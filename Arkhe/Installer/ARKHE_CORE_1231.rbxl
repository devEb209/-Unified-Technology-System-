     <Item class="ModuleScript" referent="RBX355375"><Properties><string name="Name">Optimizer</string><ProtectedString name="Source"><![CDATA[--[[
	Optimizer (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Optimize > Optimizer
	============================================================
	F13 — OTIMIZADOR 1-CLIQUE (Ring1).
	Principio: Sem destruir trabalho do dev. Tudo conservador.
	============================================================
]]

local Optimizer = {}

local function coletarDescendants()
	local ok, lista = pcall(function() return workspace:GetDescendants() end)
	return ok and lista or {}
end

function Optimizer.DesativarSombrasPequenas(limiteTamanho)
	limiteTamanho = limiteTamanho or 4
	local afetados = 0
	for _, inst in ipairs(coletarDescendants()) do
		if inst:IsA("BasePart") and inst.CastShadow then
			local s = inst.Size
			local menor = math.min(s.X, s.Y, s.Z)
			if menor < limiteTamanho then
				local nome = inst.Name:lower()
				if not nome:find("hitbox") and not nome:find("colisao") and not nome:find("collision") then
					inst.CastShadow = false
					afetados = afetados + 1
				end
			end
		end
	end
	return afetados
end

function Optimizer.ReduzirParticulas(fator)
	fator = fator or 0.5
	local afetados = 0
	for _, inst in ipairs(coletarDescendants()) do
		if inst:IsA("ParticleEmitter") and inst.Enabled then
			if inst.Rate > 3 then
				inst.Rate = math.max(1, math.floor(inst.Rate * fator))
				afetados = afetados + 1
			end
		end
	end
	return afetados
end

function Optimizer.ReduzirLuzes()
	local afetados = 0
	for _, inst in ipairs(coletarDescendants()) do
		if inst:IsA("PointLight") or inst:IsA("SpotLight") then
			if inst.Shadows then
				if inst.Range < 30 then
					inst.Shadows = false
					afetados = afetados + 1
				end
			end
			if inst.Range > 10 then
				inst.Range = inst.Range * 0.85
			end
		end
	end
	return afetados
end

function Optimizer.AncorarDecoracao()
	local afetados = 0
	for _, inst in ipairs(coletarDescendants()) do
		if inst:IsA("BasePart") and not inst.Anchored then
			local temHumanoid = inst.Parent and inst.Parent:FindFirstChildOfClass("Humanoid")
			if not temHumanoid and inst.Name ~= "Handle" then
				local temScript = false
				for _, filho in ipairs(inst:GetChildren()) do
					if filho:IsA("Script") or filho:IsA("LocalScript") then temScript = true break end
				end
				if not temScript then
					inst.Anchored = true
					afetados = afetados + 1
					if afetados > 300 then break end
				end
			end
		end
	end
	return afetados
end

function Optimizer.AjustarTerrainLOD(Kernel, plataforma)
	local ok, render = pcall(function()
		return Kernel and Kernel.Obter and Kernel.Obter("TerrainRender") or nil
	end)
	if not ok or not render then return 0 end
	if plataforma == "MobileFraco" then
		if render.OrcamentoPorTick and render.OrcamentoPorTick > 1 then
			render.OrcamentoPorTick = 1
			return 1
		end
	elseif plataforma == "MobileMedio" then
		if render.OrcamentoPorTick and render.OrcamentoPorTick > 2 then
			render.OrcamentoPorTick = 2
			return 1
		end
	end
	return 0
end

function Optimizer.LimitarNPCs(Kernel, plataforma)
	local orcamentos = {
		MobileFraco = 8,
		MobileMedio = 16,
		Console = 28,
		PC = 50,
	}
	local novoMax = orcamentos[plataforma] or 16
	local ok, brain = pcall(function()
		return Kernel and Kernel.Obter and Kernel.Obter("NPCBrain") or nil
	end)
	if ok and brain and brain.MaxNPCs then
		if brain.MaxNPCs > novoMax then
			brain.MaxNPCs = novoMax
			return novoMax
		end
	end
	return 0
end

function Optimizer.AjustarMaterializer(Kernel, plataforma)
	local ok, mat = pcall(function()
		return Kernel and Kernel.Obter and Kernel.Obter("Materializer") or nil
	end)
	if not ok or not mat then return 0 end
	if plataforma == "MobileFraco" then
		if mat.PorFrame and mat.PorFrame > 3 then
			mat.PorFrame = 3
			return 3
		end
	elseif plataforma == "MobileMedio" then
		if mat.PorFrame and mat.PorFrame > 4 then
			mat.PorFrame = 4
			return 4
		end
	elseif plataforma == "PC" then
		if mat.PorFrame and mat.PorFrame < 6 then
			mat.PorFrame = 6
			return 6
		end
	end
	return 0
end

function Optimizer.SugerirVisualMobile(Kernel, plataforma)
	local ok, visual = pcall(function()
		return Kernel and Kernel.Obter and Kernel.Obter("VisualPresets") or require(game:GetService("ReplicatedStorage").Arkhe.Visual.Presets)
	end)
	if not ok or not visual then return nil end
	if plataforma == "MobileFraco" then
		if visual.Atual ~= "Arcade" and visual.Atual ~= "SemiRealista" then
			return "Arcade"
		end
	end
	return nil
end

function Optimizer.OtimizarSeguro(plataforma, Kernel)
	plataforma = plataforma or "MobileMedio"
	local log = {}
	local function registrar(acao, qtd, detalhe)
		table.insert(log, { Acao = acao, Quantidade = qtd, Detalhe = detalhe or "" })
	end

	local Analyzer = nil
	pcall(function()
		Analyzer = require(game:GetService("ReplicatedStorage").Arkhe.Optimize.Analyzer)
	end)
	local limiteSombra = 4
	if Analyzer and Analyzer.Orcamentos[plataforma] then
		limiteSombra = Analyzer.Orcamentos[plataforma].SombraMaxPartSize or 4
	end

	local q1 = Optimizer.DesativarSombrasPequenas(limiteSombra)
	registrar("DesativarSombrasPequenas", q1, "CastShadow=false em parts < " .. limiteSombra .. " studs")

	local q2 = Optimizer.ReduzirParticulas(0.55)
	registrar("ReduzirParticulas", q2, "Rate x0.55")

	local q3 = Optimizer.ReduzirLuzes()
	registrar("ReduzirLuzes", q3, "Shadows off em luzes pequenas + Range -15%")

	local q4 = Optimizer.AncorarDecoracao()
	registrar("AncorarDecoracao", q4, "Anchored em decoracao solta max 300")

	local q5 = Optimizer.AjustarTerrainLOD(Kernel, plataforma)
	registrar("AjustarTerrainLOD", q5, "OrcamentoPorTick ajustado para " .. plataforma)

	local q6 = Optimizer.LimitarNPCs(Kernel, plataforma)
	registrar("LimitarNPCs", q6 ~= 0 and 1 or 0, q6 ~= 0 and ("MaxNPCs=" .. q6) or "ja dentro do limite")

	local q7 = Optimizer.AjustarMaterializer(Kernel, plataforma)
	registrar("AjustarMaterializer", q7 ~= 0 and 1 or 0, q7 ~= 0 and ("PorFrame=" .. q7) or "ja ok")

	local sugestaoVisual = Optimizer.SugerirVisualMobile(Kernel, plataforma)
	if sugestaoVisual then
		registrar("SugerirVisual", 1, "Sugestao: preset " .. sugestaoVisual .. " para " .. plataforma)
	end

	local ganho = (q1 * 0.15) + (q2 * 0.3) + (q3 * 0.5) + (q4 * 0.1)
	ganho = math.clamp(ganho, 0, 100)

	return {
		Plataforma = plataforma,
		Log = log,
		GanhoEstimado = math.floor(ganho),
		Quando = os.time(),
		SugestaoVisual = sugestaoVisual,
	}
end

return Optimizer
]]></ProtectedString></Properties></Item>
