     <Item class="ModuleScript" referent="RBX489073"><Properties><string name="Name">ConsoleSupport</string><ProtectedString name="Source"><![CDATA[[[
	ConsoleSupport (ModuleScript)
	Local: ReplicatedStorage > Arkhe > VRConsole > ConsoleSupport
	============================================================
	F22 — SUPORTE TOTAL A CONSOLE (gamepad + safe-area)
	- Mapeamento botões: A/B/X/Y, LB/RB, LT/RT, DPad, Sticks
	- Ações: Confirmar, Cancelar, Menu, Foco Proximo/Anterior
	- Safe-area: 4% bordas (consoles cortam)
	- Cursor virtual: stick direito move cursor, A clica
	- Vibração: feedback háptico por evento
	- Integra com Gamepad.lua + DockUI + UI Builder
	============================================================
]]

local ConsoleSupport = {}
ConsoleSupport.__index = ConsoleSupport

ConsoleSupport.Botoes = {
	A = { Acao="Confirmar", Desc="Confirmar/selecionar" },
	B = { Acao="Cancelar", Desc="Voltar/cancelar" },
	X = { Acao="AcaoSecundaria", Desc="Ação secundária (ex: deletar)" },
	Y = { Acao="MenuRapido", Desc="Menu rápido/contexto" },
	LB = { Acao="AbaAnterior", Desc="Aba anterior" },
	RB = { Acao="ProximaAba", Desc="Próxima aba" },
	LT = { Acao="ZoomOut", Desc="Zoom out / LOD -" },
	RT = { Acao="ZoomIn", Desc="Zoom in / LOD +" },
	DPadUp = { Acao="FocoCima", Desc="Foco para cima" },
	DPadDown = { Acao="FocoBaixo", Desc="Foco para baixo" },
	DPadLeft = { Acao="FocoEsquerda", Desc="Foco para esquerda" },
	DPadRight = { Acao="FocoDireita", Desc="Foco para direita" },
	StickL = { Acao="Mover", Desc="Mover personagem/câmera" },
	StickR = { Acao="Cursor", Desc="Mover cursor virtual" },
	Start = { Acao="Menu", Desc="Menu principal" },
	Back = { Acao="Inventario", Desc="Inventário/mapa" },
}

ConsoleSupport.SafeArea = 0.04 -- 4%

function ConsoleSupport.novo()
	local self = setmetatable({}, ConsoleSupport)
	self.Mapeamento = {}
	for botao, info in pairs(ConsoleSupport.Botoes) do
		self.Mapeamento[botao] = info.Acao
	end
	self.CursorPos = Vector2.new(0.5,0.5) -- centro 0-1
	self.CursorVel = Vector2.new(0,0)
	self.VibracaoAtiva = false
	self.UltimaVibracao = 0
	self.ModoConsole = false
	return self
end

function ConsoleSupport:DefinirMapeamento(botao, acao)
	if ConsoleSupport.Botoes[botao] then
		self.Mapeamento[botao] = acao
		return true
	end
	return false
end

function ConsoleSupport:AtualizarCursor(stickX, stickY, dt)
	dt = dt or 0.033
	local deadzone = 0.2
	if math.abs(stickX) < deadzone then stickX=0 end
	if math.abs(stickY) < deadzone then stickY=0 end
	self.CursorVel = Vector2.new(stickX, -stickY) * 1.5 -- sensibilidade
	self.CursorPos = self.CursorPos + self.CursorVel * dt
	-- clamp com safe-area
	local safe = ConsoleSupport.SafeArea
	self.CursorPos = Vector2.new(
		math.clamp(self.CursorPos.X, safe, 1-safe),
		math.clamp(self.CursorPos.Y, safe, 1-safe)
	)
	return self.CursorPos
end

function ConsoleSupport:ConverterParaUDim2(pos01)
	-- converte 0-1 para UDim2 com safe-area
	return UDim2.new(pos01.X, 0, pos01.Y, 0)
end

function ConsoleSupport:ObterAcao(botao)
	return self.Mapeamento[botao] or "Nenhuma"
end

function ConsoleSupport:Vibrar(intensidade, duracao)
	intensidade = math.clamp(intensidade or 0.5, 0, 1)
	duracao = duracao or 0.2
	self.VibracaoAtiva = true
	self.UltimaVibracao = os.time()
	-- em Roblox real: GamepadService:SetVibration?
	return { Intensidade=intensidade, Duracao=duracao, Quando=self.UltimaVibracao }
end

function ConsoleSupport:ChecarSafeArea(pos01)
	local safe = ConsoleSupport.SafeArea
	return pos01.X >= safe and pos01.X <= 1-safe and pos01.Y >= safe and pos01.Y <= 1-safe
end

function ConsoleSupport:ListarBotoes()
	local lista={}
	for botao, info in pairs(ConsoleSupport.Botoes) do
		table.insert(lista, { Botao=botao, Acao=self.Mapeamento[botao], Desc=info.Desc })
	end
	return lista
end

function ConsoleSupport:Serializar()
	return {
		ModoConsole=self.ModoConsole,
		Cursor={ X=self.CursorPos.X, Y=self.CursorPos.Y },
		SafeArea=ConsoleSupport.SafeArea,
		TotalBotoes=(function() local c=0 for _ in pairs(ConsoleSupport.Botoes) do c=c+1 end return c end)(),
		Mapeamento=self.Mapeamento,
	}
end

return ConsoleSupport
]]></ProtectedString></Properties></Item>
