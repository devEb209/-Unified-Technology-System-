     <Item class="ModuleScript" referent="RBX855425"><Properties><string name="Name">PreviewRender</string><ProtectedString name="Source"><![CDATA[--[[
  PreviewRender (ModuleScript)
  Local: ReplicatedStorage > Arkhe > Cinematic > PreviewRender
  ============================================================================
  F17 — PREVIEW DESENHADO FINAL (o que faltava pra 100%)
  - Renderiza preview de timeline/curva/spline como imagem ASCII + frames
  - Gera desenho 2D da câmera ao longo do spline
  - Exporta para ClipExporter e para UI
  - Contrato: GerarPreview, DesenharFrame, Exportar
  ============================================================================
]]

local PreviewRender = {}
PreviewRender.__index = PreviewRender

function PreviewRender.novo(nome)
    local self = setmetatable({}, PreviewRender)
    self.Nome = nome or "Preview"
    self.Frames = {} -- { T, Pos, Rot, FOV }
    self.Largura = 320
    self.Altura = 180
    self.Duracao = 10
    return self
end

function PreviewRender:GerarDeTimeline(timeline, fps)
    fps = fps or 24
    self.Frames = {}
    local totalFrames = math.floor(self.Duracao * fps)
    for i=0, totalFrames do
        local t = (i / totalFrames) * self.Duracao
        local pos = { X=0, Y=5, Z=0 }
        local rot = { X=0, Y=0, Z=0 }
        local fov = 70
        if timeline and timeline.Avaliar then
            local ok, dados = pcall(function() return timeline:Avaliar(t) end)
            if ok and dados then
                pos = dados.Pos or pos
                rot = dados.Rot or rot
                fov = dados.FOV or fov
            end
        end
        table.insert(self.Frames, { T=t, Pos=pos, Rot=rot, FOV=fov, Indice=i })
    end
    return self.Frames
end

function PreviewRender:GerarDeSpline(spline, fps)
    fps = fps or 24
    self.Frames = {}
    local totalFrames = math.floor(self.Duracao * fps)
    for i=0, totalFrames do
        local t = i / totalFrames
        local pos = { X=0, Y=5, Z=0 }
        if spline and spline.Avaliar then
            local ok, p = pcall(function() return spline:Avaliar(t) end)
            if ok and p then pos = p end
        end
        table.insert(self.Frames, { T=t*self.Duracao, Pos=pos, Rot={X=0,Y=0,Z=0}, FOV=70, Indice=i })
    end
    return self.Frames
end

function PreviewRender:DesenharFrame(indice)
    local frame = self.Frames[indice]
    if not frame then return nil end
    -- gera representação ASCII simplificada do preview
    local linhas = {}
    table.insert(linhas, string.format("Frame %d T=%.2f FOV=%d", frame.Indice, frame.T, frame.FOV))
    table.insert(linhas, string.format("Pos: %.1f, %.1f, %.1f", frame.Pos.X, frame.Pos.Y, frame.Pos.Z))
    -- mini mapa 10x10
    for y=1, 10 do
        local linha = ""
        for x=1, 20 do
            if x == 10 and y == 5 then linha = linha .. "C" else linha = linha .. "." end
        end
        table.insert(linhas, linha)
    end
    return table.concat(linhas, "\n")
end

function PreviewRender:ExportarParaClipExporter(clipExporter)
    if not clipExporter or not clipExporter.AdicionarFonte then return false end
    local ok = pcall(function()
        clipExporter:AdicionarFonte("PreviewRender", {
            Frames = self.Frames,
            Largura = self.Largura,
            Altura = self.Altura,
            Duracao = self.Duracao,
        })
    end)
    return ok
end

function PreviewRender:Serializar()
    return {
        Nome=self.Nome,
        TotalFrames=#self.Frames,
        Largura=self.Largura,
        Altura=self.Altura,
        Duracao=self.Duracao,
    }
end

return PreviewRender
]]></ProtectedString></Properties></Item>
