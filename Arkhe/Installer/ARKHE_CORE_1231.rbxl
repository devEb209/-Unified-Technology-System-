     <Item class="ModuleScript" referent="RBX675684"><Properties><string name="Name">VRUIEditor</string><ProtectedString name="Source"><![CDATA[--[[
	VRUIEditor (ModuleScript)
	Local: ReplicatedStorage > Arkhe > UI > VRUIEditor
	============================================================
	F10 — EDITOR DE UI EM VR (mãos + laser)
	- Cria/mover/redimensionar elementos UI com mãos VR
	- Mão esquerda: paleta de componentes
	- Mão direita: laser para posicionar
	- Gestos: pinça para agarrar, polegar para confirmar
	- Preview em 3D: UI flutua no espaço VR
	- Integra com UIKit + HandTracking + LaserPointer
	============================================================
]]

local VRUIEditor = {}
VRUIEditor.__index = VRUIEditor

function VRUIEditor.novo()
	local self = setmetatable({}, VRUIEditor)
	self.Ativo = false
	self.ElementosVR = {} -- { Id, Tipo, Pos3D, Tamanho, Cor, AgarradoPor }
	self.Paleta = { "Painel","Texto","Botao","Imagem","Lista" }
	self.Historico = {}
	return self
end

function VRUIEditor:Ativar()
	self.Ativo = true
	return true
end

function VRUIEditor:Desativar()
	self.Ativo = false
	return true
end

function VRUIEditor:CriarElemento(tipo, pos3D, tamanho)
	if not self.Ativo then return nil end
	local id = "vr_ui_"..math.random(1000,9999)
	local elem = {
		Id=id,
		Tipo=tipo or "Painel",
		Pos3D=pos3D or Vector3.new(0,2, -3),
		Tamanho=tamanho or Vector3.new(2,1,0.1),
		Cor=Color3.fromRGB(200,200,200),
		AgarradoPor=nil,
		CriadoEm=os.time(),
	}
	self.ElementosVR[id]=elem
	table.insert(self.Historico, { Quando=os.time(), Acao="Criar", Id=id, Tipo=tipo })
	return elem
end

function VRUIEditor:Agarrar(id, maoId)
	local elem = self.ElementosVR[id]
	if not elem then return false end
	if elem.AgarradoPor then return false end
	elem.AgarradoPor = maoId
	return true
end

function VRUIEditor:Mover(id, novaPos3D)
	local elem = self.ElementosVR[id]
	if not elem then return false end
	elem.Pos3D = novaPos3D
	table.insert(self.Historico, { Quando=os.time(), Acao="Mover", Id=id, Pos=novaPos3D })
	return true
end

function VRUIEditor:Redimensionar(id, novoTamanho)
	local elem = self.ElementosVR[id]
	if not elem then return false end
	elem.Tamanho = novoTamanho
	table.insert(self.Historico, { Quando=os.time(), Acao="Redimensionar", Id=id, Tam=novoTamanho })
	return true
end

function VRUIEditor:Soltar(id)
	local elem = self.ElementosVR[id]
	if not elem then return false end
	elem.AgarradoPor = nil
	return true
end

function VRUIEditor:Deletar(id)
	if not self.ElementosVR[id] then return false end
	self.ElementosVR[id]=nil
	table.insert(self.Historico, { Quando=os.time(), Acao="Deletar", Id=id })
	return true
end

function VRUIEditor:ExportarParaUIKit()
	-- converte elementos 3D para UIKit 2D (%)
	local telas={}
	for id, elem in pairs(self.ElementosVR) do
		-- projeta 3D para 2D simples: X 0-1, Y 0-1
		local xPerc = math.clamp((elem.Pos3D.X + 5)/10, 0, 1) * 100
		local yPerc = math.clamp((2 - elem.Pos3D.Y + 2)/4, 0, 1) * 100
		table.insert(telas, {
			Tipo=elem.Tipo,
			Pos={ X=xPerc, Y=yPerc },
			Tamanho={ X=elem.Tamanho.X*10, Y=elem.Tamanho.Y*10 },
			Id=id,
		})
	end
	return telas
end

function VRUIEditor:Listar()
	local lista={}
	for id, elem in pairs(self.ElementosVR) do
		table.insert(lista, { Id=id, Tipo=elem.Tipo, Pos=elem.Pos3D, Agarrado=elem.AgarradoPor ~= nil })
	end
	return lista
end

function VRUIEditor:Serializar()
	return {
		Ativo=self.Ativo,
		Total=#self:Listar(),
		Paleta=self.Paleta,
		Historico=#self.Historico,
	}
end

return VRUIEditor
]]></ProtectedString></Properties></Item>
    </Item>
