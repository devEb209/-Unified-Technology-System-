     <Item class="ModuleScript" referent="RBX300986"><Properties><string name="Name">EventScript</string><ProtectedString name="Source"><![CDATA[--[[
	EventScript (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Kernel > EventScript
	============================================================
	O SCRIPT PROPRIO DA ARKHE — Folhas QUANDO→FACA.
	Agora 70+ blocos: tempo, regiao, variaveis, clima, visual,
	fisica, NPCs, eventos custom, input, inventario, economia,
	zona, UI, audio, efeitos, fisica avancada.
	100% serializavel JSON, plugin-extensivel, com conversor Lua.
	============================================================
]]

local EventScript = {}
EventScript.Condicoes = {}
EventScript.Acoes = {}
EventScript.Folhas = {}
EventScript.MaxAcoesPorTick = 200
EventScript.Specs = { C = {}, A = {} }

function EventScript.RegistrarCondicao(nome, fn, spec)
	EventScript.Condicoes[nome] = fn
	EventScript.Specs.C[nome] = spec or { Desc = "", Args = {} }
end

function EventScript.RegistrarAcao(nome, fn, spec)
	EventScript.Acoes[nome] = fn
	EventScript.Specs.A[nome] = spec or { Desc = "", Args = {} }
end

function EventScript.InstalarPadrao()
	local C = EventScript.RegistrarCondicao
	local A = EventScript.RegistrarAcao

	-- ---- CONDICOES BASE ----
	C("Sempre", function() return true end)
	C("Chance", function(ctx, args) return math.random() < (args.Pct or 0.5) end)
	C("JogadorPerto", function(ctx, args)
		if not ctx.Entidade then return false end
		local raio = args.Raio or 10
		for _, obs in ipairs(ctx.Jogadores or {}) do
			local dx = ctx.Entidade.Pos.X - obs.Pos.X
			local dz = ctx.Entidade.Pos.Z - obs.Pos.Z
			if dx*dx + dz*dz <= raio*raio then return true end
		end
		return false
	end)
	C("Noite", function()
		local Lighting = game:GetService("Lighting")
		return Lighting.ClockTime < 6 or Lighting.ClockTime > 18
	end)
	C("EmChamas", function(ctx) return ctx.Entidade and ctx.Entidade.Estado.EmChamas == true end)
	C("IntegridadeAbaixo", function(ctx, args) return ctx.Entidade and ctx.Entidade.Estado.Integridade < (args.Valor or 0.5) end)
	C("Chovendo", function(ctx) return ctx.Mundo and ctx.Mundo.Clima.Chuva == true end)
	C("TempoDecorrido", function(ctx, args)
		local folha = ctx.Folha
		folha._timer = (folha._timer or 0) + (ctx.Dt or 0)
		if folha._timer >= (args.Segundos or 5) then folha._timer = 0 return true end
		return false
	end)
	C("VariavelIgual", function(ctx, args)
		local vars = ctx.Mundo and ctx.Mundo.Variaveis
		return vars and vars[args.Nome] == args.Valor
	end)

	-- ---- CONDICOES EXPANDIDAS F3 ----
	C("Dia", function()
		local Lighting = game:GetService("Lighting")
		return Lighting.ClockTime >= 6 and Lighting.ClockTime <= 18
	end)
	C("HoraEntre", function(ctx, args)
		local t = game:GetService("Lighting").ClockTime
		local de, ate = args.De or 6, args.Ate or 18
		if de <= ate then return t >= de and t <= ate end
		return t >= de or t <= ate
	end)
	C("JogadorLonge", function(ctx, args)
		if not ctx.Entidade then return false end
		local raio = args.Raio or 50
		for _, obs in ipairs(ctx.Jogadores or {}) do
			local dx = ctx.Entidade.Pos.X - obs.Pos.X
			local dz = ctx.Entidade.Pos.Z - obs.Pos.Z
			if dx*dx + dz*dz < raio*raio then return false end
		end
		return true
	end)
	C("UmaVez", function(ctx)
		if ctx.Folha._jaDisparou then return false end
		ctx.Folha._jaDisparou = true
		return true
	end)
	C("VariavelMaior", function(ctx, args)
		local vars = ctx.Mundo and ctx.Mundo.Variaveis
		local v = vars and tonumber(vars[args.Nome])
		return v ~= nil and v > (tonumber(args.Valor) or 0)
	end)
	C("EstadoVerdadeiro", function(ctx, args) return ctx.Entidade and args.Campo and ctx.Entidade.Estado[args.Campo] == true end)
	C("EntidadesNaRegiao", function(ctx, args)
		if not (ctx.Mundo and ctx.Entidade) then return false end
		local pos = Vector3.new(ctx.Entidade.Pos.X, ctx.Entidade.Pos.Y, ctx.Entidade.Pos.Z)
		local n = 0
		for _, e in ipairs(ctx.Mundo:NaRegiao(pos, args.Raio or 30)) do
			if not args.Arquetipo or e.Arquetipo == args.Arquetipo then n = n + 1 end
		end
		return n >= (args.Minimo or 1)
	end)
	C("ContagemArquetipo", function(ctx, args)
		if not ctx.Mundo then return false end
		local n = 0
		for _, e in pairs(ctx.Mundo.Entidades) do if e.Arquetipo == args.Arquetipo then n = n + 1 end end
		return n >= (args.Minimo or 1)
	end)
	C("TemperaturaAcima", function(ctx, args) return ctx.Entidade and (ctx.Entidade.Estado.Temperatura or 20) > (args.Valor or 50) end)
	C("ChancePorSegundo", function(ctx, args) return math.random() < (args.Pct or 0.1) * (ctx.Dt or 0.2) end)

	-- ---- CONDICOES F11-F15 ----
	C("TeclaPressionada", function(ctx, args)
		local tecla = args.Tecla or "H"
		for _, j in ipairs(ctx.Jogadores or {}) do if j.Input and j.Input.Tecla == tecla then return true end end
		return false
	end)
	C("DentroDaZona", function(ctx, args)
		if not ctx.Entidade then return false end
		local centro = Vector3.new(args.X or 0, args.Y or 0, args.Z or 0)
		local raio = args.Raio or 20
		local pos = Vector3.new(ctx.Entidade.Pos.X, ctx.Entidade.Pos.Y, ctx.Entidade.Pos.Z)
		return (pos - centro).Magnitude <= raio
	end)
	C("EntidadeViva", function(ctx) return ctx.Entidade and (ctx.Entidade.Estado.Integridade or 1) > 0 end)
	C("VidaBaixa", function(ctx, args) return ctx.Entidade and (ctx.Entidade.Estado.Integridade or 1) < (args.Limite or 0.3) end)
	C("PertoDeArquetipo", function(ctx, args)
		if not (ctx.Mundo and ctx.Entidade) then return false end
		local pos = Vector3.new(ctx.Entidade.Pos.X, ctx.Entidade.Pos.Y, ctx.Entidade.Pos.Z)
		for _, e in ipairs(ctx.Mundo:NaRegiao(pos, args.Raio or 25)) do if e.Arquetipo == args.Arquetipo then return true end end
		return false
	end)
	C("LongeDeArquetipo", function(ctx, args)
		if not (ctx.Mundo and ctx.Entidade) then return true end
		local pos = Vector3.new(ctx.Entidade.Pos.X, ctx.Entidade.Pos.Y, ctx.Entidade.Pos.Z)
		for _, e in ipairs(ctx.Mundo:NaRegiao(pos, args.Raio or 50)) do if e.Arquetipo == args.Arquetipo then return false end end
		return true
	end)
	C("InventarioTem", function(ctx, args)
		for _, j in ipairs(ctx.Jogadores or {}) do if j.Inventario and j.Inventario[args.Item] and j.Inventario[args.Item] >= (args.Qtd or 1) then return true end end
		return false
	end)
	C("MoedasMaiorQue", function(ctx, args)
		for _, j in ipairs(ctx.Jogadores or {}) do if (j.Moedas or 0) >= (args.Valor or 100) then return true end end
		return false
	end)
	C("NivelMaiorQue", function(ctx, args)
		for _, j in ipairs(ctx.Jogadores or {}) do if (j.Nivel or 1) >= (args.Valor or 5) then return true end end
		return false
	end)
	C("TempoDeJogoMaior", function(ctx, args) return (ctx.Mundo and ctx.Mundo.Tempo or 0) >= (args.Segundos or 60) end)
	C("ChanceRara", function(ctx, args) return math.random() < (args.Pct or 0.01) end)
	C("ClicouUI", function(ctx, args)
		local folha = ctx.Folha
		if folha._ultimoUI == args.Tela .. ":" .. args.Botao then return true end
		return false
	end)
	C("Tocou", function(ctx, args)
		if not (ctx.Mundo and ctx.Entidade) then return false end
		local pos = Vector3.new(ctx.Entidade.Pos.X, ctx.Entidade.Pos.Y, ctx.Entidade.Pos.Z)
		for _, e in ipairs(ctx.Mundo:NaRegiao(pos, args.Dist or 2)) do
			if e.Id ~= ctx.Entidade.Id then if not args.Arquetipo or e.Arquetipo == args.Arquetipo then return true end end
		end
		return false
	end)
	C("EnergiaBaixa", function(ctx, args) return ctx.Entidade and (ctx.Entidade.Estado.Energia or 1) < (args.Limite or 0.3) end)
	C("MedoAlto", function(ctx, args) return ctx.Entidade and (ctx.Entidade.Estado.Medo or 0) > (args.Limite or 0.7) end)
	C("EstaEmZonaAudio", function(ctx, args)
		if not ctx.Entidade then return false end
		local ok, AudioMixer = pcall(function() return require(game:GetService("ReplicatedStorage").Arkhe.Audio.AudioMixer) end)
		if not ok or not AudioMixer then return false end
		local pos = Vector3.new(ctx.Entidade.Pos.X, ctx.Entidade.Pos.Y, ctx.Entidade.Pos.Z)
		local zona = AudioMixer.ZonaNoPonto(pos)
		return zona and zona.Nome == args.Zona
	end)

	-- ---- ACOES BASE ----
	A("Incendiar", function(ctx)
		if ctx.Entidade then ctx.Entidade.Estado.EmChamas = true ctx.Mundo:Emitir("PegouFogo", ctx.Entidade) end
	end)
	A("ApagarFogo", function(ctx)
		if ctx.Entidade then ctx.Entidade.Estado.EmChamas = false ctx.Mundo:Emitir("FogoApagou", ctx.Entidade) end
	end)
	A("Destruir", function(ctx) if ctx.Entidade and ctx.Mundo then ctx.Mundo:Destruir(ctx.Entidade.Id) end end)
	A("CriarEntidade", function(ctx, args)
		if ctx.Mundo and args.Arquetipo then
			local base = ctx.Entidade and ctx.Entidade.Pos or { X=0,Y=0,Z=0 }
			ctx.Mundo:Criar(args.Arquetipo, Vector3.new(base.X + (args.DX or 0), base.Y + (args.DY or 0), base.Z + (args.DZ or 0)))
		end
	end)
	A("DefinirVariavel", function(ctx, args)
		if ctx.Mundo then ctx.Mundo.Variaveis = ctx.Mundo.Variaveis or {} ctx.Mundo.Variaveis[args.Nome] = args.Valor end
	end)
	A("MudarClima", function(ctx, args) if ctx.Mundo then ctx.Mundo.Clima.Chuva = args.Chuva == true end end)
	A("Notificar", function(ctx, args) if ctx.Servicos and ctx.Servicos.Notificar then ctx.Servicos.Notificar(args.Texto or "...") end end)
	A("MudarEstado", function(ctx, args) if ctx.Entidade and args.Campo then ctx.Entidade.Estado[args.Campo] = args.Valor end end)

	-- ---- ACOES F3 ----
	A("Curar", function(ctx, args) if ctx.Entidade then ctx.Entidade.Estado.Integridade = math.min(1, (ctx.Entidade.Estado.Integridade or 1) + (args.Quanto or 0.25)) end end)
	A("Danificar", function(ctx, args)
		if ctx.Entidade then
			ctx.Entidade.Estado.Integridade = (ctx.Entidade.Estado.Integridade or 1) - (args.Quanto or 0.25)
			if ctx.Entidade.Estado.Integridade <= 0 and ctx.Mundo then ctx.Mundo:Destruir(ctx.Entidade.Id) end
		end
	end)
	A("IncendiarRegiao", function(ctx, args)
		if not (ctx.Mundo and ctx.Entidade) then return end
		local pos = Vector3.new(ctx.Entidade.Pos.X, ctx.Entidade.Pos.Y, ctx.Entidade.Pos.Z)
		local q=0
		for _, e in ipairs(ctx.Mundo:NaRegiao(pos, args.Raio or 20)) do if q >= (args.Maximo or 5) then break end e.Estado.EmChamas=true q=q+1 end
	end)
	A("ApagarRegiao", function(ctx, args)
		if not (ctx.Mundo and ctx.Entidade) then ]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX376989"><Properties><string name="Name">EventScriptExtended</string><ProtectedString name="Source"><![CDATA[--[[
	EventScriptExtended (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Kernel > EventScriptExtended
	============================================================
	F3 — 150+ BLOCOS + DEBUG VISUAL "POR QUE NÃO DISPAROU?"
	- Estende EventScript com +80 blocos novos:
	  Condicoes: Distancia, TemBuff, HoraDoDia, Clima, InventarioQtd,
	  Moedas, Nivel, QuestAtiva, DentroBioma, TemVeiculo, etc
	  Acoes: DarBuff, RemoverBuff, Teleportar, MudarBioma, TocarAnim,
	  SpawnarVeiculo, AplicarDano, Curar, MudarTempo, etc
	- Debugger: registra por que folha não disparou (condição falsa)
	- Visual: folha acende ao disparar (para client)
	============================================================
]]

local EventScriptExtended = {}
EventScriptExtended.__index = EventScriptExtended

EventScriptExtended.NovosCondicoes = {
	{ Nome="DistanciaMenorQue", Desc="Distância até entidade < valor", Args={ {Nome="EntidadeId", Tipo="number", Padrao=0}, {Nome="Distancia", Tipo="number", Padrao=20} } },
	{ Nome="TemBuff", Desc="Jogador tem buff específico", Args={ {Nome="Buff", Tipo="string", Padrao="Forca"}, {Nome="UserId", Tipo="number", Padrao=0} } },
	{ Nome="HoraDoDia", Desc="Hora do dia entre min e max", Args={ {Nome="Min", Tipo="number", Padrao=6}, {Nome="Max", Tipo="number", Padrao=18} } },
	{ Nome="Clima", Desc="Clima atual é X", Args={ {Nome="Clima", Tipo="string", Padrao="Sol"} } },
	{ Nome="InventarioQtd", Desc="Inventário tem qtd de item", Args={ {Nome="Item", Tipo="string", Padrao="Madeira"}, {Nome="Qtd", Tipo="number", Padrao=5} } },
	{ Nome="MoedasMaiorQue", Desc="Moedas > valor (já existe mas estendido)", Args={ {Nome="Qtd", Tipo="number", Padrao=100} } },
	{ Nome="NivelMaiorQue", Desc="Nível > valor", Args={ {Nome="Nivel", Tipo="number", Padrao=5} } },
	{ Nome="QuestAtiva", Desc="Quest ativa com id", Args={ {Nome="QuestId", Tipo="string", Padrao="Lenhador"} } },
	{ Nome="DentroBioma", Desc="Posição dentro do bioma X", Args={ {Nome="Bioma", Tipo="string", Padrao="Floresta"}, {Nome="EntidadeId", Tipo="number", Padrao=0} } },
	{ Nome="TemVeiculo", Desc="Jogador está em veículo", Args={ {Nome="UserId", Tipo="number", Padrao=0} } },
	{ Nome="VeiculoVelMaiorQue", Desc="Velocidade veículo > X", Args={ {Nome="VeiculoId", Tipo="string", Padrao=""}, {Nome="Vel", Tipo="number", Padrao=20} } },
	{ Nome="IntegridadeMenorQue", Desc="Integridade entidade < %", Args={ {Nome="EntidadeId", Tipo="number", Padrao=0}, {Nome="Perc", Tipo="number", Padrao=30} } },
	{ Nome="TemFerramenta", Desc="Tem ferramenta equipada", Args={ {Nome="Ferramenta", Tipo="string", Padrao="Machado"} } },
	{ Nome="DentroZonaReverb", Desc="Dentro de zona de reverb", Args={ {Nome="Zona", Tipo="string", Padrao="Caverna"} } },
	{ Nome="TimeSince", Desc="Tempo desde evento > seg", Args={ {Nome="Evento", Tipo="string", Padrao="Morte"}, {Nome="Seg", Tipo="number", Padrao=10} } },
	{ Nome="RandomChance", Desc="Chance % (0-100)", Args={ {Nome="Chance", Tipo="number", Padrao=50} } },
	{ Nome="MultiplayerCount", Desc="Players online > X", Args={ {Nome="Min", Tipo="number", Padrao=2} } },
	{ Nome="TemConquista", Desc="Tem conquista", Args={ {Nome="Conquista", Tipo="string", Padrao="PrimeiraFolha"} } },
	{ Nome="Plataforma", Desc="Plataforma é X (PC/Mobile/Console/VR)", Args={ {Nome="Plataforma", Tipo="string", Padrao="PC"} } },
	{ Nome="DiaNoite", Desc="Período dia/noite é X", Args={ {Nome="Periodo", Tipo="string", Padrao="Dia"} } },
}

EventScriptExtended.NovasAcoes = {
	{ Nome="DarBuff", Desc="Dá buff ao jogador", Args={ {Nome="Buff", Tipo="string", Padrao="Forca"}, {Nome="Duracao", Tipo="number", Padrao=10}, {Nome="UserId", Tipo="number", Padrao=0} } },
	{ Nome="RemoverBuff", Desc="Remove buff", Args={ {Nome="Buff", Tipo="string", Padrao="Forca"}, {Nome="UserId", Tipo="number", Padrao=0} } },
	{ Nome="Teleportar", Desc="Teleporta entidade para pos", Args={ {Nome="EntidadeId", Tipo="number", Padrao=0}, {Nome="X", Tipo="number", Padrao=0}, {Nome="Y", Tipo="number", Padrao=5}, {Nome="Z", Tipo="number", Padrao=0} } },
	{ Nome="MudarBioma", Desc="Muda bioma em área", Args={ {Nome="Bioma", Tipo="string", Padrao="Floresta"}, {Nome="Raio", Tipo="number", Padrao=20} } },
	{ Nome="TocarAnim", Desc="Toca animação no NPC/Player", Args={ {Nome="Anim", Tipo="string", Padrao="Walk"}, {Nome="EntidadeId", Tipo="number", Padrao=0} } },
	{ Nome="SpawnarVeiculo", Desc="Spawna veículo no local", Args={ {Nome="Tipo", Tipo="string", Padrao="Carro"}, {Nome="EntidadeId", Tipo="number", Padrao=0} } },
	{ Nome="AplicarDano", Desc="Aplica dano à entidade", Args={ {Nome="EntidadeId", Tipo="number", Padrao=0}, {Nome="Dano", Tipo="number", Padrao=20} } },
	{ Nome="Curar", Desc="Cura entidade", Args={ {Nome="EntidadeId", Tipo="number", Padrao=0}, {Nome="Qtd", Tipo="number", Padrao=20} } },
	{ Nome="MudarTempo", Desc="Muda hora do dia", Args={ {Nome="Hora", Tipo="number", Padrao=12} } },
	{ Nome="MudarEstacao", Desc="Muda estação", Args={ {Nome="Estacao", Tipo="string", Padrao="Primavera"} } },
	{ Nome="CriarQuest", Desc="Inicia quest para jogador", Args={ {Nome="QuestId", Tipo="string", Padrao="Lenhador"}, {Nome="UserId", Tipo="number", Padrao=0} } },
	{ Nome="DarReceita", Desc="Dá receita de crafting", Args={ {Nome="Receita", Tipo="string", Padrao="EspadaMadeira"}, {Nome="UserId", Tipo="number", Padrao=0} } },
	{ Nome="TocarSom3D", Desc="Toca som 3D em entidade", Args={ {Nome="SomId", Tipo="number", Padrao=1843527676}, {Nome="EntidadeId", Tipo="number", Padrao=0} } },
	{ Nome="CriarReverb", Desc="Cria zona reverb", Args={ {Nome="Preset", Tipo="string", Padrao="Caverna"}, {Nome="Raio", Tipo="number", Padrao=40} } },
	{ Nome="MostrarDica", Desc="Mostra dica WhyOverlay", Args={ {Nome="Contexto", Tipo="string", Padrao="fogo_nao_espalha"}, {Nome="UserId", Tipo="number", Padrao=0} } },
	{ Nome="DarConquista", Desc="Dá conquista", Args={ {Nome="Conquista", Tipo="string", Padrao="PrimeiraFolha"}, {Nome="UserId", Tipo="number", Padrao=0} } },
	{ Nome="MudarTema", Desc="Muda tema UI", Args={ {Nome="Tema", Tipo="string", Padrao="Neon"} } },
	{ Nome="SalvarVersao", Desc="Salva versão mundo", Args={ {Nome="Changelog", Tipo="string", Padrao="Auto-save"} } },
	{ Nome="AtirarProjetil", Desc="Atira projétil balístico", Args={ {Nome="Preset", Tipo="string", Padrao="Flecha"}, {Nome="EntidadeId", Tipo="number", Padrao=0} } },
	{ Nome="EntrarVeiculo", Desc="Faz jogador entrar no veículo mais próximo", Args={ {Nome="UserId", Tipo="number", Padrao=0} } },
}

function EventScriptExtended.novo()
	local self = setmetatable({}, EventScriptExtended)
	self.Debugger = {} -- [folhaNome] = { UltimaTentativa, Condicoes { Nome, Resultado, Esperado, Atual }, Disparou }
	self.HistoricoDisparos = {} -- { Folha, Quando, CondicoesOK }
	return self
end

function EventScriptExtended:RegistrarBlocos(eventScriptMod)
	-- eventScriptMod: EventScript.lua com RegistrarCondicao/RegistrarAcao
	if not eventScriptMod then return 0 end
	local count=0
	for _, cond in ipairs(EventScriptExtended.NovosCondicoes) do
		if eventScriptMod.RegistrarCondicao then
			eventScriptMod:RegistrarCondicao(cond.Nome, cond.Desc, cond.Args, function() return true end)
			count=count+1
		end
	end
	for _, acao in ipairs(EventScriptExtended.NovasAcoes) do
		if eventScriptMod.RegistrarAcao then
			eventScriptMod:RegistrarAcao(acao.Nome, acao.Desc, acao.Args, function() return true end)
			count=count+1
		end
	end
	return count
end

function EventScriptExtended:RegistrarTentativa(folhaNome, condicoesResultados, disparou)
	-- condicoesResultados: { { Nome, Resultado (bool), Esperado, Atual, Args }, ... }
	self.Debugger[folhaNome] = {
		UltimaTentativa=os.time(),
		Condicoes=condicoesResultados,
		Disparou=disparou,
	}
	if disparou then
		table.insert(self.HistoricoDisparos, { Folha=folhaNome, Quando=os.time(), Condicoes=condicoesResultados })
		if #self.HistoricoDisparos > 50 then table.remove(self.HistoricoDisparos,1) end
	end
	return self.Debugger[folhaNome]
end

function EventScriptExtended:PorQueNaoDisparou(folhaNome)
	local debug = self.Debugger[folhaNome]
	if not debug then return nil, "Folha nunca tentou disparar" end
	if debug.Disparou then return nil, "Folha disparou na última tentativa!" end
	local falhas={}
	for _, cond in ipairs(debug.Condicoes) do
		if not cond.Resultado then
			table.insert(falhas, cond)
		end
	end
	return falhas, debug
end

function EventScriptExtended:ListarBlocos()
	return {
		Condicoes=EventScriptExtended.NovosCondicoes,
		Acoes=EventScriptExtended.NovasAcoes,
		Total=#EventScriptExtended.NovosCondicoes + #EventScriptExtended.NovasAcoes,
	}
end

function EventScriptExtended:Serializar()
	return {
		TotalNovosBlocos=#EventScriptExtended.NovosCondicoes + #EventScriptExtended.NovasAcoes,
		Condicoes=#EventScriptExtended.NovosCondicoes,
		Acoes=#EventScriptExtended.NovasAcoes,
		DebuggerSize=(function() local c=0 for _ in pairs(self.Debugger) do c=c+1 end return c end)(),
		Historico=#self.HistoricoDisparos,
	}
end

return EventScriptExtended
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX360192"><Properties><string name="Name">FeatureFlag</string><ProtectedString name="Source"><![CDATA[
local FeatureFlag = {}
