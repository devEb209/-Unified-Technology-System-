     <Item class="ModuleScript" referent="RBX816255"><Properties><string name="Name">Texture</string><ProtectedString name="Source"><![CDATA[
local Texture = {}
Texture.Tipos={Noise="rbxassetid://noise", Grid="rbxassetid://grid", Dots="rbxassetid://dots", Carbon="rbxassetid://carbon", Metal="rbxassetid://metal"}
function Texture.novo(tipo)
  return setmetatable({Tipo=tipo or "Noise", Opacidade=0.15, Escala=1, Cor={255,255,255}}, {__index=Texture})
end
function Texture:Aplicar(uiObject)
  return {UI=uiObject, Textura=self.Tipo, Opacidade=self.Opacidade}
end
function Texture:Serializar() return {Tipo=self.Tipo, Opacidade=self.Opacidade} end
return Texture
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX26092"><Properties><string name="Name">TexturedUI</string><ProtectedString name="Source"><![CDATA[
local TexturedUI = {}
function TexturedUI.novo()
  return setmetatable({
    Texturas={
      Noise={Id="rbxassetid://14928074460", Opacidade=0.15, Escala=1, Tipo="Overlay"},
      Grid={Id="rbxassetid://14928074461", Opacidade=0.08, Escala=2, Tipo="Pattern"},
      Dots={Id="rbxassetid://14928074462", Opacidade=0.1, Escala=1.5, Tipo="Pattern"},
      Carbon={Id="rbxassetid://14928074463", Opacidade=0.12, Escala=1, Tipo="Material"},
      Metal={Id="rbxassetid://14928074464", Opacidade=0.1, Escala=1, Tipo="Material"},
      Fabric={Id="rbxassetid://14928074465", Opacidade=0.08, Escala=1, Tipo="Material"},
      Marble={Id="rbxassetid://14928074466", Opacidade=0.05, Escala=2, Tipo="Material"},
    },
    Ativa="Noise",
    Combinacao={"Noise","Grid"},
  }, {__index=TexturedUI})
end
function TexturedUI:Aplicar(uiObject, texturaNome)
  texturaNome=texturaNome or self.Ativa
  local tex=self.Texturas[texturaNome]
  if not tex then return nil end
  return {UI=uiObject, Textura=tex, Combinacao=self.Combinacao}
end
function TexturedUI:Combinar(t1,t2) self.Combinacao={t1,t2} return self.Combinacao end
function TexturedUI:Serializar() return {Ativa=self.Ativa, TotalTexturas=self:Contar()} end
function TexturedUI:Contar() local n=0 for _ in pairs(self.Texturas) do n=n+1 end return n end
return TexturedUI
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX213614"><Properties><string name="Name">ThemeManager</string><ProtectedString name="Source"><![CDATA[[[
	ThemeManager (ModuleScript)
	Local: ReplicatedStorage > Arkhe > UI > ThemeManager
	============================================================
	F10 — GERENCIADOR DE TEMAS PUBLICÁVEIS
	- Tema: { Nome, Cores {Fundo,Painel,Cabecalho,Destaque,Texto...}, Fonte, Espessura }
	- Presets nativos: ArkheDark, Claro, Neon, Medieval, SciFi, Floresta
	- Operações: Criar, Duplicar, Aplicar, Exportar, Importar
	- Publicável: serializa para marketplace como asset
	============================================================
]]

local ThemeManager = {}
ThemeManager.__index = ThemeManager

ThemeManager.Presets = {
	ArkheDark = {
		Desc="Padrão Arkhe: indigo escuro + dourado",
		Cores={
			Fundo=Color3.fromRGB(16,14,24),
			Painel=Color3.fromRGB(28,25,40),
			Cabecalho=Color3.fromRGB(38,33,56),
			Destaque=Color3.fromRGB(212,175,55),
			Texto=Color3.fromRGB(235,232,245),
			TextoFraco=Color3.fromRGB(150,145,170),
			Perigo=Color3.fromRGB(200,70,70),
			Sucesso=Color3.fromRGB(70,200,120),
		},
		Fonte="Gotham",
	},
	Claro = {
		Desc="Tema claro para estúdios iluminados",
		Cores={
			Fundo=Color3.fromRGB(240,240,245),
			Painel=Color3.fromRGB(255,255,255),
			Cabecalho=Color3.fromRGB(220,220,230),
			Destaque=Color3.fromRGB(60,120,200),
			Texto=Color3.fromRGB(30,30,40),
			TextoFraco=Color3.fromRGB(120,120,130),
			Perigo=Color3.fromRGB(200,70,70),
			Sucesso=Color3.fromRGB(70,160,90),
		},
		Fonte="Gotham",
	},
	Neon = {
		Desc="Neon cyberpunk: rosa + ciano",
		Cores={
			Fundo=Color3.fromRGB(10,5,20),
			Painel=Color3.fromRGB(20,10,40),
			Cabecalho=Color3.fromRGB(40,20,80),
			Destaque=Color3.fromRGB(255,50,150),
			Texto=Color3.fromRGB(200,255,255),
			TextoFraco=Color3.fromRGB(120,180,200),
			Perigo=Color3.fromRGB(255,80,80),
			Sucesso=Color3.fromRGB(80,255,180),
		},
		Fonte="Code",
	},
	Medieval = {
		Desc="Medieval: madeira + pergaminho",
		Cores={
			Fundo=Color3.fromRGB(40,30,20),
			Painel=Color3.fromRGB(60,45,30),
			Cabecalho=Color3.fromRGB(80,60,40),
			Destaque=Color3.fromRGB(180,140,80),
			Texto=Color3.fromRGB(240,220,180),
			TextoFraco=Color3.fromRGB(160,140,110),
			Perigo=Color3.fromRGB(180,60,40),
			Sucesso=Color3.fromRGB(100,160,80),
		},
		Fonte="Garamond",
	},
	SciFi = {
		Desc="SciFi: azul escuro + laranja",
		Cores={
			Fundo=Color3.fromRGB(10,20,30),
			Painel=Color3.fromRGB(20,35,50),
			Cabecalho=Color3.fromRGB(30,50,70),
			Destaque=Color3.fromRGB(255,140,40),
			Texto=Color3.fromRGB(200,230,255),
			TextoFraco=Color3.fromRGB(120,160,180),
			Perigo=Color3.fromRGB(255,60,60),
			Sucesso=Color3.fromRGB(60,255,120),
		},
		Fonte="Gotham",
	},
	Floresta = {
		Desc="Floresta: verde escuro + dourado folha",
		Cores={
			Fundo=Color3.fromRGB(15,25,15),
			Painel=Color3.fromRGB(25,40,25),
			Cabecalho=Color3.fromRGB(35,55,35),
			Destaque=Color3.fromRGB(180,200,80),
			Texto=Color3.fromRGB(220,240,200),
			TextoFraco=Color3.fromRGB(140,160,120),
			Perigo=Color3.fromRGB(200,80,60),
			Sucesso=Color3.fromRGB(100,200,100),
		},
		Fonte="Gotham",
	},
}

function ThemeManager.novo(nome, basePreset)
	local self = setmetatable({}, ThemeManager)
	self.Nome = nome or "Tema_"..math.random(1000,9999)
	local base = ThemeManager.Presets[basePreset or "ArkheDark"]
	self.Cores = {}
	for k,v in pairs(base.Cores) do self.Cores[k]=v end
	self.Fonte = base.Fonte
	self.Desc = base.Desc
	self.Atual = false
	return self
end

function ThemeManager:DefinirCor(chave, cor)
	self.Cores[chave] = cor
	return true
end

function ThemeManager:Duplicar(novoNome)
	local copia = ThemeManager.novo(novoNome or self.Nome.."_Copia")
	for k,v in pairs(self.Cores) do copia.Cores[k]=v end
	copia.Fonte = self.Fonte
	copia.Desc = self.Desc .. " (cópia)"
	return copia
end

function ThemeManager:AplicarNoDockUI(DockUI)
	if not DockUI or not DockUI.Tema then return false end
	for k,v in pairs(self.Cores) do
		DockUI.Tema[k] = v
	end
	return true
end

function ThemeManager:Exportar()
	local coresSer={}
	for k, cor in pairs(self.Cores) do
		coresSer[k] = { R=cor.R, G=cor.G, B=cor.B }
	end
	return {
		Nome=self.Nome,
		Desc=self.Desc,
		Fonte=self.Fonte,
		Cores=coresSer,
		Versao=1,
	}
end

function ThemeManager.Importar(dados)
	if not dados or not dados.Cores then return nil end
	local self = setmetatable({}, ThemeManager)
	self.Nome = dados.Nome or "Importado"
	self.Desc = dados.Desc or ""
	self.Fonte = dados.Fonte or "Gotham"
	self.Cores = {}
	for k, c in pairs(dados.Cores) do
		self.Cores[k] = Color3.new(c.R or c.r or 0, c.G or c.g or 0, c.B or c.b or 0)
	end
	return self
end

function ThemeManager.ListarPresets()
	local lista={}
	for nome, p in pairs(ThemeManager.Presets) do
		table.insert(lista, { Nome=nome, Desc=p.Desc, Fonte=p.Fonte })
	end
	return lista
end

function ThemeManager:Serializar()
	return self:Exportar()
end

return ThemeManager
]]></ProtectedString></Properties></Item>
