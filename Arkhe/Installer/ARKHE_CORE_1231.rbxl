     <Properties>
      <string name="Name">NPC</string>
     </Properties>
     <Item class="ModuleScript" referent="RBX210750"><Properties><string name="Name">AutoSkin</string><ProtectedString name="Source"><![CDATA[--[[
	AutoSkin (ModuleScript)
	Local: ReplicatedStorage > Arkhe > NPC > AutoSkin
	============================================================
	F7 — CRIADOR AUTOMATICO DE SKIN: clique em QUALQUER rig e a
	Arkhe veste ele. Funciona em rigs da RigFactory E em rigs
	de fora (recolore qualquer BasePart com nome de corpo).

	- 6 temas nativos (Viking, Medieval, Deserto, Gelo, Fantasia,
	  Tech) com paletas coerentes + variacao por seed
	- Acessorios por codigo: capacete/capuz/elmo (parts na cabeca)
	- Registrar() tema proprio (dev OU IA — publicavel!)
	VERDADE: skins por textura pintada (EditableImage) vem na
	fase do relay; aqui e paleta + acessorios, e ja muda tudo.
	============================================================
]]

local AutoSkin = {}

AutoSkin.Temas = {
	Viking = {
		Peles = { Color3.fromRGB(228, 188, 152), Color3.fromRGB(210, 168, 130) },
		Torsos = { Color3.fromRGB(94, 74, 52), Color3.fromRGB(120, 90, 60), Color3.fromRGB(80, 84, 92) },
		Pernas = { Color3.fromRGB(60, 48, 36), Color3.fromRGB(74, 60, 44) },
		Chapeu = { Tipo = "Elmo", Cor = Color3.fromRGB(140, 144, 152) },
	},
	Medieval = {
		Peles = { Color3.fromRGB(234, 192, 156), Color3.fromRGB(198, 156, 120) },
		Torsos = { Color3.fromRGB(122, 62, 48), Color3.fromRGB(72, 96, 60), Color3.fromRGB(96, 82, 110) },
		Pernas = { Color3.fromRGB(58, 52, 44), Color3.fromRGB(70, 62, 50) },
		Chapeu = { Tipo = "Capuz", Cor = Color3.fromRGB(88, 70, 52) },
	},
	Deserto = {
		Peles = { Color3.fromRGB(196, 150, 110), Color3.fromRGB(170, 128, 92) },
		Torsos = { Color3.fromRGB(222, 202, 160), Color3.fromRGB(206, 180, 134) },
		Pernas = { Color3.fromRGB(180, 160, 122), Color3.fromRGB(160, 142, 106) },
		Chapeu = { Tipo = "Turbante", Cor = Color3.fromRGB(234, 220, 186) },
	},
	Gelo = {
		Peles = { Color3.fromRGB(226, 202, 186), Color3.fromRGB(240, 214, 196) },
		Torsos = { Color3.fromRGB(120, 150, 180), Color3.fromRGB(90, 120, 160) },
		Pernas = { Color3.fromRGB(70, 90, 120), Color3.fromRGB(84, 104, 130) },
		Chapeu = { Tipo = "Capuz", Cor = Color3.fromRGB(200, 220, 240) },
	},
	Fantasia = {
		Peles = { Color3.fromRGB(216, 234, 200), Color3.fromRGB(190, 214, 230), Color3.fromRGB(234, 192, 156) },
		Torsos = { Color3.fromRGB(130, 80, 180), Color3.fromRGB(60, 150, 140), Color3.fromRGB(180, 130, 60) },
		Pernas = { Color3.fromRGB(60, 50, 90), Color3.fromRGB(50, 80, 76) },
		Chapeu = { Tipo = "Chapeu", Cor = Color3.fromRGB(90, 50, 130) },
	},
	Tech = {
		Peles = { Color3.fromRGB(210, 210, 216), Color3.fromRGB(234, 192, 156) },
		Torsos = { Color3.fromRGB(40, 44, 52), Color3.fromRGB(52, 58, 70) },
		Pernas = { Color3.fromRGB(30, 32, 38), Color3.fromRGB(44, 48, 56) },
		Chapeu = { Tipo = "Visor", Cor = Color3.fromRGB(80, 200, 255) },
	},
}

local NOMES_CORPO = {
	Pele = { ["Head"] = true, ["Right Arm"] = true, ["Left Arm"] = true },
	Torso = { ["Torso"] = true, ["UpperTorso"] = true, ["LowerTorso"] = true, ["Corpo"] = true },
	Pernas = { ["Right Leg"] = true, ["Left Leg"] = true },
}

local function escolher(lista, rng)
	return lista[rng:NextInteger(1, #lista)]
end

local function acessorio(cabeca, spec, rng)
	local antigo = cabeca.Parent:FindFirstChild("ArkheAcessorio")
	if antigo then antigo:Destroy() end
	local a = Instance.new("Part")
	a.Name = "ArkheAcessorio"
	a.CanCollide = false
	a.Massless = true
	a.Color = spec.Cor
	a.Material = spec.Tipo == "Visor" and Enum.Material.Neon or Enum.Material.SmoothPlastic
	local tam = cabeca.Size
	local cf
	if spec.Tipo == "Elmo" or spec.Tipo == "Turbante" then
		a.Size = Vector3.new(tam.X * 1.15, tam.Y * 0.55, tam.Z * 1.15)
		cf = CFrame.new(0, tam.Y * 0.42, 0)
	elseif spec.Tipo == "Capuz" then
		a.Size = Vector3.new(tam.X * 1.2, tam.Y * 0.8, tam.Z * 1.2)
		cf = CFrame.new(0, tam.Y * 0.28, tam.Z * 0.12)
	elseif spec.Tipo == "Visor" then
		a.Size = Vector3.new(tam.X * 1.05, tam.Y * 0.28, 0.15)
		cf = CFrame.new(0, tam.Y * 0.1, -tam.Z * 0.55)
	else -- Chapeu
		a.Size = Vector3.new(tam.X * 1.3, tam.Y * 0.25, tam.Z * 1.3)
		cf = CFrame.new(0, tam.Y * 0.55, 0)
	end
	a.Parent = cabeca.Parent
	local solda = Instance.new("Weld")
	solda.Part0 = cabeca
	solda.Part1 = a
	solda.C0 = cf
	solda.Parent = a
	return a
end

-- ============ API ============
-- Aplica skin em QUALQUER rig. seed opcional = variacao reproduzivel
function AutoSkin.Aplicar(modelo, temaNome, seed)
	local tema = AutoSkin.Temas[temaNome]
	if not tema then return false, "tema '" .. tostring(temaNome) .. "' nao existe" end
	local rng = Random.new(seed or math.random(1, 1e6))

	local pele = escolher(tema.Peles, rng)
	local torso = escolher(tema.Torsos, rng)
	local pernas = escolher(tema.Pernas, rng)

	local conhecidas = 0
	for _, p in ipairs(modelo:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Name ~= "ArkheAcessorio" then
			if NOMES_CORPO.Pele[p.Name] then
				p.Color = pele conhecidas = conhecidas + 1
			elseif NOMES_CORPO.Torso[p.Name] then
				p.Color = torso conhecidas = conhecidas + 1
			elseif NOMES_CORPO.Pernas[p.Name] then
				p.Color = pernas conhecidas = conhecidas + 1
			end
		end
	end
	-- rig desconhecido? recolore tudo com a paleta (nunca descartar!)
	if conhecidas == 0 then
		for _, p in ipairs(modelo:GetDescendants()) do
			if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
				p.Color = rng:NextNumber() > 0.5 and torso or pernas
			end
		end
	end

	local cabeca = modelo:FindFirstChild("Head")
	if cabeca and tema.Chapeu then
		acessorio(cabeca, tema.Chapeu, rng)
	end
	return true
end

function AutoSkin.Registrar(nome, def)
	if type(nome) ~= "string" or type(def) ~= "table" then return false end
	if not (def.Peles and def.Torsos and def.Pernas) then return false end
	AutoSkin.Temas[nome] = def
	return true
end

function AutoSkin.Listar()
	local nomes = {}
	for nome in pairs(AutoSkin.Temas) do table.insert(nomes, nome) end
	table.sort(nomes)
	return nomes
end

return AutoSkin
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX914314"><Properties><string name="Name">BehaviorTree</string><ProtectedString name="Source"><![CDATA[
