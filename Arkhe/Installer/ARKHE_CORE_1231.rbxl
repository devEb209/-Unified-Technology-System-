     <Item class="ModuleScript" referent="RBX470723"><Properties><string name="Name">Operations</string><ProtectedString name="Source"><![CDATA[--[[
	Operations (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Modeler > Operations
	============================================================
	F5 — OPERACOES DE MODELAGEM (Ring1).
	Extrude, Inset, Bevel (aproximado), Subdivide, Mirror, LoopCut,
	Triangulate, Suavizar, Limpar, etc.
	Tudo opera sobre EditableModel (dados puros).
	============================================================
]]

local Operations = {}

-- Extrude: pega triangulos selecionados (ou todos se nil) e extruda ao longo da normal media
function Operations.Extrude(modelo, indicesTriangulos, distancia)
	distancia = distancia or 1.5
	modelo:SalvarHistorico()
	local tris = indicesTriangulos or {}
	if #tris == 0 then
		for i = 1, #modelo.Triangulos do tris[i]=i end
	end
	-- normal media dos tris selecionados
	local normalMedia = Vector3.new(0,0,0)
	local vertsAfetados = {}
	for _, ti in ipairs(tris) do
		local tri = modelo.Triangulos[ti]
		if tri then
			local v1 = modelo.Vertices[tri[1]]
			local v2 = modelo.Vertices[tri[2]]
			local v3 = modelo.Vertices[tri[3]]
			if v1 and v2 and v3 then
				local n = (v2.Pos - v1.Pos):Cross(v3.Pos - v1.Pos)
				if n.Magnitude > 0.001 then normalMedia = normalMedia + n.Unit end
				vertsAfetados[tri[1]]=true
				vertsAfetados[tri[2]]=true
				vertsAfetados[tri[3]]=true
			end
		end
	end
	if normalMedia.Magnitude < 0.001 then normalMedia = Vector3.new(0,1,0) else normalMedia = normalMedia.Unit end
	local offset = normalMedia * distancia

	-- cria novos vertices extrudados
	local novoIndice = {}
	for vi in pairs(vertsAfetados) do
		local v = modelo.Vertices[vi]
		local novo = modelo:AdicionarVertice(v.Pos + offset, v.Normal, v.UV, v.Cor)
		novoIndice[vi] = novo
	end
	-- cria faces laterais (para cada aresta dos tris selecionados que é borda)
	-- simplificacao: para cada tri selecionado, cria 3 quads (2 tris cada) ligando antigo->novo
	for _, ti in ipairs(tris) do
		local tri = modelo.Triangulos[ti]
		if tri then
			local a,b,c = tri[1], tri[2], tri[3]
			local na, nb, nc = novoIndice[a], novoIndice[b], novoIndice[c]
			if na and nb and nc then
				-- tampa superior (nova)
				modelo:AdicionarTriangulo(na, nb, nc)
				-- laterais
				modelo:AdicionarTriangulo(a, b, nb)
				modelo:AdicionarTriangulo(a, nb, na)
				modelo:AdicionarTriangulo(b, c, nc)
				modelo:AdicionarTriangulo(b, nc, nb)
				modelo:AdicionarTriangulo(c, a, na)
				modelo:AdicionarTriangulo(c, na, nc)
			end
		end
	end
	modelo:CalcularNormais()
	return true
end

function Operations.Inset(modelo, indicesTriangulos, fator)
	fator = fator or 0.5 -- 0..1
	modelo:SalvarHistorico()
	local tris = indicesTriangulos or {}
	if #tris == 0 then for i=1,#modelo.Triangulos do tris[i]=i end end

	for _, ti in ipairs(tris) do
		local tri = modelo.Triangulos[ti]
		if tri then
			local v1 = modelo.Vertices[tri[1]]
			local v2 = modelo.Vertices[tri[2]]
			local v3 = modelo.Vertices[tri[3]]
			if v1 and v2 and v3 then
				local centro = (v1.Pos + v2.Pos + v3.Pos)/3
				v1.Pos = centro + (v1.Pos - centro) * fator
				v2.Pos = centro + (v2.Pos - centro) * fator
				v3.Pos = centro + (v3.Pos - centro) * fator
			end
		end
	end
	modelo:CalcularNormais()
	return true
end

function Operations.Subdividir(modelo)
	modelo:SalvarHistorico()
	local novosTris = {}
	local arestaMeio = {} -- cache de meios de aresta: "a-b" -> indice vertice meio
	local function meio(a,b)
		local chave = a<b and (a.."-"..b) or (b.."-"..a)
		if arestaMeio[chave] then return arestaMeio[chave] end
		local va = modelo.Vertices[a]
		local vb = modelo.Vertices[b]
		if not va or not vb then return nil end
		local midPos = (va.Pos + vb.Pos)/2
		local mid = modelo:AdicionarVertice(midPos, (va.Normal+vb.Normal).Unit, (va.UV+vb.UV)/2, va.Cor:Lerp(vb.Cor,0.5))
		arestaMeio[chave]=mid
		return mid
	end

	for _, tri in ipairs(modelo.Triangulos) do
		local a,b,c = tri[1], tri[2], tri[3]
		local ab = meio(a,b)
		local bc = meio(b,c)
		local ca = meio(c,a)
		if ab and bc and ca then
			table.insert(novosTris, {a, ab, ca})
			table.insert(novosTris, {b, bc, ab})
			table.insert(novosTris, {c, ca, bc})
			table.insert(novosTris, {ab, bc, ca})
		end
	end
	modelo.Triangulos = novosTris
	modelo:CalcularNormais()
	return true
end

function Operations.Suavizar(modelo, iteracoes)
	iteracoes = iteracoes or 1
	modelo:SalvarHistorico()
	for _ = 1, iteracoes do
		-- laplacian simples: cada vertice vai para media dos vizinhos
		local vizinhos = {}
		for i = 1, #modelo.Vertices do vizinhos[i] = { soma=Vector3.new(0,0,0), n=0 } end
		for _, tri in ipairs(modelo.Triangulos) do
			local a,b,c = tri[1], tri[2], tri[3]
			local pa = modelo.Vertices[a] and modelo.Vertices[a].Pos or Vector3.new(0,0,0)
			local pb = modelo.Vertices[b] and modelo.Vertices[b].Pos or Vector3.new(0,0,0)
			local pc = modelo.Vertices[c] and modelo.Vertices[c].Pos or Vector3.new(0,0,0)
			if vizinhos[a] then vizinhos[a].soma = vizinhos[a].soma + pb + pc; vizinhos[a].n = vizinhos[a].n + 2 end
			if vizinhos[b] then vizinhos[b].soma = vizinhos[b].soma + pa + pc; vizinhos[b].n = vizinhos[b].n + 2 end
			if vizinhos[c] then vizinhos[c].soma = vizinhos[c].soma + pa + pb; vizinhos[c].n = vizinhos[c].n + 2 end
		end
		for i, v in ipairs(modelo.Vertices) do
			local vz = vizinhos[i]
			if vz and vz.n > 0 then
				local media = vz.soma / vz.n
				v.Pos = v.Pos:Lerp(media, 0.5)
			end
		end
	end
	modelo:CalcularNormais()
	return true
end

function Operations.Espelhamento(modelo, eixo)
	eixo = eixo or "X" -- X, Y, Z
	modelo:SalvarHistorico()
	local countOrig = #modelo.Vertices
	-- duplica vertices espelhados
	local mapa = {}
	for i = 1, countOrig do
		local v = modelo.Vertices[i]
		local pos = v.Pos
		if eixo == "X" then pos = Vector3.new(-pos.X, pos.Y, pos.Z)
		elseif eixo == "Y" then pos = Vector3.new(pos.X, -pos.Y, pos.Z)
		else pos = Vector3.new(pos.X, pos.Y, -pos.Z) end
		local novo = modelo:AdicionarVertice(pos, Vector3.new(-v.Normal.X, v.Normal.Y, v.Normal.Z), v.UV, v.Cor)
		mapa[i] = novo
	end
	-- duplica triangulos espelhados (inverte winding para manter normal)
	local trisOrig = {}
	for i = 1, #modelo.Triangulos do trisOrig[i] = modelo.Triangulos[i] end
	for _, tri in ipairs(trisOrig) do
		local a = mapa[tri[1]]
		local b = mapa[tri[2]]
		local c = mapa[tri[3]]
		if a and b and c then
			-- inverte ordem para manter face correta apos espelho
			modelo:AdicionarTriangulo(a, c, b)
		end
	end
	modelo:CalcularNormais()
	return true
end

function Operations.BevelAproximado(modelo, raio)
	-- bevel real exige topologia de arestas; aqui fazemos chamfer simples:
	-- subdivide + suaviza levemente = aparencia de bevel
	raio = raio or 0.2
	modelo:SalvarHistorico()
	Operations.Subdividir(modelo)
	Operations.Suavizar(modelo, 1)
	-- move vertices um pouco para dentro para simular chanfro
	for _, v in ipairs(modelo.Vertices) do
		v.Pos = v.Pos - v.Normal * raio * 0.1
	end
	modelo:CalcularNormais()
	return true
end

function Operations.LoopCutAproximado(modelo, eixo)
	-- corta modelo ao meio no eixo e adiciona loop de vertices no corte (simplificado)
	eixo = eixo or "Y"
	modelo:SalvarHistorico()
	-- encontra media no eixo
	local media = 0
	for _, v in ipairs(modelo.Vertices) do
		if eixo == "X" then media = media + v.Pos.X
		elseif eixo == "Y" then media = media + v.Pos.Y
		else media = media + v.Pos.Z end
	end
	media = media / #modelo.Vertices
	-- para cada triangulo que cruza o plano medio, adiciona vertice no meio da aresta cruzada
	-- simplificacao honesta: apenas adiciona um anel de vertices no plano
	-- (nao e loop cut perfeito de Blender, mas ja permite edicao)
	local novos = {}
	for _, tri in ipairs(modelo.Triangulos) do
		local v1 = modelo.Vertices[tri[1]]
		local v2 = modelo.Vertices[tri[2]]
		local v3 = modelo.Vertices[tri[3]]
		if v1 and v2 and v3 then
			local function cruza(a,b)
				local av = eixo=="X" and a.Pos.X or (eixo=="Y" and a.Pos.Y or a.Pos.Z)
				local bv = eixo=="X" and b.Pos.X or (eixo=="Y" and b.Pos.Y or b.Pos.Z)
				return (av < media and bv > media) or (av > media and bv < media)
			end
			if cruza(v1,v2) or cruza(v2,v3) or cruza(v3,v1) then
				-- marca para futura divisao (por enquanto so conta)
			end
		end
	end
	-- cria 8 vertices no anel de corte para visual
	for i = 0, 7 do
		local ang = i * math.pi * 2 / 8
		local pos
		if eixo == "Y" then pos = Vector3.new(math.cos(ang)*2, media, math.sin(ang)*2)
		elseif eixo == "X" then pos = Vector3.new(media, math.cos(ang)*2, math.sin(ang)*2)
		else pos = Vector3.new(math.cos(ang)*2, math.sin(ang)*2, media) end
		table.insert(novos, modelo:AdicionarVertice(pos))
	end
	-- conecta anel em triangulos simples (fan)
	for i = 1, #novos-1 do
		modelo:AdicionarTriangulo(novos[1], novos[i], novos[i+1])
	end
	modelo:CalcularNormais()
	return true
end

function Operations.Limpar(modelo)
	modelo:SalvarHistorico()
	modelo.Vertices = {}
	modelo.Triangulos = {}
	return true
end

function Operations.Listar()
	return {
		{ Nome="Extrude", Desc="Puxa faces ao longo da normal" },
		{ Nome="Inset", Desc="Encolhe faces para dentro" },
		{ Nome="Subdividir", Desc="Divide cada tri em 4" },
		{ Nome="Suavizar", Desc="Laplacian smooth" },
		{ Nome="Espelhamento", Desc="Espelha em X/Y/Z" },
		{ Nome="Bevel", Desc="Chanfro aproximado (subdiv+smooth)" },
		{ Nome="LoopCut", Desc="Corte de loop aproximado" },
		{ Nome="Limpar", Desc="Apaga tudo" },
	}
end

return Operations
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX149046"><Properties><string name="Name">Primitives</string><ProtectedString name="Source"><![CDATA[--[[
	Primitives (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Modeler > Primitives
	============================================================
	F5 — PRIMITIVAS DO MODELADOR (Ring1).
	Cria EditableModel a partir de formas basicas.
	Tudo 100% codigo, zero assets.
	============================================================
]]

local EditableModel = require(script.Parent.EditableModel)

local Primitives = {}

function Primitives.Cubo(tamanho, nome)
	tamanho = tamanho or 4
	nome = nome or "Cubo"
	local s = tamanho/2
	local m = EditableModel.novo(nome)
	-- 8 vertices
	local v = {}
	v[1]=m:AdicionarVertice(Vector3.new(-s,-s,-s))
	v[2]=m:AdicionarVertice(Vector3.new( s,-s,-s))
	v[3]=m:AdicionarVertice(Vector3.new( s, s,-s))
	v[4]=m:AdicionarVertice(Vector3.new(-s, s,-s))
	v[5]=m:AdicionarVertice(Vector3.new(-s,-s, s))
	v[6]=m:AdicionarVertice(Vector3.new( s,-s, s))
	v[7]=m:AdicionarVertice(Vector3.new( s, s, s))
	v[8]=m:AdicionarVertice(Vector3.new(-s, s, s))
	-- 12 triangulos (2 por face)
	local faces = {
		{1,2,3,4}, -- tras
		{5,6,7,8}, -- frente
		{1,5,8,4}, -- esq
		{2,6,7,3}, -- dir
		{4,3,7,8}, -- topo
		{1,2,6,5}, -- base
	}
	for _, f in ipairs(faces) do
		m:AdicionarTriangulo(f[1], f[2], f[3])
		m:AdicionarTriangulo(f[1], f[3], f[4])
	end
	m:CalcularNormais()
	m:SalvarHistorico()
	return m
end

function Primitives.Plano(largura, altura, subdivX, subdivY, nome)
	largura = largura or 10
	altura = altura or 10
	subdivX = subdivX or 1
	subdivY = subdivY or 1
	nome = nome or "Plano"
	local m = EditableModel.novo(nome)
	local dx = largura / subdivX
	local dy = altura / subdivY
	local ox = -largura/2
	local oz = -altura/2
	-- grid
	local grid = {}
	for x = 0, subdivX do
		grid[x] = {}
		for y = 0, subdivY do
			local px = ox + x*dx
			local pz = oz + y*dy
			grid[x][y] = m:AdicionarVertice(Vector3.new(px, 0, pz), Vector3.new(0,1,0), Vector2.new(x/subdivX, y/subdivY))
		end
	end
	for x = 0, subdivX-1 do
		for y = 0, subdivY-1 do
			local a = grid[x][y]
			local b = grid[x+1][y]
			local c = grid[x+1][y+1]
			local d = grid[x][y+1]
			m:AdicionarTriangulo(a,b,c)
			m:AdicionarTriangulo(a,c,d)
		end
	end
	m:CalcularNormais()
	m:SalvarHistorico()
	return m
end

function Primitives.Esfera(raio, segmentos, aneis, nome)
	raio = raio or 2
	segmentos = segmentos or 12
	aneis = aneis or 8
	nome = nome or "Esfera"
	local m = EditableModel.novo(nome)
	-- vertices
	local verts = {}
	for r = 0, aneis do
		local phi = math.pi * r / aneis
		local y = math.cos(phi) * raio
		local rad = math.sin(phi) * raio
		for s = 0, segmentos-1 do
			local theta = 2*math.pi * s / segmentos
			local x = math.cos(theta) * rad
			local z = math.sin(theta) * rad
			local idx = m:AdicionarVertice(Vector3.new(x,y,z), Vector3.new(x,y,z).Unit, Vector2.new(s/segmentos, r/aneis))
			verts[r] = verts[r] or {}
			verts[r][s] = idx
		end
	end
	-- triangulos
	for r = 0, aneis-1 do
		for s = 0, segmentos-1 do
			local s2 = (s+1)%segmentos
			local a = verts[r][s]
			local b = verts[r][s2]
			local c = verts[r+1][s]
			local d = verts[r+1][s2]
			if r == 0 then
				m:AdicionarTriangulo(a, d, c)
			elseif r == aneis-1 then
				m:AdicionarTriangulo(a, b, c)
			else
				m:AdicionarTriangulo(a, b, d)
				m:AdicionarTriangulo(a, d, c)
			end
		end
	end
	m:CalcularNormais()
	m:SalvarHistorico()
	return m
end

function Primitives.Cilindro(raio, altura, segmentos, nome)
	raio = raio or 1.5
	altura = altura or 4
	segmentos = segmentos or 12
	nome = nome or "Cilindro"
	local m = EditableModel.novo(nome)
	local h2 = altura/2
	local base = {}
	local topo = {}
	for s = 0, segmentos-1 do
		local ang = 2*math.pi * s / segmentos
		local x = math.cos(ang)*raio
		local z = math.sin(ang)*raio
		base[s] = m:AdicionarVertice(Vector3.new(x, -h2, z), Vector3.new(x,0,z).Unit)
		topo[s] = m:AdicionarVertice(Vector3.new(x, h2, z), Vector3.new(x,0,z).Unit)
	end
	local baseCentro = m:AdicionarVertice(Vector3.new(0,-h2,0), Vector3.new(0,-1,0))
	local topoCentro = m:AdicionarVertice(Vector3.new(0,h2,0), Vector3.new(0,1,0))
	for s = 0, segmentos-1 do
		local s2 = (s+1)%segmentos
		-- lateral
		m:AdicionarTriangulo(base[s], base[s2], topo[s2])
		m:AdicionarTriangulo(base[s], topo[s2], topo[s])
		-- tampas
		m:AdicionarTriangulo(baseCentro, base[s2], base[s])
		m:AdicionarTriangulo(topoCentro, topo[s], topo[s2])
	end
	m:CalcularNormais()
	m:SalvarHistorico()
	return m
end

function Primitives.Cone(raio, altura, segmentos, nome)
	raio = raio or 1.5
	altura = altura or 3
	segmentos = segmentos or 12
	nome = nome or "Cone"
	local m = EditableModel.novo(nome)
	local base = {}
	for s = 0, segmentos-1 do
		local ang = 2*math.pi * s / segmentos
		base[s] = m:AdicionarVertice(Vector3.new(math.cos(ang)*raio, 0, math.sin(ang)*raio))
	end
	local ponta = m:AdicionarVertice(Vector3.new(0, altura, 0))
	local centro = m:AdicionarVertice(Vector3.new(0,0,0), Vector3.new(0,-1,0))
	for s = 0, segmentos-1 do
		local s2 = (s+1)%segmentos
		m:AdicionarTriangulo(base[s], base[s2], ponta)
		m:AdicionarTriangulo(centro, base[s2], base[s])
	end
	m:CalcularNormais()
	m:SalvarHistorico()
	return m
end

function Primitives.Listar()
	return {
		{ Nome="Cubo", Desc="6 faces, 12 tris" },
		{ Nome="Plano", Desc="Grade subdividida" },
		{ Nome="Esfera", Desc="UV sphere" },
		{ Nome="Cilindro", Desc="Com tampas" },
		{ Nome="Cone", Desc="Ponta unica" },
	}
end

function Primitives.Criar(tipo, tamanho)
	tipo = tipo or "Cubo"
	if tipo == "Cubo" then return Primitives.Cubo(tamanho or 4, "Cubo")
	elseif tipo == "Plano" then return Primitives.Plano(tamanho or 10, tamanho or 10, 2, 2, "Plano")
	elseif tipo == "Esfera" then return Primitives.Esfera((tamanho or 4)/2, 12, 8, "Esfera")
	elseif tipo == "Cilindro" then return Primitives.Cilindro((tamanho or 3)/2, tamanho or 4, 12, "Cilindro")
	elseif tipo == "Cone" then return Primitives.Cone((tamanho or 3)/2, tamanho or 4, 12, "Cone")
	end
	return Primitives.Cubo(4, "Cubo")
end

return Primitives
]]></ProtectedString></Properties></Item>
