     <Item class="ModuleScript" referent="RBX577148"><Properties><string name="Name">Docking</string><ProtectedString name="Source"><![CDATA[[[
	Docking (ModuleScript)
	Local: ReplicatedStorage > Arkhe > UI > Docking
	============================================================
	F10 — SISTEMA DE DOCKING DE PAINÉIS
	- Layout salvo: cada painel { Titulo, Pos, Tamanho, Dockado, Lado }
	- Lados: Esquerda/Direita/Topo/Fundo/Centro/Flutuante
	- Operações: Dockar, Desdockar, Mover, Redimensionar, Salvar, Carregar
	- Temas: integra com ThemeManager
	- Mobile: força modo abas quando tela pequena
	============================================================
]]

local Docking = {}
Docking.__index = Docking

Docking.Lados = { "Esquerda","Direita","Topo","Fundo","Centro","Flutuante" }

function Docking.novo(nome)
	local self = setmetatable({}, Docking)
	self.Nome = nome or "LayoutPadrao"
	self.Paineis = {} -- [titulo] = { Titulo, Pos, Tamanho, Lado, Visivel, Ordem }
	self.Versao = 1
	return self
end

function Docking:RegistrarPainel(titulo, pos, tamanho, lado)
	lado = lado or "Flutuante"
	self.Paineis[titulo] = {
		Titulo=titulo,
		Pos=pos or UDim2.new(0,10,0,10),
		Tamanho=tamanho or UDim2.new(0,300,0,400),
		Lado=lado,
		Visivel=true,
		Ordem=#self.Paineis+1,
	}
	return self.Paineis[titulo]
end

function Docking:Dockar(titulo, lado, ordem)
	local p = self.Paineis[titulo]
	if not p then return false end
	p.Lado = lado
	if ordem then p.Ordem = ordem end
	p.Visivel = true
	return true
end

function Docking:Desdockar(titulo, novaPos)
	local p = self.Paineis[titulo]
	if not p then return false end
	p.Lado = "Flutuante"
	if novaPos then p.Pos = novaPos end
	return true
end

function Docking:Mover(titulo, novaPos)
	local p = self.Paineis[titulo]
	if not p then return false end
	p.Pos = novaPos
	return true
end

function Docking:Redimensionar(titulo, novoTamanho)
	local p = self.Paineis[titulo]
	if not p then return false end
	p.Tamanho = novoTamanho
	return true
end

function Docking:AlternarVisibilidade(titulo)
	local p = self.Paineis[titulo]
	if not p then return false end
	p.Visivel = not p.Visivel
	return p.Visivel
end

function Docking:ObterLayoutPorLado(lado)
	local lista={}
	for _, p in pairs(self.Paineis) do
		if p.Lado == lado then table.insert(lista, p) end
	end
	table.sort(lista, function(a,b) return a.Ordem < b.Ordem end)
	return lista
end

function Docking:Salvar()
	-- serializa para JSON-friendly
	local dados = { Nome=self.Nome, Versao=self.Versao, Paineis={} }
	for titulo, p in pairs(self.Paineis) do
		dados.Paineis[titulo] = {
			Titulo=p.Titulo,
			Lado=p.Lado,
			Visivel=p.Visivel,
			Ordem=p.Ordem,
			Pos={ XScale=p.Pos.X.Scale, XOffset=p.Pos.X.Offset, YScale=p.Pos.Y.Scale, YOffset=p.Pos.Y.Offset },
			Tamanho={ XScale=p.Tamanho.X.Scale, XOffset=p.Tamanho.X.Offset, YScale=p.Tamanho.Y.Scale, YOffset=p.Tamanho.Y.Offset },
		}
	end
	return dados
end

function Docking:Carregar(dados)
	if not dados or not dados.Paineis then return false end
	self.Nome = dados.Nome or self.Nome
	self.Versao = dados.Versao or 1
	self.Paineis = {}
	for titulo, p in pairs(dados.Paineis) do
		self.Paineis[titulo] = {
			Titulo=p.Titulo,
			Lado=p.Lado,
			Visivel=p.Visivel,
			Ordem=p.Ordem,
			Pos=UDim2.new(p.Pos.XScale, p.Pos.XOffset, p.Pos.YScale, p.Pos.YOffset),
			Tamanho=UDim2.new(p.Tamanho.XScale, p.Tamanho.XOffset, p.Tamanho.YScale, p.Tamanho.YOffset),
		}
	end
	return true
end

function Docking:Listar()
	local lista={}
	for titulo, p in pairs(self.Paineis) do
		table.insert(lista, { Titulo=titulo, Lado=p.Lado, Visivel=p.Visivel, Ordem=p.Ordem })
	end
	table.sort(lista, function(a,b) return a.Ordem < b.Ordem end)
	return lista
end

function Docking:Serializar()
	return self:Salvar()
end

return Docking
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX183674"><Properties><string name="Name">DragDrop</string><ProtectedString name="Source"><![CDATA[--[[
	DragDrop (ModuleScript)
	Local: ReplicatedStorage > Arkhe > UI > DragDrop
	============================================================
	F10 — UI BUILDER DRAG & DROP (Ring1).
	Permite arrastar componentes direto no preview, com
	ancoragem por cantos, snap, e atualizacao em tempo real.

	- Registra drag: Inicio, Movimento, Fim
	- Snap em grid 2% (opcional)
	- Ancoragem: TopLeft, TopRight, BottomLeft, BottomRight, Center
	- Limita dentro do pai (0..100%)
	- Evento OnDrop: retorna nova pos X,Y

	Integra com PainelUI: quando arrasta no preview, atualiza
	o componente no telasUI e dispara remotes.

	Verdade: 100% UI puro, sem plugins, funciona no celular
	com touch (UserInputService Touch).
	============================================================
]]

local DragDrop = {}
DragDrop.GridSnap = 2 -- %
DragDrop.Ativo = false
DragDrop.Arrastando = nil -- { Comp, OffsetX, OffsetY, InicioX, InicioY }

function DragDrop.CalcularAncoragem(x, y)
	-- x,y em % (0..100)
	if x < 33 then
		if y < 33 then return "TopLeft"
		elseif y > 66 then return "BottomLeft"
		else return "Left" end
	elseif x > 66 then
		if y < 33 then return "TopRight"
		elseif y > 66 then return "BottomRight"
		else return "Right" end
	else
		if y < 33 then return "Top"
		elseif y > 66 then return "Bottom"
		else return "Center" end
	end
end

function DragDrop.AplicarSnap(valor)
	if DragDrop.GridSnap <= 0 then return valor end
	return math.floor(valor / DragDrop.GridSnap + 0.5) * DragDrop.GridSnap
end

function DragDrop.IniciarArrastar(comp, mouseXPercent, mouseYPercent)
	DragDrop.Ativo = true
	DragDrop.Arrastando = {
		Comp = comp,
		OffsetX = mouseXPercent - comp.X,
		OffsetY = mouseYPercent - comp.Y,
		InicioX = comp.X,
		InicioY = comp.Y,
	}
end

function DragDrop.Mover(mouseXPercent, mouseYPercent)
	if not DragDrop.Ativo or not DragDrop.Arrastando then return nil end
	local comp = DragDrop.Arrastando.Comp
	local novoX = DragDrop.AplicarSnap(mouseXPercent - DragDrop.Arrastando.OffsetX)
	local novoY = DragDrop.AplicarSnap(mouseYPercent - DragDrop.Arrastando.OffsetY)
	novoX = math.clamp(novoX, 0, 100 - comp.W)
	novoY = math.clamp(novoY, 0, 100 - comp.H)
	comp.X = novoX
	comp.Y = novoY
	comp.Ancora = DragDrop.CalcularAncoragem(novoX + comp.W/2, novoY + comp.H/2)
	return novoX, novoY
end

function DragDrop.Finalizar()
	if not DragDrop.Ativo then return nil end
	local comp = DragDrop.Arrastando and DragDrop.Arrastando.Comp or nil
	local inicioX = DragDrop.Arrastando and DragDrop.Arrastando.InicioX or 0
	local inicioY = DragDrop.Arrastando and DragDrop.Arrastando.InicioY or 0
	DragDrop.Ativo = false
	DragDrop.Arrastando = nil
	if comp then
		return { Comp=comp, De={X=inicioX, Y=inicioY}, Para={X=comp.X, Y=comp.Y}, Ancora=comp.Ancora }
	end
	return nil
end

function DragDrop.ListarAncoragens()
	return { "TopLeft", "Top", "TopRight", "Left", "Center", "Right", "BottomLeft", "Bottom", "BottomRight" }
end

return DragDrop
]]></ProtectedString></Properties></Item>
