     <Item class="ModuleScript" referent="RBX206306"><Properties><string name="Name">WhyMode</string><ProtectedString name="Source"><![CDATA[--[[
	WhyMode (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Education > WhyMode
	============================================================
	F21 — EDUCACAO INVISIVEL: MODO "POR QUE?" (Ring1).
	Cada sistema pode explicar por que fez algo, ensinando
	programacao, design, fisica sem o dev perceber.

	- Registra explicacoes: sistema → acao → por que
	- Conquistas: "Primeira Folha", "Primeiro Modelo", etc
	- Dicas contextuais: quando dev erra, sugere
	- Integra com EventScript ParaLua (ja é educacao invisivel)
	- Serializavel por jogador (progresso de aprendizado)

	Exemplo:
	  WhyMode.Explicar("Physica", "Madeira boia", "Densidade 0.6 < 1.0 da agua")
	  WhyMode.Conquista(player, "PrimeiraCasa")
	============================================================
]]

local WhyMode = {}
WhyMode.Explicacoes = {} -- { Sistema, Acao, PorQue, Quando }
WhyMode.Conquistas = {} -- [userId] = { [nome]=true }
WhyMode.DefinicoesConquista = {
	PrimeiraFolha = { Nome="Primeira Folha", Desc="Criou sua primeira folha QUANDO→FACA", Icon="📜" },
	PrimeiroModelo = { Nome="Primeiro Modelo", Desc="Modelou seu primeiro modelo 3D", Icon="🧊" },
	PrimeiraAnim = { Nome="Primeira Animacao", Desc="Criou seu primeiro clip", Icon="🎬" },
	PrimeiroNPC = { Nome="Primeiro NPC", Desc="Deu vida ao primeiro NPC", Icon="🧍" },
	PrimeiroTerreno = { Nome="Primeiro Terreno", Desc="Gerou seu primeiro terreno GAIA", Icon="🌄" },
	Otimizador = { Nome="Otimizador", Desc="Otimizou para mobile", Icon="⚡" },
	Publicador = { Nome="Publicador", Desc="Publicou seu primeiro mundo", Icon="🚀" },
	Importador = { Nome="Importador", Desc="Importou um asset externo", Icon="📦" },
	Comerciante = { Nome="Comerciante", Desc="Publicou no marketplace", Icon="🏪" },
	Sonoro = { Nome="Sonoro", Desc="Criou zona de audio", Icon="🔊" },
}

function WhyMode.Explicar(sistema, acao, porque)
	table.insert(WhyMode.Explicacoes, { Sistema=sistema, Acao=acao, PorQue=porque, Quando=os.time() })
	if #WhyMode.Explicacoes > 200 then table.remove(WhyMode.Explicacoes, 1) end
	return porque
end

function WhyMode.ListarExplicacoes(sistema, limite)
	limite = limite or 20
	local lista={}
	for i=#WhyMode.Explicacoes,1,-1 do
		local e = WhyMode.Explicacoes[i]
		if not sistema or e.Sistema==sistema then
			table.insert(lista, e)
			if #lista>=limite then break end
		end
	end
	return lista
end

function WhyMode.Conquista(userId, nome)
	WhyMode.Conquistas[userId] = WhyMode.Conquistas[userId] or {}
	if WhyMode.Conquistas[userId][nome] then return false end
	WhyMode.Conquistas[userId][nome]=true
	return true, WhyMode.DefinicoesConquista[nome]
end

function WhyMode.TemConquista(userId, nome)
	return WhyMode.Conquistas[userId] and WhyMode.Conquistas[userId][nome] or false
end

function WhyMode.ListarConquistas(userId)
	local lista={}
	for nome, def in pairs(WhyMode.DefinicoesConquista) do
		table.insert(lista, { Id=nome, Nome=def.Nome, Desc=def.Desc, Icon=def.Icon, Tem=WhyMode.TemConquista(userId, nome) })
	end
	table.sort(lista, function(a,b) return a.Nome < b.Nome end)
	return lista
end

function WhyMode.DicaContextual(contexto)
	-- contexto: string como "fogo_nao_espalha", "npc_nao_move"
	local dicas = {
		fogo_nao_espalha = "Fogo precisa de materia Queimavel (madeira, grama). Rocha nao queima. Veja RRW > Materia.",
		npc_nao_move = "NPC precisa de RigFactory e NavMesh simples. Verifique se o chao tem colisao e se o cerebro esta em estado Vagar.",
		modelo_invisivel = "Modelo precisa de preview no mundo ou exportar como arquetipo RRW. Use Painel Modelar > Preview.",
		terreno_sem_arvores = "Escolha escopo 'Veg' ou 'Tudo' ao gerar terreno para plantar entidades RRW.",
		audio_nao_toca = "Audio 3D precisa de posicao perto do jogador e volume master >0. Max 8 sons simultaneos.",
	}
	return dicas[contexto] or "Nenhuma dica para " .. tostring(contexto) .. ". Pergunte a IA no chat!"
end

function WhyMode.PorQueLua(folhaNome)
	-- explica como folha virou Lua
	return "Sua folha '" .. folhaNome .. "' é codigo real! QUANDO são ifs, FACA são chamadas. Veja em Eventos > Ver o Lua desta folha. Você já programa sem perceber!"
end

return WhyMode
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX41916"><Properties><string name="Name">WhyOverlay</string><ProtectedString name="Source"><![CDATA[[[
	WhyOverlay (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Education > WhyOverlay
	============================================================
	F21 — MODO "POR QUÊ?" EM CADA PAINEL
	- Overlay que explica por que algo acontece
	- Exemplos: "Por que meu fogo não espalha?" -> RRW precisa de matéria inflamável + vento
	- Base de conhecimento: { Contexto, Pergunta, Resposta, Sistema, Link }
	- Dica contextual automática por estado do mundo
	- Integra com WhyMode + Tutorial
	============================================================
]]

local WhyOverlay = {}
WhyOverlay.__index = WhyOverlay

WhyOverlay.BaseConhecimento = {
	{ Contexto="fogo_nao_espalha", Pergunta="Por que meu fogo não espalha?", Resposta="Fogo precisa de matéria inflamável (Madeira/Pano) + oxigênio + sem chuva. Cheque RRW Materia.Inflamabilidade e clima RRW.", Sistema="RRW", Tags={"fogo","materia","clima"} },
	{ Contexto="npc_nao_move", Pergunta="Por que NPC não se move?", Resposta="NPCBrain precisa de navmesh e necessidades. Se estiver Descansando ou sem destino, fica parado. Veja billboard emoção.", Sistema="NPCBrain", Tags={"npc","brain"} },
	{ Contexto="terreno_plano", Pergunta="Por que terreno está plano?", Resposta="HeightField ainda não gerado. Use TerrainGerar com estilo ou lat/lon real. Depois esculpa com pincéis raycast.", Sistema="Terrain", Tags={"terrain","heightfield"} },
	{ Contexto="folha_nao_dispara", Pergunta="Por que folha não dispara?", Resposta="Cheque gatilho: Tick roda sempre, Evento:<nome> precisa ser disparado via EventScript:DispararEvento. Veja guard anti-loop.", Sistema="EventScript", Tags={"eventscript","folha"} },
	{ Contexto="modelo_invisivel", Pergunta="Por que modelo não aparece?", Resposta="EditableModel precisa ser materializado: D-O15 Materializer cria Partes por chunk. Verifique se está em raio de relevância.", Sistema="D-O15", Tags={"modeler","d-o15"} },
	{ Contexto="som_nao_toca", Pergunta="Por que som não toca?", Resposta="AudioMixer tem limite MaxSons3D=8. Se muitos sons, novos são cortados. Use zonas e Audio3D com raio.", Sistema="Audio", Tags={"audio","mixer"} },
	{ Contexto="versao_nao_salva", Pergunta="Por que versão não salva?", Resposta="WorldSerializer precisa de Kernel com World. Se mundo vazio, pacote pequeno mas salva. Veja VersionManager.", Sistema="Publish", Tags={"publish","version"} },
	{ Contexto="trade_falha", Pergunta="Por que trade falha?", Resposta="Trade valida inventário e saldo. Se item não existe ou saldo insuficiente, falha. Anti-dupe ativo.", Sistema="Trade", Tags={"economia","trade"} },
}

function WhyOverlay.novo()
	local self = setmetatable({}, WhyOverlay)
	self.HistoricoPerguntas = {} -- { Quando, Contexto, Pergunta }
	self.DicasMostradas = {} -- [userId] = { contexto->vezes }
	return self
end

function WhyOverlay:Buscar(contextoOuPergunta)
	contextoOuPergunta = string.lower(contextoOuPergunta or "")
	local resultados={}
	for _, entry in ipairs(WhyOverlay.BaseConhecimento) do
		if string.find(string.lower(entry.Contexto), contextoOuPergunta) or
		   string.find(string.lower(entry.Pergunta), contextoOuPergunta) or
		   string.find(string.lower(entry.Resposta), contextoOuPergunta) then
			table.insert(resultados, entry)
		end
		-- busca por tags
		for _, tag in ipairs(entry.Tags) do
			if string.find(contextoOuPergunta, tag) then
				table.insert(resultados, entry)
				break
			end
		end
	end
	-- dedup
	local unicos={}
	local vistos={}
	for _, r in ipairs(resultados) do
		if not vistos[r.Contexto] then
			vistos[r.Contexto]=true
			table.insert(unicos, r)
		end
	end
	return unicos
end

function WhyOverlay:Explicar(contexto)
	for _, entry in ipairs(WhyOverlay.BaseConhecimento) do
		if entry.Contexto == contexto then
			table.insert(self.HistoricoPerguntas, { Quando=os.time(), Contexto=contexto, Pergunta=entry.Pergunta })
			if #self.HistoricoPerguntas > 50 then table.remove(self.HistoricoPerguntas,1) end
			return entry
		end
	end
	return nil
end

function WhyOverlay:DicaContextual(estadoMundo)
	-- estadoMundo: { TemFogo, TemNPCs, TemTerreno, NumFolhas, etc }
	estadoMundo = estadoMundo or {}
	if not estadoMundo.TemTerreno then
		return self:Explicar("terreno_plano")
	elseif not estadoMundo.TemNPCs then
		return self:Explicar("npc_nao_move")
	elseif estadoMundo.TemFogo and not estadoMundo.FogoEspalha then
		return self:Explicar("fogo_nao_espalha")
	elseif estadoMundo.NumFolhas == 0 then
		return self:Explicar("folha_nao_dispara")
	end
	return nil
end

function WhyOverlay:RegistrarPergunta(userId, contexto)
	self.DicasMostradas[userId] = self.DicasMostradas[userId] or {}
	self.DicasMostradas[userId][contexto] = (self.DicasMostradas[userId][contexto] or 0) + 1
	return self:Explicar(contexto)
end

function WhyOverlay:ListarConhecimento()
	return WhyOverlay.BaseConhecimento
end

function WhyOverlay:Serializar()
	return {
		TotalConhecimento=#WhyOverlay.BaseConhecimento,
		HistoricoRecente=(function()
			local l={}
			for i=math.max(1,#self.HistoricoPerguntas-4), #self.HistoricoPerguntas do table.insert(l, self.HistoricoPerguntas[i]) end
			return l
		end)(),
	}
end

return WhyOverlay
]]></ProtectedString></Properties></Item>
    </Item>
    <Item class="Folder" referent="RBX489618">
     <Properties>
      <string name="Name">Genesis</string>
     </Properties>
     <Item class="ModuleScript" referent="RBX125831"><Properties><string name="Name">AssetBrowser</string><ProtectedString name="Source"><![CDATA[
