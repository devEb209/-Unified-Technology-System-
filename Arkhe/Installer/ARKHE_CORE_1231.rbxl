     <Item class="ModuleScript" referent="RBX382542"><Properties><string name="Name">TexturePaint</string><ProtectedString name="Source"><![CDATA[--[[
	TexturePaint (ModuleScript)
	Local: ReplicatedStorage > Arkhe > NPC > TexturePaint
	============================================================
	F7 — SKIN POR TEXTURA PINTADA (pinta textura do NPC)
	- Canvas 2D por parte do corpo (cabeça/torso/braços/pernas)
	- Pincéis: cor sólida, spray, carimbo (estampa viking etc)
	- Layers: base + detalhes + sujeira + tatuagem
	- Exporta para Decal/TextureId ou Color3 por parte
	- Integra com AutoSkin + RigFactory
	============================================================
]]

local TexturePaint = {}
TexturePaint.__index = TexturePaint

TexturePaint.Carimbos = {
	Viking = { Desc="Runas nórdicas", Pattern="Runa" },
	Medieval = { Desc="Brasão medieval", Pattern="Brasao" },
	Tribal = { Desc="Tribal espiral", Pattern="Espiral" },
	Cicatriz = { Desc="Cicatriz de batalha", Pattern="Linha" },
	Tatuagem = { Desc="Tatuagem dragão", Pattern="Dragao" },
}

TexturePaint.Pinceis = {
	Solido = { Desc="Cor sólida", Tamanho=5, Opacidade=1.0 },
	Spray = { Desc="Spray suave", Tamanho=10, Opacidade=0.5 },
	Borracha = { Desc="Apaga", Tamanho=8, Opacidade=1.0 },
	Carimbo = { Desc="Carimbo padrão", Tamanho=15, Opacidade=1.0 },
}

function TexturePaint.novo(nome, largura, altura)
	local self = setmetatable({}, TexturePaint)
	self.Nome = nome or "SkinPaint_"..math.random(1000,9999)
	self.Largura = largura or 128
	self.Altura = altura or 128
	self.Layers = {
		Base = { Nome="Base", Cor=Color3.fromRGB(220,180,140), Visivel=true, Pixels={} },
		Detalhes = { Nome="Detalhes", Cor=Color3.fromRGB(0,0,0), Visivel=true, Pixels={} },
		Sujeira = { Nome="Sujeira", Cor=Color3.fromRGB(80,60,40), Visivel=true, Pixels={} },
		Tatuagem = { Nome="Tatuagem", Cor=Color3.fromRGB(30,30,30), Visivel=true, Pixels={} },
	}
	-- inicializa pixels base
	for x=1,self.Largura do
		self.Layers.Base.Pixels[x]={}
		for y=1,self.Altura do
			self.Layers.Base.Pixels[x][y]=self.Layers.Base.Cor
		end
	end
	for _, layerName in ipairs({"Detalhes","Sujeira","Tatuagem"}) do
		for x=1,self.Largura do
			self.Layers[layerName].Pixels[x]={}
			for y=1,self.Altura do
				self.Layers[layerName].Pixels[x][y]=nil -- transparente
			end
		end
	end
	self.Historico = {}
	return self
end

function TexturePaint:Pintar(layerNome, centroX, centroY, raio, cor, pincel)
	layerNome = layerNome or "Detalhes"
	pincel = pincel or "Solido"
	local layer = self.Layers[layerNome]
	if not layer then return 0 end
	raio = raio or 5
	local afetados=0
	for dx=-raio, raio do
		for dy=-raio, raio do
			local x=centroX+dx; local y=centroY+dy
			if layer.Pixels[x] and layer.Pixels[x][y] ~= nil or layer.Pixels[x] then
				local dist = math.sqrt(dx*dx+dy*dy)
				if dist <= raio then
					if pincel=="Borracha" then
						layer.Pixels[x][y]=nil
					else
						local falloff = pincel=="Spray" and (1-dist/raio)*0.5 or 1
						if math.random() < falloff then
							layer.Pixels[x][y]=cor or layer.Cor
							afetados=afetados+1
						end
					end
				end
			end
		end
	end
	table.insert(self.Historico, { Quando=os.time(), Layer=layerNome, Centro={X=centroX,Y=centroY}, Raio=raio, Cor=cor, Pincel=pincel, Afetados=afetados })
	if #self.Historico > 30 then table.remove(self.Historico,1) end
	return afetados
end

function TexturePaint:Carimbar(layerNome, centroX, centroY, carimboNome, cor, escala)
	local carimbo = TexturePaint.Carimbos[carimboNome]
	if not carimbo then return 0 end
	escala = escala or 1
	-- simula carimbo como cruz ou círculo
	local raio = math.floor(8*escala)
	return self:Pintar(layerNome, centroX, centroY, raio, cor, "Carimbo")
end

function TexturePaint:ObterCorFinal(x,y)
	-- compõe layers de baixo para cima
	local cor = self.Layers.Base.Pixels[x] and self.Layers.Base.Pixels[x][y] or self.Layers.Base.Cor
	for _, layerName in ipairs({"Detalhes","Sujeira","Tatuagem"}) do
		local layer = self.Layers[layerName]
		if layer.Visivel and layer.Pixels[x] and layer.Pixels[x][y] then
			cor = layer.Pixels[x][y] -- sobrepõe (sem alpha blend simplificado)
		end
	end
	return cor
end

function TexturePaint:ExportarParaPartes()
	-- retorna cores médias por parte do corpo (para aplicar em Part Color)
	local mediaR, mediaG, mediaB = 0,0,0
	local count=0
	for x=1, self.Largura do
		for y=1, self.Altura do
			local cor = self:ObterCorFinal(x,y)
			if cor then
				mediaR=mediaR+cor.R; mediaG=mediaG+cor.G; mediaB=mediaB+cor.B; count=count+1
			end
		end
	end
	if count==0 then return self.Layers.Base.Cor end
	return Color3.new(mediaR/count, mediaG/count, mediaB/count)
end

function TexturePaint:ListarCarimbos()
	local lista={}
	for nome, info in pairs(TexturePaint.Carimbos) do table.insert(lista, { Nome=nome, Desc=info.Desc, Pattern=info.Pattern }) end
	return lista
end

function TexturePaint:ListarPinceis()
	local lista={}
	for nome, info in pairs(TexturePaint.Pinceis) do table.insert(lista, { Nome=nome, Desc=info.Desc, Tamanho=info.Tamanho }) end
	return lista
end

function TexturePaint:Serializar()
	return {
		Nome=self.Nome,
		Largura=self.Largura,
		Altura=self.Altura,
		Layers=(function() local l={} for k,_ in pairs(self.Layers) do table.insert(l,k) end return l end)(),
		CorMedia={ R=self:ExportarParaPartes().R, G=self:ExportarParaPartes().G, B=self:ExportarParaPartes().B },
		Historico=#self.Historico,
	}
end

return TexturePaint
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX131672"><Properties><string name="Name">UtilityAI</string><ProtectedString name="Source"><![CDATA[
local UtilityAI = {}
function UtilityAI.novo() return setmetatable({Nome="UtilityAI", Ativo=true, Dados={}}, {__index=UtilityAI}) end
function UtilityAI:Ativar() self.Ativo=true end
function UtilityAI:Desativar() self.Ativo=false end
function UtilityAI:Tick(dt) end
function UtilityAI:Serializar() return {Nome=self.Nome, Ativo=self.Ativo} end
return UtilityAI
]]></ProtectedString></Properties></Item>
    </Item>
    <Item class="Folder" referent="RBX692782">
     <Properties>
      <string name="Name">Optimize</string>
     </Properties>
     <Item class="ModuleScript" referent="RBX550793"><Properties><string name="Name">Analyzer</string><ProtectedString name="Source"><![CDATA[--[[
	Analyzer (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Optimize > Analyzer
	============================================================
	F13 — AUTO-OTIMIZACAO: ANALISADOR DE MUNDO (Ring1).
	Analisa Workspace + RRW + Terrain + NPC + UI + Visual + Physica
	e compara com orcamentos por plataforma.
	============================================================
]]

local Analyzer = {}

Analyzer.Orcamentos = {
	MobileFraco = {
		Nome = "Celular fraco (Android 3GB)",
		MaxParts = 900,
		MaxMeshParts = 200,
		MaxLuzes = 8,
		MaxParticulas = 30,
		MaxTerrainWedges = 380,
		MaxNPCs = 8,
		MaxUIComps = 35,
		MaxFolhas = 30,
		MaxEntidadesRRW = 400,
		SombraMaxPartSize = 6,
	},
	MobileMedio = {
		Nome = "Celular medio (Android 6GB / iPhone 11)",
		MaxParts = 1600,
		MaxMeshParts = 450,
		MaxLuzes = 18,
		MaxParticulas = 80,
		MaxTerrainWedges = 700,
		MaxNPCs = 16,
		MaxUIComps = 60,
		MaxFolhas = 60,
		MaxEntidadesRRW = 800,
		SombraMaxPartSize = 4,
	},
	PC = {
		Nome = "PC / Notebook gamer",
		MaxParts = 6000,
		MaxMeshParts = 1500,
		MaxLuzes = 70,
		MaxParticulas = 300,
		MaxTerrainWedges = 2200,
		MaxNPCs = 50,
		MaxUIComps = 150,
		MaxFolhas = 200,
		MaxEntidadesRRW = 3000,
		SombraMaxPartSize = 2,
	},
	Console = {
		Nome = "Console (Xbox/PS)",
		MaxParts = 4500,
		MaxMeshParts = 1100,
		MaxLuzes = 50,
		MaxParticulas = 200,
		MaxTerrainWedges = 1600,
		MaxNPCs = 32,
		MaxUIComps = 100,
		MaxFolhas = 120,
		MaxEntidadesRRW = 2000,
		SombraMaxPartSize = 3,
	},
}

local function contarWorkspace()
	local stats = {
		BaseParts = 0,
		MeshParts = 0,
		Luzes = 0,
		Particulas = 0,
		Scripts = 0,
		PartesPequenasComSombra = 0,
		PartesAncoradas = 0,
		PartesNaoAncoradas = 0,
		Detalhe = { LuzesLista = {}, ParticulasLista = {} },
	}
	local ok, lista = pcall(function() return workspace:GetDescendants() end)
	if not ok then return stats end
	for _, inst in ipairs(lista) do
		if inst:IsA("BasePart") then
			stats.BaseParts = stats.BaseParts + 1
			if inst:IsA("MeshPart") then stats.MeshParts = stats.MeshParts + 1 end
			if inst.Anchored then stats.PartesAncoradas = stats.PartesAncoradas + 1
			else stats.PartesNaoAncoradas = stats.PartesNaoAncoradas + 1 end
			if inst.CastShadow then
				local s = inst.Size
				local menor = math.min(s.X, s.Y, s.Z)
				if menor < 4 then
					stats.PartesPequenasComSombra = stats.PartesPequenasComSombra + 1
				end
			end
		elseif inst:IsA("PointLight") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight") then
			stats.Luzes = stats.Luzes + 1
			if #stats.Detalhe.LuzesLista < 8 then
				table.insert(stats.Detalhe.LuzesLista, inst:GetFullName())
			end
		elseif inst:IsA("ParticleEmitter") then
			stats.Particulas = stats.Particulas + 1
			if #stats.Detalhe.ParticulasLista < 8 then
				table.insert(stats.Detalhe.ParticulasLista, inst:GetFullName() .. " Rate=" .. tostring(inst.Rate))
			end
		elseif inst:IsA("Script") or inst:IsA("LocalScript") then
			stats.Scripts = stats.Scripts + 1
		end
	end
	return stats
end

local function contarTerrain(Kernel)
	local stats = { Existe = false, Chunks = 0, Wedges = 0, Largura = 0 }
	local ok, campo = pcall(function()
		return Kernel and Kernel.Obter and Kernel.Obter("TerrainCampo") or nil
	end)
	if campo then
		stats.Existe = true
		stats.Largura = campo.Largura or 0
	end
	local ok2, render = pcall(function()
		return Kernel and Kernel.Obter and Kernel.Obter("TerrainRender") or nil
	end)
	if ok2 and render then
		local pasta = workspace:FindFirstChild("ArkheTerrain")
		if pasta then
			local wedges = 0
			for _, obj in ipairs(pasta:GetDescendants()) do
				if obj.Name == "Wedge" or obj:IsA("WedgePart") then wedges = wedges + 1 end
			end
			stats.Wedges = wedges
		end
	end
	return stats
end

local function contarNPCs(Kernel)
	local stats = { Total = 0, Max = 30, Personalidades = 0 }
	local ok, brain = pcall(function()
		return Kernel and Kernel.Obter and Kernel.Obter("NPCBrain") or nil
	end)
	if ok and brain and brain.Contar then
		local ok2, total = pcall(brain.Contar)
		if ok2 then stats.Total = total or 0 end
		stats.Max = brain.MaxNPCs or 30
		local pers = 0
		for _ in pairs(brain.Personalidades or {}) do pers = pers + 1 end
		stats.Personalidades = pers
	end
	return stats
end

local function contarUI(Kernel)
	local stats = { Telas = 0, Componentes = 0, Nomes = {} }
	local ok, telas = pcall(function()
		return Kernel and Kernel.Obter and Kernel.Obter("TelasUI") or nil
	end)
	if ok and type(telas) == "table" then
		stats.Telas = #telas
		for _, t in ipairs(telas) do
			stats.Componentes = stats.Componentes + #(t.Comps or {})
			if #stats.Nomes < 10 then table.insert(stats.Nomes, t.Nome) end
		end
	end
	return stats
end

local function contarRRW(Kernel)
	local stats = { Total = 0, PorArquetipo = {}, Folhas = 0 }
	local ok, mundo = pcall(function()
		return Kernel and Kernel.Obter and Kernel.Obter("Mundo") or nil
	end)
	if ok and mundo and mundo.Entidades then
		for _, e in pairs(mundo.Entidades) do
			stats.Total = stats.Total + 1
			stats.PorArquetipo[e.Arquetipo] = (stats.PorArquetipo[e.Arquetipo] or 0) + 1
		end
	end
	local ok2, es = pcall(function()
		return Kernel and Kernel.Obter and Kernel.Obter("EventScript") or require(game:GetService("ReplicatedStorage").Arkhe.Kernel.EventScript)
	end)
	if not ok2 then
		local ok3, mod = pcall(function()
			return require(game:GetService("ReplicatedStorage").Arkhe.Kernel.EventScript)
		end)
		if ok3 and mod then es = mod end
	end
	if es and es.Folhas then stats.Folhas = #es.Folhas end
	return stats
end

local function contarDO15(Kernel)
	local stats = { PorFrame = 6, Fidelidade = "desconhecido", Pressao = 0 }
	local ok, mat = pcall(function()
		return Kernel and Kernel.Obter and Kernel.Obter("Materializer") or nil
	end)
	if ok and mat then
		stats.PorFrame = mat.PorFrame or 6
		local mundo = Kernel.Obter("Mundo")
		if mundo then
			local pendentes = 0
			for _, e in pairs(mundo.Entidades) do
				if e.Materializacao < 2 then pendentes = pendentes + 1 end
			end
			stats.Pressao = pendentes
		end
	end
	return stats
end

function Analyzer.Auditar(plataformaNome, Kernel)
	plataformaNome = plataformaNome or "MobileMedio"
	local orc = Analyzer.Orcamentos[plataformaNome] or Analyzer.Orcamentos.MobileMedio

	local ws = contarWorkspace()
	local terrain = contarTerrain(Kernel)
	local npcs = contarNPCs(Kernel)
	local ui = contarUI(Kernel)
	local rrw = contarRRW(Kernel)
	local do15 = contarDO15(Kernel)

	local achados = {}

	local function add(sev, sis, msg, sug, acao)
		table.insert(achados, {
			Severidade = sev,
			Sistema = sis,
			Mensagem = msg,
			Sugestao = sug,
			Acao = acao,
		})
	end

	if ws.BaseParts > orc.MaxParts then
		add("Critico", "Workspace",
			"BaseParts: " .. ws.BaseParts .. " / limite " .. orc.MaxParts .. " para " .. orc.Nome,
			"Use o otimizador para desativar sombras de pecas pequenas e reduzir decoracao.",
			"DesativarSombrasPequenas")
	elseif ws.BaseParts > orc.MaxParts * 0.75 then
		add("Aviso", "Workspace",
			"BaseParts: " .. ws.BaseParts .. " (75% do limite " .. orc.MaxParts .. ")",
			"Considere agrupar decoracao ou remover pecas invisiveis.", nil)
	else
		add("Info", "Workspace", "BaseParts: " .. ws.BaseParts .. " dentro do orcamento.", nil, nil)
	end

	if ws.MeshParts > orc.MaxMeshParts then
		add("Aviso", "Workspace",
			"MeshParts: " .. ws.MeshParts .. " / " .. orc.MaxMeshParts,
			"MeshParts custam mais memoria em celular.", nil)
	end

	if ws.Luzes > orc.MaxLuzes then
		add("Critico", "Iluminacao",
			"Luzes dinamicas: " .. ws.Luzes .. " / " .. orc.MaxLuzes,
			"Cada luz dinamica custa caro em mobile.",
			"ReduzirLuzes")
	elseif ws.Luzes > orc.MaxLuzes * 0.7 then
		add("Aviso", "Iluminacao", "Luzes: " .. ws.Luzes .. " perto do limite.", nil, nil)
	end

	if ws.Particulas > orc.MaxParticulas then
		add("Aviso", "Particulas",
			"ParticleEmitters: " .. ws.Particulas .. " / " .. orc.MaxParticulas,
			"Reduza Rate de particulas decorativas.",
			"ReduzirParticulas")
	end

	if ws.PartesPequenasComSombra > 30 then
		add("Aviso", "Sombras",
			ws.PartesPequenasComSombra .. " pecas pequenas (<4 studs) com CastShadow ligado",
			"Desativar sombra de decoracao pequena ganha 5-15 FPS em celular.",
			"DesativarSombrasPequenas")
	end

	if ws.PartesNaoAncoradas > 80 then
		add("Aviso", "Fisica",
			ws.PartesNaoAncoradas .. " partes nao-ancoradas (fisica ativa)",
			"Ancore decoracao. Fisica custa CPU.",
			"AncorarDecoracao")
	end

	if terrain.Existe then
		if terrain.Wedges > orc.MaxTerrainWedges then
			add("Critico", "Terrain",
				"Wedges do terreno: " .. terrain.Wedges .. " / " .. orc.MaxTerrainWedges,
				"Aumente LOD ou reduza largura. Otimizador ajusta orcamento por tick.",
				"AjustarTerrainLOD")
		else
			add("Info", "Terrain",
				"Terreno ativo (Largura=" .. terrain.Largura .. ", Wedges~" .. terrain.Wedges .. ")",
				nil, nil)
		end
	else
		add("Info", "Terrain", "Nenhum terreno Arkhe gerado ainda.", "Gere no painel Terrain.", nil)
	end

	if npcs.Total > orc.MaxNPCs then
		add("Critico", "NPC",
			"NPCs: " .. npcs.Total .. " / limite " .. orc.MaxNPCs .. " para " .. orc.Nome,
			"Reduza NPCs ou use LOD de cerebro. Otimizador limita MaxNPCs.",
			"LimitarNPCs")
	elseif npcs.Total > 0 then
		add("Info", "NPC", "NPCs: " .. npcs.Total .. " (max " .. npcs.Max .. "), " .. npcs.Personalidades .. " personalidades.", nil, nil)
	end

	if ui.Componentes > orc.MaxUIComps then
		add("Aviso", "UI",
			"Componentes de UI: " .. ui.Componentes .. " / " .. orc.MaxUIComps,
			"UI em % e leve, mas muitos componentes poluem celular.",
			nil)
	else
		add("Info", "UI", "UI: " .. ui.Telas .. " telas, " .. ui.Componentes .. " componentes.", nil, nil)
	end

	if rrw.Total > orc.MaxEntidadesRRW then
		add("Critico", "RRW",
			"Entidades RRW: " .. rrw.Total .. " / " .. orc.MaxEntidadesRRW,
			"RRW e leve, mas acima de 2000 custa no tick de causalidade.",
			"AjustarCausalidade")
	else
		add("Info", "RRW", "RRW: " .. rrw.Total .. " entidades, " .. rrw.Folhas .. " folhas EventScript.", nil, nil)
	end

	]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX387170"><Properties><string name="Name">AutoRestore</string><ProtectedString name="Source"><![CDATA[--[[
  AutoRestore (ModuleScript)
  Local: ReplicatedStorage > Arkhe > Optimize > AutoRestore
  ============================================================================
  F13 — RESTAURA AUTO (o que faltava pra 100%)
  - Snapshot automático do mundo a cada N segundos
  - Restaura para último snapshot estável se FPS < threshold ou crash
  - Integra com LiveOptimizer + VersionManager
  - Contrato: Registrar, Tick, Restaurar, Payload para relay
  ============================================================================
]]

local AutoRestore = {}
AutoRestore.__index = AutoRestore

function AutoRestore.novo(nome)
    local self = setmetatable({}, AutoRestore)
    self.Nome = nome or "AutoRestore"
    self.Snapshots = {} -- { Tempo, Pacote, FPS, Memoria }
    self.MaxSnapshots = 10
    self.Intervalo = 30 -- segundos
    self.UltimoSave = 0
    self.FPSMinimo = 20
    self.Ativo = true
    return self
end

function AutoRestore:Registrar(pacote, fps, memoria)
    if not self.Ativo then return false end
    if #self.Snapshots >= self.MaxSnapshots then
        table.remove(self.Snapshots, 1)
    end
    table.insert(self.Snapshots, {
        Tempo = os.time(),
        Pacote = pacote,
        FPS = fps or 60,
        Memoria = memoria or 0,
    })
    self.UltimoSave = os.time()
    return true
end

function AutoRestore:Tick(dt, fpsAtual, serializer, kernel)
    if not self.Ativo then return nil end
    self.UltimoSave = self.UltimoSave + dt
    if self.UltimoSave >= self.Intervalo then
        self.UltimoSave = 0
        if serializer and kernel then
            local ok, pacote = pcall(function() return serializer.ExportarPacote(kernel) end)
            if ok and pacote then
                self:Registrar(pacote, fpsAtual, 0)
            end
        end
    end
    -- detecta necessidade de restaura
    if fpsAtual and fpsAtual < self.FPSMinimo and #self.Snapshots > 1 then
        return self:Restaurar(-2) -- penúltimo estável
    end
    return nil
end

function AutoRestore:Restaurar(indice)
    indice = indice or -1
    if #self.Snapshots == 0 then return nil, "sem snapshots" end
    local idx = indice
    if indice < 0 then idx = #self.Snapshots + indice + 1 end
    idx = math.max(1, math.min(idx, #self.Snapshots))
    local snap = self.Snapshots[idx]
    return snap.Pacote, snap
end

function AutoRestore:Listar()
    local lista = {}
    for i, s in ipairs(self.Snapshots) do
        table.insert(lista, { Indice=i, Tempo=s.Tempo, FPS=s.FPS, Memoria=s.Memoria })
    end
    return lista
end

function AutoRestore:Serializar()
    return {
        Nome=self.Nome,
        Total=self.Snapshots and #self.Snapshots or 0,
        Max=self.MaxSnapshots,
        Intervalo=self.Intervalo,
        FPSMinimo=self.FPSMinimo,
        Ativo=self.Ativo,
    }
end

return AutoRestore
]]></ProtectedString></Properties></Item>
