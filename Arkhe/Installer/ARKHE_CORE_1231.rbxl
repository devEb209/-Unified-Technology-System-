     <Item class="ModuleScript" referent="RBX232325"><Properties><string name="Name">AssetImporter</string><ProtectedString name="Source"><![CDATA[--[[
	AssetImporter (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Import > AssetImporter
	============================================================
	F11 — IMPORTACAO DE ASSETS (Ring1).

	Fluxos:
	1) Roblox AssetId (InsertService) — ja funciona, 100% in-game.
	2) FBX/GLB/OBJ/Blend via relay:
	   - Dev cola URL do arquivo (ou faz upload no relay)
	   - Relay converte: FBX/GLB → Mesh + Texturas → Open Cloud Assets API
	   - Relay devolve assetId / meshId pronto para inserir via InsertService
	   - Sem relay: explica limitacao real (sem fantasia)
	3) Heightmap PNG/JPG via relay ou base64 local → HeightField
	4) Audio via Open Cloud (relay faz upload)

	Contrato relay:
	  POST /import/convert { Url, Tipo=FBX|GLB|OBJ|PNG|MP3|WAV, Nome, Autor }
	  → { Sucesso, AssetId?, MeshId?, Texturas?, Erro? }

	Verdade: Roblox NAO deixa importar FBX/GLB direto em runtime.
	Precisa do relay + Open Cloud Assets. Mas com relay, é 1 clique.
	============================================================
]]

local AssetImporter = {}

AssetImporter.TiposSuportados = {
	FBX = { Desc="Autodesk FBX — modelo com rig opcional", Exts={"fbx"} },
	GLB = { Desc="glTF binary — PBR completo", Exts={"glb","gltf"} },
	OBJ = { Desc="Wavefront OBJ — geometria simples", Exts={"obj"} },
	PNG = { Desc="Heightmap ou textura", Exts={"png","jpg","jpeg"} },
	MP3 = { Desc="Audio", Exts={"mp3","wav","ogg"} },
	RBXMX = { Desc="Roblox model XML", Exts={"rbxmx","rbxm"} },
}

function AssetImporter.ListarTipos()
	local lista = {}
	for nome, info in pairs(AssetImporter.TiposSuportados) do
		table.insert(lista, { Nome=nome, Descricao=info.Desc })
	end
	table.sort(lista, function(a,b) return a.Nome < b.Nome end)
	return lista
end

-- Importa asset Roblox por Id (ja existe no GenesisServer, mas aqui como modulo reutilizavel)
function AssetImporter.ImportarRobloxAsset(assetId, pos)
	assetId = tonumber(assetId)
	if not assetId then return nil, "Id invalido" end
	local InsertService = game:GetService("InsertService")
	local ok, modelo = pcall(function() return InsertService:LoadAsset(assetId) end)
	if not ok or not modelo then return nil, "Falha ao carregar asset " .. assetId .. " (precisa ser publico/seu)" end
	if pos then
		pcall(function() modelo:PivotTo(CFrame.new(pos)) end)
	end
	modelo.Name = "RobloxAsset_" .. assetId
	modelo.Parent = workspace
	return modelo
end

-- Importa via relay (FBX/GLB/OBJ/etc)
function AssetImporter.ImportarViaRelay(url, tipo, nome, autor, chamarRelayFn)
	tipo = tipo or "GLB"
	nome = nome or "ModeloImportado"
	autor = autor or "Dev"
	if not chamarRelayFn then return nil, "sem_relay" end
	local resposta, err = chamarRelayFn("/import/convert", {
		Url = url,
		Tipo = tipo,
		Nome = nome,
		Autor = autor,
	})
	if not resposta then return nil, err or "falha_relay" end
	if resposta.Sucesso and resposta.AssetId then
		-- tenta inserir o asset convertido
		local modelo, err2 = AssetImporter.ImportarRobloxAsset(resposta.AssetId)
		if modelo then
			return modelo, nil, resposta
		else
			return nil, err2, resposta
		end
	end
	return nil, resposta.Erro or "conversao_falhou", resposta
end

-- Heightmap: matriz 2D de alturas (0..1) -> HeightField
function AssetImporter.AplicarHeightmapComoTerreno(matriz, Kernel)
	local HeightField = nil
	local ok, mod = pcall(function() return Kernel and Kernel.Obter and Kernel.Obter("HeightField") or require(game:GetService("ReplicatedStorage").Arkhe.Terrain.HeightField) end)
	if not ok then
		local ok2, m = pcall(function() return require(game:GetService("ReplicatedStorage").Arkhe.Terrain.HeightField) end)
		if ok2 then HeightField = m end
	else
		HeightField = mod
	end
	if not HeightField then return nil, "HeightField nao encontrado" end
	local campo = HeightField.nova({ Largura = 96, Celula = 12 })
	-- matriz esperada: { {0..1, ...}, ... } -> converte para metros
	local ok2 = campo:CarregarMatriz(matriz, 0.3)
	if not ok2 then return nil, "matriz invalida" end
	return campo
end

function AssetImporter.CriarPlaceholderImportado(nome, pos, tipo)
	-- cria placeholder visual quando relay nao esta configurado
	local part = Instance.new("Part")
	part.Name = nome or ("Import_" .. tipo)
	part.Anchored = true
	part.Size = Vector3.new(4,4,4)
	part.Position = pos or Vector3.new(0,5,0)
	part.Color = Color3.fromRGB(180, 180, 255)
	part.Material = Enum.Material.Neon
	local tag = Instance.new("BillboardGui", part)
	tag.Size = UDim2.new(0,200,0,50)
	tag.StudsOffset = Vector3.new(0,3,0)
	tag.AlwaysOnTop = true
	local txt = Instance.new("TextLabel", tag)
	txt.Size = UDim2.new(1,0,1,0)
	txt.BackgroundTransparency = 1
	txt.TextColor3 = Color3.new(1,1,1)
	txt.TextScaled = true
	txt.Text = "📦 " .. (nome or tipo) .. "\n(precisa relay)"
	txt.Font = Enum.Font.GothamBold
	part.Parent = workspace
	return part
end

return AssetImporter
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX472140"><Properties><string name="Name">BLENDLoader</string><ProtectedString name="Source"><![CDATA[
