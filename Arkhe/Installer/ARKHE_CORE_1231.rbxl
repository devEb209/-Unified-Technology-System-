     <Item class="ModuleScript" referent="RBX688176"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[--[[
	Shop (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Economy > Shop
	============================================================
	F18 — KIT ECONOMIA: LOJA (Ring1).
	Loja que vende itens do Inventory por moedas (moeda Arkhe R$k).
	- Itens com preco, estoque, desconto
	- Compra/venda com validacao
	- Integra com MarketplaceService (preco global) e com EventScript
	  (DarMoedas/TirarMoedas/DarItem)
	- Eventos: OnCompra, OnVenda
	- Serializavel

	Exemplo:
	  local shop = Shop.novo("Loja da Vila")
	  shop:AdicionarItem("EspadaMadeira", 50, 10) -- nome, preco, estoque
	  shop:Comprar(jogadorInv, "EspadaMadeira", jogadorMoedas)
	============================================================
]]

local Shop = {}
Shop.__index = Shop

function Shop.novo(nome)
	local self = setmetatable({}, Shop)
	self.Nome = nome or "Loja"
	self.Itens = {} -- [nome] = { Preco, Estoque, Desconto }
	self.MoedasTotais = 0
	self._onCompra = {}
	self._onVenda = {}
	return self
end

function Shop:AdicionarItem(nome, preco, estoque, desconto)
	preco = preco or 10
	estoque = estoque or -1 -- -1 = infinito
	desconto = desconto or 0
	self.Itens[nome] = { Preco=preco, Estoque=estoque, Desconto=desconto }
end

function Shop:RemoverItem(nome)
	self.Itens[nome]=nil
end

function Shop:PrecoFinal(nome)
	local item = self.Itens[nome]
	if not item then return nil end
	return math.max(1, math.floor(item.Preco * (1 - (item.Desconto or 0))))
end

function Shop:Comprar(inventario, nome, moedasRef)
	-- moedasRef: tabela { Valor=100 } ou numero por referencia via retorno
	-- Para simplificar: inventario e moedas sao do jogador (tabela mutavel)
	-- moedasRef pode ser { Moedas=... } ou numero direto (retornamos novo valor)
	local item = self.Itens[nome]
	if not item then return false, "item_nao_existe" end
	if item.Estoque == 0 then return false, "sem_estoque" end
	local preco = self:PrecoFinal(nome)
	-- moedasRef pode ser numero ou tabela
	local moedasAtuais
	if type(moedasRef)=="table" then moedasAtuais = moedasRef.Moedas or moedasRef.Valor or 0 else moedasAtuais = moedasRef or 0 end
	if moedasAtuais < preco then return false, "sem_moedas" end
	-- tenta adicionar no inventario
	local ok, err = inventario:Adicionar(nome, 1)
	if not ok then return false, err end
	-- desconta moedas
	if type(moedasRef)=="table" then
		if moedasRef.Moedas ~= nil then moedasRef.Moedas = moedasRef.Moedas - preco else moedasRef.Valor = moedasRef.Valor - preco end
	end
	if item.Estoque > 0 then item.Estoque = item.Estoque - 1 end
	self.MoedasTotais = self.MoedasTotais + preco
	for _, fn in ipairs(self._onCompra) do pcall(fn, nome, preco) end
	return true, preco
end

function Shop:Vender(inventario, nome, moedasRef)
	local item = self.Itens[nome]
	if not item then
		-- aceita venda mesmo se loja nao vende (preco = metade do catalogo?)
		item = { Preco=5 }
	end
	if not inventario:Tem(nome, 1) then return false, "sem_item" end
	local precoVenda = math.floor((item.Preco or 5) * 0.5)
	inventario:Remover(nome, 1)
	if type(moedasRef)=="table" then
		if moedasRef.Moedas ~= nil then moedasRef.Moedas = moedasRef.Moedas + precoVenda else moedasRef.Valor = moedasRef.Valor + precoVenda end
	end
	if item.Estoque >=0 then item.Estoque = item.Estoque + 1 end
	self.MoedasTotais = math.max(0, self.MoedasTotais - precoVenda)
	for _, fn in ipairs(self._onVenda) do pcall(fn, nome, precoVenda) end
	return true, precoVenda
end

function Shop:Listar()
	local lista = {}
	for nome, data in pairs(self.Itens) do
		table.insert(lista, { Nome=nome, Preco=data.Preco, PrecoFinal=self:PrecoFinal(nome), Estoque=data.Estoque, Desconto=data.Desconto })
	end
	table.sort(lista, function(a,b) return a.Nome < b.Nome end)
	return lista
end

function Shop:OnCompra(fn) table.insert(self._onCompra, fn) end
function Shop:OnVenda(fn) table.insert(self._onVenda, fn) end

function Shop:Serializar()
	return { Nome=self.Nome, Itens=self.Itens, MoedasTotais=self.MoedasTotais }
end

function Shop.Deserializar(dados)
	local shop = Shop.novo(dados.Nome)
	shop.Itens = dados.Itens or {}
	shop.MoedasTotais = dados.MoedasTotais or 0
	return shop
end

return Shop
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX236744"><Properties><string name="Name">System1016_Economy</string><ProtectedString name="Source"><![CDATA[
