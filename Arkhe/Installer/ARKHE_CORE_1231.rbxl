     <Item class="ModuleScript" referent="RBX918329"><Properties><string name="Name">Archetypes</string><ProtectedString name="Source"><![CDATA[--[[
	Archetypes (ModuleScript)
	Local: ReplicatedStorage > Arkhe > RRW > Archetypes
	============================================================
	Um arquetipo e a DESCRICAO SEMANTICA de uma coisa da realidade.
	"Carvalho" nao e um modelo 3D — e conhecimento: materia, forma,
	comportamento e as RECEITAS DE MATERIALIZACAO em cada nivel de
	fidelidade que o D-O15 pode escolher.

	Niveis de materializacao (Tese dos D aplicada):
	  D0 = dado puro       (existe, ocupa memoria minima, sem Instance)
	  D1 = impostor        (1 Part — silhueta a distancia)
	  D2 = essencial       (2-4 Parts — forma reconhecivel)
	  D3 = detalhado       (5-12 Parts — perto, interagivel)
	  D4 = vivo            (D3 + luz/particulas/som/comportamento fisico)
	Custo = "pontos de materializacao" que cada nivel consome do
	orcamento do dispositivo (DeviceProfile).
	============================================================
]]

local Archetypes = {}

Archetypes.Catalogo = {
	Carvalho = {
		Categoria = "Vegetacao",
		Materia = { Tronco = "MadeiraViva", Copa = "Folhagem" },
		Forma = { Altura = { 7, 13 }, RaioTronco = { 0.35, 0.7 }, RaioCopa = { 2.6, 4.5 } },
		Comportamento = { Queimavel = true, BalancaNoVento = true },
		Custo = { [1] = 1, [2] = 3, [3] = 8, [4] = 10 },
		Interagivel = true, -- pode ser cortado
	},
	Pinheiro = {
		Categoria = "Vegetacao",
		Materia = { Tronco = "MadeiraViva", Copa = "Folhagem" },
		Forma = { Altura = { 9, 16 }, RaioTronco = { 0.3, 0.5 }, RaioCopa = { 1.8, 3 } },
		Comportamento = { Queimavel = true },
		Custo = { [1] = 1, [2] = 3, [3] = 7, [4] = 9 },
		Interagivel = true,
	},
	Rocha = {
		Categoria = "Geologia",
		Materia = { Corpo = "Granito" },
		Forma = { Tamanho = { 1.5, 6 } },
		Comportamento = {},
		Custo = { [1] = 1, [2] = 2, [3] = 4, [4] = 4 },
		Interagivel = true, -- mineravel
	},
	CasaVila = {
		Categoria = "Estrutura",
		Materia = { Parede = "MadeiraSeca", Telhado = "Palha", Base = "Granito" },
		Forma = { Largura = { 8, 12 }, Profundidade = { 8, 12 }, Altura = { 5, 7 } },
		Comportamento = { Queimavel = true, Abrigo = true },
		Custo = { [1] = 2, [2] = 6, [3] = 14, [4] = 16 },
		Interagivel = true,
	},
	Tocha = {
		Categoria = "Utilidade",
		Materia = { Cabo = "MadeiraSeca", Fogo = "Chama" },
		Forma = { Altura = { 3, 3.5 } },
		Comportamento = { EmiteLuz = true, PropagaFogo = true },
		Custo = { [1] = 1, [2] = 2, [3] = 3, [4] = 6 }, -- D4 = luz+fogo reais
		Interagivel = true,
	},
	Lago = {
		Categoria = "Hidrologia",
		Materia = { Corpo = "AguaDoce" },
		Forma = { Raio = { 10, 40 }, Profundidade = { 2, 6 } },
		Comportamento = { ExtingueFogo = true, Flutuacao = true },
		Custo = { [1] = 1, [2] = 2, [3] = 3, [4] = 5 },
		Interagivel = true,
	},
	CristalRessonante = {
		Categoria = "Fantastico",
		Materia = { Corpo = "CristalAether" },
		Forma = { Altura = { 2, 5 } },
		Comportamento = { EmiteLuz = true, Ressonante = true },
		Custo = { [1] = 1, [2] = 2, [3] = 4, [4] = 8 },
		Interagivel = true,
	},
	AfloramentoFerro = {
		Categoria = "Geologia",
		Materia = { Corpo = "Ferro", Base = "Granito" },
		Forma = { Tamanho = { 1.5, 3.5 } },
		Comportamento = {},
		Custo = { [1] = 1, [2] = 2, [3] = 4, [4] = 4 },
		Interagivel = true,
	},
}

function Archetypes.Get(nome)
	return Archetypes.Catalogo[nome]
end

-- Registra novos arquetipos em runtime (a IA/Singularity vai usar isto!)
function Archetypes.Registrar(nome, def)
	if type(nome) == "string" and type(def) == "table" then
		Archetypes.Catalogo[nome] = def
		return true
	end
	return false
end

return Archetypes
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX111184"><Properties><string name="Name">Materia</string><ProtectedString name="Source"><![CDATA[--[[
	Materia (ModuleScript)
	Local: ReplicatedStorage > Arkhe > RRW > Materia
	============================================================
	RRW — a materia NAO e "albedo+roughness+metallic".
	Aqui a materia e uma representacao SEMANTICA da realidade:
	composicao, densidade, estado fisico, comportamento termico,
	condutividade, inflamabilidade, interacao com agua e luz.
	A aparencia Roblox (Material/Color/PhysicalProperties) e apenas
	UMA materializacao possivel dessa materia — decidida pelo D-O15.
	============================================================
]]

local Materia = {}

-- Catalogo de materias fundamentais (extensivel — RRW nunca e lista fechada)
Materia.Catalogo = {
	MadeiraViva = {
		Densidade = 600, Estado = "Solido", Inflamavel = true, PontoIgnicao = 300,
		CondutividadeTermica = 0.12, AbsorveAgua = true, Flutua = true,
		Rigidez = 0.6, Organico = true,
		Aparencia = { Material = Enum.Material.Wood, Cor = Color3.fromRGB(107, 78, 49) },
		Fisica = { Friccao = 0.45, Elasticidade = 0.15 },
	},
	MadeiraSeca = {
		Densidade = 450, Estado = "Solido", Inflamavel = true, PontoIgnicao = 250,
		CondutividadeTermica = 0.10, AbsorveAgua = true, Flutua = true,
		Rigidez = 0.5, Organico = true,
		Aparencia = { Material = Enum.Material.WoodPlanks, Cor = Color3.fromRGB(139, 105, 70) },
		Fisica = { Friccao = 0.5, Elasticidade = 0.1 },
	},
	Folhagem = {
		Densidade = 150, Estado = "Solido", Inflamavel = true, PontoIgnicao = 200,
		CondutividadeTermica = 0.05, AbsorveAgua = true, Flutua = true,
		Rigidez = 0.05, Organico = true, TranslucidezLuz = 0.35,
		Aparencia = { Material = Enum.Material.Grass, Cor = Color3.fromRGB(74, 118, 58) },
		Fisica = { Friccao = 0.3, Elasticidade = 0.4 },
	},
	Granito = {
		Densidade = 2700, Estado = "Solido", Inflamavel = false,
		CondutividadeTermica = 2.8, AbsorveAgua = false, Flutua = false,
		Rigidez = 0.98, Organico = false,
		Aparencia = { Material = Enum.Material.Slate, Cor = Color3.fromRGB(120, 118, 115) },
		Fisica = { Friccao = 0.7, Elasticidade = 0.05 },
	},
	Ferro = {
		Densidade = 7870, Estado = "Solido", Inflamavel = false,
		CondutividadeTermica = 80, AbsorveAgua = false, Flutua = false,
		Rigidez = 0.95, Condutor = true, Oxidavel = true,
		Aparencia = { Material = Enum.Material.Metal, Cor = Color3.fromRGB(160, 160, 165) },
		Fisica = { Friccao = 0.4, Elasticidade = 0.08 },
	},
	AguaDoce = {
		Densidade = 1000, Estado = "Liquido", Inflamavel = false,
		CondutividadeTermica = 0.6, ExtingueFogo = true, TranslucidezLuz = 0.7,
		Rigidez = 0, Solvente = true,
		Aparencia = { Material = Enum.Material.Glass, Cor = Color3.fromRGB(60, 120, 160), Transparencia = 0.45 },
		Fisica = { Friccao = 0.05, Elasticidade = 0 },
	},
	SoloFertil = {
		Densidade = 1300, Estado = "Solido", Inflamavel = false,
		AbsorveAgua = true, SuportaVida = true,
		Rigidez = 0.3, Organico = true,
		Aparencia = { Material = Enum.Material.Ground, Cor = Color3.fromRGB(101, 84, 63) },
		Fisica = { Friccao = 0.6, Elasticidade = 0.05 },
	},
	Chama = {
		Densidade = 0.3, Estado = "Plasma", EmiteLuz = true, EmiteCalor = true,
		Temperatura = 900, ConsumeInflamavel = true,
		Aparencia = { Material = Enum.Material.Neon, Cor = Color3.fromRGB(255, 150, 40) },
		Fisica = nil, -- chama nao colide
	},
	Palha = {
		Densidade = 100, Estado = "Solido", Inflamavel = true, PontoIgnicao = 150,
		AbsorveAgua = true, Flutua = true, Rigidez = 0.1, Organico = true,
		Aparencia = { Material = Enum.Material.Fabric, Cor = Color3.fromRGB(196, 164, 90) },
		Fisica = { Friccao = 0.55, Elasticidade = 0.2 },
	},
	CristalAether = { -- materia "impossivel" — RRW tambem representa o fantastico
		Densidade = 50, Estado = "Solido", EmiteLuz = true, Ressonante = true,
		Rigidez = 0.9, TranslucidezLuz = 0.8,
		Aparencia = { Material = Enum.Material.Neon, Cor = Color3.fromRGB(140, 120, 255), Transparencia = 0.15 },
		Fisica = { Friccao = 0.2, Elasticidade = 0.6 },
	},
}

function Materia.Get(nome)
	return Materia.Catalogo[nome] or Materia.Catalogo.Granito
end

-- Materializa as propriedades FISICAS Roblox a partir da materia semantica
function Materia.AplicarFisica(parte, nomeMateria)
	local m = Materia.Get(nomeMateria)
	if m.Fisica then
		parte.CustomPhysicalProperties = PhysicalProperties.new(
			math.clamp(m.Densidade / 1000, 0.01, 100), -- densidade Roblox ~ g/cm3
			m.Fisica.Friccao or 0.3,
			m.Fisica.Elasticidade or 0.2
		)
		parte.CanCollide = true
	else
		parte.CanCollide = false
	end
end

-- Materializa a APARENCIA a partir da materia semantica
function Materia.AplicarAparencia(parte, nomeMateria, variacao)
	local m = Materia.Get(nomeMateria)
	local ap = m.Aparencia
	parte.Material = ap.Material
	local cor = ap.Cor
	if variacao and variacao ~= 0 then
		-- variacao deterministica de tom (mundo organico, nunca repetitivo)
		local f = 1 + (variacao - 0.5) * 0.25
		cor = Color3.new(
			math.clamp(cor.R * f, 0, 1),
			math.clamp(cor.G * f, 0, 1),
			math.clamp(cor.B * f, 0, 1)
		)
	end
	parte.Color = cor
	parte.Transparency = ap.Transparencia or 0
end

return Materia
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX544822"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[--[[
	World (ModuleScript)
	Local: ReplicatedStorage > Arkhe > RRW > World
	============================================================
	O CORACAO DO RRW: o mundo existe como DADOS, nao como Instances.
	Uma entidade e um registro semantico:
	  { Id, Arquetipo, Pos, Seed, Estado, Relacoes, Materializacao }
	Parts no Workspace sao apenas a MATERIALIZACAO ATUAL escolhida
	pelo D-O15 — podem sumir e voltar sem que a realidade mude.

	- Indice espacial em chunks (consultas O(1) por regiao)
	- Estado mutavel (vida, temperatura, umidade, integridade)
	- Relacoes entre entidades (fogo consome arvore; agua apaga fogo)
	- Serializacao completa (DataStore / relay / publicacao)
	============================================================
]]

local World = {}
World.__index = World

local TAMANHO_CHUNK = 128

local function chaveChunk(x, z)
	return math.floor(x / TAMANHO_CHUNK) .. "," .. math.floor(z / TAMANHO_CHUNK)
end

function World.new(nome)
	local self = setmetatable({}, World)
	self.Nome = nome or "Realidade"
	self.Entidades = {}      -- [id] = entidade
	self.Chunks = {}         -- [chave] = { [id] = true }
	self.ProximoId = 0
	self.Tempo = 0           -- tempo proprio da realidade
	self.Clima = { Chuva = false, Vento = 0.2, Temperatura = 22 }
	self.Observadores = {}   -- callbacks de eventos da realidade
	return self
end

-- ============ CICLO DE VIDA DE ENTIDADES ============
function World:Criar(arquetipo, pos, estadoExtra)
	self.ProximoId = self.ProximoId + 1
	local id = self.ProximoId
	local entidade = {
		Id = id,
		Arquetipo = arquetipo,
		Pos = { X = pos.X, Y = pos.Y, Z = pos.Z },
		Seed = (id * 2654435761) % 1000 / 1000, -- variacao deterministica
		Estado = {
			Integridade = 1,      -- 1 = intacto, 0 = destruido
			Temperatura = 22,
			Umidade = 0.3,
			EmChamas = false,
		},
		Relacoes = {},            -- { {Tipo="Sustenta", Alvo=id}, ... }
		Materializacao = 0,       -- nivel D atual (0 = dado puro)
		Instancia = nil,          -- Model atual (se materializada)
		Relevancia = 0,           -- calculada pelo D-O15
	}
	if estadoExtra then
		for k, v in pairs(estadoExtra) do
			entidade.Estado[k] = v
		end
	end
	self.Entidades[id] = entidade
	local ck = chaveChunk(pos.X, pos.Z)
	self.Chunks[ck] = self.Chunks[ck] or {}
	self.Chunks[ck][id] = true
	self:Emitir("Criada", entidade)
	return entidade
end

function World:Destruir(id)
	local e = self.Entidades[id]
	if not e then return end
	if e.Instancia then
		e.Instancia:Destroy()
		e.Instancia = nil
	end
	local ck = chaveChunk(e.Pos.X, e.Pos.Z)
	if self.Chunks[ck] then
		self.Chunks[ck][id] = nil
	end
	self.Entidades[id] = nil
	self:Emitir("Destruida", e)
end

-- ============ CONSULTAS ESPACIAIS ============
function World:NaRegiao(centro, raio)
	local resultado = {}
	local cMin = math.floor((centro.X - raio) / TAMANHO_CHUNK)
	local cMax = math.floor((centro.X + raio) / TAMANHO_CHUNK)
	local zMin = math.floor((centro.Z - raio) / TAMANHO_CHUNK)
	local zMax = math.floor((centro.Z + raio) / TAMANHO_CHUNK)
	local raioSq = raio * raio
	for cx = cMin, cMax do
		for cz = zMin, zMax do
			local chunk = self.Chunks[cx .. "," .. cz]
			if chunk then
				for id in pairs(chunk) do
					local e = self.Entidades[id]
					if e then
						local dx = e.Pos.X - centro.X
						local dz = e.Pos.Z - centro.Z
						if dx * dx + dz * dz <= raioSq then
							table.insert(resultado, e)
						end
					end
				end
			end
		end
	end
	return resultado
end

-- ============ RELACOES E CAUSALIDADE ============
function World:Relacionar(idOrigem, tipo, idAlvo)
	local e = self.Entidades[idOrigem]
	if e then
		table.insert(e.Relacoes, { Tipo = tipo, Alvo = idAlvo })
	end
end

-- Simulacao causal LEVE que roda sobre os DADOS (mesmo sem Instances!)
-- Fogo se espalha, agua apaga, chuva molha — a realidade vive sozinha.
function World:SimularCausalidade(dt, Archetypes)
	self.Tempo = self.Tempo + dt
	for id, e in pairs(self.Entidades) do
		local arq = Archetypes.Get(e.Arquetipo)
		if arq then
			-- fogo consome o inflamavel
			if e.Estado.EmChamas then
				e.Estado.Integridade = e.Estado.Integridade - 0.02 * dt
				e.Estado.Temperatura = math.min(900, e.Estado.Temperatura + 100 * dt)
				-- propaga para vizinhos queimaveis secos
				if math.random() < 0.08 * dt then
					local vizinhos = self:NaRegiao(e.Pos, 12)
					for _, v in ipairs(vizinhos) do
						local arqV = Archetypes.Get(v.Arquetipo)
						if arqV and arqV.Comportamento.Queimavel
							and not v.Estado.EmChamas and v.Estado.Umidade < 0.6 then
							v.Estado.EmChamas = true
							self:Emitir("PegouFogo", v)
							break
						end
					end
				end
				-- chuva apaga
				if self.Clima.Chuva and math.random() < 0.3 * dt then
					e.Estado.EmChamas = false
					self:Emitir("FogoApagou", e)
				end
				if e.Estado.Integridade <= 0 then
					self:Emitir("ConsumidaPeloFogo", e)
					self:Destruir(id)
				end
			else
				-- clima molha/seca a realidade
				if self.Clima.Chuva then
					e.Estado.Umidade = math.min(1, e.Estado.Umidade + 0.05 * dt)
				else
					e.Estado.Umidade = math.max(0, e.Estado.Umidade - 0.005 * dt)
				end
				if e.Estado.Temperatura > 22 then
					e.Estado.Temperatura = math.max(22, e.Estado.Temperatura - 30 * dt)
				end
			end
		end
	end
end

-- ============ EVENTOS DA REALIDADE ============
function World:Observar(callback)
	table.insert(self.Observadores, callback)
end

function World:Emitir(evento, entidade)
	for _, cb in ipairs(self.Observadores) do
		task.spawn(cb, evento, entidade)
	end
end

-- ============ SERIALIZACAO (DataStore / relay / publicacao) ============
function World:Serializar()
	local dados = { Nome = self.Nome, Tempo = self.Tempo, Clima = self.Clima, Entidades = {} }
	for id, e in pairs(self.Entidades) do
		table.insert(dados.Entidades, {
			A = e.Arquetipo,
			P = { e.Pos.X, e.Pos.Y, e.Pos.Z },
			S = e.Seed,
			E = e.Estado,
		})
	end
	return dados
end

function World.Deserializar(dados)
	local mundo = World.new(dados.Nome)
	mundo.Tempo = dados.Tempo or 0
	mundo.Clima = dados.Clima or mundo.Clima
	for _, reg in ipairs(dados.Entidades or {}) do
		local e = mundo:Criar(reg.A, Vector3.new(reg.P[1], reg.P[2], reg.P[3]), reg.E)
		e.Seed = reg.S or e.Seed
	end
	return mundo
end

return World
]]></ProtectedString></Properties></Item>
    </Item>
    <Item class="Folder" referent="RBX384814">
     <Properties>
      <string name="Name">Terrain</string>
     </Properties>
     <Item class="ModuleScript" referent="RBX337057"><Properties><string name="Name">BiomeBlender</string><ProtectedString name="Source"><![CDATA[
local BiomeBlender = {}
function BiomeBlender.novo() return setmetatable({Nome="BiomeBlender", Ativo=true}, {__index=BiomeBlender}) end
function BiomeBlender:Serializar() return {Nome=self.Nome} end
return BiomeBlender
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX587213"><Properties><string name="Name">BiomePainter</string><ProtectedString name="Source"><![CDATA[[[
	BiomePainter (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Terrain > BiomePainter
	============================================================
	F4 — BIOMAS PINTÁVEIS (pinta bioma no terreno)
	- Biomas: Floresta, Deserto, Neve, Pantano, Rocha, Grama, Areia
	- Cada voxel tem bioma + umidade + temperatura
	- Pincel: pinta bioma com raio + falloff
	- Regras: bioma influencia vegetação + textura + sons
	- Integra com HeightField + EditableTerrain + RRW
	============================================================
]]

local BiomePainter = {}
BiomePainter.__index = BiomePainter

BiomePainter.Biomas = {
	Floresta = { Cor=Color3.fromRGB(34,139,34), Umidade=0.8, Temp=0.6, Vegetacao="Carvalho", Som="Floresta", Desc="Verde úmido, árvores densas" },
	Deserto = { Cor=Color3.fromRGB(237,201,175), Umidade=0.1, Temp=0.9, Vegetacao="Cacto", Som="Deserto", Desc="Areia quente, pouca água" },
	Neve = { Cor=Color3.fromRGB(255,250,250), Umidade=0.6, Temp=0.1, Vegetacao="PinheiroNevado", Som="Neve", Desc="Frio, neve, pinheiros" },
	Pantano = { Cor=Color3.fromRGB(85,107,47), Umidade=0.95, Temp=0.7, Vegetacao="Mangue", Som="Pantano", Desc="Úmido, lama, névoa" },
	Rocha = { Cor=Color3.fromRGB(112,112,112), Umidade=0.3, Temp=0.5, Vegetacao="Nenhuma", Som="Caverna", Desc="Pedra exposta" },
	Grama = { Cor=Color3.fromRGB(124,252,0), Umidade=0.5, Temp=0.6, Vegetacao="GramaAlta", Som="Campo", Desc="Campo gramado" },
	Areia = { Cor=Color3.fromRGB(194,178,128), Umidade=0.2, Temp=0.8, Vegetacao="Palmeira", Som="Praia", Desc="Areia de praia" },
}

function BiomePainter.novo(largura, altura)
	local self = setmetatable({}, BiomePainter)
	self.Largura = largura or 256
	self.Altura = altura or 256
	self.Mapa = {} -- [x][z] = { Bioma, Umidade, Temp }
	for x=1,self.Largura do
		self.Mapa[x]={}
		for z=1,self.Altura do
			self.Mapa[x][z]={ Bioma="Grama", Umidade=0.5, Temp=0.6 }
		end
	end
	self.Historico = {}
	return self
end

function BiomePainter:Obter(x,z)
	if self.Mapa[x] and self.Mapa[x][z] then return self.Mapa[x][z] end
	return nil
end

function BiomePainter:Definir(x,z, bioma)
	if not BiomePainter.Biomas[bioma] then return false end
	if self.Mapa[x] and self.Mapa[x][z] then
		self.Mapa[x][z].Bioma = bioma
		self.Mapa[x][z].Umidade = BiomePainter.Biomas[bioma].Umidade
		self.Mapa[x][z].Temp = BiomePainter.Biomas[bioma].Temp
		return true
	end
	return false
end

function BiomePainter:Pintar(centroX, centroZ, raio, bioma, forca)
	if not BiomePainter.Biomas[bioma] then return 0 end
	raio = raio or 10
	forca = forca or 1
	local afetados=0
	for dx=-raio, raio do
		for dz=-raio, raio do
			local x = centroX+dx
			local z = centroZ+dz
			if self.Mapa[x] and self.Mapa[x][z] then
				local dist = math.sqrt(dx*dx+dz*dz)
				if dist <= raio then
					local falloff = 1 - (dist/raio)
					if math.random() < falloff*forca then
						self:Definir(x,z,bioma)
						afetados=afetados+1
					end
				end
			end
		end
	end
	table.insert(self.Historico, { Quando=os.time(), Bioma=bioma, Centro={X=centroX,Z=centroZ}, Raio=raio, Afetados=afetados })
	if #self.Historico > 20 then table.remove(self.Historico,1) end
	return afetados
end

function BiomePainter:Suavizar(centroX, centroZ, raio)
	raio = raio or 10
	local afetados=0
	for dx=-raio, raio do
		for dz=-raio, raio do
			local x=centroX+dx; local z=centroZ+dz
			if self.Mapa[x] and self.Mapa[x][z] then
				if math.sqrt(dx*dx+dz*dz) <= raio then
					-- média de biomas vizinhos (moda)
					local contagem={}
					for ox=-1,1 do for oz=-1,1 do
						local nx=x+ox; local nz=z+oz
						if self.Mapa[nx] and self.Mapa[nx][nz] then
							local b = self.Mapa[nx][nz].Bioma
							contagem[b]=(contagem[b] or 0)+1
						end
					end end
					local maisComum, maxC=nil,0
					for b,c in pairs(contagem) do if c>maxC then maxC=c; maisComum=b end end
					if maisComum then self:Definir(x,z,maisComum); afetados=afetados+1 end
				end
			end
		end
	end
	return afetados
end

function BiomePainter:GerarVegetacaoPorBioma()
	-- retorna lista de vegetação por bioma
	local lista={}
	for x=1, self.Largura, 10 do
		for z=1, self.Altura, 10 do
			local cel = self:Obter(x,z)
			if cel then
				local bio = BiomePainter.Biomas[cel.Bioma]
				if bio and bio.Vegetacao ~= "Nenhuma" and math.random() < 0.3 then
					table.insert(lista, { X=x, Z=z, Bioma=cel.Bioma, Vegetacao=bio.Vegetacao })
				end
			end
		end
	end
	return lista
end

function BiomePainter:ListarBiomas()
	local lista={}
	for nome, info in pairs(BiomePainter.Biomas) do
		table.insert(lista, { Nome=nome, Desc=info.Desc, Cor=info.Cor, Vegetacao=info.Vegetacao })
	end
	return lista
end

function BiomePainter:Serializar()
	return {
		Largura=self.Largura,
		Altura=self.Altura,
		Biomas=self:ListarBiomas(),
		Historico=self.Historico,
	}
end

return BiomePainter
]]></ProtectedString></Properties></Item>
