     <Item class="ModuleScript" referent="RBX387052"><Properties><string name="Name">Gradient</string><ProtectedString name="Source"><![CDATA[
local Gradient = {}
Gradient.Presets={
  Arkhe={Inicio={R=74,G=0,B=224}, Fim={R=0,G=229,B=255}},
  Sunset={Inicio={R=255,G=94,B=77}, Fim={R=255,G=154,B=0}},
  Ocean={Inicio={R=0,G=102,B=204}, Fim={R=0,G=204,B=204}},
  Forest={Inicio={R=34,G=139,B=34}, Fim={R=154,G=205,B=50}},
  Neon={Inicio={R=255,G=0,B=128}, Fim={R=0,G=255,B=255}},
}
function Gradient.novo(preset)
  preset=preset or "Arkhe"
  return setmetatable({Preset=preset, Cores=Gradient.Presets[preset] or Gradient.Presets.Arkhe, Angulo=90, Textura="noise"}, {__index=Gradient})
end
function Gradient:Aplicar(uiObject)
  -- aplica gradiente em UI
  return {UI=uiObject, Gradient=self.Cores, Angulo=self.Angulo}
end
function Gradient:ListarPresets() local l={} for k in pairs(Gradient.Presets) do table.insert(l,k) end return l end
function Gradient:Serializar() return {Preset=self.Preset, Angulo=self.Angulo} end
return Gradient
]]></ProtectedString></Properties></Item>
