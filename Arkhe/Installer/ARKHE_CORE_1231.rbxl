     <Item class="ModuleScript" referent="RBX39100"><Properties><string name="Name">TerrainFeatures</string><ProtectedString name="Source"><![CDATA[--[[
	TerrainFeatures (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Terrain > TerrainFeatures
	============================================================
	F4 — Gerenciador de cavernas, rios e estradas.
	- Agrega CaveSystem + RiverSpline + RoadSpline
	- CarvarTudoNoCampo(campo): aplica tudo em ordem rio->estrada->caverna
	- Serializavel
	============================================================
]]

local CaveSystem = require(script.Parent:WaitForChild("CaveSystem"))
local RiverSpline = require(script.Parent:WaitForChild("RiverSpline"))
local RoadSpline = require(script.Parent:WaitForChild("RoadSpline"))

local TerrainFeatures = {}
TerrainFeatures.__index = TerrainFeatures

function TerrainFeatures.novo(nome)
	local self = setmetatable({}, TerrainFeatures)
	self.Nome = nome or "Features"
	self.Cavernas = CaveSystem.novo(nome.."_Cavernas")
	self.Rios = {} -- [nome] = RiverSpline
	self.Estradas = {} -- [nome] = RoadSpline
	return self
end

function TerrainFeatures:CriarRio(nome)
	nome = nome or "Rio_"..(#self.Rios+1)
	local rio = RiverSpline.novo(nome)
	self.Rios[nome] = rio
	return rio
end

function TerrainFeatures:CriarEstrada(nome)
	nome = nome or "Estrada_"..(#self.Estradas+1)
	local estrada = RoadSpline.novo(nome)
	self.Estradas[nome] = estrada
	return estrada
end

function TerrainFeatures:CarvarTudoNoCampo(campo)
	local total=0
	for _, rio in pairs(self.Rios) do
		total = total + rio:CarvarNoCampo(campo)
	end
	for _, estrada in pairs(self.Estradas) do
		total = total + estrada:CarvarNoCampo(campo)
	end
	total = total + self.Cavernas:CarvarNoCampo(campo)
	return total
end

function TerrainFeatures:Serializar()
	local riosSer={}
	for nome, rio in pairs(self.Rios) do riosSer[nome]=rio:Serializar() end
	local estrSer={}
	for nome, est in pairs(self.Estradas) do estrSer[nome]=est:Serializar() end
	return {
		Nome=self.Nome,
		Cavernas=self.Cavernas:Serializar(),
		Rios=riosSer,
		Estradas=estrSer,
		TotalRios=0 + (function() local n=0 for _ in pairs(self.Rios) do n=n+1 end return n end)(),
		TotalEstradas=0 + (function() local n=0 for _ in pairs(self.Estradas) do n=n+1 end return n end)(),
	}
end

function TerrainFeatures:Listar()
	local lista={}
	for nome, rio in pairs(self.Rios) do table.insert(lista, { Tipo="Rio", Nome=nome, Pontos=rio:Contar() }) end
	for nome, est in pairs(self.Estradas) do table.insert(lista, { Tipo="Estrada", Nome=nome, Pontos=est:Contar() }) end
	for _, c in ipairs(self.Cavernas:Listar()) do table.insert(lista, c) end
	return lista
end

function TerrainFeatures:Contar()
	local n=self.Cavernas:Contar()
	for _ in pairs(self.Rios) do n=n+1 end
	for _ in pairs(self.Estradas) do n=n+1 end
	return n
end

function TerrainFeatures:Limpar()
	self.Cavernas:Limpar()
	self.Rios={}
	self.Estradas={}
end

return TerrainFeatures
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX465842"><Properties><string name="Name">TerrainLOD</string><ProtectedString name="Source"><![CDATA[
local TerrainLOD = {}
function TerrainLOD.novo() return setmetatable({Niveis={10,50,150,500}, Atual=0}, {__index=TerrainLOD}) end
function TerrainLOD:NivelParaDist(dist)
  for i, d in ipairs(self.Niveis) do if dist < d then return i end end
  return #self.Niveis+1
end
function TerrainLOD:Serializar() return {Niveis=self.Niveis} end
return TerrainLOD
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX755741"><Properties><string name="Name">TerrainMaterial</string><ProtectedString name="Source"><![CDATA[
local TerrainMaterial = {}
TerrainMaterial.Materiais={Grama={Cor={88,110,70}}, Rocha={Cor={100,100,100}}, Areia={Cor={194,178,128}}, Neve={Cor={255,255,255}}}
function TerrainMaterial.novo(nome) return setmetatable({Nome=nome or "Grama", Def=TerrainMaterial.Materiais[nome or "Grama"]}, {__index=TerrainMaterial}) end
function TerrainMaterial:Listar() local l={} for k in pairs(TerrainMaterial.Materiais) do table.insert(l,k) end return l end
function TerrainMaterial:Serializar() return {Nome=self.Nome} end
return TerrainMaterial
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX285841"><Properties><string name="Name">TerrainRender</string><ProtectedString name="Source"><![CDATA[--[[
	TerrainRender (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Terrain > TerrainRender
	============================================================
	F4 — RENDER do terreno proprio: malha TRIANGULAR em chunks
	(WedgeParts, tecnica classica de triangle terrain) com LOD
	por distancia no espirito D-O15:

	  passo 1 (perto)  -> detalhe total
	  passo 2 / 4 / 6  -> longe simplifica ate 36x menos parts

	- So reconstroi chunks SUJOS (pincel marca regiao)
	- Orcamento de reconstrucao por tick (nunca trava o frame)
	- Cores + materiais por BIOMA semantico do HeightField
	- Plano de agua unico quando o estilo tem mar
	VERDADE: WedgePart e mais pesado que mesh nativa, mas roda
	em QUALQUER lugar (Studio Lite incluso) e da colisao gratis.
	Upgrade futuro: EditableMesh onde disponivel (mesmo dado!).
	============================================================
]]

local TerrainRender = {}

local BIOMAS = {
	Areia = { Cor = Color3.fromRGB(216, 200, 150), Material = Enum.Material.Sand },
	Grama = { Cor = Color3.fromRGB(106, 158, 74), Material = Enum.Material.Grass },
	Floresta = { Cor = Color3.fromRGB(64, 118, 56), Material = Enum.Material.Grass },
	Rocha = { Cor = Color3.fromRGB(122, 118, 112), Material = Enum.Material.Slate },
	Neve = { Cor = Color3.fromRGB(235, 240, 245), Material = Enum.Material.Snow },
	Seco = { Cor = Color3.fromRGB(172, 154, 98), Material = Enum.Material.Ground },
}

TerrainRender.Config = {
	TamanhoChunk = 12,          -- celulas por chunk
	Passos = { 1, 2, 4, 6 },    -- niveis de LOD
	Distancias = { 160, 360, 720 }, -- studs para cair de nivel
	OrcamentoPorTick = 2,       -- chunks reconstruidos por tick
	Espessura = 1,
}

local campo = nil
local pasta = nil
local agua = nil
local chunks = {} -- [chave] = { Modelo, Passo, Sujo, CX, CZ }

-- ============ TRIANGULO (2 wedges, tecnica classica) ============
local function wedge(pai, cor, material)
	local w = Instance.new("WedgePart")
	w.Anchored = true
	w.CastShadow = false
	w.TopSurface = Enum.SurfaceType.Smooth
	w.BottomSurface = Enum.SurfaceType.Smooth
	w.Color = cor
	w.Material = material
	w.Parent = pai
	return w
end

local function desenharTriangulo(a, b, c, pai, cor, material, espessura)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		a, c = c, a
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	if bc.Magnitude < 0.01 then return end
	local cruz = ac:Cross(ab)
	if cruz.Magnitude < 0.01 then return end
	local direita = cruz.Unit
	local cima = bc:Cross(direita).Unit
	local tras = bc.Unit
	local altura = math.abs(ab:Dot(cima))
	if altura < 0.01 then return end

	local w1 = wedge(pai, cor, material)
	w1.Size = Vector3.new(espessura, altura, math.abs(ab:Dot(tras)))
	w1.CFrame = CFrame.fromMatrix((a + b) / 2, direita, cima, tras)

	local w2 = wedge(pai, cor, material)
	w2.Size = Vector3.new(espessura, altura, math.abs(ac:Dot(tras)))
	w2.CFrame = CFrame.fromMatrix((a + c) / 2, -direita, cima, -tras)
end

-- ============ CHUNKS ============
local function posicaoMundo(x, z)
	local meio = campo.Largura / 2
	return Vector3.new((x - meio) * campo.Celula, campo.Alturas[x][z], (z - meio) * campo.Celula)
end

local function construirChunk(registro, passo)
	if registro.Modelo then registro.Modelo:Destroy() end
	local modelo = Instance.new("Model")
	modelo.Name = "Chunk_" .. registro.CX .. "_" .. registro.CZ
	local T = TerrainRender.Config.TamanhoChunk
	local x0, z0 = registro.CX * T, registro.CZ * T
	local esp = TerrainRender.Config.Espessura

	for x = x0, math.min(x0 + T - 1, campo.Largura - 1), passo do
		for z = z0, math.min(z0 + T - 1, campo.Largura - 1), passo do
			local px = math.min(x + passo, campo.Largura)
			local pz = math.min(z + passo, campo.Largura)
			local a = posicaoMundo(x, z)
			local b = posicaoMundo(px, z)
			local c = posicaoMundo(x, pz)
			local d = posicaoMundo(px, pz)
			local bioma = BIOMAS[campo:Bioma(x, z)] or BIOMAS.Grama
			desenharTriangulo(a, b, c, modelo, bioma.Cor, bioma.Material, esp)
			desenharTriangulo(b, d, c, modelo, bioma.Cor, bioma.Material, esp)
		end
	end
	modelo.Parent = pasta
	registro.Modelo = modelo
	registro.Passo = passo
	registro.Sujo = false
end

-- ============ API ============
function TerrainRender.Iniciar(novoCampo)
	TerrainRender.Limpar()
	campo = novoCampo
	pasta = Instance.new("Folder")
	pasta.Name = "ArkheTerrain"
	pasta.Parent = workspace

	local T = TerrainRender.Config.TamanhoChunk
	local n = math.ceil(campo.Largura / T)
	chunks = {}
	for cx = 0, n - 1 do
		for cz = 0, n - 1 do
			chunks[cx .. ":" .. cz] = { CX = cx, CZ = cz, Sujo = true, Passo = nil, Modelo = nil }
		end
	end

	if campo.TemAgua then
		agua = Instance.new("Part")
		agua.Name = "ArkheMar"
		agua.Anchored = true
		agua.CanCollide = false
		agua.Transparency = 0.35
		agua.Color = Color3.fromRGB(52, 118, 158)
		agua.Material = Enum.Material.Glass
		local lado = campo.Largura * campo.Celula
		agua.Size = Vector3.new(lado, 1.2, lado)
		agua.Position = Vector3.new(0, campo.NivelMar, 0)
		agua.Parent = pasta
	end
end

function TerrainRender.Limpar()
	if pasta then pasta:Destroy() end
	pasta, campo, agua = nil, nil, nil
	chunks = {}
end

function TerrainRender.Ativo()
	return campo ~= nil
end

-- Pincel mexeu nas celulas [x0..x1, z0..z1]: marca chunks pra redesenho
function TerrainRender.MarcarRegiao(x0, z0, x1, z1)
	if not campo then return end
	local T = TerrainRender.Config.TamanhoChunk
	for cx = math.floor(x0 / T), math.floor(x1 / T) do
		for cz = math.floor(z0 / T), math.floor(z1 / T) do
			local r = chunks[cx .. ":" .. cz]
			if r then r.Sujo = true end
		end
	end
end

-- LOD: decide o passo de cada chunk pela distancia ao jogador mais perto
function TerrainRender.AtualizarLOD(posicoes)
	if not campo then return end
	local cfg = TerrainRender.Config
	local T = cfg.TamanhoChunk
	local meio = campo.Largura / 2
	for _, r in pairs(chunks) do
		local centro = Vector3.new(
			(r.CX * T + T / 2 - meio) * campo.Celula, 0,
			(r.CZ * T + T / 2 - meio) * campo.Celula)
		local menor = math.huge
		for _, p in ipairs(posicoes) do
			local d = (Vector3.new(p.X, 0, p.Z) - centro).Magnitude
			if d < menor then menor = d end
		end
		local passo = cfg.Passos[#cfg.Passos]
		for i, limite in ipairs(cfg.Distancias) do
			if menor < limite then passo = cfg.Passos[i] break end
		end
		if passo ~= r.Passo then r.Sujo = true r.PassoDesejado = passo end
	end
end

-- Reconstroi ate N chunks sujos (chame num loop; nunca trava o frame)
function TerrainRender.Processar()
	if not campo then return 0 end
	local feitos = 0
	for _, r in pairs(chunks) do
		if r.Sujo then
			construirChunk(r, r.PassoDesejado or r.Passo or TerrainRender.Config.Passos[#TerrainRender.Config.Passos])
			feitos = feitos + 1
			if feitos >= TerrainRender.Config.OrcamentoPorTick then break end
		end
	end
	return feitos
end

return TerrainRender
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX118286"><Properties><string name="Name">VegetationScatter</string><ProtectedString name="Source"><![CDATA[
local VegetationScatter = {}
function VegetationScatter.novo() return setmetatable({Densidade=0.5, Biomas={"Floresta","Campo"}, Sementes={}}, {__index=VegetationScatter}) end
function VegetationScatter:Espalhar(mundo, centro, raio, qtd)
  local pts={}
  for i=1,qtd do table.insert(pts,{X=centro.X+math.random(-raio,raio), Z=centro.Z+math.random(-raio,raio), Tipo=self.Biomas[math.random(#self.Biomas)]}) end
  return pts
end
function VegetationScatter:Serializar() return {Densidade=self.Densidade, Biomas=self.Biomas} end
return VegetationScatter
]]></ProtectedString></Properties></Item>
