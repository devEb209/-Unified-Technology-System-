     <Item class="ModuleScript" referent="RBX735326"><Properties><string name="Name">ChatCollab</string><ProtectedString name="Source"><![CDATA[
local ChatCollab = {}
function ChatCollab.novo()
  return setmetatable({Mensagens={}, Max=100, Canais={"Geral","Equipe","Sistema"}}, {__index=ChatCollab})
end
function ChatCollab:Enviar(userId, nome, texto, canal)
  canal=canal or "Geral"
  local msg={Id=os.time()..math.random(1000,9999), UserId=userId, Nome=nome, Texto=texto, Canal=canal, Tempo=os.time()}
  table.insert(self.Mensagens, msg)
  if #self.Mensagens>self.Max then table.remove(self.Mensagens,1) end
  return msg
end
function ChatCollab:Listar(canal)
  if not canal then return self.Mensagens end
  local res={} for _, m in ipairs(self.Mensagens) do if m.Canal==canal then table.insert(res,m) end end return res
end
function ChatCollab:Serializar() return {Total=#self.Mensagens, Canais=self.Canais} end
return ChatCollab
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX415839"><Properties><string name="Name">CollaborationRealTime</string><ProtectedString name="Source"><![CDATA[
local CollaborationRealTime = {}
function CollaborationRealTime.novo()
  return setmetatable({
    Usuarios={},
    Cursores={},
    Selecoes={},
    Ativo=true,
    MaxUsers=10,
  }, {__index=CollaborationRealTime})
end
function CollaborationRealTime:Entrar(userId, nome, cor)
  self.Usuarios[userId]={Nome=nome, Cor=cor or {R=255,G=0,B=0}, EntrouEm=os.time()}
end
function CollaborationRealTime:Sair(userId) self.Usuarios[userId]=nil; self.Cursors[userId]=nil end
function CollaborationRealTime:AtualizarCursor(userId, pos) self.Cursors[userId]=pos end
function CollaborationRealTime:CompartilharSelecao(userId, selecao) self.Selecoes[userId]=selecao end
function CollaborationRealTime:Listar() return {Usuarios=self.Usuarios, Cursores=self.Cursors, Total=#self.Usuarios} end
function CollaborationRealTime:Serializar() return {TotalUsers=self:Contar(), Ativo=self.Ativo} end
function CollaborationRealTime:Contar() local n=0 for _ in pairs(self.Usuarios) do n=n+1 end return n end
return CollaborationRealTime
]]></ProtectedString></Properties></Item>
