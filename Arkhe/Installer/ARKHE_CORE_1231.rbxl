     <Item class="ModuleScript" referent="RBX372892"><Properties><string name="Name">ScreenReader</string><ProtectedString name="Source"><![CDATA[--[[
	ScreenReader (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Accessibility > ScreenReader
	============================================================
	F19 — LEITOR DE TELA (acessibilidade total)
	- Lê UI e mundo em voz via Narration TTS
	- Foco: elemento UI atual, entidade RRW, texto
	- Navegação: Tab/Shift+Tab por elementos, setas por entidades
	- Anúncios: "Botão Criar Vila, pressione A para ativar"
	- Integra com Narration + Gamepad + ConsoleSupport + DockUI
	============================================================
]]

local ScreenReader = {}
ScreenReader.__index = ScreenReader

function ScreenReader.novo()
	local self = setmetatable({}, ScreenReader)
	self.Ativo = false
	self.FocoAtual = nil -- { Tipo, Id, Nome, Desc, Pos }
	self.HistoricoLeitura = {} -- { Quando, Texto, Tipo }
	self.Velocidade = 1.0
	self.Voz = "pt-BR-Female"
	self.Fila = {}
	self.ElementosNavegaveis = {} -- lista de { Tipo, Nome, Desc, Acao }
	self.IndiceFoco = 1
	return self
end

function ScreenReader:Ativar()
	self.Ativo = true
	return true
end

function ScreenReader:Desativar()
	self.Ativo = false
	return true
end

function ScreenReader:DefinirElementos(elementos)
	-- elementos: { { Tipo, Nome, Desc, Acao }, ... }
	self.ElementosNavegaveis = elementos or {}
	self.IndiceFoco = 1
	if #self.ElementosNavegaveis > 0 then
		self.FocoAtual = self.ElementosNavegaveis[1]
	end
	return #self.ElementosNavegaveis
end

function ScreenReader:Proximo()
	if #self.ElementosNavegaveis == 0 then return nil end
	self.IndiceFoco = self.IndiceFoco + 1
	if self.IndiceFoco > #self.ElementosNavegaveis then self.IndiceFoco = 1 end
	self.FocoAtual = self.ElementosNavegaveis[self.IndiceFoco]
	self:LerFoco()
	return self.FocoAtual
end

function ScreenReader:Anterior()
	if #self.ElementosNavegaveis == 0 then return nil end
	self.IndiceFoco = self.IndiceFoco - 1
	if self.IndiceFoco < 1 then self.IndiceFoco = #self.ElementosNavegaveis end
	self.FocoAtual = self.ElementosNavegaveis[self.IndiceFoco]
	self:LerFoco()
	return self.FocoAtual
end

function ScreenReader:LerFoco()
	if not self.Ativo or not self.FocoAtual then return nil end
	local texto = ""
	if self.FocoAtual.Tipo == "Botao" then
		texto = "Botão "..self.FocoAtual.Nome..". "..(self.FocoAtual.Desc or "")..". Pressione A para ativar."
	elseif self.FocoAtual.Tipo == "Painel" then
		texto = "Painel "..self.FocoAtual.Nome..". "..(self.FocoAtual.Desc or "")
	elseif self.FocoAtual.Tipo == "Entidade" then
		texto = "Entidade "..self.FocoAtual.Nome.." tipo "..(self.FocoAtual.Tipo or "").." na posição "..tostring(self.FocoAtual.Pos or "")
	else
		texto = (self.FocoAtual.Nome or "").." "..(self.FocoAtual.Desc or "")
	end
	table.insert(self.Fila, { Texto=texto, Quando=os.time(), Tipo=self.FocoAtual.Tipo })
	if #self.Fila > 20 then table.remove(self.Fila,1) end
	table.insert(self.HistoricoLeitura, { Quando=os.time(), Texto=texto, Tipo=self.FocoAtual.Tipo })
	if #self.HistoricoLeitura > 50 then table.remove(self.HistoricoLeitura,1) end
	return texto
end

function ScreenReader:LerTexto(texto, prioridade)
	if not self.Ativo then return false end
	prioridade = prioridade or 1
	table.insert(self.Fila, { Texto=texto, Quando=os.time(), Prioridade=prioridade, Tipo="Texto" })
	table.sort(self.Fila, function(a,b) return (a.Prioridade or 1) > (b.Prioridade or 1) end)
	if #self.Fila > 20 then table.remove(self.Fila,1) end
	return true
end

function ScreenReader:ProximaFala()
	if #self.Fila == 0 then return nil end
	return table.remove(self.Fila,1)
end

function ScreenReader:PayloadTTS(texto)
	return {
		Texto=texto,
		Voz=self.Voz,
		Velocidade=self.Velocidade,
		Formato="mp3",
	}
end

function ScreenReader:ListarHistorico(n)
	n = n or 10
	local lista={}
	for i=math.max(1, #self.HistoricoLeitura-n+1), #self.HistoricoLeitura do
		table.insert(lista, self.HistoricoLeitura[i])
	end
	return lista
end

function ScreenReader:Serializar()
	return {
		Ativo=self.Ativo,
		Foco=self.FocoAtual,
		Fila=#self.Fila,
		Historico=#self.HistoricoLeitura,
		Voz=self.Voz,
		Velocidade=self.Velocidade,
		TotalNavegaveis=#self.ElementosNavegaveis,
	}
end

return ScreenReader
]]></ProtectedString></Properties></Item>
