     <Item class="ModuleScript" referent="RBX927155"><Properties><string name="Name">MaterialSounds</string><ProtectedString name="Source"><![CDATA[--[[
	MaterialSounds (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Audio > MaterialSounds
	============================================================
	F15 — SONS POR MATERIA RRW (Ring1).

	Cada materia semantica (Madeira, Rocha, Metal, etc) tem
	sons caracteristicos: passos, impacto, quebra, fogo.

	Integra com:
	- RRW Materia (densidade, tipo)
	- AudioMixer (toca 3D)
	- Physica (colisao, destruicao)

	Dev pode registrar sons proprios: Registrar(tipoMateria, evento, soundId)
	IA pode gerar sons via relay: POST /audio/gerar {Descricao} → {SoundId}
	============================================================
]]

local MaterialSounds = {}

-- Catalogo nativo: materia -> evento -> soundId (placeholders, dev troca por ids reais)
MaterialSounds.Catalogo = {
	Madeira = {
		Passo = 12222025,
		Impacto = 12222026,
		Quebra = 12222027,
		Fogo = 12222028,
	},
	Rocha = {
		Passo = 12222030,
		Impacto = 12222031,
		Quebra = 12222032,
	},
	Metal = {
		Passo = 12222034,
		Impacto = 12222035,
		Quebra = 12222036,
	},
	Grama = {
		Passo = 12222038,
	},
	Agua = {
		Passo = 12222040,
		Impacto = 12222041,
	},
	Cristal = {
		Impacto = 12222043,
		Quebra = 12222044,
		Ambiente = 12222045,
	},
	Areia = {
		Passo = 12222047,
	},
	Neve = {
		Passo = 12222049,
	},
}

function MaterialSounds.Obter(materiaNome, evento)
	materiaNome = materiaNome or "Rocha"
	evento = evento or "Impacto"
	local mat = MaterialSounds.Catalogo[materiaNome]
	if mat and mat[evento] then return mat[evento] end
	-- fallback: tenta Rocha
	local rocha = MaterialSounds.Catalogo.Rocha
	if rocha and rocha[evento] then return rocha[evento] end
	return nil
end

function MaterialSounds.Registrar(materiaNome, evento, soundId)
	if type(materiaNome) ~= "string" or type(evento) ~= "string" or type(soundId) ~= "number" then return false end
	MaterialSounds.Catalogo[materiaNome] = MaterialSounds.Catalogo[materiaNome] or {}
	MaterialSounds.Catalogo[materiaNome][evento] = soundId
	return true
end

function MaterialSounds.Listar()
	local lista = {}
	for materia, eventos in pairs(MaterialSounds.Catalogo) do
		for ev, id in pairs(eventos) do
			table.insert(lista, { Materia=materia, Evento=ev, Id=id })
		end
	end
	table.sort(lista, function(a,b)
		if a.Materia ~= b.Materia then return a.Materia < b.Materia end
		return a.Evento < b.Evento
	end)
	return lista
end

function MaterialSounds.TocarParaEntidade(entidade, evento, AudioMixer, volume)
	if not entidade then return nil end
	-- tenta pegar materia do arquetipo
	local ok, Archetypes = pcall(function() return require(game:GetService("ReplicatedStorage").Arkhe.RRW.Archetypes) end)
	local materiaNome = "Rocha"
	if ok and Archetypes and Archetypes.Get then
		local arq = Archetypes.Get(entidade.Arquetipo)
		if arq and arq.Fisica and arq.Fisica.Materia then
			materiaNome = arq.Fisica.Materia
		elseif arq and arq.Categoria == "Natureza" then
			materiaNome = "Madeira"
		end
	end
	local soundId = MaterialSounds.Obter(materiaNome, evento)
	if not soundId then return nil end
	if AudioMixer and AudioMixer.TocarEfeito3D then
		local pos = Vector3.new(entidade.Pos.X, entidade.Pos.Y, entidade.Pos.Z)
		return AudioMixer.TocarEfeito3D(pos, soundId, volume or 0.7)
	end
	return soundId
end

return MaterialSounds
]]></ProtectedString></Properties></Item>
