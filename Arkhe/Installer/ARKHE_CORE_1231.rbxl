     </Properties>
     <Item class="ModuleScript" referent="RBX249176"><Properties><string name="Name">AntiCheat</string><ProtectedString name="Source"><![CDATA[--[[
	AntiCheat (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Multiplayer > AntiCheat
	============================================================
	F16 — ANTI-CHEAT validação para multiplayer RRW
	- Valida movimento, ações, inventário
	- Rate limiting por ação
	- Detecção de teleporte, velocidade, spam
	- Integra com Replicator e Economy
	============================================================
]]

local AntiCheat = {}

AntiCheat.Limites = {
	MaxVelocidade = 80, -- studs/s
	MaxTeleporte = 150, -- distância instantânea suspeita
	MaxAcoesPorSegundo = 12,
	MaxInventarioAddPorSegundo = 5,
}

AntiCheat.Historico = {} -- [userId] = { UltimaPos, UltimoTempo, AcoesCount, Violacoes }

function AntiCheat.ObterHistorico(userId)
	AntiCheat.Historico[userId] = AntiCheat.Historico[userId] or {
		UltimaPos=Vector3.new(0,0,0),
		UltimoTempo=os.clock(),
		AcoesCount=0,
		UltimoReset=os.clock(),
		Violacoes=0,
		Logs={},
	}
	return AntiCheat.Historico[userId]
end

function AntiCheat.ValidarMovimento(userId, novaPos)
	local hist = AntiCheat.ObterHistorico(userId)
	local agora = os.clock()
	local dt = agora - hist.UltimoTempo
	if dt < 0.01 then dt = 0.01 end
	local dist = (novaPos - hist.UltimaPos).Magnitude
	local vel = dist / dt

	if dist > AntiCheat.Limites.MaxTeleporte and dt < 1 then
		hist.Violacoes = hist.Violacoes + 1
		table.insert(hist.Logs, { Tipo="Teleporte", Dist=dist, Quando=agora })
		if #hist.Logs > 20 then table.remove(hist.Logs, 1) end
		return false, "teleporte suspeito "..math.floor(dist).." studs"
	end

	if vel > AntiCheat.Limites.MaxVelocidade then
		hist.Violacoes = hist.Violacoes + 1
		table.insert(hist.Logs, { Tipo="Velocidade", Vel=vel, Quando=agora })
		if #hist.Logs > 20 then table.remove(hist.Logs, 1) end
		return false, "velocidade "..math.floor(vel).." > "..AntiCheat.Limites.MaxVelocidade
	end

	hist.UltimaPos = novaPos
	hist.UltimoTempo = agora
	return true
end

function AntiCheat.ValidarAcao(userId, acaoNome)
	local hist = AntiCheat.ObterHistorico(userId)
	local agora = os.clock()
	if agora - hist.UltimoReset > 1 then
		hist.AcoesCount = 0
		hist.UltimoReset = agora
	end
	hist.AcoesCount = hist.AcoesCount + 1
	if hist.AcoesCount > AntiCheat.Limites.MaxAcoesPorSegundo then
		hist.Violacoes = hist.Violacoes + 1
		table.insert(hist.Logs, { Tipo="SpamAcao", Acao=acaoNome, Quando=agora })
		if #hist.Logs > 20 then table.remove(hist.Logs, 1) end
		return false, "spam de acoes "..hist.AcoesCount
	end
	return true
end

function AntiCheat.ValidarInventario(userId, qtd)
	-- simples rate limit
	return AntiCheat.ValidarAcao(userId, "InventarioAdd")
end

function AntiCheat.ObterViolacoes(userId)
	local hist = AntiCheat.Historico[userId]
	return hist and hist.Violacoes or 0
end

function AntiCheat.ListarLogs(userId, n)
	local hist = AntiCheat.Historico[userId]
	if not hist then return {} end
	n = n or 10
	local lista={}
	for i=math.max(1,#hist.Logs-n+1),#hist.Logs do table.insert(lista, hist.Logs[i]) end
	return lista
end

function AntiCheat.Limpar(userId)
	AntiCheat.Historico[userId] = nil
end

function AntiCheat.Stats()
	local total=0
	local violacoes=0
	for _, h in pairs(AntiCheat.Historico) do
		total=total+1
		violacoes=violacoes+h.Violacoes
	end
	return { TotalJogadores=total, TotalViolacoes=violacoes, Limites=AntiCheat.Limites }
end

return AntiCheat
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX94227"><Properties><string name="Name">ClientPrediction</string><ProtectedString name="Source"><![CDATA[[[
	ClientPrediction (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Multiplayer > ClientPrediction
	============================================================
	F16 — CLIENT PREDICTION (predição local + reconciliação)
	- Cliente prediz movimento localmente sem esperar server
	- Server envia estado autoritativo periodicamente
	- Se divergir, reconcilia (interpola para estado server)
	- Inputs: { Id, Tipo, Tempo, Dados } com buffer
	- Integra com Replicator + AntiCheat + RRW
	============================================================
]]

local ClientPrediction = {}
ClientPrediction.__index = ClientPrediction

function ClientPrediction.novo(userId)
	local self = setmetatable({}, ClientPrediction)
	self.UserId = userId or 0
	self.InputBuffer = {} -- { Id, Tipo, Tempo, Dados, Processado }
	self.EstadoPredito = { Pos=Vector3.new(0,0,0), Vel=Vector3.new(0,0,0), Tempo=os.time() }
	self.EstadoServer = { Pos=Vector3.new(0,0,0), Vel=Vector3.new(0,0,0), Tempo=os.time() }
	self.ProximoInputId = 1
	self.ErroAcumulado = 0
	self.NumReconciliacoes = 0
	return self
end

function ClientPrediction:AdicionarInput(tipo, dados)
	local input = {
		Id=self.ProximoInputId,
		Tipo=tipo, -- Mover, Pular, Atacar, etc
		Tempo=os.time(),
		Dados=dados or {},
		Processado=false,
	}
	self.ProximoInputId = self.ProximoInputId + 1
	table.insert(self.InputBuffer, input)
	if #self.InputBuffer > 60 then table.remove(self.InputBuffer,1) end
	return input
end

function ClientPrediction:Predizer(dt, input)
	dt = dt or 0.033
	-- simula movimento simples
	if input and input.Tipo=="Mover" then
		local dir = input.Dados.Direcao or Vector3.new(0,0,1)
		local vel = input.Dados.Velocidade or 16
		self.EstadoPredito.Vel = dir * vel
		self.EstadoPredito.Pos = self.EstadoPredito.Pos + self.EstadoPredito.Vel * dt
	elseif input and input.Tipo=="Pular" then
		self.EstadoPredito.Vel = Vector3.new(self.EstadoPredito.Vel.X, 20, self.EstadoPredito.Vel.Z)
	end
	self.EstadoPredito.Tempo = os.time()
	if input then input.Processado=true end
	return self.EstadoPredito
end

function ClientPrediction:ReceberEstadoServer(estadoServer, ultimoInputIdProcessado)
	-- estadoServer: { Pos, Vel, Tempo, UltimoInputId }
	self.EstadoServer = estadoServer
	self.EstadoServer.Tempo = os.time()

	-- calcula erro
	local erro = (self.EstadoPredito.Pos - estadoServer.Pos).Magnitude
	self.ErroAcumulado = self.ErroAcumulado + erro

	-- se erro grande, reconcilia
	if erro > 2 then
		self:Reconciliar(estadoServer, ultimoInputIdProcessado)
	end

	-- limpa inputs já processados pelo server
	local novosBuffer={}
	for _, inp in ipairs(self.InputBuffer) do
		if inp.Id > (ultimoInputIdProcessado or 0) then
			table.insert(novosBuffer, inp)
		end
	end
	self.InputBuffer = novosBuffer
	return erro
end

function ClientPrediction:Reconciliar(estadoServer, ultimoInputId)
	-- volta para estado server e reaplica inputs não processados
	self.EstadoPredito.Pos = estadoServer.Pos
	self.EstadoPredito.Vel = estadoServer.Vel
	-- reaplica inputs pendentes
	for _, inp in ipairs(self.InputBuffer) do
		if inp.Id > (ultimoInputId or 0) then
			self:Predizer(0.033, inp)
		end
	end
	self.NumReconciliacoes = self.NumReconciliacoes + 1
	return self.EstadoPredito
end

function ClientPrediction:InterpolarParaServer(alpha)
	alpha = math.clamp(alpha or 0.1, 0, 1)
	self.EstadoPredito.Pos = self.EstadoPredito.Pos:Lerp(self.EstadoServer.Pos, alpha)
	self.EstadoPredito.Vel = self.EstadoPredito.Vel:Lerp(self.EstadoServer.Vel, alpha)
	return self.EstadoPredito
end

function ClientPrediction:Serializar()
	return {
		UserId=self.UserId,
		PosPredita={ X=self.EstadoPredito.Pos.X, Y=self.EstadoPredito.Pos.Y, Z=self.EstadoPredito.Pos.Z },
		PosServer={ X=self.EstadoServer.Pos.X, Y=self.EstadoServer.Pos.Y, Z=self.EstadoServer.Pos.Z },
		Erro=self.ErroAcumulado,
		Reconciliacoes=self.NumReconciliacoes,
		InputsPendentes=#self.InputBuffer,
		ProximoId=self.ProximoInputId,
	}
end

return ClientPrediction
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX28584"><Properties><string name="Name">CrossServer</string><ProtectedString name="Source"><![CDATA[--[[
	CrossServer (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Multiplayer > CrossServer
	============================================================
	F16 — CROSS-SERVER SYNC via relay
	- Sincroniza RRW delta entre servidores via relay
	- Shards: cada servidor é um shard do mundo global
	- Contrato relay: POST /multiplayer/sync { ShardId, Delta, Timestamp }
	- Fallback: funciona local se sem relay (honestidade)
	============================================================
]]

local CrossServer = {}

CrossServer.ShardId = "shard_"..math.random(1000,9999)
CrossServer.ShardNome = "Vila Principal"
CrossServer.UltimoSync = 0
CrossServer.IntervaloSync = 2 -- segundos
CrossServer.FilaDelta = {} -- deltas pendentes para enviar
CrossServer.DeltasRecebidos = {} -- do relay
CrossServer.MaxFila = 100

function CrossServer.DefinirShard(id, nome)
	CrossServer.ShardId = id or CrossServer.ShardId
	CrossServer.ShardNome = nome or CrossServer.ShardNome
end

function CrossServer.EnfileirarDelta(delta)
	if #CrossServer.FilaDelta >= CrossServer.MaxFila then table.remove(CrossServer.FilaDelta, 1) end
	table.insert(CrossServer.FilaDelta, { Delta=delta, Timestamp=os.time(), ShardId=CrossServer.ShardId })
end

function CrossServer.ColetarParaEnvio()
	if #CrossServer.FilaDelta == 0 then return nil end
	local pacote = {
		ShardId=CrossServer.ShardId,
		ShardNome=CrossServer.ShardNome,
		Deltas=CrossServer.FilaDelta,
		Timestamp=os.time(),
	}
	CrossServer.FilaDelta = {}
	CrossServer.UltimoSync = os.time()
	return pacote
end

function CrossServer.ReceberDoRelay(dados)
	-- dados = { Deltas={ {ShardId, Delta, Timestamp} } }
	if not dados or not dados.Deltas then return 0 end
	local count=0
	for _, entry in ipairs(dados.Deltas) do
		if entry.ShardId ~= CrossServer.ShardId then
			table.insert(CrossServer.DeltasRecebidos, entry)
			count=count+1
		end
	end
	if #CrossServer.DeltasRecebidos > CrossServer.MaxFila then
		for i=1,#CrossServer.DeltasRecebidos-CrossServer.MaxFila do table.remove(CrossServer.DeltasRecebidos, 1) end
	end
	return count
end

function CrossServer.AplicarRecebidos(mundo, replicator)
	if not mundo then return 0 end
	local aplicados=0
	for _, entry in ipairs(CrossServer.DeltasRecebidos) do
		if replicator and replicator.AplicarDeltaNoCliente then
			-- aplica no mundo local
			-- para simplificar, só conta
			aplicados=aplicados+1
		end
	end
	CrossServer.DeltasRecebidos = {}
	return aplicados
end

function CrossServer.PayloadSync()
	return {
		ShardId=CrossServer.ShardId,
		ShardNome=CrossServer.ShardNome,
		Timestamp=os.time(),
		-- Deltas são preenchidos por ColetarParaEnvio
	}
end

function CrossServer.Stats()
	return {
		ShardId=CrossServer.ShardId,
		ShardNome=CrossServer.ShardNome,
		FilaEnvio=#CrossServer.FilaDelta,
		FilaRecebidos=#CrossServer.DeltasRecebidos,
		UltimoSync=CrossServer.UltimoSync,
		Intervalo=CrossServer.IntervaloSync,
	}
end

function CrossServer.Limpar()
	CrossServer.FilaDelta={}
	CrossServer.DeltasRecebidos={}
end

return CrossServer
]]></ProtectedString></Properties></Item>
