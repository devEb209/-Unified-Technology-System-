     <Item class="ModuleScript" referent="RBX132162"><Properties><string name="Name">RoadSpline</string><ProtectedString name="Source"><![CDATA[--[[
	RoadSpline (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Terrain > RoadSpline
	============================================================
	F4 — ESTRADAS por spline que achata e suaviza o heightfield.
	- Pontos com largura
	- CarvarNoCampo: media de altura ao longo da estrada (flatten)
	============================================================
]]

local RoadSpline = {}
RoadSpline.__index = RoadSpline

function RoadSpline.novo(nome)
	local self = setmetatable({}, RoadSpline)
	self.Nome = nome or "Estrada"
	self.Pontos = {} -- { Pos=Vector3, Largura=number }
	return self
end

function RoadSpline:AdicionarPonto(pos, largura)
	largura = math.clamp(largura or 12, 3, 40)
	table.insert(self.Pontos, { Pos=pos, Largura=largura })
	return #self.Pontos
end

local function catmullRom(p0,p1,p2,p3,t)
	local t2=t*t; local t3=t2*t
	return 0.5 * ((2*p1)+(-p0+p2)*t+(2*p0-5*p1+4*p2-p3)*t2+(-p0+3*p1-3*p2+p3)*t3)
end

function RoadSpline:Interpolar(t)
	local n=#self.Pontos
	if n==0 then return nil end
	if n==1 then return self.Pontos[1].Pos end
	local seg=(n-1)*t
	local i=math.floor(seg)+1
	local f=seg-math.floor(seg)
	i=math.clamp(i,1,n-1)
	local p0=self.Pontos[math.max(1,i-1)].Pos
	local p1=self.Pontos[i].Pos
	local p2=self.Pontos[math.min(n,i+1)].Pos
	local p3=self.Pontos[math.min(n,i+2)].Pos
	return catmullRom(p0,p1,p2,p3,f)
end

function RoadSpline:CarvarNoCampo(campo)
	if not campo or #self.Pontos<2 then return 0 end
	local meio=campo.Largura/2
	local cel=campo.Celula
	-- calcula altura media da estrada
	local alturasAmostra={}
	for s=0,80 do
		local pos=self:Interpolar(s/80)
		if pos then
			local gx=math.clamp(math.floor(pos.X/cel+meio),0,campo.Largura)
			local gz=math.clamp(math.floor(pos.Z/cel+meio),0,campo.Largura)
			table.insert(alturasAmostra, campo.Alturas[gx][gz])
		end
	end
	local media=0
	for _,h in ipairs(alturasAmostra) do media=media+h end
	media = #alturasAmostra>0 and media/#alturasAmostra or 0

	local amostras={}
	for s=0,100 do
		local t=s/100
		local pos=self:Interpolar(t)
		if pos then
			local idx=math.floor(t*(#self.Pontos-1))+1
			local larg=self.Pontos[math.clamp(idx,1,#self.Pontos)].Largura
			table.insert(amostras, {Pos=pos, Largura=larg, Altura=media})
		end
	end
	local flat=0
	for x=0,campo.Largura do
		for z=0,campo.Largura do
			local wx=(x-meio)*cel
			local wz=(z-meio)*cel
			local p2d=Vector3.new(wx,0,wz)
			local menor=math.huge
			local perto=nil
			for _,am in ipairs(amostras) do
				local d=(Vector3.new(am.Pos.X,0,am.Pos.Z)-p2d).Magnitude
				if d<menor then menor=d; perto=am end
			end
			if perto and menor < perto.Largura then
				local fator=1 - (menor/perto.Largura)
				-- lerp para media
				campo.Alturas[x][z] = campo.Alturas[x][z] * (1-fator*0.8) + perto.Altura * fator*0.8
				flat=flat+1
			end
		end
	end
	return flat
end

function RoadSpline:Serializar()
	return { Nome=self.Nome, Pontos=self.Pontos, Total=#self.Pontos }
end
function RoadSpline:Contar() return #self.Pontos end
function RoadSpline:Limpar() self.Pontos={} end

return RoadSpline
]]></ProtectedString></Properties></Item>
