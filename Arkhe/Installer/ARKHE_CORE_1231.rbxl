     <Item class="ModuleScript" referent="RBX728599"><Properties><string name="Name">CaveSystem</string><ProtectedString name="Source"><![CDATA[--[[
	CaveSystem (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Terrain > CaveSystem
	============================================================
	F4 — CAVERNAS & OVERHANGS por CSG aproximado + carving no heightfield.
	- Tuneis: segmento P1->P2 com raio, carva vale no campo + marca area como caverna
	- Camaras: esfera pos+raio
	- Overhangs: usa noise para criar teto falso (altura reduzida + teto elevado)
	- Serializavel, integra com HeightField:CarvarNoCampo e TerrainRender
	============================================================
]]

local CaveSystem = {}
CaveSystem.__index = CaveSystem

function CaveSystem.novo(nome)
	local self = setmetatable({}, CaveSystem)
	self.Nome = nome or "Cavernas"
	self.Tuneis = {} -- { P1=Vector3, P2=Vector3, Raio=number, Tipo="Tunel" }
	self.Camaras = {} -- { Pos=Vector3, Raio=number }
	self.Overhangs = {} -- { Centro=Vector3, Raio=number, AlturaTeto=number }
	return self
end

function CaveSystem:AdicionarTunel(p1, p2, raio)
	raio = math.clamp(raio or 12, 4, 60)
	table.insert(self.Tuneis, { P1=p1, P2=p2, Raio=raio, Tipo="Tunel" })
	return #self.Tuneis
end

function CaveSystem:AdicionarCamara(pos, raio)
	raio = math.clamp(raio or 18, 6, 80)
	table.insert(self.Camaras, { Pos=pos, Raio=raio })
	return #self.Camaras
end

function CaveSystem:AdicionarOverhang(centro, raio, alturaTeto)
	raio = math.clamp(raio or 20, 8, 100)
	alturaTeto = alturaTeto or 15
	table.insert(self.Overhangs, { Centro=centro, Raio=raio, AlturaTeto=alturaTeto })
	return #self.Overhangs
end

-- distancia ponto -> segmento 3D
local function distPontoSegmento(p, a, b)
	local ab = b - a
	local ap = p - a
	local t = ab:Dot(ap) / math.max(ab.Magnitude^2, 0.001)
	t = math.clamp(t, 0, 1)
	local proj = a + ab * t
	return (p - proj).Magnitude, proj
end

-- carva no HeightField (campo precisa ter Alturas[L][L], Largura, Celula)
function CaveSystem:CarvarNoCampo(campo)
	if not campo or not campo.Alturas then return 0 end
	local meio = campo.Largura / 2
	local cel = campo.Celula
	local carved = 0
	for x = 0, campo.Largura do
		for z = 0, campo.Largura do
			local wx = (x - meio) * cel
			local wz = (z - meio) * cel
			local wy = campo.Alturas[x][z]
			local p = Vector3.new(wx, wy, wz)
			-- checa tuneis
			for _, tun in ipairs(self.Tuneis) do
				local dist, _ = distPontoSegmento(p, tun.P1, tun.P2)
				if dist < tun.Raio then
					local fator = (tun.Raio - dist) / tun.Raio
					campo.Alturas[x][z] = campo.Alturas[x][z] - fator * tun.Raio * 0.6
					carved = carved + 1
				end
			end
			-- checa camaras
			for _, cam in ipairs(self.Camaras) do
				local d = (Vector3.new(wx, 0, wz) - Vector3.new(cam.Pos.X, 0, cam.Pos.Z)).Magnitude
				if d < cam.Raio then
					local fator = (cam.Raio - d) / cam.Raio
					campo.Alturas[x][z] = campo.Alturas[x][z] - fator * cam.Raio * 0.8
					carved = carved + 1
				end
			end
			-- overhangs: cria depressao ao redor + platô elevado no centro (simula teto)
			for _, ov in ipairs(self.Overhangs) do
				local d = (Vector3.new(wx, 0, wz) - Vector3.new(ov.Centro.X, 0, ov.Centro.Z)).Magnitude
				if d < ov.Raio then
					if d < ov.Raio * 0.4 then
						-- centro: eleva um pouco para teto
						campo.Alturas[x][z] = campo.Alturas[x][z] + (1 - d/(ov.Raio*0.4)) * ov.AlturaTeto * 0.3
					else
						-- borda: carva entrada
						local fator = (d - ov.Raio*0.4)/(ov.Raio*0.6)
						campo.Alturas[x][z] = campo.Alturas[x][z] - (1-fator) * 8
					end
					carved = carved + 1
				end
			end
		end
	end
	return carved
end

function CaveSystem:Listar()
	local lista = {}
	for i, t in ipairs(self.Tuneis) do
		table.insert(lista, { Id=i, Tipo="Tunel", P1=t.P1, P2=t.P2, Raio=t.Raio })
	end
	for i, c in ipairs(self.Camaras) do
		table.insert(lista, { Id=#self.Tuneis+i, Tipo="Camara", Pos=c.Pos, Raio=c.Raio })
	end
	return lista
end

function CaveSystem:Serializar()
	return {
		Nome=self.Nome,
		Tuneis=self.Tuneis,
		Camaras=self.Camaras,
		Overhangs=self.Overhangs,
		Total=#self.Tuneis + #self.Camaras + #self.Overhangs
	}
end

function CaveSystem:Contar()
	return #self.Tuneis + #self.Camaras + #self.Overhangs
end

function CaveSystem:Limpar()
	self.Tuneis = {}
	self.Camaras = {}
	self.Overhangs = {}
end

return CaveSystem
]]></ProtectedString></Properties></Item>
