     <Item class="ModuleScript" referent="RBX27916"><Properties><string name="Name">CascadeurPlus</string><ProtectedString name="Source"><![CDATA[--[[
  CascadeurPlus (ModuleScript)
  Local: ReplicatedStorage > Arkhe > Animator > CascadeurPlus
  ============================================================================
  Animator melhor que Cascadeur
  - Cascadeur tem física de animação, nós temos + RRW + D-O15 + AutoBalance + Trajectory
  - Ferramentas: AutoPosing, PhysicsSecondary, Balance, Trajectory, Motion Prediction
  ============================================================================
]]

local CascadeurPlus = {}
CascadeurPlus.__index = CascadeurPlus

function CascadeurPlus.novo()
  return setmetatable({
    Ferramentas={
      AutoPosing={Desc="Gera pose automaticamente via IK + física", MelhorQue="Cascadeur AutoPosing"},
      PhysicsSecondary={Desc="Física secundária cabelo/roupa com RRW", MelhorQue="Cascadeur Physics"},
      Balance={Desc="Balanceamento automático com centro de massa", MelhorQue="Cascadeur Balance"},
      Trajectory={Desc="Trajetória com colisão RRW", MelhorQue="Cascadeur Trajectory"},
      MotionPrediction={Desc="Prediz movimento com IA", MelhorQue="Cascadeur Motion"},
      AutoOverlap={Desc="Overlap e follow-through automático", MelhorQue="Cascadeur Overlap"},
      GroundContact={Desc="Contato com solo via raycast RRW", MelhorQue="Cascadeur Ground"},
    },
    Ativo=true,
  }, {__index=CascadeurPlus})
end

function CascadeurPlus:GerarAnimacao(poseInicial, poseFinal, duracao)
  local frames={}
  local totalFrames=math.floor(duracao*60)
  for i=0, totalFrames do
    local t=i/totalFrames
    table.insert(frames, {T=t, Pose=self:Interpolar(poseInicial, poseFinal, t), Balanceado=true})
  end
  return frames
end

function CascadeurPlus:Interpolar(a,b,t)
  return {X=a.X+(b.X-a.X)*t, Y=a.Y+(b.Y-a.Y)*t, Z=a.Z+(b.Z-a.Z)*t}
end

function CascadeurPlus:ListarFerramentas() return self.Ferramentas end
function CascadeurPlus:Serializar() return {TotalFerramentas=self:Contar(), MelhorQueCascadeur=true} end
function CascadeurPlus:Contar() local n=0 for _ in pairs(self.Ferramentas) do n=n+1 end return n end

return CascadeurPlus
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX888495"><Properties><string name="Name">CurveEditor</string><ProtectedString name="Source"><![CDATA[--[[
	CurveEditor (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Animator > CurveEditor
	============================================================
	F6 — Editor de curvas de easing para keyframes.
	- Curvas: Linear, SineInOut, QuadInOut, CubicInOut, Elastic, Bounce, Bezier custom
	- Avaliar(t, tipo, params) -> valor 0..1
	- Pontos de controle Bezier para Timeline visual
	- Serializavel
	============================================================
]]

local CurveEditor = {}

CurveEditor.Tipos = {
	"Linear", "SineIn", "SineOut", "SineInOut",
	"QuadIn", "QuadOut", "QuadInOut",
	"CubicIn", "CubicOut", "CubicInOut",
	"ElasticOut", "BounceOut",
	"Bezier"
}

function CurveEditor.Avaliar(t, tipo, params)
	t = math.clamp(t, 0, 1)
	tipo = tipo or "SineInOut"
	if tipo == "Linear" then
		return t
	elseif tipo == "SineIn" then
		return 1 - math.cos(t * math.pi / 2)
	elseif tipo == "SineOut" then
		return math.sin(t * math.pi / 2)
	elseif tipo == "SineInOut" then
		return 0.5 * (1 - math.cos(math.pi * t))
	elseif tipo == "QuadIn" then
		return t*t
	elseif tipo == "QuadOut" then
		return 1 - (1-t)*(1-t)
	elseif tipo == "QuadInOut" then
		if t < 0.5 then return 2*t*t else return 1 - (-2*t+2)^2/2 end
	elseif tipo == "CubicIn" then
		return t*t*t
	elseif tipo == "CubicOut" then
		return 1 - (1-t)^3
	elseif tipo == "CubicInOut" then
		if t < 0.5 then return 4*t*t*t else return 1 - (-2*t+2)^3/2 end
	elseif tipo == "ElasticOut" then
		if t==0 then return 0 end
		if t==1 then return 1 end
		local c4 = (2*math.pi)/3
		return 2^(-10*t) * math.sin((t*10 -0.75)*c4) + 1
	elseif tipo == "BounceOut" then
		local n1=7.5625; local d1=2.75
		if t < 1/d1 then return n1*t*t
		elseif t < 2/d1 then t=t-1.5/d1; return n1*t*t+0.75
		elseif t < 2.5/d1 then t=t-2.25/d1; return n1*t*t+0.9375
		else t=t-2.625/d1; return n1*t*t+0.984375 end
	elseif tipo == "Bezier" then
		-- params = { p1x,p1y,p2x,p2y }  cubic bezier 0..1
		local p1x,p1y,p2x,p2y = 0.25,0.1,0.25,1
		if params and #params>=4 then p1x,p1y,p2x,p2y = params[1],params[2],params[3],params[4] end
		-- approximate bezier Y at t (simplified: treat t as bezier param)
		local u = 1-t
		local tt = t*t
		local uu = u*u
		local uuu = uu*u
		local ttt = tt*t
		-- cubic bezier formula for y: (1-t)^3*0 + 3(1-t)^2 t p1y + 3(1-t) t^2 p2y + t^3*1
		return 3*uu*t*p1y + 3*u*tt*p2y + ttt
	end
	return t
end

function CurveEditor.Listar()
	local lista={}
	for _, nome in ipairs(CurveEditor.Tipos) do
		table.insert(lista, { Nome=nome, Desc="Easing "..nome })
	end
	return lista
end

-- Gera 32 amostras para preview visual
function CurveEditor.Amostrar(tipo, params, amostras)
	amostras = amostras or 32
	local pontos={}
	for i=0,amostras do
		local t=i/amostras
		table.insert(pontos, { X=t, Y=CurveEditor.Avaliar(t, tipo, params) })
	end
	return pontos
end

-- Converte curva para Timeline: interpola entre dois keyframes com easing
function CurveEditor.InterpolarKeyframes(kf1, kf2, tempo, tipo)
	if not kf1 or not kf2 then return nil end
	local dur = kf2.Tempo - kf1.Tempo
	if dur <= 0 then return kf1 end
	local t = math.clamp((tempo - kf1.Tempo)/dur, 0, 1)
	local e = CurveEditor.Avaliar(t, tipo or kf1.Easing or "SineInOut", kf1.BezierParams)
	-- interpola Pos e Rot
	local pos = kf1.Pos:Lerp(kf2.Pos, e)
	-- lerp rot via CFrame
	local cf1 = CFrame.Angles(math.rad(kf1.Rot.X), math.rad(kf1.Rot.Y), math.rad(kf1.Rot.Z))
	local cf2 = CFrame.Angles(math.rad(kf2.Rot.X), math.rad(kf2.Rot.Y), math.rad(kf2.Rot.Z))
	local cf = cf1:Lerp(cf2, e)
	local rx,ry,rz = cf:ToEulerAnglesYXZ()
	return {
		Pos=pos,
		Rot=Vector3.new(math.deg(rx), math.deg(ry), math.deg(rz)),
		Easing=tipo
	}
end

function CurveEditor.SerializarCurva(tipo, params)
	return { Tipo=tipo, Params=params or {}, Amostras=CurveEditor.Amostrar(tipo, params, 16) }
end

return CurveEditor
]]></ProtectedString></Properties></Item>
