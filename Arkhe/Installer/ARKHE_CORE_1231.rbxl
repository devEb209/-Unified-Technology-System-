     <Item class="ModuleScript" referent="RBX729714"><Properties><string name="Name">Subtitles</string><ProtectedString name="Source"><![CDATA[--[[
	Subtitles (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Accessibility > Subtitles
	============================================================
	F19 — LEGENDAS AUTOMÁTICAS (para todos os sons)
	- Legenda: { Id, Texto, Inicio, Duracao, Falante, Cor, Pos }
	- Fila: mostra legendas sincronizadas com áudio
	- Estilos: Normal, Grande, AltoContraste, Fundo escuro
	- Idiomas: pt-BR, en-US, es, etc
	- Integra com AudioMixer + Narration + Dialogue
	============================================================
]]

local Subtitles = {}
Subtitles.__index = Subtitles

Subtitles.Estilos = {
	Normal = { Tamanho=18, Cor=Color3.fromRGB(255,255,255), Fundo=Color3.fromRGB(0,0,0), Opacidade=0.7 },
	Grande = { Tamanho=24, Cor=Color3.fromRGB(255,255,255), Fundo=Color3.fromRGB(0,0,0), Opacidade=0.8 },
	AltoContraste = { Tamanho=20, Cor=Color3.fromRGB(255,255,0), Fundo=Color3.fromRGB(0,0,0), Opacidade=1.0 },
	Pequeno = { Tamanho=14, Cor=Color3.fromRGB(200,200,200), Fundo=Color3.fromRGB(0,0,0), Opacidade=0.5 },
}

function Subtitles.novo()
	local self = setmetatable({}, Subtitles)
	self.Legendas = {} -- [id] = legenda
	self.FilaAtiva = {} -- legendas atualmente na tela
	self.Historico = {} -- últimas 30
	self.EstiloAtual = "Normal"
	self.Idioma = "pt-BR"
	self.Ativo = true
	self.ProximoId = 1
	return self
end

function Subtitles:Adicionar(texto, duracao, falante, cor, pos)
	duracao = duracao or 3
	local id = "sub_"..self.ProximoId
	self.ProximoId = self.ProximoId + 1
	local legenda = {
		Id=id,
		Texto=texto,
		Inicio=os.time(),
		Duracao=duracao,
		Falante=falante or "Narrador",
		Cor=cor or Color3.fromRGB(255,255,255),
		Pos=pos or "Baixo", -- Baixo/Centro/Topo
		Idioma=self.Idioma,
		ExpiraEm=os.time()+duracao,
	}
	self.Legendas[id]=legenda
	table.insert(self.FilaAtiva, legenda)
	table.insert(self.Historico, legenda)
	if #self.Historico > 30 then table.remove(self.Historico,1) end
	if #self.FilaAtiva > 3 then table.remove(self.FilaAtiva,1) end
	return legenda
end

function Subtitles:Remover(id)
	self.Legendas[id]=nil
	for i, leg in ipairs(self.FilaAtiva) do
		if leg.Id == id then table.remove(self.FilaAtiva,i) break end
	end
	return true
end

function Subtitles:Atualizar()
	-- remove expiradas
	local agora = os.time()
	for i=#self.FilaAtiva, 1, -1 do
		if agora >= self.FilaAtiva[i].ExpiraEm then
			table.remove(self.FilaAtiva,i)
		end
	end
	return #self.FilaAtiva
end

function Subtitles:DefinirEstilo(estilo)
	if Subtitles.Estilos[estilo] then
		self.EstiloAtual = estilo
		return true
	end
	return false
end

function Subtitles:DefinirIdioma(idioma)
	self.Idioma = idioma
	return true
end

function Subtitles:LegendarAudio(soundId, textoAutomatico, falante)
	-- se textoAutomatico não fornecido, gera placeholder
	textoAutomatico = textoAutomatico or "[Som "..tostring(soundId).."]"
	return self:Adicionar(textoAutomatico, 3, falante, nil, "Baixo")
end

function Subtitles:LegendarDialogue(dialogueNo, falante)
	-- dialogueNo: { Texto, ... }
	if not dialogueNo then return nil end
	return self:Adicionar(dialogueNo.Texto or dialogueNo, 4, falante or "NPC", nil, "Baixo")
end

function Subtitles:ListarAtivas()
	self:Atualizar()
	return self.FilaAtiva
end

function Subtitles:ListarHistorico(n)
	n = n or 10
	local lista={}
	for i=math.max(1, #self.Historico-n+1), #self.Historico do table.insert(lista, self.Historico[i]) end
	return lista
end

function Subtitles:Serializar()
	return {
		Ativo=self.Ativo,
		Estilo=self.EstiloAtual,
		Idioma=self.Idioma,
		Ativas=#self.FilaAtiva,
		Historico=#self.Historico,
		Estilos=(function() local l={} for k,_ in pairs(Subtitles.Estilos) do table.insert(l,k) end return l end)(),
	}
end

return Subtitles
]]></ProtectedString></Properties></Item>
