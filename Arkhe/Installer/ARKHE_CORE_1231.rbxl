     <Item class="ModuleScript" referent="RBX231190"><Properties><string name="Name">OAuth2Manager</string><ProtectedString name="Source"><![CDATA[[[
	OAuth2Manager (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Publish > OAuth2Manager
	============================================================
	F12 — OAUTH2 PARA OPEN CLOUD PUBLISH
	- Fluxo: 1) Criar URL autorização 2) Usuário autoriza no browser
	  3) Relay recebe code 4) Troca por access_token 5) Usa token
	  para universe.place:write
	- Token armazenado seguro no relay, nunca no client
	- Scopes: universe.place:write, universe.script:write, asset:write
	- Refresh: access_token expira, usa refresh_token
	- Integra com WorldSerializer + RBXDomBuilder + relay
	============================================================
]]

local OAuth2Manager = {}
OAuth2Manager.__index = OAuth2Manager

OAuth2Manager.Scopes = {
	"universe.place:write",
	"universe.script:write",
	"asset:write",
	"user:read",
}

OAuth2Manager.Endpoints = {
	AuthUrl = "https://apis.roblox.com/oauth/v1/authorize",
	TokenUrl = "https://apis.roblox.com/oauth/v1/token",
	RevokeUrl = "https://apis.roblox.com/oauth/v1/token/revoke",
}

function OAuth2Manager.novo(clientId)
	local self = setmetatable({}, OAuth2Manager)
	self.ClientId = clientId or "arkhe_client"
	self.AccessToken = nil
	self.RefreshToken = nil
	self.ExpiresEm = 0
	self.ScopesConcedidos = {}
	self.UsuarioId = nil
	self.Estado = "Desconectado" -- Desconectado/Autorizando/Conectado/Expirado/Erro
	self.CodigoAuth = nil
	return self
end

function OAuth2Manager:GerarUrlAutorizacao(redirectUri, state)
	redirectUri = redirectUri or "https://arkhe.relay/oauth/callback"
	state = state or "state_"..math.random(100000,999999)
	local scopes = table.concat(OAuth2Manager.Scopes, " ")
	local url = OAuth2Manager.Endpoints.AuthUrl ..
		"?client_id="..self.ClientId ..
		"&redirect_uri="..redirectUri ..
		"&scope="..string.gsub(scopes, " ", "%%20") ..
		"&response_type=code" ..
		"&state="..state
	self.Estado = "Autorizando"
	self.State = state
	return url, state
end

function OAuth2Manager:ReceberCodigo(code, state)
	if state ~= self.State then return false, "State inválido" end
	self.CodigoAuth = code
	self.Estado = "CodigoRecebido"
	return true
end

function OAuth2Manager:PayloadTrocaToken(code, redirectUri)
	return {
		grant_type="authorization_code",
		client_id=self.ClientId,
		code=code,
		redirect_uri=redirectUri or "https://arkhe.relay/oauth/callback",
	}
end

function OAuth2Manager:ReceberTokens(resposta)
	-- resposta relay: { access_token, refresh_token, expires_in, scope, user_id }
	if not resposta or not resposta.access_token then return false, "Sem access_token" end
	self.AccessToken = resposta.access_token
	self.RefreshToken = resposta.refresh_token
	self.ExpiresEm = os.time() + (resposta.expires_in or 3600)
	self.ScopesConcedidos = {}
	for scope in string.gmatch(resposta.scope or "", "%S+") do
		table.insert(self.ScopesConcedidos, scope)
	end
	self.UsuarioId = resposta.user_id
	self.Estado = "Conectado"
	return true
end

function OAuth2Manager:PrecisaRefresh()
	return os.time() >= self.ExpiresEm - 60 -- 1 min antes
end

function OAuth2Manager:PayloadRefresh()
	return {
		grant_type="refresh_token",
		client_id=self.ClientId,
		refresh_token=self.RefreshToken,
	}
end

function OAuth2Manager:Revogar()
	self.AccessToken = nil
	self.RefreshToken = nil
	self.ExpiresEm = 0
	self.Estado = "Desconectado"
	return true
end

function OAuth2Manager:PodePublicar()
	if self.Estado ~= "Conectado" then return false, "Não conectado" end
	if self:PrecisaRefresh() then return false, "Token expirado, precisa refresh" end
	local temScope=false
	for _, scope in ipairs(self.ScopesConcedidos) do
		if scope == "universe.place:write" then temScope=true break end
	end
	if not temScope then return false, "Sem scope universe.place:write" end
	return true
end

function OAuth2Manager:Serializar()
	return {
		ClientId=self.ClientId,
		Estado=self.Estado,
		ExpiraEm=self.ExpiresEm,
		Scopes=self.ScopesConcedidos,
		UsuarioId=self.UsuarioId,
		TemAccess=self.AccessToken ~= nil,
		TemRefresh=self.RefreshToken ~= nil,
		PrecisaRefresh=self:PrecisaRefresh(),
	}
end

function OAuth2Manager.ListarScopes()
	return OAuth2Manager.Scopes
end

return OAuth2Manager
]]></ProtectedString></Properties></Item>
