     <Item class="ModuleScript" referent="RBX531932"><Properties><string name="Name">System1111_Physica</string><ProtectedString name="Source"><![CDATA[
local System1111_Physica = {}
function System1111_Physica.novo()
  return setmetatable({
    Id=1111,
    Familia="Physica",
    Nome="System1111_Physica",
    TopbarBotao=true,
    Menu=true,
    Submenu=true,
    Funcoes={"Novo","Abrir","Salvar","Editar","Deletar","Duplicar","Exportar","Importar","Configurar","Publicar"},
    Gradiente="Arkhe",
    Textura="Noise",
    Mobile=true,
    Console=true,
    VR=true,
    PC=true,
  }, {__index=System1111_Physica})
end
