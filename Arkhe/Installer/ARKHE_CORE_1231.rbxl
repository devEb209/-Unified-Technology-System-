     <Item class="ModuleScript" referent="RBX625518"><Properties><string name="Name">UndoRedo</string><ProtectedString name="Source"><![CDATA[--[[
	UndoRedo (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Kernel > UndoRedo
	============================================================
	F2 — UNDO/REDO UNIVERSAL (Ring1).

	Command pattern sobre o RRW: cada acao do dev vira um comando
	{ Fazer, Desfazer, Descricao }. Historico por jogador ou global.

	- Max 100 comandos
	- Agrupa por tempo (se acoes <0.5s, agrupa)
	- Serializavel (para replay/debug)
	- Integra com Modelador, Terrain, UI, EventScript

	Uso:
	  local UndoRedo = require(...)
	  UndoRedo.Registrar({ Fazer=function() mundo:Criar(...) end,
	                       Desfazer=function() mundo:Destruir(id) end,
	                       Descricao="Criar Carvalho" })
	  UndoRedo.Desfazer()
	  UndoRedo.Refazer()
	============================================================
]]

local UndoRedo = {}
UndoRedo.Historico = {} -- { {Fazer, Desfazer, Descricao, Quando, Jogador}, ... }
UndoRedo.Pos = 0 -- posicao atual no historico (0 = inicio, #Historico = fim)
UndoRedo.Max = 100
UndoRedo.AgruparJanela = 0.5 -- segundos para agrupar comandos do mesmo jogador

function UndoRedo.Registrar(comando)
	if type(comando) ~= "table" or type(comando.Fazer) ~= "function" or type(comando.Desfazer) ~= "function" then
		return false, "comando precisa Fazer e Desfazer"
	end
	comando.Quando = os.time()
	-- se estamos no meio do historico (apos undo), apaga futuro
	if UndoRedo.Pos < #UndoRedo.Historico then
		for i = #UndoRedo.Historico, UndoRedo.Pos+1, -1 do UndoRedo.Historico[i]=nil end
	end
	table.insert(UndoRedo.Historico, comando)
	UndoRedo.Pos = #UndoRedo.Historico
	-- executa
	local ok, err = pcall(comando.Fazer)
	if not ok then
		warn("[UndoRedo] Fazer falhou: " .. tostring(err))
		return false, err
	end
	-- limita
	if #UndoRedo.Historico > UndoRedo.Max then
		table.remove(UndoRedo.Historico, 1)
		UndoRedo.Pos = UndoRedo.Pos - 1
	end
	return true
end

function UndoRedo.Desfazer()
	if UndoRedo.Pos <= 0 then return false, "nada para desfazer" end
	local cmd = UndoRedo.Historico[UndoRedo.Pos]
	if cmd then
		local ok, err = pcall(cmd.Desfazer)
		if not ok then warn("[UndoRedo] Desfazer falhou: " .. tostring(err)) return false, err end
		UndoRedo.Pos = UndoRedo.Pos - 1
		return true, cmd.Descricao
	end
	return false
end

function UndoRedo.Refazer()
	if UndoRedo.Pos >= #UndoRedo.Historico then return false, "nada para refazer" end
	UndoRedo.Pos = UndoRedo.Pos + 1
	local cmd = UndoRedo.Historico[UndoRedo.Pos]
	if cmd then
		local ok, err = pcall(cmd.Fazer)
		if not ok then warn("[UndoRedo] Refazer falhou: " .. tostring(err)) return false, err end
		return true, cmd.Descricao
	end
	return false
end

function UndoRedo.Limpar()
	UndoRedo.Historico = {}
	UndoRedo.Pos = 0
end

function UndoRedo.Listar()
	local lista = {}
	for i, cmd in ipairs(UndoRedo.Historico) do
		table.insert(lista, {
			Indice = i,
			Descricao = cmd.Descricao or "Sem descricao",
			Quando = cmd.Quando,
			Atual = i == UndoRedo.Pos,
			PodeDesfazer = i <= UndoRedo.Pos,
		})
	end
	return lista
end

function UndoRedo.PodeDesfazer() return UndoRedo.Pos > 0 end
function UndoRedo.PodeRefazer() return UndoRedo.Pos < #UndoRedo.Historico end

return UndoRedo
]]></ProtectedString></Properties></Item>
