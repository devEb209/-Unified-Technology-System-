     <Item class="ModuleScript" referent="RBX706277"><Properties><string name="Name">SkillTree</string><ProtectedString name="Source"><![CDATA[--[[
	SkillTree (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Education > SkillTree
	============================================================
	F21 — ÁRVORE DE HABILIDADES (educação invisível)
	- Habilidades: { Id, Nome, Desc, Nivel, PreRequisitos, XP, Icon }
	- Árvore: grafo de habilidades com conexões
	- Progresso por userId: { Habilidades, XP, Nivel }
	- Desbloqueio: se tem pre-requisitos + XP suficiente
	- Recompensa: desbloqueia ferramentas, blocos, temas
	============================================================
]]

local SkillTree = {}
SkillTree.__index = SkillTree

SkillTree.HabilidadesPadrao = {
	{ Id="explorador", Nome="Explorador", Desc="Abriu o Explorer", Nivel=1, PreReq={}, XP=10, Icon="🧭", Recompensa={ Ferramenta="Explorer" } },
	{ Id="construtor", Nome="Construtor", Desc="Criou terreno", Nivel=1, PreReq={"explorador"}, XP=20, Icon="⛰️", Recompensa={ Ferramenta="Terrain" } },
	{ Id="povoador", Nome="Povoador", Desc="Spawnou NPC", Nivel=2, PreReq={"construtor"}, XP=30, Icon="👤", Recompensa={ Ferramenta="NPC" } },
	{ Id="programador", Nome="Programador", Desc="Criou folha EventScript", Nivel=2, PreReq={"explorador"}, XP=30, Icon="📜", Recompensa={ Bloco="CondicaoCustom" } },
	{ Id="modelador", Nome="Modelador", Desc="Criou modelo 3D", Nivel=3, PreReq={"construtor"}, XP=40, Icon="🧊", Recompensa={ Ferramenta="Modeler" } },
	{ Id="animador", Nome="Animador", Desc="Criou animação", Nivel=3, PreReq={"modelador"}, XP=40, Icon="🎬", Recompensa={ Ferramenta="Animator" } },
	{ Id="sonoro", Nome="Sonoro", Desc="Criou zona de áudio", Nivel=3, PreReq={"construtor"}, XP=30, Icon="🎵", Recompensa={ Ferramenta="Audio" } },
	{ Id="comerciante", Nome="Comerciante", Desc="Publicou no marketplace", Nivel=4, PreReq={"modelador","programador"}, XP=50, Icon="🛒", Recompensa={ Ferramenta="Marketplace" } },
	{ Id="publicador", Nome="Publicador", Desc="Publicou mundo", Nivel=4, PreReq={"construtor","programador"}, XP=60, Icon="📦", Recompensa={ Ferramenta="Publish" } },
	{ Id="mestre", Nome="Mestre Arkhe", Desc="Desbloqueou tudo", Nivel=5, PreReq={"publicador","comerciante","animador","sonoro","povoador"}, XP=100, Icon="👑", Recompensa={ Tema="ArkheDark" } },
}

function SkillTree.novo()
	local self = setmetatable({}, SkillTree)
	self.Habilidades = {}
	for _, hab in ipairs(SkillTree.HabilidadesPadrao) do
		self.Habilidades[hab.Id] = {
			Id=hab.Id,
			Nome=hab.Nome,
			Desc=hab.Desc,
			Nivel=hab.Nivel,
			PreReq=hab.PreReq,
			XP=hab.XP,
			Icon=hab.Icon,
			Recompensa=hab.Recompensa,
		}
	end
	self.Progresso = {} -- [userId] = { XP, Nivel, Desbloqueadas={}, Tempo }
	return self
end

function SkillTree:ObterProgresso(userId)
	if not self.Progresso[userId] then
		self.Progresso[userId] = { XP=0, Nivel=1, Desbloqueadas={}, Inicio=os.time() }
	end
	return self.Progresso[userId]
end

function SkillTree:AdicionarXP(userId, qtd, motivo)
	local prog = self:ObterProgresso(userId)
	prog.XP = prog.XP + qtd
	-- calcula nível: cada 100 XP = 1 nível
	prog.Nivel = math.floor(prog.XP / 100) + 1
	return prog.XP, prog.Nivel
end

function SkillTree:PodeDesbloquear(userId, habilidadeId)
	local hab = self.Habilidades[habilidadeId]
	if not hab then return false, "Habilidade não existe" end
	local prog = self:ObterProgresso(userId)
	if prog.Desbloqueadas[habilidadeId] then return false, "Já desbloqueada" end
	-- checa pre-requisitos
	for _, pre in ipairs(hab.PreReq) do
		if not prog.Desbloqueadas[pre] then
			return false, "Falta pre-requisito: "..pre
		end
	end
	if prog.XP < hab.XP then
		return false, "XP insuficiente: precisa "..hab.XP.." tem "..prog.XP
	end
	return true
end

function SkillTree:Desbloquear(userId, habilidadeId)
	local pode, err = self:PodeDesbloquear(userId, habilidadeId)
	if not pode then return false, err end
	local prog = self:ObterProgresso(userId)
	prog.Desbloqueadas[habilidadeId] = os.time()
	return true, self.Habilidades[habilidadeId].Recompensa
end

function SkillTree:DesbloquearPorCondicao(userId, condicao)
	-- condicao: string do evento (ex: CriarTerreno -> construtor)
	local mapaCondicao = {
		AbrirExplorer="explorador",
		CriarTerreno="construtor",
		CriarNPC="povoador",
		CriarFolha="programador",
		CriarModelo="modelador",
		CriarAnim="animador",
		CriarAudio="sonoro",
		PublicarMarketplace="comerciante",
		PublicarMundo="publicador",
	}
	local habId = mapaCondicao[condicao]
	if habId then
		return self:Desbloquear(userId, habId)
	end
	return false
end

function SkillTree:ListarHabilidades()
	local lista={}
	for _, hab in pairs(self.Habilidades) do table.insert(lista, hab) end
	table.sort(lista, function(a,b) return a.Nivel < b.Nivel end)
	return lista
end

function SkillTree:ListarDesbloqueadas(userId)
	local prog = self:ObterProgresso(userId)
	local lista={}
	for id, _ in pairs(prog.Desbloqueadas) do
		if self.Habilidades[id] then table.insert(lista, self.Habilidades[id]) end
	end
	return lista
end

function SkillTree:ProgressoPercentual(userId)
	local prog = self:ObterProgresso(userId)
	local total=0; for _ in pairs(self.Habilidades) do total=total+1 end
	local desbloq=0; for _ in pairs(prog.Desbloqueadas) do desbloq=desbloq+1 end
	return desbloq/total, desbloq, total, prog.XP, prog.Nivel
end

function SkillTree:Serializar(userId)
	if userId then
		local prog = self:ObterProgresso(userId)
		local perc, desbloq, total, xp, nivel = self:ProgressoPercentual(userId)
		return {
			XP=xp,
			Nivel=nivel,
			Desbloqueadas=desbloq,
			Total=total,
			Percentual=perc,
			Lista=self:ListarDesbloqueadas(userId),
		}
	else
		return {
			TotalHabilidades=(function() local c=0 for _ in pairs(self.Habilidades) do c=c+1 end return c end)(),
			Habilidades=self:ListarHabilidades(),
		}
	end
end

return SkillTree
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX344256"><Properties><string name="Name">SkillTreeVisual</string><ProtectedString name="Source"><![CDATA[--[[
  SkillTreeVisual (ModuleScript)
  Local: ReplicatedStorage > Arkhe > Education > SkillTreeVisual
  ============================================================================
  F21 — ÁRVORE HABILIDADES VISUAL (o que faltava pra 100%)
  - Renderiza SkillTree como grafo visual desenhável
  - Gera desenho de nós, conexões, progresso, bloqueios
  - Integra com SkillTree + WhyOverlay + CanvasVisual
  - Contrato: GerarDesenho, Avaliar, Exportar
  ============================================================================
]]

local SkillTreeVisual = {}
SkillTreeVisual.__index = SkillTreeVisual

function SkillTreeVisual.novo(skillTree)
    local self = setmetatable({}, SkillTreeVisual)
    self.SkillTree = skillTree
    self.Nos = {} -- { Id, X, Y, Desbloqueada, Nivel, Conexoes }
    self.Largura = 800
    self.Altura = 600
    self.Zoom = 1
    return self
end

function SkillTreeVisual:GerarLayout()
    if not self.SkillTree or not self.SkillTree.Habilidades then return {} end
    self.Nos = {}
    local habilidades = self.SkillTree.Habilidades
    local i=0
    for id, hab in pairs(habilidades) do
        i=i+1
        local x = (i % 5) * 150 + 50
        local y = math.floor(i / 5) * 120 + 50
        -- se habilidade tem posicao salva, usa
        if hab.X then x = hab.X end
        if hab.Y then y = hab.Y end
        table.insert(self.Nos, {
            Id=id,
            Nome=hab.Nome or id,
            X=x,
            Y=y,
            Desbloqueada=hab.Desbloqueada or false,
            Nivel=hab.Nivel or 0,
            PreReq=hab.PreReq or {},
            Conexoes=hab.PreReq or {},
            Recompensa=hab.Recompensa,
            XP=hab.XP or 0,
        })
    end
    -- ordena por Y
    table.sort(self.Nos, function(a,b) return a.Y < b.Y end)
    return self.Nos
end

function SkillTreeVisual:GerarDesenho()
    if #self.Nos == 0 then self:GerarLayout() end
    local linhas = {}
    table.insert(linhas, string.format("SkillTreeVisual %dx%d Zoom=%.1f Nos=%d", self.Largura, self.Altura, self.Zoom, #self.Nos))
    for _, no in ipairs(self.Nos) do
        local status = no.Desbloqueada and "[OK]" or "[LOCK]"
        table.insert(linhas, string.format("%s %s (%d,%d) Req:%s", status, no.Nome, no.X, no.Y, table.concat(no.PreReq, ",")))
    end
    -- conexões
    table.insert(linhas, "--- Conexoes ---")
    for _, no in ipairs(self.Nos) do
        for _, req in ipairs(no.PreReq) do
            table.insert(linhas, string.format("%s -> %s", req, no.Id))
        end
    end
    return table.concat(linhas, "\n")
end

function SkillTreeVisual:ObterNo(id)
    for _, no in ipairs(self.Nos) do if no.Id == id then return no end end
    return nil
end

function SkillTreeVisual:Progresso(userId)
    if not self.SkillTree or not self.SkillTree.ObterProgresso then return 0 end
    local ok, prog = pcall(function() return self.SkillTree:ObterProgresso(userId) end)
    if ok then return prog end
    -- fallback: conta desbloqueadas
    local total=0
    local desbloq=0
    for _, no in ipairs(self.Nos) do
        total=total+1
        if no.Desbloqueada then desbloq=desbloq+1 end
    end
    return total>0 and (desbloq/total) or 0
end

function SkillTreeVisual:ExportarParaCanvas(canvasVisual)
    if not canvasVisual or not canvasVisual.CarregarDeHeatmap then return false end
    local pontos = {}
    for _, no in ipairs(self.Nos) do
        table.insert(pontos, { X=no.X, Y=no.Y, Count=no.Desbloqueada and 10 or 1, Tipo=no.Desbloqueada and "desbloqueada" or "bloqueada" })
    end
    local ok = pcall(function() canvasVisual:CarregarDeHeatmap({ Pontos=pontos }) end)
    return ok
end

function SkillTreeVisual:Serializar()
    return {
        Largura=self.Largura,
        Altura=self.Altura,
        Zoom=self.Zoom,
        TotalNos=#self.Nos,
        Desbloqueadas=self:ContarDesbloqueadas(),
    }
end

function SkillTreeVisual:ContarDesbloqueadas()
    local n=0 for _, no in ipairs(self.Nos) do if no.Desbloqueada then n=n+1 end end return n
end

return SkillTreeVisual
]]></ProtectedString></Properties></Item>
