     <Item class="ModuleScript" referent="RBX730550"><Properties><string name="Name">Replicator</string><ProtectedString name="Source"><![CDATA[--[[
	Replicator (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Multiplayer > Replicator
	============================================================
	F16 — MULTIPLAYER RRW REPLICATION (Ring1, futuro Ring0).
	Replica estado RRW para clientes sem usar replicação nativa
	descontrolada. Fatiado por relevancia D-O15: so envia o que
	importa perto do jogador.

	- Server: coleta delta de entidades (pos, estado, evento) a cada 0.2s
	- Client: aplica delta em mundo local (espelho)
	- Relay opcional: conecta servidores via /multiplayer/sync para
	  mundos persistentes cross-server (ex: 100 players em shards)
	- Anti-cheat: valida acoes do cliente (inventario, dano) no server

	Contrato relay:
	  POST /multiplayer/sync { ServerId, EntidadesDelta, Eventos }
	  → { EntidadesDeOutrosServers, MensagensGlobais }
	============================================================
]]

local Replicator = {}
Replicator.TickRate = 0.2
Replicator.MaxEntidadesPorTick = 120
Replicator.Buffer = {} -- [id] = { Pos, Estado, UltimoEnvio }
Replicator.Clients = {} -- [userId] = { UltimoAck, Pos }

function Replicator.RegistrarCliente(userId, pos)
	Replicator.Clients[userId] = { UltimoAck = os.time(), Pos = pos or Vector3.new(0,0,0) }
end

function Replicator.RemoverCliente(userId)
	Replicator.Clients[userId] = nil
end

function Replicator.ColetarDelta(mundo, D15)
	-- D15 opcional: funcao que retorna relevancia por entidade
	local delta = {}
	local n = 0
	for id, e in pairs(mundo.Entidades) do
		if n >= Replicator.MaxEntidadesPorTick then break end
		local mudou = false
		local buf = Replicator.Buffer[id]
		if not buf then
			mudou = true
		else
			-- compara pos e chamas (exemplo simples)
			if buf.Pos then
				local dx = e.Pos.X - buf.Pos.X
				local dz = e.Pos.Z - buf.Pos.Z
				if dx*dx + dz*dz > 0.25 then mudou = true end
			else
				mudou = true
			end
			if (buf.Estado and buf.Estado.EmChamas) ~= e.Estado.EmChamas then mudou = true end
		end
		if mudou then
			table.insert(delta, {
				Id = id,
				Arquetipo = e.Arquetipo,
				Pos = { X=e.Pos.X, Y=e.Pos.Y, Z=e.Pos.Z },
				Estado = { EmChamas=e.Estado.EmChamas, Integridade=e.Estado.Integridade },
			})
			Replicator.Buffer[id] = { Pos = { X=e.Pos.X, Y=e.Pos.Y, Z=e.Pos.Z }, Estado = { EmChamas=e.Estado.EmChamas } }
			n = n + 1
		end
	end
	return delta
end

function Replicator.FiltrarPorRelevancia(delta, clientPos, raio)
	raio = raio or 300
	local filtrado = {}
	for _, d in ipairs(delta) do
		local dx = d.Pos.X - clientPos.X
		local dz = d.Pos.Z - clientPos.Z
		if dx*dx + dz*dz <= raio*raio then
			table.insert(filtrado, d)
		end
	end
	return filtrado
end

function Replicator.AplicarDeltaNoCliente(mundoLocal, delta)
	for _, d in ipairs(delta) do
		local e = mundoLocal.Entidades[d.Id]
		if e then
			e.Pos.X = d.Pos.X
			e.Pos.Y = d.Pos.Y
			e.Pos.Z = d.Pos.Z
			if d.Estado then
				for k,v in pairs(d.Estado) do e.Estado[k]=v end
			end
		else
			-- cria entidade fantasma local se nao existe (para preview)
			if d.Arquetipo then
				mundoLocal:Criar(d.Arquetipo, Vector3.new(d.Pos.X, d.Pos.Y, d.Pos.Z))
			end
		end
	end
end

function Replicator.LimparBuffer()
	Replicator.Buffer = {}
end

function Replicator.Stats()
	return {
		BufferSize = 0 + (function() local n=0 for _ in pairs(Replicator.Buffer) do n=n+1 end return n end)(),
		Clients = 0 + (function() local n=0 for _ in pairs(Replicator.Clients) do n=n+1 end return n end)(),
		TickRate = Replicator.TickRate,
		MaxPorTick = Replicator.MaxEntidadesPorTick,
	}
end

return Replicator
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX217283"><Properties><string name="Name">Rollback</string><ProtectedString name="Source"><![CDATA[[[
	Rollback (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Multiplayer > Rollback
	============================================================
	F16 — ROLLBACK NETCODE (GGPO-like simplificado)
	- Guarda snapshots do mundo a cada tick
	- Se input atrasado chega, volta no tempo e re-simula
	- Snapshots: { Tick, EstadoMundo, Inputs }
	- Inputs: por player { Tick, Input }
	- Re-simulação: aplica inputs em ordem e avança
	- Integra com ClientPrediction + Replicator
	============================================================
]]

local Rollback = {}
Rollback.__index = Rollback

function Rollback.novo(tamanhoHistorico)
	local self = setmetatable({}, Rollback)
	self.TamanhoHistorico = tamanhoHistorico or 60 -- 2s a 30Hz
	self.Snapshots = {} -- [tick] = { Estado, Inputs, Quando }
	self.TickAtual = 0
	self.InputsPendentes = {} -- [playerId] = { [tick]=input }
	self.NumRollbacks = 0
	self.TempoTotalResim = 0
	return self
end

function Rollback:SalvarSnapshot(estadoMundo)
	self.TickAtual = self.TickAtual + 1
	self.Snapshots[self.TickAtual] = {
		Tick=self.TickAtual,
		Estado=estadoMundo, -- tabela ou função de clone
		Inputs={},
		Quando=os.time(),
	}
	-- limita histórico
	local minTick = self.TickAtual - self.TamanhoHistorico
	for tick, _ in pairs(self.Snapshots) do
		if tick < minTick then self.Snapshots[tick]=nil end
	end
	return self.TickAtual
end

function Rollback:RegistrarInput(playerId, tick, input)
	self.InputsPendentes[playerId] = self.InputsPendentes[playerId] or {}
	self.InputsPendentes[playerId][tick] = input
	-- também guarda no snapshot se existir
	if self.Snapshots[tick] then
		self.Snapshots[tick].Inputs[playerId] = input
	end
	-- se input é de tick passado, precisa rollback
	if tick < self.TickAtual then
		return self:PrecisaRollback(tick)
	end
	return false
end

function Rollback:PrecisaRollback(tickInput)
	-- se tickInput < TickAtual e snapshot existe, precisa
	if tickInput < self.TickAtual and self.Snapshots[tickInput] then
		return true, self.TickAtual - tickInput
	end
	return false
end

function Rollback:FazerRollback(tickAlvo, funcaoSimular)
	-- funcaoSimular: function(estado, inputs, tick) -> novoEstado
	if not self.Snapshots[tickAlvo] then return false, "Sem snapshot para tick "..tickAlvo end
	local inicio = os.clock()
	local estado = self.Snapshots[tickAlvo].Estado
	-- re-simula do tickAlvo até atual
	for tick=tickAlvo+1, self.TickAtual do
		local inputsTick={}
		for playerId, inputs in pairs(self.InputsPendentes) do
			if inputs[tick] then inputsTick[playerId]=inputs[tick] end
		end
		if funcaoSimular then
			local ok, novoEstado = pcall(funcaoSimular, estado, inputsTick, tick)
			if ok and novoEstado then estado=novoEstado end
		end
		-- atualiza snapshot
		if self.Snapshots[tick] then
			self.Snapshots[tick].Estado = estado
		end
	end
	local tempo = os.clock() - inicio
	self.NumRollbacks = self.NumRollbacks + 1
	self.TempoTotalResim = self.TempoTotalResim + tempo
	return true, { TicksResimulados=self.TickAtual-tickAlvo, Tempo=tempo, Estado=estado }
end

function Rollback:ObterEstado(tick)
	tick = tick or self.TickAtual
	return self.Snapshots[tick] and self.Snapshots[tick].Estado or nil
end

function Rollback:Limpar()
	self.Snapshots={}
	self.InputsPendentes={}
	self.TickAtual=0
end

function Rollback:Stats()
	return {
		TickAtual=self.TickAtual,
		Snapshots=(function() local c=0 for _ in pairs(self.Snapshots) do c=c+1 end return c end)(),
		Rollbacks=self.NumRollbacks,
		TempoResim=self.TempoTotalResim,
		MediaResim=self.NumRollbacks>0 and self.TempoTotalResim/self.NumRollbacks or 0,
	}
end

function Rollback:Serializar()
	return self:Stats()
end

return Rollback
]]></ProtectedString></Properties></Item>
