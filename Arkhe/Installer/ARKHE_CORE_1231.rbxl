     <Item class="ModuleScript" referent="RBX68754"><Properties><string name="Name">HandTracking</string><ProtectedString name="Source"><![CDATA[[[
	HandTracking (ModuleScript)
	Local: ReplicatedStorage > Arkhe > VRConsole > HandTracking
	============================================================
	F22 — EDIÇÃO COM MÃOS (VR)
	- Mão: { Id, Pos, Rot, Gestos, Pinça, Apontando }
	- Gestos: Aberta, Fechada, Pinça, Apontar, Polegar
	- Ações: Agarrar entidade, Escalar (pinça 2 mãos), Pintar terreno
	- Raycast da mão + LaserPointer
	- Integra com VRConsole + Terrain + Modeler
	============================================================
]]

local HandTracking = {}
HandTracking.__index = HandTracking

HandTracking.Gestos = {
	Aberta = { Desc="Mão aberta, pronto para agarrar", Dedos={ Polegar=1, Indicador=1, Medio=1, Anelar=1, Mindinho=1 } },
	Fechada = { Desc="Mão fechada, agarrando", Dedos={ Polegar=0, Indicador=0, Medio=0, Anelar=0, Mindinho=0 } },
	Pinca = { Desc="Pinça polegar+indicador, preciso", Dedos={ Polegar=0.5, Indicador=0.5, Medio=1, Anelar=1, Mindinho=1 } },
	Apontar = { Desc="Apontando com indicador", Dedos={ Polegar=1, Indicador=0, Medio=1, Anelar=1, Mindinho=1 } },
	Polegar = { Desc="Polegar para cima, confirmar", Dedos={ Polegar=0, Indicador=1, Medio=1, Anelar=1, Mindinho=1 } },
}

function HandTracking.novo(id, lado)
	local self = setmetatable({}, HandTracking)
	self.Id = id or "mao_"..math.random(1000,9999)
	self.Lado = lado or "Direita" -- Esquerda/Direita
	self.Pos = Vector3.new(0,0,0)
	self.Rot = CFrame.new()
	self.Gesto = "Aberta"
	self.PincaForca = 0 -- 0..1
	self.Apontando = false
	self.EntidadeAgarrada = nil
	self.UltimoGesto = "Aberta"
	self.Historico = {} -- { Quando, Gesto, Pos }
	return self
end

function HandTracking:Atualizar(pos, rot, gesto, pincaForca)
	self.Pos = pos or self.Pos
	self.Rot = rot or self.Rot
	if gesto and HandTracking.Gestos[gesto] then
		self.UltimoGesto = self.Gesto
		self.Gesto = gesto
	end
	if pincaForca then self.PincaForca = math.clamp(pincaForca,0,1) end
	self.Apontando = (self.Gesto == "Apontar" or self.Gesto == "Pinca")

	table.insert(self.Historico, { Quando=os.time(), Gesto=self.Gesto, Pos=self.Pos })
	if #self.Historico > 20 then table.remove(self.Historico,1) end
	return self.Gesto
end

function HandTracking:DetectarGestoAutomatico(distanciasDedos)
	-- distanciasDedos: { Polegar, Indicador, Medio, Anelar, Mindinho } 0 fechado 1 aberto
	if not distanciasDedos then return self.Gesto end
	local media = 0
	for _, v in pairs(distanciasDedos) do media=media+v end
	media = media / 5
	if media > 0.8 then return "Aberta"
	elseif media < 0.2 then return "Fechada"
	elseif distanciasDedos.Polegar < 0.5 and distanciasDedos.Indicador < 0.5 and distanciasDedos.Medio > 0.7 then return "Pinca"
	elseif distanciasDedos.Indicador < 0.3 and distanciasDedos.Medio > 0.7 then return "Apontar"
	elseif distanciasDedos.Polegar < 0.3 then return "Polegar"
	end
	return self.Gesto
end

function HandTracking:Agarrar(entidadeId)
	if self.Gesto == "Fechada" and not self.EntidadeAgarrada then
		self.EntidadeAgarrada = entidadeId
		return true
	end
	return false
end

function HandTracking:Soltar()
	if self.EntidadeAgarrada then
		local id = self.EntidadeAgarrada
		self.EntidadeAgarrada = nil
		return id
	end
	return nil
end

function HandTracking:CalcularEscala(outraMao)
	-- escala por distância entre duas mãos em pinça
	if not outraMao then return 1 end
	if self.Gesto ~= "Pinca" or outraMao.Gesto ~= "Pinca" then return 1 end
	local dist = (self.Pos - outraMao.Pos).Magnitude
	-- normaliza por distância inicial 0.3m
	return math.clamp(dist / 0.3, 0.2, 5.0)
end

function HandTracking:RaycastMao(world, alcance)
	alcance = alcance or 100
	local dir = self.Rot.LookVector
	-- simula raycast
	return {
		Origem=self.Pos,
		Direcao=dir,
		Alcance=alcance,
		Gesto=self.Gesto,
	}
end

function HandTracking:Serializar()
	return {
		Id=self.Id,
		Lado=self.Lado,
		Pos={ X=self.Pos.X, Y=self.Pos.Y, Z=self.Pos.Z },
		Gesto=self.Gesto,
		Pinca=self.PincaForca,
		Agarrada=self.EntidadeAgarrada,
	}
end

function HandTracking.ListarGestos()
	local lista={}
	for nome, info in pairs(HandTracking.Gestos) do
		table.insert(lista, { Nome=nome, Desc=info.Desc })
	end
	return lista
end

return HandTracking
]]></ProtectedString></Properties></Item>
