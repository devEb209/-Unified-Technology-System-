     <Item class="ModuleScript" referent="RBX647365"><Properties><string name="Name">ToolboxCustom</string><ProtectedString name="Source"><![CDATA[
local ToolboxCustom = {}
function ToolboxCustom.novo()
  return setmetatable({
    Categorias={
      {Nome="Modelos", Icone="📦", Itens={"Casa","Arvore","Carro","NPC","Arma"}},
      {Nome="Imagens", Icone="🖼️", Itens={"Logo Arkhe","Gradiente","Noise","Grid"}},
      {Nome="Sons", Icone="🔊", Itens={"Explosao","Passos","Musica","Vento"}},
      {Nome="Plugins", Icone="🔌", Itens={"Arkhe Terrain","Arkhe Modeler","Arkhe Animator"}},
      {Nome="Arkhe", Icone="🔮", Itens={"Bioma Floresta","Bioma Deserto","Entidade Carvalho","Entidade Rocha","Veiculo","Tocha"}},
      {Nome="Meus Modelos", Icone="👤", Itens={}},
    },
    Busca="",
    Historico={},
  }, {__index=ToolboxCustom})
end
function ToolboxCustom:Buscar(texto)
  self.Busca=texto
  local res={}
  for _, cat in ipairs(self.Categorias) do
    for _, item in ipairs(cat.Itens) do
      if string.find(string.lower(item), string.lower(texto)) then table.insert(res, {Categoria=cat.Nome, Item=item}) end
    end
  end
  return res
end
function ToolboxCustom:AdicionarAosMeus(item) table.insert(self.Categorias[6].Itens, item) end
function ToolboxCustom:ListarCategorias() return self.Categorias end
function ToolboxCustom:ContarFuncoes()
  local total=0
  for _, cat in ipairs(self.Categorias) do total=total+#cat.Itens end
  return total + #self.Categorias
end
function ToolboxCustom:Serializar() return {TotalCategorias=#self.Categorias, TotalItens=self:ContarFuncoes()} end
return ToolboxCustom
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX300791"><Properties><string name="Name">Topbar</string><ProtectedString name="Source"><![CDATA[
local Topbar = {}
function Topbar.novo()
  return setmetatable({
    Botoes={},
    Altura=36,
    CorFundo={R=30,G=30,B=45},
    Gradiente={Inicio={R=74,G=0,B=224}, Fim={R=0,G=229,B=255}},
    Textura="noise",
    Logo="rbxassetid://ARKHE_LOGO"
  }, {__index=Topbar})
end
function Topbar:AdicionarBotao(id, texto, icone, callback, submenu)
  table.insert(self.Botoes, {Id=id, Texto=texto, Icone=icone, Callback=callback, Submenu=submenu or {}, Ordem=#self.Botoes+1})
end
function Topbar:ListarBotoes() return self.Botoes end
function Topbar:GerarDesenho()
  local linhas={"Topbar ARKHE Gradient Purple->Cyan Textura Noise"}
  for _, b in ipairs(self.Botoes) do table.insert(linhas, b.Texto.." ["..#b.Submenu.." submenus]") end
  return table.concat(linhas, "\n")
end
function Topbar:Serializar() return {Altura=self.Altura, TotalBotoes=#self.Botoes, Gradiente=self.Gradiente, Textura=self.Textura} end
return Topbar
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX379878"><Properties><string name="Name">TopbarPlus</string><ProtectedString name="Source"><![CDATA[
local TopbarPlus = {}
function TopbarPlus.novo()
  return setmetatable({
    Botoes={},
    Gradiente={Inicio={R=74,G=0,B=224}, Fim={R=0,G=229,B=255}},
    Textura="Noise",
    Logo="rbxassetid://ARKHE_LOGO_1K",
    Altura=40,
    Animacao=true,
  }, {__index=TopbarPlus})
end
function TopbarPlus:AdicionarBotao(id, texto, icone, submenu, callback)
  table.insert(self.Botoes, {Id=id, Texto=texto, Icone=icone, Submenu=submenu or {}, Callback=callback, Ordem=#self.Botoes+1})
end
function TopbarPlus:AdicionarSubmenu(botaoId, submenuNome, itens)
  for _, b in ipairs(self.Botoes) do
    if b.Id==botaoId then
      table.insert(b.Submenu, {Nome=submenuNome, Itens=itens})
    end
  end
end
function TopbarPlus:ContarFuncoes()
  local total=0
  for _, b in ipairs(self.Botoes) do total=total+1+#b.Submenu end
  return total
end
function TopbarPlus:Serializar() return {TotalBotoes=#self.Botoes, TotalFuncoes=self:ContarFuncoes(), Gradiente=self.Gradiente, Textura=self.Textura} end
return TopbarPlus
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX252581"><Properties><string name="Name">TreeView</string><ProtectedString name="Source"><![CDATA[local TreeView={} function TreeView.novo() return setmetatable({Nos={}, Expandido=true}, {__index=TreeView}) end function TreeView:AddNo(n) table.insert(self.Nos,n) end function TreeView:Serializar() return {Total=#self.Nos} end return TreeView]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX398284"><Properties><string name="Name">UIKit</string><ProtectedString name="Source"><![CDATA[--[[
	UIKit (ModuleScript)
	Local: ReplicatedStorage > Arkhe > UI > UIKit
	============================================================
	F10 — O UI BUILDER DA ARKHE (runtime).
	Telas de interface como DADOS PUROS (JSON): o dev monta no
	painel, salva, publica no marketplace — e o UIKit constroi
	a interface REAL em qualquer plataforma.

	POR QUE MELHOR QUE FAZER NA MAO:
	- Coordenadas em PORCENTAGEM (0..100): a MESMA tela reflui
	  em PC, celular, tablet, console e (futuro) VR
	- Modo Console: safe-area automatica + fontes maiores
	- Modo Celular: alvos de toque maiores automaticos
	- Botao da tela dispara EVENTO no EventScript do servidor
	  (UI -> folhas QUANDO/FACA, sem uma linha de codigo!)

	Componentes: Painel, Texto, Botao, Barra, Campo, Imagem
	Formato: { Nome, Comps = { { Nome, Tipo, X,Y,W,H (0..100),
	  Cor, Texto, Valor, Cantos, Transparencia }, ... } }
	============================================================
]]

local UIKit = {}

UIKit.Paleta = {
	Indigo = Color3.fromRGB(88, 96, 200),
	Ouro = Color3.fromRGB(214, 178, 84),
	Verde = Color3.fromRGB(90, 180, 100),
	Vermelho = Color3.fromRGB(200, 82, 82),
	Escuro = Color3.fromRGB(26, 28, 38),
	Claro = Color3.fromRGB(235, 235, 242),
	Azul = Color3.fromRGB(74, 140, 210),
	Roxo = Color3.fromRGB(140, 90, 190),
}

UIKit.Tipos = { "Painel", "Texto", "Botao", "Barra", "Campo", "Imagem", "Lista", "Scroll", "Grade" }

local function cor(nome)
	return UIKit.Paleta[nome] or UIKit.Paleta.Escuro
end

local function aplicarBase(inst, comp, modo)
	inst.Name = comp.Nome or "Comp"
	inst.Position = UDim2.new((comp.X or 10) / 100, 0, (comp.Y or 10) / 100, 0)
	inst.Size = UDim2.new((comp.W or 20) / 100, 0, (comp.H or 8) / 100, 0)
	inst.BackgroundColor3 = cor(comp.Cor)
	inst.BackgroundTransparency = comp.Transparencia or 0
	inst.BorderSizePixel = 0
	if comp.Cantos and comp.Cantos > 0 then
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, comp.Cantos)
		c.Parent = inst
	end
	-- celular: alvo de toque minimo (acessibilidade real)
	if modo == "Celular" and (inst:IsA("TextButton") or inst:IsA("TextBox")) then
		local minY = 0.055
		if inst.Size.Y.Scale < minY then
			inst.Size = UDim2.new(inst.Size.X.Scale, 0, minY, 0)
		end
	end
end

local function aplicarTexto(lbl, comp, modo)
	lbl.Text = comp.Texto or ""
	lbl.TextColor3 = comp.Cor == "Escuro" and UIKit.Paleta.Claro
		or (comp.CorTexto and cor(comp.CorTexto) or UIKit.Paleta.Claro)
	lbl.Font = Enum.Font.GothamBold
	lbl.TextScaled = true
	local tam = Instance.new("UITextSizeConstraint")
	tam.MaxTextSize = (modo == "Console" and 34) or (modo == "Celular" and 22) or 26
	tam.MinTextSize = 8
	tam.Parent = lbl
end

-- ============ CONSTRUTOR ============
-- def: a tela em dados | pai: onde montar | modo: "PC"|"Celular"|"Console"
-- aoClicar(comp): callback de botoes (a Genesis liga no EventScript)
function UIKit.Construir(def, pai, modo, aoClicar)
	modo = modo or "PC"
	local raiz = Instance.new("Frame")
	raiz.Name = "ArkheTela_" .. (def.Nome or "Tela")
	raiz.BackgroundTransparency = 1
	raiz.Size = UDim2.new(1, 0, 1, 0)

	-- console/TV: safe-area de 4% (overscan real de TVs)
	local area = raiz
	if modo == "Console" then
		area = Instance.new("Frame")
		area.Name = "SafeArea"
		area.BackgroundTransparency = 1
		area.Position = UDim2.new(0.04, 0, 0.04, 0)
		area.Size = UDim2.new(0.92, 0, 0.92, 0)
		area.Parent = raiz
	end

	for _, comp in ipairs(def.Comps or {}) do
		local tipo = comp.Tipo or "Painel"
		if tipo == "Painel" then
			local f = Instance.new("Frame")
			aplicarBase(f, comp, modo)
			f.Parent = area
		elseif tipo == "Texto" then
			local l = Instance.new("TextLabel")
			aplicarBase(l, comp, modo)
			l.BackgroundTransparency = comp.Transparencia or 1
			aplicarTexto(l, comp, modo)
			l.Parent = area
		elseif tipo == "Botao" then
			local b = Instance.new("TextButton")
			aplicarBase(b, comp, modo)
			aplicarTexto(b, comp, modo)
			b.AutoButtonColor = true
			if aoClicar then
				b.MouseButton1Click:Connect(function()
					aoClicar(comp)
				end)
			end
			b.Parent = area
		elseif tipo == "Barra" then
			local fundo = Instance.new("Frame")
			aplicarBase(fundo, comp, modo)
			fundo.BackgroundColor3 = UIKit.Paleta.Escuro
			local frente = Instance.new("Frame")
			frente.Name = "Preenchimento"
			frente.BorderSizePixel = 0
			frente.BackgroundColor3 = cor(comp.Cor)
			frente.Size = UDim2.new(math.clamp(comp.Valor or 0.75, 0, 1), 0, 1, 0)
			frente.Parent = fundo
			if comp.Texto and comp.Texto ~= "" then
				local l = Instance.new("TextLabel")
				l.BackgroundTransparency = 1
				l.Size = UDim2.new(1, 0, 1, 0)
				aplicarTexto(l, comp, modo)
				l.Parent = fundo
			end
			fundo.Parent = area
		elseif tipo == "Campo" then
			local t = Instance.new("TextBox")
			aplicarBase(t, comp, modo)
			t.PlaceholderText = comp.Texto or "..."
			t.Text = ""
			t.TextColor3 = UIKit.Paleta.Claro
			t.Font = Enum.Font.Gotham
			t.TextScaled = true
			t.ClearTextOnFocus = false
			t.Parent = area
		elseif tipo == "Imagem" then
			local img = Instance.new("ImageLabel")
			aplicarBase(img, comp, modo)
			img.Image = comp.Imagem and ("rbxassetid://" .. tostring(comp.Imagem)) or ""
			img.ScaleType = Enum.ScaleType.Fit
			img.Parent = area
		elseif tipo == "Lista" then
			local scroll = Instance.new("ScrollingFrame")
			aplicarBase(scroll, comp, modo)
			scroll.BackgroundColor3 = cor(comp.Cor)
			scroll.ScrollBarThickness = 6
			scroll.CanvasSize = UDim2.new(0,0,0,0)
			scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
			local layout = Instance.new("UIListLayout")
			layout.SortOrder = Enum.SortOrder.LayoutOrder
			layout.Padding = UDim.new(0, 4)
			layout.Parent = scroll
			for i, txt in ipairs(comp.Itens or {}) do
				local b = Instance.new("TextButton")
				b.Name = "Item_"..i
				b.Size = UDim2.new(1, -8, 0, 32)
				b.BackgroundColor3 = UIKit.Paleta.Claro
				b.Text = tostring(txt)
				b.TextColor3 = UIKit.Paleta.Escuro
				b.Font = Enum.Font.Gotham
				b.TextScaled = true
				b.Parent = scroll
				if aoClicar then
					b.MouseButton1Click:Connect(function()
						aoClicar({ Nome=comp.Nome..":"..txt, Tipo="Botao" })
					end)
				end
			end
			scroll.Parent = area
		elseif tipo == "Scroll" then
			local scroll = Instance.new("ScrollingFrame")
			aplicarBase(scroll, comp, modo)
			scroll.ScrollBarThickness = 8
			scroll.CanvasSize = UDim2.new(0,0,1,0)
			scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
			scroll.Parent = area
		elseif tipo == "Grade" then
			local grid = Instance.new("Frame")
			aplicarBase(grid, comp, modo)
			grid.BackgroundTransparency = 1
			local layout = Instance.new("UIGridLayout")
			layout.CellSize = UDim2.new(0, 80, 0, 80)
			layout.CellPadding = UDim2.new(0, 6, 0, 6)
			layout.Parent = grid
			for i, txt in ipairs(comp.Itens or {}) do
				local b = Instance.new("TextButton")
				b.Size = UDim2.new(0, 80, 0, 80)
				b.Text = tostring(txt)
				b.BackgroundColor3 = cor(comp.Cor)
				b.Parent = grid
				if aoClicar then
					b.MouseButton1Click:Connect(function()
						aoClicar({ Nome=comp.Nome..":"..txt, Tipo="Botao" })
					end)
				end
			end
			grid.Parent = area
		end
	end
	if pai then raiz.Parent = pai end
	return raiz
end

UIKit.Temas = {
	Escuro = { Fundo="Escuro", Texto="Claro", Destaque="Indigo" },
	Claro = { Fundo="Claro", Texto="Escuro", Destaque="Azul" },
	AltoContraste = { Fundo="Escuro", Texto="Ouro", Destaque="Verde" },
}

function UIKit.AplicarTema(raiz, temaNome)
	local tema = UIKit.Temas[temaNome]
	if not tema then return false end
	return true
end

-- Atualiza uma barra ja construida (ex: vida do jogador em runtime)
function UIKit.DefinirBarra(raiz, nomeComp, valor)
	local area = raiz:FindFirstChild("SafeArea") or raiz
	local fundo = area:FindFirstChild(nomeComp)
	local frente = fundo and fundo:FindFirstChild("Preenchimento")
	if frente then
		frente.Size = UDim2.new(math.clamp(valor, 0, 1), 0, 1, 0)
	end
end

-- Detecta o modo certo pro jogador atual (o UIKit escolhe sozinho)
function UIKit.ModoLocal()
	local UIS = game:GetService("UserInputService")
	local GuiService = game:GetService("GuiService")
	if GuiService:IsTenFootInterface() then return "Console" end
	if UIS.TouchEnabled and not UIS.KeyboardEnabled then return "Celular" end
	return "PC"
end

return UIKit
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX613691"><Properties><string name="Name">UltraSystem1501_UI</string><ProtectedString name="Source"><![CDATA[
local UltraSystem1501_UI = {}
function UltraSystem1501_UI.novo()
  return setmetatable({
    Id=1501,
    Familia="UI",
    Nome="UltraSystem1501_UI",
    Topbar=true,
    Menu=true,
    Submenu=true,
    Submenus={"Novo","Abrir","Salvar","Salvar Como","Publicar","Exportar","Importar","Configurar","Colaborar","Chat","Marcar Local","Criar Place"},
    Gradiente="Arkhe",
    Textura="Noise",
    Mobile=true,
    Console=true,
    VR=true,
    PC=true,
    Colaboracao=true,
    Chat=true,
    Marcacao=true,
    PlaceDireto=true,
