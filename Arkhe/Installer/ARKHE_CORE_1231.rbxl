     <Item class="ModuleScript" referent="RBX893812"><Properties><string name="Name">MarketplaceCustom</string><ProtectedString name="Source"><![CDATA[
local MarketplaceCustom = {}
function MarketplaceCustom.novo()
  return setmetatable({
    Itens={},
    Categorias={"Modelos","Scripts","UI","Audio","Terreno","NPC","Completo"},
    Filtros={"Mais Recentes","Mais Baixados","Gratis","Pagos","Arkhe Oficial"},
    Carrinho={},
  }, {__index=MarketplaceCustom})
end
function MarketplaceCustom:Publicar(item)
  item.Id="arkhe_"..os.time()..math.random(1000,9999)
  item.PublicadoEm=os.time()
  table.insert(self.Itens, item)
  return item
end
function MarketplaceCustom:Buscar(filtro, categoria)
  local res={}
  for _, it in ipairs(self.Itens) do
    if (not categoria or it.Categoria==categoria) then table.insert(res,it) end
  end
  return res
end
function MarketplaceCustom:AdicionarAoCarrinho(itemId)
  table.insert(self.Carrinho, itemId)
end
function MarketplaceCustom:Serializar() return {TotalItens=#self.Itens, Categorias=self.Categorias, Carrinho=#self.Carrinho} end
return MarketplaceCustom
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX768557"><Properties><string name="Name">MarketplaceService</string><ProtectedString name="Source"><![CDATA[--[[
	MarketplaceService (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Marketplace > MarketplaceService
	============================================================
	F14 — MARKETPLACE ARKHE GLOBAL (Ring1, futuro Ring0).
	Expande o catalogo local com busca, avaliacao, moderacao,
	categorias, perfis de criador, receita.

	- Catalogo local (semente) + itens do relay (global)
	- Busca por nome/autor/categoria
	- Avaliacao 1-5 estrelas + comentarios
	- Moderacao: fila de analise (IA + curadoria)
	- Compra simulada local (sem Robux real — economia propria)
	- Publicacao com preco gratis/pago

	Contrato relay:
	  POST /marketplace/listar { Filtro, Aba, Sub }
	  → { Itens=[{Id,Nome,Autor,Preco,Gratis,Aba,Sub,Estrelas,Avaliacoes,Arquetipo?,Folha?,ModeloBlob?}] }
	  POST /marketplace/publicar { Nome, Preco, Autor, Tipo, Blob }
	  → { Sucesso, Id?, Erro? }
	  POST /marketplace/avaliar { Id, Estrelas, Comentario, Autor }
	  POST /marketplace/comprar { Id, Comprador }

	Sem relay: funciona 100% local (catálogo semente + itens publicados localmente).
	============================================================
]]

local MarketplaceService = {}
MarketplaceService.__index = MarketplaceService

function MarketplaceService.novo(catalogoInicial)
	local self = setmetatable({}, MarketplaceService)
	self.Catalogo = catalogoInicial or {}
	self.Avaliacoes = {} -- [id] = { {Estrelas, Comentario, Autor, Quando}, ... }
	self.FilaModeracao = {} -- itens aguardando aprovacao
	self.Compras = {} -- [userId] = { id, ... }
	return self
end

function MarketplaceService:Adicionar(item)
	item.Id = item.Id or ("AK" .. tostring(100 + #self.Catalogo + math.random(1,900)))
	item.CriadoEm = os.time()
	item.Estrelas = item.Estrelas or 5
	item.Avaliacoes = item.Avaliacoes or 0
	table.insert(self.Catalogo, item)
	return item
end

function MarketplaceService:Buscar(filtro, aba, sub)
	filtro = filtro and filtro:lower() or ""
	aba = aba or "Todos"
	sub = sub or "Todos"
	local resultado = {}
	for _, item in ipairs(self.Catalogo) do
		local abaOk = (aba == "Todos") or (item.Aba == aba) or (aba == "Meus")
		local subOk = (sub == "Todos") or (item.Sub == sub)
		local filtroOk = filtro == "" or item.Nome:lower():find(filtro,1,true) or (item.Autor and item.Autor:lower():find(filtro,1,true))
		if abaOk and subOk and filtroOk then
			table.insert(resultado, item)
		end
	end
	-- ordena por estrelas desc, depois nome
	table.sort(resultado, function(a,b)
		if a.Estrelas ~= b.Estrelas then return a.Estrelas > b.Estrelas end
		return a.Nome < b.Nome
	end)
	return resultado
end

function MarketplaceService:Avaliar(id, estrelas, comentario, autor)
	estrelas = math.clamp(estrelas or 5, 1, 5)
	self.Avaliacoes[id] = self.Avaliacoes[id] or {}
	table.insert(self.Avaliacoes[id], {
		Estrelas = estrelas,
		Comentario = comentario or "",
		Autor = autor or "Anon",
		Quando = os.time(),
	})
	-- recalcula media
	for _, item in ipairs(self.Catalogo) do
		if item.Id == id then
			local soma, n = 0, 0
			for _, av in ipairs(self.Avaliacoes[id]) do soma = soma + av.Estrelas; n = n + 1 end
			item.Estrelas = n > 0 and (soma / n) or item.Estrelas
			item.Avaliacoes = n
			break
		end
	end
	return true
end

function MarketplaceService:Comprar(userId, id)
	self.Compras[userId] = self.Compras[userId] or {}
	for _, comprado in ipairs(self.Compras[userId]) do if comprado == id then return false, "ja_comprado" end end
	table.insert(self.Compras[userId], id)
	return true
end

function MarketplaceService:JaComprou(userId, id)
	local lista = self.Compras[userId]
	if not lista then return false end
	for _, v in ipairs(lista) do if v == id then return true end end
	return false
end

function MarketplaceService:ParaModeracao(item)
	item.Status = "EmAnalise"
	table.insert(self.FilaModeracao, item)
	return true
end

function MarketplaceService:Aprovar(id)
	for i, item in ipairs(self.FilaModeracao) do
		if item.Id == id then
			item.Status = "Aprovado"
			table.insert(self.Catalogo, item)
			table.remove(self.FilaModeracao, i)
			return true
		end
	end
	return false
end

function MarketplaceService:Rejeitar(id, motivo)
	for i, item in ipairs(self.FilaModeracao) do
		if item.Id == id then
			item.Status = "Rejeitado"
			item.MotivoRejeicao = motivo
			table.remove(self.FilaModeracao, i)
			return true
		end
	end
	return false
end

function MarketplaceService:ListarAbas()
	return { "Todos", "Modelos", "Plugins", "Folhas", "Mundos", "Meus" }
end

function MarketplaceService:ListarSubs()
	return { "Todos", "Natureza", "Estruturas", "Fantasia", "Tech", "Audio", "UI", "Animacoes" }
end

function MarketplaceService:TopCriadores()
	local porAutor = {}
	for _, item in ipairs(self.Catalogo) do
		local autor = item.Autor or "Arkhe"
		porAutor[autor] = porAutor[autor] or { Autor=autor, Total=0, EstrelasSoma=0, Itens={} }
		porAutor[autor].Total = porAutor[autor].Total + 1
		porAutor[autor].EstrelasSoma = porAutor[autor].EstrelasSoma + (item.Estrelas or 5)
		table.insert(porAutor[autor].Itens, item.Nome)
	end
	local lista = {}
	for _, v in pairs(porAutor) do
		v.Media = v.Total > 0 and (v.EstrelasSoma / v.Total) or 0
		table.insert(lista, v)
	end
	table.sort(lista, function(a,b) return a.Total > b.Total end)
	return lista
end

return MarketplaceService
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX658090"><Properties><string name="Name">ModerationAI</string><ProtectedString name="Source"><![CDATA[[[
	ModerationAI (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Marketplace > ModerationAI
	============================================================
	F14 — MODERAÇÃO IA DO MARKETPLACE
	- Analisa asset antes de publicar: nome, descrição, tags
	- Checa: palavrões, conteúdo impróprio, spam, duplicata
	- Score 0-100: <30 rejeita, 30-70 revisão humana, >70 aprova
	- Fila: pendentes, aprovados, rejeitados
	- Integra com relay POST /marketplace/moderate
	============================================================
]]

local ModerationAI = {}
ModerationAI.__index = ModerationAI

ModerationAI.PalavrasBloqueadas = { "xxx","nsfw","hack","exploit","scam" } -- exemplo curto

function ModerationAI.novo()
	local self = setmetatable({}, ModerationAI)
	self.Fila = {} -- pendentes { Id, Nome, Autor, Desc, Score, Status, Motivo }
	self.Aprovados = {}
	self.Rejeitados = {}
	self.TotalAnalisados = 0
	return self
end

function ModerationAI:AnalisarTexto(texto)
	texto = string.lower(texto or "")
	local score = 100
	local motivos = {}

	-- checa palavras bloqueadas
	for _, palavra in ipairs(ModerationAI.PalavrasBloqueadas) do
		if string.find(texto, palavra) then
			score = score - 40
			table.insert(motivos, "Contém '"..palavra.."'")
		end
	end
	-- checa tamanho
	if #texto < 3 then
		score = score - 20
		table.insert(motivos, "Nome muito curto")
	end
	if #texto > 100 then
		score = score - 10
		table.insert(motivos, "Nome muito longo")
	end
	-- checa spam (repetição)
	if string.find(texto, "(.)%1%1%1") then
		score = score - 15
		table.insert(motivos, "Possível spam (caracteres repetidos)")
	end

	score = math.clamp(score, 0, 100)
	return score, motivos
end

function ModerationAI:AnalisarAsset(asset)
	-- asset: { Id, Nome, Desc, Autor, Tags, Tipo }
	local scoreNome, motivosNome = self:AnalisarTexto(asset.Nome or "")
	local scoreDesc, motivosDesc = self:AnalisarTexto(asset.Desc or "")
	local score = (scoreNome*0.6 + scoreDesc*0.4)

	local todosMotivos={}
	for _, m in ipairs(motivosNome) do table.insert(todosMotivos, m) end
	for _, m in ipairs(motivosDesc) do table.insert(todosMotivos, m) end

	-- duplicata: verifica nome igual em aprovados
	for _, ap in ipairs(self.Aprovados) do
		if ap.Nome == asset.Nome and ap.Autor == asset.Autor then
			score = score - 20
			table.insert(todosMotivos, "Possível duplicata")
			break
		end
	end

	local status="Pendente"
	if score < 30 then status="Rejeitado"
	elseif score >= 70 then status="Aprovado"
	else status="Revisao"
	end

	local entry = {
		Id=asset.Id or "asset_"..math.random(1000,9999),
		Nome=asset.Nome,
		Autor=asset.Autor,
		Desc=asset.Desc,
		Score=math.floor(score),
		Status=status,
		Motivos=todosMotivos,
		Quando=os.time(),
		Tipo=asset.Tipo or "Modelo",
	}

	if status=="Aprovado" then
		table.insert(self.Aprovados, entry)
	elseif status=="Rejeitado" then
		table.insert(self.Rejeitados, entry)
	else
		table.insert(self.Fila, entry)
	end
	self.TotalAnalisados = self.TotalAnalisados + 1

	return entry
end

function ModerationAI:Aprovar(id)
	for i, entry in ipairs(self.Fila) do
		if entry.Id == id then
			entry.Status="Aprovado"
			table.insert(self.Aprovados, entry)
			table.remove(self.Fila,i)
			return true
		end
	end
	return false
end

function ModerationAI:Rejeitar(id, motivo)
	for i, entry in ipairs(self.Fila) do
		if entry.Id == id then
			entry.Status="Rejeitado"
			entry.MotivoRejeicao=motivo or "Rejeitado manualmente"
			table.insert(self.Rejeitados, entry)
			table.remove(self.Fila,i)
			return true
		end
	end
	return false
end

function ModerationAI:ListarFila()
	return self.Fila
end

function ModerationAI:Stats()
	return {
		Pendentes=#self.Fila,
		Aprovados=#self.Aprovados,
		Rejeitados=#self.Rejeitados,
		Total=self.TotalAnalisados,
	}
end

function ModerationAI:Serializar()
	return {
		Stats=self:Stats(),
		Fila=self.Fila,
	}
end

return ModerationAI
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX39521"><Properties><string name="Name">Payout</string><ProtectedString name="Source"><![CDATA[--[[
  Payout (ModuleScript)
  Local: ReplicatedStorage > Arkhe > Marketplace > Payout
  ============================================================================
  F14 — SAQUE RECEITA (o que faltava pra 100%)
  - Calcula receita de vendas (Marketplace + Gamepasses)
  - Fila de saques, taxa Arkhe 10%, repasse dev 90%
  - Integra com Revenue + Bank
  - Contrato: RegistrarVenda, Calcular, Sacar, Payload relay Open Cloud
  ============================================================================
]]

local Payout = {}
Payout.__index = Payout

function Payout.novo(devId)
    local self = setmetatable({}, Payout)
    self.DevId = devId or "dev"
    self.Vendas = {} -- { Id, ItemId, Valor, Tempo, Pago }
    self.Saldo = 0
    self.TotalSacado = 0
    self.TaxaArkhe = 0.10
    self.MinSaque = 100 -- Robux
    return self
end

function Payout:RegistrarVenda(itemId, valor)
    local venda = {
        Id = "venda_"..tostring(os.time()).."_"..math.random(1000,9999),
        ItemId = itemId,
        Valor = valor,
        Tempo = os.time(),
        Pago = false,
    }
    table.insert(self.Vendas, venda)
    local liquido = valor * (1 - self.TaxaArkhe)
    self.Saldo = self.Saldo + liquido
    return venda
end

function Payout:Calcular()
    local totalBruto = 0
    for _, v in ipairs(self.Vendas) do totalBruto = totalBruto + v.Valor end
    local taxa = totalBruto * self.TaxaArkhe
    local liquido = totalBruto - taxa
    return {
        Bruto = totalBruto,
        Taxa = taxa,
        Liquido = liquido,
        Saldo = self.Saldo,
        TotalSacado = self.TotalSacado,
        Disponivel = self.Saldo,
        TotalVendas = #self.Vendas,
    }
end

function Payout:PodeSacar()
    return self.Saldo >= self.MinSaque
end

function Payout:Sacar(quantia)
    quantia = quantia or self.Saldo
    if quantia > self.Saldo then return false, "saldo insuficiente" end
    if quantia < self.MinSaque then return false, "minimo "..self.MinSaque end
    self.Saldo = self.Saldo - quantia
    self.TotalSacado = self.TotalSacado + quantia
    for _, v in ipairs(self.Vendas) do v.Pago = true end
    return true, {
        Sacado = quantia,
        NovoSaldo = self.Saldo,
        Tempo = os.time(),
        Metodo = "Robux",
    }
end

function Payout:ListarVendas()
    return self.Vendas
end

function Payout:PayloadParaRelay()
    return {
        DevId = self.DevId,
        Calculo = self:Calcular(),
        Vendas = self.Vendas,
        PodeSacar = self:PodeSacar(),
    }
end

function Payout:Serializar()
    return {
        DevId = self.DevId,
        Saldo = self.Saldo,
        TotalSacado = self.TotalSacado,
        TotalVendas = #self.Vendas,
        TaxaArkhe = self.TaxaArkhe,
    }
end

return Payout
]]></ProtectedString></Properties></Item>
