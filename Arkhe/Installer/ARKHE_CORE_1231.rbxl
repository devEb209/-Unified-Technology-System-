     <Item class="ModuleScript" referent="RBX395161"><Properties><string name="Name">AnimationClip</string><ProtectedString name="Source"><![CDATA[--[[
	AnimationClip (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Animator > AnimationClip
	============================================================
	F6 — CLIP DE ANIMACAO (Ring1).
	Armazena keyframes por osso/joint (nome -> lista de {Tempo, CFrame, Easing}).
	Avaliacao com interpolacao e easing.
	Serializavel, publicavel, compativel com metodo CFrames atual.
	============================================================
]]

local AnimationClip = {}
AnimationClip.__index = AnimationClip

local function lerp(a,b,t) return a + (b-a)*t end
local function ease(t, tipo)
	tipo = tipo or "Linear"
	if tipo == "Linear" then return t
	elseif tipo == "SineInOut" then return 0.5 - math.cos(t*math.pi)*0.5
	elseif tipo == "QuadIn" then return t*t
	elseif tipo == "QuadOut" then return 1 - (1-t)*(1-t)
	elseif tipo == "QuadInOut" then
		if t < 0.5 then return 2*t*t else return 1 - (-2*t+2)^2/2 end
	elseif tipo == "ElasticOut" then
		if t==0 then return 0 elseif t==1 then return 1 else
			return 2^(-10*t)*math.sin((t*10-0.75)*2*math.pi/3)+1 end
	end
	return t
end

function AnimationClip.novo(nome, duracao)
	local self = setmetatable({}, AnimationClip)
	self.Nome = nome or "Clip"
	self.Duracao = duracao or 2
	self.Tracks = {} -- [boneNome] = { {Tempo, Pos=Vector3, Rot=Vector3 (euler), Escala=Vector3, Easing}, ... }
	self.Loop = true
	self.CriadoEm = os.time()
	return self
end

function AnimationClip:AdicionarKeyframe(osso, tempo, cf, easing)
	osso = osso or "Root"
	tempo = math.clamp(tempo or 0, 0, self.Duracao)
	cf = cf or CFrame.new()
	easing = easing or "QuadInOut"
	self.Tracks[osso] = self.Tracks[osso] or {}
	-- extrai pos e rot euler de cf
	local pos = cf.Position
	local _,_,_, rx, ry, rz = cf:GetComponents()
	-- GetComponents retorna 12 valores, mas para simplificar usamos ToEulerAngles
	local x,y,z = cf:ToEulerAnglesYXZ()
	table.insert(self.Tracks[osso], {
		Tempo = tempo,
		Pos = pos,
		Rot = Vector3.new(x,y,z),
		CFrame = cf,
		Easing = easing,
	})
	table.sort(self.Tracks[osso], function(a,b) return a.Tempo < b.Tempo end)
	return true
end

function AnimationClip:AdicionarKeyframePosRot(osso, tempo, pos, rotEuler, easing)
	osso = osso or "Root"
	tempo = math.clamp(tempo or 0, 0, self.Duracao)
	pos = pos or Vector3.new(0,0,0)
	rotEuler = rotEuler or Vector3.new(0,0,0)
	easing = easing or "QuadInOut"
	self.Tracks[osso] = self.Tracks[osso] or {}
	local cf = CFrame.new(pos) * CFrame.fromEulerAnglesYXZ(rotEuler.X, rotEuler.Y, rotEuler.Z)
	table.insert(self.Tracks[osso], {
		Tempo = tempo,
		Pos = pos,
		Rot = rotEuler,
		CFrame = cf,
		Easing = easing,
	})
	table.sort(self.Tracks[osso], function(a,b) return a.Tempo < b.Tempo end)
end

function AnimationClip:Avaliar(tempo)
	tempo = tempo or 0
	if self.Loop and self.Duracao > 0 then
		tempo = tempo % self.Duracao
	else
		tempo = math.clamp(tempo, 0, self.Duracao)
	end
	local pose = {} -- [osso] = CFrame
	for osso, kfs in pairs(self.Tracks) do
		if #kfs == 0 then
		elseif #kfs == 1 then
			pose[osso] = kfs[1].CFrame
		else
			-- encontra intervalo
			local a,b = kfs[1], kfs[#kfs]
			for i = 1, #kfs-1 do
				if tempo >= kfs[i].Tempo and tempo <= kfs[i+1].Tempo then
					a = kfs[i]; b = kfs[i+1]; break
				end
			end
			if tempo <= a.Tempo then
				pose[osso] = a.CFrame
			elseif tempo >= b.Tempo then
				pose[osso] = b.CFrame
			else
				local dt = b.Tempo - a.Tempo
				if dt <= 0.001 then
					pose[osso] = a.CFrame
				else
					local t = (tempo - a.Tempo)/dt
					t = ease(t, a.Easing)
					-- interpola pos linear, rot via Lerp de CFrame (nao slerp perfeito mas funciona)
					local pos = a.Pos:Lerp(b.Pos, t)
					-- slerp de rot via CFrame:Lerp
					local cf = a.CFrame:Lerp(b.CFrame, t)
					pose[osso] = CFrame.new(pos) * (cf - cf.Position)
				end
			end
		end
	end
	return pose
end

function AnimationClip:Serializar()
	local tracks = {}
	for osso, kfs in pairs(self.Tracks) do
		tracks[osso] = {}
		for _, kf in ipairs(kfs) do
			table.insert(tracks[osso], {
				T = kf.Tempo,
				P = { kf.Pos.X, kf.Pos.Y, kf.Pos.Z },
				R = { kf.Rot.X, kf.Rot.Y, kf.Rot.Z },
				E = kf.Easing,
			})
		end
	end
	return {
		Nome = self.Nome,
		Duracao = self.Duracao,
		Loop = self.Loop,
		Tracks = tracks,
		CriadoEm = self.CriadoEm,
	}
end

function AnimationClip.Deserializar(blob)
	local clip = AnimationClip.novo(blob.Nome or "Clip", blob.Duracao or 2)
	clip.Loop = blob.Loop ~= false
	clip.CriadoEm = blob.CriadoEm or os.time()
	for osso, kfs in pairs(blob.Tracks or {}) do
		for _, kf in ipairs(kfs) do
			local pos = Vector3.new(kf.P[1], kf.P[2], kf.P[3])
			local rot = Vector3.new(kf.R[1], kf.R[2], kf.R[3])
			clip:AdicionarKeyframePosRot(osso, kf.T, pos, rot, kf.E)
		end
	end
	return clip
end

function AnimationClip:Clonar(novoNome)
	local blob = self:Serializar()
	blob.Nome = novoNome or (self.Nome .. "_Clone")
	return AnimationClip.Deserializar(blob)
end

function AnimationClip:ListarOssos()
	local lista = {}
	for osso in pairs(self.Tracks) do table.insert(lista, osso) end
	table.sort(lista)
	return lista
end

return AnimationClip
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX921444"><Properties><string name="Name">BlendSpace</string><ProtectedString name="Source"><![CDATA[[[
	BlendSpace (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Animator > BlendSpace
	============================================================
	F6 — BLEND SPACES (Unreal-like)
	- 1D: blend por velocidade (Idle->Walk->Run)
	- 2D: blend por direção+velocidade (strafe)
	- Pontos: { Pos (Vector2), ClipNome, Peso }
	- Avaliar(pos): retorna { ClipA, ClipB, Peso, PoseBlend }
	- Triangulação baricêntrica simples para 2D
	============================================================
]]

local BlendSpace = {}
BlendSpace.__index = BlendSpace

function BlendSpace.novo(nome, tipo)
	local self = setmetatable({}, BlendSpace)
	self.Nome = nome or "BlendSpace_"..math.random(1000,9999)
	self.Tipo = tipo or "2D" -- 1D ou 2D
	self.Pontos = {} -- { Pos=Vector2/number, Clip, PesoBase }
	self.Min = Vector2.new(-1,-1)
	self.Max = Vector2.new(1,1)
	return self
end

function BlendSpace:AdicionarPonto(pos, clipNome, pesoBase)
	-- pos: Vector2 para 2D, number para 1D
	table.insert(self.Pontos, {
		Pos = pos,
		Clip = clipNome,
		PesoBase = pesoBase or 1,
	})
	return #self.Pontos
end

function BlendSpace:DefinirLimites(minV, maxV)
	self.Min = minV
	self.Max = maxV
	return self
end

function BlendSpace:Avaliar1D(valor)
	-- encontra 2 pontos mais próximos
	if #self.Pontos == 0 then return nil end
	if #self.Pontos == 1 then return { Clip=self.Pontos[1].Clip, Peso=1 } end
	table.sort(self.Pontos, function(a,b) return a.Pos < b.Pos end)
	local menor=nil; local maior=nil
	for _, p in ipairs(self.Pontos) do
		if p.Pos <= valor then menor=p end
		if p.Pos >= valor and not maior then maior=p end
	end
	menor = menor or self.Pontos[1]
	maior = maior or self.Pontos[#self.Pontos]
	if menor == maior then
		return { ClipA=menor.Clip, ClipB=menor.Clip, T=0, Peso=1 }
	end
	local t = (valor - menor.Pos) / (maior.Pos - menor.Pos)
	t = math.clamp(t,0,1)
	return { ClipA=menor.Clip, ClipB=maior.Clip, T=t, Peso=1 }
end

function BlendSpace:Avaliar2D(pos)
	if #self.Pontos == 0 then return nil end
	if #self.Pontos == 1 then return { Clip=self.Pontos[1].Clip, Peso=1 } end
	-- encontra 3 pontos mais próximos para blend baricêntrico
	local dists={}
	for _, p in ipairs(self.Pontos) do
		local d = (p.Pos - pos).Magnitude
		table.insert(dists, { Ponto=p, Dist=d })
	end
	table.sort(dists, function(a,b) return a.Dist < b.Dist end)
	local n = math.min(3, #dists)
	local selecionados={}
	local totalInv=0
	for i=1,n do
		local inv = 1 / (dists[i].Dist + 0.001)
		totalInv = totalInv + inv
		table.insert(selecionados, { Ponto=dists[i].Ponto, Inv=inv })
	end
	-- normaliza pesos
	local blends={}
	for _, s in ipairs(selecionados) do
		table.insert(blends, { Clip=s.Ponto.Clip, Peso=(s.Inv/totalInv)*s.Ponto.PesoBase, Pos=s.Ponto.Pos })
	end
	return { Blends=blends, Pos=pos, Num=n }
end

function BlendSpace:Avaliar(pos)
	if self.Tipo == "1D" then
		return self:Avaliar1D(type(pos)=="number" and pos or pos.X)
	else
		return self:Avaliar2D(typeof(pos)=="Vector2" and pos or Vector2.new(pos.X or 0, pos.Z or 0))
	end
end

function BlendSpace:Serializar()
	return {
		Nome=self.Nome,
		Tipo=self.Tipo,
		NumPontos=#self.Pontos,
		Pontos=(function()
			local l={}
			for _, p in ipairs(self.Pontos) do
				table.insert(l, { Clip=p.Clip, Pos=tostring(p.Pos) })
			end
			return l
		end)(),
		Min={ X=self.Min.X, Y=self.Min.Y },
		Max={ X=self.Max.X, Y=self.Max.Y },
	}
end

function BlendSpace.ListarExemplo()
	local bs = BlendSpace.novo("Locomocao", "2D")
	bs:AdicionarPonto(Vector2.new(0,0), "Idle", 1)
	bs:AdicionarPonto(Vector2.new(0,1), "WalkF", 1)
	bs:AdicionarPonto(Vector2.new(0,2), "RunF", 1)
	bs:AdicionarPonto(Vector2.new(-1,1), "WalkL", 1)
	bs:AdicionarPonto(Vector2.new(1,1), "WalkR", 1)
	return bs:Serializar()
end

return BlendSpace
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX545912"><Properties><string name="Name">CCD</string><ProtectedString name="Source"><![CDATA[
local CCD = {}
function CCD.novo() return setmetatable({Nome="CCD", Ativo=true, Dados={}}, {__index=CCD}) end
