     <Item class="ModuleScript" referent="RBX886545"><Properties><string name="Name">Title</string><ProtectedString name="Source"><![CDATA[
local Title = {}
function Title.novo() return setmetatable({Nome="Title", Ativo=true, Dados={}}, {__index=Title}) end
function Title:Ativar() self.Ativo=true end
function Title:Desativar() self.Ativo=false end
function Title:Tick(dt) end
function Title:Serializar() return {Nome=self.Nome, Ativo=self.Ativo} end
return Title
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX902312"><Properties><string name="Name">Trade</string><ProtectedString name="Source"><![CDATA[[[
	Trade (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Economy > Trade
	============================================================
	F18 — TRADE ENTRE JOGADORES
	- Oferta: { De, Para, ItensDe, ItensPara, MoedasDe, MoedasPara, Status }
	- Status: Pendente/Aceita/Recusada/Cancelada/Expirada
	- Validação: tem itens? anti-dupe via Inventory
	- Expiração: 5 minutos
	- Integra com Inventory + Bank + AntiCheat
	============================================================
]]

local Trade = {}
Trade.__index = Trade

function Trade.novo()
	local self = setmetatable({}, Trade)
	self.Ofertas = {} -- [id] = oferta
	self.Historico = {}
	self.ProximoId = 1
	return self
end

function Trade:CriarOferta(deUserId, paraUserId, itensDe, itensPara, moedasDe, moedasPara)
	local id = "trade_"..self.ProximoId
	self.ProximoId = self.ProximoId + 1
	local oferta = {
		Id=id,
		De=deUserId,
		Para=paraUserId,
		ItensDe=itensDe or {},
		ItensPara=itensPara or {},
		MoedasDe=moedasDe or 0,
		MoedasPara=moedasPara or 0,
		Status="Pendente",
		CriadoEm=os.time(),
		ExpiraEm=os.time()+300, -- 5 min
	}
	self.Ofertas[id]=oferta
	return oferta
end

function Trade:ValidarOferta(id, inventarios, bancos)
	local oferta = self.Ofertas[id]
	if not oferta then return false, "Oferta não existe" end
	if oferta.Status ~= "Pendente" then return false, "Oferta não está pendente" end
	if os.time() > oferta.ExpiraEm then
		oferta.Status="Expirada"
		return false, "Oferta expirada"
	end
	-- valida se De tem itens/moedas
	-- inventarios: [userId] = Inventory
	-- simplificado: checa se tem
	if inventarios then
		local invDe = inventarios[oferta.De]
		if invDe and invDe.Tem then
			for item, qtd in pairs(oferta.ItensDe) do
				if not invDe:Tem(item, qtd) then
					return false, "De não tem "..item
				end
			end
		end
		local invPara = inventarios[oferta.Para]
		if invPara and invPara.Tem then
			for item, qtd in pairs(oferta.ItensPara) do
				if not invPara:Tem(item, qtd) then
					return false, "Para não tem "..item
				end
			end
		end
	end
	return true, "OK"
end

function Trade:Aceitar(id, inventarios, bancos)
	local ok, err = self:ValidarOferta(id, inventarios, bancos)
	if not ok then return false, err end
	local oferta = self.Ofertas[id]
	-- transfere itens
	if inventarios then
		local invDe = inventarios[oferta.De]
		local invPara = inventarios[oferta.Para]
		if invDe and invPara then
			for item, qtd in pairs(oferta.ItensDe) do
				if invDe.Remover then invDe:Remover(item, qtd) end
				if invPara.Adicionar then invPara:Adicionar(item, qtd) end
			end
			for item, qtd in pairs(oferta.ItensPara) do
				if invPara.Remover then invPara:Remover(item, qtd) end
				if invDe.Adicionar then invDe:Adicionar(item, qtd) end
			end
		end
	end
	-- transfere moedas via banco
	if bancos then
		if oferta.MoedasDe > 0 then
			bancos:Sacar(oferta.De, oferta.MoedasDe, "Trade "..id)
			bancos:Depositar(oferta.Para, oferta.MoedasDe, "Trade "..id)
		end
		if oferta.MoedasPara > 0 then
			bancos:Sacar(oferta.Para, oferta.MoedasPara, "Trade "..id)
			bancos:Depositar(oferta.De, oferta.MoedasPara, "Trade "..id)
		end
	end
	oferta.Status="Aceita"
	table.insert(self.Historico, oferta)
	self.Ofertas[id]=nil
	if #self.Historico > 50 then table.remove(self.Historico,1) end
	return true, oferta
end

function Trade:Recusar(id)
	local oferta = self.Ofertas[id]
	if not oferta then return false end
	oferta.Status="Recusada"
	table.insert(self.Historico, oferta)
	self.Ofertas[id]=nil
	return true
end

function Trade:Cancelar(id, quem)
	local oferta = self.Ofertas[id]
	if not oferta then return false end
	if oferta.De ~= quem and oferta.Para ~= quem then return false end
	oferta.Status="Cancelada"
	table.insert(self.Historico, oferta)
	self.Ofertas[id]=nil
	return true
end

function Trade:ListarPendentes(userId)
	local lista={}
	for _, oferta in pairs(self.Ofertas) do
		if oferta.De == userId or oferta.Para == userId then
			if os.time() <= oferta.ExpiraEm then
				table.insert(lista, oferta)
			else
				oferta.Status="Expirada"
			end
		end
	end
	return lista
end

function Trade:LimparExpiradas()
	local removidas=0
	for id, oferta in pairs(self.Ofertas) do
		if os.time() > oferta.ExpiraEm then
			oferta.Status="Expirada"
			table.insert(self.Historico, oferta)
			self.Ofertas[id]=nil
			removidas=removidas+1
		end
	end
	return removidas
end

function Trade:Serializar()
	return {
		Pendentes=(function() local c=0 for _ in pairs(self.Ofertas) do c=c+1 end return c end)(),
		Historico=#self.Historico,
		ProximoId=self.ProximoId,
	}
end

return Trade
]]></ProtectedString></Properties></Item>
