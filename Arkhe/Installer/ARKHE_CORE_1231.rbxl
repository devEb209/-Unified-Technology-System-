     <Item class="ModuleScript" referent="RBX802103"><Properties><string name="Name">OceanSystem</string><ProtectedString name="Source"><![CDATA[
local OceanSystem = {}
function OceanSystem.novo() return setmetatable({Nivel=0, Ondas={Altura=2, Frequencia=0.5}, Mares=0}, {__index=OceanSystem}) end
function OceanSystem:AlturaEm(x,z,t) return self.Nivel + math.sin(x*0.1+t*self.Ondas.Frequencia)*self.Ondas.Altura + math.cos(z*0.1+t*0.3)*self.Ondas.Altura*0.5 end
function OceanSystem:Serializar() return {Nivel=self.Nivel, Ondas=self.Ondas} end
return OceanSystem
]]></ProtectedString></Properties></Item>
