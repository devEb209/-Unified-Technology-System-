     <Item class="ModuleScript" referent="RBX675259"><Properties><string name="Name">Grammar</string><ProtectedString name="Source"><![CDATA[[[
	Grammar (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Terrain > Grammar
	============================================================
	F4 — GRAMÁTICA DE CONSTRUÇÕES PROCEDURAIS
	Regras tipo L-system para vila/castelo/ruína:
	- Regra: Antecedente -> Sucessores com prob + condição
	- Expansão: a partir de semente (ex: "Vila") gera lista
	  de entidades {Arquetipo, Pos, Rot, Escala, Tags}
	- Integra com RRW: coloca entidades no World
	- Busca web: presets de arquitetura (viking/medieval/etc)
	============================================================
]]

local Grammar = {}
Grammar.__index = Grammar

Grammar.Presets = {
	VilaViking = {
		Desc = "Vila viking: longhouse central + cabanas ao redor + paliçada",
		Regras = {
			{ De="Vila", Para={ "Longhouse","Cabana","Cabana","Paliçada","TorreVigia" }, Prob=1.0 },
			{ De="Longhouse", Para={ "Longhouse","Mesa","Banco","Tocheiro" }, Prob=0.8 },
			{ De="Cabana", Para={ "Cabana","Baú","Fogueira" }, Prob=0.6 },
		}
	},
	CasteloMedieval = {
		Desc = "Castelo medieval: muralha + torres + pátio + castelo",
		Regras = {
			{ De="Castelo", Para={ "Muralha","Torre","Torre","Pátio","TorreMenagem" }, Prob=1.0 },
			{ De="Muralha", Para={ "Muralha","Portão","Muralha" }, Prob=0.9 },
			{ De="Pátio", Para={ "Poço","Estábulo","Capela" }, Prob=0.7 },
		}
	},
	RuinaFantasia = {
		Desc = "Ruína fantasia: arcos quebrados + colunas + altar",
		Regras = {
			{ De="Ruina", Para={ "Arco","Coluna","Coluna","Altar","MuroQuebrado" }, Prob=1.0 },
		}
	},
}

function Grammar.novo(nome, seed)
	local self = setmetatable({}, Grammar)
	self.Nome = nome or "Gramatica_"..math.random(1000,9999)
	self.Seed = seed or math.random(1, 999999)
	self.Regras = {}
	self.EntidadesGeradas = {}
	self.RNG = Random.new(self.Seed)
	return self
end

function Grammar:AdicionarRegra(de, paraLista, prob, condicao)
	-- paraLista: { "Arquetipo1", "Arquetipo2", ... }
	table.insert(self.Regras, {
		De = de,
		Para = paraLista,
		Prob = prob or 1.0,
		Condicao = condicao, -- opcional function(ctx)->bool
	})
	return #self.Regras
end

function Grammar:CarregarPreset(nomePreset)
	local preset = Grammar.Presets[nomePreset]
	if not preset then return false, "Preset nao encontrado: "..tostring(nomePreset) end
	self.Regras = {}
	for _, r in ipairs(preset.Regras) do
		self:AdicionarRegra(r.De, r.Para, r.Prob, r.Condicao)
	end
	return true
end

function Grammar:Expandir(simboloInicial, maxIteracoes, contexto)
	simboloInicial = simboloInicial or "Vila"
	maxIteracoes = maxIteracoes or 3
	contexto = contexto or {}
	local fila = { simboloInicial }
	local resultado = {}
	local iter = 0

	while #fila > 0 and iter < maxIteracoes do
		iter = iter + 1
		local novaFila = {}
		for _, simbolo in ipairs(fila) do
			local expandiu = false
			for _, regra in ipairs(self.Regras) do
				if regra.De == simbolo then
					-- checa condicao
					local pode = true
					if regra.Condicao then
						local ok, res = pcall(regra.Condicao, contexto)
						pode = ok and res
					end
					if pode and self.RNG:NextNumber() <= regra.Prob then
						for _, s in ipairs(regra.Para) do
							table.insert(novaFila, s)
						end
						expandiu = true
						break
					end
				end
			end
			if not expandiu then
				-- terminal
				table.insert(resultado, simbolo)
			end
		end
		fila = novaFila
		if #fila > 200 then break end -- limite segurança
	end
	-- resto da fila vira resultado
	for _, s in ipairs(fila) do table.insert(resultado, s) end
	self.EntidadesGeradas = resultado
	return resultado
end

function Grammar:GerarPosicoes(centro, raio, resultado)
	resultado = resultado or self.EntidadesGeradas
	centro = centro or Vector3.new(0,0,0)
	raio = raio or 80
	local posicoes = {}
	local anguloStep = (2*math.pi) / math.max(1, #resultado)
	for i, arquetipo in ipairs(resultado) do
		local ang = anguloStep * (i-1) + self.RNG:NextNumber(-0.3,0.3)
		local dist = self.RNG:NextNumber(raio*0.2, raio)
		local pos = centro + Vector3.new(math.cos(ang)*dist, 0, math.sin(ang)*dist)
		table.insert(posicoes, {
			Arquetipo = arquetipo,
			Pos = pos,
			Rot = self.RNG:NextNumber(0,360),
			Escala = self.RNG:NextNumber(0.9,1.2),
			Indice = i,
		})
	end
	return posicoes
end

function Grammar:Serializar()
	return {
		Nome = self.Nome,
		Seed = self.Seed,
		NumRegras = #self.Regras,
		Entidades = self.EntidadesGeradas,
		Presets = (function()
			local l={}
			for k,_ in pairs(Grammar.Presets) do table.insert(l,k) end
			return l
		end)(),
	}
end

function Grammar.ListarPresets()
	local lista={}
	for nome, p in pairs(Grammar.Presets) do
		table.insert(lista, { Nome=nome, Desc=p.Desc, NumRegras=#p.Regras })
	end
	return lista
end

return Grammar
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX544404"><Properties><string name="Name">HeightField</string><ProtectedString name="Source"><![CDATA[--[[
	HeightField (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Terrain > HeightField
	============================================================
	F4 — O TERRENO PROPRIO DA ARKHE (dados, nao render).
	Nao usamos o Terrain do Roblox: aqui o chao e um CAMPO DE
	ALTURAS semantico (RRW-style) que sabe bioma, umidade e
	inclinacao em cada ponto.

	- Geracao procedural multi-oitava (7 estilos nativos)
	- Mapa de umidade -> biomas coerentes (floresta nasce onde
	  ha agua, neve onde e alto, rocha onde e ingreme)
	- Erosao termica (montanhas com pe realista, sem picos ocos)
	- Pinceis: Elevar / Baixar / Suavizar / Plato
	- Bilinear: AlturaMundo(x,z) para plantar qualquer entidade
	- Serializavel (DataStore/relay/marketplace)
	- MUNDO REAL: CarregarMatriz() aceita alturas de elevacao
	  reais vindas do relay (lat/lon -> APIs publicas)
	============================================================
]]

local HeightField = {}
HeightField.__index = HeightField

-- ============ ESTILOS NATIVOS ============
HeightField.Estilos = {
	Planicie = { Descricao = "Campos suaves, quase plano",
		Amplitude = 9, Frequencia = 1 / 260, Oitavas = 3, TemAgua = false, UmidadeBase = 0.1 },
	Colinas = { Descricao = "Morros rolantes classicos",
		Amplitude = 26, Frequencia = 1 / 190, Oitavas = 4, TemAgua = false, UmidadeBase = 0.05 },
	Montanhas = { Descricao = "Picos ridged com neve, vales profundos",
		Amplitude = 92, Frequencia = 1 / 300, Oitavas = 5, Ridged = true,
		AlturaNeve = 55, TemAgua = false, UmidadeBase = 0 },
	Vale = { Descricao = "Vale habitavel cercado de montanhas",
		Amplitude = 80, Frequencia = 1 / 280, Oitavas = 5, Ridged = true,
		Vale = true, AlturaNeve = 60, TemAgua = false, UmidadeBase = 0.15 },
	Ilha = { Descricao = "Ilha com praias, centro elevado, mar ao redor",
		Amplitude = 42, Frequencia = 1 / 210, Oitavas = 4, Ilha = true,
		TemAgua = true, UmidadeBase = 0.2 },
	Arquipelago = { Descricao = "Varias ilhas pequenas num mar raso",
		Amplitude = 24, Frequencia = 1 / 150, Oitavas = 4, Arquipelago = true,
		TemAgua = true, UmidadeBase = 0.25 },
	Deserto = { Descricao = "Dunas ridged, seco, sem vegetacao",
		Amplitude = 14, Frequencia = 1 / 120, Oitavas = 3, Ridged = true,
		TemAgua = false, UmidadeBase = -0.6 },
}

-- ============ CONSTRUTOR ============
-- config: Largura (celulas), Celula (studs), Seed
function HeightField.nova(config)
	local self = setmetatable({}, HeightField)
	self.Largura = config.Largura or 96          -- celulas por lado
	self.Celula = config.Celula or 12            -- studs por celula
	self.Seed = config.Seed or math.random(1, 99999)
	self.NivelMar = 0
	self.TemAgua = false
	self.EstiloNome = nil
	self.Alturas = {}                            -- [x][z], 0..Largura (cantos)
	self.Umidade = {}
	for x = 0, self.Largura do
		self.Alturas[x] = {}
		self.Umidade[x] = {}
		for z = 0, self.Largura do
			self.Alturas[x][z] = 0
			self.Umidade[x][z] = 0
		end
	end
	return self
end

-- ============ RUIDO ============
local function ruido(x, z, seed)
	return math.noise(x + seed * 0.1731, z + seed * 0.7193)
end

local function fractal(x, z, seed, freq, oitavas, ridged)
	local total, amp, f, peso = 0, 1, freq, 0
	for o = 1, oitavas do
		local n = ruido(x * f, z * f, seed + o * 131)
		if ridged then
			n = 1 - math.abs(n) * 2 -- cristas afiadas (montanha real)
			n = n * n
		end
		total = total + n * amp
		peso = peso + amp
		amp = amp * 0.5
		f = f * 2.1
	end
	return total / peso
end

-- ============ GERACAO ============
function HeightField:Gerar(estiloNome, ajustes)
	local e = HeightField.Estilos[estiloNome]
	if not e then return false, "estilo '" .. tostring(estiloNome) .. "' nao existe" end
	-- ajustes: a IA pode sobrescrever qualquer parametro (referencias web!)
	local p = {}
	for k, v in pairs(e) do p[k] = v end
	for k, v in pairs(ajustes or {}) do p[k] = v end

	self.EstiloNome = estiloNome
	self.TemAgua = p.TemAgua == true
	self.NivelMar = p.NivelMar or 0
	local L, meio = self.Largura, self.Largura / 2

	for x = 0, L do
		for z = 0, L do
			local wx, wz = x * self.Celula, z * self.Celula
			local h = fractal(wx, wz, self.Seed, p.Frequencia, p.Oitavas, p.Ridged)
			h = h * p.Amplitude

			if p.Ilha then
				local d = math.sqrt((x - meio) ^ 2 + (z - meio) ^ 2) / meio
				local mascara = math.clamp(1 - d ^ 2.2, 0, 1)
				h = (h + p.Amplitude * 0.35) * mascara - 7 -- borda afunda no mar
			elseif p.Arquipelago then
				local m = ruido(wx / 400, wz / 400, self.Seed + 777)
				local mascara = math.clamp((m + 0.12) * 4, 0, 1)
				h = (h + p.Amplitude * 0.4) * mascara - 6
			elseif p.Vale then
				local lateral = math.clamp(math.abs(x - meio) / meio, 0, 1) ^ 1.6
				h = h * lateral + 2 -- centro plano habitavel, bordas erguem
			end

			self.Alturas[x][z] = h
			-- umidade: ruido lento + baixadas sao mais umidas
			local u = ruido(wx / 500, wz / 500, self.Seed + 4242) + (p.UmidadeBase or 0)
			u = u + math.clamp((10 - h) / 60, -0.2, 0.25)
			self.Umidade[x][z] = math.clamp(u + 0.5, 0, 1)
		end
	end

	self:Erosao(p.Ridged and 3 or 1)
	self.AlturaNeve = p.AlturaNeve
	return true
end

-- Erosao termica: material desliza de encostas ingremes (talus)
function HeightField:Erosao(iteracoes)
	local L = self.Largura
	local talus = self.Celula * 0.9
	for _ = 1, iteracoes do
		for x = 1, L - 1 do
			for z = 1, L - 1 do
				local h = self.Alturas[x][z]
				local menorH, mx, mz = h, x, z
				for _, v in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
					local nh = self.Alturas[x + v[1]][z + v[2]]
					if nh < menorH then menorH, mx, mz = nh, x + v[1], z + v[2] end
				end
				local diff = h - menorH
				if diff > talus then
					local mover = (diff - talus) * 0.4
					self.Alturas[x][z] = h - mover
					self.Alturas[mx][mz] = menorH + mover
				end
			end
		end
	end
end

-- ============ CONSULTAS ============
-- Altura interpolada em coordenada de MUNDO (pra plantar entidades)
function HeightField:AlturaMundo(wx, wz)
	local meio = self.Largura / 2
	local fx = wx / self.Celula + meio
	local fz = wz / self.Celula + meio
	local x0 = math.clamp(math.floor(fx), 0, self.Largura - 1)
	local z0 = math.clamp(math.floor(fz), 0, self.Largura - 1)
	local tx, tz = fx - x0, fz - z0
	local a = self.Alturas[x0][z0]
	local b = self.Alturas[x0 + 1][z0]
	local c = self.Alturas[x0][z0 + 1]
	local d = self.Alturas[x0 + 1][z0 + 1]
	return (a * (1 - tx) + b * tx) * (1 - tz) + (c * (1 - tx) + d * tx) * tz
end

-- Bioma semantico de uma celula (altura + umidade + inclinacao)
function HeightField:Bioma(x, z)
	x = math.clamp(x, 0, self.Largura - 1)
	z = math.clamp(z, 0, self.Largura - 1)
	local h = self.Alturas[x][z]
	local u = self.Umidade[x][z]
	local dx = math.abs(self.Alturas[x + 1][z] - h)
	local dz = math.abs(self.Alturas[x][z + 1] - h)
	local inclinacao = math.max(dx, dz) / self.Celula

	if self.TemAgua and h < self.NivelMar + 1.5 then return "Areia" end
	if self.AlturaNeve and h > self.AlturaNeve then return "Neve" end
	if inclinacao > 0.85 then return "Rocha" end
	if u < 0.22 then return "Seco" end
	if u > 0.62 then return "Floresta" end
	return "Grama"
end

-- ============ PINCEIS (o editor esculpe AQUI, o render segue) ============
-- op: "Elevar" | "Baixar" | "Suavizar" | "Plato"
-- Devolve o retangulo de celulas alterado (pro render redesenhar so ali)
function HeightField:Pincel(op, wx, wz, raio, forca)
	local meio = self.Largura / 2
	local cx = math.floor(wx / self.Celula + meio + 0.5)
	local cz = math.floor(wz / self.Celula + meio + 0.5)
	local rc = math.max(1, math.floor(raio / self.Celula + 0.5))
	forca = math.clamp(forca or 4, -60, 60)
	local alvoPlato = self.Alturas[math.clamp(cx, 0, self.Largura)][math.clamp(cz, 0, self.Largura)]

	local x0 = math.clamp(cx - rc, 0, self.Largura)
	local x1 = math.clamp(cx + rc, 0, self.Largura)
	local z0 = math.clamp(cz - rc, 0, self.Largura)
	local z1 = math.clamp(cz + rc, 0, self.Largura)

	for x = x0, x1 do
		for z = z0, z1 do
			local d = math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2) / rc
			if d <= 1 then
				local queda = (math.cos(d * math.pi) + 1) * 0.5 -- suave nas bordas
				local h = self.Alturas[x][z]
				if op == "Elevar" then
					self.Alturas[x][z] = h + forca * queda
				elseif op == "Baixar" then
					self.Alturas[x][z] = h - forca * queda
				elseif op == "Suavizar" then
					local soma, n = 0, 0
					for ox = -1, 1 do
						for oz = -1, 1 do
							local ax = math.clamp(x + ox, 0, self.Largura)
							local az = math.clamp(z + oz, 0, self.Largura)
							soma = soma + self.Alturas[ax][az]
							n = n + 1
						end
					end
					self.Alturas[x][z] = h + (soma / n - h) * 0.6 * queda
				elseif op == "Plato" then
					self.Alturas[x][z] = h + (alvoPlato - h) * 0.8 * queda
				end
			end
		end
	end
	return x0, z0, x1, z1
end

-- ============ MUNDO REAL (relay -> APIs de elevacao) ============
-- matriz: array de linhas [ [h,h,...], ... ] em metros; escala converte
function HeightField:CarregarMatriz(matriz, escalaVertical)
	if type(matriz) ~= "table" or #matriz < 2 then return false end
	escalaVertical = escalaVertical or 0.28 -- metros -> studs (1 stud ~ 0.28m)
	local linhas = #matriz
	local colunas = #matriz[1]
	local minimo = math.huge
	for _, linha in ipairs(matriz) do
		for _, v in ipairs(linha) do
			if type(v) == "number" and v < minimo then minimo = v end
		end
	end
	for x = 0, self.Largura do
		for z = 0, self.Largura do
			local sx = math.floor(x / self.Largura * (colunas - 1)) + 1
			local sz = math.floor(z / self.Largura * (linhas - 1)) + 1
			local v = matriz[sz] and matriz[sz][sx]
			self.Alturas[x][z] = type(v) == "number" and (v - minimo) * escalaVertical or 0
			self.Umidade[x][z] = 0.35
		end
	end
	self.EstiloNome = "MundoReal"
	self.TemAgua = false
	self:Erosao(1)
	return true
end

-- ============ SERIALIZACAO ============
function HeightField:Serializar()
	local partes = {}
	for x = 0, self.Largura do
		for z = 0, self.Largura do
			table.insert(partes, string.format("%.1f", self.Alturas[x][z]))
		end
	end
	return {
		Largura = self.Largura, Celula =]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX617490"><Properties><string name="Name">HeightmapEroder</string><ProtectedString name="Source"><![CDATA[
local HeightmapEroder = {}
function HeightmapEroder.novo() return setmetatable({Nome="HeightmapEroder", Ativo=true}, {__index=HeightmapEroder}) end
function HeightmapEroder:Serializar() return {Nome=self.Nome} end
return HeightmapEroder
