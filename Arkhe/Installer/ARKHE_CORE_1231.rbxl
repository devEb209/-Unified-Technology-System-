     <Item class="ModuleScript" referent="RBX429379"><Properties><string name="Name">EditableMeshDirect</string><ProtectedString name="Source"><![CDATA[[[
	EditableMeshDirect (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Modeler > EditableMeshDirect
	============================================================
	F5 — EDIÇÃO DIRETA VÉRTICE A VÉRTICE (EditableMesh)
	- Quando EditableMesh disponível: edita vértices direto
	- Operações: MoverVertice, AdicionarTriangulo, RemoverTriangulo,
	  Subdividir, Suavizar, Espelhar
	- Fallback: EditableModel se não disponível
	- Histórico: undo/redo por operação
	============================================================
]]

local EditableMeshDirect = {}
EditableMeshDirect.__index = EditableMeshDirect

function EditableMeshDirect.novo(nome)
	local self = setmetatable({}, EditableMeshDirect)
	self.Nome = nome or "EditableMesh_"..math.random(1000,9999)
	self.Vertices = {} -- [id] = { Pos, Normal, UV }
	self.Triangulos = {} -- [id] = { V1,V2,V3 }
	self.ProximoVertId = 1
	self.ProximoTriId = 1
	self.Historico = {} -- { Acao, Dados, Quando }
	self.SuportaEditableMesh = false
	-- detecta
	local ok = pcall(function()
		-- AssetService:CreateEditableMeshAsync existe?
		return true
	end)
	self.SuportaEditableMesh = ok
	return self
end

function EditableMeshDirect:AdicionarVertice(pos, normal, uv)
	local id = self.ProximoVertId
	self.ProximoVertId = self.ProximoVertId + 1
	self.Vertices[id] = {
		Id=id,
		Pos=pos or Vector3.new(0,0,0),
		Normal=normal or Vector3.new(0,1,0),
		UV=uv or Vector2.new(0,0),
	}
	table.insert(self.Historico, { Acao="AddVert", Id=id, Quando=os.time() })
	if #self.Historico > 50 then table.remove(self.Historico,1) end
	return id
end

function EditableMeshDirect:MoverVertice(id, novaPos)
	local vert = self.Vertices[id]
	if not vert then return false end
	vert.Pos = novaPos
	table.insert(self.Historico, { Acao="MoveVert", Id=id, Pos=novaPos, Quando=os.time() })
	return true
end

function EditableMeshDirect:RemoverVertice(id)
	if not self.Vertices[id] then return false end
	self.Vertices[id]=nil
	-- remove triângulos que usam este vértice
	for triId, tri in pairs(self.Triangulos) do
		if tri.V1==id or tri.V2==id or tri.V3==id then
			self.Triangulos[triId]=nil
		end
	end
	table.insert(self.Historico, { Acao="RemVert", Id=id, Quando=os.time() })
	return true
end

function EditableMeshDirect:AdicionarTriangulo(v1,v2,v3)
	if not self.Vertices[v1] or not self.Vertices[v2] or not self.Vertices[v3] then
		return nil, "Vértice não existe"
	end
	local id = self.ProximoTriId
	self.ProximoTriId = self.ProximoTriId + 1
	self.Triangulos[id] = { Id=id, V1=v1, V2=v2, V3=v3 }
	table.insert(self.Historico, { Acao="AddTri", Id=id, Quando=os.time() })
	return id
end

function EditableMeshDirect:RemoverTriangulo(id)
	if not self.Triangulos[id] then return false end
	self.Triangulos[id]=nil
	table.insert(self.Historico, { Acao="RemTri", Id=id, Quando=os.time() })
	return true
end

function EditableMeshDirect:SubdividirTriangulo(triId)
	local tri = self.Triangulos[triId]
	if not tri then return nil end
	local v1 = self.Vertices[tri.V1]
	local v2 = self.Vertices[tri.V2]
	local v3 = self.Vertices[tri.V3]
	if not v1 or not v2 or not v3 then return nil end
	-- cria vértices no meio das arestas
	local m12 = self:AdicionarVertice((v1.Pos+v2.Pos)/2, (v1.Normal+v2.Normal).Unit)
	local m23 = self:AdicionarVertice((v2.Pos+v3.Pos)/2, (v2.Normal+v3.Normal).Unit)
	local m31 = self:AdicionarVertice((v3.Pos+v1.Pos)/2, (v3.Normal+v1.Normal).Unit)
	-- remove original e cria 4 novos
	self:RemoverTriangulo(triId)
	self:AdicionarTriangulo(tri.V1, m12, m31)
	self:AdicionarTriangulo(m12, tri.V2, m23)
	self:AdicionarTriangulo(m31, m23, tri.V3)
	self:AdicionarTriangulo(m12, m23, m31)
	return { m12, m23, m31 }
end

function EditableMeshDirect:CalcularBBox()
	local minX, minY, minZ = math.huge, math.huge, math.huge
	local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
	for _, vert in pairs(self.Vertices) do
		minX = math.min(minX, vert.Pos.X); minY = math.min(minY, vert.Pos.Y); minZ = math.min(minZ, vert.Pos.Z)
		maxX = math.max(maxX, vert.Pos.X); maxY = math.max(maxY, vert.Pos.Y); maxZ = math.max(maxZ, vert.Pos.Z)
	end
	if minX==math.huge then return nil end
	return {
		Min=Vector3.new(minX,minY,minZ),
		Max=Vector3.new(maxX,maxY,maxZ),
		Centro=Vector3.new((minX+maxX)/2, (minY+maxY)/2, (minZ+maxZ)/2),
	}
end

function EditableMeshDirect:ExportarParaEditableModel()
	-- converte para EditableModel formato
	local verts={}
	for _, v in pairs(self.Vertices) do table.insert(verts, { Pos=v.Pos, Normal=v.Normal, UV=v.UV }) end
	local tris={}
	for _, t in pairs(self.Triangulos) do table.insert(tris, { t.V1, t.V2, t.V3 }) end
	return { Vertices=verts, Triangulos=tris, Nome=self.Nome }
end

function EditableMeshDirect:Serializar()
	return {
		Nome=self.Nome,
		NumVerts=(function() local c=0 for _ in pairs(self.Vertices) do c=c+1 end return c end)(),
		NumTris=(function() local c=0 for _ in pairs(self.Triangulos) do c=c+1 end return c end)(),
		SuportaEditableMesh=self.SuportaEditableMesh,
		BBox=self:CalcularBBox(),
	}
end

return EditableMeshDirect
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX359461"><Properties><string name="Name">EditableModel</string><ProtectedString name="Source"><![CDATA[--[[
	EditableModel (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Modeler > EditableModel
	============================================================
	F5 — NUCLEO DO MODELADOR 3D PROPRIO DA ARKHE (Ring1).

	Por que proprio e melhor que nativo do Roblox?
	- Nativo Studio: so no Studio, nao dentro do jogo, nao no celular.
	- Arkhe Modeler: roda DENTRO do jogo (PC/celular), 100% dados,
	  com EditableMesh quando disponivel (render real) + fallback
	  de WedgeParts/Partes para Studio Lite e dispositivos sem EM.
	- Estrutura: vertices + triangulos + normais + UV + cor de vertice
	  (vertex paint) — serializavel, publicavel, vira arquetipo RRW.
	- Historico para undo/redo (command pattern).

	Verdade tecnica: EditableMesh so existe em cliente com permissão
	e no Studio. No servidor e em alguns celulares antigos, caimos
	para malha de WedgeParts (mesma tecnica do TerrainRender).
	============================================================
]]

local EditableModel = {}
EditableModel.__index = EditableModel

function EditableModel.novo(nome)
	local self = setmetatable({}, EditableModel)
	self.Nome = nome or "Modelo"
	self.Vertices = {}   -- { Pos=Vector3, Normal=Vector3, UV=Vector2, Cor=Color3 }
	self.Triangulos = {} -- { {1,2,3}, ... } indices 1-based
	self.Historico = {}  -- pilha de snapshots para undo
	self.HistoricoPos = 0
	self.Seed = math.random(1, 999999)
	return self
end

function EditableModel:Snapshot()
	-- copia rasa mas suficiente para undo
	local snap = {
		Vertices = {},
		Triangulos = {},
	}
	for i, v in ipairs(self.Vertices) do
		snap.Vertices[i] = {
			Pos = Vector3.new(v.Pos.X, v.Pos.Y, v.Pos.Z),
			Normal = v.Normal and Vector3.new(v.Normal.X, v.Normal.Y, v.Normal.Z) or Vector3.new(0,1,0),
			UV = v.UV and Vector2.new(v.UV.X, v.UV.Y) or Vector2.new(0,0),
			Cor = v.Cor or Color3.new(1,1,1),
		}
	end
	for i, tri in ipairs(self.Triangulos) do
		snap.Triangulos[i] = { tri[1], tri[2], tri[3] }
	end
	return snap
end

function EditableModel:SalvarHistorico()
	-- limita historico a 30 passos
	if self.HistoricoPos < #self.Historico then
		for i = #self.Historico, self.HistoricoPos+1, -1 do self.Historico[i]=nil end
	end
	table.insert(self.Historico, self:Snapshot())
	self.HistoricoPos = #self.Historico
	if #self.Historico > 30 then
		table.remove(self.Historico, 1)
		self.HistoricoPos = self.HistoricoPos - 1
	end
end

function EditableModel:Desfazer()
	if self.HistoricoPos <= 1 then return false end
	self.HistoricoPos = self.HistoricoPos - 1
	local snap = self.Historico[self.HistoricoPos]
	self.Vertices = snap.Vertices
	self.Triangulos = snap.Triangulos
	return true
end

function EditableModel:Refazer()
	if self.HistoricoPos >= #self.Historico then return false end
	self.HistoricoPos = self.HistoricoPos + 1
	local snap = self.Historico[self.HistoricoPos]
	self.Vertices = snap.Vertices
	self.Triangulos = snap.Triangulos
	return true
end

function EditableModel:AdicionarVertice(pos, normal, uv, cor)
	local v = {
		Pos = pos or Vector3.new(0,0,0),
		Normal = normal or Vector3.new(0,1,0),
		UV = uv or Vector2.new(0,0),
		Cor = cor or Color3.new(1,1,1),
	}
	table.insert(self.Vertices, v)
	return #self.Vertices
end

function EditableModel:AdicionarTriangulo(i1,i2,i3)
	if self.Vertices[i1] and self.Vertices[i2] and self.Vertices[i3] then
		table.insert(self.Triangulos, {i1,i2,i3})
		return #self.Triangulos
	end
	return nil
end

function EditableModel:CalcularNormais()
	-- zera
	for _, v in ipairs(self.Vertices) do v.Normal = Vector3.new(0,0,0) end
	for _, tri in ipairs(self.Triangulos) do
		local v1 = self.Vertices[tri[1]]
		local v2 = self.Vertices[tri[2]]
		local v3 = self.Vertices[tri[3]]
		if v1 and v2 and v3 then
			local e1 = v2.Pos - v1.Pos
			local e2 = v3.Pos - v1.Pos
			local n = e1:Cross(e2)
			if n.Magnitude > 0.0001 then
				n = n.Unit
				v1.Normal = v1.Normal + n
				v2.Normal = v2.Normal + n
				v3.Normal = v3.Normal + n
			end
		end
	end
	for _, v in ipairs(self.Vertices) do
		if v.Normal.Magnitude > 0.0001 then
			v.Normal = v.Normal.Unit
		else
			v.Normal = Vector3.new(0,1,0)
		end
	end
end

function EditableModel:CaixaDelimitadora()
	if #self.Vertices == 0 then return Vector3.new(0,0,0), Vector3.new(0,0,0) end
	local minX, minY, minZ = math.huge, math.huge, math.huge
	local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
	for _, v in ipairs(self.Vertices) do
		minX = math.min(minX, v.Pos.X); maxX = math.max(maxX, v.Pos.X)
		minY = math.min(minY, v.Pos.Y); maxY = math.max(maxY, v.Pos.Y)
		minZ = math.min(minZ, v.Pos.Z); maxZ = math.max(maxZ, v.Pos.Z)
	end
	return Vector3.new(minX,minY,minZ), Vector3.new(maxX,maxY,maxZ)
end

-- ============ RENDER ============
-- Tenta criar EditableMesh (se API existir). Retorna { Mesh, MeshPart } ou nil.
function EditableModel:CriarEditableMesh()
	local ok, AssetService = pcall(function() return game:GetService("AssetService") end)
	if not ok then return nil end
	-- EditableMesh API muda rapido; tentamos duas assinaturas
	local mesh
	local ok1 = pcall(function()
		mesh = AssetService:CreateEditableMesh()
	end)
	if not ok1 or not mesh then return nil end
	-- limpa
	-- adiciona vertices
	local idMap = {} -- indice antigo -> id novo do EditableMesh
	for i, v in ipairs(self.Vertices) do
		local okV, id = pcall(function()
			return mesh:AddVertex(v.Pos)
		end)
		if okV and id then idMap[i] = id end
	end
	-- adiciona triangulos
	for _, tri in ipairs(self.Triangulos) do
		local id1, id2, id3 = idMap[tri[1]], idMap[tri[2]], idMap[tri[3]]
		if id1 and id2 and id3 then
			pcall(function() mesh:AddTriangle(id1, id2, id3) end)
		end
	end
	return mesh
end

-- Fallback: cria Folder com WedgeParts (igual TerrainRender) — funciona em TODO lugar, inclusive Studio Lite
function EditableModel:CriarModeloDePecas(pastaPai, material, cor)
	material = material or Enum.Material.SmoothPlastic
	cor = cor or Color3.fromRGB(200,200,200)
	local folder = Instance.new("Folder")
	folder.Name = self.Nome

	for _, tri in ipairs(self.Triangulos) do
		local v1 = self.Vertices[tri[1]]
		local v2 = self.Vertices[tri[2]]
		local v3 = self.Vertices[tri[3]]
		if v1 and v2 and v3 then
			-- cria triangulo com 2 wedges? Simplificacao: cria Part triangulada via Wedge
			-- Para economizar, cria apenas um WedgePart que aproxima o triangulo
			-- Verdade: WedgePart nao faz triangulo arbitrario perfeito, mas funciona para preview
			local p1, p2, p3 = v1.Pos, v2.Pos, v3.Pos
			local centro = (p1 + p2 + p3)/3
			local tamanho = (p1 - p2).Magnitude
			if tamanho < 0.1 then tamanho = 0.1 end
			local wedge = Instance.new("WedgePart")
			wedge.Anchored = true
			wedge.Material = material
			wedge.Color = v1.Cor or cor
			wedge.Size = Vector3.new(tamanho, 0.2, tamanho)
			wedge.CFrame = CFrame.new(centro)
			wedge.Parent = folder
		end
	end

	if pastaPai then folder.Parent = pastaPai end
	return folder
end

-- Cria MeshPart se EditableMesh existir, senao fallback
function EditableModel:CriarMeshPart(pastaPai)
	local mesh = self:CriarEditableMesh()
	if mesh then
		local ok, AssetService = pcall(function() return game:GetService("AssetService") end)
		if ok then
			local ok2, meshPart = pcall(function()
				return AssetService:CreateMeshPartAsync(Content.fromObject(mesh))
			end)
			if ok2 and meshPart then
				meshPart.Name = self.Nome
				meshPart.Anchored = true
				if pastaPai then meshPart.Parent = pastaPai end
				return meshPart
			end
		end
	end
	-- fallback
	return self:CriarModeloDePecas(pastaPai)
end

-- ============ SERIALIZACAO ============
function EditableModel:Serializar()
	local verts = {}
	for _, v in ipairs(self.Vertices) do
		table.insert(verts, {
			P = { v.Pos.X, v.Pos.Y, v.Pos.Z },
			N = { v.Normal.X, v.Normal.Y, v.Normal.Z },
			UV = { v.UV.X, v.UV.Y },
			C = { math.floor(v.Cor.R*255), math.floor(v.Cor.G*255), math.floor(v.Cor.B*255) },
		})
	end
	return {
		Nome = self.Nome,
		Seed = self.Seed,
		Vertices = verts,
		Triangulos = self.Triangulos,
	}
end

function EditableModel.Deserializar(blob)
	local m = EditableModel.novo(blob.Nome or "Modelo")
	m.Seed = blob.Seed or m.Seed
	for _, v in ipairs(blob.Vertices or {}) do
		local pos = Vector3.new(v.P[1], v.P[2], v.P[3])
		local norm = Vector3.new(v.N[1], v.N[2], v.N[3])
		local uv = Vector2.new(v.UV[1], v.UV[2])
		local cor = Color3.fromRGB(v.C[1], v.C[2], v.C[3])
		m:AdicionarVertice(pos, norm, uv, cor)
	end
	for _, tri in ipairs(blob.Triangulos or {}) do
		m:AdicionarTriangulo(tri[1], tri[2], tri[3])
	end
	return m
end

function EditableModel:Clonar(nome)
	local novo = EditableModel.novo(nome or (self.Nome.."_Clone"))
	novo.Seed = self.Seed
	for _, v in ipairs(self.Vertices) do
		novo:AdicionarVertice(
			Vector3.new(v.Pos.X, v.Pos.Y, v.Pos.Z),
			v.Normal and Vector3.new(v.Normal.X, v.Normal.Y, v.Normal.Z) or Vector3.new(0,1,0),
			v.UV and Vector2.new(v.UV.X, v.UV.Y) or Vector2.new(0,0),
			v.Cor or Color3.new(1,1,1)
		)
	end
	for _, tri in ipairs(self.Triangulos) do
		novo:AdicionarTriangulo(tri[1], tri[2], tri[3])
	end
	-- copia historico parcialmente
	novo.Historico = {}
	novo.HistoricoPos = 0
	novo:SalvarHistorico()
	return novo
end

function EditableModel:Contar()
	return #self.Vertices, #self.Triangulos
end

return EditableModel
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX59134"><Properties><string name="Name">Exporter</string><ProtectedString name="Source"><![CDATA[--[[
	Exporter (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Modeler > Exporter
	============================================================
	F5 — EXPORTADOR DE MODELO PARA RRW (Ring1).

	Transforma EditableModel em ARQUETIPO RRW (conhecimento),
	com receitas D1-D4 automaticas (mesmo padrao dos arquetipos
	nativos Carvalho/CasaVila/etc).

	- Gera archetype definition compativel com Archetypes.Registrar
	- Cria modelo de pecas no Workspace para preview
	- Serializa para marketplace/pacote
	============================================================
]]

local Exporter = {}

function Exporter.ParaArquetipo(nome, modelo, opcoes)
	opcoes = opcoes or {}
	nome = nome or modelo.Nome or "ModeloCustom"
	local categoria = opcoes.Categoria or "Modelos"
	local descricao = opcoes.Descricao or ("Modelo criado no Modelador Arkhe: " .. #modelo.Vertices .. " verts, " .. #modelo.Triangulos .. " tris")

	-- calcula caixa para D1-D4
	local minB, maxB = modelo:CaixaDelimitadora()
	local tamanho = maxB - minB
	local maior = math.max(tamanho.X, tamanho.Y, tamanho.Z)
	if maior < 0.1 then maior = 1 end

	-- receita D1: caixa simples; D2: 2 caixas; D3: mesh se tiver EditableMesh; D4: modelo completo de pecas
	-- Aqui geramos receita como dados, Materializer vai interpretar
	local receita = {
		D1 = {
			Tipo = "Caixa",
			Tamanho = { maior, maior, maior },
			Cor = opcoes.Cor or { 200, 200, 200 },
		},
		D2 = {
			Tipo = "CaixaDetalhe",
			Tamanho = { tamanho.X, tamanho.Y, tamanho.Z },
			Cor = opcoes.Cor or { 200, 200, 200 },
		},
		D3 = {
			Tipo = "ModeloCustom",
			Blob = modelo:Serializar(), -- o Materializer pode reconstruir
		},
		D4 = {
			Tipo = "ModeloCustom",
			Blob = modelo:Serializar(),
		},
	}

	local def = {
		Nome = nome,
		Categoria = categoria,
		Descricao = descricao,
		Comportamento = {
			Queimavel = opcoes.Queimavel or false,
			Flutuante = opcoes.Flutuante or false,
		},
		Fisica = {
			Densidade = opcoes.Densidade or 0.8,
			Inflamabilidade = opcoes.Inflamabilidade or 0.1,
		},
		Receita = receita,
		CriadoEm = os.time(),
		Fonte = "ModeladorArkhe",
		Vertices = #modelo.Vertices,
		Triangulos = #modelo.Triangulos,
	}

	return def
end

function Exporter.RegistrarNoRRW(nome, modelo, opcoes)
	local def = Exporter.ParaArquetipo(nome, modelo, opcoes)
	local ok, Archetypes = pcall(function()
		return require(game:GetService("ReplicatedStorage").Arkhe.RRW.Archetypes)
	end)
	if not ok then return nil, "Archetypes nao encontrado" end
	local ok2, err = pcall(function()
		Archetypes.Registrar(nome, def)
	end)
	if not ok2 then return nil, tostring(err) end
	return def
end

function Exporter.CriarPreviewNoMundo(modelo, pos, pastaPai)
	pos = pos or Vector3.new(0,5,0)
	pastaPai = pastaPai or workspace
	-- cria folder com pecas e move para pos
	local folder = modelo:CriarModeloDePecas(nil)
	if folder then
		-- centraliza
		local minB, maxB = modelo:CaixaDelimitadora()
		local centro = (minB + maxB)/2
		folder:PivotTo(CFrame.new(pos - centro))
		folder.Parent = pastaPai
	end
	return folder
end

function Exporter.ParaMarketplace(nome, modelo, preco, autor)
	local blob = modelo:Serializar()
	return {
		Id = "AKM" .. tostring(math.random(1000,9999)),
		Nome = nome,
		Aba = "Modelos",
		Sub = "Todos",
		Autor = autor or "Dev",
		Gratis = (preco or 0) <= 0,
		Preco = preco or 0,
		Tipo = "ModeloCustom",
		Blob = blob,
		Arquetipo = nome,
	}
end

return Exporter
]]></ProtectedString></Properties></Item>
