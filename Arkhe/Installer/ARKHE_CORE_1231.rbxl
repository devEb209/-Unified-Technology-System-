     <Item class="ModuleScript" referent="RBX613176"><Properties><string name="Name">CurveVisual</string><ProtectedString name="Source"><![CDATA[--[[
	CurveVisual (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Cinematic > CurveVisual
	============================================================
	F17 — CURVAS DESENHADAS NO PREVIEW + EXPORT CLIP
	- Desenha curvas de easing em Canvas (pontos + linhas)
	- Curva: { Nome, Pontos {T, Valor}, Easing, Cor }
	- Operações: AdicionarPonto, MoverPonto, RemoverPonto, Suavizar
	- Export: para AnimationClip + para TimelineVisual + para Spline
	- Integra com CurveEditor + TimelineEditor + CameraSpline
	============================================================
]]

local CurveVisual = {}
CurveVisual.__index = CurveVisual

function CurveVisual.novo(nome, cor)
	local self = setmetatable({}, CurveVisual)
	self.Nome = nome or "Curva_"..math.random(1000,9999)
	self.Cor = cor or Color3.fromRGB(100,200,255)
	self.Pontos = {} -- { T 0-1, Valor 0-1, Easing }
	self.EasingPadrao = "SineInOut"
	self.Suavizacao = 0
	return self
end

function CurveVisual:AdicionarPonto(t, valor, easing)
	t = math.clamp(t, 0, 1)
	valor = math.clamp(valor, 0, 1)
	table.insert(self.Pontos, {
		T=t,
		Valor=valor,
		Easing=easing or self.EasingPadrao,
		Id=#self.Pontos+1,
	})
	table.sort(self.Pontos, function(a,b) return a.T < b.T end)
	return #self.Pontos
end

function CurveVisual:MoverPonto(indice, novoT, novoValor)
	local p = self.Pontos[indice]
	if not p then return false end
	p.T = math.clamp(novoT, 0, 1)
	p.Valor = math.clamp(novoValor, 0, 1)
	table.sort(self.Pontos, function(a,b) return a.T < b.T end)
	return true
end

function CurveVisual:RemoverPonto(indice)
	if not self.Pontos[indice] then return false end
	table.remove(self.Pontos, indice)
	return true
end

function CurveVisual:Suavizar(janela)
	janela = janela or 1
	if #self.Pontos < 3 then return end
	for i=2, #self.Pontos-1 do
		local soma=0; local cnt=0
		for j=-janela, janela do
			if self.Pontos[i+j] then soma=soma+self.Pontos[i+j].Valor; cnt=cnt+1 end
		end
		if cnt>0 then
			self.Pontos[i].Valor = self.Pontos[i].Valor*0.5 + (soma/cnt)*0.5
		end
	end
	self.Suavizacao = self.Suavizacao + 1
end

function CurveVisual:Avaliar(t)
	t = math.clamp(t,0,1)
	if #self.Pontos==0 then return 0 end
	if #self.Pontos==1 then return self.Pontos[1].Valor end
	for i=1, #self.Pontos-1 do
		local p1 = self.Pontos[i]
		local p2 = self.Pontos[i+1]
		if t >= p1.T and t <= p2.T then
			local segT = (t - p1.T) / (p2.T - p1.T)
			-- easing
			local eased = segT
			if p1.Easing == "SineInOut" then
				eased = -(math.cos(math.pi*segT)-1)/2
			elseif p1.Easing == "Linear" then
				eased = segT
			elseif p1.Easing == "QuadIn" then
				eased = segT*segT
			end
			return p1.Valor + (p2.Valor - p1.Valor)*eased
		end
	end
	if t < self.Pontos[1].T then return self.Pontos[1].Valor end
	return self.Pontos[#self.Pontos].Valor
end

function CurveVisual:GerarDesenho(numAmostras, largura, altura)
	numAmostras = numAmostras or 100
	largura = largura or 400
	altura = altura or 200
	local pontos={}
	for i=0, numAmostras do
		local t = i/numAmostras
		local v = self:Avaliar(t)
		table.insert(pontos, {
			X=t*largura,
			Y=altura - v*altura,
			T=t,
			Valor=v,
		})
	end
	return {
		Nome=self.Nome,
		Cor=self.Cor,
		Pontos=pontos,
		Keyframes=self.Pontos,
		Largura=largura,
		Altura=altura,
	}
end

function CurveVisual:ExportarParaClip(nomeTrack)
	return {
		Nome=nomeTrack or self.Nome,
		Pontos=self.Pontos,
		Easing=self.EasingPadrao,
	}
end

function CurveVisual:ExportarParaSpline(spline)
	-- spline: CameraSpline, adiciona pontos com FOV = Valor*100
	if not spline then return 0 end
	local count=0
	for _, p in ipairs(self.Pontos) do
		if spline.AdicionarPonto then
			spline:AdicionarPonto(Vector3.new(p.T*100, p.Valor*20, 0), 60 + p.Valor*30, p.T*5)
			count=count+1
		end
	end
	return count
end

function CurveVisual:Serializar()
	return {
		Nome=self.Nome,
		NumPontos=#self.Pontos,
		Easing=self.EasingPadrao,
		Cor={ R=self.Cor.R, G=self.Cor.G, B=self.Cor.B },
		Pontos=self.Pontos,
	}
end

function CurveVisual.CriarExemplo()
	local cv = CurveVisual.novo("ExemploFOV", Color3.fromRGB(255,150,50))
	cv:AdicionarPonto(0, 0.2, "SineInOut")
	cv:AdicionarPonto(0.3, 0.8, "QuadIn")
	cv:AdicionarPonto(0.7, 0.5, "Linear")
	cv:AdicionarPonto(1.0, 0.3, "SineInOut")
	return cv
end

return CurveVisual
]]></ProtectedString></Properties></Item>
