     <Item class="ModuleScript" referent="RBX127566"><Properties><string name="Name">SnapSystem</string><ProtectedString name="Source"><![CDATA[[[
	SnapSystem (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Modeler > SnapSystem
	============================================================
	F5 — SNAP / RÉGUAS / ALINHAMENTO
	- Snap: grade, vértice, aresta, face, ângulo, escala
	- Réguas: guias visuais X/Y/Z com distância
	- Alinhamento: alinha seleção por eixo
	- Distribuição: espaça igualmente
	- Integra com EditableModel + MultiSelect
	============================================================
]]

local SnapSystem = {}
SnapSystem.__index = SnapSystem

SnapSystem.Modos = {
	Grade = { Desc="Snap na grade (ex: 1 stud)", Tamanho=1 },
	Vertice = { Desc="Snap no vértice mais próximo", Raio=2 },
	Aresta = { Desc="Snap na aresta", Raio=1.5 },
	Face = { Desc="Snap na face", Raio=2 },
	Angulo = { Desc="Snap ângulo 15°", Passo=15 },
	Escala = { Desc="Snap escala 0.1", Passo=0.1 },
}

function SnapSystem.novo()
	local self = setmetatable({}, SnapSystem)
	self.ModoAtivo = "Grade"
	self.TamanhoGrade = 1
	self.AnguloPasso = 15
	self.EscalaPasso = 0.1
	self.RaioVertice = 2
	self.Guias = {} -- { Eixo, Pos, Cor }
	self.Ativo = true
	return self
end

function SnapSystem:DefinirModo(modo, param)
	if SnapSystem.Modos[modo] then
		self.ModoAtivo = modo
		if modo=="Grade" and param then self.TamanhoGrade = param end
		if modo=="Angulo" and param then self.AnguloPasso = param end
		if modo=="Escala" and param then self.EscalaPasso = param end
		return true
	end
	return false
end

function SnapSystem:SnapPos(pos)
	if not self.Ativo then return pos end
	if self.ModoAtivo=="Grade" then
		return Vector3.new(
			math.floor(pos.X / self.TamanhoGrade + 0.5) * self.TamanhoGrade,
			math.floor(pos.Y / self.TamanhoGrade + 0.5) * self.TamanhoGrade,
			math.floor(pos.Z / self.TamanhoGrade + 0.5) * self.TamanhoGrade
		)
	end
	return pos
end

function SnapSystem:SnapAngulo(angulo)
	if self.ModoAtivo=="Angulo" then
		return math.floor(angulo / self.AnguloPasso + 0.5) * self.AnguloPasso
	end
	return angulo
end

function SnapSystem:SnapEscala(escala)
	if self.ModoAtivo=="Escala" then
		return math.floor(escala / self.EscalaPasso + 0.5) * self.EscalaPasso
	end
	return escala
end

function SnapSystem:AdicionarGuia(eixo, pos, cor)
	table.insert(self.Guias, { Eixo=eixo, Pos=pos, Cor=cor or Color3.fromRGB(255,255,0) })
	return #self.Guias
end

function SnapSystem:RemoverGuia(indice)
	if self.Guias[indice] then
		table.remove(self.Guias, indice)
		return true
	end
	return false
end

function SnapSystem:LimparGuias()
	self.Guias={}
end

function SnapSystem:CalcularDistancia(pos1, pos2)
	return (pos1 - pos2).Magnitude
end

function SnapSystem:AlinharSelecao(selecao, eixo, referencia)
	-- selecao: lista de posições
	-- eixo: X/Y/Z
	-- referencia: Min/Centro/Max
	if #selecao < 2 then return selecao end
	local vals={}
	for _, pos in ipairs(selecao) do
		table.insert(vals, pos[eixo])
	end
	table.sort(vals)
	local alvo=0
	if referencia=="Min" then alvo=vals[1]
	elseif referencia=="Max" then alvo=vals[#vals]
	else -- Centro
		alvo = (vals[1]+vals[#vals])/2
	end
	local resultado={}
	for _, pos in ipairs(selecao) do
		local nova = Vector3.new(pos.X, pos.Y, pos.Z)
		if eixo=="X" then nova = Vector3.new(alvo, pos.Y, pos.Z)
		elseif eixo=="Y" then nova = Vector3.new(pos.X, alvo, pos.Z)
		elseif eixo=="Z" then nova = Vector3.new(pos.X, pos.Y, alvo)
		end
		table.insert(resultado, nova)
	end
	return resultado
end

function SnapSystem:ListarModos()
	local lista={}
	for nome, info in pairs(SnapSystem.Modos) do
		table.insert(lista, { Nome=nome, Desc=info.Desc })
	end
	return lista
end

function SnapSystem:Serializar()
	return {
		Modo=self.ModoAtivo,
		TamanhoGrade=self.TamanhoGrade,
		AnguloPasso=self.AnguloPasso,
		EscalaPasso=self.EscalaPasso,
		NumGuias=#self.Guias,
		Ativo=self.Ativo,
	}
end

return SnapSystem
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX483620"><Properties><string name="Name">Subdivision</string><ProtectedString name="Source"><![CDATA[
local Subdivision = {}
function Subdivision.novo() return setmetatable({Levels=2, Tipo="CatmullClark"}, {__index=Subdivision}) end
function Subdivision:Aplicar(mesh) return {Mesh=mesh, Levels=self.Levels, Tris=(mesh.Tris or 100)*(4^self.Levels)} end
function Subdivision:Serializar() return {Levels=self.Levels, Tipo=self.Tipo} end
return Subdivision
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX902410"><Properties><string name="Name">Sweep</string><ProtectedString name="Source"><![CDATA[
local Sweep = {}
function Sweep.novo() return setmetatable({Nome="Sweep", Ativo=true}, {__index=Sweep}) end
