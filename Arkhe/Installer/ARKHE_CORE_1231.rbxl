     <Item class="ModuleScript" referent="RBX772230"><Properties><string name="Name">Retarget</string><ProtectedString name="Source"><![CDATA[--[[
	Retarget (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Animator > Retarget
	============================================================
	F6 — RETARGETING R6 <-> R15 <-> CUSTOM (Ring1).

	Mapeia nomes de ossos entre rigs diferentes para que uma
	animacao feita em um rig funcione em outro.

	Ex: R6 tem "Left Arm", R15 tem "LeftUpperArm"+"LeftLowerArm".
	A Arkhe faz retarget inteligente: se nao ha osso equivalente,
	usa o pai mais proximo e interpola.

	Tambem suporta rigs custom do RigFactory (nomes como "BracoE").
	============================================================
]]

local Retarget = {}

-- Mapas de equivalencia
Retarget.Mapas = {
	-- R6 -> R15
	R6_para_R15 = {
		["Head"] = "Head",
		["Torso"] = "UpperTorso",
		["Left Arm"] = "LeftUpperArm",
		["Right Arm"] = "RightUpperArm",
		["Left Leg"] = "LeftUpperLeg",
		["Right Leg"] = "RightUpperLeg",
		["HumanoidRootPart"] = "HumanoidRootPart",
	},
	R15_para_R6 = {
		["Head"] = "Head",
		["UpperTorso"] = "Torso",
		["LowerTorso"] = "Torso",
		["LeftUpperArm"] = "Left Arm",
		["LeftLowerArm"] = "Left Arm",
		["LeftHand"] = "Left Arm",
		["RightUpperArm"] = "Right Arm",
		["RightLowerArm"] = "Right Arm",
		["RightHand"] = "Right Arm",
		["LeftUpperLeg"] = "Left Leg",
		["LeftLowerLeg"] = "Left Leg",
		["LeftFoot"] = "Left Leg",
		["RightUpperLeg"] = "Right Leg",
		["RightLowerLeg"] = "Right Leg",
		["RightFoot"] = "Right Leg",
		["HumanoidRootPart"] = "HumanoidRootPart",
	},
	-- Custom RigFactory usa nomes em PT-BR as vezes: "Cabeca", "Tronco", "BracoE", etc.
	Custom_para_R6 = {
		["Cabeca"] = "Head",
		["Tronco"] = "Torso",
		["BracoE"] = "Left Arm",
		["BracoD"] = "Right Arm",
		["PernaE"] = "Left Leg",
		["PernaD"] = "Right Leg",
		["Root"] = "HumanoidRootPart",
	},
}

function Retarget.DetectarTipoRig(modelo)
	if not modelo then return "Desconhecido" end
	local hum = modelo:FindFirstChildOfClass("Humanoid")
	if not hum then return "Custom" end
	if hum.RigType == Enum.HumanoidRigType.R15 then return "R15"
	elseif hum.RigType == Enum.HumanoidRigType.R6 then return "R6"
	end
	return "Custom"
end

function Retarget.MapearOsso(nomeOsso, deTipo, paraTipo)
	deTipo = deTipo or "R6"
	paraTipo = paraTipo or "R15"
	local chave = deTipo .. "_para_" .. paraTipo
	local mapa = Retarget.Mapas[chave]
	if mapa and mapa[nomeOsso] then return mapa[nomeOsso] end
	-- tenta reverso
	local chaveRev = paraTipo .. "_para_" .. deTipo
	local mapaRev = Retarget.Mapas[chaveRev]
	if mapaRev then
		-- procura valor -> chave
		for k,v in pairs(mapaRev) do
			if v == nomeOsso then return k end
		end
	end
	-- fallback: mesmo nome
	return nomeOsso
end

-- Retarget de pose inteira: poseOrigem = { [ossoOrigem]=CFrame }, deTipo, paraTipo -> novaPose
function Retarget.RetargetPose(poseOrigem, deTipo, paraTipo)
	local nova = {}
	for ossoOrig, cf in pairs(poseOrigem) do
		local ossoDest = Retarget.MapearOsso(ossoOrig, deTipo, paraTipo)
		-- se ja existe, faz blend (media) para nao sobrescrever abruptamente
		if nova[ossoDest] then
			nova[ossoDest] = nova[ossoDest]:Lerp(cf, 0.5)
		else
			nova[ossoDest] = cf
		end
	end
	return nova
end

-- Retarget de clip inteiro
function Retarget.RetargetClip(clipOrigem, deTipo, paraTipo, novoNome)
	local AnimationClip = require(script.Parent.AnimationClip)
	local blob = clipOrigem:Serializar()
	local novo = AnimationClip.novo(novoNome or (blob.Nome .. "_" .. paraTipo), blob.Duracao)
	novo.Loop = blob.Loop
	for ossoOrig, kfs in pairs(blob.Tracks or {}) do
		local ossoDest = Retarget.MapearOsso(ossoOrig, deTipo, paraTipo)
		for _, kf in ipairs(kfs) do
			local pos = Vector3.new(kf.P[1], kf.P[2], kf.P[3])
			local rot = Vector3.new(kf.R[1], kf.R[2], kf.R[3])
			novo:AdicionarKeyframePosRot(ossoDest, kf.T, pos, rot, kf.E)
		end
	end
	return novo
end

-- Lista ossos esperados por tipo de rig
function Retarget.OssosEsperados(tipo)
	if tipo == "R6" then
		return { "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "HumanoidRootPart" }
	elseif tipo == "R15" then
		return { "Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot", "HumanoidRootPart" }
	else
		return { "Cabeca", "Tronco", "BracoE", "BracoD", "PernaE", "PernaD", "Root" }
	end
end

return Retarget
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX953862"><Properties><string name="Name">RigIK</string><ProtectedString name="Source"><![CDATA[--[[
	RigIK (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Animator > RigIK
	============================================================
	F6 — IK SOLVER DA ARKHE (Ring1).
	Resolve cadeias de ossos para animacao procedural e
	Cascadeur-style physics assist.

	- Resolver2Ossos: IK de 2 ossos (ombro-cotovelo-mao, quadril-joelho-pe)
	- ResolverCadeia: FABRIK para N ossos (coluna, cauda, tentaculo)
	- AplicarEmModelo: aplica pose IK diretamente em Motor6D de R6/R15/custom

	Verdade: IK analitico 2 ossos é exato e barato; FABRIK converge rapido
	para cadeias longas e é melhor que CCD para jogos.
	============================================================
]]

local RigIK = {}

-- IK 2 ossos no plano: origem, alvo, tam1, tam2
-- retorna CFrame do joint meio e CFrame do fim (ou nil se inalcançavel)
function RigIK.Resolver2Ossos(origem, alvo, tam1, tam2, polo)
	origem = origem or Vector3.new(0,0,0)
	alvo = alvo or Vector3.new(0,2,0)
	tam1 = tam1 or 1
	tam2 = tam2 or 1
	polo = polo or Vector3.new(0,0,1) -- direcao do cotovelo/joelho

	local dir = alvo - origem
	local dist = dir.Magnitude
	if dist < 0.001 then return nil end
	if dist > tam1 + tam2 then
		-- alvo inalcançavel: estica reto
		local dirN = dir.Unit
		local meio = origem + dirN * tam1
		return meio, alvo, false
	end
	if dist < math.abs(tam1 - tam2) then
		-- muito perto: dobra
		local dirN = dir.Magnitude > 0.001 and dir.Unit or Vector3.new(0,1,0)
		local meio = origem + dirN * tam1
		return meio, alvo, false
	end

	-- lei dos cossenos
	local a = tam1
	local b = tam2
	local c = dist
	local cosAng = (a*a + c*c - b*b) / (2*a*c)
	cosAng = math.clamp(cosAng, -1, 1)
	local ang = math.acos(cosAng)

	-- base
	local dirN = dir.Unit
	-- encontra perpendicular usando polo
	local eixo = dirN:Cross(polo)
	if eixo.Magnitude < 0.001 then
		eixo = dirN:Cross(Vector3.new(0,1,0))
		if eixo.Magnitude < 0.001 then eixo = dirN:Cross(Vector3.new(1,0,0)) end
	end
	eixo = eixo.Unit

	-- rotaciona dirN em torno de eixo por ang
	local meioDir = CFrame.fromAxisAngle(eixo, ang) * dirN
	local meio = origem + meioDir * tam1

	return meio, alvo, true
end

-- FABRIK: joints = { Vector3, ... } (posicoes), alvo = Vector3, tolerancia, maxIter
-- retorna novas posicoes {Vector3, ...}
function RigIK.ResolverCadeia(joints, alvo, tolerancia, maxIter)
	tolerancia = tolerancia or 0.01
	maxIter = maxIter or 10
	if #joints < 2 then return joints end

	local pos = {}
	for i, p in ipairs(joints) do pos[i] = Vector3.new(p.X, p.Y, p.Z) end

	local tamanhos = {}
	local total = 0
	for i = 1, #pos-1 do
		tamanhos[i] = (pos[i+1] - pos[i]).Magnitude
		total = total + tamanhos[i]
	end

	local origem = pos[1]
	if (alvo - origem).Magnitude > total then
		-- inalcançavel: estica em linha reta
		local dir = (alvo - origem).Unit
		for i = 2, #pos do
			pos[i] = pos[i-1] + dir * tamanhos[i-1]
		end
		return pos
	end

	local iter = 0
	while iter < maxIter do
		-- forward: do fim para origem
		pos[#pos] = alvo
		for i = #pos-1, 1, -1 do
			local dir = (pos[i] - pos[i+1]).Unit
			pos[i] = pos[i+1] + dir * tamanhos[i]
		end
		-- backward: da origem para fim
		pos[1] = origem
		for i = 1, #pos-1 do
			local dir = (pos[i+1] - pos[i]).Unit
			pos[i+1] = pos[i] + dir * tamanhos[i]
		end
		if (pos[#pos] - alvo).Magnitude <= tolerancia then break end
		iter = iter + 1
	end
	return pos
end

-- Aplica pose (tabela osso->CFrame) em um modelo com Motor6D
-- modelo: Model com Motor6D, pose: { [nomeJoint] = CFrame }
-- Retorna quantos joints aplicados
function RigIK.AplicarEmModelo(modelo, pose)
	if not modelo or not pose then return 0 end
	local aplicados = 0
	for _, motor in ipairs(modelo:GetDescendants()) do
		if motor:IsA("Motor6D") then
			local nome = motor.Name
			-- tenta achar por nome exato ou por Part0/Part1
			local cf = pose[nome] or pose[motor.Part0.Name] or pose[motor.Part1.Name]
			if cf then
				-- preserva C0 original? Simplificacao: aplica direto em Transform ou C1
				-- Para R6, usamos Transform se disponivel (Animator)
				-- Aqui aplicamos em C0 para compatibilidade com RigFactory procedural
				if motor:GetAttribute("ArkheIKBaseC0") == nil then
					motor:SetAttribute("ArkheIKBaseC0", true)
					motor:SetAttribute("BaseC0", tostring(motor.C0))
				end
				motor.C0 = motor.C0 * cf
				aplicados = aplicados + 1
			end
		end
	end
	return aplicados
end

-- Cascadeur-style: sugere pose balistica realista para um pulo
-- posInicial, velocidade, gravidade, tempo -> retorna pos
function RigIK.TrajetoriaBalistica(posInicial, velocidade, gravidade, tempo)
	gravidade = gravidade or 196.2
	local gVec = Vector3.new(0, -gravidade, 0)
	return posInicial + velocidade * tempo + gVec * (0.5 * tempo * tempo)
end

-- Sugere pose de ragdoll ativo: dado um modelo, aplica gravidade + mola para cada parte
function RigIK.RagdollAtivoSugerir(modelo, gravidade, rigidez)
	gravidade = gravidade or 196.2
	rigidez = rigidez or 0.5
	local sugestoes = {}
	for _, part in ipairs(modelo:GetDescendants()) do
		if part:IsA("BasePart") then
			-- sugere cair um pouco
			sugestoes[part.Name] = CFrame.new(0, -gravidade * 0.001 * rigidez, 0)
		end
	end
	return sugestoes
end

return RigIK
]]></ProtectedString></Properties></Item>
