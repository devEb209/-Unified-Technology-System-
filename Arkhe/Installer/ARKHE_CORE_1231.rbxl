     <Item class="ModuleScript" referent="RBX297377"><Properties><string name="Name">Quest</string><ProtectedString name="Source"><![CDATA[--[[
	Quest (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Economy > Quest
	============================================================
	F18 — KIT ECONOMIA: QUESTS (Ring1).
	Sistema de missoes com objetivos, recompensas, cadeia.

	- Quest: Nome, Descricao, Objetivos { Tipo, Alvo, Qtd, Atual },
	  Recompensas { Moedas, XP, Itens }, PreRequisitos { QuestId }
	- Tipos objetivo: Coletar, Matar, Visitar, Falar, Construir
	- Eventos: OnProgresso, OnCompleta
	- Integra com EventScript: condicao QuestCompleta, acao DarQuest
	- Serializavel por jogador

	Exemplo:
	  local q = Quest.novo("Lenhador", "Colete 10 madeiras")
	  q:AdicionarObjetivo("Coletar", "Madeira", 10)
	  q:Recompensa({ Moedas=50, Itens={{"Madeira",5}} })
	============================================================
]]

local Quest = {}
Quest.__index = Quest

function Quest.novo(id, nome, descricao)
	local self = setmetatable({}, Quest)
	self.Id = id or ("Q" .. tostring(math.random(1000,9999)))
	self.Nome = nome or id
	self.Descricao = descricao or ""
	self.Objetivos = {} -- { Tipo, Alvo, Qtd, Atual, Desc }
	self.Recompensas = { Moedas=0, XP=0, Itens={} }
	self.PreRequisitos = {} -- [questId]
	self.Completa = false
	self._onProgresso = {}
	self._onCompleta = {}
	return self
end

function Quest:AdicionarObjetivo(tipo, alvo, qtd, desc)
	qtd = qtd or 1
	table.insert(self.Objetivos, { Tipo=tipo, Alvo=alvo, Qtd=qtd, Atual=0, Desc=desc or (tipo .. " " .. alvo .. " x" .. qtd) })
	return self
end

function Quest:Recompensa(recomp)
	recomp = recomp or {}
	self.Recompensas.Moedas = recomp.Moedas or self.Recompensas.Moedas
	self.Recompensas.XP = recomp.XP or self.Recompensas.XP
	self.Recompensas.Itens = recomp.Itens or self.Recompensas.Itens
	return self
end

function Quest:AdicionarPreRequisito(questId)
	table.insert(self.PreRequisitos, questId)
	return self
end

function Quest:Progresso(tipo, alvo, qtd)
	qtd = qtd or 1
	local mudou = false
	for _, obj in ipairs(self.Objetivos) do
		if obj.Tipo == tipo and obj.Alvo == alvo and obj.Atual < obj.Qtd then
			obj.Atual = math.min(obj.Qtd, obj.Atual + qtd)
			mudou = true
		end
	end
	if mudou then
		for _, fn in ipairs(self._onProgresso) do pcall(fn, self) end
		self:VerificarCompleta()
	end
	return mudou
end

function Quest:VerificarCompleta()
	if self.Completa then return true end
	for _, obj in ipairs(self.Objetivos) do if obj.Atual < obj.Qtd then return false end end
	self.Completa = true
	for _, fn in ipairs(self._onCompleta) do pcall(fn, self) end
	return true
end

function Quest:PodeIniciar(questsCompletas)
	questsCompletas = questsCompletas or {}
	for _, pre in ipairs(self.PreRequisitos) do if not questsCompletas[pre] then return false end end
	return true
end

function Quest:Porcentagem()
	if #self.Objetivos==0 then return self.Completa and 100 or 0 end
	local soma=0
	for _, obj in ipairs(self.Objetivos) do soma = soma + (obj.Atual / obj.Qtd) end
	return math.floor((soma / #self.Objetivos)*100)
end

function Quest:OnProgresso(fn) table.insert(self._onProgresso, fn) end
function Quest:OnCompleta(fn) table.insert(self._onCompleta, fn) end

function Quest:Serializar()
	return { Id=self.Id, Nome=self.Nome, Descricao=self.Descricao, Objetivos=self.Objetivos, Recompensas=self.Recompensas, PreRequisitos=self.PreRequisitos, Completa=self.Completa }
end

function Quest.Deserializar(dados)
	local q = Quest.novo(dados.Id, dados.Nome, dados.Descricao)
	q.Objetivos = dados.Objetivos or {}
	q.Recompensas = dados.Recompensas or { Moedas=0, XP=0, Itens={} }
	q.PreRequisitos = dados.PreRequisitos or {}
	q.Completa = dados.Completa or false
	return q
end

-- Gerenciador de quests por jogador
local QuestManager = {}
QuestManager.__index = QuestManager

function QuestManager.novo()
	local self = setmetatable({}, QuestManager)
	self.Ativas = {} -- [id] = Quest
	self.Completas = {} -- [id] = true
	self.Disponiveis = {} -- [id] = Quest template
	return self
end

function QuestManager:RegistrarTemplate(quest)
	self.Disponiveis[quest.Id] = quest
end

function QuestManager:Iniciar(id)
	local template = self.Disponiveis[id]
	if not template then return nil, "nao_existe" end
	if self.Ativas[id] or self.Completas[id] then return nil, "ja_ativa_ou_completa" end
	if not template:PodeIniciar(self.Completas) then return nil, "pre_requisito" end
	local q = Quest.Deserializar(template:Serializar())
	self.Ativas[id]=q
	return q
end

function QuestManager:Progresso(tipo, alvo, qtd)
	for _, q in pairs(self.Ativas) do q:Progresso(tipo, alvo, qtd) end
	-- move completas
	for id, q in pairs(self.Ativas) do if q.Completa then self.Completas[id]=true self.Ativas[id]=nil end end
end

function QuestManager:ListarAtivas()
	local lista={}
	for _, q in pairs(self.Ativas) do table.insert(lista, q:Serializar()) end
	return lista
end

function QuestManager:ListarCompletas()
	local lista={}
	for id in pairs(self.Completas) do table.insert(lista, id) end
	return lista
end

Quest.Manager = QuestManager

return Quest
]]></ProtectedString></Properties></Item>
