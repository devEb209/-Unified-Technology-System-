    Textura="Noise",
    Mobile=true,
    Console=true,
    VR=true,
    PC=true,
    Colaboracao=true,
    Chat=true,
    Marcacao=true,
    PlaceDireto=true,
  }, {__index=UltraSystem1649_Multiplayer})
end
function UltraSystem1649_Multiplayer:Serializar() return {Id=self.Id, Submenus=#self.Submenus} end
return UltraSystem1649_Multiplayer
]]></ProtectedString></Properties></Item>
