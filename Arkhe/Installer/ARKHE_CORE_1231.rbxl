     <Item class="ModuleScript" referent="RBX405374"><Properties><string name="Name">LiveOptimizer</string><ProtectedString name="Source"><![CDATA[[[
	LiveOptimizer (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Optimize > LiveOptimizer
	============================================================
	F13 — AUTO-OTIMIZAÇÃO AO VIVO
	- Monitora frametime + memória + D-O15 pressão
	- Se FPS < 30 por 5s, aplica otimizações progressivas:
	  1) Reduz sombras pequenas
	  2) Desativa partículas distantes
	  3) LOD mais agressivo (Materializer D-O15)
	  4) Reduz MaxEntidadesPorTick Replicator
	  5) Pausa NPCs distantes (brain hiberna)
	- Restaura quando FPS volta > 55
	- Log de ações para Analytics
	============================================================
]]

local LiveOptimizer = {}
LiveOptimizer.__index = LiveOptimizer

function LiveOptimizer.novo()
	local self = setmetatable({}, LiveOptimizer)
	self.Ativo = true
	self.NivelOtimizacao = 0 -- 0=normal, 5=máximo
	self.Historico = {} -- { Quando, FPS, Acao, Nivel }
	self.FPSAlvo = 50
	self.FPSBaixo = 30
	self.FPSAlto = 55
	self.ContadorBaixo = 0
	self.ContadorAlto = 0
	self.UltimaAcao = 0
	return self
end

function LiveOptimizer:RegistrarFrame(fps, memoriaMB, numEntidades)
	fps = fps or 60
	local agora = os.time()
	-- detecta baixo FPS sustentado
	if fps < self.FPSBaixo then
		self.ContadorBaixo = self.ContadorBaixo + 1
		self.ContadorAlto = 0
	else
		self.ContadorBaixo = 0
		if fps > self.FPSAlto then
			self.ContadorAlto = self.ContadorAlto + 1
		else
			self.ContadorAlto = 0
		end
	end

	-- se 5 frames seguidos baixo, aumenta nível
	if self.ContadorBaixo >= 5 and agora - self.UltimaAcao > 3 then
		self:AumentarNivel(fps, "FPS baixo sustentado "..fps)
		self.ContadorBaixo = 0
		self.UltimaAcao = agora
	elseif self.ContadorAlto >= 10 and self.NivelOtimizacao > 0 and agora - self.UltimaAcao > 5 then
		self:DiminuirNivel(fps, "FPS recuperado "..fps)
		self.ContadorAlto = 0
		self.UltimaAcao = agora
	end
end

function LiveOptimizer:AumentarNivel(fps, motivo)
	if self.NivelOtimizacao >= 5 then return end
	self.NivelOtimizacao = self.NivelOtimizacao + 1
	local acoes = {
		[1]="Sombras pequenas OFF",
		[2]="Particulas distantes OFF (>150 studs)",
		[3]="LOD agressivo D-O15 (MaxEntidades 120->60)",
		[4]="NPCs distantes hibernados (>200 studs)",
		[5]="Audio 3D raio reduzido 50%, Reverb OFF",
	}
	local acao = acoes[self.NivelOtimizacao] or "Otimização nível "..self.NivelOtimizacao
	table.insert(self.Historico, {
		Quando=os.time(),
		FPS=fps,
		Acao=acao,
		Nivel=self.NivelOtimizacao,
		Motivo=motivo,
	})
	if #self.Historico > 50 then table.remove(self.Historico,1) end
	return acao
end

function LiveOptimizer:DiminuirNivel(fps, motivo)
	if self.NivelOtimizacao <= 0 then return end
	self.NivelOtimizacao = self.NivelOtimizacao - 1
	table.insert(self.Historico, {
		Quando=os.time(),
		FPS=fps,
		Acao="Restaura nível "..self.NivelOtimizacao,
		Nivel=self.NivelOtimizacao,
		Motivo=motivo,
	})
	if #self.Historico > 50 then table.remove(self.Historico,1) end
	return self.NivelOtimizacao
end

function LiveOptimizer:AplicarNoMundo(world, replicator, npcRegistro)
	-- aplica otimizações conforme nível
	local cfg = {
		Sombras = self.NivelOtimizacao < 1,
		ParticulasDistantes = self.NivelOtimizacao < 2,
		MaxEntidades = self.NivelOtimizacao >= 3 and 60 or 120,
		NPCsHibernados = self.NivelOtimizacao >= 4,
		AudioRaio = self.NivelOtimizacao >= 5 and 0.5 or 1.0,
	}
	if replicator then
		replicator.MaxEntidadesPorTick = cfg.MaxEntidades
	end
	return cfg
end

function LiveOptimizer:ListarHistorico(n)
	n = n or 10
	local lista={}
	for i=math.max(1, #self.Historico-n+1), #self.Historico do
		table.insert(lista, self.Historico[i])
	end
	return lista
end

function LiveOptimizer:Serializar()
	return {
		Ativo=self.Ativo,
		Nivel=self.NivelOtimizacao,
		FPSAlvo=self.FPSAlvo,
		HistoricoRecente=self:ListarHistorico(5),
		TotalAcoes=#self.Historico,
	}
end

return LiveOptimizer
]]></ProtectedString></Properties></Item>
