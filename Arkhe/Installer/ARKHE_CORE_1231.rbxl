     <Item class="ModuleScript" referent="RBX836539"><Properties><string name="Name">DockUI</string><ProtectedString name="Source"><![CDATA[--[[
	DockUI (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > DockUI
	============================================================
	O framework de janelas da GENESIS (frontend da Arkhe):
	 - Paineis dockaveis, arrastaveis, minimizaveis e fechaveis
	 - Barra de tarefas (taskbar) com os paineis abertos
	 - 100% touch-friendly: alcas grandes, arrasto por toque
	 - Adaptacao automatica: em telas pequenas os paineis abrem
	   em tela cheia com abas (modo Mobile)
	 - Tema Arkhe (indigo/dourado) customizavel via Kernel (Ring1!)
	============================================================
]]

local UserInputService = game:GetService("UserInputService")

local DockUI = {}
DockUI.Tema = {
	Fundo = Color3.fromRGB(16, 14, 24),
	Painel = Color3.fromRGB(28, 25, 40),
	Cabecalho = Color3.fromRGB(38, 33, 56),
	Destaque = Color3.fromRGB(212, 175, 55),
	Texto = Color3.fromRGB(235, 232, 245),
	TextoFraco = Color3.fromRGB(150, 145, 170),
	Perigo = Color3.fromRGB(200, 70, 70),
}
DockUI.Paineis = {}
DockUI.ModoMobile = false

local function novo(classe, props, pai)
	local i = Instance.new(classe)
	for k, v in pairs(props) do
		i[k] = v
	end
	i.Parent = pai
	return i
end

local function canto(inst, r)
	novo("UICorner", { CornerRadius = UDim.new(0, r or 8) }, inst)
end

function DockUI.Iniciar(playerGui)
	DockUI.ModoMobile = UserInputService.TouchEnabled
		and workspace.CurrentCamera.ViewportSize.X < 900

	local gui = novo("ScreenGui", {
		Name = "ArkheGenesis", ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, playerGui)
	DockUI.Gui = gui

	-- taskbar
	local taskbar = novo("Frame", {
		Name = "Taskbar",
		Size = UDim2.new(1, 0, 0, 42),
		Position = UDim2.new(0, 0, 1, -42),
		BackgroundColor3 = DockUI.Tema.Fundo,
		BackgroundTransparency = 0.1,
	}, gui)
	novo("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 4),
		VerticalAlignment = Enum.VerticalAlignment.Center,
	}, taskbar)
	novo("UIPadding", { PaddingLeft = UDim.new(0, 6) }, taskbar)
	DockUI.Taskbar = taskbar

	local marca = novo("TextLabel", {
		Text = "⟁ ARKHE", Size = UDim2.new(0, 92, 0, 32),
		BackgroundTransparency = 1, TextColor3 = DockUI.Tema.Destaque,
		Font = Enum.Font.GothamBold, TextScaled = true,
	}, taskbar)
	novo("UITextSizeConstraint", { MaxTextSize = 18 }, marca)

	return gui
end

-- ============ PAINEL ============
function DockUI.CriarPainel(opcoes)
	local titulo = opcoes.Titulo or "Painel"
	local painel = {}

	local largura = opcoes.Largura or 330
	local altura = opcoes.Altura or 420

	local frame = novo("Frame", {
		Name = "Painel_" .. titulo,
		Size = DockUI.ModoMobile and UDim2.new(1, 0, 1, -42) or UDim2.new(0, largura, 0, altura),
		Position = DockUI.ModoMobile and UDim2.new(0, 0, 0, 0)
			or (opcoes.Posicao or UDim2.new(0.5, -largura / 2, 0.5, -altura / 2)),
		BackgroundColor3 = DockUI.Tema.Painel,
		Visible = false,
		Active = true,
	}, DockUI.Gui)
	canto(frame, 10)

	-- cabecalho (alca de arrasto)
	local cab = novo("Frame", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = DockUI.Tema.Cabecalho,
	}, frame)
	canto(cab, 10)
	local lblTitulo = novo("TextLabel", {
		Text = titulo, Size = UDim2.new(1, -84, 1, 0), Position = UDim2.new(0, 12, 0, 0),
		BackgroundTransparency = 1, TextColor3 = DockUI.Tema.Texto,
		Font = Enum.Font.GothamBold, TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, cab)
	novo("UITextSizeConstraint", { MaxTextSize = 16 }, lblTitulo)

	local btnMin = novo("TextButton", {
		Text = "—", Size = UDim2.new(0, 32, 0, 28), Position = UDim2.new(1, -72, 0, 4),
		BackgroundColor3 = DockUI.Tema.Painel, TextColor3 = DockUI.Tema.Texto,
		Font = Enum.Font.GothamBold, TextScaled = true,
	}, cab)
	canto(btnMin, 6)
	local btnFechar = novo("TextButton", {
		Text = "X", Size = UDim2.new(0, 32, 0, 28), Position = UDim2.new(1, -36, 0, 4),
		BackgroundColor3 = DockUI.Tema.Perigo, TextColor3 = DockUI.Tema.Texto,
		Font = Enum.Font.GothamBold, TextScaled = true,
	}, cab)
	canto(btnFechar, 6)

	-- corpo com scroll
	local corpo = novo("ScrollingFrame", {
		Size = UDim2.new(1, -12, 1, -46), Position = UDim2.new(0, 6, 0, 40),
		BackgroundTransparency = 1, ScrollBarThickness = 6,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, frame)
	novo("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, corpo)

	-- arrasto (mouse E toque) — desativado no modo mobile (tela cheia)
	if not DockUI.ModoMobile then
		local arrastando, inicioInput, inicioPos = false, nil, nil
		cab.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				arrastando = true
				inicioInput = input.Position
				inicioPos = frame.Position
			end
		end)
		cab.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				arrastando = false
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if arrastando and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - inicioInput
				frame.Position = UDim2.new(
					inicioPos.X.Scale, inicioPos.X.Offset + delta.X,
					inicioPos.Y.Scale, inicioPos.Y.Offset + delta.Y)
			end
		end)
	end

	-- botao na taskbar
	local btnTask = novo("TextButton", {
		Text = titulo, Size = UDim2.new(0, 96, 0, 32),
		BackgroundColor3 = DockUI.Tema.Painel, TextColor3 = DockUI.Tema.TextoFraco,
		Font = Enum.Font.Gotham, TextScaled = true,
	}, DockUI.Taskbar)
	canto(btnTask, 6)
	novo("UITextSizeConstraint", { MaxTextSize = 14 }, btnTask)

	-- comportamento
	local function atualizarTask()
		btnTask.TextColor3 = frame.Visible and DockUI.Tema.Destaque or DockUI.Tema.TextoFraco
	end
	local function alternar(visivel)
		if visivel == nil then
			visivel = not frame.Visible
		end
		if visivel and DockUI.ModoMobile then
			-- mobile: um painel por vez (tela cheia)
			for _, p in pairs(DockUI.Paineis) do
				if p.Frame ~= frame then
					p.Frame.Visible = false
					p.AtualizarTask()
				end
			end
		end
		frame.Visible = visivel
		atualizarTask()
		if visivel and opcoes.AoAbrir then
			task.spawn(opcoes.AoAbrir, painel)
		end
	end

	btnTask.MouseButton1Click:Connect(function() alternar() end)
	btnMin.MouseButton1Click:Connect(function() alternar(false) end)
	btnFechar.MouseButton1Click:Connect(function() alternar(false) end)

	painel.Frame = frame
	painel.Corpo = corpo
	painel.Alternar = alternar
	painel.AtualizarTask = atualizarTask
	painel.Titulo = titulo

	-- ============ HELPERS DE CONTEUDO ============
	function painel.Limpar()
		for _, filho in ipairs(corpo:GetChildren()) do
			if filho:IsA("GuiObject") then
				filho:Destroy()
			end
		end
	end
	function painel.Texto(txt, cor)
		local l = novo("TextLabel", {
			Text = txt, Size = UDim2.new(1, -8, 0, 26), BackgroundTransparency = 1,
			TextColor3 = cor or DockUI.Tema.Texto, Font = Enum.Font.Gotham,
			TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
		}, corpo)
		novo("UITextSizeConstraint", { MaxTextSize = 14 }, l)
		return l
	end
	function painel.Botao(txt, cb, cor)
		local b = novo("TextButton", {
			Text = txt, Size = UDim2.new(1, -8, 0, 36),
			BackgroundColor3 = cor or DockUI.Tema.Cabecalho,
			TextColor3 = DockUI.Tema.Texto, Font = Enum.Font.GothamBold, TextScaled = true,
		}, corpo)
		canto(b, 6)
		novo("UITextSizeConstraint", { MaxTextSize = 14 }, b)
		b.MouseButton1Click:Connect(cb)
		return b
	end
	function painel.Campo(placeholder)
		local t = novo("TextBox", {
			PlaceholderText = placeholder, Text = "",
			Size = UDim2.new(1, -8, 0, 34), BackgroundColor3 = DockUI.Tema.Fundo,
			TextColor3 = DockUI.Tema.Texto, Font = Enum.Font.Gotham, TextScaled = true,
			ClearTextOnFocus = false,
		}, corpo)
		canto(t, 6)
		novo("UITextSizeConstraint", { MaxTextSize = 14 }, t)
		return t
	end
	-- barra de abas horizontais (para submenus da Toolbox etc.)
	function painel.Abas(nomes, aoTrocar)
		local barra = novo("Frame", {
			Size = UDim2.new(1, -8, 0, 34), BackgroundTransparency = 1,
		}, corpo)
		novo("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4),
		}, barra)
		for _, nome in ipairs(nomes) do
			local b = novo("TextButton", {
				Text = nome, Size = UDim2.new(0, math.max(64, 300 / #nomes), 1, 0),
				BackgroundColor3 = DockUI.Tema.Fundo, TextColor3 = DockUI.Tema.TextoFraco,
				Font = Enum.Font.Gotham, TextScaled = true,
			}, barra)
			canto(b, 6)
			novo("UITextSizeConstraint", { MaxTextSize = 13 }, b)
			b.MouseButton1Click:Connect(function()
				for _, outro in ipairs(barra:GetChildren()) do
					if outro:IsA("TextButton") then
						outro.TextColor3 = DockUI.Tema.TextoFraco
					end
				end
				b.TextColor3 = DockUI.Tema.Destaque
				aoTrocar(nome)
			end)
		end
		return barra
	end

	DockUI.Paineis[titulo] = painel
	atualizarTask()
	return painel
end

return DockUI
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX82097"><Properties><string name="Name">ExplorerDynamic</string><ProtectedString name="Source"><![CDATA[
local ExplorerDynamic = {}
function ExplorerDynamic.novo()
  return setmetatable({
    Servicos={
      {Nome="Workspace", Icone="[WORLD]", Cor={R=100,G=100,B=255}, Custom=false},
      {Nome="ReplicatedStorage", Icone="[PKG]", Cor={R=255,G=200,B=0}, Custom=false},
      {Nome="ServerScriptService", Icone="[PHYS]", Cor={R=255,G=100,B=100}, Custom=false},
      {Nome="StarterPlayer", Icone="[PLAYER]", Cor={R=100,G=255,B=100}, Custom=false},
      -- NOSSOS SERVIÇOS CUSTOM
      {Nome="ArkheRealidade", Icone="[ARKHE]", Cor={R=74,G=0,B=224}, Custom=true, Desc="RRW Mundo como dados puros"},
      {Nome="ArkheTerrain", Icone="[TERRAIN]", Cor={R=34,G=139,B=34}, Custom=true, Desc="Terrain próprio 40 sistemas"},
      {Nome="ArkheModeler", Icone="[MODEL]", Cor={R=255,G=140,B=0}, Custom=true, Desc="Modeler Blender-level 40 sistemas"},
      {Nome="ArkheAnimator", Icone="[ANIM]", Cor={R=255,G=0,B=128}, Custom=true, Desc="Animator Cascadeur+Blender 35 sistemas"},
      {Nome="ArkheNPC", Icone="[NPC]", Cor={R=0,G=200,B=200}, Custom=true, Desc="NPC generator 30 sistemas"},
      {Nome="ArkhePhysica", Icone="[PHYS]", Cor={R=150,G=150,B=150}, Custom=true, Desc="Physica presets 30 sistemas"},
      {Nome="ArkheVisual", Icone="[VISUAL]", Cor={R=200,G=100,B=255}, Custom=true, Desc="Visual PBR+ 30 sistemas"},
      {Nome="ArkheAudio", Icone="[AUDIO]", Cor={R=255,G=200,B=100}, Custom=true, Desc="Audio 3D+Occlusion 25 sistemas"},
      {Nome="ArkheMarketplace", Icone="[SHOP]", Cor={R=0,G=200,B=0}, Custom=true, Desc="Marketplace próprio"},
      {Nome="ArkheOptimize", Icone="[OPTIM]", Cor={R=255,G=255,B=0}, Custom=true, Desc="Auto-otimizador"},
      {Nome="ArkheMultiplayer", Icone="[MULTI]", Cor={R=0,G=150,B=255}, Custom=true, Desc="Multiplayer 25 sistemas"},
      {Nome="ArkheAnalytics", Icone="[ANALYT]", Cor={R=255,G=100,B=200}, Custom=true, Desc="Analytics heatmap"},
      {Nome="ArkheEconomy", Icone="[ECON]", Cor={R=255,G=215,B=0}, Custom=true, Desc="Economia 25 sistemas"},
    },
    Itens={},
    Filtro="",
    Ordenacao="Nome",
    Expandidos={},
  }, {__index=ExplorerDynamic})
end
function ExplorerDynamic:AdicionarServico(nome, icone, cor, desc)
  table.insert(self.Servicos, {Nome=nome, Icone=icone, Cor=cor, Custom=true, Desc=desc})
end
function ExplorerDynamic:ListarServicos() return self.Servicos end
function ExplorerDynamic:ListarCustom() local r={} for _, s in ipairs(self.Servicos) do if s.Custom then table.insert(r,s) end end return r end
function ExplorerDynamic:Buscar(filtro) self.Filtro=filtro; local res={} for _, s in ipairs(self.Servicos) do if string.find(string.lower(s.Nome), string.lower(filtro)) then table.insert(res,s) end end return res end
function ExplorerDynamic:Serializar() return {TotalServicos=#self.Servicos, Custom=self:ContarCustom()} end
function ExplorerDynamic:ContarCustom() local n=0 for _, s in ipairs(self.Servicos) do if s.Custom then n=n+1 end end return n end
return ExplorerDynamic
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX435004"><Properties><string name="Name">FileExplorer</string><ProtectedString name="Source"><![CDATA[
