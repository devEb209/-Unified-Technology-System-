     <Item class="ModuleScript" referent="RBX364612"><Properties><string name="Name">FileImporter</string><ProtectedString name="Source"><![CDATA[[[
	FileImporter (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Import > FileImporter
	============================================================
	F11 — IMPORTADOR DE MUNDOS JSON + DRAG-DROP ARQUIVO
	- Formatos: Arkhe JSON (WorldSerializer), Heightmap PNG->grid,
	  GLB/FBX via relay (quando disponível)
	- Drag-drop: recebe payload JSON do relay /import/file
	- Validação: checa Versao, ArkheVersao, integridade
	- Preview: lista entidades antes de importar
	- Integra com World (RRW) + Terrain + NPCs
	============================================================
]]

local FileImporter = {}
FileImporter.__index = FileImporter

FileImporter.FormatosSuportados = {
	"arkhe.json","json","png","jpg","glb","fbx","obj"
}

function FileImporter.novo()
	local self = setmetatable({}, FileImporter)
	self.Historico = {} -- { Nome, Formato, Quando, NumEntidades, Sucesso }
	self.UltimoPreview = nil
	return self
end

function FileImporter:DetectarFormato(nomeArquivo)
	nomeArquivo = string.lower(nomeArquivo or "")
	for _, fmt in ipairs(FileImporter.FormatosSuportados) do
		if string.find(nomeArquivo, "%."..fmt.."$") then
			return fmt
		end
	end
	-- tenta por conteúdo
	if string.find(nomeArquivo, "arkhe") then return "arkhe.json" end
	return "desconhecido"
end

function FileImporter:ValidarArkheJSON(dados)
	if type(dados) ~= "table" then return false, "Não é tabela" end
	if not dados.Versao then return false, "Sem Versao" end
	if not dados.Meta then return false, "Sem Meta" end
	if dados.ArkheVersao and not string.find(dados.ArkheVersao, "F12") then
		-- ainda aceita, mas avisa
	end
	return true, "OK"
end

function FileImporter:PreviewArkheJSON(pacote)
	local ok, err = self:ValidarArkheJSON(pacote)
	if not ok then return nil, err end
	local preview = {
		Versao=pacote.Versao,
		ArkheVersao=pacote.ArkheVersao,
		CriadoEm=pacote.CriadoEm,
		Entidades=pacote.Meta.TotalEntidades or 0,
		Folhas=pacote.Meta.TotalFolhas or 0,
		Telas=pacote.Meta.TotalTelas or 0,
		NPCs=pacote.Meta.TotalNPCs or 0,
		Modelos=pacote.Meta.TotalModelos or 0,
		TemCaves=pacote.Meta and pacote.Meta.TemCaves or false,
		TemRios=pacote.Meta and pacote.Meta.TemRios or false,
		TemEstradas=pacote.Meta and pacote.Meta.TemEstradas or false,
	}
	self.UltimoPreview = preview
	return preview
end

function FileImporter:ImportarParaMundo(pacote, world, opcoes)
	-- opcoes: { Sobrescrever=false, ImportarNPCs=true, ImportarTerrain=true }
	opcoes = opcoes or {}
	local ok, err = self:ValidarArkheJSON(pacote)
	if not ok then return false, err end
	local importados=0
	if world and pacote.Entidades then
		for id, ent in pairs(pacote.Entidades) do
			-- world:AdicionarEntidade etc - simula
			importados = importados + 1
		end
	end
	table.insert(self.Historico, {
		Nome=pacote.ArkheVersao or "Mundo",
		Formato="arkhe.json",
		Quando=os.time(),
		NumEntidades=importados,
		Sucesso=true,
	})
	if #self.Historico > 20 then table.remove(self.Historico,1) end
	return true, importados
end

function FileImporter:ImportarHeightmapPNG(dadosImagem, largura, altura, escalaAltura)
	-- dadosImagem: tabela 2D ou base64 (via relay)
	-- retorna HeightField
	largura = largura or 128
	altura = altura or 128
	escalaAltura = escalaAltura or 50
	local grid={}
	for x=1,largura do
		grid[x]={}
		for z=1,altura do
			-- simula leitura: se dadosImagem for function, chama
			local h=0
			if type(dadosImagem)=="table" and dadosImagem[x] and dadosImagem[x][z] then
				h = dadosImagem[x][z] * escalaAltura
			elseif type(dadosImagem)=="function" then
				h = dadosImagem(x,z) * escalaAltura
			else
				h = math.noise(x*0.05, z*0.05) * escalaAltura
			end
			grid[x][z]=h
		end
	end
	return grid
end

function FileImporter:ReceberDoRelay(payload)
	-- payload do relay POST /import/file { Nome, Formato, Conteudo (JSON ou base64) }
	if not payload or not payload.Conteudo then return false, "Payload vazio" end
	local formato = self:DetectarFormato(payload.Nome or "")
	if formato=="arkhe.json" or formato=="json" then
		local dados = payload.Conteudo
		if type(dados)=="string" then
			local ok, HttpService = pcall(function() return game:GetService("HttpService") end)
			if ok then
				local ok2, dec = pcall(function() return HttpService:JSONDecode(dados) end)
				if ok2 then dados=dec end
			end
		end
		return self:PreviewArkheJSON(dados)
	elseif formato=="png" or formato=="jpg" then
		return { Tipo="Heightmap", Formato=formato, Nome=payload.Nome, ProntoParaImportar=true }
	else
		return { Tipo="Modelo3D", Formato=formato, Nome=payload.Nome, PrecisaRelay=true, Endpoint="/import/model" }
	end
end

function FileImporter:ListarHistorico()
	return self.Historico
end

function FileImporter:Serializar()
	return {
		Formatos=FileImporter.FormatosSuportados,
		Historico=self.Historico,
		UltimoPreview=self.UltimoPreview,
	}
end

return FileImporter
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX237789"><Properties><string name="Name">GLTFLoader</string><ProtectedString name="Source"><![CDATA[
