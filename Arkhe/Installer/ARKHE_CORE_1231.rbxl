     <Item class="ModuleScript" referent="RBX492041"><Properties><string name="Name">TopbarButtons</string><ProtectedString name="Source"><![CDATA[
local TopbarButtons = {}
TopbarButtons.BotoesPadrao={
  {Id="arquivo", Texto="ARQUIVO", Icone="[FILE]", Submenu={"Novo Place","Abrir","Salvar","Salvar Como","Publicar","Configurações"}},
  {Id="editar", Texto="EDITAR", Icone="[EDIT]", Submenu={"Desfazer","Refazer","Copiar","Colar","Duplicar","Deletar","Selecionar Tudo"}},
  {Id="exibir", Texto="EXIBIR", Icone="[VIEW]", Submenu={"Explorer","Propriedades","Toolbox","Output","Console","Viewport","Material Manager"}},
  {Id="inserir", Texto="INSERIR", Icone="[ADD]", Submenu={"Parte","Modelo","Script","ModuleScript","LocalScript","Folder","Partícula","Som","Luz"}},
  {Id="terreno", Texto="TERRENO", Icone="[TERRAIN]", Submenu={"Editor","Biomas","Cavernas","Rios","Estradas","Vegetação","Erosão","Clima","Oceano","Voxel"}},
  {Id="modelagem", Texto="MODELAGEM", Icone="[MODEL]", Submenu={"Primitivas","Sculpt","CSG","Boolean","Bevel","Extrude","Mirror","Array","Subdivision","Rig Auto"}},
  {Id="animacao", Texto="ANIMAÇÃO", Icone="[ANIM]", Submenu={"Timeline","CurveEditor","BlendSpace","MoCap","IK","Retarget","Preview"}},
  {Id="npc", Texto="NPC", Icone="[NPC]", Submenu={"Criar NPC","Dialogue","Multidão","TexturePaint","BehaviorTree","Factions"}},
  {Id="fisica", Texto="FÍSICA", Icone="[PHYS]", Submenu={"Presets","Destruição","Veículo","Tecido","Fluido","Restrições"}},
  {Id="visual", Texto="VISUAL", Icone="[VISUAL]", Submenu={"PBR","Probes","DayNight","Fog","Bloom","SSAO","SSR","ColorGrading"}},
  {Id="ui", Texto="UI", Icone="[UI]", Submenu={"UIKit","DragDrop","Topbar","MenuBar","VRUI","Temas","Gradiente"}},
  {Id="audio", Texto="ÁUDIO", Icone="[AUDIO]", Submenu={"Mixer","3D","Reverb","Occlusion","Música","VoiceChat"}},
  {Id="import", Texto="IMPORT", Icone="[IMPORT]", Submenu={"FBX","GLB","OBJ","Heightmap","Binário"}},
  {Id="publicar", Texto="PUBLICAR", Icone="[PUBLISH]", Submenu={"Novo Place","Salvar Versão","Publicar Jogo","Marketplace","Export CSV"}},
  {Id="otimizar", Texto="OTIMIZAR", Icone="[OPTIM]", Submenu={"Analyzer","LiveOpt","AutoRestore","Occlusion","Batching"}},
  {Id="multiplayer", Texto="MULTIPLAYER", Icone="[MULTI]", Submenu={"Lobby","Matchmaking","AntiCheat","Rollback"}},
  {Id="economia", Texto="ECONOMIA", Icone="[ECON]", Submenu={"Loja","Quests","Banco","Trade","BattlePass","Gacha"}},
  {Id="cinematica", Texto="CINEMÁTICA", Icone="[CINE]", Submenu={"Spline","Timeline","ClipExporter","PreviewRender"}},
  {Id="acessibilidade", Texto="ACESSIBILIDADE", Icone="[ACCESS]", Submenu={"ScreenReader","Legendas","AutoCaption","Contraste"}},
  {Id="analytics", Texto="ANALYTICS", Icone="[ANALYT]", Submenu={"Heatmap","Funnel","Canvas","ExportCSV"}},
  {Id="educacao", Texto="EDUCAÇÃO", Icone="[EDU]", Submenu={"Tutorial","SkillTree","WhyMode"}},
  {Id="vr", Texto="VR/CONSOLE", Icone="[VR]", Submenu={"HandTracking","Teleport","Grab","Gamepad"}},
}
function TopbarButtons.novo() return setmetatable({Botoes=TopbarButtons.BotoesPadrao}, {__index=TopbarButtons}) end
function TopbarButtons:Listar() return self.Botoes end
function TopbarButtons:ContarFuncoes()
  local total=0
  for _, b in ipairs(self.Botoes) do total=total+1+#b.Submenu end
  return total
end
function TopbarButtons:Serializar() return {TotalTopbar=#self.Botoes, TotalFuncoes=self:ContarFuncoes()} end
return TopbarButtons
]]></ProtectedString></Properties></Item>
