     <Item class="ModuleScript" referent="RBX66844"><Properties><string name="Name">GameConfigMenu</string><ProtectedString name="Source"><![CDATA[
local GameConfigMenu = {}
function GameConfigMenu.novo()
  return setmetatable({
    Abas={
      {Nome="Geral", Icone="⚙️", Funcoes={"Nome do Jogo","Descricao","Genero","Max Players","Privacidade"}},
      {Nome="Seguranca", Icone="🔒", Funcoes={"Ativar HttpService","Ativar LoadString","Ativar Studio API","Filtrar Chat","AntiCheat","Moderacao"}},
      {Nome="Performance", Icone="⚡", Funcoes={"Orcamento D-O15","Fidelidade Max","Distancia Render","AutoRestore","LiveOptimizer","OcclusionCulling"}},
      {Nome="Mundo", Icone="🌍", Funcoes={"Bioma Padrao","Clima","Ciclo Dia/Noite","Gravidade","Vento","Oceano","Neve","Lava"}},
      {Nome="Audio", Icone="🔊", Funcoes={"Volume Master","Musica","Efeitos","VoiceChat","Occlusion","Reverb"}},
      {Nome="Multiplayer", Icone="🌐", Funcoes={"Lobby","Matchmaking","CrossServer","Rollback","ClientPrediction"}},
      {Nome="Economia", Icone="💰", Funcoes={"Moeda","Loja","Trade","Banco","BattlePass","Gacha"}},
      {Nome="Visual", Icone="🎨", Funcoes={"Preset Visual","Bloom","SSAO","SSR","Fog","ColorGrading","Logo"}},
      {Nome="Controles", Icone="🎮", Funcoes={"Gamepad","Mobile","VR","HandTracking","Remap","Sensibilidade"}},
      {Nome="Publicacao", Icone="🚀", Funcoes={"Criar Place","Publicar Jogo","Versao","Marketplace","Analytics"}},
    },
    Configs={
      HttpService=false,
      LoadString=false,
      StudioAPI=false,
      MaxPlayers=10,
      Orcamento=1000,
      Fidelidade=4,
    }
  }, {__index=GameConfigMenu})
end

function GameConfigMenu:AtivarHttpService()
  self.Configs.HttpService=true
  -- tenta ativar de verdade
  local HttpService=game:GetService("HttpService")
  local ok=pcall(function() HttpService.HttpEnabled=true end)
  return ok, self.Configs.HttpService
end

function GameConfigMenu:DesativarHttpService() self.Configs.HttpService=false return true end
function GameConfigMenu:StatusHttp() return self.Configs.HttpService end

function GameConfigMenu:ListarAbas() return self.Abas end
function GameConfigMenu:ContarFuncoes()
  local total=0
  for _, aba in ipairs(self.Abas) do total=total+#aba.Funcoes end
  return total
end
function GameConfigMenu:Serializar() return {TotalAbas=#self.Abas, TotalFuncoes=self:ContarFuncoes(), HttpAtivo=self.Configs.HttpService} end
return GameConfigMenu
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX377913"><Properties><string name="Name">GenesisPanels</string><ProtectedString name="Source"><![CDATA[--[[
	GenesisPanels (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > GenesisPanels
	============================================================
	Os paineis nativos da GENESIS (todos Ring1 — o dev pode
	substituir/estender qualquer um via Kernel!):

	 1. EXPLORER dinamico — a arvore do RRW (nao do Workspace!):
	    entidades agrupadas por categoria, busca, selecao.
	 2. PROPERTIES dinamico — reflete o ESTADO SEMANTICO da
	    entidade (integridade, temperatura, chamas...) editavel,
	    e plugins adicionam secoes proprias.
	 3. TOOLBOX propria — abas + submenus por categoria, catalogo
	    Arkhe (gratis/a venda) + caixa de ID da Toolbox do ROBLOX.
	 4. CHAT DA IA — dockavel, minimizavel, com Modo Autonomo
	    (a IA assume o volante sem fugir do projeto).
	 5. EVENTSCRIPT — folhas Quando/Faca visuais.
	============================================================
]]

local GenesisPanels = {}

function GenesisPanels.Construir(DockUI, remotes, Kernel)
	local P = {}
	local selecionadaId = nil

	-- ============ 1) EXPLORER ============
	P.Explorer = DockUI.CriarPainel({
		Titulo = "Explorer", Largura = 300, Altura = 460,
		Posicao = UDim2.new(0, 10, 0, 10),
		AoAbrir = function(painel)
			painel.Limpar()
			local busca = painel.Campo("Buscar entidade...")
			local function listar(filtro)
				local arvore = remotes.GenesisConsulta:InvokeServer("Explorer", filtro)
				if not arvore then return end
				for _, grupo in ipairs(arvore) do
					painel.Texto("▸ " .. grupo.Categoria .. " (" .. #grupo.Itens .. ")",
						DockUI.Tema.Destaque)
					for _, item in ipairs(grupo.Itens) do
						painel.Botao("   " .. item.Nome .. " #" .. item.Id ..
							(item.EmChamas and " 🔥" or ""), function()
							selecionadaId = item.Id
							P.Properties.Alternar(true)
						end)
					end
				end
			end
			busca.FocusLost:Connect(function()
				painel.Limpar()
				painel.Corpo:FindFirstChildOfClass("TextBox")
				listar(busca.Text)
			end)
			listar(nil)
		end,
	})

	-- ============ 2) PROPERTIES ============
	P.Properties = DockUI.CriarPainel({
		Titulo = "Properties", Largura = 300, Altura = 400,
		Posicao = UDim2.new(0, 10, 0, 480),
		AoAbrir = function(painel)
			painel.Limpar()
			if not selecionadaId then
				painel.Texto("Selecione uma entidade no Explorer.")
				return
			end
			local props = remotes.GenesisConsulta:InvokeServer("Propriedades", selecionadaId)
			if not props then
				painel.Texto("Entidade nao existe mais.")
				return
			end
			painel.Texto(props.Arquetipo .. " #" .. props.Id, DockUI.Tema.Destaque)
			painel.Texto("Nivel D atual: " .. props.NivelD .. " | Relevancia: " ..
				string.format("%.2f", props.Relevancia or 0))
			painel.Texto("— ESTADO (edite e Enter) —")
			for campo, valor in pairs(props.Estado) do
				local tipoV = type(valor)
				if tipoV == "number" or tipoV == "boolean" then
					local caixa = painel.Campo(campo .. " = " .. tostring(valor))
					caixa.Text = tostring(valor)
					caixa.FocusLost:Connect(function(enter)
						if enter then
							local novoValor
							if tipoV == "number" then
								novoValor = tonumber(caixa.Text)
							else
								novoValor = (caixa.Text == "true")
							end
							if novoValor ~= nil then
								remotes.GenesisAcao:FireServer("DefinirEstado",
									selecionadaId, campo, novoValor)
							end
						end
					end)
					painel.Texto("  " .. campo, DockUI.Tema.TextoFraco)
				end
			end
			painel.Botao("🔥 Incendiar", function()
				remotes.GenesisAcao:FireServer("DefinirEstado", selecionadaId, "EmChamas", true)
			end, DockUI.Tema.Perigo)
			painel.Botao("Destruir entidade", function()
				remotes.GenesisAcao:FireServer("DestruirEntidade", selecionadaId)
				selecionadaId = nil
				painel.Alternar(false)
			end, DockUI.Tema.Perigo)
			-- extensoes de plugins (Explorer/Properties customizavel!)
			Kernel.ChamarExtensoes("Properties", "Render", {
				Painel = painel, EntidadeId = selecionadaId, Props = props,
			})
		end,
	})

	-- ============ 3) TOOLBOX ============
	P.Toolbox = DockUI.CriarPainel({
		Titulo = "Toolbox", Largura = 360, Altura = 500,
		Posicao = UDim2.new(1, -380, 0, 10),
		AoAbrir = function(painel)
			painel.Limpar()
			local abaAtual = "Modelos"
			local subAtual = "Todos"

			local corpoLista -- render abaixo

			local function renderLista()
				-- remove itens antigos (mantem abas e campos fixos)
				for _, filho in ipairs(painel.Corpo:GetChildren()) do
					if filho:IsA("TextButton") and filho.Name == "ItemToolbox" then
						filho:Destroy()
					elseif filho:IsA("TextLabel") and filho.Name == "InfoToolbox" then
						filho:Destroy()
					end
				end
				local catalogo = remotes.GenesisConsulta:InvokeServer("Toolbox", abaAtual, subAtual)
				if not catalogo then return end
				for _, item in ipairs(catalogo) do
					local preco = item.Gratis and "GRATIS" or (tostring(item.Preco) .. " R$k") -- moeda Arkhe
					local b = painel.Botao(item.Nome .. "  [" .. preco .. "]  por " .. item.Autor,
						function()
							remotes.GenesisAcao:FireServer("ToolboxInserir", item.Id)
						end)
					b.Name = "ItemToolbox"
				end
				if #catalogo == 0 then
					local l = painel.Texto("(vazio — publique o primeiro!)", DockUI.Tema.TextoFraco)
					l.Name = "InfoToolbox"
				end
			end

			painel.Abas({ "Modelos", "Plugins", "Folhas", "Mundos", "Meus" }, function(aba)
				abaAtual = aba
				renderLista()
			end)
			painel.Abas({ "Todos", "Natureza", "Estruturas", "Fantasia", "Tech" }, function(sub)
				subAtual = sub
				renderLista()
			end)

			painel.Texto("— TOOLBOX DO ROBLOX (por ID) —", DockUI.Tema.Destaque)
			local caixaId = painel.Campo("Cole o AssetId do Roblox aqui")
			painel.Botao("Inserir asset do Roblox", function()
				local id = tonumber(caixaId.Text)
				if id then
					remotes.GenesisAcao:FireServer("InserirRobloxAsset", id)
				end
			end)

			painel.Texto("— PUBLICAR NO MARKETPLACE ARKHE —", DockUI.Tema.Destaque)
			local nomePub = painel.Campo("Nome do seu asset/plugin")
			local precoPub = painel.Campo("Preco (0 = gratis)")
			painel.Botao("Publicar selecao atual", function()
				remotes.GenesisAcao:FireServer("PublicarAsset",
					nomePub.Text, tonumber(precoPub.Text) or 0, selecionadaId)
			end, DockUI.Tema.Destaque)

			renderLista()
		end,
	})

	-- ============ 4) CHAT DA IA (Singularity) ============
	P.IA = DockUI.CriarPainel({
		Titulo = "IA", Largura = 340, Altura = 460,
		Posicao = UDim2.new(1, -380, 0, 520),
		AoAbrir = function(painel)
			painel.Limpar()
			painel.Texto("SINGULARITY AI — operadora da Arkhe", DockUI.Tema.Destaque)
			local autonomo = false
			local btnAuto
			btnAuto = painel.Botao("Modo Autonomo: DESLIGADO", function()
				autonomo = not autonomo
				btnAuto.Text = "Modo Autonomo: " .. (autonomo and "LIGADO ✦" or "DESLIGADO")
				remotes.GenesisAcao:FireServer("IAModoAutonomo", autonomo)
			end)
			local caixa = painel.Campo("Peca qualquer coisa... (ex: crie uma vila viking)")
			painel.Botao("Enviar", function()
				if caixa.Text ~= "" then
					painel.Texto("Voce: " .. caixa.Text, DockUI.Tema.TextoFraco)
					remotes.GenesisAcao:FireServer("IAMensagem", caixa.Text)
					caixa.Text = ""
				end
			end, DockUI.Tema.Destaque)
			-- respostas chegam via evento
			P._chatPainel = painel
		end,
	})

	-- ============ 5) EVENTSCRIPT — EDITOR VISUAL DE BLOCOS ============
	-- Touch-first (GDevelop-style, sem arrastar): toque monta blocos
	-- QUANDO (ambar) -> FACA (indigo). "Ver Lua" = aprendizado invisivel.
	local folhaAberta = nil   -- nome da folha em edicao
	local modoPicker = nil    -- { Tipo = "C"|"A" } escolhendo bloco novo
	local blocoNovo = nil     -- { Tipo, Nome, Spec } preenchendo args

	P.Eventos = DockUI.CriarPainel({
		Titulo = "Eventos", Largura = 350, Altura = 520,
		Posicao = UDim2.new(0.5, -170, 0, 10),
		AoAbrir = function(painel)
			painel.Limpar()
			local corQuando = Color3.fromRGB(214, 158, 60)  -- ambar
			local corFaca = DockUI.Tema.Destaque

			-- ===== MODO 3: preenchendo args de um bloco novo =====
			if blocoNovo then
				painel.Texto((blocoNovo.Tipo == "C" and "QUANDO " or "FACA ") ..
					blocoNovo.Nome, blocoNovo.Tipo == "C" and corQuando or corFaca)
				painel.Texto(blocoNovo.Spec.Desc or "", DockUI.Tema.TextoFraco)
				local caixas = {}
				for _, arg in ipairs(blocoNovo.Spec.Args or {}) do
					local cx = painel.Campo(arg.Nome .. " (padrao: " .. tostring(arg.Padrao) .. ")")
					caixas[arg.Nome] = { Caixa = cx, Padrao = arg.Padrao }
				end
				painel.Botao("✔ Adicionar bloco", function()
					local args = {}
					for nome, info in pairs(caixas) do
						local texto = info.Caixa.Text
						if texto == "" then
							args[nome] = info.Padrao
						elseif tonumber(texto) then
							args[nome] = tonumber(texto)
						elseif texto == "true" or texto == "false" then
							args[nome] = texto == "true"
						else
							args[nome] = texto
						end
					end
					remotes.GenesisAcao:FireServer("FolhaAddBloco", folhaAberta,
						blocoNovo.Tipo, blocoNovo.Nome,
						game:GetService("HttpService"):JSONEncode(args))
					blocoNovo = nil
					task.wait(0.15)
					painel.Alternar(true)
				end, corFaca)
				painel.Botao("← Cancelar", function()
					blocoNovo = nil
					painel.Alternar(true)
				end)
				return
			end

			-- ===== MODO 2: escolhendo bloco da biblioteca =====
			if modoPicker then
				local bib = remotes.GenesisConsulta:InvokeServer("ESBiblioteca")
				local lista = modoPicker.Tipo == "C" and bib.Condicoes or bib.Acoes
				painel.Texto(modoPicker.Tipo == "C"
					and "ESCOLHA A CONDICAO (quando?)" or "ESCOLHA A ACAO (fazer o que?)",
					modoPicker.Tipo == "C" and corQuando or corFaca)
				for _, item in ipairs(lista) do
					painel.Botao((modoPicker.Tipo == "C" and "❖ " or "▶ ") .. item.Nome ..
						"  — " .. item.Desc, function()
						blocoNovo = { Tipo = modoPicker.Tipo, Nome = item.Nome, Spec = item }
						modoPicker = nil
						painel.Alternar(true)
					end)
				end
				painel.Botao("← Voltar", function()
					modoPicker = nil
					painel.Alternar(t]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX604119"><Properties><string name="Name">Gizmos</string><ProtectedString name="Source"><![CDATA[--[[
  Gizmos (ModuleScript)
  Local: ReplicatedStorage > Arkhe > Genesis > Gizmos
  ============================================================================
  Ferramentas de edição visuais - melhor que Unreal/Unity
  - Move, Rotate, Scale, Transform Universal
  - Com gradiente e textura custom, sem emojis
  - Ícones personalizados rbxassetid://
  ============================================================================
]]

local Gizmos = {}
Gizmos.__index = Gizmos

Gizmos.Tipos = {
  Mover={Icone="rbxassetid://14928074447", Cor={R=255,G=0,B=0}, Eixos={"X","Y","Z"}},
  Rotacionar={Icone="rbxassetid://14928074448", Cor={R=0,G=255,B=0}, Eixos={"X","Y","Z"}},
  Escalar={Icone="rbxassetid://14928074449", Cor={R=0,G=0,B=255}, Eixos={"X","Y","Z"}},
  TransformUniversal={Icone="rbxassetid://14928074450", Cor={R=255,G=255,B=0}, Eixos={"X","Y","Z"}},
  CaixaSelecao={Icone="rbxassetid://14928074451", Cor={R=255,G=255,B=255}},
  LacoSelecao={Icone="rbxassetid://14928074452", Cor={R=200,G=200,B=255}},
  PincelTerreno={Icone="rbxassetid://14928074453", Cor={R=34,G=139,B=34}},
  PincelVegetacao={Icone="rbxassetid://14928074454", Cor={R=50,G=205,B=50}},
  PincelAgua={Icone="rbxassetid://14928074455", Cor={R=0,G=100,B=255}},
}

function Gizmos.novo()
  return setmetatable({Ativo="Mover", Tamanho=1, Snap=false, SnapValor=1, Espaco="Mundo"}, {__index=Gizmos})
end

function Gizmos:Ativar(tipo) self.Ativo=tipo end
function Gizmos:ObterAtivo() return self.Tipos[self.Ativo] end
function Gizmos:Listar() return self.Tipos end
function Gizmos:Serializar() return {Ativo=self.Ativo, Tamanho=self.Tamanho, TotalTipos=self:Contar()} end
function Gizmos:Contar() local n=0 for _ in pairs(self.Tipos) do n=n+1 end return n end

return Gizmos
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX993928"><Properties><string name="Name">LocationMarker</string><ProtectedString name="Source"><![CDATA[
local LocationMarker = {}
function LocationMarker.novo()
  return setmetatable({Marcacoes={}, Max=50}, {__index=LocationMarker})
end
function LocationMarker:Marcar(userId, nome, pos, cor, texto)
  local m={Id=os.time()..math.random(1000,9999), UserId=userId, Nome=nome, Pos=pos, Cor=cor or {R=255,G=255,B=0}, Texto=texto or "", Tempo=os.time()}
  table.insert(self.Marcacoes, m)
  if #self.Marcacoes>self.Max then table.remove(self.Marcacoes,1) end
  return m
end
function LocationMarker:Remover(id)
  for i, m in ipairs(self.Marcacoes) do if m.Id==id then table.remove(self.Marcacoes,i) return true end end
  return false
end
function LocationMarker:Listar() return self.Marcacoes end
function LocationMarker:Serializar() return {Total=#self.Marcacoes} end
return LocationMarker
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX868515"><Properties><string name="Name">Modal</string><ProtectedString name="Source"><![CDATA[
