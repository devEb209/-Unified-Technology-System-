local function equalData(a,b)
	if type(a)~=type(b) then return false end
	if type(a)~="table" then return a==b end
	for key,value in pairs(a) do if not equalData(value,b[key]) then return false end end
	for key in pairs(b) do if a[key]==nil then return false end end
	return true
end
local function floorProject()
	local p=Project.new("Navigation tests")
	add(p,{name="Walkable ground",transform={position={x=0,y=-1,z=0},size={x=80,y=2,z=80}}})
	return p
end
local function npc(p,x,z,config)
	return add(p,{kind="npc",name="Agent",transform={position={x=x,y=2,z=z}},npc=config or {}})
end

test("navigation plans an actual route around a blocking wall",function()
	local p=floorProject();add(p,{transform={position={x=0,y=3,z=0},size={x=2,y=6,z=32}}})
	local nav=Navigation.new(WorldQuery.new(p.state))
	local path,report=nav:find({x=-20,y=2,z=0},{x=20,y=2,z=0})
	assert(path and report.reason=="found");assert(#path>11)
	for _,point in ipairs(path) do assert(nav.query:walkable(point.x,point.z,1,4)) end
	local repeated=nav:find({x=-20,y=2,z=0},{x=20,y=2,z=0})
	assert(equalData(path,repeated));assert(nav.cacheCount>0)
end)
test("navigation search budget is enforced without mutating scene state",function()
	local p=floorProject();local original=p.state
	local nav=Navigation.new(WorldQuery.new(p.state))
	local path,report=nav:find({x=-24,y=2,z=-24},{x=24,y=2,z=24},{maxExpanded=1})
	eq(path,nil);eq(report.reason,"budget_exhausted");eq(report.expanded,1);eq(p.state,original)
end)
test("navigation cannot invent walkable ground in an empty world",function()
	local nav=Navigation.new(WorldQuery.new(Schema.empty()))
	local path,report=nav:find({x=0,y=0,z=0},{x=10,y=0,z=10})
	eq(path,nil);eq(report.reason,"no_walkable_endpoint")
end)
test("world queries distinguish ground, obstructions and line of sight",function()
	local p=floorProject();local wall=add(p,{transform={position={x=0,y=3,z=0},size={x=2,y=6,z=20}}})
	local query=WorldQuery.new(p.state)
	assert(query:walkable(-12,0,1,4));assert(not query:walkable(0,0,1,4))
	assert(not query:visible({x=-10,y=3,z=0},{x=10,y=3,z=0},"target"))
	assert(query:visible({x=-10,y=3,z=0},{x=0,y=3,z=0},wall))
end)
test("NPC configuration is validated and remains editable with undo",function()
	local p=floorProject();local id=npc(p,0,0)
	p:execute({{op="npc",id=id,patch={behavior="goTo",target={x=20,y=2,z=0},speed=8}}},p.state.revision)
	eq(p.state.nodes[id].npc.behavior,"goTo");p:undo(p.state.revision);eq(p.state.nodes[id].npc.behavior,"wander")
	rejects(function() p:execute({{op="npc",id=id,patch={speed=0/0}}},p.state.revision) end)
end)
test("NPC follows its route while authored transforms remain unchanged",function()
	local p=floorProject();local id=npc(p,-20,0,{behavior="goTo",target={x=20,y=2,z=0},speed=8})
	local sim=Runtime.new(p.state)
	for _=1,130 do sim:step(.05) end
	assert(sim.state.nodes[id].transform.position.x>18);eq(sim.npcs.brains[id].goal,"arrived")
	eq(p.state.nodes[id].transform.position.x,-20)
end)
test("NPC movement uses generated terrain heights, not visual Instance positions",function()
	local p=Project.new();p:execute({{op="terrain",options={width=8,depth=8,cell=6,seed=12,amplitude=3}}},0)
	local id=npc(p,-12,-12,{behavior="goTo",target={x=12,y=2,z=12},speed=6,maxStep=4})
	local sim=Runtime.new(p.state);for _=1,120 do sim:step(.05) end
	local pos=sim.state.nodes[id].transform.position
	near(pos.y,sim.npcs.query:height(pos.x,pos.z)+2)
end)
test("NPC does not know an unseen source behind its field of view",function()
	local p=floorProject();local id=npc(p,0,0,{fov=60,hunger=.9})
	local food=add(p,{transform={position={x=0,y=1,z=-12},size={x=2,y=2,z=2}},metadata={food=true,foodAmount=3}})
	local sim=Runtime.new(p.state);sim.npcs:index();sim.npcs:perceive(id,0)
	eq(sim.npcs.brains[id].known[food],nil)
end)
test("static occlusion prevents knowledge through walls",function()
	local p=floorProject();local id=npc(p,-12,0,{fov=360})
	local hazard=add(p,{transform={position={x=12,y=2,z=0},size={x=2,y=2,z=2}},metadata={hazard=true}})
	add(p,{transform={position={x=0,y=4,z=0},size={x=2,y=8,z=28}}})
	local sim=Runtime.new(p.state);sim.npcs:index();sim.npcs:perceive(id,0)
	eq(sim.npcs.brains[id].known[hazard],nil)
end)
test("NPC hears an explicit noise stimulus behind it without omniscient sight",function()
	local p=floorProject();local id=npc(p,0,0,{fov=60,sight=16,hearing=40})
	local source=add(p,{transform={position={x=0,y=2,z=-24}},metadata={noiseRadius=32}})
	local sim=Runtime.new(p.state);sim.npcs:index();local seen,heard=sim.npcs:perceive(id,0)
	local found=false;for _,entry in ipairs(heard) do if entry.node.id==source then found=true end end
	assert(found);assert(sim.npcs.brains[id].known[source])
	for _,entry in ipairs(seen) do assert(entry.node.id~=source) end
end)
test("a perceived hazard produces a traceable flee decision",function()
	local p=floorProject();local id=npc(p,0,0,{fov=360})
	local hazard=add(p,{transform={position={x=0,y=2,z=8}},metadata={hazard=true}})
	local sim=Runtime.new(p.state);sim:step(.05)
	eq(sim.npcs.brains[id].goal,"flee");eq(sim.npcs.brains[id].lastCause,hazard)
end)
test("unobserved distant hazards do not trigger a fabricated cause",function()
	local p=floorProject();local id=npc(p,-24,-24,{sight=8,hearing=0,fov=360})
	local hazard=add(p,{transform={position={x=28,y=2,z=28}},metadata={hazard=true}})
	local sim=Runtime.new(p.state);sim:step(.05)
	assert(sim.npcs.brains[id].goal~="flee");eq(sim.npcs.brains[id].known[hazard],nil)
end)
test("needs cause rest and recovery instead of a fixed movement script",function()
	local p=floorProject();local id=npc(p,0,0,{energy=.05})
	local sim=Runtime.new(p.state);sim:step(.05)
	eq(sim.npcs.brains[id].mode,"resting")
	local before=sim.npcs.brains[id].needs.energy
	for _=1,80 do sim:step(.05) end
	assert(sim.npcs.brains[id].needs.energy>before)
end)
test("food interaction consumes finite scene stock and records the source",function()
	local p=floorProject();local id=npc(p,0,0,{fov=360,hunger=.9})
	local food=add(p,{transform={position={x=4,y=1,z=0},size={x=1,y=2,z=1}},metadata={food=true,foodAmount=2}})
	local sim=Runtime.new(p.state);sim:step(.05)
	eq(sim.state.nodes[food].metadata.foodAmount,1);eq(p.state.nodes[food].metadata.foodAmount,2)
	assert(sim.npcs.brains[id].needs.hunger<.5);eq(sim.npcs.brains[id].summary.ate,1)
end)
test("bounded NPC decisions are fair while all needs continue evolving",function()
	local p=floorProject();for i=1,12 do npc(p,(i%4)*6-12,math.floor(i/4)*6-12) end
	local sim=Runtime.new(p.state,{npcThinkBudget=2})
	for _=1,30 do sim:step(.05);assert(sim.npcs.thinking<=2) end
	for _,id in ipairs(sim.npcs.ids) do
		assert(sim.npcs.brains[id].nextThink>0);assert(sim.npcs.brains[id].needs.hunger>.15)
	end
end)
test("NPC snapshots preserve authoritative future evolution",function()
	local p=floorProject();npc(p,-12,-12,{seed=5});npc(p,12,12,{seed=17})
	local a=Runtime.new(p.state);for _=1,45 do a:step(.05) end
	local checkpoint=a:checkpoint();local b=Runtime.restore(checkpoint)
	for _=1,60 do a:step(.05);b:step(.05) end
	assert(equalData(a.state,b.state),"scene state diverged after checkpoint")
	assert(equalData(a.npcs:snapshot(),b.npcs:snapshot()),"agent memory/RNG diverged after checkpoint")
	near(a.time,b.time);eq(a.ticks,b.ticks)
end)
test("corrupt checkpoint memory is rejected before replacing a project",function()
	local p=floorProject();local id=npc(p,0,0);local sim=Runtime.new(p.state);sim:step(.05)
	local cp=sim:checkpoint();cp.agents.brains[id].rng=0
	rejects(function() Runtime.restore(cp) end)
	local s=Session.new({project=p,authorize=function() return true end})
	local before=s.project.state
	rejects(function() s:handle(1,"resumeSimulation",{revision=p.state.revision,confirm=true,checkpoint=cp}) end)
	eq(s.project.state,before);eq(s.mode,"edit")
end)
test("session checkpoints are explicit and do not leak the running state by reference",function()
	local p=floorProject();local id=npc(p,0,0)
	local s=Session.new({project=p,authorize=function() return true end})
	s:handle(1,"play",{revision=p.state.revision});s:step(.05)
	local response=s:handle(1,"checkpoint",{epoch=s.epoch})
	response.checkpoint.state.nodes[id].name="tampered"
	assert(s.runtime.state.nodes[id].name~="tampered")
	s:handle(1,"stop",{epoch=s.epoch})
	rejects(function() s:handle(1,"resumeSimulation",{revision=p.state.revision,checkpoint=response.checkpoint}) end)
end)

test("session resumes a checkpoint only after explicit confirmation",function()
	local p=floorProject();local id=npc(p,-12,0,{behavior="goTo",target={x=20,y=2,z=0},speed=5})
	local s=Session.new({project=p,authorize=function() return true end})
	s:handle(1,"play",{revision=p.state.revision})
	for _=1,20 do s:step(.05) end
	local cp=s:handle(1,"checkpoint",{epoch=s.epoch}).checkpoint
	s:handle(1,"stop",{epoch=s.epoch})
	s:handle(1,"resumeSimulation",{revision=p.state.revision,checkpoint=cp,confirm=true})
	eq(s.mode,"play");near(s.runtime.time,cp.time)
	local x=s.runtime.state.nodes[id].transform.position.x;s:step(.05)
	assert(s.runtime.state.nodes[id].transform.position.x>x)
	s:handle(1,"stop",{epoch=s.epoch})
	near(s.project.state.nodes[id].transform.position.x,cp.state.nodes[id].transform.position.x)
end)
test("NPC inspection returns a copy and rejects non-agent identities",function()
	local p=floorProject();local id=npc(p,0,0)
	local s=Session.new({project=p,authorize=function() return true end})
	s:handle(1,"play",{revision=p.state.revision});s:step(.05)
	local info=s:handle(1,"inspectNpc",{epoch=s.epoch,id=id})
	info.brain.needs.energy=0
	assert(s.runtime.npcs.brains[id].needs.energy>0)
	rejects(function() s:handle(1,"inspectNpc",{epoch=s.epoch,id="not-an-agent"}) end)
end)
