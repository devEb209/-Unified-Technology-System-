     <Item class="ModuleScript" referent="RBX947531"><Properties><string name="Name">RBXDomBuilder</string><ProtectedString name="Source"><![CDATA[[[
	RBXDomBuilder (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Publish > RBXDomBuilder
	============================================================
	F12 — MONTAGEM .RBXL NO RELAY (rbx-dom)
	- Constrói árvore .rbxl a partir de pacote WorldSerializer
	- Estrutura: DataModel -> Workspace -> Pastas Arkhe + Terrain + Lighting
	- Cada entidade RRW vira Instance (Part/Model) com Attributes
	- Gera XML .rbxl (ou JSON rbx-dom) para relay
	- Contrato: POST /publisher/build { Pacote } -> { RBXLUrl, Tamanho }
	- Verdade: .rbxl NÃO nasce dentro do Roblox, só via relay
	============================================================
]]

local RBXDomBuilder = {}
RBXDomBuilder.__index = RBXDomBuilder

function RBXDomBuilder.novo(nome)
	local self = setmetatable({}, RBXDomBuilder)
	self.Nome = nome or "Build_"..math.random(1000,9999)
	self.Pacote = nil
	self.Arvore = {} -- { Classe, Nome, Props, Filhos }
	self.TotalInstances = 0
	self.TamanhoEstimadoKB = 0
	return self
end

function RBXDomBuilder:CarregarPacote(pacote)
	self.Pacote = pacote
	return true
end

function RBXDomBuilder:ConstruirArvore()
	if not self.Pacote then return nil, "Sem pacote" end
	self.Arvore = {
		Classe="DataModel",
		Nome="Game",
		Props={},
		Filhos={
			{
				Classe="Workspace",
				Nome="Workspace",
				Props={},
				Filhos={
					{ Classe="Folder", Nome="ArkheEntidades", Props={}, Filhos={} },
					{ Classe="Folder", Nome="ArkheNPCs", Props={}, Filhos={} },
					{ Classe="Folder", Nome="ArkheModelos", Props={}, Filhos={} },
				}
			},
			{
				Classe="Lighting",
				Nome="Lighting",
				Props={ ClockTime=12, Brightness=2 },
				Filhos={},
			},
			{
				Classe="ReplicatedStorage",
				Nome="ReplicatedStorage",
				Props={},
				Filhos={
					{ Classe="ModuleScript", Nome="ArkhePacote", Props={ Source="return "..(self.Pacote.Versao or "2.7") }, Filhos={} }
				}
			}
		}
	}
	-- adiciona entidades como Parts
	local numEnts = 0
	if self.Pacote.Entidades then
		for id, ent in pairs(self.Pacote.Entidades) do
			numEnts = numEnts + 1
			if numEnts <= 100 then -- limite preview
				table.insert(self.Arvore.Filhos[1].Filhos[1].Filhos, {
					Classe="Part",
					Nome="Ent_"..tostring(id),
					Props={
						Position={ X=0, Y=5, Z=0 },
						Size={ X=4, Y=4, Z=4 },
						Anchored=true,
					},
					Filhos={},
				})
			end
		end
	end
	self.TotalInstances = numEnts + 5
	self.TamanhoEstimadoKB = math.floor(self.TotalInstances * 0.5 + 100)
	return self.Arvore
end

function RBXDomBuilder:GerarXML()
	-- gera XML simplificado .rbxl (preview, relay gera binário real)
	if not self.Arvore or not self.Arvore.Classe then
		local ok, err = self:ConstruirArvore()
		if not ok then return nil, err end
	end
	local xml = '<roblox version="4">\n'
	xml = xml .. '  <Item class="DataModel">\n'
	xml = xml .. '    <Properties><string name="Name">Game</string></Properties>\n'
	for _, filho in ipairs(self.Arvore.Filhos or {}) do
		xml = xml .. '    <Item class="'..filho.Classe..'"><Properties><string name="Name">'..filho.Nome..'</string></Properties></Item>\n'
	end
	xml = xml .. '  </Item>\n</roblox>'
	return xml
end

function RBXDomBuilder:PayloadParaRelay()
	if not self.Pacote then return nil end
	return {
		Pacote=self.Pacote,
		Nome=self.Nome,
		Versao=self.Pacote.Versao or "2.7",
		ArkheVersao=self.Pacote.ArkheVersao or "F12-serializer-v2.7",
		TotalEntidades=self.Pacote.Meta and self.Pacote.Meta.TotalEntidades or 0,
		BuildOptions={
			IncluirScripts=true,
			IncluirTerrain=true,
			IncluirLighting=true,
			Formato="rbxl",
		}
	}
end

function RBXDomBuilder:ReceberDoRelay(resposta)
	if not resposta then return false end
	-- resposta: { RBXLUrl, TamanhoKB, Hash, Sucesso }
	if resposta.RBXLUrl then
		self.RBXLUrl = resposta.RBXLUrl
		self.TamanhoEstimadoKB = resposta.TamanhoKB or self.TamanhoEstimadoKB
		return true
	end
	return false
end

function RBXDomBuilder:Serializar()
	return {
		Nome=self.Nome,
		TotalInstances=self.TotalInstances,
		TamanhoKB=self.TamanhoEstimadoKB,
		TemPacote=self.Pacote ~= nil,
		RBXLUrl=self.RBXLUrl,
	}
end

return RBXDomBuilder
]]></ProtectedString></Properties></Item>
