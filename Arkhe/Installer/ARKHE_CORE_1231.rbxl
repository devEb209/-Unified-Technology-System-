     <Item class="ModuleScript" referent="RBX590221"><Properties><string name="Name">System1144_Analytics</string><ProtectedString name="Source"><![CDATA[
local System1144_Analytics = {}
function System1144_Analytics.novo()
  return setmetatable({
    Id=1144,
    Familia="Analytics",
    Nome="System1144_Analytics",
    TopbarBotao=true,
    Menu=true,
    Submenu=true,
    Funcoes={"Novo","Abrir","Salvar","Editar","Deletar","Duplicar","Exportar","Importar","Configurar","Publicar"},
    Gradiente="Arkhe",
    Textura="Noise",
    Mobile=true,
