     <Item class="ModuleScript" referent="RBX634967"><Properties><string name="Name">Vehicle</string><ProtectedString name="Source"><![CDATA[[[
	Vehicle (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Physica > Vehicle
	============================================================
	F8 — VEÍCULOS (carro/barco/voador)
	- Tipos: Carro, Barco, Voador, Montaria
	- Física: motor, freio, direção, suspensão (raycast rodas)
	- Estado: { Pos, Vel, Acel, Direcao, Combustivel, Integridade }
	- Controle: Acelerar/Frear/Virar por input
	- Integra com Physica presets + Destruction
	============================================================
]]

local Vehicle = {}
Vehicle.__index = Vehicle

Vehicle.Tipos = {
	Carro = { Massa=1500, Potencia=300, MaxVel=80, NumRodas=4, Desc="Carro terrestre 4 rodas" },
	Barco = { Massa=2000, Potencia=200, MaxVel=40, NumRodas=0, Desc="Barco flutua por empuxo RRW" },
	Voador = { Massa=800, Potencia=500, MaxVel=120, NumRodas=0, Desc="Voador com sustentação" },
	Montaria = { Massa=400, Potencia=100, MaxVel=30, NumRodas=0, Desc="Montaria animal (usa NPCBrain)" },
	Carrinho = { Massa=200, Potencia=50, MaxVel=20, NumRodas=2, Desc="Carrinho simples" },
}

function Vehicle.novo(tipo, pos)
	local cfg = Vehicle.Tipos[tipo or "Carro"]
	local self = setmetatable({}, Vehicle)
	self.Tipo = tipo or "Carro"
	self.Pos = pos or Vector3.new(0,5,0)
	self.Vel = Vector3.new(0,0,0)
	self.Direcao = Vector3.new(0,0,1)
	self.Acel = 0
	self.Velocidade = 0
	self.Combustivel = 100
	self.Integridade = 100
	self.Massa = cfg.Massa
	self.Potencia = cfg.Potencia
	self.MaxVel = cfg.MaxVel
	self.NumRodas = cfg.NumRodas
	self.Estado = "Parado" -- Parado/Acelerando/Freando/Quebrado
	self.Piloto = nil
	self.Passageiros = {}
	return self
end

function Vehicle:Entrar(jogadorOuNPC)
	if self.Piloto then
		table.insert(self.Passageiros, jogadorOuNPC)
		return "Passageiro"
	else
		self.Piloto = jogadorOuNPC
		self.Estado = "Parado"
		return "Piloto"
	end
end

function Vehicle:Sair(jogadorOuNPC)
	if self.Piloto == jogadorOuNPC then
		self.Piloto = nil
		if #self.Passageiros > 0 then
			self.Piloto = table.remove(self.Passageiros,1)
		else
			self.Estado = "Parado"
		end
		return true
	end
	for i, p in ipairs(self.Passageiros) do
		if p == jogadorOuNPC then
			table.remove(self.Passageiros,i)
			return true
		end
	end
	return false
end

function Vehicle:Acelerar(forca, dt)
	dt = dt or 0.033
	if self.Combustivel <= 0 or self.Integridade <= 0 then
		self.Estado = "Quebrado"
		return false
	end
	forca = math.clamp(forca or 0, -1, 1)
	self.Acel = forca * self.Potencia / self.Massa
	self.Velocidade = math.clamp(self.Velocidade + self.Acel * dt * 10, -self.MaxVel*0.5, self.MaxVel)
	self.Vel = self.Direcao * self.Velocidade
	self.Pos = self.Pos + self.Vel * dt
	self.Combustivel = math.max(0, self.Combustivel - math.abs(forca)*dt*0.5)
	self.Estado = forca > 0.1 and "Acelerando" or (forca < -0.1 and "Freando" or "Parado")
	return true
end

function Vehicle:Virar(anguloGraus)
	local rad = math.rad(anguloGraus or 0)
	local cosA = math.cos(rad)
	local sinA = math.sin(rad)
	-- rotaciona direcao no plano XZ
	local dx = self.Direcao.X * cosA - self.Direcao.Z * sinA
	local dz = self.Direcao.X * sinA + self.Direcao.Z * cosA
	self.Direcao = Vector3.new(dx, 0, dz).Unit
	return self.Direcao
end

function Vehicle:AplicarDano(quantidade)
	self.Integridade = math.clamp(self.Integridade - quantidade, 0, 100)
	if self.Integridade <= 0 then
		self.Estado = "Quebrado"
		self.Velocidade = 0
	end
	return self.Integridade
end

function Vehicle:Reabastecer(quantidade)
	self.Combustivel = math.clamp(self.Combustivel + (quantidade or 50), 0, 100)
	return self.Combustivel
end

function Vehicle:Serializar()
	return {
		Tipo=self.Tipo,
		Pos={ X=self.Pos.X, Y=self.Pos.Y, Z=self.Pos.Z },
		Vel=self.Velocidade,
		Dir={ X=self.Direcao.X, Z=self.Direcao.Z },
		Combustivel=self.Combustivel,
		Integridade=self.Integridade,
		Estado=self.Estado,
		TemPiloto=self.Piloto ~= nil,
		Passageiros=#self.Passageiros,
	}
end

function Vehicle.ListarTipos()
	local lista={}
	for nome, cfg in pairs(Vehicle.Tipos) do
		table.insert(lista, { Nome=nome, Desc=cfg.Desc, MaxVel=cfg.MaxVel, Massa=cfg.Massa })
	end
	return lista
end

return Vehicle
]]></ProtectedString></Properties></Item>
