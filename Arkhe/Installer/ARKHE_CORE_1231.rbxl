     <Item class="ModuleScript" referent="RBX269949"><Properties><string name="Name">SnowSystem</string><ProtectedString name="Source"><![CDATA[
local SnowSystem = {}
function SnowSystem.novo() return setmetatable({AlturaNeve=0, Acumulacao=0.1, Derretimento=0.01, Ativo=false}, {__index=SnowSystem}) end
function SnowSystem:Tick(dt, temperatura)
  if temperatura < 0 then self.AlturaNeve=self.AlturaNeve+self.Acumulacao*dt else self.AlturaNeve=math.max(0,self.AlturaNeve-self.Derretimento*dt) end
end
function SnowSystem:Serializar() return {Altura=self.AlturaNeve, Ativo=self.Ativo} end
return SnowSystem
]]></ProtectedString></Properties></Item>
