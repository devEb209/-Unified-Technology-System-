     <Item class="ModuleScript" referent="RBX70748"><Properties><string name="Name">BinaryImporter</string><ProtectedString name="Source"><![CDATA[--[[
	BinaryImporter (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Import > BinaryImporter
	============================================================
	F11 — FBX/GLB BINÁRIO VIA RELAY (rbx-dom + Open Cloud)
	- Recebe arquivo binário via relay POST /import/binary
	- Relay usa rbx-dom / assimp para converter FBX/GLB -> MeshPart
	- Retorna AssetId + preview + estatísticas
	- Suporta: FBX, GLB, GLTF, OBJ binário, Blend (via relay)
	- Drag-drop: cliente envia base64, relay converte
	============================================================
]]

local BinaryImporter = {}
BinaryImporter.__index = BinaryImporter

BinaryImporter.FormatosBinarios = { "fbx","glb","gltf","obj","blend","dae","3ds" }

function BinaryImporter.novo()
	local self = setmetatable({}, BinaryImporter)
	self.Fila = {} -- { Id, Nome, Formato, Tamanho, Status, Progresso }
	self.Concluidos = {}
	self.TotalImportados = 0
	return self
end

function BinaryImporter:DetectarFormato(nomeArquivo)
	nomeArquivo = string.lower(nomeArquivo or "")
	for _, fmt in ipairs(BinaryImporter.FormatosBinarios) do
		if string.find(nomeArquivo, "%."..fmt.."$") then return fmt end
	end
	return "desconhecido"
end

function BinaryImporter:AdicionarFila(nomeArquivo, tamanhoBytes, base64Preview)
	local formato = self:DetectarFormato(nomeArquivo)
	local id = "bin_"..math.random(100000,999999)
	local entry = {
		Id=id,
		Nome=nomeArquivo,
		Formato=formato,
		Tamanho=tamanhoBytes or 0,
		Status="NaFila",
		Progresso=0,
		CriadoEm=os.time(),
		Preview=base64Preview and string.sub(base64Preview,1,100).."..." or nil,
	}
	self.Fila[id]=entry
	return entry
end

function BinaryImporter:PayloadParaRelay(id, base64Conteudo)
	local entry = self.Fila[id]
	if not entry then return nil end
	return {
		Id=id,
		Nome=entry.Nome,
		Formato=entry.Formato,
		ConteudoBase64=base64Conteudo, -- arquivo binário em base64
		Opcoes={
			Escala=1.0,
			GerarColisao=true,
			Otimizar=true,
			FormatoSaida="rbxmesh",
		}
	}
end

function BinaryImporter:ReceberDoRelay(resposta)
	-- resposta: { Id, Sucesso, AssetId, MeshId, TamanhoVerts, TamanhoTris, Erro, PreviewUrl }
	if not resposta or not resposta.Id then return false end
	local entry = self.Fila[resposta.Id]
	if not entry then return false end
	if resposta.Sucesso then
		entry.Status="Concluido"
		entry.AssetId=resposta.AssetId
		entry.MeshId=resposta.MeshId
		entry.Verts=resposta.TamanhoVerts
		entry.Tris=resposta.TamanhoTris
		entry.PreviewUrl=resposta.PreviewUrl
		entry.Progresso=100
		self.Concluidos[resposta.Id]=entry
		self.Fila[resposta.Id]=nil
		self.TotalImportados=self.TotalImportados+1
	else
		entry.Status="Erro"
		entry.Erro=resposta.Erro
		entry.Progresso=0
	end
	return true, entry
end

function BinaryImporter:AtualizarProgresso(id, progresso, status)
	local entry = self.Fila[id]
	if not entry then return false end
	entry.Progresso = progresso or entry.Progresso
	if status then entry.Status=status end
	return true
end

function BinaryImporter:ListarFila()
	local lista={}
	for _, entry in pairs(self.Fila) do table.insert(lista, entry) end
	return lista
end

function BinaryImporter:ListarConcluidos()
	local lista={}
	for _, entry in pairs(self.Concluidos) do table.insert(lista, entry) end
	return lista
end

function BinaryImporter:Stats()
	local naFila=0; for _ in pairs(self.Fila) do naFila=naFila+1 end
	local concl=0; for _ in pairs(self.Concluidos) do concl=concl+1 end
	return {
		NaFila=naFila,
		Concluidos=concl,
		Total=self.TotalImportados,
		Formatos=BinaryImporter.FormatosBinarios,
	}
end

function BinaryImporter:Serializar()
	return self:Stats()
end

return BinaryImporter
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX487388"><Properties><string name="Name">DAELoader</string><ProtectedString name="Source"><![CDATA[
