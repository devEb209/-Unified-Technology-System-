     <Item class="ModuleScript" referent="RBX376280"><Properties><string name="Name">Array</string><ProtectedString name="Source"><![CDATA[
local Array = {}
function Array.novo() return setmetatable({Count=3, Offset={X=2,Y=0,Z=0}}, {__index=Array}) end
function Array:Aplicar(obj) local arr={} for i=1,self.Count do table.insert(arr,{Obj=obj, I=i, Pos={X=self.Offset.X*i}}) end return arr end
function Array:Serializar() return {Count=self.Count, Offset=self.Offset} end
return Array
]]></ProtectedString></Properties></Item>
