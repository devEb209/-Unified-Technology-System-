     <Item class="ModuleScript" referent="RBX815260"><Properties><string name="Name">Narration</string><ProtectedString name="Source"><![CDATA[--[[
	Narration (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Accessibility > Narration
	============================================================
	F19 — NARRAÇÃO por TTS via relay + fallback local.
	- Fila de frases para falar
	- Falar(texto, prioridade) -> enfileira
	- Contrato relay POST /accessibility/tts { Texto, Voz, Velocidade }
	  retorna { AudioUrl ou AssetId }
	- Fallback: usa chat da IA + print (honestidade: TTS real precisa relay)
	- Integra com Accessibility para modo narração ativado
	============================================================
]]

local Narration = {}
Narration.__index = Narration

Narration.Fila = {} -- { Texto, Prioridade, Timestamp }
Narration.MaxFila = 20
Narration.VozPadrao = "pt-BR-Female"
Narration.Velocidade = 1.0
Narration.Ativo = false
Narration.Historico = {} -- ultimas 50 falas

function Narration.DefinirAtivo(ativo)
	Narration.Ativo = ativo and true or false
end

function Narration.DefinirVoz(voz)
	Narration.VozPadrao = voz or "pt-BR-Female"
end

function Narration.Falar(texto, prioridade)
	if not texto or #texto < 2 then return false end
	prioridade = prioridade or 1
	if #Narration.Fila >= Narration.MaxFila then
		-- remove menor prioridade
		table.sort(Narration.Fila, function(a,b) return a.Prioridade < b.Prioridade end)
		table.remove(Narration.Fila, 1)
	end
	table.insert(Narration.Fila, { Texto=texto:sub(1,300), Prioridade=prioridade, Timestamp=os.time() })
	table.insert(Narration.Historico, { Texto=texto, Quando=os.time() })
	if #Narration.Historico > 50 then table.remove(Narration.Historico, 1) end
	return true
end

function Narration.Proxima()
	if #Narration.Fila == 0 then return nil end
	table.sort(Narration.Fila, function(a,b)
		if a.Prioridade ~= b.Prioridade then return a.Prioridade > b.Prioridade end
		return a.Timestamp < b.Timestamp
	end)
	return table.remove(Narration.Fila, 1)
end

function Narration.ListarFila()
	return Narration.Fila
end

function Narration.ListarHistorico(n)
	n = n or 20
	local lista={}
	for i=math.max(1,#Narration.Historico-n+1),#Narration.Historico do
		table.insert(lista, Narration.Historico[i])
	end
	return lista
end

function Narration.Limpar()
	Narration.Fila = {}
end

-- Contrato para relay: monta payload
function Narration.PayloadTTS(texto, voz, velocidade)
	return {
		Texto=texto,
		Voz=voz or Narration.VozPadrao,
		Velocidade=velocidade or Narration.Velocidade,
		Formato="mp3",
	}
end

-- Fallback local: retorna texto para IA falar
function Narration.FallbackLocal(texto)
	return "[Narração] "..texto
end

function Narration.Serializar()
	return {
		Ativo=Narration.Ativo,
		Voz=Narration.VozPadrao,
		Velocidade=Narration.Velocidade,
		FilaCount=#Narration.Fila,
		HistoricoCount=#Narration.Historico,
	}
end

return Narration
]]></ProtectedString></Properties></Item>
