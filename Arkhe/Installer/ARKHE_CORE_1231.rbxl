     <Item class="ModuleScript" referent="RBX817064"><Properties><string name="Name">TeamPermissions</string><ProtectedString name="Source"><![CDATA[[[
	TeamPermissions (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > TeamPermissions
	============================================================
	F2 — PERMISSÕES DE EQUIPE (dono/editor/visitante/testador)
	- Papéis: Dono (tudo), Editor (edita mundo), Visitante (só vê),
	  Testador (joga mas não edita), Moderador (modera marketplace)
	- Permissões por ação: TerrainEditar, NPCriar, Publicar, etc
	- Convites: por UserId + papel + expira
	- Integra com Kernel anéis + Genesis
	============================================================
]]

local TeamPermissions = {}
TeamPermissions.__index = TeamPermissions

TeamPermissions.Papeis = {
	Dono = { Nivel=100, Permissoes={"*"}, Desc="Acesso total, pode tudo" },
	Editor = { Nivel=70, Permissoes={"TerrainEditar","NPCCriar","Modelar","Animar","EventosEditar","UIEditar","AudioEditar","PublicarRascunho"}, Desc="Edita mundo mas não publica final nem gerencia equipe" },
	Visitante = { Nivel=10, Permissoes={"VerMundo","ChatIA"}, Desc="Só vê, não edita" },
	Testador = { Nivel=30, Permissoes={"VerMundo","Jogar","ChatIA","ReportarBug"}, Desc="Joga o jogo mas não edita" },
	Moderador = { Nivel=60, Permissoes={"VerMundo","ModerarMarketplace","BanirVisitante"}, Desc="Modera marketplace e visitantes" },
}

function TeamPermissions.novo(donoUserId)
	local self = setmetatable({}, TeamPermissions)
	self.Dono = donoUserId
	self.Membros = {} -- [userId] = { Papel, AdicionadoEm, AdicionadoPor }
	self.Convites = {} -- [codigo] = { UserId, Papel, ExpiraEm, CriadoPor }
	self.Banidos = {} -- [userId] = { Motivo, Quando, Por }
	if donoUserId then
		self.Membros[donoUserId] = { Papel="Dono", AdicionadoEm=os.time(), AdicionadoPor=donoUserId }
	end
	return self
end

function TeamPermissions:AdicionarMembro(userId, papel, adicionadoPor)
	if not TeamPermissions.Papeis[papel] then return false, "Papel inválido" end
	-- só Dono pode adicionar Dono/Editor/Moderador, Editor pode adicionar Visitante/Testador
	local papelQuem = self.Membros[adicionadoPor] and self.Membros[adicionadoPor].Papel or "Visitante"
	local nivelQuem = TeamPermissions.Papeis[papelQuem] and TeamPermissions.Papeis[papelQuem].Nivel or 0
	local nivelAlvo = TeamPermissions.Papeis[papel].Nivel
	if nivelQuem < 70 and nivelAlvo >= 60 then
		return false, "Sem permissão para adicionar "..papel
	end
	self.Membros[userId] = { Papel=papel, AdicionadoEm=os.time(), AdicionadoPor=adicionadoPor }
	return true
end

function TeamPermissions:RemoverMembro(userId, removidoPor)
	if userId == self.Dono then return false, "Não pode remover dono" end
	local papelQuem = self.Membros[removidoPor] and self.Membros[removidoPor].Papel or "Visitante"
	if TeamPermissions.Papeis[papelQuem].Nivel < 70 then return false, "Sem permissão" end
	self.Membros[userId]=nil
	return true
end

function TeamPermissions:TemPermissao(userId, acao)
	local membro = self.Membros[userId]
	if not membro then return false end
	local papelInfo = TeamPermissions.Papeis[membro.Papel]
	if not papelInfo then return false end
	for _, perm in ipairs(papelInfo.Permissoes) do
		if perm == "*" or perm == acao then return true end
	end
	return false
end

function TeamPermissions:CriarConvite(userIdAlvo, papel, criadoPor, duracaoHoras)
	duracaoHoras = duracaoHoras or 24
	local codigo = "conv_"..math.random(100000,999999)
	self.Convites[codigo] = {
		UserId=userIdAlvo,
		Papel=papel,
		ExpiraEm=os.time()+duracaoHoras*3600,
		CriadoPor=criadoPor,
		CriadoEm=os.time(),
	}
	return codigo
end

function TeamPermissions:AceitarConvite(codigo, userId)
	local conv = self.Convites[codigo]
	if not conv then return false, "Convite não existe" end
	if os.time() > conv.ExpiraEm then self.Convites[codigo]=nil return false, "Expirado" end
	if conv.UserId ~= 0 and conv.UserId ~= userId then return false, "Convite não é para você" end
	local ok, err = self:AdicionarMembro(userId, conv.Papel, conv.CriadoPor)
	if ok then self.Convites[codigo]=nil end
	return ok, err
end

function TeamPermissions:Banir(userId, motivo, porUserId)
	if not self:TemPermissao(porUserId, "BanirVisitante") and not self:TemPermissao(porUserId, "*") then
		return false, "Sem permissão para banir"
	end
	self.Banidos[userId] = { Motivo=motivo, Quando=os.time(), Por=porUserId }
	self.Membros[userId]=nil
	return true
end

function TeamPermissions:ListarMembros()
	local lista={}
	for uid, info in pairs(self.Membros) do
		table.insert(lista, { UserId=uid, Papel=info.Papel, AdicionadoEm=info.AdicionadoEm })
	end
	return lista
end

function TeamPermissions:Serializar()
	return {
		Dono=self.Dono,
		TotalMembros=(function() local c=0 for _ in pairs(self.Membros) do c=c+1 end return c end)(),
		Membros=self:ListarMembros(),
		ConvitesPendentes=(function() local c=0 for _ in pairs(self.Convites) do c=c+1 end return c end)(),
		Banidos=(function() local c=0 for _ in pairs(self.Banidos) do c=c+1 end return c end)(),
		Papeis=(function() local l={} for k,v in pairs(TeamPermissions.Papeis) do table.insert(l, { Nome=k, Nivel=v.Nivel, Desc=v.Desc }) end return l end)(),
	}
end

return TeamPermissions
]]></ProtectedString></Properties></Item>
