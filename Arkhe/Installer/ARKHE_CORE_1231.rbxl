     <Item class="ModuleScript" referent="RBX892774"><Properties><string name="Name">MotionCapture</string><ProtectedString name="Source"><![CDATA[[[
	MotionCapture (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Animator > MotionCapture
	============================================================
	F6 — GRAVAÇÃO DE MOVIMENTO (motion capture via player)
	- Grava poses do Humanoid (ou R6 custom) em tempo real
	- Frames: { Tempo, Ossos {Nome->CFrame}, RootPos }
	- Playback: reproduz em Timeline
	- Exporta para AnimationClip
	- Filtros: suavização, redução de ruído
	============================================================
]]

local MotionCapture = {}
MotionCapture.__index = MotionCapture

function MotionCapture.novo(nome)
	local self = setmetatable({}, MotionCapture)
	self.Nome = nome or "MoCap_"..math.random(1000,9999)
	self.Frames = {} -- { Tempo, Ossos, RootPos, RootCFrame }
	self.Gravando = false
	self.TempoInicio = 0
	self.Duracao = 0
	self.FPS = 30
	self.Suavizacao = 0.2
	return self
end

function MotionCapture:IniciarGravacao()
	self.Frames = {}
	self.Gravando = true
	self.TempoInicio = os.clock()
	self.Duracao = 0
	return true
end

function MotionCapture:RegistrarFrame(personagem)
	if not self.Gravando then return false end
	if not personagem then return false end
	local tempo = os.clock() - self.TempoInicio
	local ossos = {}
	-- tenta pegar Motor6D transforms
	for _, obj in ipairs(personagem:GetDescendants()) do
		if obj:IsA("Motor6D") then
			ossos[obj.Name] = {
				C0 = { obj.C0:ToEulerAnglesYXZ() },
				C1 = { obj.C1:ToEulerAnglesYXZ() },
				Transform = obj.Transform,
			}
		end
	end
	local root = personagem:FindFirstChild("HumanoidRootPart")
	local rootPos = root and root.Position or Vector3.new(0,0,0)
	local rootCF = root and root.CFrame or CFrame.new()
	table.insert(self.Frames, {
		Tempo = tempo,
		Ossos = ossos,
		RootPos = rootPos,
		RootCFrame = rootCF,
		Indice = #self.Frames+1,
	})
	self.Duracao = tempo
	return #self.Frames
end

function MotionCapture:PararGravacao()
	self.Gravando = false
	return {
		Frames = #self.Frames,
		Duracao = self.Duracao,
		FPSMedio = #self.Frames / (self.Duracao > 0 and self.Duracao or 1),
	}
end

function MotionCapture:Suavizar(janela)
	janela = janela or 3
	if #self.Frames < janela*2 then return end
	-- média móvel nas posições root
	for i=janela+1, #self.Frames-janela do
		local soma = Vector3.new(0,0,0)
		for j=-janela, janela do
			soma = soma + self.Frames[i+j].RootPos
		end
		self.Frames[i].RootPos = soma / (janela*2+1)
	end
end

function MotionCapture:ReduzirRuido(limite)
	limite = limite or 0.05
	-- remove frames com movimento muito pequeno (ruído)
	local filtrados = {}
	local ultimoPos = nil
	for _, frame in ipairs(self.Frames) do
		if not ultimoPos or (frame.RootPos - ultimoPos).Magnitude > limite then
			table.insert(filtrados, frame)
			ultimoPos = frame.RootPos
		end
	end
	self.Frames = filtrados
	return #self.Frames
end

function MotionCapture:ExportarParaClip(nomeClip)
	local clip = {
		Nome = nomeClip or self.Nome.."_Clip",
		Duracao = self.Duracao,
		NumFrames = #self.Frames,
		Tracks = {},
	}
	-- converte ossos para tracks
	local ossosNomes = {}
	for _, frame in ipairs(self.Frames) do
		for nomeOsso, _ in pairs(frame.Ossos) do
			ossosNomes[nomeOsso] = true
		end
	end
	for nomeOsso, _ in pairs(ossosNomes) do
		clip.Tracks[nomeOsso] = {}
		for _, frame in ipairs(self.Frames) do
			local osso = frame.Ossos[nomeOsso]
			if osso then
				table.insert(clip.Tracks[nomeOsso], {
					Tempo = frame.Tempo,
					Transform = osso.Transform,
				})
			end
		end
	end
	return clip
end

function MotionCapture:Serializar()
	return {
		Nome=self.Nome,
		Frames=#self.Frames,
		Duracao=self.Duracao,
		FPS=self.FPS,
		Gravando=self.Gravando,
	}
end

return MotionCapture
]]></ProtectedString></Properties></Item>
