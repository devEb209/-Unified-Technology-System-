local function fixture()
	local now,sequence=0,0
	local allowed={[1]=true,[2]=true}
	local session=Session.new({project=Project.new(),authorize=function(id) return allowed[id]==true end,
		clock=function() return now end,token=function() sequence+=1;return "ticket-"..sequence end})
	return session,function(value) now=value end,allowed
end

test("server session denies unauthorized requests and spoofed payload identity",function()
	local s=fixture()
	rejects(function() s:handle(9,"execute",{userId=1,revision=0,operations={{op="add",node={kind="box"}}}}) end)
	eq(#s.project.state.order,0)
end)
test("collaborative revisions reject a stale second editor",function()
	local s=fixture()
	s:handle(1,"execute",{revision=0,operations={{op="add",node={kind="box"}}}})
	rejects(function() s:handle(2,"execute",{revision=0,operations={{op="add",node={kind="sphere"}}}}) end)
	eq(#s.project.state.order,1)
end)
test("request rate budget recovers with elapsed time",function()
	local s,clock=fixture()
	for _=1,20 do s:handle(1,"state",{}) end
	rejects(function() s:handle(1,"state",{}) end)
	clock(1);assert(s:handle(1,"state",{}).state)
end)
test("AI confirmation is mandatory and bound to requesting user",function()
	local s=fixture()
	local result=s:handle(1,"plan",{revision=0,prompt="crie um cubo"})
	eq(#s.project.state.order,0)
	rejects(function() s:handle(2,"applyPlan",{revision=0,token=result.token,confirm=true}) end)
	rejects(function() s:handle(1,"applyPlan",{revision=0,token=result.token}) end)
	s:handle(1,"applyPlan",{revision=0,token=result.token,confirm=true});eq(#s.project.state.order,1)
end)
test("client cannot replace stored AI operations at approval time",function()
	local s=fixture();local result=s:handle(1,"plan",{revision=0,prompt="crie um cubo"})
	s:handle(1,"applyPlan",{revision=0,token=result.token,confirm=true,operations={{op="delete",id="all"}}})
	eq(#s.project.state.order,1);eq(s.project.state.nodes[s.project.state.order[1]].kind,"box")
end)
test("AI previews expire without mutating the project",function()
	local s,clock=fixture();local result=s:handle(1,"plan",{revision=0,prompt="crie um cubo"});clock(91)
	rejects(function() s:handle(1,"applyPlan",{revision=0,token=result.token,confirm=true}) end);eq(#s.project.state.order,0)
end)
test("another edit invalidates an outstanding AI preview",function()
	local s=fixture();local result=s:handle(1,"plan",{revision=0,prompt="crie um cubo"})
	s:handle(2,"execute",{revision=0,operations={{op="add",node={kind="sphere"}}}})
	rejects(function() s:handle(1,"applyPlan",{revision=1,token=result.token,confirm=true}) end)
	eq(#s.project.state.order,1)
end)
test("provider failure releases the pending-request slot",function()
	local s=fixture();s.provider=function() error("provider failed") end
	rejects(function() s:handle(1,"plan",{revision=0,prompt="x",provider="remote"}) end)
	eq(s.busy[1],nil);assert(s:handle(1,"plan",{revision=0,prompt="crie um cubo"}).token)
end)
test("provider cannot bypass whole-plan validation",function()
	local s=fixture();s.provider=function() return {format="arkher.plan/1",label="bad",operations={{op="add",node={kind="box"}},{op="executeSource"}}} end
	rejects(function() s:handle(1,"plan",{revision=0,prompt="x",provider="remote"}) end)
	eq(#s.project.state.order,0);eq(s.plans[1],nil)
end)
test("edits during asynchronous-style planning invalidate its result",function()
	local s=fixture();s.provider=function()
		s.project:execute({{op="add",node={kind="sphere"}}},0)
		return {format="arkher.plan/1",label="stale",operations={{op="add",node={kind="box"}}}}
	end
	rejects(function() s:handle(1,"plan",{revision=0,prompt="x",provider="remote"}) end)
	eq(#s.project.state.order,1);eq(s.plans[1],nil)
end)
test("disconnected users cannot receive a reusable pending plan",function()
	local s,_,allowed=fixture();s.provider=function()
		allowed[1]=nil;s:removeUser(1)
		return {format="arkher.plan/1",label="old",operations={{op="add",node={kind="box"}}}}
	end
	rejects(function() s:handle(1,"plan",{revision=0,prompt="x",provider="remote"}) end)
	eq(s.plans[1],nil)
end)
test("play stop restores authored state and blocks live authoring edits",function()
	local s=fixture();s.project:execute({{op="add",node={kind="box",body={dynamic=true}}}},0)
	s:handle(1,"play",{revision=1});s:step(.05)
	rejects(function() s:handle(1,"execute",{revision=1,operations={{op="delete",id=s.project.state.order[1]}}}) end)
	local exported=s:handle(1,"export",{})
	eq(exported.state.nodes[exported.state.order[1]].transform.position.y,0)
	s:handle(1,"stop",{epoch=s.epoch});eq(s.mode,"edit");eq(s.project.state.nodes[s.project.state.order[1]].transform.position.y,0)
end)
test("disabled persistence never pretends a project was saved",function()
	local s=fixture();rejects(function() s:handle(1,"save",{revision=0}) end)
end)
test("DataStore adapter applies compare-and-swap and preserves an existing save",function()
	local data
	local backend={GetAsync=function() return data end,UpdateAsync=function(_,_,fn) local next=fn(data);if next then data=next end;return next end}
	local store=PlatformStore.new(backend,"project",function() return "small JSON fixture" end)
	eq(store:save(Schema.empty(),0,1),1)
	rejects(function() store:save(Schema.empty("overwrite"),0,2) end)
	eq(data.state.name,"Meu projeto ARKHER");eq(store:load().version,1)
end)
test("DataStore adapter rejects oversized and corrupt data",function()
	local touched=false
	local backend={GetAsync=function() return {format="unknown",version=1} end,UpdateAsync=function() touched=true end}
	local store=PlatformStore.new(backend,"p",function() return string.rep("x",3000001) end)
	rejects(function() store:save(Schema.empty(),0,1) end);eq(touched,false)
	rejects(function() store:load() end)
end)
test("failed load does not discard current authoring state",function()
	local s=fixture();add(s.project)
	s.storage={load=function() return {version=2,state={format="wrong"}} end}
	local before=s.project.state
	rejects(function() s:handle(1,"load",{revision=1}) end);eq(s.project.state,before);eq(s.busy.storage,nil)
end)
test("light parameters produce a valid project operation",function()
	local p=Project.new();local id=add(p,{kind="light"})
	p:execute({{op="light",id=id,patch={range=48,intensity=5}}},1)
	eq(p.state.nodes[id].light.range,48);eq(p.state.nodes[id].light.intensity,5)
end)
