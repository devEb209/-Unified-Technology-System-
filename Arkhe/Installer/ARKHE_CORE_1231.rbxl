     <Item class="ModuleScript" referent="RBX152922"><Properties><string name="Name">ClimateSystem</string><ProtectedString name="Source"><![CDATA[
local ClimateSystem = {}
function ClimateSystem.novo() return setmetatable({Temperatura=20, Umidade=0.5, Vento={X=1,Z=0, Forca=2}, Estacao="Verao"}, {__index=ClimateSystem}) end
function ClimateSystem:Tick(dt) self.Temperatura=self.Temperatura+math.sin(os.clock()*0.01)*0.01 end
function ClimateSystem:BiomaEm(x,z,altura)
  if altura>80 then return "Neve" elseif self.Umidade>0.7 then return "Floresta" elseif self.Temperatura>30 then return "Deserto" else return "Campo" end
end
function ClimateSystem:Serializar() return {Temp=self.Temperatura, Umidade=self.Umidade, Estacao=self.Estacao} end
return ClimateSystem
]]></ProtectedString></Properties></Item>
