    <Item class="Folder" referent="RBX380095">
     <Properties>
      <string name="Name">DO15</string>
     </Properties>
     <Item class="ModuleScript" referent="RBX125964"><Properties><string name="Name">DeviceProfile</string><ProtectedString name="Source"><![CDATA[--[[
	DeviceProfile (ModuleScript)
	Local: ReplicatedStorage > Arkhe > DO15 > DeviceProfile
	============================================================
	D-O15, parte 1: CONHECER O DISPOSITIVO.
	Nao existe "Low/Medium/High". Cada dispositivo informa sua
	capacidade REAL (frametime medio, memoria, plataforma) e recebe
	um ORCAMENTO DE MATERIALIZACAO em pontos. A mesma realidade se
	materializa diferente em cada aparelho — sem deixar de ser a mesma.

	Uso no cliente: DeviceProfile.MedirCliente() -> envia ao servidor
	Uso no servidor: DeviceProfile.CalcularOrcamento(metricas)
	============================================================
]]

local DeviceProfile = {}

-- ============ LADO CLIENTE ============
function DeviceProfile.MedirCliente()
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local Stats = game:GetService("Stats")

	-- mede frametime real por 3 segundos
	local amostras = 0
	local somaDt = 0
	local inicio = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		amostras = amostras + 1
		somaDt = somaDt + dt
	end)
	repeat task.wait(0.25) until os.clock() - inicio >= 3
	conn:Disconnect()

	local frametimeMedio = amostras > 0 and (somaDt / amostras) or 0.033
	local memoriaMB = 0
	pcall(function()
		memoriaMB = Stats:GetTotalMemoryUsageMb()
	end)

	local plataforma = "PC"
	if UserInputService.VREnabled then
		plataforma = "VR"
	elseif UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		plataforma = "Mobile"
	elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
		plataforma = "Console"
	end

	return {
		FrametimeMedio = frametimeMedio,
		MemoriaMB = memoriaMB,
		Plataforma = plataforma,
	}
end

-- ============ LADO SERVIDOR ============
-- Converte metricas reais em orcamento de pontos de materializacao
function DeviceProfile.CalcularOrcamento(metricas)
	if not metricas then
		return 1200 -- padrao conservador
	end
	local fps = 1 / math.max(0.008, metricas.FrametimeMedio or 0.033)

	-- base por plataforma (VR precisa de folga; mobile e conservador)
	local base
	if metricas.Plataforma == "VR" then
		base = 900
	elseif metricas.Plataforma == "Mobile" then
		base = 800
	elseif metricas.Plataforma == "Console" then
		base = 1600
	else
		base = 2000
	end

	-- desempenho REAL manda mais que a etiqueta da plataforma
	local fator
	if fps >= 55 then
		fator = 1.6
	elseif fps >= 40 then
		fator = 1.2
	elseif fps >= 28 then
		fator = 0.9
	else
		fator = 0.55
	end

	return math.floor(base * fator)
end

-- Orcamento dinamico: se o pior dispositivo do servidor sofre,
-- toda a materializacao compartilhada respeita esse limite
function DeviceProfile.OrcamentoServidor(orcamentosPorJogador)
	local menor = math.huge
	local algum = false
	for _, orc in pairs(orcamentosPorJogador) do
		algum = true
		if orc < menor then menor = orc end
	end
	if not algum then return 1500 end
	return menor
end

return DeviceProfile
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX889340"><Properties><string name="Name">Fidelity</string><ProtectedString name="Source"><![CDATA[--[[
	Fidelity (ModuleScript)
	Local: ReplicatedStorage > Arkhe > DO15 > Fidelity
	============================================================
	D-O15, parte 2: DECIDIR A REPRESENTACAO.
	Para cada entidade, calcula a RELEVANCIA (nao so distancia!):
	  - distancia ate o observador mais proximo
	  - tamanho aparente (coisa grande importa de longe)
	  - interatividade e interacao recente
	  - estado dramatico (algo EM CHAMAS importa muito!)
	  - campo de visao (atras do observador importa menos)
	Depois distribui o ORCAMENTO do dispositivo: as entidades mais
	relevantes ganham D3/D4, as medianas D2/D1, o resto vira D0
	(dado puro — continua existindo e sendo simulado!).
	============================================================
]]

local Fidelity = {}

local ALCANCE_MAXIMO = 700 -- alem disso, relevancia ~0 (mas a entidade VIVE)

function Fidelity.CalcularRelevancia(entidade, arquetipo, observadores)
	local melhor = 0
	for _, obs in ipairs(observadores) do
		local dx = entidade.Pos.X - obs.Pos.X
		local dy = entidade.Pos.Y - obs.Pos.Y
		local dz = entidade.Pos.Z - obs.Pos.Z
		local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
		if dist < ALCANCE_MAXIMO then
			-- proximidade: 1 perto, 0 longe (curva suave)
			local proximidade = 1 - (dist / ALCANCE_MAXIMO)
			proximidade = proximidade * proximidade

			-- tamanho aparente: estruturas grandes importam de longe
			local escala = 1
			if arquetipo.Categoria == "Estrutura" then
				escala = 1.6
			elseif arquetipo.Categoria == "Hidrologia" then
				escala = 1.4
			end

			-- campo de visao: atras do observador cai 40%
			local visao = 1
			if obs.Look and dist > 20 then
				local dot = (dx * obs.Look.X + dz * obs.Look.Z) / math.max(dist, 0.01)
				if dot < -0.3 then
					visao = 0.6
				end
			end

			local r = proximidade * escala * visao
			if r > melhor then melhor = r end
		end
	end

	-- estado dramatico domina: fogo/destruicao sao sempre relevantes
	if entidade.Estado.EmChamas then
		melhor = math.max(melhor, 0.85)
	end
	if entidade.Estado.Integridade < 0.5 and melhor > 0.05 then
		melhor = melhor * 1.3
	end
	-- interacao recente mantem detalhe
	if entidade.Estado.UltimaInteracao and (os.clock() - entidade.Estado.UltimaInteracao) < 20 then
		melhor = math.max(melhor, 0.7)
	end

	return math.min(melhor, 1.5)
end

-- Converte relevancia em nivel D desejado
local function nivelDesejado(relevancia)
	if relevancia >= 0.75 then
		return 4
	elseif relevancia >= 0.45 then
		return 3
	elseif relevancia >= 0.18 then
		return 2
	elseif relevancia >= 0.05 then
		return 1
	end
	return 0
end

-- Distribui o orcamento: retorna { [entidadeId] = nivelD }
function Fidelity.Planejar(entidades, Archetypes, observadores, orcamento)
	local candidatas = {}
	for _, e in ipairs(entidades) do
		local arq = Archetypes.Get(e.Arquetipo)
		if arq then
			e.Relevancia = Fidelity.CalcularRelevancia(e, arq, observadores)
			if e.Relevancia > 0.02 then
				table.insert(candidatas, e)
			else
				e._nivelPlanejado = 0
			end
		end
	end
	-- mais relevantes primeiro
	table.sort(candidatas, function(a, b)
		return a.Relevancia > b.Relevancia
	end)

	local plano = {}
	local gasto = 0
	for _, e in ipairs(candidatas) do
		local arq = Archetypes.Get(e.Arquetipo)
		local nivel = nivelDesejado(e.Relevancia)
		-- rebaixa o nivel ate caber no orcamento (nunca corta a existencia!)
		while nivel > 0 do
			local custo = arq.Custo[nivel] or 1
			if gasto + custo <= orcamento then
				gasto = gasto + custo
				break
			end
			nivel = nivel - 1
		end
		plano[e.Id] = nivel
		e._nivelPlanejado = nivel
	end
	return plano, gasto
end

return Fidelity
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX767209"><Properties><string name="Name">Materializer</string><ProtectedString name="Source"><![CDATA[--[[
	Materializer (ModuleScript)
	Local: ReplicatedStorage > Arkhe > DO15 > Materializer
	============================================================
	D-O15, parte 3: MATERIALIZAR.
	Recebe (entidade, nivel D) e constroi/troca/destroi a Instance.
	Cada arquetipo tem receitas por nivel — todas deterministicas
	pelo Seed da entidade (a mesma arvore e SEMPRE a mesma arvore,
	em qualquer dispositivo, em qualquer sessao).

	Trabalha em FATIAS por frame (nunca trava) e reusa um pool de
	Parts para evitar custo de criacao/GC.
	============================================================
]]

local Materia = require(script.Parent.Parent.RRW.Materia)

local Materializer = {}
Materializer.Pasta = nil
Materializer.FilaTrabalho = {}   -- { {Entidade, Nivel} }
Materializer.PorFrame = 6        -- entidades re-materializadas por frame

local function s(seed, salt)
	-- pseudo-random deterministico [0,1) a partir do seed da entidade
	local v = math.sin((seed * 127.1 + salt * 311.7) * 43758.5453)
	return v - math.floor(v)
end

local function faixa(seed, salt, minMax)
	return minMax[1] + s(seed, salt) * (minMax[2] - minMax[1])
end

local function novaParte(nome, tamanho, cf, materiaNome, variacao, pai)
	local p = Instance.new("Part")
	p.Name = nome
	p.Anchored = true
	p.CastShadow = tamanho.Magnitude > 4 -- sombras so no que importa
	p.Size = tamanho
	p.CFrame = cf
	Materia.AplicarAparencia(p, materiaNome, variacao)
	Materia.AplicarFisica(p, materiaNome)
	p.Parent = pai
	return p
end

-- ============ RECEITAS DE MATERIALIZACAO ============
-- Cada funcao recebe (entidade, arquetipo, nivel, model) e constroi.
local Receitas = {}

Receitas.Carvalho = function(e, arq, nivel, model)
	local seed = e.Seed
	local altura = faixa(seed, 1, arq.Forma.Altura)
	local raioT = faixa(seed, 2, arq.Forma.RaioTronco)
	local raioC = faixa(seed, 3, arq.Forma.RaioCopa)
	local base = CFrame.new(e.Pos.X, e.Pos.Y, e.Pos.Z)

	if nivel == 1 then
		-- impostor: 1 part verde vertical (silhueta)
		novaParte("Impostor", Vector3.new(raioC * 1.6, altura, raioC * 1.6),
			base * CFrame.new(0, altura / 2, 0), "Folhagem", seed, model)
	elseif nivel == 2 then
		novaParte("Tronco", Vector3.new(raioT * 2, altura * 0.55, raioT * 2),
			base * CFrame.new(0, altura * 0.275, 0), "MadeiraViva", seed, model)
		novaParte("Copa", Vector3.new(raioC * 2, altura * 0.5, raioC * 2),
			base * CFrame.new(0, altura * 0.75, 0), "Folhagem", seed, model)
	else -- 3 e 4
		novaParte("Tronco", Vector3.new(raioT * 2, altura * 0.6, raioT * 2),
			base * CFrame.new(0, altura * 0.3, 0), "MadeiraViva", seed, model)
		-- copa em 3 camadas irregulares
		for i = 1, 3 do
			local fatorY = 0.55 + i * 0.14
			local raio = raioC * (1.15 - i * 0.22)
			novaParte("Copa" .. i, Vector3.new(raio * 2, altura * 0.22, raio * 2),
				base * CFrame.new((s(seed, 10 + i) - 0.5) * raioT * 3, altura * fatorY,
					(s(seed, 20 + i) - 0.5) * raioT * 3)
				* CFrame.Angles(0, s(seed, 30 + i) * 3.14, 0),
				"Folhagem", seed + i * 0.1, model)
		end
		-- galhos no D3+
		for i = 1, 2 do
			local ang = s(seed, 40 + i) * 6.28
			novaParte("Galho" .. i, Vector3.new(raioT, raioC * 0.9, raioT),
				base * CFrame.new(math.cos(ang) * raioT * 2, altura * 0.5, math.sin(ang) * raioT * 2)
				* CFrame.Angles(0.6, ang, 0),
				"MadeiraViva", seed, model)
		end
	end
end
Receitas.Pinheiro = function(e, arq, nivel, model)
	local seed = e.Seed
	local altura = faixa(seed, 1, arq.Forma.Altura)
	local raioT = faixa(seed, 2, arq.Forma.RaioTronco)
	local raioC = faixa(seed, 3, arq.Forma.RaioCopa)
	local base = CFrame.new(e.Pos.X, e.Pos.Y, e.Pos.Z)
	if nivel == 1 then
		novaParte("Impostor", Vector3.new(raioC * 1.4, altura, raioC * 1.4),
			base * CFrame.new(0, altura / 2, 0), "Folhagem", seed, model)
	else
		novaParte("Tronco", Vector3.new(raioT * 2, altura * 0.4, raioT * 2),
			base * CFrame.new(0, altura * 0.2, 0), "MadeiraViva", seed, model)
		local camadas = (nivel >= 3) and 4 or 2
		for i = 1, camadas do
			local raio = raioC * (1.2 - (i / camadas) * 0.85)
			local y = altura * (0.3 + (i / camadas) * 0.65)
			novaParte("Copa" .. i, Vector3.new(raio * 2, altura * 0.18, raio * 2),
				base * CFrame.new(0, y, 0) * CFrame.Angles(0, i * 0.7, 0),
				"Folhagem", seed + i * 0.07, model)
		end
	end
end

Receitas.Rocha = function(e, arq, nivel, model)
	local seed = e.Seed
	local t = faixa(seed, 1, arq.Forma.Tamanho)
	local base = CFrame.new(e.Pos.X, e.Pos.Y, e.Pos.Z)
	local blocos = (nivel <= 1) and 1 or ((nivel == 2) and 2 or 3)
	for i = 1, blocos do
		local f = 1 - (i - 1) * 0.3
		novaParte("Rocha" .. i,
			Vector3.new(t * f * (0.8 + s(seed, i) * 0.5), t * f * 0.7, t * f * (0.8 + s(seed, i + 5) * 0.5)),
			base * CFrame.new((s(seed, i + 10) - 0.5) * t * 0.6, t * 0.25 * f,
				(s(seed, i + 15) - 0.5) * t * 0.6)
			* CFrame.Angles(s(seed, i + 20) * 0.4, s(seed, i + 25) * 3.14, s(seed, i + 30) * 0.4),
			"Granito", seed + i * 0.1, model)
	end
end
Receitas.AfloramentoFerro = function(e, arq, nivel, model)
	Receitas.Rocha(e, arq, nivel, model)
	if nivel >= 2 then
		local t = faixa(e.Seed, 1, arq.Forma.Tamanho)
		novaParte("VeioFerro", Vector3.new(t * 0.5, t * 0.4, t * 0.5),
			CFrame.new(e.Pos.X, e.Pos.Y + t * 0.5, e.Pos.Z) * CFrame.Angles(0.3, e.Seed * 6, 0.2),
			"Ferro", e.Seed, model)
	end
end

Receitas.CasaVila = function(e, arq, nivel, model)
	local seed = e.Seed
	local L = faixa(seed, 1, arq.Forma.Largura)
	local P = faixa(seed, 2, arq.Forma.Profundidade)
	local A = faixa(seed, 3, arq.Forma.Altura)
	local rot = math.floor(s(seed, 4) * 4) * 1.5708
	local base = CFrame.new(e.Pos.X, e.Pos.Y, e.Pos.Z) * CFrame.Angles(0, rot, 0)

	if nivel == 1 then
		novaParte("Impostor", Vector3.new(L, A, P), base * CFrame.new(0, A / 2, 0),
			"MadeiraSeca", seed, model)
		return
	end
	novaParte("Fundacao", Vector3.new(L + 1, 1, P + 1), base * CFrame.new(0, 0.5, 0), "Granito", seed, model)
	if nivel == 2 then
		novaParte("Corpo", Vector3.new(L, A * 0.7, P), base * CFrame.new(0, 1 + A * 0.35, 0), "MadeiraSeca", seed, model)
		novaParte("Telhado", Vector3.new(L + 1.5, A * 0.3, P + 1.5), base * CFrame.new(0, 1 + A * 0.85, 0), "Palha", seed, model)
	else
		-- D3+: paredes individuais, vao de porta, telhado em duas aguas
		local h = A * 0.65
		novaParte("ParedeFundo", Vector3.new(L, h, 0.6), base * CFrame.new(0, 1 + h / 2, -P / 2), "MadeiraSeca", seed, model)
		novaParte("ParedeEsq", Vector3.new(0.6, h, P), base * CFrame.new(-L / 2, 1 + h / 2, 0), "MadeiraSeca", seed, model)
		novaParte("ParedeDir", Vector3.new(0.6, h, P), base * CFrame.new(L / 2, 1 + h / 2, 0), "MadeiraSeca", seed, model)
		local vao = 2.4
		novaParte("FrenteEsq", Vector3.new((L - vao) / 2, h, 0.6),
			base * CFrame.new(-(vao + (L - vao) / 2) / 2, 1 + h / 2, P / 2), "MadeiraSeca", seed, model)
		novaParte("FrenteDir", Vector3.new((L - vao) / 2, h, 0.6),
			base * CFrame.new((vao + (L - vao) / 2) / 2, 1 + h / 2, P / 2), "MadeiraSeca", seed, model)
		novaParte("Verga", Vector3.new(vao, h * 0.25, 0.6),
			base * CFrame.new(0, 1 + h * 0.875, P / 2), "MadeiraSeca", seed, model)
		-- telhado duas aguas (wedges)
		for lado = -1, 1, 2 do
			local aba = Instance.new("WedgePart")
			aba.Anchored = true
			aba.Size = Vector3.new(L + 1.5, A * 0.35, P / 2 + 1)
			aba.CFrame = base * CFrame.new(0, 1 + h + A * 0.175, lado * (P / 4 + 0.25))
				* CFrame.Angles(0, (lado == 1) and 3.1416 or 0, 0)
			Materia.AplicarAparencia(aba, "Palha", seed)
			Materia.AplicarFisica(aba, "Palha")
			aba.Parent = model
		end
	end
end

Receitas.Tocha = function(e, arq, nivel, model)
	local seed = e.Seed
	local altura = faixa(seed, 1, arq.Forma.Altura)
	local base = CFrame.new(e.Pos.X, e.Pos.Y, e.Pos.Z)
	novaParte("Cabo", Vector3.new(0.3, altura, 0.3),
		base * CFrame.new(0, altura / 2, 0), "MadeiraSeca", seed, model)
	if nivel >= 2 then
		local ponta = novaParte("Ponta", Vector3.new(0.55, 0.55, 0.55),
			base * CFrame.new(0, altura + 0.2, 0), "Chama", seed, model)
		if nivel >= 4 then
			-- D4: fogo e luz REAIS (o caro fica so para quem esta perto)
			local fogo = Instance.new("Fire")
			fogo.Heat = 6
			fogo.Size = 4
			fogo.Parent = ponta
			local luz = Instance.new("PointLight")
			luz.Color = Color3.fromRGB(255, 170, 80)
			luz.Range = 22
			luz.Brightness = 1.4
			luz.Shadows = true
			luz.Parent = ponta
		end
	end
end

Receitas.Lago = function(e, arq, nivel, model)
	local seed = e.Seed
	local raio = faixa(seed, 1, arq.Forma.Raio)
	local prof = faixa(seed, 2, arq.Forma.Profundidade)
	local agua = novaParte("Agua", Vector3.new(raio * 2, prof, raio * 2),
		CFrame.new(e.Pos.X, e.Pos.Y - prof / 2 + 0.2, e.Pos.Z), "AguaDoce", seed, model)
	agua.CanCollide = false
	if nivel >= 3 then
		novaParte("Margem", Vector3.new(raio * 2.3, 0.4, raio * 2.3),
			CFrame.new(e.Pos.X, e.Pos.Y - prof, e.Pos.Z), "SoloFertil", seed, model)
	end
end

Receitas.CristalRessonante = function(e, arq, nivel, model)
	local seed = e.Seed
	local altura = faixa(seed, 1, arq.Forma.Altura)
	local base = CFrame.new(e.Pos.X, e.Pos.Y, e.Pos.Z)
	local n = (nivel <= 2) and 1 or 3
	for i = 1, n do
		local h = altura * (1 - (i - 1) * 0.3)
		novaParte("Cristal" .. i, Vector3.new(h * 0.25, h, h * 0.25),
			base * CFrame.new((s(seed, i) - 0.5) * altura * 0.5, h / 2, (s(seed, i + 3) - 0.5) * altura * 0.5)
			* CFrame.Angles(s(seed, i + 6) * 0.5, s(seed, i + 9) * 6.28, s(seed, i + 12) * 0.5),
			"CristalAether", seed + i * 0.1, model)
	end
	if nivel >= 4 then
		local luz = Instance.new("PointLight")
		luz.Color = Color3.fromRGB(150, 120, 255)
		luz.Range = 26
		luz.Brightness = 1.2
		luz.Parent = model:FindFirstChild("Cristal1")
	end
end

-- ============ NUCLEO ============
function Materializer.Inicializar(pastaWorkspace)
	Materializer.Pasta = pastaWorkspace
end

local function materializarAgora(e, arq, nivel)
	-- destroi a materializacao anterior
	if e.Instancia then
		e.Instancia:Destroy()
		e.Instancia = nil
	end
	e.Materializacao = nivel
	if nivel <= 0 then
		return -- D0: dado puro. A entidade segue viva na simulacao.
	end
	local model = Instance.new("Model")
	model.N]]></ProtectedString></Properties></Item>
