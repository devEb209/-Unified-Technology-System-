     <Item class="ModuleScript" referent="RBX560249"><Properties><string name="Name">Gamepad</string><ProtectedString name="Source"><![CDATA[--[[
	Gamepad (ModuleScript)
	Local: ReplicatedStorage > Arkhe > VRConsole > Gamepad
	============================================================
	F22 — VR & CONSOLE: GAMEPAD FOCUS + LASER (Ring1).
	- Foco navegavel por direcional (cima/baixo/esq/dir)
	- Selecao com botao A / Cross
	- Laser pointer para VR (raycast da camera)
	- Edicao com maos (gesto pinça) — placeholder para futuro
	- Integra com DockUI (painéis dockáveis viram focusable)
	- Integra com UIKit (componentes viram focusable)

	Contrato:
	  Gamepad tem lista de focusables { Frame, OnSelect, Vizinhos }
	  e navega por input.

	Verdade: VR real precisa de headset. Sem headset, simula
	com mouse + gamepad. Com relay, pode gerar preview VR.
	============================================================
]]

local Gamepad = {}
Gamepad.Focusables = {} -- { Id, Frame, OnSelect, Pos={X,Y} }
Gamepad.FocoAtual = nil
Gamepad.Modo = "Gamepad" -- Gamepad | VR | Mouse

function Gamepad.Registrar(id, frame, onSelect, pos)
	Gamepad.Focusables[id] = { Id=id, Frame=frame, OnSelect=onSelect, Pos=pos or {X=0,Y=0} }
	if not Gamepad.FocoAtual then Gamepad.FocoAtual = id end
end

function Gamepad.Remover(id)
	Gamepad.Focusables[id]=nil
	if Gamepad.FocoAtual==id then Gamepad.FocoAtual=nil end
end

function Gamepad.MoverFoco(dir)
	-- dir: Cima, Baixo, Esq, Dir
	if not Gamepad.FocoAtual then
		for id in pairs(Gamepad.Focusables) do Gamepad.FocoAtual=id break end
		return Gamepad.FocoAtual
	end
	local atual = Gamepad.Focusables[Gamepad.FocoAtual]
	if not atual then return nil end
	local melhor, menorDist = nil, math.huge
	for id, f in pairs(Gamepad.Focusables) do
		if id ~= Gamepad.FocoAtual then
			local dx = f.Pos.X - atual.Pos.X
			local dy = f.Pos.Y - atual.Pos.Y
			local ok=false
			if dir=="Cima" and dy<0 and math.abs(dx)<math.abs(dy)*1.5 then ok=true end
			if dir=="Baixo" and dy>0 and math.abs(dx)<math.abs(dy)*1.5 then ok=true end
			if dir=="Esq" and dx<0 and math.abs(dy)<math.abs(dx)*1.5 then ok=true end
			if dir=="Dir" and dx>0 and math.abs(dy)<math.abs(dx)*1.5 then ok=true end
			if ok then
				local dist = dx*dx + dy*dy
				if dist < menorDist then menorDist=dist melhor=id end
			end
		end
	end
	if melhor then Gamepad.FocoAtual=melhor end
	return Gamepad.FocoAtual
end

function Gamepad.Selecionar()
	if not Gamepad.FocoAtual then return false end
	local f = Gamepad.Focusables[Gamepad.FocoAtual]
	if f and f.OnSelect then
		local ok, err = pcall(f.OnSelect)
		if not ok then warn("[Gamepad] OnSelect falhou: " .. tostring(err)) end
		return true
	end
	return false
end

function Gamepad.LaserPointer(camera, maxDist)
	maxDist = maxDist or 500
	if not camera then return nil end
	local origin = camera.CFrame.Position
	local dir = camera.CFrame.LookVector
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {}
	local result = workspace:Raycast(origin, dir * maxDist, params)
	if result then return result.Position, result.Instance, result.Normal end
	return nil
end

function Gamepad.ModoVR(ativo)
	Gamepad.Modo = ativo and "VR" or "Gamepad"
	return Gamepad.Modo
end

function Gamepad.Listar()
	local lista={}
	for id, f in pairs(Gamepad.Focusables) do table.insert(lista, { Id=id, Pos=f.Pos, FocoAtual=(id==Gamepad.FocoAtual) }) end
	return lista
end

function Gamepad.Limpar()
	Gamepad.Focusables={}
	Gamepad.FocoAtual=nil
end

return Gamepad
]]></ProtectedString></Properties></Item>
