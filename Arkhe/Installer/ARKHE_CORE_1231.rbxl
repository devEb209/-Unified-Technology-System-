     <Item class="ModuleScript" referent="RBX432474"><Properties><string name="Name">RaycastBrush</string><ProtectedString name="Source"><![CDATA[--[[
	RaycastBrush (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Terrain > RaycastBrush
	============================================================
	F4 — TERRAIN RAYCAST PINCEL (Ring1).
	Pincel por CLIQUE: raycast da camera/mouse para o chao,
	retorna posicao XYZ no mundo para esculpir HeightField.

	Antes: pincel usava posicao do jogador (HumanoidRootPart).
	Agora: usa raycast real (Workspace:Raycast) para precisao.

	Uso server:
	  local pos = RaycastBrush.RaycastDoJogador(player, 500)
	  if pos then campo:Pincel("Elevar", pos.X, pos.Z, raio, forca) end

	Uso client:
	  local mousePos = UserInputService:GetMouseLocation()
	  local ray = workspace.CurrentCamera:ViewportPointToRay(mousePos.X, mousePos.Y)
	  local pos = RaycastBrush.Raycast(ray, 1000)
	============================================================
]]

local RaycastBrush = {}

function RaycastBrush.Raycast(rayOrigin, rayDir, maxDist, params)
	maxDist = maxDist or 1000
	local RaycastParams = RaycastParams.new()
	RaycastParams.FilterType = Enum.RaycastFilterType.Exclude
	RaycastParams.FilterDescendantsInstances = params and params.Filter or {}
	RaycastParams.IgnoreWater = false
	local result = workspace:Raycast(rayOrigin, rayDir * maxDist, RaycastParams)
	if result then
		return result.Position, result.Normal, result.Instance
	end
	return nil
end

function RaycastBrush.RaycastDoJogador(player, maxDist)
	maxDist = maxDist or 500
	local char = player.Character
	if not char then return nil end
	local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
	if not head then return nil end
	-- raycast da cabeca na direcao do lookVector
	local origin = head.Position
	local dir = (char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.CFrame.LookVector or Vector3.new(0,0,-1))
	-- tenta para baixo tambem se nao acertar
	local pos, normal, inst = RaycastBrush.Raycast(origin, dir, maxDist)
	if not pos then
		-- raycast para baixo (chao)
		pos, normal, inst = RaycastBrush.Raycast(origin, Vector3.new(0,-1,0), maxDist)
	end
	return pos, normal, inst
end

function RaycastBrush.RaycastDaCamera(camera, mouseX, mouseY, maxDist)
	maxDist = maxDist or 1000
	if not camera then return nil end
	local ray = camera:ViewportPointToRay(mouseX, mouseY)
	return RaycastBrush.Raycast(ray.Origin, ray.Direction, maxDist)
end

function RaycastBrush.AplicarPincelNoPonto(campo, pos, operacao, raio, forca)
	if not campo or not pos then return nil end
	operacao = operacao or "Elevar"
	raio = raio or 40
	forca = forca or 8
	local x0, z0, x1, z1 = campo:Pincel(operacao, pos.X, pos.Z, raio, forca)
	return x0, z0, x1, z1
end

return RaycastBrush
]]></ProtectedString></Properties></Item>
