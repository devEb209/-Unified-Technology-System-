function PropertiesRobloxFull.novo()
    return setmetatable({Props={}}, {__index=PropertiesRobloxFull})
end

function PropertiesRobloxFull:Contar() return #self.AllProperties end
function PropertiesRobloxFull:Listar() return self.AllProperties end
function PropertiesRobloxFull:Buscar(classe)
    local res={}
    for _, p in ipairs(self.AllProperties) do
        if p.Classe==classe then table.insert(res,p) end
    end
    return res
end
function PropertiesRobloxFull:Serializar() return {Total=#self.AllProperties, Classes=138} end

