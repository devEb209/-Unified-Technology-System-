     <Item class="ModuleScript" referent="RBX771219"><Properties><string name="Name">Kernel</string><ProtectedString name="Source"><![CDATA[--[[
	Kernel (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Kernel > Kernel
	============================================================
	O NUCLEO DA ARKHE — onde os "5000+ sistemas" se tornam possiveis.
	Tudo na engine e um MODULO registrado aqui. Plugins de devs
	registram, estendem e ATE SUBSTITUEM modulos — liberdade de 95%.

	ANEIS DE PERMISSAO (a regra 95% / 5%):
	  Ring0 (5% critico — INTOCAVEL pelo dev):
	    Publisher, RelayAuth, DataCore, AntiCheat, KernelCore
	  Ring1 (95% — liberdade TOTAL local):
	    todo o resto: editores, materializador, fisica, UI, toolbox,
	    receitas, arquetipos, presets... o dev pode ler, modificar,
	    substituir e redistribuir localmente.
	============================================================
]]

local Kernel = {}
Kernel.Modulos = {}        -- [nome] = { Modulo, Ring, Dono, Versao }
Kernel.Extensoes = {}      -- [nomeModulo] = { fn, fn, ... } (hooks)
Kernel.Eventos = {}        -- barramento global de eventos da engine

local RING0 = {
	KernelCore = true, Publisher = true, RelayAuth = true,
	DataCore = true, AntiCheat = true,
}

-- ============ REGISTRO DE MODULOS ============
function Kernel.Registrar(nome, modulo, opcoes)
	opcoes = opcoes or {}
	local existente = Kernel.Modulos[nome]
	local ring = RING0[nome] and 0 or 1

	if existente then
		-- substituicao: so permitida em Ring1 (a liberdade dos 95%)
		if existente.Ring == 0 then
			warn("[Kernel] '" .. nome .. "' e Ring0 (nucleo critico). Substituicao negada.")
			return false
		end
		Kernel.Emitir("ModuloSubstituido", { Nome = nome, Por = opcoes.Dono or "dev" })
	end

	Kernel.Modulos[nome] = {
		Modulo = modulo,
		Ring = ring,
		Dono = opcoes.Dono or "Arkhe",
		Versao = opcoes.Versao or "1.0",
	}
	Kernel.Emitir("ModuloRegistrado", { Nome = nome })
	return true
end

function Kernel.Obter(nome)
	local reg = Kernel.Modulos[nome]
	return reg and reg.Modulo or nil
end

function Kernel.Listar()
	local lista = {}
	for nome, reg in pairs(Kernel.Modulos) do
		table.insert(lista, {
			Nome = nome, Ring = reg.Ring, Dono = reg.Dono, Versao = reg.Versao,
			Modificavel = reg.Ring ~= 0,
		})
	end
	table.sort(lista, function(a, b) return a.Nome < b.Nome end)
	return lista
end

-- ============ EXTENSOES (hooks sem substituir) ============
-- Um plugin pode ESTENDER qualquer modulo Ring1: recebe chamadas
-- antes/depois sem mexer no original.
function Kernel.Estender(nomeModulo, hook)
	if RING0[nomeModulo] then
		warn("[Kernel] Nao e possivel estender Ring0: " .. nomeModulo)
		return false
	end
	Kernel.Extensoes[nomeModulo] = Kernel.Extensoes[nomeModulo] or {}
	table.insert(Kernel.Extensoes[nomeModulo], hook)
	return true
end

function Kernel.ChamarExtensoes(nomeModulo, evento, dados)
	local hooks = Kernel.Extensoes[nomeModulo]
	if hooks then
		for _, hook in ipairs(hooks) do
			local ok, err = pcall(hook, evento, dados)
			if not ok then
				warn("[Kernel] Extensao de " .. nomeModulo .. " falhou: " .. tostring(err))
			end
		end
	end
end

-- ============ BARRAMENTO DE EVENTOS DA ENGINE ============
function Kernel.Ouvir(evento, callback)
	Kernel.Eventos[evento] = Kernel.Eventos[evento] or {}
	table.insert(Kernel.Eventos[evento], callback)
end

function Kernel.Emitir(evento, dados)
	local lista = Kernel.Eventos[evento]
	if lista then
		for _, cb in ipairs(lista) do
			task.spawn(cb, dados)
		end
	end
end

-- ============ PLUGINS (o dev cria, usa local, e PODE publicar) ============
-- Um plugin Arkhe e uma tabela:
-- { Nome, Autor, Versao, Descricao,
--   AoCarregar = function(kernel) ... end,
--   Paineis = { {Titulo, Construir=function(dock) ...} },   -- UI propria!
--   Condicoes = {...}, Acoes = {...},                        -- EventScript!
--   Arquetipos = {...} }                                     -- RRW!
Kernel.Plugins = {}

function Kernel.CarregarPlugin(plugin)
	if type(plugin) ~= "table" or type(plugin.Nome) ~= "string" then
		return false, "Plugin invalido"
	end
	if Kernel.Plugins[plugin.Nome] then
		return false, "Plugin ja carregado"
	end
	Kernel.Plugins[plugin.Nome] = plugin

	-- registra as contribuicoes do plugin em cada subsistema
	local EventScript = Kernel.Obter("EventScript")
	if EventScript then
		for nome, fn in pairs(plugin.Condicoes or {}) do
			EventScript.RegistrarCondicao(nome, fn)
		end
		for nome, fn in pairs(plugin.Acoes or {}) do
			EventScript.RegistrarAcao(nome, fn)
		end
	end
	local Archetypes = Kernel.Obter("Archetypes")
	if Archetypes then
		for nome, def in pairs(plugin.Arquetipos or {}) do
			Archetypes.Registrar(nome, def)
		end
	end
	if plugin.AoCarregar then
		local ok, err = pcall(plugin.AoCarregar, Kernel)
		if not ok then
			warn("[Kernel] Plugin '" .. plugin.Nome .. "' falhou ao carregar: " .. tostring(err))
		end
	end
	Kernel.Emitir("PluginCarregado", { Nome = plugin.Nome, Autor = plugin.Autor })
	print("[Kernel] Plugin carregado: " .. plugin.Nome .. " (" .. tostring(plugin.Autor) .. ")")
	return true
end

return Kernel
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX82902"><Properties><string name="Name">PluginSystem</string><ProtectedString name="Source"><![CDATA[[[
	PluginSystem (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Kernel > PluginSystem
	============================================================
	F1 — SISTEMA DE PLUGINS AVANÇADO (Ring1 95% livre)
	- Plugin: { Nome, Versao, Autor, Dependencias, Modulos, Ativo }
	- Ciclo: Registrar -> Carregar -> Ativar -> Desativar -> Descarregar
	- Hot-reload: recarrega sem reiniciar engine
	- Dependências: verifica se modulos requeridos existem
	- Marketplace: instala plugin do marketplace como dados
	============================================================
]]

local PluginSystem = {}
PluginSystem.__index = PluginSystem

function PluginSystem.novo()
	local self = setmetatable({}, PluginSystem)
	self.Plugins = {} -- [nome] = plugin
	self.Carregados = {} -- [nome] = true
	self.Ativos = {} -- [nome] = true
	self.Historico = {} -- { Quando, Acao, Plugin }
	return self
end

function PluginSystem:Registrar(nome, versao, autor, modulos, dependencias)
	modulos = modulos or {}
	dependencias = dependencias or {}
	self.Plugins[nome] = {
		Nome=nome,
		Versao=versao or "1.0.0",
		Autor=autor or "Arkhe",
		Modulos=modulos, -- { "Condicao:MinhaCond", "Acao:MinhaAcao", "Painel:MeuPainel" }
		Dependencias=dependencias,
		Ativo=false,
		Carregado=false,
		RegistradoEm=os.time(),
	}
	return self.Plugins[nome]
end

function PluginSystem:VerificarDependencias(nome)
	local plugin = self.Plugins[nome]
	if not plugin then return false, "Plugin não encontrado" end
	for _, dep in ipairs(plugin.Dependencias) do
		if not self.Plugins[dep] or not self.Carregados[dep] then
			return false, "Falta dependência: "..dep
		end
	end
	return true
end

function PluginSystem:Carregar(nome, kernel)
	local plugin = self.Plugins[nome]
	if not plugin then return false, "Não encontrado" end
	local ok, err = self:VerificarDependencias(nome)
	if not ok then return false, err end
	-- simula carregamento: registra modulos no kernel
	if kernel and kernel.Registrar then
		for _, mod in ipairs(plugin.Modulos) do
			-- mod formato "Tipo:Nome"
			-- aqui apenas loga
		end
	end
	plugin.Carregado = true
	self.Carregados[nome] = true
	table.insert(self.Historico, { Quando=os.time(), Acao="Carregar", Plugin=nome })
	if #self.Historico > 50 then table.remove(self.Historico,1) end
	return true
end

function PluginSystem:Ativar(nome)
	local plugin = self.Plugins[nome]
	if not plugin or not plugin.Carregado then return false, "Não carregado" end
	plugin.Ativo = true
	self.Ativos[nome] = true
	table.insert(self.Historico, { Quando=os.time(), Acao="Ativar", Plugin=nome })
	if #self.Historico > 50 then table.remove(self.Historico,1) end
	return true
end

function PluginSystem:Desativar(nome)
	local plugin = self.Plugins[nome]
	if not plugin then return false end
	plugin.Ativo = false
	self.Ativos[nome] = nil
	table.insert(self.Historico, { Quando=os.time(), Acao="Desativar", Plugin=nome })
	return true
end

function PluginSystem:Descarregar(nome)
	local plugin = self.Plugins[nome]
	if not plugin then return false end
	plugin.Carregado = false
	plugin.Ativo = false
	self.Carregados[nome] = nil
	self.Ativos[nome] = nil
	table.insert(self.Historico, { Quando=os.time(), Acao="Descarregar", Plugin=nome })
	return true
end

function PluginSystem:HotReload(nome, kernel)
	self:Descarregar(nome)
	task.wait(0.1)
	local ok, err = self:Carregar(nome, kernel)
	if ok then self:Ativar(nome) end
	return ok, err
end

function PluginSystem:InstalarDoMarketplace(dadosMarketplace)
	-- dados: { Nome, Versao, Autor, Modulos, Desc }
	return self:Registrar(dadosMarketplace.Nome, dadosMarketplace.Versao, dadosMarketplace.Autor, dadosMarketplace.Modulos, dadosMarketplace.Dependencias)
end

function PluginSystem:Listar()
	local lista={}
	for nome, p in pairs(self.Plugins) do
		table.insert(lista, { Nome=nome, Versao=p.Versao, Autor=p.Autor, Ativo=p.Ativo, Carregado=p.Carregado, Modulos=#p.Modulos })
	end
	return lista
end

function PluginSystem:Stats()
	local total=0; local ativos=0; local carregados=0
	for _ in pairs(self.Plugins) do total=total+1 end
	for _ in pairs(self.Ativos) do ativos=ativos+1 end
	for _ in pairs(self.Carregados) do carregados=carregados+1 end
	return { Total=total, Ativos=ativos, Carregados=carregados, Historico=#self.Historico }
end

function PluginSystem:Serializar()
	return { Stats=self:Stats(), Plugins=self:Listar() }
end

return PluginSystem
]]></ProtectedString></Properties></Item>
