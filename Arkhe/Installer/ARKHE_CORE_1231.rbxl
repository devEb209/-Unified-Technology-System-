     <Item class="ModuleScript" referent="RBX912991"><Properties><string name="Name">Inventory</string><ProtectedString name="Source"><![CDATA[--[[
	Inventory (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Economy > Inventory
	============================================================
	F18 — KIT ECONOMIA: INVENTARIO (Ring1).
	Inventario por jogador (ou por entidade RRW) com:
	- Slots com stack (max 99 por item)
	- Peso/capacidade (opcional)
	- Equip (arma, armadura) que muda atributos
	- Eventos: OnAdd, OnRemove, OnEquip
	- Integra com EventScript: condicao InventarioTem, acao DarItem/RemoverItem
	- Serializavel (DataStore)
	- Receita: itens podem ser arquetipos RRW com materia

	Exemplo:
	  local inv = Inventory.novo(20) -- 20 slots
	  inv:Adicionar("Madeira", 10)
	  inv:Tem("Madeira", 5) → true
	============================================================
]]

local Inventory = {}
Inventory.__index = Inventory

function Inventory.novo(maxSlots, maxPeso)
	local self = setmetatable({}, Inventory)
	self.MaxSlots = maxSlots or 20
	self.MaxPeso = maxPeso or 100
	self.Itens = {} -- [nome] = { Qtd, PesoUnit, Equipavel, Atributos }
	self.PesoAtual = 0
	self.Equipados = {} -- [slotEquip] = nomeItem
	self._onAdd = {}
	self._onRemove = {}
	return self
end

function Inventory:RegistrarItem(nome, def)
	-- def = { Peso=0.5, Equipavel=false, Slot="Mao", Atributos={Dano=5} }
	def = def or {}
	self.Itens[nome] = self.Itens[nome] or { Qtd=0, Def=def }
	self.Itens[nome].Def = def
end

function Inventory:Adicionar(nome, qtd, def)
	qtd = qtd or 1
	self.Itens[nome] = self.Itens[nome] or { Qtd=0, Def=def or { Peso=0.5 } }
	local pesoAdd = (self.Itens[nome].Def.Peso or 0.5) * qtd
	if self.PesoAtual + pesoAdd > self.MaxPeso then return false, "peso_excedido" end
	-- conta slots distintos
	local slotsUsados = 0
	for _ in pairs(self.Itens) do slotsUsados = slotsUsados + 1 end
	if not self.Itens[nome] or self.Itens[nome].Qtd == 0 then
		if slotsUsados >= self.MaxSlots and (self.Itens[nome] == nil or self.Itens[nome].Qtd==0) then
			-- verifica se é novo slot
			local existe = self.Itens[nome] and self.Itens[nome].Qtd > 0
			if not existe and slotsUsados >= self.MaxSlots then return false, "inventario_cheio" end
		end
	end
	self.Itens[nome].Qtd = self.Itens[nome].Qtd + qtd
	self.PesoAtual = self.PesoAtual + pesoAdd
	for _, fn in ipairs(self._onAdd) do pcall(fn, nome, qtd) end
	return true
end

function Inventory:Remover(nome, qtd)
	qtd = qtd or 1
	local entry = self.Itens[nome]
	if not entry or entry.Qtd < qtd then return false, "sem_item" end
	entry.Qtd = entry.Qtd - qtd
	self.PesoAtual = self.PesoAtual - (entry.Def.Peso or 0.5) * qtd
	if entry.Qtd <= 0 then self.Itens[nome]=nil end
	for _, fn in ipairs(self._onRemove) do pcall(fn, nome, qtd) end
	return true
end

function Inventory:Tem(nome, qtd)
	qtd = qtd or 1
	local entry = self.Itens[nome]
	return entry and entry.Qtd >= qtd or false
end

function Inventory:Listar()
	local lista = {}
	for nome, data in pairs(self.Itens) do
		table.insert(lista, { Nome=nome, Qtd=data.Qtd, Peso=data.Def.Peso or 0.5, Equipavel=data.Def.Equipavel or false })
	end
	table.sort(lista, function(a,b) return a.Nome < b.Nome end)
	return lista
end

function Inventory:Equipar(nome)
	local entry = self.Itens[nome]
	if not entry or not entry.Def.Equipavel then return false, "nao_equipavel" end
	local slot = entry.Def.Slot or "Mao"
	self.Equipados[slot] = nome
	return true
end

function Inventory:Desequipar(slot)
	slot = slot or "Mao"
	self.Equipados[slot] = nil
	return true
end

function Inventory:AtributosEquipados()
	local total = {}
	for slot, nome in pairs(self.Equipados) do
		local entry = self.Itens[nome]
		if entry and entry.Def.Atributos then
			for k,v in pairs(entry.Def.Atributos) do total[k] = (total[k] or 0) + v end
		end
	end
	return total
end

function Inventory:OnAdd(fn) table.insert(self._onAdd, fn) end
function Inventory:OnRemove(fn) table.insert(self._onRemove, fn) end

function Inventory:Serializar()
	local ser = { MaxSlots=self.MaxSlots, MaxPeso=self.MaxPeso, Itens={}, Equipados=self.Equipados }
	for nome, data in pairs(self.Itens) do ser.Itens[nome] = { Qtd=data.Qtd, Def=data.Def } end
	return ser
end

function Inventory.Deserializar(dados)
	local inv = Inventory.novo(dados.MaxSlots, dados.MaxPeso)
	inv.Equipados = dados.Equipados or {}
	for nome, d in pairs(dados.Itens or {}) do inv.Itens[nome] = { Qtd=d.Qtd, Def=d.Def } end
	-- recalc peso
	local peso=0
	for _, data in pairs(inv.Itens) do peso = peso + (data.Def.Peso or 0.5)*data.Qtd end
	inv.PesoAtual = peso
	return inv
end

return Inventory
]]></ProtectedString></Properties></Item>
