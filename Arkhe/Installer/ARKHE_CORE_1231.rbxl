     <Item class="ModuleScript" referent="RBX453605"><Properties><string name="Name">ClipExporter</string><ProtectedString name="Source"><![CDATA[--[[
	ClipExporter (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Cinematic > ClipExporter
	============================================================
	F17 — EXPORT COMO CLIP + INTEGRAÇÃO CURVEEDITOR
	- Exporta TimelineEditor + TimelineVisual + CameraSpline
	  para AnimationClip unificado
	- Clip: { Nome, Duracao, Tracks { Faixa->{ Tempo, Valor, Easing } } }
	- Formatos: ArkheClip JSON, Roblox KeyframeSequence (via relay)
	- Integra com CurveEditor para easing por track
	============================================================
]]

local ClipExporter = {}
ClipExporter.__index = ClipExporter

function ClipExporter.novo(nome)
	local self = setmetatable({}, ClipExporter)
	self.Nome = nome or "Clip_"..math.random(1000,9999)
	self.Fontes = {} -- { Tipo, Ref, Faixa }
	return self
end

function ClipExporter:AdicionarFonte(tipo, ref, faixa)
	-- tipo: TimelineEditor, TimelineVisual, CameraSpline, CurveVisual
	table.insert(self.Fontes, { Tipo=tipo, Ref=ref, Faixa=faixa or "Geral" })
	return #self.Fontes
end

function ClipExporter:Exportar(duracao)
	duracao = duracao or 10
	local clip = {
		Nome=self.Nome,
		Duracao=duracao,
		Tracks={},
		Fontes=#self.Fontes,
		CriadoEm=os.time(),
	}
	for _, fonte in ipairs(self.Fontes) do
		local ref = fonte.Ref
		local faixa = fonte.Faixa
		clip.Tracks[faixa] = clip.Tracks[faixa] or {}
		if fonte.Tipo=="TimelineEditor" and ref.Avaliar then
			-- amostra timeline a cada 0.1s
			for t=0, duracao, 0.1 do
				local ok, val = pcall(function() return ref:Avaliar(faixa, t) end)
				if ok and val then
					table.insert(clip.Tracks[faixa], { Tempo=t, Valor=val, Fonte="TimelineEditor" })
				end
			end
		elseif fonte.Tipo=="TimelineVisual" and ref.Avaliar then
			for t=0, duracao, 0.1 do
				local val = ref:Avaliar(faixa, t)
				if val then
					table.insert(clip.Tracks[faixa], { Tempo=t, Valor=val, Fonte="TimelineVisual" })
				end
			end
		elseif fonte.Tipo=="CameraSpline" and ref.Pontos then
			for _, ponto in ipairs(ref.Pontos or {}) do
				table.insert(clip.Tracks[faixa], { Tempo=ponto.Tempo or 0, Valor=ponto.Pos, FOV=ponto.FOV, Fonte="CameraSpline" })
			end
		elseif fonte.Tipo=="CurveVisual" and ref.Pontos then
			for _, p in ipairs(ref.Pontos) do
				table.insert(clip.Tracks[faixa], { Tempo=p.T*duracao, Valor=p.Valor, Fonte="CurveVisual" })
			end
		end
	end
	return clip
end

function ClipExporter:ParaJSON(clip)
	local ok, HttpService = pcall(function() return game:GetService("HttpService") end)
	if not ok then return nil end
	local ok2, json = pcall(function() return HttpService:JSONEncode(clip) end)
	return ok2 and json or nil
end

function ClipExporter:PayloadParaRelay(clip, formato)
	formato = formato or "arkhe_clip"
	return {
		Nome=clip.Nome,
		Duracao=clip.Duracao,
		Tracks=clip.Tracks,
		Formato=formato, -- arkhe_clip, roblox_keyframe, fbx
		Opcoes={
			FPS=30,
			Loop=false,
			Otimizar=true,
		}
	}
end

function ClipExporter:Serializar()
	return {
		Nome=self.Nome,
		Fontes=#self.Fontes,
	}
end

return ClipExporter
]]></ProtectedString></Properties></Item>
