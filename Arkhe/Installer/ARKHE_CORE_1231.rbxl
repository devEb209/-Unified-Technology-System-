     <Item class="ModuleScript" referent="RBX20741"><Properties><string name="Name">RigCustom</string><ProtectedString name="Source"><![CDATA[--[[
  RigCustom (ModuleScript)
  Local: ReplicatedStorage > Arkhe > NPC > RigCustom
  ============================================================================
  Rigs personalizados - além de R6/R15 do Roblox
  - Rigs custom: Dragão, Aranha, Quadrúpede, Ave, Serpente, Humanoide Avançado
  - Melhor que Roblox nativo
  - Ícones custom sem emojis
  ============================================================================
]]

local RigCustom = {}
RigCustom.__index = RigCustom

RigCustom.Tipos = {
  R6={Bones=6, Desc="Roblox padrão 6 bones"},
  R15={Bones=15, Desc="Roblox padrão 15 bones"},
  -- CUSTOM
  HumanoideAvancado={Bones=35, Desc="35 bones com dedos, facial, twist", Custom=true},
  Quadrupede={Bones=28, Desc="Cavalo, lobo, gato - 4 patas", Custom=true},
  Dragao={Bones=48, Desc="Dragão com asas, cauda, pescoço longo", Custom=true},
  Aranha={Bones=32, Desc="8 patas com IK", Custom=true},
  Ave={Bones=22, Desc="Ave com asas articuladas", Custom=true},
  Serpente={Bones=25, Desc="Serpente com spine chain", Custom=true},
  AranhaGigante={Bones=40, Desc="Aranha gigante com presas", Custom=true},
  Robo={Bones=20, Desc="Robô com pistões", Custom=true},
  Esqueleto={Bones=30, Desc="Esqueleto com costelas", Custom=true},
  CustomLivre={Bones=100, Desc="100 bones livres", Custom=true},
}

function RigCustom.novo(tipo)
  tipo=tipo or "HumanoideAvancado"
  return setmetatable({Tipo=tipo, Def=RigCustom.Tipos[tipo], Bones={}, IK=true}, {__index=RigCustom})
end

function RigCustom:Gerar()
  local def=self.Def or RigCustom.Tipos.HumanoideAvancado
  local bones={}
  for i=1, def.Bones do table.insert(bones, {Id=i, Nome="Bone_"..i, Pos={X=0,Y=i*0.5,Z=0}}) end
  self.Bones=bones
  return {Tipo=self.Tipo, Bones=bones, Total=def.Bones, Custom=def.Custom}
end

function RigCustom:Listar() return RigCustom.Tipos end
function RigCustom:ListarCustom() local r={} for k,v in pairs(RigCustom.Tipos) do if v.Custom then r[k]=v end end return r end
function RigCustom:Serializar() return {Tipo=self.Tipo, TotalBones=self.Def and self.Def.Bones or 0, Custom=self.Def and self.Def.Custom or false} end

return RigCustom
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX79033"><Properties><string name="Name">RigFactory</string><ProtectedString name="Source"><![CDATA[--[[
	RigFactory (ModuleScript)
	Local: ReplicatedStorage > Arkhe > NPC > RigFactory
	============================================================
	F7 — FABRICA DE RIGS da Arkhe (dos TXTs do repositorio!).
	Constroi personagens BLOCKY R6 e QUADRUPEDES por codigo puro:
	parts + Motor6D, zero assets externos — roda ate no Lite.

	- CriarR6(config): humanoide classico com proporcoes
	  parametricas (altura, largura, cabeca) — aldeao, guarda,
	  gigante, crianca: mesmo rig, proporcoes diferentes
	- CriarQuadrupede(config): fera de 4 patas (lobo, javali...)
	- Animacao PROCEDURAL de caminhada (seno nos Motor6D) —
	  VERDADE: sem Animator nativo em rig custom de servidor,
	  entao a Arkhe anima na mao (e fica bom e barato)
	- Billboard de nome/emocao integrado
	============================================================
]]

local RigFactory = {}

local function parte(nome, tamanho, cor, pai)
	local p = Instance.new("Part")
	p.Name = nome
	p.Size = tamanho
	p.Color = cor
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = pai
	return p
end

local function motor(nome, p0, p1, c0, c1)
	local m = Instance.new("Motor6D")
	m.Name = nome
	m.Part0 = p0
	m.Part1 = p1
	m.C0 = c0
	m.C1 = c1
	m.Parent = p0
	return m
end

-- ============ R6 BLOCKY PARAMETRICO ============
-- config: Nome, Altura (escala 0.6..2.5), Largura, CorPele, CorTorso,
--         CorPernas, CorCabelo, Pos
function RigFactory.CriarR6(config)
	local esc = config.Altura or 1
	local lar = config.Largura or 1
	local pele = config.CorPele or Color3.fromRGB(234, 192, 156)
	local torsoCor = config.CorTorso or Color3.fromRGB(90, 110, 160)
	local pernaCor = config.CorPernas or Color3.fromRGB(70, 70, 80)

	local modelo = Instance.new("Model")
	modelo.Name = config.Nome or "NPC"

	local hrp = parte("HumanoidRootPart", Vector3.new(2 * lar, 2 * esc, 1), torsoCor, modelo)
	hrp.Transparency = 1
	hrp.CanCollide = false

	local torso = parte("Torso", Vector3.new(2 * lar, 2 * esc, 1), torsoCor, modelo)
	local cabeca = parte("Head", Vector3.new(2 * lar * 0.6, esc, esc), pele, modelo)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Head
	mesh.Scale = Vector3.new(1.25, 1.25, 1.25)
	mesh.Parent = cabeca
	local rosto = Instance.new("Decal")
	rosto.Name = "face"
	rosto.Texture = "rbxasset://textures/face.png"
	rosto.Parent = cabeca

	local bracoD = parte("Right Arm", Vector3.new(lar, 2 * esc, 1), pele, modelo)
	local bracoE = parte("Left Arm", Vector3.new(lar, 2 * esc, 1), pele, modelo)
	local pernaD = parte("Right Leg", Vector3.new(lar, 2 * esc, 1), pernaCor, modelo)
	local pernaE = parte("Left Leg", Vector3.new(lar, 2 * esc, 1), pernaCor, modelo)

	motor("RootJoint", hrp, torso, CFrame.new(), CFrame.new())
	motor("Neck", torso, cabeca, CFrame.new(0, esc, 0), CFrame.new(0, -esc * 0.5, 0))
	motor("Right Shoulder", torso, bracoD,
		CFrame.new(lar * 1.5, esc * 0.5, 0), CFrame.new(0, esc * 0.5, 0))
	motor("Left Shoulder", torso, bracoE,
		CFrame.new(-lar * 1.5, esc * 0.5, 0), CFrame.new(0, esc * 0.5, 0))
	motor("Right Hip", torso, pernaD,
		CFrame.new(lar * 0.5, -esc, 0), CFrame.new(0, esc, 0))
	motor("Left Hip", torso, pernaE,
		CFrame.new(-lar * 0.5, -esc, 0), CFrame.new(0, esc, 0))

	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R6
	hum.WalkSpeed = 10
	hum.MaxHealth = 100
	hum.Health = 100
	hum.Parent = modelo

	modelo.PrimaryPart = hrp
	hrp.CFrame = CFrame.new((config.Pos or Vector3.new(0, 10, 0)) + Vector3.new(0, 3 * esc + 1, 0))
	return modelo
end

-- ============ QUADRUPEDE (fera) ============
function RigFactory.CriarQuadrupede(config)
	local esc = config.Altura or 1
	local cor = config.CorTorso or Color3.fromRGB(105, 85, 65)

	local modelo = Instance.new("Model")
	modelo.Name = config.Nome or "Fera"

	local hrp = parte("HumanoidRootPart", Vector3.new(2 * esc, 1.6 * esc, 4 * esc), cor, modelo)
	hrp.Transparency = 1
	hrp.CanCollide = false
	local corpo = parte("Corpo", Vector3.new(2 * esc, 1.6 * esc, 4 * esc), cor, modelo)
	local cabeca = parte("Head", Vector3.new(1.4 * esc, 1.2 * esc, 1.4 * esc), cor, modelo)

	motor("RootJoint", hrp, corpo, CFrame.new(), CFrame.new())
	motor("Neck", corpo, cabeca,
		CFrame.new(0, 0.6 * esc, -2.2 * esc), CFrame.new(0, -0.2 * esc, 0.4 * esc))

	local patas = {}
	for i, off in ipairs({
		Vector3.new(0.7, -1.2, -1.4), Vector3.new(-0.7, -1.2, -1.4),
		Vector3.new(0.7, -1.2, 1.4), Vector3.new(-0.7, -1.2, 1.4),
	}) do
		local pata = parte("Pata" .. i, Vector3.new(0.5 * esc, 1.4 * esc, 0.5 * esc),
			cor:Lerp(Color3.new(0, 0, 0), 0.25), modelo)
		motor("MotorPata" .. i, corpo, pata,
			CFrame.new(off.X * esc, off.Y * esc * 0.55, off.Z * esc),
			CFrame.new(0, 0.7 * esc, 0))
		table.insert(patas, pata)
	end

	local hum = Instance.new("Humanoid")
	hum.WalkSpeed = 14
	hum.HipHeight = 1.4 * esc
	hum.MaxHealth = 120
	hum.Health = 120
	hum.Parent = modelo

	modelo.PrimaryPart = hrp
	hrp.CFrame = CFrame.new((config.Pos or Vector3.new(0, 10, 0)) + Vector3.new(0, 2.5 * esc, 0))
	return modelo
end

-- ============ BILLBOARD (nome + emocao) ============
function RigFactory.Billboard(modelo, nome)
	local cabeca = modelo:FindFirstChild("Head")
	if not cabeca then return nil end
	local bb = Instance.new("BillboardGui")
	bb.Name = "ArkheNome"
	bb.Size = UDim2.new(0, 130, 0, 34)
	bb.StudsOffset = Vector3.new(0, 2.2, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 90
	bb.Parent = cabeca
	local lbl = Instance.new("TextLabel")
	lbl.Name = "Texto"
	lbl.Size = UDim2.new(1, 0, 1, 0)
	lbl.BackgroundTransparency = 1
	lbl.TextColor3 = Color3.fromRGB(235, 235, 245)
	lbl.TextStrokeTransparency = 0.3
	lbl.TextScaled = true
	lbl.Font = Enum.Font.GothamBold
	lbl.Text = nome
	lbl.Parent = bb
	return lbl
end

-- ============ CAMINHADA PROCEDURAL ============
-- Chame com fase acumulada; balanca bracos/pernas (R6) ou patas
function RigFactory.AnimarPasso(modelo, fase, andando)
	local torso = modelo:FindFirstChild("Torso") or modelo:FindFirstChild("Corpo")
	if not torso then return end
	local amp = andando and 0.8 or 0
	local s = math.sin(fase) * amp
	for _, m in ipairs(torso:GetChildren()) do
		if m:IsA("Motor6D") then
			if m.Name == "Right Shoulder" or m.Name == "Left Hip"
				or m.Name == "MotorPata1" or m.Name == "MotorPata4" then
				m.Transform = CFrame.Angles(s, 0, 0)
			elseif m.Name == "Left Shoulder" or m.Name == "Right Hip"
				or m.Name == "MotorPata2" or m.Name == "MotorPata3" then
				m.Transform = CFrame.Angles(-s, 0, 0)
			end
		end
	end
end

return RigFactory
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX838468"><Properties><string name="Name">Schedule</string><ProtectedString name="Source"><![CDATA[
local Schedule = {}
function Schedule.novo() return setmetatable({Nome="Schedule", Ativo=true, Dados={}}, {__index=Schedule}) end
function Schedule:Ativar() self.Ativo=true end
function Schedule:Desativar() self.Ativo=false end
function Schedule:Tick(dt) end
function Schedule:Serializar() return {Nome=self.Nome, Ativo=self.Ativo} end
return Schedule
]]></ProtectedString></Properties></Item>
