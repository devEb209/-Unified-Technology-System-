]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX299874"><Properties><string name="Name">PainelAccessibility</string><ProtectedString name="Source"><![CDATA[--[[
	PainelAccessibility (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > PainelAccessibility
	============================================================
	F19 + F22 — ACESSIBILIDADE + VR/CONSOLE
	============================================================
]]

local PainelAccessibility = {}

function PainelAccessibility.Construir(DockUI, remotes, P)
	P.Acess = DockUI.CriarPainel({
		Titulo = "Acess",
		Largura = 340,
		Altura = 560,
		Posicao = UDim2.new(1, -360, 0, 1080),
		AoAbrir = function(painel)
			painel.Limpar()
			painel.Texto("ACESSIBILIDADE — F19 + F22", DockUI.Tema.Destaque)
			painel.Texto("Fonte, contraste, daltonico, remapeamento, gamepad/VR.", DockUI.Tema.TextoFraco)

			local cfg = remotes.GenesisConsulta:InvokeServer("AccessibilityConfig")
			if cfg then
				painel.Texto("Fonte: " .. cfg.FonteEscala .. "x | AltoContraste: " .. tostring(cfg.AltoContraste) .. " | Daltonico: " .. tostring(cfg.Daltonico), DockUI.Tema.TextoFraco)
				for acao, tecla in pairs(cfg.Teclas or {}) do
					painel.Texto(acao .. " → " .. tecla, DockUI.Tema.TextoFraco)
				end
			end

			painel.Texto("— FONTE —", DockUI.Tema.Destaque)
			painel.Botao("A- Fonte 0.8x", function() remotes.GenesisAcao:FireServer("AccessibilityFonte", 0.8) end)
			painel.Botao("A Fonte 1.0x", function() remotes.GenesisAcao:FireServer("AccessibilityFonte", 1.0) end)
			painel.Botao("A+ Fonte 1.5x", function() remotes.GenesisAcao:FireServer("AccessibilityFonte", 1.5) end)
			painel.Botao("A++ Fonte 2.0x", function() remotes.GenesisAcao:FireServer("AccessibilityFonte", 2.0) end)

			painel.Botao("🌓 Alternar alto contraste", function()
				local cur = cfg and cfg.AltoContraste or false
				remotes.GenesisAcao:FireServer("AccessibilityAltoContraste", not cur)
				task.wait(0.2)
				painel.Alternar(true)
			end)

			painel.Texto("— REMAPEAR TECLAS —", DockUI.Tema.Destaque)
			local acoes = remotes.GenesisConsulta:InvokeServer("AccessibilityAcoes")
			for _, ac in ipairs(acoes or {}) do
				local campo = painel.Campo(ac .. " → nova tecla")
				painel.Botao("Remapear " .. ac, function()
					if campo.Text ~= "" then
						remotes.GenesisAcao:FireServer("AccessibilityRemapear", ac, campo.Text)
						task.wait(0.2)
						painel.Alternar(true)
					end
				end)
			end

			painel.Texto("— NARRACAO TTS (F19) —", DockUI.Tema.Destaque)
			local narrInfo = remotes.GenesisConsulta:InvokeServer("NarrationInfo")
			if narrInfo then
				painel.Texto("Voz: "..(narrInfo.Voz or "?").." | Fila: "..(narrInfo.FilaCount or 0).." | Hist: "..(narrInfo.HistoricoCount or 0), DockUI.Tema.TextoFraco)
			end
			local textoNarr = painel.Campo("Texto para narrar (ex: Bem-vindo a Arkhe)")
			painel.Botao("🔊 Falar (via relay TTS ou fallback texto)", function()
				if textoNarr.Text ~= "" then remotes.GenesisAcao:FireServer("NarrationFalar", textoNarr.Text, 1) end
			end)
			painel.Botao("🗑️ Limpar fila narracao", function() remotes.GenesisAcao:FireServer("NarrationLimpar") end)
			local vozCampo = painel.Campo("Voz (ex: pt-BR-Female, en-US-Male)")
			painel.Botao("🎙️ Definir voz", function()
				if vozCampo.Text ~= "" then remotes.GenesisAcao:FireServer("NarrationVoz", vozCampo.Text) end
			end)

			painel.Texto("— GAMEPAD / VR + LASER —", DockUI.Tema.Destaque)
			local gamepad = remotes.GenesisConsulta:InvokeServer("GamepadLista")
			painel.Texto("Focusables: " .. #(gamepad or {}) , DockUI.Tema.TextoFraco)
			painel.Abas({ "Cima", "Baixo", "Esq", "Dir" }, function(dir)
				remotes.GenesisAcao:FireServer("GamepadMoverFoco", dir)
			end)
			painel.Botao("✅ Selecionar (A)", function() remotes.GenesisAcao:FireServer("GamepadSelecionar") end)
			painel.Botao("🥽 Alternar modo VR", function() remotes.GenesisAcao:FireServer("GamepadModoVR", true) end)

			local laserModos = remotes.GenesisConsulta:InvokeServer("LaserLista") or {}
			for _, m in ipairs(laserModos) do
				painel.Botao("🔦 Laser "..m.Nome.." — "..m.Desc, function()
					remotes.GenesisAcao:FireServer("LaserModo", m.Nome)
				end)
			end
			painel.Botao("🎯 Laser apontar agora (raycast RRW+terreno)", function()
				remotes.GenesisAcao:FireServer("LaserApontar")
			end)

			painel.Botao("✦ IA FAZ: deixe meu jogo acessivel", function()
				remotes.GenesisAcao:FireServer("IAMensagem", "Torne meu jogo acessivel: aumente fonte para 1.5x, ative alto contraste opcional, remapeie teclas para ESDF, configure gamepad focus para todos os botoes da HUD e ative narracao TTS com voz pt-BR-Female. Use Accessibility, Gamepad, Narration e LaserPointer.")
			end)

			painel.Texto("Verdade: TTS real precisa de relay (POST /accessibility/tts) ou SoundIds pre-gravados. Sem relay, usa legendas + IA texto.", DockUI.Tema.TextoFraco)
		end,
	})
	return P
end

return PainelAccessibility
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX872150"><Properties><string name="Name">PainelAnimator</string><ProtectedString name="Source"><![CDATA[--[[
	PainelAnimator (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > PainelAnimator
	============================================================
	F6 — PAINEL DO ANIMATOR (Ring1).
	Timeline, keyframes, IK, retarget, blend, gravacao por
	puppeteering (pose ao vivo).
	Padrao: ✋ EU FACO / ✦ IA FAZ
	============================================================
]]

local PainelAnimator = {}

function PainelAnimator.Construir(DockUI, remotes, P)
	P.Animator = DockUI.CriarPainel({
		Titulo = "Animar",
		Largura = 360,
		Altura = 600,
		Posicao = UDim2.new(0, 10, 0, 10),
		AoAbrir = function(painel)
			painel.Limpar()
			painel.Texto("ANIMATOR ARKHE — Cascadeur + Blender (categoria)", DockUI.Tema.Destaque)
			painel.Texto("Timeline com keyframes, IK 2 ossos e FABRIK, retarget R6/R15/custom, blend, e gravacao ao vivo.", DockUI.Tema.TextoFraco)

			local info = remotes.GenesisConsulta:InvokeServer("AnimatorInfo")
			if info then
				painel.Texto("Clip: " .. (info.Clip or "nenhum") .. " | " .. (info.Duracao or 0) .. "s | " .. (info.Tracks or 0) .. " ossos | " .. (info.Keyframes or 0) .. " kfs", DockUI.Tema.TextoFraco)
				painel.Texto("Tocando: " .. tostring(info.Tocando) .. " | Tempo: " .. string.format("%.2f", info.Tempo or 0), DockUI.Tema.TextoFraco)
			end

			painel.Texto("— CLIP —", DockUI.Tema.Destaque)
			local nomeClip = painel.Campo("Nome do clip (ex: Correr, Atacar)")
			painel.Botao("+ Novo clip 2s", function()
				if nomeClip.Text ~= "" then
					remotes.GenesisAcao:FireServer("AnimatorNovoClip", nomeClip.Text, 2)
					task.wait(0.2)
					painel.Alternar(true)
				end
			end, DockUI.Tema.Destaque)

			local clips = remotes.GenesisConsulta:InvokeServer("AnimatorListaClips")
			for _, c in ipairs(clips or {}) do
				painel.Botao("🎬 " .. c.Nome .. " (" .. c.Duracao .. "s, " .. c.Tracks .. " ossos)", function()
					remotes.GenesisAcao:FireServer("AnimatorSelecionarClip", c.Nome)
					task.wait(0.1)
					painel.Alternar(true)
				end)
			end

			painel.Texto("— PLAYBACK —", DockUI.Tema.Destaque)
			painel.Botao("▶ Play", function() remotes.GenesisAcao:FireServer("AnimatorPlay") end)
			painel.Botao("⏸ Pause", function() remotes.GenesisAcao:FireServer("AnimatorPause") end)
			painel.Botao("⏹ Stop", function() remotes.GenesisAcao:FireServer("AnimatorStop") end)
			painel.Botao("⏩ Scrub +0.5s", function() remotes.GenesisAcao:FireServer("AnimatorScrub", 0.5) end)

			painel.Texto("— KEYFRAMES —", DockUI.Tema.Destaque)
			painel.Botao("➕ Add keyframe do meu personagem agora (puppeteering)", function()
				remotes.GenesisAcao:FireServer("AnimatorGravarPose", 0)
			end, DockUI.Tema.Destaque)
			painel.Botao("🦶 IK: pe no chao (2 ossos)", function()
				remotes.GenesisAcao:FireServer("AnimatorIK", "PernaD", 1, 1)
			end)
			painel.Botao("✋ IK: mao no alvo (FABRIK 3 ossos)", function()
				remotes.GenesisAcao:FireServer("AnimatorIK", "BracoD", 3, 1)
			end)

			painel.Texto("— CURVAS DE EASING (CurveEditor) —", DockUI.Tema.Destaque)
			local curvas = remotes.GenesisConsulta:InvokeServer("AnimatorCurvas") or {}
			local ossoCampo = painel.Campo("Osso (ex: Torso, Left Leg)")
			for _, cur in ipairs(curvas) do
				painel.Botao("〰 " .. cur.Nome .. " — " .. cur.Desc, function()
					if ossoCampo.Text ~= "" then
						remotes.GenesisAcao:FireServer("AnimatorCurvaAplicar", cur.Nome, ossoCampo.Text)
					end
				end)
			end
			painel.Botao("📈 Ver amostra curva atual (log IA)", function()
				local amostra = remotes.GenesisConsulta:InvokeServer("AnimatorCurvaAmostra", "SineInOut")
				remotes.GenesisAcao:FireServer("IAMensagem", "Amostra curva SineInOut: "..tostring(#(amostra or {})).." pontos")
			end)

			painel.Texto("— RETARGET & BLEND —", DockUI.Tema.Destaque)
			painel.Botao("🔄 Retarget R6→R15", function()
				remotes.GenesisAcao:FireServer("AnimatorRetarget", "R6", "R15")
			end)
			painel.Botao("🔄 Retarget R15→R6", function()
				remotes.GenesisAcao:FireServer("AnimatorRetarget", "R15", "R6")
			end)
			painel.Botao("🎭 Blend com clip (0.5)", function()
				remotes.GenesisAcao:FireServer("AnimatorBlend", 0.5)
			end)

			painel.Texto("— QUEM DECIDE? —", DockUI.Tema.Destaque)
			painel.Botao("✦ IA FAZ: anime meu NPC andando (ciclo)", function()
				remotes.GenesisAcao:FireServer("IAMensagem", "Crie uma animacao de caminhada em loop para R6 no Animator (timeline 1.2s, keyframes de pernas alternadas, easing QuadInOut, com IK de pes fincados). Use referencia real de ciclo de caminhada.")
			end)
			painel.Botao("✦ IA FAZ: anime ataque com fisica (Cascadeur)", function()
				remotes.GenesisAcao:FireServer("IAMensagem", "Crie animacao de ataque com fisica-assistida estilo Cascadeur: pose balistica de espada, ragdoll ativo sugere movimento, retarget para R15 e custom.")
			end)

			painel.Texto("— EXPORTAR —", DockUI.Tema.Destaque)
			painel.Botao("📦 Exportar clip (CFrames)", function()
				remotes.GenesisAcao:FireServer("AnimatorExportar")
			end)
			painel.Botao("🗑 Limpar clip atual", function()
				remotes.GenesisAcao:FireServer("AnimatorLimpar")
				task.wait(0.1)
				painel.Alternar(true)
			end, DockUI.Tema.Perigo)

			painel.Texto("Verdade: sem Animator nativo em rig custom de servidor, Arkhe anima Motor6D na mao (igual NPCBrain). Com EditableMesh futuro, interpola vertices.", DockUI.Tema.TextoFraco)
		end,
	})
	return P
end

return PainelAnimator
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX397641"><Properties><string name="Name">PainelAudio</string><ProtectedString name="Source"><![CDATA[--[[
	PainelAudio (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > PainelAudio
	============================================================
	F15 — PAINEL DE AUDIO (Ring1).
	- Zonas de audio (caixa)
	- Musica global com crossfade
	- Musica adaptativa por estado (Exploracao/Combate/Noite/Perigo/Vitoria)
	- Sons por materia RRW (Madeira/Rocha/Metal/Cristal...)
	- Volume master/musica/efeitos
	- Lista catalogo de sons materiais

	Padrao: ✋ EU FACO / ✦ IA FAZ
	============================================================
]]

local PainelAudio = {}

function PainelAudio.Construir(DockUI, remotes, P)
	P.Audio = DockUI.CriarPainel({
		Titulo = "Audio",
		Largura = 360,
		Altura = 580,
		Posicao = UDim2.new(0.5, -180, 0, 380),
		AoAbrir = function(painel)
			painel.Limpar()
			painel.Texto("AUDIO MIXER — F15", DockUI.Tema.Destaque)
			painel.Texto("Zonas com musica diferente, musica adaptativa e sons por materia RRW. Max 8 sons 3D simultaneos.", DockUI.Tema.TextoFraco)

			local info = remotes.GenesisConsulta:InvokeServer("AudioInfo")
			if info then
				painel.Texto("Master: " .. string.format("%.0f%%", (info.Master or 1)*100) .. " | Musica: " .. string.format("%.0f%%", (info.Musica or 0.8)*100) .. " | Efeitos: " .. string.format("%.0f%%", (info.Efeitos or 1)*100), DockUI.Tema.TextoFraco)
				painel.Texto("Zonas: " .. (info.NumZonas or 0) .. " | Musica atual: " .. (info.MusicaAtual or "nenhuma"), DockUI.Tema.TextoFraco)
			end

			painel.Texto("— ZONAS —", DockUI.Tema.Destaque)
			local zonas = remotes.GenesisConsulta:InvokeServer("AudioZonas")
			for _, z in ipairs(zonas or {}) do
				painel.Texto("🔊 " .. z.Nome .. " Raio " .. z.Raio .. " MusicaId " .. tostring(z.MusicaId or "—"), DockUI.Tema.TextoFraco)
			end
			local campoZonaNome = painel.Campo("Nome zona (ex: Floresta)")
			local campoZonaRaio = painel.Campo("Raio (ex: 60)")
			local campoZonaMusica = painel.Campo("MusicaId (rbxassetid)")
			painel.Botao("＋ Criar zona na minha posicao", function()
				if campoZonaNome.Text ~= "" then
					remotes.GenesisAcao:FireServer("AudioCriarZona", campoZonaNome.Text, tonumber(campoZonaRaio.Text) or 60, tonumber(campoZonaMusica.Text))
				end
			end)

			painel.Texto("— MUSICA GLOBAL —", DockUI.Tema.Destaque)
			local campoMusicaId = painel.Campo("MusicId (ex: 1843527676)")
			local campoVol = painel.Campo("Volume 0..1 (ex: 0.8)")
			campoVol.Text = "0.8"
			painel.Botao("▶ Tocar musica global (crossfade)", function()
				local id = tonumber(campoMusicaId.Text)
				if id then remotes.GenesisAcao:FireServer("AudioTocarMusica", id, tonumber(campoVol.Text) or 0.8) end
			end)
			painel.Abas({ "Exploracao", "Combate", "Noite", "Perigo", "Vitoria" }, function(estado)
				remotes.GenesisAcao:FireServer("AudioAdaptativa", estado)
			end)

			painel.Texto("— SONS POR MATERIA —", DockUI.Tema.Destaque)
			local mats = remotes.GenesisConsulta:InvokeServer("AudioMateriais")
			for _, m in ipairs(mats or {}) do
				painel.Texto(m.Materia .. "." .. m.Evento .. " → " .. m.Id, DockUI.Tema.TextoFraco)
			end
			local campoMat = painel.Campo("Materia (Madeira/Rocha/Metal/Cristal...)")
			local campoEv = painel.Campo("Evento (Passo/Impacto/Quebra/Fogo)")
			campoEv.Text = "Impacto"
			local campoSound = painel.Campo("SoundId")
			painel.Botao("Registrar som materia", function()
				if campoMat.Text ~= "" and campoSound.Text ~= "" then
					remotes.GenesisAcao:FireServer("AudioRegistrarMat", campoMat.Text, campoEv.Text, tonumber(campoSound.Text))
				end
			end)
			painel.Botao("💥 Tocar som 3D aqui (teste)", function()
				remotes.GenesisAcao:FireServer("AudioTeste3D", 12222025)
			end)

			painel.Texto("— VOLUME —", DockUI.Tema.Destaque)
			painel.Botao("🔉 Master 50%", function() remotes.GenesisAcao:FireServer("AudioVolume", 0.5, nil, nil) end)
			painel.Botao("🔊 Master 100%", function() remotes.GenesisAcao:FireServer("AudioVolume", 1, nil, nil) end)

			painel.Botao("✦ IA FAZ: crie atmosfera de floresta noturna", function()
				remotes.GenesisAcao:FireServer("IAMensagem", "Crie atmosfera sonora de floresta noturna: zona Floresta com musica ambiente escura, sons de madeira para passos, cristal para vento, e musica adaptativa Noite. Use AudioMixer e MaterialSounds.")
			end)

			painel.Texto("Verdade: Roblox limita Sound simultaneos. Mixer controla orcamento (max 8 sons 3D) e faz crossfade suave.", DockUI.Tema.TextoFraco)
		end,
	})
	return P
end

return PainelAudio
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX882362"><Properties><string name="Name">PainelCinematic</string><ProtectedString name="Source"><![CDATA[--[[
	PainelCinematic (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > PainelCinematic
	============================================================
	F17 — PAINEL CINEMATICA (Ring1) 70%:
	- CameraSpline Catmull-Rom
	- TimelineEditor 5 faixas + keyframes
	============================================================
]]

local PainelCinematic = {}

function PainelCinematic.Construir(DockUI, remotes, P)
	P.Cinematic = DockUI.CriarPainel({
		Titulo = "Cinema",
		Largura = 380,
		Altura = 620,
		Posicao = UDim2.new(0.5, -190, 0, 900),
		AoAbrir = function(painel)
			painel.Limpar()
			painel.Texto("CINEMATICA — F17 70%", DockUI.Tema.Destaque)
			painel.Texto("Splines Catmull-Rom + TimelineEditor 5 faixas.", DockUI.Tema.TextoFraco)

			painel.Texto("— SPLINES (CameraSpline) —", DockUI.Tema.Destaque)
			local lista = remotes.GenesisConsulta:InvokeServer("CinematicLista")
			for _, s in ipairs(lista or {}) do
				painel.Texto("🎬 " .. s.Nome .. " " .. s.Duracao .. "s " .. s.Pontos .. " pts", DockUI.Tema.TextoFraco)
				painel.Botao("▶ Play " .. s.Nome, function() remotes.GenesisAcao:FireServer("CinematicPlay", s.Nome) end)
				painel.Botao("⏹ Stop " .. s.Nome, function() remotes.GenesisAcao:FireServer("CinematicStop", s.Nome) end)
				painel.Botao("＋ Ponto aqui", function() remotes.GenesisAcao:FireServer("CinematicAddPonto", s.Nome, 70, 3) end)
			end
			local campoNome = painel.Campo("Nome cutscene (ex: IntroVila)")
			painel.Botao("Criar cutscene", function()
				if campoNome.Text ~= "" then
					remotes.GenesisAcao:FireServer("CinematicNovo", campoNome.Text)
					task.wait(0.2)
					painel.Alternar(true)
				end
			end)

			painel.Texto("— TIMELINE EDITOR (F17) —", DockUI.Tema.Destaque)
			local tlLista = remotes.GenesisConsulta:InvokeServer("TimelineLista") or {}
			for _, tl in ipairs(tlLista) do
				painel.Texto("🎞 " .. tl.Nome .. " " .. tl.Duracao .. "s " .. tl.TotalKeyframes .. " KFs", DockUI.Tema.TextoFraco)
				local detalhe = remotes.GenesisConsulta:InvokeServer("TimelineFaixas", tl.Nome) or {}
				for _, faixa in ipairs(detalhe) do
					painel.Texto("  " .. faixa.Nome .. ": " .. faixa.Count .. " KFs", DockUI.Tema.TextoFraco)
				end
				painel.Botao("▶ Play Timeline " .. tl.Nome, function()
					remotes.GenesisAcao:FireServer("TimelinePlay", tl.Nome)
				end)
			end
			local campoTl = painel.Campo("Nome timeline (ex: CenaBoss)")
			local campoDur = painel.Campo("Duracao seg (ex: 15)")
			painel.Botao("＋ Nova Timeline", function()
				if campoTl.Text ~= "" then
					remotes.GenesisAcao:FireServer("TimelineNovo", campoTl.Text, tonumber(campoDur.Text) or 10)
					task.wait(0.2)
					painel.Alternar(true)
				end
			end)
			painel.Abas({ "Camera","Visual","Audio","NPC","Evento" }, function(faixa)
				-- add KF na timeline selecionada ou CenaIntro
				local nomeTl = campoTl.Text ~= "" and campoTl.Text or "CenaIntro"
				remotes.GenesisAcao:FireServer("TimelineAddKF", nomeTl, faixa, 0)
				task.wait(0.2)
				painel.Alternar(true)
			end)

			painel.Botao("✦ IA FAZ: cutscene epica com timeline", function()
				remotes.GenesisAcao:FireServer("IAMensagem", "Crie uma timeline 'VilaEpica' 20s com faixas: Camera 4 KFs (aerea, praca, tocha, close), Visual 2 KFs (Fantasia->Realista), Audio 1 KF, NPC 2 KFs. Depois exporte para spline e toque.")
			end)

			painel.Texto("Timeline exporta para CameraSpline Catmull-Rom + dispara Visual/Audio nos eventos.", DockUI.Tema.TextoFraco)
		end,
	})
	return P
end

return PainelCinematic
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX764897"><Properties><string name="Name">PainelEconomy</string><ProtectedString name="Source"><![CDATA[--[[
	PainelEconomy (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > PainelEconomy
	============================================================
	F18 — PAINEL ECONOMIA: Inventario + Loja + Quests
	============================================================
]]

local PainelEconomy = {}

function PainelEconomy.Construir(DockUI, remotes, P)
	P.Economia = DockUI.CriarPainel({
		Titulo = "Economia",
		Largura = 380,
		Altura = 600,
		Posicao = UDim2.new(0, 10, 0, 900),
		AoAbrir = function(painel)
			painel.Limpar()
			painel.Texto("ECONOMIA & RPG KITS — F18", DockUI.Tema.Destaque)
			painel.Texto("Inventario, loja, quests. Tudo vira EventScript sem codigo.", DockUI.Tema.TextoFraco)

			local inv = remotes.GenesisConsulta:InvokeServer("EconomiaInventario")
			if inv then
				painel.Texto("— INVENTARIO (" .. #inv .. " itens) —", DockUI.Tema.Destaque)
				for _, it in ipairs(inv) do
					painel.Texto(it.Nome .. " x" .. it.Qtd .. (it.Equipavel and " [equipavel]" or ""), DockUI.Tema.TextoFraco)
				end
			end

			local shop = remotes.GenesisConsulta:InvokeServer("EconomiaLoja")
			if shop then
				painel.Texto("— LOJA: " .. (shop.Nome or "Loja") .. " —", DockUI.Tema.Destaque)
				for _, it in ipairs(shop.Itens or {}) do
					painel.Botao(it.Nome .. " — " .. it.PrecoFinal .. " R$k (estoque " .. tostring(it.Estoque) .. ")", function()
						remotes.GenesisAcao:FireServer("EconomiaComprar", it.Nome)
					end)
				end
			end

			painel.Texto("— ADICIONAR ITEM NA LOJA —", DockUI.Tema.Destaque)
			local campoItem = painel.Campo("Nome item (ex: EspadaMadeira)")
			local campoPreco = painel.Campo("Preco (ex: 50)")
			painel.Botao("Adicionar na loja", function()
				if campoItem.Text ~= "" then
					remotes.GenesisAcao:FireServer("EconomiaLojaAdd", campoItem.Text, tonumber(campoPreco.Text) or 50)
					task.wait(0.2)
					painel.Alternar(true)
				end
			end)

			local quests = remotes.GenesisConsulta:InvokeServer("EconomiaQuests")
			if quests then
				painel.Texto("— QUESTS ATIVAS —", DockUI.Tema.Destaque)
				for _, q in ipairs(quests.Ativas or {}) do
					painel.Texto("📜 " .. q.Nome .. " " .. (q.Completa and "✅" or ("(" .. (function() local s=0 for _,o in ipairs(q.Objetivos or {}) do s=s+o.Atual/o.Qtd end return math.floor(s/#q.Objetivos*100) end)() .. "%)")), DockUI.Tema.TextoFraco)
					for _, obj in ipairs(q.Objetivos or {}) do
						painel.Texto("  - " .. obj.Desc .. " " .. obj.Atual .. "/" .. obj.Qtd, DockUI.Tema.TextoFraco)
					end
				end
				if #quests.Disponiveis>0 then
					painel.Texto("— QUESTS DISPONIVEIS —", DockUI.Tema.Destaque)
					for _, q in ipairs(quests.Disponiveis) do
						painel.Botao("Iniciar " .. q.Nome, function()
							remotes.GenesisAcao:FireServer("EconomiaQuestIniciar", q.Id)
						end)
					end
				end
			end

			painel.Botao("✦ IA FAZ: crie quest de lenhador", function()
				remotes.GenesisAcao:FireServer("IAMensagem", "Crie uma quest 'Lenhador' com objetivo Coletar Madeira x10 e recompensa 50 moedas + XP 20. Registre no QuestManager e deixe disponivel.")
			end)

			painel.Texto("Integra com EventScript: InventarioTem, DarItem, DarMoedas, QuestCompleta, etc. Tudo sem codigo.", DockUI.Tema.TextoFraco)
		end,
	})
	return P
end

return PainelEconomy
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX172868"><Properties><string name="Name">PainelImport</string><ProtectedString name="Source"><![CDATA[--[[
	PainelImport (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > PainelImport
	============================================================
	F11 — PAINEL DE IMPORTACAO (Ring1).
	- Roblox AssetId (InsertService)
	- FBX/GLB/OBJ/PNG/MP3 via relay (/import/convert)
	- Heightmap matriz local ou via relay /import/heightmap
	- Lista tipos suportados + exemplos

	Padrao: ✋ EU FACO / ✦ IA FAZ
	============================================================
]]

local PainelImport = {}

function PainelImport.Construir(DockUI, remotes, P)
	P.Import = DockUI.CriarPainel({
		Titulo = "Import",
		Largura = 360,
		Altura = 580,
		Posicao = UDim2.new(0, 10, 0, 740),
		AoAbrir = function(painel)
			painel.Limpar()
			painel.Texto("IMPORTACAO ARKHE — F11", DockUI.Tema.Destaque)
			painel.Texto("Traga modelos FBX/GLB/OBJ, heightmaps PNG e audios. Com relay: 1 clique. Sem relay: AssetId ou matriz local.", DockUI.Tema.TextoFraco)

			painel.Texto("— TIPOS SUPORTADOS —", DockUI.Tema.Destaque)
			local tipos = remotes.GenesisConsulta:InvokeServer("ImportTipos")
			for _, t in ipairs(tipos or {}) do
				painel.Texto(t.Nome .. " — " .. t.Descricao, DockUI.Tema.TextoFraco)
			end

			painel.Texto("— ROBLOX ASSET (sem relay) —", DockUI.Tema.Destaque)
			local campoId = painel.Campo("AssetId Roblox (ex: 123456789)")
			painel.Botao("📦 Inserir AssetId na frente", function()
				local id = tonumber(campoId.Text)
				if id then remotes.GenesisAcao:FireServer("ImportRoblox", id) end
			end)

			painel.Texto("— VIA RELAY (FBX/GLB/OBJ/PNG/MP3) —", DockUI.Tema.Destaque)
			local campoUrl = painel.Campo("URL do arquivo (ou caminho no relay)")
			local campoTipo = painel.Campo("Tipo: FBX|GLB|OBJ|PNG|MP3")
			campoTipo.Text = "GLB"
			local campoNome = painel.Campo("Nome do modelo")
			painel.Botao("✋ Importar via relay", function()
				if campoUrl.Text ~= "" then
					remotes.GenesisAcao:FireServer("ImportViaRelay", campoUrl.Text, campoTipo.Text, campoNome.Text)
				end
			end)
			painel.Botao("✦ IA FAZ: busque um modelo e importe", function()
				remotes.GenesisAcao:FireServer("IAMensagem", "Quero importar um modelo FBX/GLB real: busque na web referencias de um modelo compativel (ex: cadeira medieval, carro low-poly) e importe via relay /import/convert. Se nao tiver relay, explique o que falta e crie um placeholder.")
			end)

			painel.Texto("— HEIGHTMAP —", DockUI.Tema.Destaque)
			painel.Botao("🌄 Ruido local → Terreno (sem relay)", function()
				remotes.GenesisAcao:FireServer("ImportHeightmapRuido")
			end)
			local campoLat = painel.Campo("Latitude (ex: -27.81)")
			local campoLon = painel.Campo("Longitude (ex: -50.32)")
			painel.Botao("🌍 Altura REAL do mundo (precisa relay)", function()
				local lat = tonumber(campoLat.Text)
				local lon = tonumber(campoLon.Text)
				if lat and lon then
					remotes.GenesisAcao:FireServer("TerrainMundoReal", lat, lon, "Tudo")
				end
			end)
			painel.Botao("✦ IA FAZ: terreno dos Alpes suicos", function()
				remotes.GenesisAcao:FireServer("IAMensagem", "Gere terreno dos Alpes suicos: busque referencias reais, use estilo Montanhas com neve, e se possivel importe altura real via /terrain/mundoreal. Com IA offline, use Montanhas com erosao.")
			end)

			painel.Texto("Verdade: FBX/GLB direto em runtime é impossivel no Roblox. Relay converte via Open Cloud Assets API. Sem relay, AssetId ainda funciona.", DockUI.Tema.TextoFraco)
		end,
	})
	return P
end

return PainelImport
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX916363"><Properties><string name="Name">PainelMarketplace</string><ProtectedString name="Source"><![CDATA[--[[
	PainelMarketplace (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > PainelMarketplace
	============================================================
	F14 — MARKETPLACE ARKHE GLOBAL (Ring1).
	- Busca por nome/autor
	- Abas: Modelos/Plugins/Folhas/Mundos/Meus + Subs
	- Estrelas, avaliacoes, comprar, top criadores
	- Moderacao (fila) para devs com permissao
	- Integra com relay /marketplace/* quando disponivel

	Padrao: ✋ EU FACO / ✦ IA FAZ
	============================================================
]]

local PainelMarketplace = {}

function PainelMarketplace.Construir(DockUI, remotes, P)
	P.Marketplace = DockUI.CriarPainel({
		Titulo = "Market",
		Largura = 380,
		Altura = 620,
		Posicao = UDim2.new(1, -400, 0, 560),
		AoAbrir = function(painel)
			painel.Limpar()
			painel.Texto("MARKETPLACE ARKHE — F14", DockUI.Tema.Destaque)
			painel.Texto("Modelos, folhas, presets, mundos e animacoes da comunidade. Local + global via relay.", DockUI.Tema.TextoFraco)

			local abaAtual = "Todos"
			local subAtual = "Todos"
			local filtroAtual = ""

			local campoBusca = painel.Campo("Buscar nome/autor...")
			campoBusca.FocusLost:Connect(function()
				filtroAtual = campoBusca.Text
				painel.Alternar(true)
			end)

			painel.Texto("— ABAS —", DockUI.Tema.Destaque)
			painel.Abas({ "Todos", "Modelos", "Plugins", "Folhas", "Mundos", "Meus" }, function(aba)
				abaAtual = aba
				painel.Alternar(true)
			end)
			painel.Abas({ "Todos", "Natureza", "Estruturas", "Fantasia", "Tech", "Audio", "UI", "Animacoes" }, function(sub)
				subAtual = sub
				painel.Alternar(true)
			end)

			local itens = remotes.GenesisConsulta:InvokeServer("MarketplaceListar", filtroAtual, abaAtual, subAtual)
			if not itens or #itens == 0 then
				painel.Texto("(vazio — seja o primeiro a publicar!)", DockUI.Tema.TextoFraco)
			else
				for _, item in ipairs(itens or {}) do
					if item.Nome then
						local estrelas = ""
						for i=1, math.floor(item.Estrelas or 5) do estrelas = estrelas .. "★" end
						painel.Texto(item.Nome .. " " .. estrelas .. " (" .. (item.Avaliacoes or 0) .. ") por " .. (item.Autor or "Arkhe"), DockUI.Tema.TextoFraco)
						painel.Botao("📦 Inserir " .. item.Nome, function()
							remotes.GenesisAcao:FireServer("MarketplaceInserir", item.Id)
						end)
						painel.Botao("⭐ Avaliar 5★", function()
							remotes.GenesisAcao:FireServer("MarketplaceAvaliar", item.Id, 5, "Excelente!")
						end)
					end
				end
			end

			painel.Texto("— TOP CRIADORES —", DockUI.Tema.Destaque)
			local tops = remotes.GenesisConsulta:InvokeServer("MarketplaceTopCriadores")
			for _, cr in ipairs(tops or {}) do
				painel.Texto(cr.Autor .. " — " .. cr.Total .. " itens, media " .. string.format("%.1f", cr.Media or 5), DockUI.Tema.TextoFraco)
			end

			painel.Texto("— PUBLICAR —", DockUI.Tema.Destaque)
			local campoNome = painel.Campo("Nome do seu asset")
			local campoPreco = painel.Campo("Preco (0=gratis)")
			painel.Botao("🚀 Publicar no Marketplace", function()
				if campoNome.Text ~= "" then
					remotes.GenesisAcao:FireServer("MarketplacePublicar", campoNome.Text, tonumber(campoPreco.Text) or 0, abaAtual, subAtual)
				end
			end, DockUI.Tema.Destaque)

			painel.Botao("✦ IA FAZ: crie e publique uma floresta", function()
				remotes.GenesisAcao:FireServer("IAMensagem", "Crie um pack de floresta com 3 variacoes de arvore no Modelador, exporte como arquetipos RRW e publique no Marketplace Arkhe como 'Pack Floresta Antiga' gratis.")
			end)

			painel.Texto("Sem relay: catalogo local. Com relay: global com moderacao IA + curadoria. Receita futura via relay.", DockUI.Tema.TextoFraco)
		end,
	})
	return P
end

return PainelMarketplace
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX838213"><Properties><string name="Name">PainelModeler</string><ProtectedString name="Source"><![CDATA[--[[
	PainelModeler (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > PainelModeler
	============================================================
	F5 — PAINEL DO MODELADOR 3D (Ring1).
	Editor por toque: primitivas, operacoes, sculpt, vertex paint,
	undo/redo, export para RRW e marketplace.
	Padrao: ✋ EU FACO / ✦ IA FAZ
	============================================================
]]

local PainelModeler = {}

function PainelModeler.Construir(DockUI, remotes, P)
	P.Modeler = DockUI.CriarPainel({
		Titulo = "Modelar",
		Largura = 360,
		Altura = 600,
		Posicao = UDim2.new(0, 10, 0, 380),
		AoAbrir = function(painel)
			painel.Limpar()
			painel.Texto("MODELADOR 3D ARKHE — nivel Blender (categoria)", DockUI.Tema.Destaque)
			painel.Texto("Crie modelos DENTRO do jogo, no celular ou PC. Tudo vira arquetipo RRW com D-O15.", DockUI.Tema.TextoFraco)

			local info = remotes.GenesisConsulta:InvokeServer("ModelerInfo")
			if info then
				painel.Texto("Modelo atual: " .. (info.Nome or "nenhum") .. " | " .. (info.Vertices or 0) .. " verts, " .. (info.Triangulos or 0) .. " tris", DockUI.Tema.TextoFraco)
			end

			painel.Texto("— PRIMITIVAS —", DockUI.Tema.Destaque)
			local prims = remotes.GenesisConsulta:InvokeServer("ModelerPrimitivas")
			for _, pr in ipairs(prims or {}) do
				painel.Botao("🧊 " .. pr.Nome .. " — " .. pr.Desc, function()
					remotes.GenesisAcao:FireServer("ModelerCriar", pr.Nome, 4)
					task.wait(0.2)
					painel.Alternar(true)
				end)
			end

			painel.Texto("— OPERACOES —", DockUI.Tema.Destaque)
			local ops = remotes.GenesisConsulta:InvokeServer("ModelerOperacoes")
			for _, op in ipairs(ops or {}) do
				painel.Botao("⚙ " .. op.Nome .. " — " .. op.Desc, function()
					remotes.GenesisAcao:FireServer("ModelerOperacao", op.Nome)
					task.wait(0.2)
					painel.Alternar(true)
				end)
			end

			painel.Texto("— CSG BOOLEANO REAL —", DockUI.Tema.Destaque)
			local csgOps = remotes.GenesisConsulta:InvokeServer("ModelerCSG") or {}
			for _, cop in ipairs(csgOps) do
				painel.Botao("🧩 CSG " .. cop.Nome .. " — " .. cop.Desc, function()
					remotes.GenesisAcao:FireServer("ModelerCSG", cop.Nome, "CuboCSG", 3)
					task.wait(0.3)
					painel.Alternar(true)
				end)
			end
			local infoCSG = remotes.GenesisConsulta:InvokeServer("ModelerCSGInfo")
			if infoCSG then
				painel.Texto("BBox: "..tostring(infoCSG.BBox and infoCSG.BBox.Min or "n/a"), DockUI.Tema.TextoFraco)
			end

			painel.Texto("— SCULPT —", DockUI.Tema.Destaque)
			local pinceis = remotes.GenesisConsulta:InvokeServer("ModelerPinceis")
			for _, pc in ipairs(pinceis or {}) do
				painel.Botao("🖌 " .. pc.Nome .. " — " .. pc.Desc, function()
					remotes.GenesisAcao:FireServer("ModelerSculpt", pc.Nome, 3, 1)
				end)
			end

			painel.Texto("— QUEM DECIDE? —", DockUI.Tema.Destaque)
			painel.Botao("✦ IA FAZ: modele uma espada medieval pra mim", function()
				remotes.GenesisAcao:FireServer("IAMensagem", "Modele uma espada medieval estilizada no Modelador 3D da Arkhe (cubo + extrude + bevel). Exporte como arquetipo RRW. Use referencias reais de espadas medievais.")
			end)
			painel.Botao("✦ IA FAZ: modele uma arvore low-poly", function()
				remotes.GenesisAcao:FireServer("IAMensagem", "Crie uma arvore low-poly no Modelador (cilindro para tronco + esfera low-poly para copa). Exporte como arquetipo RRW com material madeira.")
			end)

			painel.Texto("— EDICAO —", DockUI.Tema.Destaque)
			painel.Botao("↩ Desfazer", function()
				remotes.GenesisAcao:FireServer("ModelerUndo")
				task.wait(0.1)
				painel.Alternar(true)
			end)
			painel.Botao("↪ Refazer", function()
				remotes.GenesisAcao:FireServer("ModelerRedo")
				task.wait(0.1)
				painel.Alternar(true)
			end)
			painel.Botao("🎨 Pintar vertice (vermelho) perto de mim", function()
				remotes.GenesisAcao:FireServer("ModelerPintar", 3, 255, 0, 0)
			end)
			painel.Botao("👁 Preview no mundo (cria pecas)", function()
				remotes.GenesisAcao:FireServer("ModelerPreview")
			end)

			painel.Texto("— EXPORTAR —", DockUI.Tema.Destaque)
			local nomeCampo = painel.Campo("Nome do arquetipo (ex: EspadaLendaria)")
			painel.Botao("📦 Exportar como arquetipo RRW", function()
				if nomeCampo.Text ~= "" then
					remotes.GenesisAcao:FireServer("ModelerExportar", nomeCampo.Text)
				end
			end, DockUI.Tema.Destaque)
			painel.Botao("🗑 Limpar modelo", function()
				remotes.GenesisAcao:FireServer("ModelerOperacao", "Limpar")
				task.wait(0.1)
				painel.Alternar(true)
			end, DockUI.Tema.Perigo)

			painel.Texto("Dica: modelos viram conhecimento RRW com D1-D4 automatico. D1=caixa, D2=caixa detalhe, D3/D4=modelo completo. Funciona no celular porque e dados puros.", DockUI.Tema.TextoFraco)
		end,
	})
	return P
end

return PainelModeler
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX923954"><Properties><string name="Name">PainelMultiplayer</string><ProtectedString name="Source"><![CDATA[--[[
	PainelMultiplayer (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > PainelMultiplayer
	============================================================
	F16 — PAINEL MULTIPLAYER (Ring1) 65%:
	- Replicator stats
	- AntiCheat: violacoes, logs, limites
	- CrossServer: shards, delta sync via relay
	============================================================
]]

local PainelMultiplayer = {}

function PainelMultiplayer.Construir(DockUI, remotes, P)
	P.Multiplayer = DockUI.CriarPainel({
		Titulo = "Multi",
		Largura = 360,
		Altura = 620,
		Posicao = UDim2.new(1, -380, 0, 900),
		AoAbrir = function(painel)
			painel.Limpar()
			painel.Texto("MULTIPLAYER RRW — F16 65%", DockUI.Tema.Destaque)
			painel.Texto("Replicator D-O15 + AntiCheat + CrossServer shards.", DockUI.Tema.TextoFraco)

			local stats = remotes.GenesisConsulta:InvokeServer("MultiplayerStats")
			if stats then
				painel.Texto("Buffer: " .. stats.BufferSize .. " entidades | Clientes: " .. stats.Clients, DockUI.Tema.TextoFraco)
				painel.Texto("TickRate: " .. stats.TickRate .. "s | Max/tick: " .. stats.MaxPorTick, DockUI.Tema.TextoFraco)
			end

			painel.Botao("🔄 Limpar buffer replicacao", function()
				remotes.GenesisAcao:FireServer("MultiplayerLimpar")
			end)

			painel.Texto("— ANTICHEAT (F16) —", DockUI.Tema.Destaque)
			local acStats = remotes.GenesisConsulta:InvokeServer("AntiCheatStats")
			if acStats then
				painel.Texto("Jogadores: " .. acStats.TotalJogadores .. " | Violacoes: " .. acStats.TotalViolacoes, DockUI.Tema.TextoFraco)
				painel.Texto("Limites: Vel " .. acStats.Limites.MaxVelocidade .. " | Tele " .. acStats.Limites.MaxTeleporte .. " | Acoes " .. acStats.Limites.MaxAcoesPorSegundo .. "/s", DockUI.Tema.TextoFraco)
			end
			local logs = remotes.GenesisConsulta:InvokeServer("AntiCheatLogs", 0) or {}
			for i=1, math.min(5, #logs) do
				local lg = logs[i]
				painel.Texto("⚠ " .. lg.UserId .. " " .. lg.Tipo .. " x" .. (lg.Violacoes or 0), DockUI.Tema.Perigo)
			end
			painel.Botao("🧹 Limpar meu AntiCheat", function()
				remotes.GenesisAcao:FireServer("AntiCheatLimpar")
			end)

			painel.Texto("— CROSS-SERVER (F16) —", DockUI.Tema.Destaque)
			local csStats = remotes.GenesisConsulta:InvokeServer("CrossServerStats")
			if csStats then
				painel.Texto("Shard: " .. csStats.ShardId .. " (" .. csStats.ShardNome .. ")", DockUI.Tema.TextoFraco)
				painel.Texto("Fila: " .. csStats.Fila .. "/" .. csStats.MaxFila .. " | UltimoSync " .. csStats.SegundosDesdeSync .. "s", DockUI.Tema.TextoFraco)
			end
			painel.Botao("🔗 Sync CrossServer (relay /multiplayer/sync)", function()
				remotes.GenesisAcao:FireServer("CrossServerSync")
			end)
			painel.Texto("Sem relay: fila local. Com relay: POST /multiplayer/sync com deltas.", DockUI.Tema.TextoFraco)

			painel.Botao("✦ IA FAZ: otimize para 100 players + anti-cheat", function()
				remotes.GenesisAcao:FireServer("IAMensagem", "Otimize replicacao para 100 players, configure AntiCheat MaxVelocidade 80 MaxTeleporte 150, e ative CrossServer shards via relay /multiplayer/sync com auto-sync 2s.")
			end)

			local heat = remotes.GenesisConsulta:InvokeServer("AnalyticsRelatorio")
			if heat then
				painel.Texto("— ANALYTICS (F20) —", DockUI.Tema.Destaque)
				painel.Texto("Posicoes: " .. heat.TotalPos .. " | Mortes: " .. heat.TotalMorte .. " | Compras: " .. heat.TotalCompra, DockUI.Tema.TextoFraco)
				painel.Texto("Conversao: " .. string.format("%.1f%%", (heat.Funil.TaxaConversao or 0)*100), DockUI.Tema.TextoFraco)
			end

			local edu = remotes.GenesisConsulta:InvokeServer("EducationConquistas")
			if edu then
				painel.Texto("— CONQUISTAS (F21) —", DockUI.Tema.Destaque)
				for _, c in ipairs(edu) do
					painel.Texto((c.Tem and "✅ " or "⬜ ") .. c.Icon .. " " .. c.Nome, c.Tem and DockUI.Tema.Sucesso or DockUI.Tema.TextoFraco)
				end
			end
		end,
	})
	return P
end

return PainelMultiplayer
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX483391"><Properties><string name="Name">PainelNPC</string><ProtectedString name="Source"><![CDATA[--[[
	PainelNPC (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > PainelNPC
	============================================================
	F7 — Painel de NPCs da Genesis:
	- Spawnar por personalidade
	- Tema de skin + AUTO-SKIN
	- Dialogue: criar dialogo, add nos/opcoes, falar
	- Crowd: criar multidao, formacoes
	- Ragdoll F8 integrado
	- Padrao universal: ✋ EU FACO / ✦ IA FAZ
	============================================================
]]

local PainelNPC = {}

function PainelNPC.Construir(DockUI, remotes, P)
	local temaEscolhido = "Medieval"

	P.NPC = DockUI.CriarPainel({
		Titulo = "NPCs",
		Largura = 360,
		Altura = 620,
		Posicao = UDim2.new(1, -380, 0, 300),
		AoAbrir = function(painel)
			painel.Limpar()
			local info = remotes.GenesisConsulta:InvokeServer("NPCLista")
			if not info then return end

			painel.Texto("VIVOS AGORA: " .. info.Total .. " / " .. info.Maximo, DockUI.Tema.Destaque)

			painel.Texto("— TEMA DA SKIN —", DockUI.Tema.Destaque)
			painel.Abas(info.Temas, function(tema)
				temaEscolhido = tema
			end)

			painel.Texto("— CRIAR (nascem onde voce esta) —", DockUI.Tema.Destaque)
			local qtd = painel.Campo("Quantidade (padrao 3)")
			for _, nome in ipairs(info.Personalidades) do
				painel.Botao("👤 Criar " .. nome, function()
					remotes.GenesisAcao:FireServer("NPCCriar", nome, tonumber(qtd.Text) or 3, temaEscolhido)
					task.wait(0.3)
					painel.Alternar(true)
				end)
			end

			painel.Texto("— AUTO-SKIN (1 clique) —", DockUI.Tema.Destaque)
			painel.Botao("✨ Vestir o NPC mais perto com " .. temaEscolhido, function()
				remotes.GenesisAcao:FireServer("NPCAutoSkin", temaEscolhido)
			end)

			painel.Texto("— DIALOGUE (F7) —", DockUI.Tema.Destaque)
			local dlgLista = remotes.GenesisConsulta:InvokeServer("DialogueLista") or {}
			for _, dlg in ipairs(dlgLista) do
				painel.Texto("💬 " .. dlg.Nome .. " (" .. dlg.NumNos .. " nos)", DockUI.Tema.TextoFraco)
			end
			local campoDlg = painel.Campo("Nome dialogo (ex: Ferreiro)")
			painel.Botao("＋ Novo dialogo", function()
				if campoDlg.Text ~= "" then
					remotes.GenesisAcao:FireServer("DialogueNovo", campoDlg.Text)
					task.wait(0.2)
					painel.Alternar(true)
				end
			end)
			local campoNoId = painel.Campo("DialogoId NoId Texto")
			painel.Botao("＋ Add No (ex: exemplo inicio Ola!)", function()
				local parts = {}
				for w in string.gmatch(campoNoId.Text, "%S+") do table.insert(parts, w) end
				if #parts >= 3 then
					remotes.GenesisAcao:FireServer("DialogueAddNo", parts[1], parts[2], table.concat(parts, " ", 3))
				end
			end)
			local campoOp = painel.Campo("dlgId deNo txtOpcao paraNo")
			painel.Botao("＋ Add Opcao", function()
				local parts = {}
				for w in string.gmatch(campoOp.Text, "%S+") do table.insert(parts, w) end
				if #parts >= 4 then
					remotes.GenesisAcao:FireServer("DialogueAddOpcao", parts[1], parts[2], parts[3], parts[4])
				end
			end)
			painel.Botao("🗣 Falar exemplo (inicio)", function()
				remotes.GenesisAcao:FireServer("DialogueFalar", "exemplo", "Aldeao01", "inicio")
			end)

			painel.Texto("— MULTIDAO (F7 Crowd 100+) —", DockUI.Tema.Destaque)
			local crowdInfo = remotes.GenesisConsulta:InvokeServer("CrowdInfo")
			if crowdInfo then
				painel.Texto("Crowd: " .. crowdInfo.Total .. "/" .. crowdInfo.Maximo .. " | Form: " .. crowdInfo.Formacao, DockUI.Tema.TextoFraco)
			end
			local campoQtdCrowd = painel.Campo("Qtd (1-30)")
			painel.Abas({ "Circulo","Linha","V","Quadrado","Multidao" }, function(form)
				remotes.GenesisAcao:FireServer("CrowdFormacao", form)
			end)
			painel.Botao("👥 Criar multidao aqui", function()
				remotes.GenesisAcao:FireServer("CrowdCriar", tonumber(campoQtdCrowd.Text) or 10, 60, "Multidao")
				task.wait(0.5)
				painel.Alternar(true)
			end)
			painel.Botao("🗑 Limpar multidao", function()
				remotes.GenesisAcao:FireServer("CrowdLimpar")
				task.wait(0.2)
				painel.Alternar(true)
			end, DockUI.Tema.Perigo)

			painel.Texto("— RAGDOLL (F8) —", DockUI.Tema.Destaque)
			painel.Abas({ "Relaxado","Ativo","Morto" }, function(modo)
				remotes.GenesisAcao:FireServer("RagdollAplicar", modo, "Carne")
			end)
			painel.Botao("💀 Ragdoll Morto no mais proximo", function()
				remotes.GenesisAcao:FireServer("RagdollAplicar", "Morto", "Carne")
			end)
			painel.Botao("🧍 Remover ragdoll proximos", function()
				remotes.GenesisAcao:FireServer("RagdollRemover")
			end)

			painel.Texto("— QUEM DECIDE? —", DockUI.Tema.Destaque)
			painel.Botao("✦ IA FAZ: povoe com dialogos + multidao + ragdoll", function()
				remotes.GenesisAcao:FireServer("IAMensagem", "Povoe meu mundo com 5 NPCs com dialogos com memoria (missao e loja), crie uma multidao de 15 em formacao Circulo, e demonstre ragdoll Relaxado em um deles. Use Dialogue/Crowd/Ragdoll.")
			end)

			painel.Botao("🗑 Remover TODOS os NPCs", function()
				remotes.GenesisAcao:FireServer("NPCLimpar")
				task.wait(0.2)
				painel.Alternar(true)
			end, DockUI.Tema.Perigo)

			painel.Texto("F7 75%: Dialogos com memoria, multidoes 100+ com LOD flocking, ragdoll por materia RRW.", DockUI.Tema.TextoFraco)
		end,
	})

	return P
end

return PainelNPC
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX887383"><Properties><string name="Name">PainelOptimize</string><ProtectedString name="Source"><![CDATA[--[[
	PainelOptimize (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > PainelOptimize
	============================================================
	F13 — PAINEL DE OTIMIZACAO + F12 SERIALIZER (parcial).

	Painel "Otimizar" com:
	  - seletor de plataforma (MobileFraco/Medio/PC/Console)
	  - botao Analisar agora (mostra score + achados)
	  - IA explica e corrige
	  - Otimizar seguro 1 clique
	  - secao Publicar: resumo do pacote + exportar

	Padrao: ✋ EU FACO / ✦ IA FAZ
	============================================================
]]

local PainelOptimize = {}

function PainelOptimize.Construir(DockUI, remotes, P)
	P.Otimizar = DockUI.CriarPainel({
		Titulo = "Otimizar",
		Largura = 360,
		Altura = 560,
		Posicao = UDim2.new(1, -380, 0, 380),
		AoAbrir = function(painel)
			painel.Limpar()

			-- estado local do painel
			local plataforma = "MobileMedio"
			local ultimoRelatorio = nil

			painel.Texto("OTIMIZACAO & PUBLICACAO", DockUI.Tema.Destaque)
			painel.Texto("Analise seu mundo por plataforma e otimize em 1 clique — sem destruir nada.", DockUI.Tema.TextoFraco)

			-- seletor de plataforma
			painel.Texto("— PLATAFORMA ALVO —", DockUI.Tema.Destaque)
			local plataformas = remotes.GenesisConsulta:InvokeServer("OtimizarPlataformas")
			if plataformas and #plataformas > 0 then
				painel.Abas({ "MobileFraco", "MobileMedio", "PC", "Console" }, function(nome)
					plataforma = nome
					painel.Texto("Alvo: " .. nome, DockUI.Tema.Destaque)
				end)
				for _, pl in ipairs(plataformas) do
					painel.Texto(pl.Titulo .. "  (" .. pl.Nome .. ")", DockUI.Tema.TextoFraco)
				end
			end

			painel.Texto("— ANALISE —", DockUI.Tema.Destaque)
			painel.Botao("🔍 Analisar agora (" .. plataforma .. ")", function()
				-- pega plataforma atual do closure (mas o botao foi criado com valor antigo, entao re-invoca)
				local rel = remotes.GenesisConsulta:InvokeServer("OtimizarRelatorio", plataforma)
				if not rel then
					painel.Texto("Falha ao analisar.", DockUI.Tema.Perigo)
					return
				end
				ultimoRelatorio = rel
				painel.Limpar()
				-- reconstroi cabecalho rapido
				painel.Texto("📊 RELATORIO — " .. (rel.PlataformaNome or rel.Plataforma), DockUI.Tema.Destaque)
				local scoreCor = rel.Score >= 80 and DockUI.Tema.Sucesso or (rel.Score >= 50 and DockUI.Tema.Destaque or DockUI.Tema.Perigo)
				painel.Texto("Score: " .. rel.Score .. "/100", scoreCor)
				painel.Texto("Entidades RRW: " .. (rel.Contagens.RRW.Total or 0) ..
					" | Parts: " .. (rel.Contagens.Workspace.BaseParts or 0) ..
					" | NPCs: " .. (rel.Contagens.NPC.Total or 0), DockUI.Tema.TextoFraco)

				for _, ach in ipairs(rel.Achados or {}) do
					local cor = ach.Severidade == "Critico" and DockUI.Tema.Perigo
						or (ach.Severidade == "Aviso" and DockUI.Tema.Destaque or DockUI.Tema.TextoFraco)
					local icone = ach.Severidade == "Critico" and "🔴" or (ach.Severidade == "Aviso" and "🟡" or "🟢")
					painel.Texto(icone .. " [" .. ach.Sistema .. "] " .. ach.Mensagem, cor)
					if ach.Sugestao and ach.Sugestao ~= "" then
						painel.Texto("   → " .. ach.Sugestao, DockUI.Tema.TextoFraco)
					end
				end

				painel.Texto("— QUEM DECIDE? —", DockUI.Tema.Destaque)
				painel.Botao("✦ IA FAZ: explique e corrija", function()
					remotes.GenesisAcao:FireServer("IAMensagem",
						"Analise meu relatorio de otimizacao para " .. plataforma .. " e explique cada Critico/Aviso. Se possivel, aplique otimizacoes seguras.")
				end)
				painel.Botao("✋ Otimizar seguro 1 clique (" .. plataforma .. ")", function()
					remotes.GenesisAcao:FireServer("OtimizarSeguro", plataforma)
				end, DockUI.Tema.Destaque)

				painel.Botao("🔍 Re-analisar", function()
					painel.Alternar(true)
				end)
				painel.Botao("← Voltar", function()
					ultimoRelatorio = nil
					painel.Alternar(true)
				end)
			end, DockUI.Tema.Destaque)

			painel.Texto("— OTIMIZACAO RAPIDA —", DockUI.Tema.Destaque)
			painel.Botao("✋ Otimizar seguro 1 clique (" .. plataforma .. ")", function()
				remotes.GenesisAcao:FireServer("OtimizarSeguro", plataforma)
			end, DockUI.Tema.Destaque)

			painel.Botao("✦ IA FAZ: deixe meu jogo rapido em celular fraco", function()
				remotes.GenesisAcao:FireServer("IAMensagem",
					"Meu jogo precisa rodar liso em celular fraco. Analise e otimize tudo que for seguro, sem remover conteudo importante.")
			end)

			-- secao F12 Publisher
			painel.Texto("— PUBLICACAO (F12) —", DockUI.Tema.Destaque)
			local resumoPub = remotes.GenesisConsulta:InvokeServer("PublicarResumo")
			if resumoPub then
				painel.Texto("Pacote: " .. (resumoPub.Entidades or 0) .. " entidades, " ..
					(resumoPub.Folhas or 0) .. " folhas, " .. (resumoPub.Telas or 0) .. " telas UI, " ..
					(resumoPub.NPCs or 0) .. " NPCs", DockUI.Tema.TextoFraco)
				painel.Texto("Visual: " .. (resumoPub.VisualAtual or "?") ..
					" | Fisica: " .. (resumoPub.PhysicaAtual or "?") ..
					" | Terrain: " .. (resumoPub.TemTerrain and "SIM" or "nao") ..
					" | ~" .. math.floor((resumoPub.TamanhoBytes or 0)/1024) .. " KB JSON",
					DockUI.Tema.TextoFraco)
			end
			painel.Botao("📦 Exportar pacote (JSON)", function()
				remotes.GenesisAcao:FireServer("PublicarExportar")
			end)
			painel.Botao("🚀 Publicar no relay (Open Cloud)", function()
				remotes.GenesisAcao:FireServer("PublicarMundo", "Meu Mundo Arkhe")
			end, DockUI.Tema.Destaque)

			painel.Texto("Sem relay: pacote e salvo local e copiavel como JSON. Com relay: relay monta .rbxl via rbx-dom e publica na sua place via Open Cloud (universe.place:write). Verdade tecnica: .rbxl NAO nasce dentro do Roblox.", DockUI.Tema.TextoFraco)
		end,
	})

	return P
end

return PainelOptimize
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX775077"><Properties><string name="Name">PainelTerrain</string><ProtectedString name="Source"><![CDATA[--[[
	PainelTerrain (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > PainelTerrain
	============================================================
	F4 — O painel do TERRAIN AAAA com o FLUXO DE IA guiado:

	Ao abrir, a IA pergunta (exatamente como o criador pediu):
	 1) So terreno? Terreno+construcoes? Terreno+vegetacao? Tudo?
	 2) Qual estilo? (7 nativos, descricao livre pra IA com
	    referencias da web real, ou LUGAR REAL por lat/lon)
	 3) Gera. Depois: pinceis de escultura + regenerar.

	Padrao universal Arkhe: ✋ EU FACO / ✦ IA FAZ.
	============================================================
]]

local PainelTerrain = {}

function PainelTerrain.Construir(DockUI, remotes, P)
	local escopo = nil -- "So" | "Veg" | "Cons" | "Tudo"

	P.Terrain = DockUI.CriarPainel({
		Titulo = "Terrain", Largura = 340, Altura = 500,
		Posicao = UDim2.new(0, 320, 0, 10),
		AoAbrir = function(painel)
			painel.Limpar()
			local info = remotes.GenesisConsulta:InvokeServer("TerrainInfo")

			-- ===== PASSO 1: a IA pergunta o escopo =====
			if not escopo then
				painel.Texto("GAIA (Singularity): O que vamos criar?", DockUI.Tema.Destaque)
				painel.Botao("⛰ So o terreno", function() escopo = "So" painel.Alternar(true) end)
				painel.Botao("🌲 Terreno + vegetacao", function() escopo = "Veg" painel.Alternar(true) end)
				painel.Botao("🏠 Terreno + construcoes", function() escopo = "Cons" painel.Alternar(true) end)
				painel.Botao("✨ Tudo (terreno+vegetacao+construcoes)", function()
					escopo = "Tudo" painel.Alternar(true)
				end)
				if info and info.Existe then
					painel.Texto("Terreno atual: " .. tostring(info.Estilo) ..
						" (seed " .. tostring(info.Seed) .. ")", DockUI.Tema.TextoFraco)
				end
				return
			end

			-- ===== PASSO 2: estilo =====
			painel.Texto("GAIA: E qual estilo? (escopo: " .. escopo .. ")", DockUI.Tema.Destaque)
			local estilos = remotes.GenesisConsulta:InvokeServer("TerrainEstilos")
			for _, e in ipairs(estilos or {}) do
				painel.Botao("⛰ " .. e.Nome .. " — " .. e.Descricao, function()
					painel.Texto("Gerando '" .. e.Nome .. "'... (chunks nascem em ondas)")
					remotes.GenesisAcao:FireServer("TerrainGerar", e.Nome, escopo, "")
				end)
			end

			painel.Texto("— ✦ IA FAZ (descricao livre) —", DockUI.Tema.Destaque)
			local desc = painel.Campo("Ex: fiorde noruegues com falesias...")
			painel.Botao("✦ IA cria com referencias da web real", function()
				if desc.Text ~= "" then
					remotes.GenesisAcao:FireServer("TerrainGerar", "", escopo, desc.Text)
				end
			end)

			painel.Texto("— 🌍 LUGAR REAL (relay) —", DockUI.Tema.Destaque)
			local lat = painel.Campo("Latitude (ex: -27.81)")
			local lon = painel.Campo("Longitude (ex: -50.32)")
			painel.Botao("Gerar lugar real por coordenadas", function()
				remotes.GenesisAcao:FireServer("TerrainMundoReal",
					tonumber(lat.Text), tonumber(lon.Text), escopo)
			end)

			-- ===== PASSO 3: escultura (✋ EU FACO) =====
			painel.Texto("— ✋ PINCEIS (raycast preciso) —", DockUI.Tema.Destaque)
			local raio = painel.Campo("Raio em studs (padrao 40)")
			local forca = painel.Campo("Forca (padrao 8)")
			local function pincel(op)
				remotes.GenesisAcao:FireServer("TerrainPincel", op,
					tonumber(raio.Text) or 40, tonumber(forca.Text) or 8)
			end
			painel.Botao("▲ Elevar aqui (raycast)", function() pincel("Elevar") end)
			painel.Botao("▼ Baixar aqui", function() pincel("Baixar") end)
			painel.Botao("≈ Suavizar aqui", function() pincel("Suavizar") end)
			painel.Botao("▬ Plato aqui", function() pincel("Plato") end)

			-- ===== PASSO 4: CAVERNAS, RIOS, ESTRADAS (F4 avancado) =====
			painel.Texto("— 🕳️ CAVERNAS & RIOS & ESTRADAS —", DockUI.Tema.Destaque)
			local listaFeat = remotes.GenesisConsulta:InvokeServer("TerrainFeaturesLista") or {}
			painel.Texto("Features: "..#listaFeat.." (tuneis/camaras/rios/estradas)", DockUI.Tema.TextoFraco)

			painel.Botao("🕳️ + Tunel caverna (daqui p/ 40 studs frente)", function()
				remotes.GenesisAcao:FireServer("TerrainCavernaTunel", 40, 0, 0, 12)
			end)
			painel.Botao("🏛️ + Camara caverna aqui", function()
				remotes.GenesisAcao:FireServer("TerrainCavernaCamara", 18)
			end)
			local nomeRio = painel.Campo("Nome rio (ex: RioVerde)")
			painel.Botao("🌊 Criar Rio", function()
				if nomeRio.Text ~= "" then remotes.GenesisAcao:FireServer("TerrainRioNovo", nomeRio.Text) end
			end)
			painel.Botao("🌊 + Ponto no rio (pos atual)", function()
				if nomeRio.Text ~= "" then remotes.GenesisAcao:FireServer("TerrainRioAddPonto", nomeRio.Text, 18, 6) end
			end)
			local nomeEstrada = painel.Campo("Nome estrada (ex: EstradaReal)")
			painel.Botao("🛣️ Criar Estrada", function()
				if nomeEstrada.Text ~= "" then remotes.GenesisAcao:FireServer("TerrainEstradaNova", nomeEstrada.Text) end
			end)
			painel.Botao("🛣️ + Ponto estrada (pos atual)", function()
				if nomeEstrada.Text ~= "" then remotes.GenesisAcao:FireServer("TerrainEstradaAddPonto", nomeEstrada.Text, 12) end
			end)
			painel.Botao("✨ Aplicar features no terreno (carvar tudo)", function()
				remotes.GenesisAcao:FireServer("TerrainFeaturesAplicar")
			end)
			painel.Botao("🗑️ Limpar features", function()
				remotes.GenesisAcao:FireServer("TerrainFeaturesLimpar")
			end, DockUI.Tema.Perigo)

			painel.Botao("↺ Recomecar conversa", function()
				escopo = nil
				painel.Alternar(true)
			end, DockUI.Tema.Perigo)
		end,
	})

	return P
end

return PainelTerrain
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX677946"><Properties><string name="Name">PainelUI</string><ProtectedString name="Source"><![CDATA[--[[
	PainelUI (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > PainelUI
	============================================================
	F10 — O UI BUILDER da Genesis: monta TELAS dos jogos do dev
	por toque, com preview ao vivo em PC/Celular/Console.
	Botao criado aqui dispara folha do EventScript no servidor
	(gatilho "Evento:UI:<tela>:<botao>") — UI viva sem codigo.
	Padrao universal: ✋ EU FACO / ✦ IA FAZ.
	============================================================
]]

local PainelUI = {}

function PainelUI.Construir(DockUI, remotes, P, UIKit, playerGui)
	local telaAberta = nil
	local compAberto = nil -- indice do componente em edicao
	local previewGui = nil

	local function fecharPreview()
		if previewGui then previewGui:Destroy() previewGui = nil end
	end

	local function abrirPreview(def, modo)
		fecharPreview()
		previewGui = Instance.new("ScreenGui")
		previewGui.Name = "ArkhePreviewUI"
		previewGui.ResetOnSpawn = false
		previewGui.DisplayOrder = 40
		local raiz
		if modo == "Celular" then
			-- moldura de celular no centro da tela (proporcao 19.5:9)
			local moldura = Instance.new("Frame")
			moldura.AnchorPoint = Vector2.new(0.5, 0.5)
			moldura.Position = UDim2.new(0.5, 0, 0.5, 0)
			moldura.Size = UDim2.new(0.42, 0, 0.42 * (9 / 19.5) * (16 / 9), 0)
			moldura.SizeConstraint = Enum.SizeConstraint.RelativeXX
			moldura.BackgroundColor3 = Color3.fromRGB(10, 10, 14)
			moldura.Parent = previewGui
			local borda = Instance.new("UIStroke")
			borda.Color = Color3.fromRGB(214, 178, 84)
			borda.Thickness = 3
			borda.Parent = moldura
			raiz = UIKit.Construir(def, moldura, "Celular")
		else
			raiz = UIKit.Construir(def, previewGui, modo)
		end
		-- botao de fechar o preview
		local fechar = Instance.new("TextButton")
		fechar.Text = "✕ fechar preview (" .. modo .. ")"
		fechar.Size = UDim2.new(0, 220, 0, 34)
		fechar.Position = UDim2.new(0.5, -110, 0, 4)
		fechar.BackgroundColor3 = Color3.fromRGB(200, 82, 82)
		fechar.TextColor3 = Color3.new(1, 1, 1)
		fechar.Font = Enum.Font.GothamBold
		fechar.TextSize = 16
		fechar.Parent = previewGui
		fechar.MouseButton1Click:Connect(fecharPreview)
		previewGui.Parent = playerGui
		return raiz
	end

	P.UI = DockUI.CriarPainel({
		Titulo = "UI", Largura = 340, Altura = 520,
		Posicao = UDim2.new(1, -380, 0, 10),
		AoAbrir = function(painel)
			painel.Limpar()

			-- ===== MODO 3: editando um componente =====
			if telaAberta and compAberto then
				local def = remotes.GenesisConsulta:InvokeServer("UITelaDetalhe", telaAberta)
				local comp = def and def.Comps[compAberto]
				if not comp then
					compAberto = nil
					painel.Alternar(true)
					return
				end
				painel.Texto("✏ " .. comp.Nome .. " (" .. comp.Tipo .. ")", DockUI.Tema.Destaque)
				painel.Texto("Posicao e tamanho em % da tela (0..100):", DockUI.Tema.TextoFraco)
				local campos = {}
				for _, prop in ipairs({ "X", "Y", "W", "H" }) do
					local cx = painel.Campo(prop .. " = " .. tostring(comp[prop] or 0))
					campos[prop] = cx
				end
				local texto = painel.Campo("Texto: " .. tostring(comp.Texto or ""))
				painel.Texto("Cor:", DockUI.Tema.TextoFraco)
				for _, nomeCor in ipairs({ "Indigo", "Ouro", "Verde", "Vermelho", "Escuro", "Azul", "Roxo" }) do
					painel.Botao("● " .. nomeCor, function()
						remotes.GenesisAcao:FireServer("UICompProp", telaAberta, compAberto, "Cor", nomeCor)
					end)
				end
				painel.Botao("✔ Aplicar numeros/texto", function()
					for prop, cx in pairs(campos) do
						if cx.Text ~= "" and tonumber(cx.Text) then
							remotes.GenesisAcao:FireServer("UICompProp",
								telaAberta, compAberto, prop, cx.Text)
						end
					end
					if texto.Text ~= "" then
						remotes.GenesisAcao:FireServer("UICompProp",
							telaAberta, compAberto, "Texto", texto.Text)
					end
					task.wait(0.15)
					painel.Alternar(true)
				end, DockUI.Tema.Destaque)
				painel.Botao("🗑 Remover componente", function()
					remotes.GenesisAcao:FireServer("UICompRem", telaAberta, compAberto)
					compAberto = nil
					task.wait(0.15)
					painel.Alternar(true)
				end, DockUI.Tema.Perigo)
				painel.Botao("← Voltar a tela", function()
					compAberto = nil
					painel.Alternar(true)
				end)
				return
			end

			-- ===== MODO 2: editando uma tela =====
			if telaAberta then
				local def = remotes.GenesisConsulta:InvokeServer("UITelaDetalhe", telaAberta)
				if not def then
					telaAberta = nil
					painel.Alternar(true)
					return
				end
				painel.Texto("🖼 " .. def.Nome, DockUI.Tema.Destaque)
				for i, comp in ipairs(def.Comps or {}) do
					painel.Botao(comp.Tipo .. " · " .. comp.Nome ..
						"  (" .. (comp.X or 0) .. "," .. (comp.Y or 0) .. ")", function()
						compAberto = i
						painel.Alternar(true)
					end)
				end
				painel.Texto("— ADICIONAR (F10 completo) —", DockUI.Tema.Destaque)
				local nomeNovo = painel.Campo("Nome do componente")
				painel.Abas({ "Painel", "Texto", "Botao", "Barra", "Campo", "Imagem", "Lista", "Scroll", "Grade" }, function(tipo)
					if nomeNovo.Text ~= "" then
						remotes.GenesisAcao:FireServer("UICompAdd", telaAberta, tipo, nomeNovo.Text)
						task.wait(0.15)
						painel.Alternar(true)
					end
				end)
				painel.Texto("— PREVIEW AO VIVO —", DockUI.Tema.Destaque)
				painel.Botao("🖥 Ver como PC", function() abrirPreview(def, "PC") end)
				painel.Botao("📱 Ver como Celular", function() abrirPreview(def, "Celular") end)
				painel.Botao("🎮 Ver como Console (safe-area)", function() abrirPreview(def, "Console") end)
				painel.Texto("Botoes desta tela disparam folhas com gatilho Evento:UI:" ..
					def.Nome .. ":<botao>", DockUI.Tema.TextoFraco)
				painel.Botao("← Todas as telas", function()
					telaAberta = nil
					fecharPreview()
					painel.Alternar(true)
				end)
				painel.Botao("🗑 Apagar tela", function()
					remotes.GenesisAcao:FireServer("UITelaRem", telaAberta)
					telaAberta = nil
					task.wait(0.15)
					painel.Alternar(true)
				end, DockUI.Tema.Perigo)
				return
			end

			-- ===== MODO 1: lista de telas =====
			painel.Texto("TELAS DO SEU JOGO (dados publicaveis)", DockUI.Tema.Destaque)
			local telas = remotes.GenesisConsulta:InvokeServer("UITelas")
			for _, t in ipairs(telas or {}) do
				painel.Botao("🖼 " .. t.Nome .. "  (" .. t.NumComps .. " componentes)", function()
					telaAberta = t.Nome
					painel.Alternar(true)
				end)
			end
			painel.Texto("— NOVA TELA —", DockUI.Tema.Destaque)
			local nome = painel.Campo("Nome da tela (ex: HUD, Menu, Loja)")
			painel.Botao("+ Criar tela", function()
				if nome.Text ~= "" then
					remotes.GenesisAcao:FireServer("UITelaNova", nome.Text)
					telaAberta = nome.Text
					task.wait(0.15)
					painel.Alternar(true)
				end
			end, DockUI.Tema.Destaque)
			painel.Texto("— QUEM DECIDE? —", DockUI.Tema.Destaque)
			painel.Botao("✦ IA FAZ: desenhe um HUD pro meu jogo", function()
				remotes.GenesisAcao:FireServer("IAMensagem",
					"Crie uma tela de UI chamada HUD adequada ao meu jogo atual (vida, recursos, botoes uteis). Explique o layout.")
			end)
			painel.Texto("A MESMA tela reflui em PC, celular e console — % em vez de pixels.",
				DockUI.Tema.TextoFraco)
		end,
	})

	return P
end

return PainelUI
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX48823"><Properties><string name="Name">PaneisMundo</string><ProtectedString name="Source"><![CDATA[--[[
	PaneisMundo (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > PaneisMundo
	============================================================
	Paineis F8+F9+F12 da Genesis: VISUAL (presets+probes+daynight)
	e FISICA (presets+vento+ragdoll) + PUBLISH (versionamento)
	Padrao universal: ✋ EU FACO / ✦ IA FAZ
	============================================================
]]

local PaneisMundo = {}

function PaneisMundo.Construir(DockUI, remotes, P)

	-- ============ PAINEL VISUAL (F9) 70% ===========
	P.Visual = DockUI.CriarPainel({
		Titulo = "Visual",
		Largura = 360,
		Altura = 600,
		Posicao = UDim2.new(0.5, -180, 0, 490),
		AoAbrir = function(painel)
			painel.Limpar()
			painel.Texto("PRESETS DE AMBIENCIA (F9 70%)", DockUI.Tema.Destaque)
			local lista = remotes.GenesisConsulta:InvokeServer("VisualLista")
			for _, item in ipairs(lista or {}) do
				painel.Botao("🎨 " .. item.Nome .. (item.Atual and "  ← ATIVO" or ""), function()
					remotes.GenesisAcao:FireServer("AplicarVisual", item.Nome)
					task.wait(0.2)
					painel.Alternar(true)
				end)
				if item.Descricao ~= "" then
					painel.Texto("   " .. item.Descricao, DockUI.Tema.TextoFraco)
				end
			end

			painel.Texto("— LIGHT PROBES (GI aproximado) —", DockUI.Tema.Destaque)
			local probes = remotes.GenesisConsulta:InvokeServer("LightProbeLista") or {}
			painel.Texto("Probes: " .. #probes .. "/32", DockUI.Tema.TextoFraco)
			for _, pr in ipairs(probes) do
				painel.Texto("💡 " .. pr.Nome .. " r=" .. pr.Raio .. " int=" .. string.format("%.2f", pr.Intensidade), DockUI.Tema.TextoFraco)
			end
			painel.Botao("＋ Probe aqui (minha pos)", function()
				remotes.GenesisAcao:FireServer("LightProbeCriar", "", 40)
				task.wait(0.2)
				painel.Alternar(true)
			end)
			painel.Botao("🗑 Limpar probes", function()
				remotes.GenesisAcao:FireServer("LightProbeLimpar")
				task.wait(0.2)
				painel.Alternar(true)
			end, DockUI.Tema.Perigo)

			painel.Texto("— DIA/NOITE + ESTACOES (F9) —", DockUI.Tema.Destaque)
			local dn = remotes.GenesisConsulta:InvokeServer("DayNightInfo")
			if dn then
				painel.Texto(string.format("Hora: %.1f (%s) Est: %s Ciclo: %s", dn.Hora, dn.Periodo, dn.Estacao, dn.CicloAtivo and "ON" or "OFF"), DockUI.Tema.TextoFraco)
				painel.Texto("Temp: " .. dn.Temperatura .. "C", DockUI.Tema.TextoFraco)
			end
			painel.Abas({ "Primavera","Verao","Outono","Inverno" }, function(est)
				remotes.GenesisAcao:FireServer("DayNightEstacao", est)
			end)
			local campoHora = painel.Campo("Hora 0-23 (ex: 6,12,20)")
			painel.Botao("🕐 Definir hora", function()
				local h = tonumber(campoHora.Text)
				if h then remotes.GenesisAcao:FireServer("DayNightHora", h) end
			end)
			painel.Botao("🌗 Ciclo ON 20min", function()
				remotes.GenesisAcao:FireServer("DayNightCiclo", true, 20)
			end)
			painel.Botao("⏸ Ciclo OFF", function()
				remotes.GenesisAcao:FireServer("DayNightCiclo", false)
			end)

			painel.Texto("— QUEM DECIDE? —", DockUI.Tema.Destaque)
			painel.Botao("✦ IA FAZ: clima + luz ideal", function()
				remotes.GenesisAcao:FireServer("IAMensagem", "Configure preset visual ideal, 3 light probes, estacao e ciclo dia/noite. Use DayNight+LightProbe.")
			end)
		end,
	})

	-- ============ PAINEL FISICA (F8) 65% ===========
	P.Fisica = DockUI.CriarPainel({
		Titulo = "Fisica",
		Largura = 360,
		Altura = 580,
		Posicao = UDim2.new(0, 320, 0, 490),
		AoAbrir = function(painel)
			painel.Limpar()
			painel.Texto("PRESETS DE FISICA (F8 65%)", DockUI.Tema.Destaque)
			local lista = remotes.GenesisConsulta:InvokeServer("FisicaLista")
			for _, item in ipairs(lista or {}) do
				painel.Botao("⚙ " .. item.Nome .. (item.Atual and "  ← ATIVO" or ""), function()
					remotes.GenesisAcao:FireServer("AplicarFisica", item.Nome)
					task.wait(0.2)
					painel.Alternar(true)
				end)
				if item.Descricao ~= "" then
					painel.Texto("   " .. item.Descricao, DockUI.Tema.TextoFraco)
				end
			end
			painel.Texto("— VENTO GLOBAL —", DockUI.Tema.Destaque)
			local vx = painel.Campo("Vento X (ex: 5)")
			local vz = painel.Campo("Vento Z (ex: 3)")
			painel.Botao("Aplicar vento", function()
				remotes.GenesisAcao:FireServer("DefinirVento", tonumber(vx.Text) or 0, tonumber(vz.Text) or 0)
			end)

			painel.Texto("— RAGDOLL (F8) —", DockUI.Tema.Destaque)
			local modos = remotes.GenesisConsulta:InvokeServer("RagdollModos") or {}
			for _, m in ipairs(modos) do
				painel.Texto("  " .. m.Nome .. " — " .. m.Desc, DockUI.Tema.TextoFraco)
			end
			painel.Botao("💀 Ragdoll Morto no mais proximo", function()
				remotes.GenesisAcao:FireServer("RagdollAplicar", "Morto", "Carne")
			end)
			painel.Botao("🧍 Remover ragdoll", function()
				remotes.GenesisAcao:FireServer("RagdollRemover")
			end)

			painel.Texto("— QUEM DECIDE? —", DockUI.Tema.Destaque)
			painel.Botao("✦ IA FAZ: fisica + ragdoll demo", function()
				remotes.GenesisAcao:FireServer("IAMensagem", "Configure fisica ideal e demonstre ragdoll Relaxado em NPC. Explique densidades RRW.")
			end)
		end,
	})

	-- ============ PAINEL PUBLISH (F12) 85% ===========
	P.Publish = DockUI.CriarPainel({
		Titulo = "Publicar",
		Largura = 360,
		Altura = 500,
		Posicao = UDim2.new(1, -380, 0, 10),
		AoAbrir = function(painel)
			painel.Limpar()
			painel.Texto("PUBLISHER — F12 85% v2.5", DockUI.Tema.Destaque)
			painel.Texto("WorldSerializer + VersionManager + Open Cloud.", DockUI.Tema.TextoFraco)

			local vers = remotes.GenesisConsulta:InvokeServer("VersionAtual")
			if vers then
				painel.Texto("Versao: " .. vers.Atual .. " | Total: " .. vers.Total, DockUI.Tema.Destaque)
			end
			local lista = remotes.GenesisConsulta:InvokeServer("VersionLista") or {}
			for i=#lista, math.max(1, #lista-4), -1 do
				local v = lista[i]
				if v then
					painel.Texto("📦 v" .. v.Versao .. " — " .. v.Changelog, DockUI.Tema.TextoFraco)
				end
			end

			local campoChange = painel.Campo("Changelog (ex: adicionada vila)")
			painel.Botao("💾 Salvar nova versao", function()
				remotes.GenesisAcao:FireServer("VersionNova", campoChange.Text ~= "" and campoChange.Text or "Snapshot")
				task.wait(0.3)
				painel.Alternar(true)
			end, DockUI.Tema.Destaque)

			local campoVers = painel.Campo("Versao rollback (ex: 1.2.3)")
			painel.Botao("↩ Rollback", function()
				if campoVers.Text ~= "" then
					remotes.GenesisAcao:FireServer("VersionRollback", campoVers.Text)
				end
			end, DockUI.Tema.Perigo)

			painel.Abas({ "patch","minor","major" }, function(tipo)
				remotes.GenesisAcao:FireServer("VersionIncrementar", tipo)
				task.wait(0.2)
				painel.Alternar(true)
			end)

			painel.Botao("✦ IA FAZ: versionar + publicar Open Cloud", function()
				remotes.GenesisAcao:FireServer("IAMensagem", "Crie snapshot versionado com changelog e publique via Open Cloud. Use v2.5 + VersionManager.")
			end)

			painel.Texto("Serializer v2.5: Dialogue+Crowd+Ragdoll+Probes+DayNight+Version+AntiCheat+CrossServer+Timeline.", DockUI.Tema.TextoFraco)
		end,
	})

	return P
end

return PaneisMundo
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX728810"><Properties><string name="Name">PropertiesDynamic</string><ProtectedString name="Source"><![CDATA[
local PropertiesDynamic = {}
PropertiesDynamic.Tipos={
  String={Editor="CaixaTexto", Icone="📝"},
  Number={Editor="CaixaNumero", Icone="🔢"},
  Bool={Editor="CaixaSelecao", Icone="☑️"},
  Color={Editor="SeletorCor", Icone="🎨"},
  Vector3={Editor="Vetor3", Icone="📐"},
  Enum={Editor="Dropdown", Icone="▼"},
  Instance={Editor="SeletorInstancia", Icone="🔗"},
}

function PropertiesDynamic.novo()
  return setmetatable({
    Propriedades={},
    CustomProps={},
    Categorias={"Transform","Appearance","Data","ArkheCustom","Physics","Audio","Custom"},
    Editavel=true,
    Dinamico=true,
  }, {__index=PropertiesDynamic})
end

function PropertiesDynamic:RegistrarPropriedade(nome, tipo, valor, categoria, custom, opcoes)
  categoria=categoria or "Data"
  self.Propriedades[nome]={
    Nome=nome,
    Tipo=tipo or "String",
    Valor=valor,
    Categoria=categoria,
    Custom=custom or false,
    Opcoes=opcoes or {},
    Editor=PropertiesDynamic.Tipos[tipo] and PropertiesDynamic.Tipos[tipo].Editor or "CaixaTexto",
    Editavel=true,
  }
  if custom then self.CustomProps[nome]=self.Propriedades[nome] end
end

function PropertiesDynamic:RegistrarTodasRoblox()
  -- Todas as properties do Roblox + nossas
  local robloxProps={
    {"Name","String","Part","Appearance",false},
    {"Position","Vector3",{X=0,Y=0,Z=0},"Transform",false},
    {"Size","Vector3",{X=4,Y=1,Z=2},"Transform",false},
    {"Color","Color",{R=255,G=255,B=255},"Appearance",false},
    {"Material","Enum","Plastic","Appearance",false},
    {"Anchored","Bool",true,"Physics",false},
    {"CanCollide","Bool",true,"Physics",false},
    {"Transparency","Number",0,"Appearance",false},
    {"CastShadow","Bool",true,"Appearance",false},
    -- NOSSAS CUSTOM
    {"Arkhe_Material","String","Grama","ArkheCustom",true},
    {"Arkhe_Bioma","Enum","Floresta","ArkheCustom",true,{"Floresta","Deserto","Neve","Campo"}},
    {"Arkhe_Queimavel","Bool",true,"ArkheCustom",true},
    {"Arkhe_Destrutivel","Bool",false,"ArkheCustom",true},
    {"Arkhe_Fidelidade","Number",4,"ArkheCustom",true},
    {"Arkhe_Occlusao","Number",0.5,"ArkheCustom",true},
    {"Arkhe_Peso","Number",1,"ArkheCustom",true},
    {"Arkhe_Temperatura","Number",20,"ArkheCustom",true},
    {"Arkhe_Umidade","Number",0.5,"ArkheCustom",true},
  }
  for _, p in ipairs(robloxProps) do
    self:RegistrarPropriedade(p[1], p[2], p[3], p[4], p[5], p[6])
  end
end

function PropertiesDynamic:Editar(nome, novoValor)
  if not self.Propriedades[nome] then return false, "prop nao existe" end
  if not self.Propriedades[nome].Editavel then return false, "nao editavel" end
  self.Propriedades[nome].Valor=novoValor
  return true
end

function PropertiesDynamic:ListarPorCategoria(cat)
  local res={}
  for _, prop in pairs(self.Propriedades) do
    if prop.Categoria==cat then table.insert(res, prop) end
  end
  return res
end

function PropertiesDynamic:ListarTodas() return self.Propriedades end
function PropertiesDynamic:ListarCustom() return self.CustomProps end
function PropertiesDynamic:Contar() local n=0 for _ in pairs(self.Propriedades) do n=n+1 end return n end
function PropertiesDynamic:Serializar() return {Total=self:Contar(), Custom=self:ContarCustom(), Categorias=self.Categorias} end
function PropertiesDynamic:ContarCustom() local n=0 for _ in pairs(self.CustomProps) do n=n+1 end return n end
return PropertiesDynamic
]]></ProtectedString></Properties></Item>
