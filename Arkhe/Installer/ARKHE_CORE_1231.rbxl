     <Item class="ModuleScript" referent="RBX705189"><Properties><string name="Name">Physica</string><ProtectedString name="Source"><![CDATA[--[[
	PHYSICA (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Physica > Physica
	============================================================
	F8 — FISICA EM CAMADAS DA ARKHE (Ring1, substituivel).
	Presets de fisica POR GENERO aplicados ao mundo inteiro:
	gravidade, movimento dos personagens, vento global (afeta
	nuvens/grama/particulas nativamente via workspace.GlobalWind),
	rajadas procedurais e "sensacao" (aceleracao/atrito).

	- 6 presets: Arcade, Realista, Lunar, Brutal, Subaquatico, Espacial
	- Registrar() preset proprio (dev OU IA)
	- Vento global + rajadas (ruido senoidal, zero custo)
	- Aplica a jogadores vivos E futuros (CharacterAdded)
	- Flutuacao por densidade: consulta a MATERIA do RRW
	  (a agua da Arkhe sabe o que boia — madeira sim, rocha nao)
	============================================================
]]

local Players = game:GetService("Players")

local Physica = {}
Physica.Atual = nil
Physica.VentoBase = Vector3.new(4, 0, 2)
Physica.RajadaForca = 0 -- 0..1
local relogio = 0

-- ============ PRESETS ============
Physica.Catalogo = {
	Arcade = {
		Descricao = "Responsivo e divertido: pulo alto, queda rapida",
		Gravidade = 240, WalkSpeed = 20, JumpHeight = 9,
		Vento = Vector3.new(2, 0, 1), Rajadas = 0.1,
		HipHeightExtra = 0, AutoRotate = true,
	},
	Realista = {
		Descricao = "Peso real: 9.8m/s2 em escala Roblox, pulo humano",
		Gravidade = 196.2, WalkSpeed = 14, JumpHeight = 4.2,
		Vento = Vector3.new(5, 0, 3), Rajadas = 0.25,
		HipHeightExtra = 0, AutoRotate = true,
	},
	Lunar = {
		Descricao = "1/6 da gravidade: saltos longos, poeira lenta",
		Gravidade = 32.7, WalkSpeed = 11, JumpHeight = 12,
		Vento = Vector3.new(0, 0, 0), Rajadas = 0,
		HipHeightExtra = 0, AutoRotate = true,
	},
	Brutal = {
		Descricao = "Souls-like: pesado, pulo curto, sem perdao",
		Gravidade = 260, WalkSpeed = 12, JumpHeight = 3,
		Vento = Vector3.new(7, 0, 4), Rajadas = 0.4,
		HipHeightExtra = 0, AutoRotate = true,
	},
	Subaquatico = {
		Descricao = "Tudo lento e flutuante, como fundo do mar",
		Gravidade = 60, WalkSpeed = 8, JumpHeight = 7,
		Vento = Vector3.new(1, 0, 1), Rajadas = 0.6, -- correntes
		HipHeightExtra = 0.4, AutoRotate = true,
	},
	Espacial = {
		Descricao = "Microgravidade: quase zero-G, drift total",
		Gravidade = 8, WalkSpeed = 9, JumpHeight = 18,
		Vento = Vector3.new(0, 0, 0), Rajadas = 0,
		HipHeightExtra = 0, AutoRotate = false,
	},
}

-- ============ APLICACAO ============
local function aplicarNoPersonagem(char, p)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	hum.WalkSpeed = p.WalkSpeed
	hum.UseJumpPower = false
	hum.JumpHeight = p.JumpHeight
	hum.AutoRotate = p.AutoRotate
	hum.HipHeight = hum.HipHeight + (p.HipHeightExtra or 0)
end

function Physica.Aplicar(nome)
	local p = Physica.Catalogo[nome]
	if not p then return false, "preset '" .. tostring(nome) .. "' nao existe" end
	workspace.Gravity = p.Gravidade
	Physica.VentoBase = p.Vento
	Physica.RajadaForca = p.Rajadas or 0
	for _, jogador in ipairs(Players:GetPlayers()) do
		if jogador.Character then
			aplicarNoPersonagem(jogador.Character, p)
		end
	end
	Physica.Atual = nome
	return true
end

-- chama uma vez no boot: personagens futuros ja nascem no preset
function Physica.Instalar()
	Players.PlayerAdded:Connect(function(jogador)
		jogador.CharacterAdded:Connect(function(char)
			task.wait(0.3)
			local p = Physica.Catalogo[Physica.Atual]
			if p then aplicarNoPersonagem(char, p) end
		end)
	end)
end

-- ============ VENTO (tick barato, chame a ~5 Hz) ============
-- GlobalWind move nuvens dinamicas, grama do terreno e particulas
-- de graca (nativo). Rajadas = ruido senoidal em 2 frequencias.
function Physica.TickVento(dt)
	relogio = relogio + dt
	local rajada = 0
	if Physica.RajadaForca > 0 then
		rajada = (math.sin(relogio * 0.7) * 0.6 + math.sin(relogio * 2.3) * 0.4)
			* Physica.RajadaForca
	end
	local vento = Physica.VentoBase * (1 + rajada)
	workspace.GlobalWind = vento
	return vento
end

-- ============ FLUTUACAO POR MATERIA (RRW!) ============
-- Densidade < 1 boia na agua da Arkhe. Devolve forca de empuxo
-- sugerida para uma part de massa m com materia semantica.
function Physica.Empuxo(materia, massa)
	if not materia or not materia.Fisica then return 0 end
	local densidade = materia.Fisica.Densidade or 1
	if densidade >= 1 then return 0 end
	-- empuxo proporcional a quao mais leve que a agua a materia e
	return workspace.Gravity * massa * (1 - densidade) * 1.15
end

-- ============ EXTENSAO ============
function Physica.Registrar(nome, def)
	if type(nome) ~= "string" or type(def) ~= "table" then return false end
	def.Gravidade = def.Gravidade or 196.2
	def.WalkSpeed = def.WalkSpeed or 16
	def.JumpHeight = def.JumpHeight or 7.2
	def.Vento = def.Vento or Vector3.new(0, 0, 0)
	def.Rajadas = def.Rajadas or 0
	def.AutoRotate = (def.AutoRotate ~= false)
	Physica.Catalogo[nome] = def
	return true
end

function Physica.Listar()
	local nomes = {}
	for nome, p in pairs(Physica.Catalogo) do
		table.insert(nomes, { Nome = nome, Descricao = p.Descricao or "" })
	end
	table.sort(nomes, function(a, b) return a.Nome < b.Nome end)
	return nomes
end

return Physica
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX776828"><Properties><string name="Name">Ragdoll</string><ProtectedString name="Source"><![CDATA[--[[
	Ragdoll (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Physica > Ragdoll
	============================================================
	F8 — RAGDOLL ATIVO com constraints por matéria RRW
	- Cria BallSocket e Hinge constraints para rig R6/R15
	- Densidade da matéria RRW afeta massa e limites
	- Modos: Relaxado, Ativo (mantém pose), Morto
	- Integra com Physica presets
	============================================================
]]

local Ragdoll = {}

Ragdoll.Modos = { Relaxado="Relaxado", Ativo="Ativo", Morto="Morto" }

-- Densidade por matéria RRW -> massa
Ragdoll.DensidadeMateria = {
	Madeira = 0.6,
	Rocha = 2.5,
	Metal = 7.8,
	Carne = 1.0,
	Osso = 1.8,
	Cristal = 2.2,
	Tecido = 0.3,
}

function Ragdoll.CalcularMassa(parte, materia)
	local densidade = Ragdoll.DensidadeMateria[materia] or 1.0
	local volume = parte.Size.X * parte.Size.Y * parte.Size.Z
	return volume * densidade * 0.5
end

function Ragdoll.CriarConstraintsR6(modelo, modo, materia)
	modo = modo or "Relaxado"
	materia = materia or "Carne"
	local constraints = {}
	local function criarBallSocket(part0, part1, nome, limites)
		local att0 = Instance.new("Attachment")
		att0.Name = nome.."_Att0"
		att0.Parent = part0
		local att1 = Instance.new("Attachment")
		att1.Name = nome.."_Att1"
		att1.Parent = part1
		local bs = Instance.new("BallSocketConstraint")
		bs.Name = nome
		bs.Attachment0 = att0
		bs.Attachment1 = att1
		bs.LimitsEnabled = limites ~= nil
		if limites then
			bs.UpperAngle = limites.Upper or 45
			bs.TwistLimitsEnabled = true
			bs.TwistLowerAngle = limites.TwistLower or -45
			bs.TwistUpperAngle = limites.TwistUpper or 45
		end
		bs.Restitution = 0.2
		bs.Parent = part0
		table.insert(constraints, bs)
		return bs
	end

	local torso = modelo:FindFirstChild("Torso") or modelo:FindFirstChild("UpperTorso") or modelo:FindFirstChild("HumanoidRootPart")
	if not torso then return constraints end

	-- Cabeça
	local head = modelo:FindFirstChild("Head")
	if head then criarBallSocket(torso, head, "Neck", { Upper=30, TwistLower=-40, TwistUpper=40 }) end

	-- Braços R6
	local leftArm = modelo:FindFirstChild("Left Arm") or modelo:FindFirstChild("LeftUpperArm")
	local rightArm = modelo:FindFirstChild("Right Arm") or modelo:FindFirstChild("RightUpperArm")
	if leftArm then criarBallSocket(torso, leftArm, "LeftShoulder", { Upper=90, TwistLower=-90, TwistUpper=90 }) end
	if rightArm then criarBallSocket(torso, rightArm, "RightShoulder", { Upper=90, TwistLower=-90, TwistUpper=90 }) end

	-- Pernas R6
	local leftLeg = modelo:FindFirstChild("Left Leg") or modelo:FindFirstChild("LeftUpperLeg")
	local rightLeg = modelo:FindFirstChild("Right Leg") or modelo:FindFirstChild("RightUpperLeg")
	if leftLeg then criarBallSocket(torso, leftLeg, "LeftHip", { Upper=60, TwistLower=-30, TwistUpper=30 }) end
	if rightLeg then criarBallSocket(torso, rightLeg, "RightHip", { Upper=60, TwistLower=-30, TwistUpper=30 }) end

	-- Ajusta massa por matéria
	for _, part in ipairs(modelo:GetDescendants()) do
		if part:IsA("BasePart") then
			local massa = Ragdoll.CalcularMassa(part, materia)
			-- CustomPhysicalProperties: density
			part.CustomPhysicalProperties = PhysicalProperties.new(massa, 0.5, 0.3, 1, 1)
			if modo == "Morto" then
				part.CanCollide = true
			else
				part.CanCollide = false
			end
		end
	end

	-- Se modo Relaxado, desativa Motor6D
	if modo == "Relaxado" or modo == "Morto" then
		for _, j in ipairs(modelo:GetDescendants()) do
			if j:IsA("Motor6D") then j.Enabled = false end
		end
	end

	return constraints
end

function Ragdoll.RemoverRagdoll(modelo)
	for _, c in ipairs(modelo:GetDescendants()) do
		if c:IsA("BallSocketConstraint") or c:IsA("HingeConstraint") or c:IsA("Attachment") then
			if c.Name:find("Neck") or c.Name:find("Shoulder") or c.Name:find("Hip") then
				c:Destroy()
			end
		end
		if c:IsA("Motor6D") then c.Enabled = true end
	end
	for _, p in ipairs(modelo:GetDescendants()) do
		if p:IsA("BasePart") then p.CanCollide = false end
	end
end

function Ragdoll.AplicarForcaRagdoll(modelo, forca, pos)
	local root = modelo:FindFirstChild("HumanoidRootPart") or modelo.PrimaryPart
	if root then
		root:ApplyImpulse(forca * root.AssemblyMass)
	end
end

function Ragdoll.ListarModos()
	return {
		{ Nome="Relaxado", Desc="Ragdoll total, Motor6D desativado, colisão ativada" },
		{ Nome="Ativo", Desc="Ragdoll com pose assistida, mantém animação parcial" },
		{ Nome="Morto", Desc="Morte completa, sem colisão entre partes do mesmo modelo" },
	}
end

function Ragdoll.SerializarConstraints(constraints)
	local lista={}
	for _, c in ipairs(constraints) do
		table.insert(lista, { Nome=c.Name, Tipo=c.ClassName, Enabled=c.Enabled })
	end
	return lista
end

return Ragdoll
]]></ProtectedString></Properties></Item>
