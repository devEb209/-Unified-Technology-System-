     <Item class="ModuleScript" referent="RBX409364"><Properties><string name="Name">RiverSpline</string><ProtectedString name="Source"><![CDATA[--[[
	RiverSpline (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Terrain > RiverSpline
	============================================================
	F4 — RIOS por spline Catmull-Rom que carva o heightfield.
	- Pontos com largura e profundidade
	- CarvarNoCampo: baixa terreno ao longo do rio + suaviza margens
	- Serializavel
	============================================================
]]

local RiverSpline = {}
RiverSpline.__index = RiverSpline

function RiverSpline.novo(nome)
	local self = setmetatable({}, RiverSpline)
	self.Nome = nome or "Rio"
	self.Pontos = {} -- { Pos=Vector3, Largura=number, Prof=number }
	return self
end

function RiverSpline:AdicionarPonto(pos, largura, prof)
	largura = math.clamp(largura or 18, 4, 80)
	prof = math.clamp(prof or 6, 1, 20)
	table.insert(self.Pontos, { Pos=pos, Largura=largura, Prof=prof })
	return #self.Pontos
end

-- Catmull-Rom interpolation
local function catmullRom(p0,p1,p2,p3,t)
	local t2 = t*t
	local t3 = t2*t
	return 0.5 * (
		(2*p1) +
		(-p0 + p2)*t +
		(2*p0 -5*p1 +4*p2 -p3)*t2 +
		(-p0 +3*p1 -3*p2 +p3)*t3
	)
end

function RiverSpline:Interpolar(t) -- t 0..1 ao longo da spline
	local n = #self.Pontos
	if n == 0 then return nil end
	if n == 1 then return self.Pontos[1].Pos end
	local seg = (n-1) * t
	local i = math.floor(seg) + 1
	local f = seg - math.floor(seg)
	i = math.clamp(i, 1, n-1)
	local p0 = self.Pontos[math.max(1,i-1)].Pos
	local p1 = self.Pontos[i].Pos
	local p2 = self.Pontos[math.min(n,i+1)].Pos
	local p3 = self.Pontos[math.min(n,i+2)].Pos
	return catmullRom(p0,p1,p2,p3,f)
end

function RiverSpline:CarvarNoCampo(campo)
	if not campo or #self.Pontos < 2 then return 0 end
	local meio = campo.Largura / 2
	local cel = campo.Celula
	local carved = 0
	-- amostra rio em 120 pontos
	local amostras = {}
	for s=0,120 do
		local t = s/120
		local pos = self:Interpolar(t)
		if pos then
			local idx = math.floor(t*(#self.Pontos-1))+1
			local largura = self.Pontos[math.clamp(idx,1,#self.Pontos)].Largura
			local prof = self.Pontos[math.clamp(idx,1,#self.Pontos)].Prof
			table.insert(amostras, { Pos=pos, Largura=largura, Prof=prof })
		end
	end
	for x=0,campo.Largura do
		for z=0,campo.Largura do
			local wx = (x - meio)*cel
			local wz = (z - meio)*cel
			local p2d = Vector3.new(wx,0,wz)
			local menorDist = math.huge
			local amostraPerto = nil
			for _, am in ipairs(amostras) do
				local d = (Vector3.new(am.Pos.X,0,am.Pos.Z) - p2d).Magnitude
				if d < menorDist then
					menorDist = d
					amostraPerto = am
				end
			end
			if amostraPerto and menorDist < amostraPerto.Largura then
				local fator = 1 - (menorDist / amostraPerto.Largura)
				-- curva cosseno para leito suave
				local carve = math.cos((1-fator)*math.pi/2) * amostraPerto.Prof
				campo.Alturas[x][z] = campo.Alturas[x][z] - carve
				carved = carved + 1
			end
		end
	end
	return carved
end

function RiverSpline:Serializar()
	return { Nome=self.Nome, Pontos=self.Pontos, Total=#self.Pontos }
end

function RiverSpline:Contar() return #self.Pontos end
function RiverSpline:Limpar() self.Pontos = {} end

return RiverSpline
]]></ProtectedString></Properties></Item>
