function Modal.novo() return setmetatable({Nome="Modal", Ativo=true, Dados={}}, {__index=Modal}) end
function Modal:Ativar() self.Ativo=true end
function Modal:Desativar() self.Ativo=false end
function Modal:Tick(dt) end
function Modal:Serializar() return {Nome=self.Nome, Ativo=self.Ativo} end
return Modal
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX559700"><Properties><string name="Name">MultiSelect</string><ProtectedString name="Source"><![CDATA[[[
	MultiSelect (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Genesis > MultiSelect
	============================================================
	F2 — MULTI-SELEÇÃO, DUPLICAR, AGRUPAR, ALINHAR, DISTRIBUIR
	- Seleção múltipla: lista de entidadeIds
	- Operações: Duplicar, Agrupar (cria grupo), Desagrupar,
	  Alinhar (Topo/Centro/Fundo/Esquerda/Direita),
	  Distribuir (horizontal/vertical), Deletar em massa
	- BBox: calcula bounding box da seleção
	- Integra com Explorer + Properties + RRW World
	============================================================
]]

local MultiSelect = {}
MultiSelect.__index = MultiSelect

function MultiSelect.novo()
	local self = setmetatable({}, MultiSelect)
	self.Selecionados = {} -- [id] = true
	self.Grupos = {} -- [grupoId] = { Nome, Membros={id,...}, BBox }
	self.ProximoGrupoId = 1
	self.Historico = {} -- { Quando, Acao, Ids }
	return self
end

function MultiSelect:Selecionar(id)
	self.Selecionados[id]=true
	return true
end

function MultiSelect:Desselecionar(id)
	self.Selecionados[id]=nil
	return true
end

function MultiSelect:Limpar()
	self.Selecionados={}
	return true
end

function MultiSelect:Alternar(id)
	if self.Selecionados[id] then self.Selecionados[id]=nil else self.Selecionados[id]=true end
	return self.Selecionados[id] ~= nil
end

function MultiSelect:Listar()
	local lista={}
	for id,_ in pairs(self.Selecionados) do table.insert(lista, id) end
	return lista
end

function MultiSelect:Contar()
	local c=0 for _ in pairs(self.Selecionados) do c=c+1 end return c
end

function MultiSelect:CalcularBBox(world)
	-- world: RRW World com ObterEntidade
	local minX, minY, minZ = math.huge, math.huge, math.huge
	local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
	local tem=false
	for id,_ in pairs(self.Selecionados) do
		if world and world.ObterEntidade then
			local ok, ent = pcall(function() return world:ObterEntidade(id) end)
			if ok and ent and ent.Pos then
				tem=true
				minX = math.min(minX, ent.Pos.X); minY = math.min(minY, ent.Pos.Y); minZ = math.min(minZ, ent.Pos.Z)
				maxX = math.max(maxX, ent.Pos.X); maxY = math.max(maxY, ent.Pos.Y); maxZ = math.max(maxZ, ent.Pos.Z)
			end
		end
	end
	if not tem then return nil end
	return {
		Min=Vector3.new(minX,minY,minZ),
		Max=Vector3.new(maxX,maxY,maxZ),
		Centro=Vector3.new((minX+maxX)/2, (minY+maxY)/2, (minZ+maxZ)/2),
		Tamanho=Vector3.new(maxX-minX, maxY-minY, maxZ-minZ),
	}
end

function MultiSelect:Duplicar(world)
	-- retorna lista de novos ids (simulado)
	local novos={}
	for id,_ in pairs(self.Selecionados) do
		table.insert(novos, id.."_copy_"..math.random(1000,9999))
	end
	table.insert(self.Historico, { Quando=os.time(), Acao="Duplicar", Ids=self:Listar(), Novos=novos })
	if #self.Historico > 30 then table.remove(self.Historico,1) end
	return novos
end

function MultiSelect:Agrupar(nome)
	local membros = self:Listar()
	if #membros < 2 then return nil, "Precisa de 2+ selecionados" end
	local grupoId = "grupo_"..self.ProximoGrupoId
	self.ProximoGrupoId = self.ProximoGrupoId + 1
	self.Grupos[grupoId] = { Id=grupoId, Nome=nome or grupoId, Membros=membros, CriadoEm=os.time() }
	table.insert(self.Historico, { Quando=os.time(), Acao="Agrupar", Ids=membros, Grupo=grupoId })
	return grupoId, self.Grupos[grupoId]
end

function MultiSelect:Desagrupar(grupoId)
	if not self.Grupos[grupoId] then return false end
	self.Grupos[grupoId]=nil
	table.insert(self.Historico, { Quando=os.time(), Acao="Desagrupar", Grupo=grupoId })
	return true
end

function MultiSelect:Alinhar(eixo, world)
	-- eixo: Topo/Centro/Fundo/Esquerda/Direita/CentroX/CentroZ
	local bbox = self:CalcularBBox(world)
	if not bbox then return false end
	-- retorna deslocamentos para cada entidade (simulado)
	local deslocamentos={}
	for id,_ in pairs(self.Selecionados) do
		deslocamentos[id]=Vector3.new(0,0,0) -- placeholder
	end
	table.insert(self.Historico, { Quando=os.time(), Acao="Alinhar "..eixo, Ids=self:Listar() })
	return deslocamentos
end

function MultiSelect:Distribuir(direcao, espacamento, world)
	direcao = direcao or "Horizontal" -- Horizontal/Vertical
	espacamento = espacamento or 5
	local lista = self:Listar()
	if #lista < 3 then return nil, "Precisa de 3+ para distribuir" end
	table.insert(self.Historico, { Quando=os.time(), Acao="Distribuir "..direcao, Ids=lista })
	return true
end

function MultiSelect:Deletar(world)
	local ids = self:Listar()
	if world and world.RemoverEntidade then
		for _, id in ipairs(ids) do
			pcall(function() world:RemoverEntidade(id) end)
		end
	end
	table.insert(self.Historico, { Quando=os.time(), Acao="Deletar", Ids=ids })
	self:Limpar()
	return #ids
end

function MultiSelect:Serializar()
	return {
		Selecionados=self:Listar(),
		Total=self:Contar(),
		Grupos=(function() local c=0 for _ in pairs(self.Grupos) do c=c+1 end return c end)(),
		HistoricoRecente=(function()
			local l={}
			for i=math.max(1,#self.Historico-4), #self.Historico do table.insert(l, self.Historico[i]) end
			return l
		end)(),
	}
end

return MultiSelect
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX142634"><Properties><string name="Name">Notification</string><ProtectedString name="Source"><![CDATA[
