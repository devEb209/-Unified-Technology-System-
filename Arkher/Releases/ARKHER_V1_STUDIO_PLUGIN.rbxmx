		"arkher/catalog/m/M_0614_namegen_ledger",
		"arkher/catalog/m/M_0615_namegen_registry",
		"arkher/catalog/m/M_0616_namegen_recovery",
	}
	Index.count = 5150

	function Index.load(loader)
		local systems = {}
		for _, id in ipairs(Index.modules) do
			systems[#systems + 1] = loader:import(id)
		end
		return systems
	end

	function Index.byCategory(loader, category)
		local out = {}
		for _, id in ipairs(Index.modules) do
			local sys = loader:import(id)
			if sys.category == category then out[#out + 1] = sys end
		end
		return out
	end

	return Index
end
</ProtectedString>
</Properties>
