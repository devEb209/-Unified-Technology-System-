local function eq(a,b,message) assert(a==b,message or (tostring(a).." ~= "..tostring(b))) end
local function near(a,b) assert(math.abs(a-b)<.00001,tostring(a).." ~= "..tostring(b)) end
local function rejects(fn) local ok=pcall(fn);assert(not ok,"Expected rejection") end
local function test(name,fn) fn();recordPass(name) end
local function add(project, raw) return project:execute({{op="add",node=raw or {kind="box"}}},project.state.revision).created[1] end

test("project owns data independently of Roblox Instances",function()
	local p=Project.new();local id=add(p)
	eq(p.state.nodes[id].kind,"box");eq(p.state.revision,1)
end)
test("state is immutable outside transactions",function()
	local p=Project.new();local id=add(p)
	rejects(function() p.state.nodes[id].name="changed" end)
	local copy=p:snapshot();copy.nodes[id].name="copy";assert(p.state.nodes[id].name~="copy")
end)
test("preview does not mutate authoring state",function()
	local p=Project.new();local r=p:preview({{op="add",node={kind="sphere"}}},0)
	eq(#r.state.order,1);eq(#p.state.order,0);eq(p.state.revision,0)
end)
test("a failed multi-command transaction changes nothing",function()
	local p=Project.new();local before=p.state
	rejects(function() p:execute({{op="add",node={kind="box"}},{op="transform",id="missing",scale=2}},0) end)
	eq(p.state,before);eq(#p.undoStack,0)
end)
test("stale revisions cannot overwrite another edit",function()
	local p=Project.new();add(p)
	rejects(function() p:execute({{op="add",node={kind="box"}}},0) end);eq(#p.state.order,1)
end)
test("undo and redo retain identity and monotonic revisions",function()
	local p=Project.new();local id=add(p);p:undo(1);eq(#p.state.order,0);eq(p.state.revision,2)
	p:redo(2);eq(p.state.order[1],id);eq(p.state.revision,3)
end)
test("new edits after undo do not reuse discarded identities",function()
	local p=Project.new();local first=add(p);p:undo(1);local second=add(p)
	assert(first~=second);rejects(function() p:redo(p.state.revision) end)
end)
test("hierarchy cycle is rejected atomically",function()
	local p=Project.new();local a=add(p,{kind="group"});local b=add(p,{kind="group",parent=a})
	rejects(function() p:execute({{op="parent",id=a,parent=b}},p.state.revision) end)
	eq(p.state.nodes[a].parent,"")
end)
test("missing parents cannot enter a project",function()
	local p=Project.new();rejects(function() add(p,{kind="box",parent="nope"}) end);eq(#p.state.order,0)
end)
test("delete is a reversible subtree transaction",function()
	local p=Project.new();local a=add(p,{kind="group"});local b=add(p,{kind="box",parent=a})
	p:execute({{op="delete",id=a}},2);eq(#p.state.order,0);p:undo(3);eq(p.state.nodes[b].parent,a)
end)
test("duplicate remaps subtree IDs instead of sharing entity state",function()
	local p=Project.new();local a=add(p,{kind="group"});local b=add(p,{kind="box",parent=a})
	local result=p:execute({{op="duplicate",id=a}},2)
	eq(#result.created,2);assert(result.created[1]~=a);eq(p.state.nodes[result.created[2]].parent,result.created[1])
	eq(p.state.nodes[b].parent,a)
end)
test("hierarchical translation rotation and uniform scale compose",function()
	local p=Project.new();local a=add(p,{kind="group",transform={position={x=10,y=0,z=0},rotation={x=0,y=90,z=0},scale=2}})
	local b=add(p,{kind="box",parent=a,transform={position={x=2,y=0,z=0}}})
	local pose=Transform.world(p.state,b);near(pose.position.x,10);near(pose.position.z,-4);near(pose.scale,2)
end)
test("invalid vectors and NaN never commit",function()
	local p=Project.new();rejects(function() add(p,{transform={position={x=0/0,y=0,z=0}}}) end)
	rejects(function() add(p,{transform={size={x=-1,y=2,z=2}}}) end);eq(#p.state.order,0)
end)
test("remote-like executable and cyclic data is rejected",function()
	local p=Project.new();local cycle={};cycle.a=cycle
	rejects(function() p:execute({{op="add",node={metadata=cycle}}},0) end)
	rejects(function() p:execute({{op="add",node={metadata={run=function() end}}}},0) end)
end)
test("unimplemented commands are not reported as success",function()
	local p=Project.new();rejects(function() p:execute({{op="neural-rendering-complete"}},0) end);eq(p.state.revision,0)
end)
test("material updates are validated and undoable",function()
	local p=Project.new();local id=add(p)
	p:execute({{op="surface",id=id,patch={material="wood",color={r=1,g=.2,b=.1}}}},1)
	eq(p.state.nodes[id].surface.material,"wood");p:undo(2);eq(p.state.nodes[id].surface.material,"stone")
end)
test("terrain generation is deterministic by seed",function()
	local a=Procedural.terrain({seed=9,width=8});local b=Procedural.terrain({seed=9,width=8})
	for i,h in ipairs(a.terrain.heights) do eq(h,b.terrain.heights[i]) end
	assert(a.terrain.heights[1]~=Procedural.terrain({seed=10,width=8}).terrain.heights[1])
end)
test("terrain brush edits canonical height data and supports undo",function()
	local p=Project.new();local id=p:execute({{op="terrain",options={width=4,depth=4,cell=4,seed=5}}},0).created[1]
	local height=p.state.nodes[id].terrain.heights[6]
	p:execute({{op="brush",id=id,options={x=-2,z=-2,radius=1,strength=3,mode="raise"}}},1)
	near(p.state.nodes[id].terrain.heights[6],height+3);p:undo(2);near(p.state.nodes[id].terrain.heights[6],height)
end)
test("smooth uses the original field, not order-dependent in-place neighbors",function()
	local a=Schema.node(Procedural.terrain({width=4,depth=4,seed=8}),"t")
	local b=Util.copy(a);Procedural.brush(a,{radius=40,mode="smooth"});Procedural.brush(b,{radius=40,mode="smooth"})
	for i,h in ipairs(a.terrain.heights) do near(h,b.terrain.heights[i]) end
end)
test("city generator creates geometry and actual scene hierarchy",function()
	local p=Project.new();local r=p:execute({{op="city",options={blocks=2,seed=12}}},0)
	assert(#r.created>8);local group=r.created[1]
	for i=2,#r.created do eq(p.state.nodes[r.created[i]].parent,group) end
end)
test("procedural generation respects operation budgets without partial insertion",function()
	local p=Project.new("small",{maxEntities=4});rejects(function() p:execute({{op="city",options={blocks=3}}},0) end)
	eq(#p.state.order,0)
end)
test("project replacement rejects corrupt graphs and preserves current project",function()
	local p=Project.new();add(p);local old=p.state
	local bad=p:snapshot();bad.order={"missing"}
	rejects(function() p:replace(bad,1) end);eq(p.state,old)
end)
test("project replacement round trips all authored entities",function()
	local p=Project.example();local q=Project.new();q:replace(p:snapshot(),0)
	eq(#q.state.order,#p.state.order);Schema.validate(q.state)
end)
test("graphs reject missing dependencies cycles and unsupported operators",function()
	rejects(function() Graph.compile({nodes={{id="a",op="sine",inputs={"b"}}}}) end)
	rejects(function() Graph.compile({nodes={{id="a",op="sine",inputs={"b"}},{id="b",op="sine",inputs={"a"}}}}) end)
	rejects(function() Graph.compile({nodes={{id="a",op="loadstring"}}}) end)
end)
test("visual graph performs real dataflow and emits validated scene operations",function()
	local p=Project.new();local id=add(p)
	local graph=Graph.oscillator(id,{x=2,y=10,z=3})
	local operations=Graph.evaluate(p.state,graph,math.pi/2)
	near(operations[1].position.y,13)
	p:execute({{op="graph",id="motion",graph=graph},{op="runGraph",id="motion",time=math.pi/2}},1)
	near(p.state.nodes[id].transform.position.y,13)
end)
test("simulation runs on a fork and never mutates authoring state",function()
	local p=Project.new();local id=add(p,{transform={position={x=0,y=10,z=0}},body={dynamic=true}})
	local sim=Runtime.new(p.state);sim:step(.05)
	assert(sim.state.nodes[id].transform.position.y<10);eq(p.state.nodes[id].transform.position.y,10)
end)
test("own AABB solver resolves a falling body against static geometry",function()
	local p=Project.new();add(p,{name="floor",transform={position={x=0,y=-1,z=0},size={x=30,y=2,z=30}}})
	local id=add(p,{transform={position={x=0,y=8,z=0},size={x=2,y=2,z=2}},body={dynamic=true,restitution=0}})
	local sim=Runtime.new(p.state);for _=1,100 do sim:step(.05) end
	near(sim.state.nodes[id].transform.position.y,1)
end)
test("heightfield contact uses actual generated cell height",function()
	local p=Project.new();local terrain=p:execute({{op="terrain",options={width=4,depth=4,seed=7}}},0).created[1]
	local id=add(p,{transform={position={x=0,y=18,z=0},size={x=2,y=2,z=2}},body={dynamic=true,restitution=0}})
	local sim=Runtime.new(p.state);for _=1,120 do sim:step(.05) end
	near(sim.state.nodes[id].transform.position.y,p.state.nodes[terrain].terrain.heights[11]+1)
end)
test("visual scripting drives simulation from the same scene graph",function()
	local p=Project.new();local id=add(p)
	p:execute({{op="graph",id="motion",graph=Graph.oscillator(id,{x=0,y=10,z=0})}},1)
	local sim=Runtime.new(p.state);sim:step(.05)
	near(sim.state.nodes[id].transform.position.y,10+3*math.sin(.05))
end)
test("simulation frame is not an external mutable reference to state",function()
	local p=Project.new();local id=add(p,{body={dynamic=true}});local sim=Runtime.new(p.state)
	local frame=sim:step(.05);frame.positions[id].x=999
	assert(sim.state.nodes[id].transform.position.x~=999)
end)
test("unsupported active-body overload is explicit",function()
	local p=Project.new();add(p,{body={dynamic=true}});add(p,{body={dynamic=true}})
	rejects(function() Runtime.new(p.state,{maxDynamics=1}) end)
end)
test("D-O15 budget responds to measured frame time with hysteresis",function()
	local b=Budget.new(400,33.3)
	for _=1,100 do b:sample(60,.06) end
	assert(b.current<400 and b.current>=64)
	local low=b.current;for _=1,240 do b:sample(12,.016) end
	assert(b.current>low and b.current<=400)
end)
test("local AI produces executable plans but does not apply them",function()
	local p=Project.new();local plan=Planner.localPlan("crie uma cidade 2x2 seed 9",p.state)
	local proof=Planner.validate(plan,p);assert(proof.created>0);eq(#p.state.order,0)
	p:execute(plan.operations,0);assert(#p.state.order>0);eq(plan.origin,"local-rules")
end)
test("AI does not fake universal capabilities for unsupported requests",function()
	rejects(function() Planner.localPlan("treine uma AGI perfeita",Schema.empty()) end)
end)
test("AI provider output cannot inject source or arbitrary commands",function()
	local p=Project.new()
	rejects(function() Planner.validate({format="arkher.plan/1",label="x",operations={{op="executeSource",source="danger"}}},p) end)
	eq(p.state.revision,0)
end)
test("plans are fully validated before the first entity is inserted",function()
	local p=Project.new();local plan={format="arkher.plan/1",label="mixed",operations={{op="add",node={kind="box"}},{op="add",node={kind="not-built"}}}}
	rejects(function() Planner.validate(plan,p) end);eq(#p.state.order,0)
end)
