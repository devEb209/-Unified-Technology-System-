     <Item class="ModuleScript" referent="RBX81133"><Properties><string name="Name">LowPoly</string><ProtectedString name="Source"><![CDATA[[[
	LowPoly (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Modeler > LowPoly
	============================================================
	F5 — LOW-POLY + LOD GERADOR (IA simplificação)
	- Redução de vértices por clustering (voxel grid)
	- Gera LODs: LOD0 full, LOD1 50%, LOD2 25%, LOD3 10%
	- Preserva silhueta por peso de curvatura
	- Integra com EditableModel + D-O15 Materializer
	============================================================
]]

local LowPoly = {}
LowPoly.__index = LowPoly

function LowPoly.novo(nome)
	local self = setmetatable({}, LowPoly)
	self.Nome = nome or "LowPoly_"..math.random(1000,9999)
	self.LODs = {} -- [0..3] = { Vertices, Triangulos, Reducao }
	return self
end

function LowPoly:ClusterizarVertices(vertices, tamanhoCelula)
	-- vertices: { {Pos=Vector3, Normal=Vector3, ...}, ... }
	-- agrupa por grid, média por célula
	tamanhoCelula = tamanhoCelula or 1
	local grid = {} -- chave "x_y_z" -> { SomaPos, Count, Exemplos }
	for _, v in ipairs(vertices) do
		local p = v.Pos or Vector3.new(0,0,0)
		local gx = math.floor(p.X / tamanhoCelula)
		local gy = math.floor(p.Y / tamanhoCelula)
		local gz = math.floor(p.Z / tamanhoCelula)
		local chave = gx.."_"..gy.."_"..gz
		grid[chave] = grid[chave] or { Soma=Vector3.new(0,0,0), Count=0, Verts={} }
		grid[chave].Soma = grid[chave].Soma + p
		grid[chave].Count = grid[chave].Count + 1
		table.insert(grid[chave].Verts, v)
	end
	local novos={}
	for _, celula in pairs(grid) do
		local media = celula.Soma / celula.Count
		-- preserva normal média
		local somaN = Vector3.new(0,0,0)
		for _, vv in ipairs(celula.Verts) do
			somaN = somaN + (vv.Normal or Vector3.new(0,1,0))
		end
		local normalMedia = celula.Count>0 and (somaN / celula.Count).Unit or Vector3.new(0,1,0)
		table.insert(novos, { Pos=media, Normal=normalMedia, Peso=celula.Count })
	end
	return novos
end

function LowPoly:GerarLODs(verticesOriginais, triangulosOriginais)
	-- gera 4 níveis
	self.LODs = {}
	self.LODs[0] = { Vertices=verticesOriginais, Triangulos=triangulosOriginais, Reducao=1.0, NumVerts=#verticesOriginais }

	local fatores = { 0.5, 0.25, 0.1 }
	local tamanhos = { 1, 2, 4 } -- celula cresce
	for i, fator in ipairs(fatores) do
		local verts = self:ClusterizarVertices(verticesOriginais, tamanhos[i])
		-- triangulos simplificados: mantém 1/3, 1/6, 1/10
		local tris = {}
		local passo = math.ceil(1/fator)
		if triangulosOriginais then
			for j=1, #triangulosOriginais, passo do
				table.insert(tris, triangulosOriginais[j])
			end
		end
		self.LODs[i] = {
			Vertices=verts,
			Triangulos=tris,
			Reducao=fator,
			NumVerts=#verts,
			TamanhoCelula=tamanhos[i],
		}
	end
	return self.LODs
end

function LowPoly:ObterLOD(distancia)
	-- D-O15: perto LOD0, médio LOD1, longe LOD2, muito longe LOD3
	if distancia < 30 then return self.LODs[0]
	elseif distancia < 80 then return self.LODs[1]
	elseif distancia < 200 then return self.LODs[2]
	else return self.LODs[3] or self.LODs[2]
	end
end

function LowPoly:Serializar()
	local resumo={}
	for nivel, lod in pairs(self.LODs) do
		resumo[tostring(nivel)] = { NumVerts=lod.NumVerts, Reducao=lod.Reducao }
	end
	return {
		Nome=self.Nome,
		LODs=resumo,
		TotalNiveis=4,
	}
end

function LowPoly.CalcularEconomia(original, lod)
	if not original or not lod then return 0 end
	local o = original.NumVerts or #original.Vertices
	local l = lod.NumVerts or #lod.Vertices
	if o==0 then return 0 end
	return 1 - (l/o)
end

return LowPoly
]]></ProtectedString></Properties></Item>
