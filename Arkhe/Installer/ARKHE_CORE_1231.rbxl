     <Item class="ModuleScript" referent="RBX643075"><Properties><string name="Name">LavaFlow</string><ProtectedString name="Source"><![CDATA[
local LavaFlow = {}
function LavaFlow.novo() return setmetatable({Viscosidade=0.8, Temperatura=1200, Fluxos={}}, {__index=LavaFlow}) end
function LavaFlow:AdicionarFluxo(pos, dir) table.insert(self.Fluxos,{Pos=pos, Dir=dir, Vida=10}) end
function LavaFlow:Tick(dt)
  for i=#self.Fluxos,1,-1 do
    local f=self.Fluxos[i]
    f.Vida=f.Vida-dt
    f.Pos={X=f.Pos.X+f.Dir.X*dt, Y=f.Pos.Y, Z=f.Pos.Z+f.Dir.Z*dt}
    if f.Vida<=0 then table.remove(self.Fluxos,i) end
  end
end
function LavaFlow:Serializar() return {Viscosidade=self.Viscosidade, Total=#self.Fluxos} end
return LavaFlow
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX809763"><Properties><string name="Name">MarchingCubes</string><ProtectedString name="Source"><![CDATA[
local MarchingCubes = {}
function MarchingCubes.novo() return setmetatable({IsoLevel=0, Tabela={}}, {__index=MarchingCubes}) end
function MarchingCubes:Polygonizar(voxelTerrain)
  local tris={}
  -- simplificado: gera 1 tri por voxel preenchido
  for k,mat in pairs(voxelTerrain.Voxels or {}) do if mat~="Ar" then table.insert(tris,{k,mat}) end end
  return tris
end
function MarchingCubes:Serializar() return {Iso=self.IsoLevel} end
return MarchingCubes
]]></ProtectedString></Properties></Item>
