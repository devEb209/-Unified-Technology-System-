     <Item class="ModuleScript" referent="RBX255801"><Properties><string name="Name">Bank</string><ProtectedString name="Source"><![CDATA[[[
	Bank (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Economy > Bank
	============================================================
	F18 — BANCO + COFRE DO JOGADOR
	- Conta: { Saldo, Cofre (itens guardados), Historico }
	- Operações: Depositar/Sacar moedas, Guardar/Retirar itens
	- Juros: 1% por dia (simulado)
	- Segurança: limite saque por hora anti-exploit
	============================================================
]]

local Bank = {}
Bank.__index = Bank

function Bank.novo()
	local self = setmetatable({}, Bank)
	self.Contas = {} -- [userId] = { Saldo, Cofre={}, Historico={}, UltimoJuros, SaquesHora }
	return self
end

function Bank:ObterConta(userId)
	if not self.Contas[userId] then
		self.Contas[userId] = {
			Saldo=0,
			Cofre={},
			Historico={},
			UltimoJuros=os.time(),
			SaquesHora={ Count=0, ResetEm=os.time()+3600 },
		}
	end
	return self.Contas[userId]
end

function Bank:Depositar(userId, quantidade, motivo)
	if quantidade <=0 then return false end
	local conta = self:ObterConta(userId)
	conta.Saldo = conta.Saldo + quantidade
	table.insert(conta.Historico, {
		Tipo="Deposito",
		Valor=quantidade,
		Motivo=motivo or "Deposito",
		Quando=os.time(),
		SaldoApos=conta.Saldo,
	})
	if #conta.Historico > 50 then table.remove(conta.Historico,1) end
	return true, conta.Saldo
end

function Bank:Sacar(userId, quantidade, motivo)
	if quantidade <=0 then return false end
	local conta = self:ObterConta(userId)
	-- limite saque por hora
	if os.time() > conta.SaquesHora.ResetEm then
		conta.SaquesHora = { Count=0, ResetEm=os.time()+3600 }
	end
	if conta.SaquesHora.Count >= 20 then
		return false, "Limite de saques por hora atingido"
	end
	if conta.Saldo < quantidade then
		return false, "Saldo insuficiente"
	end
	conta.Saldo = conta.Saldo - quantidade
	conta.SaquesHora.Count = conta.SaquesHora.Count + 1
	table.insert(conta.Historico, {
		Tipo="Saque",
		Valor=quantidade,
		Motivo=motivo or "Saque",
		Quando=os.time(),
		SaldoApos=conta.Saldo,
	})
	if #conta.Historico > 50 then table.remove(conta.Historico,1) end
	return true, conta.Saldo
end

function Bank:GuardarItem(userId, itemNome, qtd)
	local conta = self:ObterConta(userId)
	conta.Cofre[itemNome] = (conta.Cofre[itemNome] or 0) + (qtd or 1)
	return true, conta.Cofre[itemNome]
end

function Bank:RetirarItem(userId, itemNome, qtd)
	local conta = self:ObterConta(userId)
	local tem = conta.Cofre[itemNome] or 0
	if tem < (qtd or 1) then return false, "Item insuficiente no cofre" end
	conta.Cofre[itemNome] = tem - (qtd or 1)
	if conta.Cofre[itemNome] <=0 then conta.Cofre[itemNome]=nil end
	return true, conta.Cofre[itemNome] or 0
end

function Bank:AplicarJuros(userId)
	local conta = self:ObterConta(userId)
	local agora = os.time()
	local dias = (agora - conta.UltimoJuros) / 86400
	if dias >= 1 then
		local juros = math.floor(conta.Saldo * 0.01 * dias)
		if juros > 0 then
			conta.Saldo = conta.Saldo + juros
			table.insert(conta.Historico, {
				Tipo="Juros",
				Valor=juros,
				Motivo="Juros "..string.format("%.1f", dias).." dias",
				Quando=agora,
				SaldoApos=conta.Saldo,
			})
		end
		conta.UltimoJuros = agora
		return juros
	end
	return 0
end

function Bank:ListarCofre(userId)
	local conta = self:ObterConta(userId)
	return conta.Cofre
end

function Bank:SerializarConta(userId)
	local conta = self:ObterConta(userId)
	return {
		Saldo=conta.Saldo,
		NumItensCofre=(function() local c=0 for _ in pairs(conta.Cofre) do c=c+1 end return c end)(),
		HistoricoRecente=(function()
			local l={}
			for i=math.max(1,#conta.Historico-4), #conta.Historico do table.insert(l, conta.Historico[i]) end
			return l
		end)(),
	}
end

return Bank
]]></ProtectedString></Properties></Item>
