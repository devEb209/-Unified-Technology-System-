     <Item class="ModuleScript" referent="RBX178709"><Properties><string name="Name">AnimatedGradient</string><ProtectedString name="Source"><![CDATA[
local AnimatedGradient = {}
function AnimatedGradient.novo(preset)
  preset=preset or "Arkhe"
  return setmetatable({
    Preset=preset,
    Cores={
      {R=74,G=0,B=224, Pos=0},
      {R=120,G=0,B=200, Pos=0.25},
      {R=0,G=120,B=255, Pos=0.5},
      {R=0,G=229,B=255, Pos=0.75},
      {R=74,G=0,B=224, Pos=1},
    },
    Velocidade=1.5,
    Angulo=90,
    Direcao="Horizontal",
    Loop=true,
    Tempo=0,
  }, {__index=AnimatedGradient})
end
function AnimatedGradient:Tick(dt)
  self.Tempo=self.Tempo+dt*self.Velocidade
  if self.Tempo>1 then self.Tempo=self.Tempo-1 end
  return self:ObterCorAtual()
end
function AnimatedGradient:ObterCorAtual()
  local t=self.Tempo
  -- interpola entre cores
  for i=1,#self.Cores-1 do
    local c1=self.Cores[i]
    local c2=self.Cores[i+1]
    if t>=c1.Pos and t<=c2.Pos then
      local localT=(t-c1.Pos)/(c2.Pos-c1.Pos)
      return {
        R=c1.R+(c2.R-c1.R)*localT,
        G=c1.G+(c2.G-c1.G)*localT,
        B=c1.B+(c2.B-c1.B)*localT,
      }
    end
  end
  return self.Cores[1]
end
function AnimatedGradient:Aplicar(uiObject)
  return {UI=uiObject, Gradient=self.Cores, Animado=true, Velocidade=self.Velocidade}
end
function AnimatedGradient:Serializar() return {Preset=self.Preset, Velocidade=self.Velocidade, Animado=true} end
return AnimatedGradient
]]></ProtectedString></Properties></Item>
