     <Item class="ModuleScript" referent="RBX497046"><Properties><string name="Name">System1015_Cinematic</string><ProtectedString name="Source"><![CDATA[
local System1015_Cinematic = {}
function System1015_Cinematic.novo()
  return setmetatable({
    Id=1015,
    Familia="Cinematic",
    Nome="System1015_Cinematic",
    TopbarBotao=true,
    Menu=true,
    Submenu=true,
    Funcoes={"Novo","Abrir","Salvar","Editar","Deletar","Duplicar","Exportar","Importar","Configurar","Publicar"},
    Gradiente="Arkhe",
    Textura="Noise",
    Mobile=true,
    Console=true,
    VR=true,
    PC=true,
