     <Item class="ModuleScript" referent="RBX387056"><Properties><string name="Name">MenuBar</string><ProtectedString name="Source"><![CDATA[
local MenuBar = {}
function MenuBar.novo()
  return setmetatable({Menus={}, Estilo="StudioGradient"}, {__index=MenuBar})
end
function MenuBar:AdicionarMenu(nome, icone)
  local menu={Nome=nome, Icone=icone, Itens={}, Submenus={}}
  table.insert(self.Menus, menu)
  return menu
end
function MenuBar:AdicionarItem(menuNome, itemNome, atalho, callback)
  for _, m in ipairs(self.Menus) do
    if m.Nome==menuNome then table.insert(m.Itens, {Nome=itemNome, Atalho=atalho, Callback=callback}) end
  end
end
function MenuBar:AdicionarSubmenu(menuNome, submenuNome, itens)
  for _, m in ipairs(self.Menus) do
    if m.Nome==menuNome then table.insert(m.Submenus, {Nome=submenuNome, Itens=itens or {}}) end
  end
end
function MenuBar:Listar() return self.Menus end
function MenuBar:Serializar() local total=0 for _,m in ipairs(self.Menus) do total=total+#m.Itens end return {TotalMenus=#self.Menus, TotalItens=total, Estilo=self.Estilo} end
return MenuBar
]]></ProtectedString></Properties></Item>
