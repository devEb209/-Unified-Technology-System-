     <Item class="ModuleScript" referent="RBX333540"><Properties><string name="Name">CursorShare</string><ProtectedString name="Source"><![CDATA[
local CursorShare = {}
function CursorShare.novo()
  return setmetatable({Cursores={}, Ativo=true}, {__index=CursorShare})
end
function CursorShare:Atualizar(userId, x, y, viewport)
