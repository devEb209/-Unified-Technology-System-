     <Item class="ModuleScript" referent="RBX794344"><Properties><string name="Name">ExportCSV</string><ProtectedString name="Source"><![CDATA[--[[
  ExportCSV (ModuleScript)
  Local: ReplicatedStorage > Arkhe > Analytics > ExportCSV
  ============================================================================
  F20 — EXPORT CSV TOTAL (o que faltava pra 100%)
  - Exporta TUDO: heatmap, funil, canvas, eventos, vendas, quests
  - Gera CSV e JSON para relay / Open Cloud / DataStore
  - Contrato: Exportar, ParaCSV, ParaJSON, Payload relay
  ============================================================================
]]

local ExportCSV = {}
ExportCSV.__index = ExportCSV

function ExportCSV.novo(nome)
    local self = setmetatable({}, ExportCSV)
    self.Nome = nome or "ExportCSV"
    self.Tabelas = {} -- { Nome, Linhas = { {col=val} } }
    return self
end

function ExportCSV:AdicionarTabela(nome, linhas)
    self.Tabelas[nome] = linhas or {}
end

function ExportCSV:CarregarDeHeatmap(heatmap)
    if not heatmap then return end
    local linhas = {}
    if heatmap.Pontos then
        for _, p in ipairs(heatmap.Pontos) do
            table.insert(linhas, { X=p.X or 0, Y=p.Y or 0, Z=p.Z or 0, Count=p.Count or 1, Tipo=p.Tipo or "movimento" })
        end
    elseif heatmap.Listar then
        local ok, lista = pcall(heatmap.Listar, heatmap)
        if ok and lista then
            for _, p in ipairs(lista) do
                table.insert(linhas, { X=p.X or 0, Y=p.Y or 0, Z=p.Z or 0, Count=p.Count or 1 })
            end
        end
    end
    self.Tabelas["heatmap"] = linhas
end

function ExportCSV:CarregarDeFunnel(funnel)
    if not funnel or not funnel.Etapas then return end
    local linhas = {}
    for i, etapa in ipairs(funnel.Etapas) do
        table.insert(linhas, { Ordem=i, Nome=etapa.Nome or "etapa_"..i, Entraram=etapa.Entraram or 0, Sairam=etapa.Sairam or 0, Conversao=etapa.Conversao or 0 })
    end
    self.Tabelas["funnel"] = linhas
end

function ExportCSV:CarregarDeVendas(payout)
    if not payout or not payout.Vendas then return end
    local linhas = {}
    for _, v in ipairs(payout.Vendas) do
        table.insert(linhas, { Id=v.Id, ItemId=v.ItemId, Valor=v.Valor, Tempo=v.Tempo, Pago=v.Pago })
    end
    self.Tabelas["vendas"] = linhas
end

function ExportCSV:ParaCSV(nomeTabela)
    local linhas = self.Tabelas[nomeTabela]
    if not linhas or #linhas == 0 then return "" end
    -- cabeçalho
    local cols = {}
    for k in pairs(linhas[1]) do table.insert(cols, k) end
    table.sort(cols)
    local csv = table.concat(cols, ",") .. "\n"
    for _, linha in ipairs(linhas) do
        local vals = {}
        for _, c in ipairs(cols) do
            local v = linha[c]
            if type(v) == "string" then
                v = '"'..v:gsub('"','""')..'"'
            end
            table.insert(vals, tostring(v or ""))
        end
        csv = csv .. table.concat(vals, ",") .. "\n"
    end
    return csv
end

function ExportCSV:ParaCSV_Tudo()
    local tudo = ""
    for nome in pairs(self.Tabelas) do
        tudo = tudo .. "# Tabela: "..nome.."\n"
        tudo = tudo .. self:ParaCSV(nome) .. "\n"
    end
    return tudo
end

function ExportCSV:ParaJSON()
    local HttpService = game:GetService("HttpService")
    local ok, json = pcall(function() return HttpService:JSONEncode(self.Tabelas) end)
    return ok and json or nil
end

function ExportCSV:PayloadParaRelay()
    return {
        Nome=self.Nome,
        Tabelas=self.Tabelas,
        TotalTabelas=self:ContarTabelas(),
        CSV_Tamanho=#self:ParaCSV_Tudo(),
        JSON=self:ParaJSON(),
    }
end

function ExportCSV:ContarTabelas()
    local n=0 for _ in pairs(self.Tabelas) do n=n+1 end return n
end

function ExportCSV:Serializar()
    local totais = {}
    for nome, linhas in pairs(self.Tabelas) do totais[nome]=#linhas end
    return {
        Nome=self.Nome,
        Tabelas=totais,
        TotalTabelas=self:ContarTabelas(),
    }
end

return ExportCSV
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX398935"><Properties><string name="Name">FunnelVisual</string><ProtectedString name="Source"><![CDATA[--[[
	FunnelVisual (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Analytics > FunnelVisual
	============================================================
	F20 — VISUALIZAÇÃO DE FUNIL + HEATMAP CORES
	- Funil: Entrada -> Jogou -> Comprou -> Retornou, com taxas
	- Heatmap cores: grade 2D com intensidade -> Color3
	- Gera imagem procedural (Frame com UIGradient ou Canvas)
	- Integra com Heatmap.lua + AnalyticsRelatorio
	============================================================
]]

local FunnelVisual = {}
FunnelVisual.__index = FunnelVisual

FunnelVisual.EtapasPadrao = { "Entrada","Spawn","Explorou","Morreu","Comprou","Retornou" }

function FunnelVisual.novo(nome)
	local self = setmetatable({}, FunnelVisual)
	self.Nome = nome or "FunilPrincipal"
	self.Etapas = {} -- { Nome, Count, Taxa (0-1), Cor }
	self.Cores = {
		Entrada=Color3.fromRGB(100,150,255),
		Spawn=Color3.fromRGB(120,200,120),
		Explorou=Color3.fromRGB(255,200,80),
		Morreu=Color3.fromRGB(255,80,80),
		Comprou=Color3.fromRGB(80,255,180),
		Retornou=Color3.fromRGB(180,120,255),
	}
	return self
end

function FunnelVisual:DefinirEtapa(nome, count, taxa)
	self.Etapas[nome] = { Nome=nome, Count=count or 0, Taxa=taxa or 0 }
	return self.Etapas[nome]
end

function FunnelVisual:CalcularAPartirDeRelatorio(relatorio)
	-- relatorio: { TotalPos, TotalMorte, TotalCompra, Funil {TaxaConversao, TaxaMorte...} }
	if not relatorio then return end
	self:DefinirEtapa("Entrada", relatorio.TotalPos or 0, 1.0)
	self:DefinirEtapa("Morreu", relatorio.TotalMorte or 0, relatorio.Funil and relatorio.Funil.TaxaMorte or 0)
	self:DefinirEtapa("Comprou", relatorio.TotalCompra or 0, relatorio.Funil and relatorio.Funil.TaxaConversao or 0)
	self:DefinirEtapa("Explorou", relatorio.TotalPos or 0, 0.8)
	self:DefinirEtapa("Retornou", math.floor((relatorio.TotalPos or 0)*0.3), 0.3)
	return self.Etapas
end

function FunnelVisual:GerarBarras()
	-- retorna lista ordenada para UI
	local ordem = { "Entrada","Spawn","Explorou","Morreu","Comprou","Retornou" }
	local barras={}
	for _, nome in ipairs(ordem) do
		local etapa = self.Etapas[nome]
		if etapa then
			table.insert(barras, {
				Nome=nome,
				Count=etapa.Count,
				Taxa=etapa.Taxa,
				Cor=self.Cores[nome] or Color3.fromRGB(200,200,200),
				Largura=math.clamp(etapa.Taxa, 0.05, 1.0), -- para barra
			})
		end
	end
	return barras
end

-- Heatmap cores
FunnelVisual.HeatmapCores = {
	{ Limite=0.0, Cor=Color3.fromRGB(0,0,80) },   -- frio
	{ Limite=0.2, Cor=Color3.fromRGB(0,80,255) },
	{ Limite=0.4, Cor=Color3.fromRGB(0,200,100) },
	{ Limite=0.6, Cor=Color3.fromRGB(255,255,0) },
	{ Limite=0.8, Cor=Color3.fromRGB(255,120,0) },
	{ Limite=1.0, Cor=Color3.fromRGB(255,0,0) },  -- quente
}

function FunnelVisual.CorParaIntensidade(intensidade)
	-- intensidade 0-1 -> interpola entre cores
	intensidade = math.clamp(intensidade or 0, 0, 1)
	local cores = FunnelVisual.HeatmapCores
	for i=1, #cores-1 do
		local c1 = cores[i]
		local c2 = cores[i+1]
		if intensidade >= c1.Limite and intensidade <= c2.Limite then
			local t = (intensidade - c1.Limite) / (c2.Limite - c1.Limite)
			return Color3.new(
				c1.Cor.R + (c2.Cor.R - c1.Cor.R)*t,
				c1.Cor.G + (c2.Cor.G - c1.Cor.G)*t,
				c1.Cor.B + (c2.Cor.B - c1.Cor.B)*t
			)
		end
	end
	return cores[#cores].Cor
end

function FunnelVisual:GerarHeatmapGrade(heatmapMod, tamanho)
	-- heatmapMod: Heatmap.lua com Grade
	tamanho = tamanho or 20
	local grade={}
	if not heatmapMod or not heatmapMod.Grade then return grade end
	local maxCount=0
	for _, celula in pairs(heatmapMod.Grade) do
		if celula.Count > maxCount then maxCount = celula.Count end
	end
	if maxCount==0 then maxCount=1 end
	for chave, celula in pairs(heatmapMod.Grade) do
		local intensidade = celula.Count / maxCount
		local cor = FunnelVisual.CorParaIntensidade(intensidade)
		table.insert(grade, {
			Celula=chave,
			Count=celula.Count,
			Intensidade=intensidade,
			Cor={ R=cor.R, G=cor.G, B=cor.B },
		})
	end
	table.sort(grade, function(a,b) return a.Count > b.Count end)
	return grade
end

function FunnelVisual:Serializar()
	return {
		Nome=self.Nome,
		Etapas=self.Etapas,
		Barras=self:GerarBarras(),
		CoresHeatmap=FunnelVisual.HeatmapCores,
	}
end

return FunnelVisual
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX124740"><Properties><string name="Name">Heatmap</string><ProtectedString name="Source"><![CDATA[--[[
	Heatmap (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Analytics > Heatmap
	============================================================
	F20 — ANALYTICS: HEATMAPS (Ring1).
	Coleta onde jogadores vao, morrem, desistem, compram.

	- Registra eventos: Posicao, Morte, Compra, Desistencia
	- Agrega em celulas 10x10 studs
	- Gera relatorio: areas quentes, frias, funil
	- Serializavel para relay: POST /analytics/heatmap
	- Painel futuro mostra mapa com cores

	Verdade: sem relay, dados ficam locais. Com relay, agrega global.
	============================================================
]]

local Heatmap = {}
Heatmap.CelulaTamanho = 10
Heatmap.Dados = {
	Posicao = {}, -- ["x,z"] = count
	Morte = {},
	Compra = {},
	Desistencia = {},
}
Heatmap.MaxCelulas = 5000

local function chave(pos)
	local cx = math.floor(pos.X / Heatmap.CelulaTamanho)
	local cz = math.floor(pos.Z / Heatmap.CelulaTamanho)
	return cx .. "," .. cz
end

function Heatmap.Registrar(tipo, pos)
	tipo = tipo or "Posicao"
	Heatmap.Dados[tipo] = Heatmap.Dados[tipo] or {}
	local k = chave(pos)
	Heatmap.Dados[tipo][k] = (Heatmap.Dados[tipo][k] or 0) + 1
	-- limita
	local total=0 for _ in pairs(Heatmap.Dados[tipo]) do total=total+1 end
	if total > Heatmap.MaxCelulas then
		-- remove menor
		local menorK, menorV = nil, math.huge
		for kk,vv in pairs(Heatmap.Dados[tipo]) do if vv < menorV then menorK, menorV = kk, vv end end
		if menorK then Heatmap.Dados[tipo][menorK]=nil end
	end
end

function Heatmap.Top(tipo, n)
	n = n or 10
	tipo = tipo or "Posicao"
	local lista={}
	for k,v in pairs(Heatmap.Dados[tipo] or {}) do table.insert(lista, { Celula=k, Count=v }) end
	table.sort(lista, function(a,b) return a.Count > b.Count end)
	while #lista > n do table.remove(lista) end
	return lista
end

function Heatmap.Relatorio()
	local rel = { TotalPos=0, TotalMorte=0, TotalCompra=0, AreasQuentes={}, AreasFrias={}, Funil={} }
	for _, v in pairs(Heatmap.Dados.Posicao) do rel.TotalPos = rel.TotalPos + v end
	for _, v in pairs(Heatmap.Dados.Morte) do rel.TotalMorte = rel.TotalMorte + v end
	for _, v in pairs(Heatmap.Dados.Compra) do rel.TotalCompra = rel.TotalCompra + v end
	rel.AreasQuentes = Heatmap.Top("Posicao", 5)
	rel.AreasFrias = (function()
		local lista={}
		for k,v in pairs(Heatmap.Dados.Posicao) do table.insert(lista, { Celula=k, Count=v }) end
		table.sort(lista, function(a,b) return a.Count < b.Count end)
		while #lista > 5 do table.remove(lista) end
		return lista
	end)()
	rel.Funil = {
		Visitou = rel.TotalPos,
		Morreu = rel.TotalMorte,
		Comprou = rel.TotalCompra,
		TaxaConversao = rel.TotalPos >0 and (rel.TotalCompra/rel.TotalPos) or 0,
		TaxaMorte = rel.TotalPos >0 and (rel.TotalMorte/rel.TotalPos) or 0,
	}
	return rel
end

function Heatmap.Limpar(tipo)
	if tipo then Heatmap.Dados[tipo]={} else Heatmap.Dados={ Posicao={}, Morte={}, Compra={}, Desistencia={} } end
end

function Heatmap.Serializar()
	return Heatmap.Dados
end

function Heatmap.Deserializar(dados)
	Heatmap.Dados = dados or { Posicao={}, Morte={}, Compra={}, Desistencia={} }
end

return Heatmap
]]></ProtectedString></Properties></Item>
