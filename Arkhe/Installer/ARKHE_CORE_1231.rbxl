    Gradiente="Arkhe",
    Textura="Noise",
    Mobile=true,
    Console=true,
    VR=true,
    PC=true,
  }, {__index=System1486_Modeler})
end
function System1486_Modeler:GerarBotaoTopbar() return {Id=self.Id, Texto=self.Nome, Submenu=self.Funcoes} end
function System1486_Modeler:Serializar() return {Id=self.Id, Familia=self.Familia, Funcoes=#self.Funcoes} end
return System1486_Modeler
]]></ProtectedString></Properties></Item>
