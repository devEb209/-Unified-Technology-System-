     <Item class="ModuleScript" referent="RBX491827"><Properties><string name="Name">Accessibility</string><ProtectedString name="Source"><![CDATA[--[[
	Accessibility (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Accessibility > Accessibility
	============================================================
	F19 — ACESSIBILIDADE (Ring1).
	- Narracao por texto-para-voz (Sound + legendas)
	- Remapeamento total de teclas/botoes
	- Tamanho de fonte escalavel (para UI Builder)
	- Alto contraste, daltônico, reduzir movimento
	- Serializavel por jogador

	Integra com:
	- UIKit (fonte, cores)
	- DockUI (tema alto-contraste)
	- GenesisPanels (atalhos)

	Verdade: TTS real precisa de relay ou SoundIds pre-gravados.
	Sem relay, usa legendas + sons indicativos.
	============================================================
]]

local Accessibility = {}
Accessibility.Configs = {} -- [userId] = { FonteEscala, AltoContraste, Daltônico, ReduzirMovimento, Teclas }

function Accessibility.ObterConfig(userId)
	Accessibility.Configs[userId] = Accessibility.Configs[userId] or {
		FonteEscala = 1.0,
		AltoContraste = false,
		Daltonico = false,
		ReduzirMovimento = false,
		Narracao = false,
		Teclas = {
			MoverFrente = "W",
			MoverTras = "S",
			MoverEsq = "A",
			MoverDir = "D",
			Pular = "Space",
			Interagir = "E",
			Inventario = "I",
		},
	}
	return Accessibility.Configs[userId]
end

function Accessibility.DefinirFonteEscala(userId, escala)
	local cfg = Accessibility.ObterConfig(userId)
	cfg.FonteEscala = math.clamp(escala or 1, 0.8, 2.0)
	return cfg.FonteEscala
end

function Accessibility.DefinirAltoContraste(userId, ativo)
	local cfg = Accessibility.ObterConfig(userId)
	cfg.AltoContraste = ativo == true
	return cfg.AltoContraste
end

function Accessibility.DefinirDaltonico(userId, ativo)
	local cfg = Accessibility.ObterConfig(userId)
	cfg.Daltonico = ativo == true
	return cfg.Daltonico
end

function Accessibility.DefinirReduzirMovimento(userId, ativo)
	local cfg = Accessibility.ObterConfig(userId)
	cfg.ReduzirMovimento = ativo == true
	return cfg.ReduzirMovimento
end

function Accessibility.RemapearTecla(userId, acao, tecla)
	local cfg = Accessibility.ObterConfig(userId)
	if cfg.Teclas[acao] ~= nil then
		cfg.Teclas[acao] = tecla
		return true
	end
	return false
end

function Accessibility.Narrar(userId, texto, servicos)
	local cfg = Accessibility.ObterConfig(userId)
	if not cfg.Narracao then return false end
	-- tenta TTS via relay ou via SoundId placeholder
	if servicos and servicos.AudioMixer then
		-- placeholder: usa notificação como legenda
		if servicos.Notificar then servicos.Notificar("🔊 " .. texto) end
	end
	return true
end

function Accessibility.AplicarTemaAcessivel(userId, DockUI)
	local cfg = Accessibility.ObterConfig(userId)
	if cfg.AltoContraste then
		-- sugere tema alto-contraste
		if DockUI and DockUI.Tema then
			DockUI.Tema.Fundo = Color3.fromRGB(0,0,0)
			DockUI.Tema.Texto = Color3.fromRGB(255,255,0)
			DockUI.Tema.Destaque = Color3.fromRGB(255,255,255)
		end
	end
end

function Accessibility.ListarAcoes()
	return { "MoverFrente", "MoverTras", "MoverEsq", "MoverDir", "Pular", "Interagir", "Inventario" }
end

function Accessibility.Serializar(userId)
	return Accessibility.ObterConfig(userId)
end

function Accessibility.Deserializar(userId, dados)
	Accessibility.Configs[userId]=dados
end

return Accessibility
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX359971"><Properties><string name="Name">AutoCaption</string><ProtectedString name="Source"><![CDATA[--[[
  AutoCaption (ModuleScript)
  Local: ReplicatedStorage > Arkhe > Accessibility > AutoCaption
  ============================================================================
  F19 — LEGENDAS AUTO POR SOM (o que faltava pra 100%)
  - Detecta sons tocando no mundo e gera legendas automaticamente
  - Usa AudioMixer + MaterialSounds para classificar tipo de som
  - Integra com Subtitles e ScreenReader
  - Contrato: Observar, GerarLegenda, LegendarAudio
  ============================================================================
]]

local AutoCaption = {}
AutoCaption.__index = AutoCaption

function AutoCaption.novo()
    local self = setmetatable({}, AutoCaption)
    self.Ativo = true
    self.Fila = {}
    self.Historico = {}
    self.MaxHistorico = 50
    self.MapaSons = {
        ["explosao"] = "[Explosão]",
        ["passo"] = "[Passos]",
        ["tiro"] = "[Tiro]",
        ["musica"] = "[Música]",
        ["porta"] = "[Porta rangendo]",
        ["agua"] = "[Água corrente]",
        ["vento"] = "[Vento]",
        ["fogo"] = "[Fogo crepitando]",
        ["voz"] = "[Voz]",
    }
    return self
end

function AutoCaption:ClassificarSom(nomeSom)
    nomeSom = string.lower(nomeSom or "")
    for chave, legenda in pairs(self.MapaSons) do
        if string.find(nomeSom, chave) then
            return legenda, chave
        end
    end
    return "["..nomeSom.."]", "generico"
end

function AutoCaption:LegendarAudio(nomeSom, posicao, volume)
    if not self.Ativo then return nil end
    local texto, tipo = self:ClassificarSom(nomeSom)
    local legenda = {
        Id = "auto_"..tostring(os.time()).."_"..math.random(1000,9999),
        Texto = texto,
        Tipo = tipo,
        Origem = nomeSom,
        Posicao = posicao,
        Volume = volume or 1,
        Inicio = os.time(),
        Duracao = 3,
        Auto = true,
    }
    table.insert(self.Fila, legenda)
    table.insert(self.Historico, legenda)
    if #self.Historico > self.MaxHistorico then table.remove(self.Historico, 1) end
    if #self.Fila > 5 then table.remove(self.Fila, 1) end
    return legenda
end

function AutoCaption:Observar(soundInstance)
    -- soundInstance: Roblox Sound
    if not soundInstance or not soundInstance.IsA then return nil end
    local ok, isSound = pcall(function() return soundInstance:IsA("Sound") end)
    if not ok or not isSound then return nil end
    if soundInstance.IsPlaying then
        return self:LegendarAudio(soundInstance.Name, nil, soundInstance.Volume)
    end
    return nil
end

function AutoCaption:Tick(soundsFolder)
    if not self.Ativo or not soundsFolder then return end
    for _, obj in ipairs(soundsFolder:GetDescendants()) do
        if obj:IsA("Sound") and obj.IsPlaying and obj.PlaybackLoudness > 100 then
            -- evita spam: só legenda se não legendou recentemente
            local ja = false
            for _, f in ipairs(self.Fila) do
                if f.Origem == obj.Name and os.time() - f.Inicio < 2 then ja = true break end
            end
            if not ja then self:Observar(obj) end
        end
    end
end

function AutoCaption:ExportarParaSubtitles(subtitles)
    if not subtitles or not subtitles.Adicionar then return false end
    for _, leg in ipairs(self.Fila) do
        pcall(function() subtitles:Adicionar(leg.Texto, leg.Tipo, leg.Duracao) end)
    end
    return true
end

function AutoCaption:Listar()
    return self.Fila
end

function AutoCaption:Serializar()
    return {
        Ativo=self.Ativo,
        FilaAtiva=#self.Fila,
        Historico=#self.Historico,
        Tipos=self.MapaSons,
    }
end

return AutoCaption
]]></ProtectedString></Properties></Item>
