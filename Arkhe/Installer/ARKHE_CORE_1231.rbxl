     <Item class="ModuleScript" referent="RBX199866"><Properties><string name="Name">CameraSpline</string><ProtectedString name="Source"><![CDATA[--[[
	CameraSpline (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Cinematic > CameraSpline
	============================================================
	F17 — CINEMATICA: CAMERAS POR SPLINE (Ring1).
	Cutscenes com timeline: camera segue spline Catmull-Rom,
	com FOV, foco, e eventos (troca visual, tocar som).

	- Spline: lista de pontos { Pos=Vector3, FOV=70, Tempo=0..1 }
	- Avalia posicao por t (0..1) com Catmull-Rom
	- Timeline: Play, Pause, Stop, Tick(dt), OnEvento
	- Integra com VisualPresets e AudioMixer
	- Serializavel (JSON) — publicavel no marketplace

	Exemplo:
	  local spline = CameraSpline.novo("Intro")
	  spline:AdicionarPonto(Vector3.new(0,10,0), 70, 0)
	  spline:AdicionarPonto(Vector3.new(50,10,50), 60, 5)
	  spline:Play()
	============================================================
]]

local CameraSpline = {}
CameraSpline.__index = CameraSpline

function CameraSpline.novo(nome)
	local self = setmetatable({}, CameraSpline)
	self.Nome = nome or "Cutscene"
	self.Pontos = {} -- { Pos, FOV, Tempo, Evento }
	self.Duracao = 0
	self.Tempo = 0
	self.Tocando = false
	self.Loop = false
	self._onEvento = {}
	return self
end

function CameraSpline:AdicionarPonto(pos, fov, tempo, evento)
	fov = fov or 70
	tempo = tempo or (#self.Pontos * 2)
	table.insert(self.Pontos, { Pos=pos, FOV=fov, Tempo=tempo, Evento=evento })
	table.sort(self.Pontos, function(a,b) return a.Tempo < b.Tempo end)
	self.Duracao = self.Pontos[#self.Pontos] and self.Pontos[#self.Pontos].Tempo or 0
	return self
end

function CameraSpline:RemoverPonto(indice)
	if self.Pontos[indice] then table.remove(self.Pontos, indice) self.Duracao = self.Pontos[#self.Pontos] and self.Pontos[#self.Pontos].Tempo or 0 end
end

local function catmullRom(p0, p1, p2, p3, t)
	-- t 0..1 entre p1 e p2
	local t2 = t*t
	local t3 = t2*t
	return 0.5 * ((2 * p1) + (-p0 + p2) * t + (2*p0 -5*p1 +4*p2 -p3)*t2 + (-p0 +3*p1 -3*p2 +p3)*t3)
end

function CameraSpline:Avaliar(tempo)
	if #self.Pontos==0 then return nil end
	if #self.Pontos==1 then return self.Pontos[1].Pos, self.Pontos[1].FOV end
	tempo = math.clamp(tempo, 0, self.Duracao)
	-- acha segmento
	local idx=1
	for i=1,#self.Pontos-1 do if tempo >= self.Pontos[i].Tempo and tempo <= self.Pontos[i+1].Tempo then idx=i break end end
	if tempo >= self.Pontos[#self.Pontos].Tempo then idx = #self.Pontos-1 end
	local p1 = self.Pontos[idx]
	local p2 = self.Pontos[idx+1]
	if not p1 or not p2 then return self.Pontos[1].Pos, self.Pontos[1].FOV end
	local segDur = p2.Tempo - p1.Tempo
	local t = segDur >0 and (tempo - p1.Tempo)/segDur or 0
	-- catmull-rom com vizinhos
	local p0 = self.Pontos[idx-1] or p1
	local p3 = self.Pontos[idx+2] or p2
	local x = catmullRom(p0.Pos.X, p1.Pos.X, p2.Pos.X, p3.Pos.X, t)
	local y = catmullRom(p0.Pos.Y, p1.Pos.Y, p2.Pos.Y, p3.Pos.Y, t)
	local z = catmullRom(p0.Pos.Z, p1.Pos.Z, p2.Pos.Z, p3.Pos.Z, t)
	local fov = p1.FOV + (p2.FOV - p1.FOV)*t
	return Vector3.new(x,y,z), fov, p1, p2
end

function CameraSpline:Play() self.Tocando=true end
function CameraSpline:Pause() self.Tocando=false end
function CameraSpline:Stop() self.Tocando=false self.Tempo=0 end

function CameraSpline:Tick(dt, servicos)
	if not self.Tocando then return nil end
	self.Tempo = self.Tempo + dt
	if self.Tempo > self.Duracao then
		if self.Loop then self.Tempo = self.Tempo % self.Duracao else self.Tempo=self.Duracao self.Tocando=false end
	end
	local pos, fov, p1, p2 = self:Avaliar(self.Tempo)
	-- dispara eventos se cruzou tempo do ponto
	if p2 and p2.Evento and self.Tempo >= p2.Tempo - dt and self.Tempo < p2.Tempo + dt then
		for _, fn in ipairs(self._onEvento) do pcall(fn, p2.Evento, self) end
		if servicos then
			if p2.Evento.Tipo=="Visual" and servicos.Visual then servicos.Visual.Aplicar(p2.Evento.Nome, p2.Evento.Duracao or 2) end
			if p2.Evento.Tipo=="Som" and servicos.AudioMixer then servicos.AudioMixer.TocarEfeito3D(pos, p2.Evento.SoundId or 12222025, 0.8) end
		end
	end
	return pos, fov
end

function CameraSpline:OnEvento(fn) table.insert(self._onEvento, fn) end

function CameraSpline:Serializar()
	local pontosSer={}
	for _, p in ipairs(self.Pontos) do table.insert(pontosSer, { Pos={X=p.Pos.X,Y=p.Pos.Y,Z=p.Pos.Z}, FOV=p.FOV, Tempo=p.Tempo, Evento=p.Evento }) end
	return { Nome=self.Nome, Pontos=pontosSer, Duracao=self.Duracao, Loop=self.Loop }
end

function CameraSpline.Deserializar(dados)
	local spline = CameraSpline.novo(dados.Nome)
	spline.Duracao = dados.Duracao or 0
	spline.Loop = dados.Loop or false
	for _, p in ipairs(dados.Pontos or {}) do spline:AdicionarPonto(Vector3.new(p.Pos.X,p.Pos.Y,p.Pos.Z), p.FOV, p.Tempo, p.Evento) end
	return spline
end

return CameraSpline
]]></ProtectedString></Properties></Item>
