     <Item class="ModuleScript" referent="RBX376211"><Properties><string name="Name">ReverbZone</string><ProtectedString name="Source"><![CDATA[[[
	ReverbZone (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Audio > ReverbZone
	============================================================
	F15 — ZONAS DE REVERB + AMBIENTE SONORO
	- Zona: { Nome, Centro, Raio, Preset Reverb, Intensidade }
	- Presets: Caverna, Floresta, Sala, Catedral, Subaquático, Espaço
	- Quando ouvinte entra na zona, aplica reverb no AudioMixer
	- Blending: se sobrepõe zonas, interpola
	- Integra com Terrain Caves + World
	============================================================
]]

local ReverbZone = {}
ReverbZone.__index = ReverbZone

ReverbZone.Presets = {
	Caverna = { Desc="Eco longo, grave, úmido", Decay=4.5, Diffusion=0.8, LowFreq=0.6, Wet=0.6 },
	Floresta = { Desc="Aberto com leve reflexão árvores", Decay=1.2, Diffusion=0.4, LowFreq=0.9, Wet=0.2 },
	Sala = { Desc="Sala pequena, seco", Decay=0.6, Diffusion=0.5, LowFreq=1.0, Wet=0.15 },
	Catedral = { Desc="Grande, eco majestoso", Decay=6.0, Diffusion=0.9, LowFreq=0.7, Wet=0.7 },
	Subaquatico = { Desc="Abafado, grave filtrado", Decay=2.0, Diffusion=0.3, LowFreq=0.3, Wet=0.5 },
	Espaco = { Desc="Quase sem reverb, vazio", Decay=0.1, Diffusion=0.1, LowFreq=1.0, Wet=0.05 },
	Deserto = { Desc="Muito seco, sem reflexão", Decay=0.3, Diffusion=0.2, LowFreq=1.0, Wet=0.1 },
}

function ReverbZone.novo(nome, centro, raio, preset)
	local self = setmetatable({}, ReverbZone)
	self.Nome = nome or "Reverb_"..math.random(1000,9999)
	self.Centro = centro or Vector3.new(0,0,0)
	self.Raio = raio or 40
	self.Preset = preset or "Sala"
	self.Intensidade = 1.0
	self.Ativo = true
	return self
end

function ReverbZone:DefinirPreset(preset)
	if ReverbZone.Presets[preset] then
		self.Preset = preset
		return true
	end
	return false
end

function ReverbZone:Contem(pos)
	return (pos - self.Centro).Magnitude <= self.Raio
end

function ReverbZone:CalcularInfluencia(pos)
	local dist = (pos - self.Centro).Magnitude
	if dist >= self.Raio then return 0 end
	return (1 - dist/self.Raio) * self.Intensidade
end

function ReverbZone:ObterParametros()
	local preset = ReverbZone.Presets[self.Preset]
	if not preset then return nil end
	return {
		Decay=preset.Decay * self.Intensidade,
		Diffusion=preset.Diffusion,
		LowFreq=preset.LowFreq,
		Wet=preset.Wet * self.Intensidade,
		Preset=self.Preset,
	}
end

function ReverbZone:Serializar()
	return {
		Nome=self.Nome,
		Centro={ X=self.Centro.X, Y=self.Centro.Y, Z=self.Centro.Z },
		Raio=self.Raio,
		Preset=self.Preset,
		Intensidade=self.Intensidade,
		Ativo=self.Ativo,
	}
end

-- Manager de zonas
local ReverbManager = {}
ReverbManager.__index = ReverbManager

function ReverbManager.novo()
	local self = setmetatable({}, ReverbManager)
	self.Zonas = {}
	self.MaxZonas = 16
	return self
end

function ReverbManager:Adicionar(zona)
	if #self.Zonas >= self.MaxZonas then
		table.remove(self.Zonas, 1)
	end
	table.insert(self.Zonas, zona)
	return zona
end

function ReverbManager:Remover(nome)
	for i, z in ipairs(self.Zonas) do
		if z.Nome == nome then
			table.remove(self.Zonas, i)
			return true
		end
	end
	return false
end

function ReverbManager:CalcularParaPos(pos)
	-- blending de zonas sobrepostas
	local totalPeso=0
	local somaDecay=0; local somaWet=0
	local presetDominante=nil; local maxPeso=0
	for _, zona in ipairs(self.Zonas) do
		if zona.Ativo then
			local peso = zona:CalcularInfluencia(pos)
			if peso > 0 then
				local params = zona:ObterParametros()
				if params then
					somaDecay = somaDecay + params.Decay * peso
					somaWet = somaWet + params.Wet * peso
					totalPeso = totalPeso + peso
					if peso > maxPeso then
						maxPeso = peso
						presetDominante = zona.Preset
					end
				end
			end
		end
	end
	if totalPeso == 0 then return nil end
	return {
		Decay=somaDecay/totalPeso,
		Wet=somaWet/totalPeso,
		Preset=presetDominante,
		Peso=totalPeso,
	}
end

function ReverbManager:Listar()
	local lista={}
	for _, z in ipairs(self.Zonas) do
		table.insert(lista, z:Serializar())
	end
	return lista
end

function ReverbManager:Serializar()
	return {
		Total=#self.Zonas,
		Max=self.MaxZonas,
		Zonas=self:Listar(),
		Presets=(function()
			local l={}
			for k,v in pairs(ReverbZone.Presets) do table.insert(l, { Nome=k, Desc=v.Desc }) end
			return l
		end)(),
	}
end

ReverbZone.Manager = ReverbManager
ReverbZone.CriarManager = function() return ReverbManager.novo() end
ReverbZone.ListarPresets = function()
	local lista={}
	for nome, p in pairs(ReverbZone.Presets) do
		table.insert(lista, { Nome=nome, Desc=p.Desc })
	end
	return lista
end

return ReverbZone
]]></ProtectedString></Properties></Item>
