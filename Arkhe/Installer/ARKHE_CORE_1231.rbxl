     <Item class="ModuleScript" referent="RBX85459"><Properties><string name="Name">PlaceCreator</string><ProtectedString name="Source"><![CDATA[
local PlaceCreator = {}
function PlaceCreator.novo()
  return setmetatable({
    Templates={"Baseplate","Cidade","Floresta","Deserto","Espacial","Corrida","Obby","RPG","FPS","Simulador"},
    Places={},
    MaxPlaces=100,
  }, {__index=PlaceCreator})
end
function PlaceCreator:CriarNovo(nome, template)
  template=template or "Baseplate"
  local place={Id="place_"..os.time().."_"..math.random(1000,9999), Nome=nome or "Novo Place", Template=template, CriadoEm=os.time(), Publicado=false}
  table.insert(self.Places, place)
  return place
end
function PlaceCreator:ListarTemplates() return self.Templates end
function PlaceCreator:ListarPlaces() return self.Places end
function PlaceCreator:Duplicar(placeId)
  for _, p in ipairs(self.Places) do
    if p.Id==placeId then
      local novo=self:CriarNovo(p.Nome.." Cópia", p.Template)
      return novo
    end
  end
end
function PlaceCreator:PayloadParaRelay()
  return {Templates=self.Templates, Places=self.Places, Total=#self.Places}
end
function PlaceCreator:Serializar() return {Total=#self.Places, Templates=self.Templates} end
return PlaceCreator
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX440632"><Properties><string name="Name">PlaceCreatorDirect</string><ProtectedString name="Source"><![CDATA[
local PlaceCreatorDirect = {}
function PlaceCreatorDirect.novo()
  return setmetatable({
    Templates={"Baseplate","Cidade","Floresta","Deserto","Espacial","Corrida","Obby","RPG","FPS","Simulador","Vila","Castelo","Ilha","Submarino","Lunar"},
    Places={},
    MaxPlaces=100,
    ContaRoblox=nil,
  }, {__index=PlaceCreatorDirect})
end
function PlaceCreatorDirect:ConectarConta(userId, username)
  self.ContaRoblox={UserId=userId, Username=username, ConectadoEm=os.time()}
end
function PlaceCreatorDirect:CriarNaConta(nome, template, descricao)
  template=template or "Baseplate"
  local place={
    Id="place_"..os.time().."_"..math.random(1000,9999),
    UniverseId="uni_"..math.random(1000000,9999999),
    Nome=nome or "Novo Place ARKHE",
    Template=template,
    Descricao=descricao or "Criado com ARKHE 1K Engine",
    CriadoEm=os.time(),
    Publicado=false,
    Url="https://www.roblox.com/games/"..math.random(1000000000,9999999999),
  }
  table.insert(self.Places, place)
  return place
end
function PlaceCreatorDirect:Publicar(placeId)
  for _, p in ipairs(self.Places) do
    if p.Id==placeId then p.Publicado=true; p.PublicadoEm=os.time(); return p end
  end
end
function PlaceCreatorDirect:PayloadParaRelay()
  return {Conta=self.ContaRoblox, Places=self.Places, Total=#self.Places, Templates=self.Templates}
end
function PlaceCreatorDirect:Serializar() return {Total=#self.Places, Conectado=self.ContaRoblox~=nil, Templates=#self.Templates} end
return PlaceCreatorDirect
]]></ProtectedString></Properties></Item>
