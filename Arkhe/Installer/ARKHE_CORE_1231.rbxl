     <Item class="ModuleScript" referent="RBX297275"><Properties><string name="Name">System1055_Audio</string><ProtectedString name="Source"><![CDATA[
local System1055_Audio = {}
function System1055_Audio.novo()
  return setmetatable({
    Id=1055,
    Familia="Audio",
    Nome="System1055_Audio",
    TopbarBotao=true,
