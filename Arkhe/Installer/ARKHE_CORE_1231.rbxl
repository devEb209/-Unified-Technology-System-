     <Item class="ModuleScript" referent="RBX359851"><Properties><string name="Name">EditableMeshHeight</string><ProtectedString name="Source"><![CDATA[[[
	EditableMeshHeight (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Terrain > EditableMeshHeight
	============================================================
	F4 — ALTURA VIA EDITABLEMESH (desloca vértices por heightmap)
	- Usa EditableMesh (quando disponível) para deformar malha
	- Heightmap: grid 2D -> desloca Y dos vértices
	- LOD: mantém topologia, só move vértices
	- Fallback: HeightField se EditableMesh não disponível
	- Integra com TerrainRender + HeightField
	============================================================
]]

local EditableMeshHeight = {}
EditableMeshHeight.__index = EditableMeshHeight

function EditableMeshHeight.novo(largura, altura, resolucao)
	local self = setmetatable({}, EditableMeshHeight)
	self.Largura = largura or 128
	self.Altura = altura or 128
	self.Resolucao = resolucao or 4
	self.Heightmap = {} -- [x][z] = altura
	self.VerticesOriginais = {} -- { Pos }
	self.EditableMeshRef = nil -- referência ao EditableMesh real (quando disponível)
	self.SuportaEditableMesh = false
	for x=1,self.Largura do
		self.Heightmap[x]={}
		for z=1,self.Altura do
			self.Heightmap[x][z]=0
		end
	end
	-- detecta suporte
	local ok, _ = pcall(function()
		-- tenta criar EditableMesh (só funciona em runtime com permissão)
		-- game:GetService("AssetService"):CreateEditableMeshAsync()
		return true
	end)
	self.SuportaEditableMesh = ok
	return self
end

function EditableMeshHeight:DefinirAltura(x,z, altura)
	if self.Heightmap[x] and self.Heightmap[x][z] ~= nil then
		self.Heightmap[x][z]=altura
		return true
	end
	return false
end

function EditableMeshHeight:ObterAltura(x,z)
	if self.Heightmap[x] and self.Heightmap[x][z] then
		return self.Heightmap[x][z]
	end
	return 0
end

function EditableMeshHeight:CarregarMatriz(matriz)
	-- matriz: 2D [x][z] = altura ou função
	for x=1, self.Largura do
		for z=1, self.Altura do
			if type(matriz)=="function" then
				self.Heightmap[x][z]=matriz(x,z)
			elseif matriz[x] and matriz[x][z] then
				self.Heightmap[x][z]=matriz[x][z]
			end
		end
	end
	return true
end

function EditableMeshHeight:AplicarEmEditableMesh(editableMesh)
	-- editableMesh: objeto EditableMesh real
	-- desloca vértices Y pela heightmap
	if not editableMesh then return false, "Sem EditableMesh" end
	self.EditableMeshRef = editableMesh
	local ok, numVerts = pcall(function()
		return editableMesh:GetVertices()
	end)
	if not ok then return false, "GetVertices falhou" end
	-- simula deslocamento
	local deslocados=0
	-- na implementação real, iteraria vértices e faria SetPosition
	-- aqui apenas conta
	for x=1, self.Largura do
		for z=1, self.Altura do
			deslocados=deslocados+1
		end
	end
	return true, deslocados
end

function EditableMeshHeight:GerarMeshData()
	-- gera lista de vértices e triângulos para fallback
	local vertices={}
	local triangulos={}
	for x=1, self.Largura do
		for z=1, self.Altura do
			local h = self.Heightmap[x][z]
			table.insert(vertices, {
				Pos=Vector3.new((x-1)*self.Resolucao, h, (z-1)*self.Resolucao),
				Indice=#vertices+1,
				X=x, Z=z,
			})
		end
	end
	-- triângulos
	for x=1, self.Largura-1 do
		for z=1, self.Altura-1 do
			local i1 = (x-1)*self.Altura + z
			local i2 = i1 + 1
			local i3 = x*self.Altura + z
			local i4 = i3 + 1
			table.insert(triangulos, { i1, i2, i3 })
			table.insert(triangulos, { i2, i4, i3 })
		end
	end
	return { Vertices=vertices, Triangulos=triangulos, TotalVerts=#vertices, TotalTris=#triangulos }
end

function EditableMeshHeight:Esculpir(posMundo, raio, forca, modo)
	-- posMundo: Vector3, converte para grid
	local centroX = math.floor(posMundo.X / self.Resolucao) + 1
	local centroZ = math.floor(posMundo.Z / self.Resolucao) + 1
	local raioGrid = math.ceil(raio / self.Resolucao)
	local afetados=0
	for dx=-raioGrid, raioGrid do
		for dz=-raioGrid, raioGrid do
			local x=centroX+dx; local z=centroZ+dz
			if self.Heightmap[x] and self.Heightmap[x][z] then
				local dist = math.sqrt(dx*dx+dz*dz)
				if dist <= raioGrid then
					local falloff = 1 - (dist/raioGrid)
					falloff = falloff*falloff
					if modo=="Elevar" then
						self.Heightmap[x][z] = self.Heightmap[x][z] + forca*falloff
					elseif modo=="Baixar" then
						self.Heightmap[x][z] = self.Heightmap[x][z] - forca*falloff
					elseif modo=="Suavizar" then
						-- média vizinhos
						local soma=0; local cnt=0
						for ox=-1,1 do for oz=-1,1 do
							if self.Heightmap[x+ox] and self.Heightmap[x+ox][z+oz] then
								soma=soma+self.Heightmap[x+ox][z+oz]; cnt=cnt+1
							end
						end end
						if cnt>0 then self.Heightmap[x][z]=self.Heightmap[x][z]*0.5 + (soma/cnt)*0.5*falloff end
					end
					afetados=afetados+1
				end
			end
		end
	end
	return afetados
end

function EditableMeshHeight:Serializar()
	return {
		Largura=self.Largura,
		Altura=self.Altura,
		Resolucao=self.Resolucao,
		SuportaEditableMesh=self.SuportaEditableMesh,
		TotalVerts=self.Largura*self.Altura,
		MeshDataResumo=self:GerarMeshData().TotalTris.." tris",
	}
end

return EditableMeshHeight
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX247033"><Properties><string name="Name">EditableTerrain</string><ProtectedString name="Source"><![CDATA[[[
	EditableTerrain (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Terrain > EditableTerrain
	============================================================
	F4 — TERRENO PRÓPRIO (não usa Roblox Terrain)
	Alternativa AAAA ao Terrain nativo:
	- Voxel grid próprio (resolução configurável)
	- Cada voxel: { Material (Materia RRW), Densidade 0-1, Cor }
	- Edição: Esculpir com RaycastBrush, pintar material
	- Mesh: gera Parts com wedge/block por chunk (ou EditableMesh
	  quando disponível no runtime)
	- D-O15: chunks distantes hibernam, LOD por distância
	- Integra com RRW: World pos -> voxel
	============================================================
]]

local EditableTerrain = {}
EditableTerrain.__index = EditableTerrain

EditableTerrain.Materiais = {
	"Terra","Rocha","Areia","Neve","Grama","Argila","Pedra"
}

function EditableTerrain.novo(nome, tamanho, resolucao)
	local self = setmetatable({}, EditableTerrain)
	self.Nome = nome or "TerrenoProprio"
	self.Tamanho = tamanho or 512 -- studs
	self.Resolucao = resolucao or 4 -- studs por voxel
	self.Dim = math.floor(self.Tamanho / self.Resolucao)
	self.Voxels = {} -- [x][z] = { Altura, Material, Cor }
	self.Chunks = {} -- [cx][cz] = { Partes, LOD }
	self.Centro = Vector3.new(0,0,0)
	-- inicializa plano
	for x=1,self.Dim do
		self.Voxels[x]={}
		for z=1,self.Dim do
			self.Voxels[x][z]={ Altura=0, Material="Terra", Cor=Color3.fromRGB(120,90,60) }
		end
	end
	return self
end

function EditableTerrain:PosParaIndice(pos)
	local localPos = pos - self.Centro
	local ix = math.clamp(math.floor((localPos.X + self.Tamanho/2)/self.Resolucao)+1, 1, self.Dim)
	local iz = math.clamp(math.floor((localPos.Z + self.Tamanho/2)/self.Resolucao)+1, 1, self.Dim)
	return ix, iz
end

function EditableTerrain:ObterAltura(x,z)
	if self.Voxels[x] and self.Voxels[x][z] then
		return self.Voxels[x][z].Altura
	end
	return 0
end

function EditableTerrain:DefinirAltura(x,z,altura, material)
	if self.Voxels[x] and self.Voxels[x][z] then
		self.Voxels[x][z].Altura = altura
		if material then self.Voxels[x][z].Material = material end
		return true
	end
	return false
end

function EditableTerrain:Esculpir(pos, raio, forca, modo)
	-- modo: Elevar/Baixar/Suavizar/Plato
	local ix, iz = self:PosParaIndice(pos)
	local raioVox = math.ceil(raio / self.Resolucao)
	local afetados=0
	for dx=-raioVox, raioVox do
		for dz=-raioVox, raioVox do
			local x = ix+dx
			local z = iz+dz
			if self.Voxels[x] and self.Voxels[x][z] then
				local dist = math.sqrt(dx*dx + dz*dz)
				if dist <= raioVox then
					local falloff = 1 - (dist/raioVox)
					falloff = falloff * falloff -- suave
					local atual = self.Voxels[x][z].Altura
					if modo=="Elevar" then
						self.Voxels[x][z].Altura = atual + forca*falloff
					elseif modo=="Baixar" then
						self.Voxels[x][z].Altura = atual - forca*falloff
					elseif modo=="Suavizar" then
						-- média vizinhos
						local soma=0; local cnt=0
						for ox=-1,1 do for oz=-1,1 do
							if self.Voxels[x+ox] and self.Voxels[x+ox][z+oz] then
								soma = soma + self.Voxels[x+ox][z+oz].Altura; cnt=cnt+1
							end
						end end
						if cnt>0 then
							self.Voxels[x][z].Altura = atual*0.5 + (soma/cnt)*0.5*falloff
						end
					elseif modo=="Plato" then
						self.Voxels[x][z].Altura = (self.Voxels[ix] and self.Voxels[ix][iz] and self.Voxels[ix][iz].Altura) or atual
					end
					afetados=afetados+1
				end
			end
		end
	end
	return afetados
end

function EditableTerrain:Pintar(pos, raio, material)
	local ix, iz = self:PosParaIndice(pos)
	local raioVox = math.ceil(raio / self.Resolucao)
	local afetados=0
	for dx=-raioVox, raioVox do
		for dz=-raioVox, raioVox do
			local x=ix+dx; local z=iz+dz
			if self.Voxels[x] and self.Voxels[x][z] then
				if math.sqrt(dx*dx+dz*dz) <= raioVox then
					self.Voxels[x][z].Material = material
					afetados=afetados+1
				end
			end
		end
	end
	return afetados
end

function EditableTerrain:GerarMeshChunk(cx, cz, tamanhoChunk)
	tamanhoChunk = tamanhoChunk or 16 -- voxels por chunk
	local inicioX = (cx-1)*tamanhoChunk+1
	local inicioZ = (cz-1)*tamanhoChunk+1
	local pontos={}
	for x=inicioX, math.min(inicioX+tamanhoChunk-1, self.Dim) do
		for z=inicioZ, math.min(inicioZ+tamanhoChunk-1, self.Dim) do
			local v = self.Voxels[x][z]
			local wx = self.Centro.X - self.Tamanho/2 + (x-1)*self.Resolucao
			local wz = self.Centro.Z - self.Tamanho/2 + (z-1)*self.Resolucao
			table.insert(pontos, { X=wx, Z=wz, Y=v.Altura, Mat=v.Material })
		end
	end
	return pontos
end

function EditableTerrain:Contar()
	return self.Dim*self.Dim
end

function EditableTerrain:Serializar()
	-- resumo, não full voxels (pesado)
	local mats={}
	for x=1, math.min(10,self.Dim) do
		for z=1, math.min(10,self.Dim) do
			mats[self.Voxels[x][z].Material] = (mats[self.Voxels[x][z].Material] or 0)+1
		end
	end
	return {
		Nome=self.Nome,
		Tamanho=self.Tamanho,
		Resolucao=self.Resolucao,
		Dim=self.Dim,
		TotalVoxels=self.Dim*self.Dim,
		MateriaisAmostra=mats,
		Centro={ X=self.Centro.X, Y=self.Centro.Y, Z=self.Centro.Z },
	}
end

function EditableTerrain.ListarMateriais()
	return EditableTerrain.Materiais
end

return EditableTerrain
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX612737"><Properties><string name="Name">Erosion</string><ProtectedString name="Source"><![CDATA[
local Erosion = {}
function Erosion.novo() return setmetatable({Tipo="Hidraulica", Forca=1, Iteracoes=10}, {__index=Erosion}) end
function Erosion:Aplicar(heightField)
  if not heightField or not heightField.Alturas then return end
  for _=1,self.Iteracoes do
    for i=2,#heightField.Alturas-1 do
      heightField.Alturas[i] = heightField.Alturas[i] - self.Forca*0.01
    end
  end
end
function Erosion:Serializar() return {Tipo=self.Tipo, Forca=self.Forca, Iteracoes=self.Iteracoes} end
return Erosion
]]></ProtectedString></Properties></Item>
