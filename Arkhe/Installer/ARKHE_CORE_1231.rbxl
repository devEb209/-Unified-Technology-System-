     <Item class="ModuleScript" referent="RBX853228"><Properties><string name="Name">NPCBrain</string><ProtectedString name="Source"><![CDATA[--[[
	NPCBrain (ModuleScript)
	Local: ReplicatedStorage > Arkhe > NPC > NPCBrain
	============================================================
	F7 — CEREBRO DOS NPCs (utility AI, herdeiro do Aetherion):
	cada NPC escolhe o que fazer pela UTILIDADE de cada acao
	dadas suas NECESSIDADES (energia, social, medo) + hora do
	dia + o que existe no MUNDO RRW ao redor.

	- Estados: Vagar, Descansar, Socializar, Conversar (jogador),
	  Fugir (de fogo RRW!), Patrulhar (guardas)
	- Emocoes visiveis no billboard (😊 😴 😨 🗨)
	- Falas por personalidade quando um jogador chega perto
	- LOD DE CEREBRO (D-O15 mental): perto pensa a 2 Hz, medio
	  a 0.5 Hz, longe hiberna — 40 NPCs por ~zero de CPU
	- Personalidades: Aldeao, Guarda, Mercador, Fera + Registrar()
	============================================================
]]

local Lighting = game:GetService("Lighting")

local NPCBrain = {}
NPCBrain.Registro = {} -- [modelo] = registro
NPCBrain.MaxNPCs = 40

-- ============ PERSONALIDADES ============
NPCBrain.Personalidades = {
	Aldeao = {
		Rig = "R6", Altura = 1, Largura = 1, Velocidade = 9, RaioCasa = 45,
		Falas = { "Bom dia, viajante!", "A colheita vai bem.", "Cuidado com a floresta a noite...",
			"Dizem que a chuva apaga ate espirito de fogo." },
		Coragem = 0.2, Social = 0.7,
	},
	Guarda = {
		Rig = "R6", Altura = 1.15, Largura = 1.1, Velocidade = 12, RaioCasa = 70,
		Falas = { "Circulando.", "Nada passa por mim.", "Vi fumaca no horizonte, fique alerta." },
		Coragem = 0.9, Social = 0.25, Patrulha = true,
	},
	Mercador = {
		Rig = "R6", Altura = 0.95, Largura = 1.2, Velocidade = 8, RaioCasa = 30,
		Falas = { "Tenho oferta pra voce!", "Compro, vendo e troco!", "Isso ai vale ouro, amigo." },
		Coragem = 0.3, Social = 0.95,
	},
	Fera = {
		Rig = "Quadrupede", Altura = 1.1, Velocidade = 16, RaioCasa = 90,
		Falas = { "*rosna*", "*fareja o ar*" },
		Coragem = 0.6, Social = 0.05,
	},
}

function NPCBrain.RegistrarPersonalidade(nome, def)
	if type(nome) ~= "string" or type(def) ~= "table" then return false end
	def.Falas = def.Falas or { "..." }
	NPCBrain.Personalidades[nome] = def
	return true
end

-- ============ CICLO DE VIDA ============
function NPCBrain.Adotar(modelo, personalidadeNome, label)
	local p = NPCBrain.Personalidades[personalidadeNome]
	if not p then return nil end
	local hrp = modelo:FindFirstChild("HumanoidRootPart")
	local registro = {
		Modelo = modelo, Hum = modelo:FindFirstChildOfClass("Humanoid"),
		HRP = hrp, Label = label,
		Personalidade = personalidadeNome, P = p,
		Casa = hrp and hrp.Position or Vector3.new(),
		Energia = 60 + math.random() * 40,
		Social = 40 + math.random() * 40,
		Medo = 0,
		Estado = "Vagar", Fase = 0, UltimoPenso = 0,
		UltimaFala = 0, Fala = nil,
	}
	if registro.Hum then registro.Hum.WalkSpeed = p.Velocidade end
	NPCBrain.Registro[modelo] = registro
	modelo.Destroying:Connect(function()
		NPCBrain.Registro[modelo] = nil
	end)
	return registro
end

function NPCBrain.Contar()
	local n = 0
	for _ in pairs(NPCBrain.Registro) do n = n + 1 end
	return n
end

function NPCBrain.LimparTodos()
	for modelo in pairs(NPCBrain.Registro) do
		modelo:Destroy()
	end
	NPCBrain.Registro = {}
end

-- ============ UTILIDADE (o coracao) ============
local function eNoite()
	local t = Lighting.ClockTime
	return t < 6 or t > 18
end

local function decidir(r, distJogador, fogoPerto)
	-- pontua cada acao; a maior vence (utility AI real)
	local u = {}
	u.Fugir = fogoPerto and (1.4 - r.P.Coragem) or 0
	u.Conversar = (distJogador < 9 and r.P.Social > 0.1) and (0.6 + r.P.Social * 0.5) or 0
	u.Descansar = (100 - r.Energia) / 100 * (eNoite() and 1.2 or 0.5)
	u.Socializar = (100 - r.Social) / 100 * r.P.Social * 0.8
	u.Patrulhar = r.P.Patrulha and 0.55 or 0
	u.Vagar = 0.35

	local melhor, nota = "Vagar", 0
	for estado, valor in pairs(u) do
		if valor > nota then melhor, nota = estado, valor end
	end
	return melhor
end

local EMOJI = { Vagar = "", Descansar = "😴", Conversar = "🗨", Fugir = "😨",
	Socializar = "😊", Patrulhar = "🛡" }

-- ============ TICK (chame a ~2 Hz com posicoes dos jogadores) ============
-- mundo: World RRW (pra farejar fogo); agora: os.clock()
function NPCBrain.Tick(dt, jogadores, mundo, RigFactory)
	local agora = os.clock()
	for modelo, r in pairs(NPCBrain.Registro) do
		if not r.HRP or not r.HRP.Parent or not r.Hum or r.Hum.Health <= 0 then
			NPCBrain.Registro[modelo] = nil
			if r.Hum and r.Hum.Health <= 0 then modelo:Destroy() end
		else
			NPCBrain.PensarUm(modelo, r, dt, agora, jogadores, mundo, RigFactory)
		end
	end
end

function NPCBrain.PensarUm(modelo, r, dt, agora, jogadores, mundo, RigFactory)
	local pos = r.HRP.Position

	-- distancia ao jogador mais proximo -> LOD DE CEREBRO
	local distJ = math.huge
	local jogadorPerto = nil
	for _, jp in ipairs(jogadores) do
		local d = (jp.Pos - pos).Magnitude
		if d < distJ then distJ, jogadorPerto = d, jp end
	end
	local intervalo = distJ < 60 and 0.5 or (distJ < 200 and 2 or 8)
	if agora - r.UltimoPenso < intervalo then
		-- so anima quem esta perto (barato)
		if distJ < 90 then
			r.Fase = r.Fase + dt * 8
			RigFactory.AnimarPasso(modelo, r.Fase,
				r.Hum.MoveDirection.Magnitude > 0.05)
		end
		return
	end
	r.UltimoPenso = agora

		-- necessidades andam
		r.Energia = math.clamp(r.Energia - intervalo * 0.4
			+ (r.Estado == "Descansar" and intervalo * 3 or 0), 0, 100)
		r.Social = math.clamp(r.Social - intervalo * 0.3
			+ ((r.Estado == "Socializar" or r.Estado == "Conversar") and intervalo * 4 or 0), 0, 100)

		-- fareja FOGO no mundo RRW (dados, nao raycast!)
		local fogoPerto = false
		if mundo then
			for _, e in ipairs(mundo:NaRegiao(pos, 30)) do
				if e.Estado.EmChamas then fogoPerto = true break end
			end
		end

		r.Estado = decidir(r, distJ, fogoPerto)

		-- executa
		if r.Estado == "Fugir" then
			r.Hum.WalkSpeed = r.P.Velocidade * 1.8
			r.Hum:MoveTo(pos + (pos - (jogadorPerto and jogadorPerto.Pos or r.Casa)).Unit * 30
				+ Vector3.new(math.random(-8, 8), 0, math.random(-8, 8)))
		elseif r.Estado == "Conversar" and jogadorPerto then
			r.Hum.WalkSpeed = r.P.Velocidade
			r.Hum:MoveTo(pos) -- para e encara
			r.HRP.CFrame = CFrame.lookAt(pos,
				Vector3.new(jogadorPerto.Pos.X, pos.Y, jogadorPerto.Pos.Z))
			if agora - r.UltimaFala > 6 then
				r.UltimaFala = agora
				r.Fala = r.P.Falas[math.random(1, #r.P.Falas)]
			end
		elseif r.Estado == "Descansar" then
			r.Hum:MoveTo(r.Casa)
		elseif r.Estado == "Patrulhar" then
			r.Hum.WalkSpeed = r.P.Velocidade
			local ang = agora * 0.15 % (math.pi * 2)
			r.Hum:MoveTo(r.Casa + Vector3.new(math.cos(ang), 0, math.sin(ang)) * r.P.RaioCasa * 0.7)
		elseif r.Estado == "Socializar" then
			-- procura o NPC mais proximo e vai ate ele
			local alvo
			local menor = math.huge
			for m2, r2 in pairs(NPCBrain.Registro) do
				if m2 ~= modelo and r2.HRP then
					local d = (r2.HRP.Position - pos).Magnitude
					if d < menor then menor, alvo = d, r2 end
				end
			end
			if alvo and menor > 6 then
				r.Hum:MoveTo(alvo.HRP.Position)
			end
		else -- Vagar
			r.Hum.WalkSpeed = r.P.Velocidade * 0.8
			if r.Hum.MoveDirection.Magnitude < 0.05 then
				local ang = math.random() * math.pi * 2
				local raio = math.random() * r.P.RaioCasa
				r.Hum:MoveTo(r.Casa + Vector3.new(math.cos(ang) * raio, 0, math.sin(ang) * raio))
			end
		end

	-- billboard: nome + emocao + fala
	if r.Label then
		local emoji = EMOJI[r.Estado] or ""
		local fala = (r.Fala and agora - r.UltimaFala < 5) and ("\n" .. r.Fala) or ""
		r.Label.Text = modelo.Name .. " " .. emoji .. fala
	end
end

return NPCBrain
]]></ProtectedString></Properties></Item>
