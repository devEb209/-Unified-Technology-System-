     <Item class="ModuleScript" referent="RBX758856"><Properties><string name="Name">BlenderPlus</string><ProtectedString name="Source"><![CDATA[--[[
  BlenderPlus (ModuleScript)
  Local: ReplicatedStorage > Arkhe > Modeler > BlenderPlus
  ============================================================================
  Modelador 3D melhor que Blender
  - Blender tem tudo, nós temos + EditableMeshDirect nativo Roblox + D-O15 + RRW + AI
  - Ferramentas: Sculpt, Retopo, UV, Bake, Rig, Anim, tudo em 1
  ============================================================================
]]

local BlenderPlus = {}
BlenderPlus.__index = BlenderPlus

function BlenderPlus.novo()
  return setmetatable({
    Modos={
      Object={Desc="Modo objeto com transform universal", MelhorQue="Blender Object"},
      Edit={Desc="Edit mesh com 50+ operações", MelhorQue="Blender Edit"},
      Sculpt={Desc="Sculpt com 20 pincéis + RRW colisão", MelhorQue="Blender Sculpt"},
      VertexPaint={Desc="Pintura vértice com gradiente", MelhorQue="Blender VertexPaint"},
      WeightPaint={Desc="Peso rig com visualização", MelhorQue="Blender WeightPaint"},
      TexturePaint={Desc="Texture paint 4 layers + carimbos", MelhorQue="Blender TexturePaint"},
      UVEdit={Desc="UV unwrap + pack + texel density", MelhorQue="Blender UV"},
      Retopo={Desc="Retopologia automática", MelhorQue="Blender Retopo"},
      Rig={Desc="Rig custom 100 bones + auto skin", MelhorQue="Blender Rig"},
      Anim={Desc="Animação com CascadeurPlus", MelhorQue="Blender Anim"},
    },
    Ferramentas={
      "Extrude","Bevel","LoopCut","Knife","Boolean","Array","Mirror","Subdivision","Decimate","Remesh",
      "Smooth","Inflate","Grab","SnakeHook","Clay","Crease","Flatten","Fill","Scrape","Pinch",
      "Bend","Twist","Taper","Lattice","CurveDeform","Displace","Decimate","Weld","Merge","Split",
    },
    Ativo="Object",
  }, {__index=BlenderPlus})
end

function BlenderPlus:TrocarModo(modo) self.Ativo=modo end
function BlenderPlus:ListarModos() return self.Modos end
function BlenderPlus:ListarFerramentas() return self.Ferramentas end
function BlenderPlus:Serializar() return {ModoAtivo=self.Ativo, TotalModos=self:ContarModos(), TotalFerramentas=#self.Ferramentas, MelhorQueBlender=true} end
function BlenderPlus:ContarModos() local n=0 for _ in pairs(self.Modos) do n=n+1 end return n end

return BlenderPlus
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX66093"><Properties><string name="Name">Boolean</string><ProtectedString name="Source"><![CDATA[
local Boolean = {}
function Boolean.novo() return setmetatable({Operacoes={}}, {__index=Boolean}) end
function Boolean:Uniao(a,b) table.insert(self.Operacoes,{Tipo="Uniao",A=a,B=b}) return {Tipo="Uniao",A=a,B=b} end
function Boolean:Subtracao(a,b) table.insert(self.Operacoes,{Tipo="Sub",A=a,B=b}) return {Tipo="Sub",A=a,B=b} end
function Boolean:Intersecao(a,b) table.insert(self.Operacoes,{Tipo="Inter",A=a,B=b}) return {Tipo="Inter",A=a,B=b} end
function Boolean:Serializar() return {Total=#self.Operacoes} end
return Boolean
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX938237"><Properties><string name="Name">CSG</string><ProtectedString name="Source"><![CDATA[--[[
	CSG (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Modeler > CSG
	============================================================
	F5 — CSG Booleano REAL aproximado para EditableModel.
	- Uniao: merge vertices + tris
	- Subtracao: remove tris de A cujo centroide está dentro de B
	- Intersecao: mantém só tris cujo centroide dentro de ambos
	- EstaDentro: ray-triangle even-odd (Moller-Trumbore) + bbox early-out
	- Opera em EditableModel (Vertices com Pos, Triangulos indices)
	============================================================
]]

local CSG = {}

-- Moller-Trumbore ray-triangle
local function rayTriIntersect(orig, dir, v0, v1, v2)
	local EPS = 1e-6
	local e1 = v1 - v0
	local e2 = v2 - v0
	local h = dir:Cross(e2)
	local a = e1:Dot(h)
	if a > -EPS and a < EPS then return nil end
	local f = 1.0 / a
	local s = orig - v0
	local u = f * s:Dot(h)
	if u < 0 or u > 1 then return nil end
	local q = s:Cross(e1)
	local v = f * dir:Dot(q)
	if v < 0 or u+v > 1 then return nil end
	local t = f * e2:Dot(q)
	if t > EPS then return t end
	return nil
end

function CSG.CalcularBBox(modelo)
	if #modelo.Vertices == 0 then return nil end
	local min = modelo.Vertices[1].Pos
	local max = min
	for _, v in ipairs(modelo.Vertices) do
		min = Vector3.new(math.min(min.X, v.Pos.X), math.min(min.Y, v.Pos.Y), math.min(min.Z, v.Pos.Z))
		max = Vector3.new(math.max(max.X, v.Pos.X), math.max(max.Y, v.Pos.Y), math.max(max.Z, v.Pos.Z))
	end
	return { Min=min, Max=max }
end

function CSG.PontoNaBBox(p, bbox)
	if not bbox then return false end
	return p.X >= bbox.Min.X and p.X <= bbox.Max.X
		and p.Y >= bbox.Min.Y and p.Y <= bbox.Max.Y
		and p.Z >= bbox.Min.Z and p.Z <= bbox.Max.Z
end

function CSG.EstaDentro(ponto, modelo, bbox)
	bbox = bbox or CSG.CalcularBBox(modelo)
	if not CSG.PontoNaBBox(ponto, bbox) then return false end
	-- ray +X, conta interseções
	local dir = Vector3.new(1, 0.123, 0.234).Unit -- direção levemente diagonal para evitar casos degenerados
	local orig = ponto + Vector3.new(0.001,0.001,0.001)
	local hits = 0
	for _, tri in ipairs(modelo.Triangulos) do
		local v0 = modelo.Vertices[tri[1]] and modelo.Vertices[tri[1]].Pos
		local v1 = modelo.Vertices[tri[2]] and modelo.Vertices[tri[2]].Pos
		local v2 = modelo.Vertices[tri[3]] and modelo.Vertices[tri[3]].Pos
		if v0 and v1 and v2 then
			if rayTriIntersect(orig, dir, v0, v1, v2) then
				hits = hits + 1
			end
		end
	end
	return (hits % 2) == 1
end

function CSG.CentroideTri(modelo, tri)
	local v0 = modelo.Vertices[tri[1]].Pos
	local v1 = modelo.Vertices[tri[2]].Pos
	local v2 = modelo.Vertices[tri[3]].Pos
	return (v0+v1+v2)/3
end

-- Uniao: merge simples
function CSG.Uniao(a, b, nome)
	local novo = a:Clonar()
	novo.Nome = nome or (a.Nome.."_Uniao_"..b.Nome)
	local offset = #novo.Vertices
	for _, v in ipairs(b.Vertices) do
		novo:AdicionarVertice(v.Pos, v.Normal, v.UV, v.Cor)
	end
	for _, tri in ipairs(b.Triangulos) do
		novo:AdicionarTriangulo(tri[1]+offset, tri[2]+offset, tri[3]+offset)
	end
	novo:CalcularNormais()
	return novo
end

-- Subtracao: A - B
function CSG.Subtracao(a, b, nome)
	local bboxB = CSG.CalcularBBox(b)
	local novo = a:Clonar()
	novo.Nome = nome or (a.Nome.."_Sub_"..b.Nome)
	local trisMantidos = {}
	for _, tri in ipairs(a.Triangulos) do
		local centro = CSG.CentroideTri(a, tri)
		if not CSG.EstaDentro(centro, b, bboxB) then
			table.insert(trisMantidos, tri)
		end
	end
	novo.Triangulos = trisMantidos
	novo:CalcularNormais()
	return novo
end

-- Intersecao: A ∩ B
function CSG.Intersecao(a, b, nome)
	local bboxA = CSG.CalcularBBox(a)
	local bboxB = CSG.CalcularBBox(b)
	local novo = a:Clonar()
	novo.Nome = nome or (a.Nome.."_Inter_"..b.Nome)
	local trisMantidos = {}
	for _, tri in ipairs(a.Triangulos) do
		local centro = CSG.CentroideTri(a, tri)
		if CSG.EstaDentro(centro, b, bboxB) and CSG.PontoNaBBox(centro, bboxA) then
			table.insert(trisMantidos, tri)
		end
	end
	novo.Triangulos = trisMantidos
	novo:CalcularNormais()
	return novo
end

function CSG.ListarOperacoes()
	return {
		{ Nome="Uniao", Desc="Merge de dois modelos (A + B)" },
		{ Nome="Subtracao", Desc="Remove de A o volume de B (A - B)" },
		{ Nome="Intersecao", Desc="Mantém só o volume comum (A ∩ B)" },
		{ Nome="EstaDentro", Desc="Teste ponto dentro do mesh (even-odd)" },
	}
end

return CSG
]]></ProtectedString></Properties></Item>
