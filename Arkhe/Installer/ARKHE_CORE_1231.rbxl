     <Item class="ModuleScript" referent="RBX863344"><Properties><string name="Name">System1104_VRConsole</string><ProtectedString name="Source"><![CDATA[
local System1104_VRConsole = {}
function System1104_VRConsole.novo()
  return setmetatable({
    Id=1104,
    Familia="VRConsole",
    Nome="System1104_VRConsole",
    TopbarBotao=true,
