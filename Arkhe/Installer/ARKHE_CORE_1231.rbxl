    Funcoes={"Novo","Abrir","Salvar","Editar","Deletar","Duplicar","Exportar","Importar","Configurar","Publicar"},
    Gradiente="Arkhe",
    Textura="Noise",
    Mobile=true,
    Console=true,
    VR=true,
    PC=true,
  }, {__index=System1403_Animator})
end
function System1403_Animator:GerarBotaoTopbar() return {Id=self.Id, Texto=self.Nome, Submenu=self.Funcoes} end
function System1403_Animator:Serializar() return {Id=self.Id, Familia=self.Familia, Funcoes=#self.Funcoes} end
return System1403_Animator
]]></ProtectedString></Properties></Item>
