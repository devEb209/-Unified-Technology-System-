     <Item class="ModuleScript" referent="RBX817806"><Properties><string name="Name">HeatmapLive</string><ProtectedString name="Source"><![CDATA[[[
	HeatmapLive (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Optimize > HeatmapLive
	============================================================
	F13 — HEATMAP AO VIVO DE PERFORMANCE
	- Grade 2D de custo por célula (ms + memória)
	- Registra custo de materialização D-O15 por pos
	- Visual: cor por custo (verde barato, vermelho caro)
	- Sugestões: onde otimizar (ex: muita vegetação)
	- Integra com Analyzer + LiveOptimizer
	============================================================
]]

local HeatmapLive = {}
HeatmapLive.__index = HeatmapLive

function HeatmapLive.novo(tamanhoCelula)
	local self = setmetatable({}, HeatmapLive)
	self.TamanhoCelula = tamanhoCelula or 20
	self.Celulas = {} -- ["x_z"] = { CustoMS, Memoria, Entidades, Sugestao }
	self.MaxCelulas = 2000
	return self
end

function HeatmapLive:Chave(pos)
	local x = math.floor(pos.X / self.TamanhoCelula)
	local z = math.floor(pos.Z / self.TamanhoCelula)
	return x.."_"..z, x, z
end

function HeatmapLive:Registrar(pos, custoMS, memoria, numEntidades)
	local chave = self:Chave(pos)
	local cel = self.Celulas[chave]
	if not cel then
		if #self.Celulas >= self.MaxCelulas then
			-- remove menor custo
			local menorChave, menorCusto=nil, math.huge
			for k, v in pairs(self.Celulas) do
				if v.CustoMS < menorCusto then menorCusto=v.CustoMS; menorChave=k end
			end
			if menorChave then self.Celulas[menorChave]=nil end
		end
		cel = { CustoMS=0, Memoria=0, Entidades=0, Amostras=0, Pos=pos }
		self.Celulas[chave]=cel
	end
	cel.CustoMS = (cel.CustoMS * cel.Amostras + custoMS) / (cel.Amostras+1)
	cel.Memoria = (cel.Memoria * cel.Amostras + (memoria or 0)) / (cel.Amostras+1)
	cel.Entidades = math.max(cel.Entidades, numEntidades or 0)
	cel.Amostras = cel.Amostras + 1
	cel.Pos = pos

	-- sugestão automática
	if cel.CustoMS > 5 then
		cel.Sugestao = "Custo alto ("..string.format("%.1fms", cel.CustoMS)..") - reduza entidades ou LOD"
	elseif cel.Entidades > 50 then
		cel.Sugestao = "Muitas entidades ("..cel.Entidades..") - use D-O15 relevancia"
	else
		cel.Sugestao = "OK"
	end
	return cel
end

function HeatmapLive:TopCustosas(n)
	n = n or 5
	local lista={}
	for chave, cel in pairs(self.Celulas) do
		table.insert(lista, { Chave=chave, Custo=cel.CustoMS, Entidades=cel.Entidades, Sugestao=cel.Sugestao, Pos=cel.Pos })
	end
	table.sort(lista, function(a,b) return a.Custo > b.Custo end)
	local top={}
	for i=1, math.min(n, #lista) do table.insert(top, lista[i]) end
	return top
end

function HeatmapLive:GerarCores()
	-- retorna lista com cor por custo
	local maxCusto=0
	for _, cel in pairs(self.Celulas) do
		if cel.CustoMS > maxCusto then maxCusto = cel.CustoMS end
	end
	if maxCusto==0 then maxCusto=1 end
	local cores={}
	for chave, cel in pairs(self.Celulas) do
		local intensidade = cel.CustoMS / maxCusto
		-- verde->amarelo->vermelho
		local r = math.clamp(intensidade*2, 0, 1)
		local g = math.clamp(2 - intensidade*2, 0, 1)
		local cor = Color3.new(r,g,0)
		table.insert(cores, {
			Chave=chave,
			Cor={ R=cor.R, G=cor.G, B=cor.B },
			Intensidade=intensidade,
			Custo=cel.CustoMS,
		})
	end
	return cores
end

function HeatmapLive:Limpar()
	self.Celulas={}
end

function HeatmapLive:Serializar()
	return {
		TamanhoCelula=self.TamanhoCelula,
		TotalCelulas=(function() local c=0 for _ in pairs(self.Celulas) do c=c+1 end return c end)(),
		Top=self:TopCustosas(3),
	}
end

return HeatmapLive
]]></ProtectedString></Properties></Item>
