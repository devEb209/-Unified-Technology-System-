     <Item class="ModuleScript" referent="RBX881698"><Properties><string name="Name">Crafting</string><ProtectedString name="Source"><![CDATA[[[
	Crafting (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Economy > Crafting
	============================================================
	F18 — SISTEMA DE CRAFTING
	- Receita: { Nome, Ingredientes {Item->Qtd}, Resultado {Item,Qtd}, Estacao, Tempo, NivelMin }
	- Estações: Bancada, Forja, Alquimia, Cozinha
	- Validação: tem ingredientes? tem estação? tem nível?
	- Integra com Inventory + Quest + RRW
	============================================================
]]

local Crafting = {}
Crafting.__index = Crafting

Crafting.Estacoes = { "Bancada","Forja","Alquimia","Cozinha","MesaEncantamento" }

function Crafting.novo()
	local self = setmetatable({}, Crafting)
	self.Receitas = {} -- [nome] = receita
	self.FilaCraft = {} -- crafts em andamento { Receita, Inicio, Jogador }
	return self
end

function Crafting:RegistrarReceita(nome, ingredientes, resultado, estacao, tempo, nivelMin, desc)
	-- ingredientes: { Madeira=2, Pedra=1 }
	-- resultado: { Item="EspadaMadeira", Qtd=1 }
	self.Receitas[nome] = {
		Nome=nome,
		Ingredientes=ingredientes or {},
		Resultado=resultado or { Item=nome, Qtd=1 },
		Estacao=estacao or "Bancada",
		Tempo=tempo or 2,
		NivelMin=nivelMin or 1,
		Desc=desc or "",
	}
	return self.Receitas[nome]
end

function Crafting:PodeCraftar(nome, inventario, estacaoAtual, nivelJogador)
	local receita = self.Receitas[nome]
	if not receita then return false, "Receita não encontrada" end
	if estacaoAtual and receita.Estacao ~= estacaoAtual then
		return false, "Precisa de "..receita.Estacao
	end
	if nivelJogador and nivelJogador < receita.NivelMin then
		return false, "Nível mínimo "..receita.NivelMin
	end
	if inventario then
		for item, qtd in pairs(receita.Ingredientes) do
			if not inventario.Tem or not inventario:Tem(item, qtd) then
				-- fallback simples se inventario for tabela
				if type(inventario)=="table" and (inventario[item] or 0) < qtd then
					return false, "Falta "..item.." x"..qtd
				elseif not inventario.Tem then
					return false, "Falta "..item
				end
			end
		end
	end
	return true, "OK"
end

function Crafting:Craftar(nome, inventario, jogador)
	local pode, motivo = self:PodeCraftar(nome, inventario)
	if not pode then return false, motivo end
	local receita = self.Receitas[nome]
	-- consome ingredientes
	if inventario and inventario.Remover then
		for item, qtd in pairs(receita.Ingredientes) do
			inventario:Remover(item, qtd)
		end
	end
	-- adiciona resultado
	if inventario and inventario.Adicionar then
		inventario:Adicionar(receita.Resultado.Item, receita.Resultado.Qtd)
	end
	table.insert(self.FilaCraft, {
		Receita=nome,
		Jogador=jogador,
		Quando=os.time(),
		Resultado=receita.Resultado,
	})
	if #self.FilaCraft > 20 then table.remove(self.FilaCraft,1) end
	return true, receita.Resultado
end

function Crafting:ListarReceitas(estacao, nivelMax)
	local lista={}
	for nome, rec in pairs(self.Receitas) do
		if (not estacao or rec.Estacao == estacao) and (not nivelMax or rec.NivelMin <= nivelMax) then
			table.insert(lista, rec)
		end
	end
	return lista
end

function Crafting:ListarEstacoes()
	return Crafting.Estacoes
end

function Crafting:Serializar()
	return {
		TotalReceitas=(function() local c=0 for _ in pairs(self.Receitas) do c=c+1 end return c end)(),
		Estacoes=Crafting.Estacoes,
		UltimosCrafts=self.FilaCraft,
	}
end

function Crafting.CriarReceitasPadrao()
	local c = Crafting.novo()
	c:RegistrarReceita("EspadaMadeira", { Madeira=3, Corda=1 }, { Item="EspadaMadeira", Qtd=1 }, "Bancada", 2, 1, "Espada simples de madeira")
	c:RegistrarReceita("PocaoVida", { Erva=2, Agua=1 }, { Item="PocaoVida", Qtd=1 }, "Alquimia", 3, 2, "Restaura vida")
	c:RegistrarReceita("MachadoPedra", { Madeira=2, Pedra=2, Corda=1 }, { Item="MachadoPedra", Qtd=1 }, "Bancada", 3, 1, "Machado para lenhar")
	c:RegistrarReceita("BarreiraMadeira", { Madeira=5 }, { Item="BarreiraMadeira", Qtd=1 }, "Bancada", 2, 1, "Barreira defensiva")
	c:RegistrarReceita("ArcoSimples", { Madeira=3, Corda=2 }, { Item="Arco", Qtd=1 }, "Bancada", 4, 2, "Arco para flechas")
	return c
end

return Crafting
]]></ProtectedString></Properties></Item>
