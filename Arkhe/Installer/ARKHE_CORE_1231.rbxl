     <Item class="ModuleScript" referent="RBX282685"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[[[
	Tutorial (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Education > Tutorial
	============================================================
	F21 — TUTORIAL INTERATIVO INVISÍVEL
	- Passos: { Id, Titulo, Desc, CondicaoCompletar, Dica, Recompensa }
	- Progresso por userId: { PassoAtual, Completos, Tempo }
	- Gatilhos: evento do jogo (ex: criou terreno, spawnou NPC)
	- Recompensa: XP, moeda, conquista WhyMode
	- Integra com WhyMode + Quest
	============================================================
]]

local Tutorial = {}
Tutorial.__index = Tutorial

Tutorial.PassosPadrao = {
	{ Id="boas_vindas", Titulo="Bem-vindo à Arkhe", Desc="Abra o Explorer e veja seu mundo como dados", Condicao="AbrirExplorer", Dica="O Explorer mostra entidades RRW, não Parts!", Recompensa={ XP=10 } },
	{ Id="primeiro_terreno", Titulo="Seu primeiro terreno", Desc="Crie um terreno com IA: escolha estilo ou descreva", Condicao="CriarTerreno", Dica="Tente 'fiorde norueguês com cachoeiras'", Recompensa={ XP=20, Moeda=10 } },
	{ Id="primeiro_npc", Titulo="Seu primeiro NPC", Desc="Spawne um NPC e veja ele viver sozinho", Condicao="CriarNPC", Dica="NPCs têm necessidades e fogem de fogo RRW!", Recompensa={ XP=20 } },
	{ Id="primeira_folha", Titulo="Primeira folha EventScript", Desc="Crie uma folha QUANDO colidir FAÇA explodir", Condicao="CriarFolha", Dica="QUANDO é âmbar, FAÇA é índigo. Toque para montar!", Recompensa={ XP=30 } },
	{ Id="primeiro_modelo", Titulo="Modele algo", Desc="Crie um modelo 3D com primitivas + CSG", Condicao="CriarModelo", Dica="CSG booleano real: Uniao/Subtracao/Intersecao", Recompensa={ XP=30 } },
	{ Id="publicar", Titulo="Publique seu mundo", Desc="Salve uma versão e exporte JSON", Condicao="Publicar", Dica="VersionManager salva snapshots com changelog", Recompensa={ XP=50, Moeda=50 } },
}

function Tutorial.novo()
	local self = setmetatable({}, Tutorial)
	self.Passos = {}
	for _, passo in ipairs(Tutorial.PassosPadrao) do
		self.Passos[passo.Id] = {
			Id=passo.Id,
			Titulo=passo.Titulo,
			Desc=passo.Desc,
			Condicao=passo.Condicao,
			Dica=passo.Dica,
			Recompensa=passo.Recompensa,
			Ordem=#self.Passos+1,
		}
	end
	self.Progresso = {} -- [userId] = { Atual, Completos={}, Inicio }
	return self
end

function Tutorial:ObterProgresso(userId)
	if not self.Progresso[userId] then
		self.Progresso[userId] = { Atual="boas_vindas", Completos={}, Inicio=os.time(), TempoTotal=0 }
	end
	return self.Progresso[userId]
end

function Tutorial:CompletarPasso(userId, passoId)
	local prog = self:ObterProgresso(userId)
	if prog.Completos[passoId] then return false end
	prog.Completos[passoId] = os.time()
	-- avança para próximo
	local ordemAtual = self.Passos[passoId] and self.Passos[passoId].Ordem or 0
	local proximo=nil
	for _, passo in pairs(self.Passos) do
		if passo.Ordem == ordemAtual+1 then proximo=passo.Id break end
	end
	if proximo then
		prog.Atual = proximo
	else
		prog.Atual = "concluido"
	end
	return true, self.Passos[passoId] and self.Passos[passoId].Recompensa or nil
end

function Tutorial:VerificarCondicao(userId, condicao)
	-- condicao: string do evento
	local prog = self:ObterProgresso(userId)
	local passoAtual = self.Passos[prog.Atual]
	if passoAtual and passoAtual.Condicao == condicao then
		return self:CompletarPasso(userId, prog.Atual)
	end
	return false
end

function Tutorial:ListarPassos()
	local lista={}
	for _, passo in pairs(self.Passos) do table.insert(lista, passo) end
	table.sort(lista, function(a,b) return a.Ordem < b.Ordem end)
	return lista
end

function Tutorial:ObterDica(userId)
	local prog = self:ObterProgresso(userId)
	local passo = self.Passos[prog.Atual]
	return passo and passo.Dica or "Você completou o tutorial! Explore livremente."
end

function Tutorial:ProgressoPercentual(userId)
	local prog = self:ObterProgresso(userId)
	local total=0; for _ in pairs(self.Passos) do total=total+1 end
	local completos=0; for _ in pairs(prog.Completos) do completos=completos+1 end
	return completos/total, completos, total
end

function Tutorial:Serializar(userId)
	if userId then
		local prog = self:ObterProgresso(userId)
		local perc, comp, tot = self:ProgressoPercentual(userId)
		return {
			Atual=prog.Atual,
			Completos=prog.Completos,
			Percentual=perc,
			CompletosNum=comp,
			Total=tot,
			Dica=self:ObterDica(userId),
		}
	else
		return {
			TotalPassos=(function() local c=0 for _ in pairs(self.Passos) do c=c+1 end return c end)(),
			Passos=self:ListarPassos(),
		}
	end
end

return Tutorial
]]></ProtectedString></Properties></Item>
