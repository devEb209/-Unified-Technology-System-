    </Item>
    <Item class="Folder" referent="RBX536511">
     <Properties>
      <string name="Name">Physica</string>
     </Properties>
     <Item class="ModuleScript" referent="RBX38369"><Properties><string name="Name">Ballistics</string><ProtectedString name="Source"><![CDATA[[[
	Ballistics (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Physica > Ballistics
	============================================================
	F8 — BALÍSTICA COM ARRASTO/GRAVIDADE POR PRESET
	- Projétil: { Pos, Vel, Massa, Calibre, Arrasto, Gravidade }
	- Presets: Flecha, Bala, Canhão, Mágico, Lunar
	- Simulação: Euler com arrasto quadrático + gravidade preset
	- Colisão: raycast por segmento, dano por energia cinética
	- Integra com Physica presets + Destruction
	============================================================
]]

local Ballistics = {}
Ballistics.__index = Ballistics

Ballistics.Presets = {
	Flecha = { Massa=0.05, Arrasto=0.02, Gravidade=1.0, VelInicial=80, DanoBase=25, Desc="Arco: leve, arqueada, média penetração" },
	Bala = { Massa=0.01, Arrasto=0.005, Gravidade=0.3, VelInicial=300, DanoBase=40, Desc="Bala: rápida, reta, alta penetração" },
	Canhao = { Massa=5.0, Arrasto=0.1, Gravidade=1.2, VelInicial=120, DanoBase=100, Desc="Canhão: pesada, parabólica, destrutiva" },
	Magico = { Massa=0.1, Arrasto=0.001, Gravidade=0.1, VelInicial=60, DanoBase=30, Desc="Mágico: quase sem gravidade, brilhante" },
	Lunar = { Massa=0.05, Arrasto=0.001, Gravidade=0.16, VelInicial=50, DanoBase=20, Desc="Lunar: gravidade baixa, flutuante" },
	Subaquatico = { Massa=0.05, Arrasto=0.5, Gravidade=0.5, VelInicial=20, DanoBase=15, Desc="Subaquático: arrasto alto, curta" },
}

function Ballistics.novo(presetNome, pos, direcao, velExtra)
	local preset = Ballistics.Presets[presetNome or "Flecha"]
	local self = setmetatable({}, Ballistics)
	self.Preset = presetNome or "Flecha"
	self.Pos = pos or Vector3.new(0,5,0)
	self.Vel = (direcao and direcao.Unit or Vector3.new(0,0,1)) * (preset.VelInicial + (velExtra or 0))
	self.Massa = preset.Massa
	self.Arrasto = preset.Arrasto
	self.Gravidade = preset.Gravidade
	self.DanoBase = preset.DanoBase
	self.TempoVoo = 0
	self.Distancia = 0
	self.Ativo = true
	self.Trajetoria = {} -- {Pos, Tempo}
	return self
end

function Ballistics:Simular(dt, gravidadeMundo)
	dt = dt or 0.033
	gravidadeMundo = gravidadeMundo or Vector3.new(0,-9.81,0)
	if not self.Ativo then return self.Pos end

	-- arrasto quadrático: F = -k * v^2 * dir
	local velMag = self.Vel.Magnitude
	local arrastoForce = Vector3.new(0,0,0)
	if velMag > 0.1 then
		arrastoForce = -self.Vel.Unit * (self.Arrasto * velMag * velMag)
	end
	-- gravidade preset
	local grav = gravidadeMundo * self.Gravidade

	-- Euler
	local accel = (arrastoForce / self.Massa) + grav
	self.Vel = self.Vel + accel * dt
	local novaPos = self.Pos + self.Vel * dt
	self.Distancia = self.Distancia + (novaPos - self.Pos).Magnitude
	self.Pos = novaPos
	self.TempoVoo = self.TempoVoo + dt

	table.insert(self.Trajetoria, { Pos=self.Pos, Tempo=self.TempoVoo })
	if #self.Trajetoria > 100 then table.remove(self.Trajetoria,1) end

	-- desativa se muito lento ou muito longe
	if velMag < 1 or self.Distancia > 500 or self.Pos.Y < -100 then
		self.Ativo = false
	end
	return self.Pos, self.Ativo
end

function Ballistics:CalcularDano(distanciaAlvo)
	-- energia cinética 0.5*m*v^2 + queda por distância
	local energia = 0.5 * self.Massa * self.Vel.Magnitude * self.Vel.Magnitude
	local queda = math.clamp(1 - (distanciaAlvo or self.Distancia)/300, 0.2, 1)
	return math.floor(self.DanoBase * queda + energia * 0.1)
end

function Ballistics:PreverTrajetoria(tempoTotal, dt)
	-- clona e simula sem alterar original
	dt = dt or 0.05
	tempoTotal = tempoTotal or 3
	local clone = Ballistics.novo(self.Preset, self.Pos, self.Vel.Unit, 0)
	clone.Vel = self.Vel
	clone.Massa = self.Massa
	clone.Arrasto = self.Arrasto
	clone.Gravidade = self.Gravidade
	local pontos={}
	local t=0
	while t < tempoTotal and clone.Ativo do
		clone:Simular(dt)
		table.insert(pontos, clone.Pos)
		t = t + dt
	end
	return pontos
end

function Ballistics:Serializar()
	return {
		Preset=self.Preset,
		Pos={ X=self.Pos.X, Y=self.Pos.Y, Z=self.Pos.Z },
		VelMag=self.Vel.Magnitude,
		TempoVoo=self.TempoVoo,
		Distancia=self.Distancia,
		Ativo=self.Ativo,
		Dano=self:CalcularDano(),
	}
end

function Ballistics.ListarPresets()
	local lista={}
	for nome, p in pairs(Ballistics.Presets) do
		table.insert(lista, { Nome=nome, Desc=p.Desc, Vel=p.VelInicial, Dano=p.DanoBase })
	end
	return lista
end

return Ballistics
]]></ProtectedString></Properties></Item>
