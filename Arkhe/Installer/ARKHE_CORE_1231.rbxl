     <Item class="ModuleScript" referent="RBX761653"><Properties><string name="Name">Destruction</string><ProtectedString name="Source"><![CDATA[[[
	Destruction (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Physica > Destruction
	============================================================
	F8 — DESTRUIÇÃO ESTRUTURAL
	- Cada entidade tem Integridade 0-100 + pontos de fratura
	- Dano: reduz integridade, se < limiar fratura -> quebra
	- Quebra: gera fragmentos (Partes) com velocidade + matéria RRW
	- Propagação: dano em cascata por vizinhança (raycast estrutural)
	- Integra com RRW World + Materia densidade
	============================================================
]]

local Destruction = {}
Destruction.__index = Destruction

Destruction.Limiares = {
	Trinca = 70,
	Quebra = 40,
	Colapso = 15,
}

function Destruction.novo(entidadeId, integridadeMax)
	local self = setmetatable({}, Destruction)
	self.EntidadeId = entidadeId
	self.IntegridadeMax = integridadeMax or 100
	self.Integridade = integridadeMax or 100
	self.Estado = "Integro" -- Integro/Trincado/Quebrado/Colapsado
	self.PontosFratura = {} -- { Pos, Normal, Severidade }
	self.Vizinhos = {} -- ids de entidades estruturalmente ligadas
	self.Material = "Rocha"
	return self
end

function Destruction:AdicionarVizinho(vizinhoId)
	table.insert(self.Vizinhos, vizinhoId)
	return #self.Vizinhos
end

function Destruction:AplicarDano(quantidade, posImpacto, tipoDano)
	quantidade = quantidade or 10
	self.Integridade = math.clamp(self.Integridade - quantidade, 0, self.IntegridadeMax)
	local perc = self.Integridade / self.IntegridadeMax * 100
	if perc <= Destruction.Limiares.Colapso then
		self.Estado = "Colapsado"
	elseif perc <= Destruction.Limiares.Quebra then
		self.Estado = "Quebrado"
	elseif perc <= Destruction.Limiares.Trinca then
		self.Estado = "Trincado"
	else
		self.Estado = "Integro"
	end
	if posImpacto then
		table.insert(self.PontosFratura, {
			Pos = posImpacto,
			Severidade = quantidade,
			Tipo = tipoDano or "Impacto",
			Quando = os.time(),
		})
	end
	return self.Estado, self.Integridade
end

function Destruction:DeveQuebrar()
	return self.Estado == "Quebrado" or self.Estado == "Colapsado"
end

function Destruction:GerarFragmentos(centro, quantidade)
	quantidade = quantidade or 5
	if not self:DeveQuebrar() then return {} end
	local fragmentos={}
	for i=1, quantidade do
		table.insert(fragmentos, {
			Pos = centro + Vector3.new(math.random(-3,3), math.random(0,3), math.random(-3,3)),
			Vel = Vector3.new(math.random(-10,10), math.random(5,15), math.random(-10,10)),
			Tamanho = math.random(1,3),
			Material = self.Material,
			Vida = math.random(5,15),
		})
	end
	return fragmentos
end

function Destruction:PropagarDano(world, quantidade, raio)
	-- propaga para vizinhos estruturais
	raio = raio or 10
	quantidade = quantidade or 5
	local afetados={}
	for _, vizId in ipairs(self.Vizinhos) do
		if world and world.ObterEntidade then
			local ok, ent = pcall(function() return world:ObterEntidade(vizId) end)
			if ok and ent then
				-- se tem Destruction, aplica
				table.insert(afetados, vizId)
			end
		end
	end
	return afetados
end

function Destruction:Reparar(quantidade)
	quantidade = quantidade or 20
	self.Integridade = math.clamp(self.Integridade + quantidade, 0, self.IntegridadeMax)
	if self.Integridade > Destruction.Limiares.Trinca then
		self.Estado = "Integro"
	elseif self.Integridade > Destruction.Limiares.Quebra then
		self.Estado = "Trincado"
	end
	return self.Estado
end

function Destruction:Serializar()
	return {
		EntidadeId=self.EntidadeId,
		Integridade=self.Integridade,
		Max=self.IntegridadeMax,
		Estado=self.Estado,
		NumFraturas=#self.PontosFratura,
		Vizinhos=#self.Vizinhos,
		Material=self.Material,
	}
end

return Destruction
]]></ProtectedString></Properties></Item>
