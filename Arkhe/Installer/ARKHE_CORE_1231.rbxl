     <Item class="ModuleScript" referent="RBX600216"><Properties><string name="Name">EventBusAdvanced</string><ProtectedString name="Source"><![CDATA[[[
	EventBusAdvanced (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Kernel > EventBusAdvanced
	============================================================
	F1 — BARRAMENTO DE EVENTOS AVANÇADO
	- Eventos com prioridade, filtros, once, async
	- Tópicos hierárquicos: "mundo.fogo.espalhou", "npc.*.morreu"
	- Middleware: intercepta/modifica eventos
	- Replay: reexecuta últimos N eventos (debug)
	- Integra com Kernel.ChamarExtensoes + EventScript
	============================================================
]]

local EventBusAdvanced = {}
EventBusAdvanced.__index = EventBusAdvanced

function EventBusAdvanced.novo()
	local self = setmetatable({}, EventBusAdvanced)
	self.Ouvintes = {} -- [topico] = { { Id, Callback, Prioridade, Once, Filtro }, ... }
	self.Middlewares = {} -- { Callback, Prioridade }
	self.Historico = {} -- últimos 100 eventos { Topico, Dados, Quando }
	self.TotalEmitidos = 0
	self.ProximoId = 1
	return self
end

function EventBusAdvanced:On(topico, callback, prioridade, filtro, once)
	prioridade = prioridade or 0
	self.Ouvintes[topico] = self.Ouvintes[topico] or {}
	local id = self.ProximoId
	self.ProximoId = self.ProximoId + 1
	table.insert(self.Ouvintes[topico], {
		Id=id,
		Callback=callback,
		Prioridade=prioridade,
		Filtro=filtro, -- function(dados)->bool
		Once=once or false,
	})
	-- ordena por prioridade desc
	table.sort(self.Ouvintes[topico], function(a,b) return a.Prioridade > b.Prioridade end)
	return id
end

function EventBusAdvanced:Once(topico, callback, prioridade, filtro)
	return self:On(topico, callback, prioridade, filtro, true)
end

function EventBusAdvanced:Off(topico, id)
	local lista = self.Ouvintes[topico]
	if not lista then return false end
	for i, ouv in ipairs(lista) do
		if ouv.Id == id then
			table.remove(lista, i)
			return true
		end
	end
	return false
end

function EventBusAdvanced:Use(middleware, prioridade)
	-- middleware: function(topico, dados, next) -> dados modificado ou nil para bloquear
	prioridade = prioridade or 0
	table.insert(self.Middlewares, { Callback=middleware, Prioridade=prioridade })
	table.sort(self.Middlewares, function(a,b) return a.Prioridade > b.Prioridade end)
	return #self.Middlewares
end

function EventBusAdvanced:Emitir(topico, dados)
	self.TotalEmitidos = self.TotalEmitidos + 1
	-- middlewares
	local dadosAtuais = dados
	for _, mw in ipairs(self.Middlewares) do
		local ok, res = pcall(mw.Callback, topico, dadosAtuais, function(d) dadosAtuais=d end)
		if not ok then
			warn("[EventBus] Middleware erro: "..tostring(res))
		else
			if res == false then
				-- bloqueado
				return false, "Bloqueado por middleware"
			elseif res ~= nil then
				dadosAtuais = res
			end
		end
	end

	-- histórico
	table.insert(self.Historico, { Topico=topico, Dados=dadosAtuais, Quando=os.time() })
	if #self.Historico > 100 then table.remove(self.Historico,1) end

	-- ouvintes exatos + wildcard
	local chamados=0
	for padrao, lista in pairs(self.Ouvintes) do
		local match = false
		if padrao == topico then match=true
		elseif string.find(padrao, "%*") then
			-- converte wildcard para pattern
			local pat = "^"..string.gsub(padrao, "%*", ".*").."$"
			if string.match(topico, pat) then match=true end
		end
		if match then
			for i=#lista, 1, -1 do -- reverso para remover once
				local ouv = lista[i]
				local passaFiltro=true
				if ouv.Filtro then
					local ok, res = pcall(ouv.Filtro, dadosAtuais)
					passaFiltro = ok and res
				end
				if passaFiltro then
					local ok, err = pcall(ouv.Callback, dadosAtuais, topico)
					if not ok then warn("[EventBus] Ouvinte erro: "..tostring(err)) end
					chamados=chamados+1
					if ouv.Once then table.remove(lista, i) end
				end
			end
		end
	end
	return true, chamados
end

function EventBusAdvanced:EmitirAsync(topico, dados)
	task.spawn(function()
		self:Emitir(topico, dados)
	end)
	return true
end

function EventBusAdvanced:Replay(n, filtroTopico)
	n = n or 10
	local lista={}
	for i=math.max(1, #self.Historico-n+1), #self.Historico do
		local ev = self.Historico[i]
		if not filtroTopico or ev.Topico == filtroTopico or string.find(ev.Topico, filtroTopico) then
			table.insert(lista, ev)
		end
	end
	-- reemite
	for _, ev in ipairs(lista) do
		self:Emitir(ev.Topico, ev.Dados)
	end
	return #lista
end

function EventBusAdvanced:ListarTopicos()
	local lista={}
	for topico, ouvintes in pairs(self.Ouvintes) do
		table.insert(lista, { Topico=topico, Ouvintes=#ouvintes })
	end
	return lista
end

function EventBusAdvanced:Stats()
	local totalOuv=0
	for _, lista in pairs(self.Ouvintes) do totalOuv=totalOuv+#lista end
	return {
		Topicos=(function() local c=0 for _ in pairs(self.Ouvintes) do c=c+1 end return c end)(),
		Ouvintes=totalOuv,
		Middlewares=#self.Middlewares,
		Emitidos=self.TotalEmitidos,
		Historico=#self.Historico,
	}
end

function EventBusAdvanced:Serializar()
	return self:Stats()
end

return EventBusAdvanced
]]></ProtectedString></Properties></Item>
