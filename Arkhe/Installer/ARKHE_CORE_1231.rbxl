    PC=true,
  }, {__index=System1498_Cinematic})
end
function System1498_Cinematic:GerarBotaoTopbar() return {Id=self.Id, Texto=self.Nome, Submenu=self.Funcoes} end
function System1498_Cinematic:Serializar() return {Id=self.Id, Familia=self.Familia, Funcoes=#self.Funcoes} end
return System1498_Cinematic
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX859247"><Properties><string name="Name">TimelineEditor</string><ProtectedString name="Source"><![CDATA[--[[
	TimelineEditor (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Cinematic > TimelineEditor
	============================================================
	F17 — TIMELINE VISUAL para cutscenes + anim clips
	- Faixas: Camera, Visual, Audio, NPC, Evento
	- Keyframes visuais com easing editável (usa CurveEditor)
	- Export como clip ou spline
	- Serializável
	============================================================
]]

local TimelineEditor = {}
TimelineEditor.__index = TimelineEditor

function TimelineEditor.novo(nome, duracao)
	local self = setmetatable({}, TimelineEditor)
	self.Nome = nome or "Cutscene"
	self.Duracao = duracao or 10
	self.Faixas = {
		Camera = {}, -- { Tempo, Pos, FOV, Easing }
		Visual = {}, -- { Tempo, Preset, Duracao }
		Audio = {}, -- { Tempo, Id, Volume }
		NPC = {}, -- { Tempo, Acao, Alvo }
		Evento = {}, -- { Tempo, Nome, Args }
	}
	return self
end

function TimelineEditor:AdicionarKeyframe(faixa, tempo, dados)
	faixa = faixa or "Camera"
	self.Faixas[faixa] = self.Faixas[faixa] or {}
	tempo = math.clamp(tempo or 0, 0, self.Duracao)
	local kf = { Tempo=tempo, Dados=dados or {}, Easing="SineInOut" }
	table.insert(self.Faixas[faixa], kf)
	table.sort(self.Faixas[faixa], function(a,b) return a.Tempo < b.Tempo end)
	return #self.Faixas[faixa]
end

function TimelineEditor:RemoverKeyframe(faixa, indice)
	local lista = self.Faixas[faixa]
	if lista and lista[indice] then table.remove(lista, indice) return true end
	return false
end

function TimelineEditor:Avaliar(faixa, tempo)
	local lista = self.Faixas[faixa]
	if not lista or #lista==0 then return nil end
	if #lista==1 then return lista[1] end
	-- encontra segmento
	for i=1,#lista-1 do
		local k1=lista[i]
		local k2=lista[i+1]
		if tempo >= k1.Tempo and tempo <= k2.Tempo then
			local t = (tempo - k1.Tempo) / math.max(k2.Tempo - k1.Tempo, 0.001)
			return { K1=k1, K2=k2, T=t, Faixa=faixa }
		end
	end
	-- fora do range: retorna último
	return lista[#lista]
end

function TimelineEditor:ExportarParaSpline(cameraSpline)
	if not cameraSpline then return nil end
	cameraSpline:Limpar()
	for _, kf in ipairs(self.Faixas.Camera or {}) do
		local pos = kf.Dados.Pos or Vector3.new(0,5,0)
		local fov = kf.Dados.FOV or 70
		cameraSpline:AdicionarPonto(pos, fov, kf.Tempo, kf.Dados.Evento)
	end
	return cameraSpline
end

function TimelineEditor:ExportarParaClip(animationClip, curveEditor)
	if not animationClip then return nil end
	-- converte faixa NPC ou Camera para tracks de anim
	-- simplificado: usa faixa Camera como track de Root
	return animationClip
end

function TimelineEditor:Serializar()
	local total=0
	for _, lista in pairs(self.Faixas) do total=total+#lista end
	return {
		Nome=self.Nome,
		Duracao=self.Duracao,
		TotalKeyframes=total,
		Faixas=self.Faixas,
	}
end

function TimelineEditor:Contar()
	local total=0
	for _, lista in pairs(self.Faixas) do total=total+#lista end
	return total
end

function TimelineEditor:ListarFaixas()
	local lista={}
	for nome, kfs in pairs(self.Faixas) do table.insert(lista, { Nome=nome, Total=#kfs }) end
	return lista
end

function TimelineEditor.LimparTodas(timeline)
	for faixa,_ in pairs(timeline.Faixas) do timeline.Faixas[faixa]={} end
end

return TimelineEditor
]]></ProtectedString></Properties></Item>
