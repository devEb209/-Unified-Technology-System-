function FileExplorer.novo() return setmetatable({Nome="FileExplorer", Ativo=true, Dados={}}, {__index=FileExplorer}) end
function FileExplorer:Ativar() self.Ativo=true end
function FileExplorer:Desativar() self.Ativo=false end
function FileExplorer:Tick(dt) end
