     <Item class="ModuleScript" referent="RBX923136"><Properties><string name="Name">Revenue</string><ProtectedString name="Source"><![CDATA[[[
	Revenue (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Marketplace > Revenue
	============================================================
	F14 — RECEITA DO CRIADOR (marketplace)
	- Cada venda gera receita: 70% criador, 30% Arkhe
	- Moeda Arkhe: R$k (moeda virtual)
	- Saldo por criador, histórico de vendas, saque
	- Integra com Shop + Inventory + relay /marketplace/revenue
	============================================================
]]

local Revenue = {}
Revenue.__index = Revenue

Revenue.TaxaArkhe = 0.3 -- 30% Arkhe
Revenue.TaxaCriador = 0.7

function Revenue.novo()
	local self = setmetatable({}, Revenue)
	self.Criadores = {} -- [nomeCriador] = { Saldo, TotalVendas, TotalReceita, Vendas[] }
	self.Vendas = {} -- histórico global
	self.TotalMovimentado = 0
	return self
end

function Revenue:RegistrarVenda(assetId, nomeAsset, criador, comprador, preco)
	preco = preco or 0
	if preco <= 0 then return nil end -- grátis não gera receita
	local receitaCriador = math.floor(preco * Revenue.TaxaCriador)
	local receitaArkhe = preco - receitaCriador

	self.Criadores[criador] = self.Criadores[criador] or { Saldo=0, TotalVendas=0, TotalReceita=0, Vendas={} }
	self.Criadores[criador].Saldo = self.Criadores[criador].Saldo + receitaCriador
	self.Criadores[criador].TotalVendas = self.Criadores[criador].TotalVendas + 1
	self.Criadores[criador].TotalReceita = self.Criadores[criador].TotalReceita + receitaCriador
	table.insert(self.Criadores[criador].Vendas, {
		AssetId=assetId,
		Nome=nomeAsset,
		Comprador=comprador,
		Preco=preco,
		Receita=receitaCriador,
		Quando=os.time(),
	})

	local venda = {
		AssetId=assetId,
		Nome=nomeAsset,
		Criador=criador,
		Comprador=comprador,
		Preco=preco,
		ReceitaCriador=receitaCriador,
		ReceitaArkhe=receitaArkhe,
		Quando=os.time(),
	}
	table.insert(self.Vendas, venda)
	self.TotalMovimentado = self.TotalMovimentado + preco
	if #self.Vendas > 100 then table.remove(self.Vendas,1) end

	return venda
end

function Revenue:ObterSaldo(criador)
	local dados = self.Criadores[criador]
	return dados and dados.Saldo or 0
end

function Revenue:Sacar(criador, quantidade)
	local dados = self.Criadores[criador]
	if not dados then return false, "Criador não encontrado" end
	if dados.Saldo < quantidade then return false, "Saldo insuficiente" end
	dados.Saldo = dados.Saldo - quantidade
	return true, dados.Saldo
end

function Revenue:TopCriadores(n)
	n = n or 5
	local lista={}
	for nome, dados in pairs(self.Criadores) do
		table.insert(lista, { Nome=nome, Saldo=dados.Saldo, Vendas=dados.TotalVendas, Receita=dados.TotalReceita })
	end
	table.sort(lista, function(a,b) return a.Receita > b.Receita end)
	local top={}
	for i=1, math.min(n, #lista) do table.insert(top, lista[i]) end
	return top
end

function Revenue:ListarVendas(criador, limite)
	limite = limite or 10
	if criador then
		local dados = self.Criadores[criador]
		if not dados then return {} end
		local lista={}
		for i=math.max(1, #dados.Vendas-limite+1), #dados.Vendas do
			table.insert(lista, dados.Vendas[i])
		end
		return lista
	else
		local lista={}
		for i=math.max(1, #self.Vendas-limite+1), #self.Vendas do
			table.insert(lista, self.Vendas[i])
		end
		return lista
	end
end

function Revenue:Stats()
	local totalCriadores=0
	for _ in pairs(self.Criadores) do totalCriadores=totalCriadores+1 end
	return {
		TotalCriadores=totalCriadores,
		TotalVendas=#self.Vendas,
		TotalMovimentado=self.TotalMovimentado,
		TaxaCriador=Revenue.TaxaCriador,
		TaxaArkhe=Revenue.TaxaArkhe,
	}
end

function Revenue:Serializar()
	return {
		Stats=self:Stats(),
		Top=self:TopCriadores(3),
	}
end

return Revenue
]]></ProtectedString></Properties></Item>
