     <Item class="ModuleScript" referent="RBX529160"><Properties><string name="Name">ContextMenu</string><ProtectedString name="Source"><![CDATA[
local ContextMenu = {}
function ContextMenu.novo()
  return setmetatable({
    Itens={
      {Nome="Recortar", Atalho="Ctrl+X", Icone="[CUT]", Submenu={}},
      {Nome="Copiar", Atalho="Ctrl+C", Icone="[COPY]", Submenu={}},
      {Nome="Colar", Atalho="Ctrl+V", Icone="[PASTE]", Submenu={}},
      {Nome="Duplicar", Atalho="Ctrl+D", Icone="[DUP]", Submenu={"Duplicar com filhos","Duplicar sem filhos"}},
      {Nome="Deletar", Atalho="Del", Icone="[DEL]", Submenu={}},
      {Nome="Renomear", Atalho="F2", Icone="[EDIT]", Submenu={}},
      {Nome="Agrupar", Atalho="Ctrl+G", Icone="[PKG]", Submenu={"Agrupar como Model","Agrupar como Folder"}},
      {Nome="Desagrupar", Atalho="Ctrl+U", Icone="[UNGROUP]", Submenu={}},
      {Nome="Mover Para", Icone="[MOVE]", Submenu={"ReplicatedStorage","Workspace","ServerScriptService","StarterPlayer","ArkheRealidade"}},
      {Nome="Inserir Objeto", Icone="[ADD]", Submenu={"Parte","Script","ModuleScript","Folder","Partícula","Som","Luz","Arkhe Entidade"}},
      {Nome="Propriedades Arkhe", Icone="[ARKHE]", Submenu={"Tornar Queimavel","Tornar Destrutivel","Mudar Bioma","Mudar Material","Definir Fidelidade"}},
    }
  }, {__index=ContextMenu})
end
function ContextMenu:AdicionarItem(nome, atalho, icone, submenu)
  table.insert(self.Itens, {Nome=nome, Atalho=atalho or "", Icone=icone or "", Submenu=submenu or {}})
end
function ContextMenu:Listar() return self.Itens end
function ContextMenu:ContarFuncoes()
  local total=0
  for _, it in ipairs(self.Itens) do total=total+1+#it.Submenu end
  return total
end
function ContextMenu:Serializar() return {TotalItens=#self.Itens, TotalFuncoes=self:ContarFuncoes()} end
return ContextMenu
]]></ProtectedString></Properties></Item>
