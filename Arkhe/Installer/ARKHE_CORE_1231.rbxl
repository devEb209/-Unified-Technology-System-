     <Item class="ModuleScript" referent="RBX348915"><Properties><string name="Name">HeightmapImporter</string><ProtectedString name="Source"><![CDATA[--[[
	HeightmapImporter (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Import > HeightmapImporter
	============================================================
	F11 — HEIGHTMAP → TERRENO PROPRIO (Ring1).

	Converte imagem grayscale (ou matriz) em HeightField.
	- Entrada local: matriz 2D { {0..1,...}, ... } (ex: do relay que leu PNG)
	- Entrada relay: POST /import/heightmap { Url, TamanhoKm, Resolucao }
	  → { Alturas=[[0..1,...],...], EscalaVertical }

	Biomas sao recalculados automaticamente pelo HeightField.
	Vegetacao RRW pode ser povoada depois (mesma funcao do Terrain).
	============================================================
]]

local HeightmapImporter = {}

function HeightmapImporter.MatrizDeGrayscale(width, height, func)
	-- func(x,y) -> 0..1, gera matriz
	local matriz = {}
	for y = 1, height do
		matriz[y] = {}
		for x = 1, width do
			matriz[y][x] = func(x,y)
		end
	end
	return matriz
end

function HeightmapImporter.MatrizRuido(width, height, seed, frequencia)
	seed = seed or 1234
	frequencia = frequencia or 0.02
	local matriz = {}
	for y = 1, height do
		matriz[y] = {}
		for x = 1, width do
			local n = math.noise(x*frequencia + seed*0.1, y*frequencia + seed*0.2)
			matriz[y][x] = (n + 1)/2
		end
	end
	return matriz
end

function HeightmapImporter.MatrizParaAlturasReais(matrizGrayscale, alturaMaximaMetros)
	alturaMaximaMetros = alturaMaximaMetros or 120
	local alturas = {}
	for y, linha in ipairs(matrizGrayscale) do
		alturas[y] = {}
		for x, v in ipairs(linha) do
			alturas[y][x] = v * alturaMaximaMetros
		end
	end
	return alturas
end

function HeightmapImporter.AplicarNoMundo(matrizAlturas, escalaVertical, Kernel)
	local HeightField = nil
	local ok, mod = pcall(function()
		return Kernel and Kernel.Obter and Kernel.Obter("HeightField") or require(game:GetService("ReplicatedStorage").Arkhe.Terrain.HeightField)
	end)
	if not ok then
		local ok2, m = pcall(function() return require(game:GetService("ReplicatedStorage").Arkhe.Terrain.HeightField) end)
		if ok2 then HeightField = m end
	else HeightField = mod end
	if not HeightField then return nil, "HeightField nao encontrado" end

	local campo = HeightField.nova({ Largura = 96, Celula = 12 })
	local ok2 = campo:CarregarMatriz(matrizAlturas, escalaVertical or 0.28)
	if not ok2 then return nil, "falha ao carregar matriz" end
	return campo
end

function HeightmapImporter.GerarExemplos()
	return {
		{ Nome="Ruido Suave", Desc="Perlin noise para colinas", Tipo="Ruido" },
		{ Nome="Ilha Radial", Desc="Gradiente circular + ruido", Tipo="Ilha" },
		{ Nome="Deserto Dunas", Desc="Ridged noise", Tipo="Deserto" },
	}
end

return HeightmapImporter
]]></ProtectedString></Properties></Item>
