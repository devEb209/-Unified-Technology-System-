<Item class="ModuleScript" referent="ARK7468">
<Properties>
<string name="Name">B_0304_search_cache</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0304 :: Search And Filter Preview Cache
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: cache (reuse of expensive editor previews)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0304"
	S.key = "arkher.studio.search.preview_cache"
	S.name = "Search And Filter Preview Cache"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Search And Filter"
	S.aspect = "Preview Cache"
	S.kit = "cache"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.search.tool_pipeline" }
	S.tags = { "b", "search", "cache", "studio" }
	S.description = "Search And Filter Preview Cache: reuse of expensive editor previews for the Search And Filter subsystem."
	S.params = {
		backlogLimit = 18,
		baseRadius = 560,
		baseWeight = 0.5,
		bias = 0.1,
		biasWeight = 0.15,
		ceiling = 442,
		detailWeight = 0.3,
		failureTolerance = 0,
		horizon = 3,
		integrator = "euler",
		minConfidence = 0.5,
		minThrottle = 0.15,
		regressionSlope = 0.1,
		saturation = 0.7,
		scale = 2.0
	}
	S.features = { "set", "get", "remove", "evict", "tick", "hitRate", "warm", "clear", "stats", "memoize", "prefetch", "pressure", "shrinkTo", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("cache", { id = "arkher.studio.search.preview_cache", policy = "lfu", capacity = 442, ttl = 0 })
		inst.system = S
		inst.ctx = ctx

	function inst.memoize(fn)
		return function(key, ...)
			local hit = inst.get(key)
			if hit ~= nil then return hit, true end
			local value = fn(key, ...)
			inst.set(key, value)
			return value, false
		end
	end
	function inst.prefetch(keys, producer)
		local n = 0
		for _, k in ipairs(keys) do
			if inst.get(k) == nil then inst.set(k, producer(k)) n = n + 1 end
		end
		return n
	end
	function inst.pressure() return inst.stats().size / math.max(1, inst.capacity) end
	function inst.shrinkTo(capacity)
		inst.capacity = math.max(1, capacity)
		return inst.evict()
	end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.search.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local calls = 0
		local memo = inst.memoize(function(k) calls = calls + 1 return k * 2 end)
		local v1 = memo(21)
		local v2, cached = memo(21)
		inst.clear()
		return v1 == 42 and v2 == 42 and cached == true and calls == 1
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7469">
<Properties>
<string name="Name">B_0305_search_session</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0305 :: Search And Filter Session Sync
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: session (multi-user editing of this editor surface)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0305"
	S.key = "arkher.studio.search.session_sync"
	S.name = "Search And Filter Session Sync"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Search And Filter"
	S.aspect = "Session Sync"
	S.kit = "session"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.search.preview_cache" }
	S.tags = { "b", "search", "session", "studio" }
	S.description = "Search And Filter Session Sync: multi-user editing of this editor surface for the Search And Filter subsystem."
	S.params = {
		backlogLimit = 23,
		baseRadius = 280,
		baseWeight = 0.85,
		bias = 0.15,
		biasWeight = 0.2,
		ceiling = 327,
		detailWeight = 0.35,
		failureTolerance = 0,
		horizon = 8,
		integrator = "verlet",
		minConfidence = 0.55,
		minThrottle = 0.175,
		regressionSlope = 0.125,
		saturation = 0.8,
		scale = 2.5
	}
	S.features = { "join", "leave", "acquireLock", "releaseLock", "submit", "rebase", "since", "updatePresence", "activeUsers", "stats", "openWith", "editPath", "lockedEdit", "conflictRate", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("session", { id = "arkher.studio.search.session_sync", maxOps = 3847 })
		inst.system = S
		inst.ctx = ctx

		function inst.openWith(users)
			for _, u in ipairs(users) do inst.join(u.id or u, u.role or "editor") end
			return #inst.activeUsers()
		end
		function inst.editPath(userId, path, value)
			return inst.submit(userId, { kind = "set", path = path, value = value })
		end
		function inst.lockedEdit(userId, path, value)
			local ok, holder = inst.acquireLock(userId, path)
			if not ok then return false, holder end
			local applied = inst.editPath(userId, path, value)
			inst.releaseLock(userId, path)
			return applied
		end
		function inst.conflictRate()
			local st = inst.stats()
			return st.conflicts / math.max(1, st.ops + st.conflicts)
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.search.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.openWith({ { id = "probe.a", role = "editor" }, { id = "probe.b", role = "editor" },
			{ id = "probe.v", role = "viewer" } })
		local ok = #inst.activeUsers() == 3
		ok = ok and inst.acquireLock("probe.a", "probe.path")
		ok = ok and inst.editPath("probe.a", "probe.path", 1)
		ok = ok and inst.editPath("probe.b", "probe.path", 2) == false
		ok = ok and inst.editPath("probe.v", "probe.other", 3) == false
		inst.releaseLock("probe.a", "probe.path")
		ok = ok and #inst.since(0) == 1
		local rebased = inst.rebase({ kind = "set", path = "probe.path", value = 9 }, 0)
		ok = ok and rebased ~= nil and rebased.conflict == true
		ok = ok and inst.lockedEdit("probe.b", "probe.other", 4)
		inst.leave("probe.a") inst.leave("probe.b") inst.leave("probe.v")
		return ok and #inst.activeUsers() == 0
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7470">
<Properties>
<string name="Name">B_0306_search_taskgraph</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0306 :: Search And Filter Task Runner
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: taskgraph (incremental background work for the editor)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0306"
	S.key = "arkher.studio.search.task_runner"
	S.name = "Search And Filter Task Runner"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Search And Filter"
	S.aspect = "Task Runner"
	S.kit = "taskgraph"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.search.session_sync" }
	S.tags = { "b", "search", "taskgraph", "studio" }
	S.description = "Search And Filter Task Runner: incremental background work for the editor for the Search And Filter subsystem."
	S.params = {
		backlogLimit = 18,
		baseRadius = 400,
		baseWeight = 0.7,
		bias = 0.1,
		biasWeight = 0.15,
		ceiling = 418,
		detailWeight = 0.5,
		failureTolerance = 0,
		horizon = 3,
		integrator = "euler",
		minConfidence = 0.5,
		minThrottle = 0.1,
		regressionSlope = 0.1,
		saturation = 0.9,
		scale = 1.0
	}
	S.features = { "addTask", "resolveOrder", "inputHash", "run", "invalidate", "artifact", "stats", "installPipeline", "build", "rebuild", "cacheEfficiency", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("taskgraph", { id = "arkher.studio.search.task_runner", incremental = true })
		inst.system = S
		inst.ctx = ctx

		function inst.installPipeline()
			if inst.pipeline then return inst.pipeline end
			local counters = { collect = 0, transform = 0, emit = 0 }
			inst.counters = counters
			inst.addTask("collect", { inputs = { S.key }, fn = function()
				counters.collect = counters.collect + 1
				return { items = 8 + (S.params.horizon or 1) }
			end })
			inst.addTask("transform", { deps = { "collect" }, inputs = { S.params.scale }, fn = function(artifacts)
				counters.transform = counters.transform + 1
				local items = artifacts["collect"].value.items
				return { items = items, weight = items * S.params.scale }
			end })
			inst.addTask("emit", { deps = { "transform" }, inputs = { S.params.ceiling }, fn = function(artifacts)
				counters.emit = counters.emit + 1
				return { payload = math.min(artifacts["transform"].value.weight, S.params.ceiling) }
			end })
			inst.pipeline = { "collect", "transform", "emit" }
			return inst.pipeline
		end
		function inst.build()
			inst.installPipeline()
			return inst.run()
		end
		function inst.rebuild(taskId)
			inst.installPipeline()
			inst.invalidate(taskId or "collect")
			return inst.run()
		end
		function inst.cacheEfficiency()
			local st = inst.stats()
			return st.cacheHits / math.max(1, st.cacheHits + st.artifacts)
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.search.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local first = inst.build()
		local ok = #first == 3 and inst.counters.collect == 1
		ok = ok and #inst.build() == 0
		local third = inst.rebuild("transform")
		ok = ok and #third == 2 and inst.counters.collect == 1 and inst.counters.transform == 2
		ok = ok and inst.artifact("emit") ~= nil and inst.cacheEfficiency() &gt; 0
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7471">
<Properties>
<string name="Name">B_0307_search_ledger</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0307 :: Search And Filter Telemetry
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: ledger (editor interaction journal and histograms)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0307"
	S.key = "arkher.studio.search.telemetry"
	S.name = "Search And Filter Telemetry"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Search And Filter"
	S.aspect = "Telemetry"
	S.kit = "ledger"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.search.task_runner" }
	S.tags = { "b", "search", "ledger", "studio" }
	S.description = "Search And Filter Telemetry: editor interaction journal and histograms for the Search And Filter subsystem."
	S.params = {
		backlogLimit = 16,
		baseRadius = 320,
		baseWeight = 0.78,
		bias = 0.08,
		biasWeight = 0.13,
		ceiling = 496,
		detailWeight = 0.48,
		failureTolerance = 3,
		horizon = 1,
		integrator = "euler",
		minConfidence = 0.48,
		minThrottle = 0.24,
		regressionSlope = 0.09,
		saturation = 0.73,
		scale = 3.8
	}
	S.features = { "write", "observe", "query", "seal", "verifySeal", "percentileBucket", "stats", "record", "timing", "digest", "recent", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("ledger", { id = "arkher.studio.search.telemetry", capacity = 176 })
		inst.system = S
		inst.ctx = ctx

	function inst.record(operation, payload) return inst.write(operation, payload) end
	function inst.timing(ms) return inst.observe(ms) end
	function inst.digest()
		return { seal = inst.seal(), written = inst.written, p95 = inst.percentileBucket(95) }
	end
	function inst.recent(kind, limit) return inst.query(kind, limit or 10) end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.search.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.record("probe", { v = 1 })
		inst.record("probe", { v = 2 })
		inst.timing(4) inst.timing(40)
		local d = inst.digest()
		return d.written == 2 and inst.verifySeal() and #inst.recent("probe") == 2
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7472">
<Properties>
<string name="Name">B_0308_search_recovery</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0308 :: Search And Filter Recovery
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: recovery (crash-safe checkpointing of editor state)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0308"
	S.key = "arkher.studio.search.recovery"
	S.name = "Search And Filter Recovery"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Search And Filter"
	S.aspect = "Recovery"
	S.kit = "recovery"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.search.telemetry" }
	S.tags = { "b", "search", "recovery", "studio" }
	S.description = "Search And Filter Recovery: crash-safe checkpointing of editor state for the Search And Filter subsystem."
	S.params = {
		backlogLimit = 14,
		baseRadius = 400,
		baseWeight = 0.76,
		bias = 0.06,
		biasWeight = 0.11,
		ceiling = 110,
		detailWeight = 0.26,
		failureTolerance = 1,
		horizon = 7,
		integrator = "euler",
		minConfidence = 0.46,
		minThrottle = 0.13,
		regressionSlope = 0.08,
		saturation = 0.71,
		scale = 1.6
	}
	S.features = { "snapshot", "verify", "rollback", "lastGood", "protect", "stats", "guardedApply", "checkpoint", "restoreLast", "healthy", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("recovery", { id = "arkher.studio.search.recovery", maxSnapshots = 18, strategy = "rollback" })
		inst.system = S
		inst.ctx = ctx

	function inst.guardedApply(state, mutate)
		return inst.protect(mutate, state)
	end
	function inst.checkpoint(label, state) return inst.snapshot(label, state) end
	function inst.restoreLast()
		local snap = inst.lastGood()
		if not snap then return nil end
		return snap.state, snap.label
	end
	function inst.healthy() return inst.stats().failures &lt;= S.params.failureTolerance end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.search.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local state = { hp = 10 }
		inst.checkpoint("probe", state)
		local result, ok = inst.guardedApply(state, function() error("probe failure") end)
		local restored = inst.restoreLast()
		return ok == false and result.hp == 10 and restored ~= nil
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7473">
<Properties>
<string name="Name">B_0309_palette_document</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0309 :: Command Palette Document Model
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: document (transactional editing state with dirty tracking and revisions)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0309"
	S.key = "arkher.studio.palette.document_model"
	S.name = "Command Palette Document Model"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Command Palette"
	S.aspect = "Document Model"
	S.kit = "document"
	S.version = "1.0.0"
	S.deps = {  }
	S.tags = { "b", "palette", "document", "studio" }
	S.description = "Command Palette Document Model: transactional editing state with dirty tracking and revisions for the Command Palette subsystem."
	S.params = {
		backlogLimit = 38,
		baseRadius = 560,
		baseWeight = 0.5,
		bias = 0.3,
		biasWeight = 0.15,
		ceiling = 566,
		detailWeight = 0.3,
		failureTolerance = 0,
		horizon = 7,
		integrator = "euler",
		minConfidence = 0.7,
		minThrottle = 0.15,
		regressionSlope = 0.1,
		saturation = 0.7,
		scale = 2.0
	}
	S.features = { "get", "set", "begin", "commit", "rollback", "validate", "isDirty", "markSaved", "serialize", "deserialize", "checksum", "stats", "transact", "applyPatch", "fieldNames", "transactionLabels", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("document", { id = "arkher.studio.palette.document_model", initial = { profile = { quality = 0.50 }, meta = { revision = 0 } } })
		inst.system = S
		inst.ctx = ctx

		function inst.transact(label, fn)
			inst.begin(label)
			local ok, err = pcall(fn)
			if not ok then inst.rollback() return false, err end
			inst.commit()
			return true
		end
		function inst.applyPatch(patch)
			local n = 0
			for path, value in pairs(patch) do
				if inst.set(path, value) then n = n + 1 end
			end
			return n
		end
		function inst.fieldNames()
			local out = {}
			for k in pairs(inst.data) do out[#out + 1] = tostring(k) end
			table.sort(out)
			return out
		end
		function inst.transactionLabels()
			local out = {}
			for i, h in ipairs(inst.history) do out[i] = h.label end
			return out
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.palette.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local ok = inst.transact("probe", function()
			inst.set("probe.alpha", 42)
			inst.set("probe.beta", "on")
		end)
		ok = ok and inst.get("probe.alpha") == 42 and inst.get("probe.beta") == "on"
		inst.begin("discard")
		inst.set("probe.alpha", 7)
		inst.rollback()
		ok = ok and inst.get("probe.alpha") == 42
		ok = ok and type(inst.checksum()) == "number" and #inst.fieldNames() &gt;= 1
		inst.markSaved()
		return ok and inst.isDirty() == false
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7474">
<Properties>
<string name="Name">B_0310_palette_commands</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0310 :: Command Palette Command Stack
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: commands (undoable operations with grouping and coalescing)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0310"
	S.key = "arkher.studio.palette.command_stack"
	S.name = "Command Palette Command Stack"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Command Palette"
	S.aspect = "Command Stack"
	S.kit = "commands"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.palette.document_model" }
	S.tags = { "b", "palette", "commands", "studio" }
	S.description = "Command Palette Command Stack: undoable operations with grouping and coalescing for the Command Palette subsystem."
	S.params = {
		backlogLimit = 40,
		baseRadius = 160,
		baseWeight = 0.72,
		bias = 0.32,
		biasWeight = 0.17,
		ceiling = 120,
		detailWeight = 0.32,
		failureTolerance = 2,
		horizon = 1,
		integrator = "euler",
		minConfidence = 0.72,
		minThrottle = 0.16,
		regressionSlope = 0.11,
		saturation = 0.92,
		scale = 2.2
	}
	S.features = { "execute", "beginGroup", "endGroup", "undo", "redo", "canUndo", "canRedo", "tick", "historyLabels", "clear", "stats", "push", "undoAll", "redoAll", "depth", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("commands", { id = "arkher.studio.palette.command_stack", limit = 184, coalesceWindow = 0.52 })
		inst.system = S
		inst.ctx = ctx

		function inst.push(label, doFn, undoFn, coalesceKey)
			return inst.execute({ label = label, doFn = doFn, undoFn = undoFn, coalesceKey = coalesceKey })
		end
		function inst.undoAll()
			local n = 0
			while inst.canUndo() do
				if not inst.undo() then break end
				n = n + 1
			end
			return n
		end
		function inst.redoAll()
			local n = 0
			while inst.canRedo() do
				if not inst.redo() then break end
				n = n + 1
			end
			return n
		end
		function inst.depth() return #inst.undoStack, #inst.redoStack end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.palette.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.clear()
		local value = 0
		for i = 1, 3 do
			inst.push("probe." .. i, function() value = value + i end, function() value = value - i end)
		end
		local ok = value == 6
		ok = ok and inst.undoAll() == 3 and value == 0
		ok = ok and inst.redoAll() == 3 and value == 6
		inst.undoAll()
		inst.clear()
		return ok and inst.canUndo() == false
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7475">
<Properties>
<string name="Name">B_0311_palette_selection</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0311 :: Command Palette Selection Model
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: selection (multi-selection with primary item and filters)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0311"
	S.key = "arkher.studio.palette.selection_model"
	S.name = "Command Palette Selection Model"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Command Palette"
	S.aspect = "Selection Model"
	S.kit = "selection"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.palette.command_stack" }
	S.tags = { "b", "palette", "selection", "studio" }
	S.description = "Command Palette Selection Model: multi-selection with primary item and filters for the Command Palette subsystem."
	S.params = {
		backlogLimit = 15,
		baseRadius = 600,
		baseWeight = 0.57,
		bias = 0.07,
		biasWeight = 0.12,
		ceiling = 151,
		detailWeight = 0.67,
		failureTolerance = 2,
		horizon = 8,
		integrator = "verlet",
		minConfidence = 0.47,
		minThrottle = 0.185,
		regressionSlope = 0.085,
		saturation = 0.77,
		scale = 2.7
	}
	S.features = { "contains", "add", "remove", "toggle", "set", "clear", "all", "count", "addFilter", "filtered", "stats", "selectWhere", "invert", "primaryOr", "summary", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("selection", { id = "arkher.studio.palette.selection_model", maxItems = 1623 })
		inst.system = S
		inst.ctx = ctx

		function inst.selectWhere(ids, predicate)
			inst.clear()
			local n = 0
			for _, id in ipairs(ids) do
				if predicate(id) and inst.add(id) then n = n + 1 end
			end
			return n
		end
		function inst.invert(universe)
			local current = {}
			for _, id in ipairs(inst.all()) do current[id] = true end
			inst.clear()
			for _, id in ipairs(universe) do
				if not current[id] then inst.add(id) end
			end
			return inst.count()
		end
		function inst.primaryOr(default) return inst.primary or default end
		function inst.summary()
			local filters = 0
			for _ in pairs(inst.filters) do filters = filters + 1 end
			return { count = inst.count(), primary = inst.primary, filters = filters, items = inst.all() }
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.palette.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.clear()
		local universe = { "probe.a", "probe.b", "probe.c", "probe.d" }
		local n = inst.selectWhere(universe, function(id) return id ~= "probe.c" end)
		local ok = n == 3 and inst.contains("probe.a") and inst.contains("probe.c") == false
		ok = ok and inst.invert(universe) == 1 and inst.contains("probe.c")
		ok = ok and inst.summary().count == 1 and inst.primaryOr("none") ~= "none"
		inst.clear()
		return ok and inst.count() == 0
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7476">
<Properties>
<string name="Name">B_0312_palette_layout</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0312 :: Command Palette Panel Layout
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: layout (dockable panel tree with persistence)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0312"
	S.key = "arkher.studio.palette.panel_layout"
	S.name = "Command Palette Panel Layout"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Command Palette"
	S.aspect = "Panel Layout"
	S.kit = "layout"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.palette.selection_model" }
	S.tags = { "b", "palette", "layout", "studio" }
	S.description = "Command Palette Panel Layout: dockable panel tree with persistence for the Command Palette subsystem."
	S.params = {
		backlogLimit = 39,
		baseRadius = 600,
		baseWeight = 0.81,
		bias = 0.31,
		biasWeight = 0.16,
		ceiling = 399,
		detailWeight = 0.31,
		failureTolerance = 1,
		horizon = 8,
		integrator = "verlet",
		minConfidence = 0.71,
		minThrottle = 0.155,
		regressionSlope = 0.105,
		saturation = 0.76,
		scale = 2.1
	}
	S.features = { "addPanel", "split", "dock", "focus", "setVisible", "visiblePanels", "save", "restore", "stats", "installDefault", "toggle", "panelIds", "workspacePreset", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("layout", { id = "arkher.studio.palette.panel_layout", minRatio = 0.16 })
		inst.system = S
		inst.ctx = ctx

		function inst.installDefault()
			local ids = { "main", "side", "bottom" }
			for _, id in ipairs(ids) do
				if not inst.panels[id] then inst.addPanel(id, { title = S.name .. " " .. id }) end
			end
			inst.focus("main")
			return #ids
		end
		function inst.toggle(panelId)
			local p = inst.panels[panelId]
			if not p then return false end
			return inst.setVisible(panelId, not p.visible)
		end
		function inst.panelIds()
			local out = {}
			for id in pairs(inst.panels) do out[#out + 1] = id end
			table.sort(out)
			return out
		end
		function inst.workspacePreset(name)
			inst.installDefault()
			local focus = (name == "focus")
			inst.setVisible("side", not focus)
			inst.setVisible("bottom", not focus)
			return #inst.visiblePanels()
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.palette.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.installDefault()
		local ok = #inst.panelIds() &gt;= 3 and #inst.visiblePanels() &gt;= 3
		local blob = inst.save()
		ok = ok and type(blob) == "string" and #blob &gt; 2
		ok = ok and inst.workspacePreset("focus") == 1
		ok = ok and inst.toggle("side") and #inst.visiblePanels() == 2
		ok = ok and inst.workspacePreset("full") == 3
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7477">
<Properties>
<string name="Name">B_0313_palette_widget</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0313 :: Command Palette Widget Surface
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: widget (retained-mode UI tree with data bindings)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0313"
	S.key = "arkher.studio.palette.widget_surface"
	S.name = "Command Palette Widget Surface"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Command Palette"
	S.aspect = "Widget Surface"
	S.kit = "widget"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.palette.panel_layout" }
	S.tags = { "b", "palette", "widget", "studio" }
	S.description = "Command Palette Widget Surface: retained-mode UI tree with data bindings for the Command Palette subsystem."
	S.params = {
		backlogLimit = 47,
		baseRadius = 280,
		baseWeight = 0.79,
		bias = 0.39,
		biasWeight = 0.24,
		ceiling = 439,
		detailWeight = 0.59,
		failureTolerance = 4,
		horizon = 8,
		integrator = "verlet",
		minConfidence = 0.79,
		minThrottle = 0.145,
		regressionSlope = 0.145,
		saturation = 0.74,
		scale = 1.9
	}
	S.features = { "create", "setProp", "bind", "update", "render", "destroy", "count", "stats", "buildSurface", "setModel", "repaint", "tree", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("widget", { id = "arkher.studio.palette.widget_surface", theme = "dark", scale = 1.04 })
		inst.system = S
		inst.ctx = ctx

		inst.model = { title = S.name, value = 0, status = "idle" }
		function inst.buildSurface()
			if inst.rootId then return inst.rootId end
			inst.rootId = inst.create("Frame", { name = S.key, scale = inst.scale })
			inst.titleId = inst.create("Label", { text = "" }, inst.rootId)
			inst.valueId = inst.create("Label", { text = "" }, inst.rootId)
			inst.bind(inst.titleId, "text", function() return inst.model.title end)
			inst.bind(inst.valueId, "text", function()
				return string.format("%s %.2f", tostring(inst.model.status), inst.model.value)
			end)
			return inst.rootId
		end
		function inst.setModel(key, value)
			inst.model[key] = value
			return inst.update()
		end
		function inst.repaint()
			inst.update()
			return inst.render()
		end
		function inst.tree()
			local out = {}
			for id, node in pairs(inst.nodes) do out[#out + 1] = { id = id, class = node.class } end
			table.sort(out, function(a, b) return a.id &lt; b.id end)
			return out
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.palette.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.buildSurface()
		local painted = inst.repaint()
		local ok = painted &gt;= 3 and #inst.tree() &gt;= 3
		ok = ok and inst.setModel("value", 12.5) &gt;= 1
		ok = ok and inst.repaint() &gt;= 1
		ok = ok and inst.repaint() == 0
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7478">
<Properties>
<string name="Name">B_0314_palette_inspector</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0314 :: Command Palette Property Inspector
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: inspector (reflection-driven property editing)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0314"
	S.key = "arkher.studio.palette.property_inspector"
	S.name = "Command Palette Property Inspector"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Command Palette"
	S.aspect = "Property Inspector"
	S.kit = "inspector"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.palette.widget_surface" }
	S.tags = { "b", "palette", "inspector", "studio" }
	S.description = "Command Palette Property Inspector: reflection-driven property editing for the Command Palette subsystem."
	S.params = {
		backlogLimit = 42,
		baseRadius = 240,
		baseWeight = 0.84,
		bias = 0.34,
		biasWeight = 0.19,
		ceiling = 506,
		detailWeight = 0.34,
		failureTolerance = 4,
		horizon = 3,
		integrator = "euler",
		minConfidence = 0.74,
		minThrottle = 0.17,
		regressionSlope = 0.12,
		saturation = 0.79,
		scale = 2.4
	}
	S.features = { "attach", "fields", "layout", "edit", "apply", "revert", "multiSelect", "applyToAll", "stats", "ensureType", "attachDefault", "editMany", "pending", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("inspector", { id = "arkher.studio.palette.property_inspector" })
		inst.system = S
		inst.ctx = ctx

		function inst.ensureType()
			local Reflection = A:import("arkher/kernel/reflection")
			if not Reflection.getType(S.key) then
				Reflection.defineType(S.key, { fields = {
					intensity = { type = "number", default = S.params.baseWeight, min = 0, max = 1,
						editor = { group = "Tuning", order = 1 } },
					mode = { type = "string", default = "auto", editor = { group = "Tuning", order = 2 } },
					enabled = { type = "boolean", default = true, editor = { group = "General", order = 3 } } } })
			end
			return S.key
		end
		function inst.attachDefault(target)
			inst.ensureType()
			target = target or { intensity = S.params.baseWeight, mode = "auto", enabled = true }
			inst.attach(target, S.key)
			return target
		end
		function inst.editMany(patch)
			local applied, rejected = 0, 0
			for field, value in pairs(patch) do
				if inst.edit(field, value) then applied = applied + 1 else rejected = rejected + 1 end
			end
			return applied, rejected
		end
		function inst.pending()
			local out = {}
			for k, v in pairs(inst.edits) do out[#out + 1] = { field = k, value = v } end
			table.sort(out, function(a, b) return a.field &lt; b.field end)
			return out
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.palette.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local target = inst.attachDefault({ intensity = 0.1, mode = "auto", enabled = true })
		local applied, rejected = inst.editMany({ intensity = 9.0, mode = "manual" })
		local ok = applied == 2 and rejected == 0 and #inst.pending() == 2
		ok = ok and inst.apply() == 2 and target.intensity == 1 and target.mode == "manual"
		ok = ok and #inst.fields() == 3
		local common = inst.multiSelect({ { intensity = 0.2 }, { intensity = 0.9 } })
		return ok and common.intensity == "&lt;mixed&gt;"
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7479">
<Properties>
<string name="Name">B_0315_palette_nodegraph</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0315 :: Command Palette Node Editor
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: nodegraph (typed node graph authoring and compilation)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0315"
	S.key = "arkher.studio.palette.node_editor"
	S.name = "Command Palette Node Editor"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Command Palette"
	S.aspect = "Node Editor"
	S.kit = "nodegraph"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.palette.property_inspector" }
	S.tags = { "b", "palette", "nodegraph", "studio" }
	S.description = "Command Palette Node Editor: typed node graph authoring and compilation for the Command Palette subsystem."
	S.params = {
		backlogLimit = 29,
		baseRadius = 200,
		baseWeight = 0.71,
		bias = 0.21,
		biasWeight = 0.06,
		ceiling = 573,
		detailWeight = 0.21,
		failureTolerance = 1,
		horizon = 6,
		integrator = "verlet",
		minConfidence = 0.61,
		minThrottle = 0.105,
		regressionSlope = 0.055,
		saturation = 0.91,
		scale = 1.1
	}
	S.features = { "defineType", "addNode", "connect", "topoOrder", "evaluate", "compile", "validate", "stats", "installStdNodes", "buildDefault", "evaluateDefault", "compileDefault", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("nodegraph", { id = "arkher.studio.palette.node_editor" })
		inst.system = S
		inst.ctx = ctx

		function inst.installStdNodes()
			if inst.types["Const"] then return inst end
			inst.defineType("Const", { inputs = {}, outputs = { { name = "out", type = "number" } },
				fn = function(_, props) return { out = props.value or 0 } end,
				emit = function(id, args, props) return string.format("local v%d_out = %.6f", id, props.value or 0) end })
			inst.defineType("Scale", { inputs = { { name = "a", type = "number", required = true } },
				outputs = { { name = "out", type = "number" } },
				fn = function(inputs, props) return { out = (inputs.a or 0) * (props.factor or 1) } end,
				emit = function(id, args, props)
					local src = "0"
					for _, arg in ipairs(args) do src = string.match(arg, "=%s*(.+)$") or src end
					return string.format("local v%d_out = (%s) * %.6f", id, src, props.factor or 1)
				end })
			inst.defineType("Sum", { inputs = { { name = "a", type = "number", required = true },
					{ name = "b", type = "number", required = true } },
				outputs = { { name = "out", type = "number" } },
				fn = function(inputs) return { out = (inputs.a or 0) + (inputs.b or 0) } end,
				emit = function(id, args)
					local parts = {}
					for _, arg in ipairs(args) do parts[#parts + 1] = string.match(arg, "=%s*(.+)$") or "0" end
					if #parts == 0 then parts[1] = "0" end
					return string.format("local v%d_out = %s", id, table.concat(parts, " + "))
				end })
			return inst
		end
		function inst.buildDefault()
			if inst.defaultGraph then return inst.defaultGraph end
			inst.installStdNodes()
			local a = inst.addNode("Const", { value = S.params.baseWeight })
			local b = inst.addNode("Const", { value = S.params.detailWeight })
			local scaled = inst.addNode("Scale", { factor = S.params.scale })
			local sum = inst.addNode("Sum", {})
			inst.connect(a, "out", scaled, "a")
			inst.connect(scaled, "out", sum, "a")
			inst.connect(b, "out", sum, "b")
			inst.defaultGraph = { a = a, b = b, scaled = scaled, sum = sum }
			return inst.defaultGraph
		end
		function inst.evaluateDefault()
			local ids = inst.buildDefault()
			local values, err = inst.evaluate({})
			if not values then return nil, err end
			return values[ids.sum .. ":out"]
		end
		function inst.compileDefault(name)
			inst.buildDefault()
			return inst.compile(name or "arkherGraph")
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.palette.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local expected = S.params.baseWeight * S.params.scale + S.params.detailWeight
		local value = inst.evaluateDefault()
		local ok = type(value) == "number" and math.abs(value - expected) &lt; 1e-6
		local src = inst.compileDefault("probeGraph")
		ok = ok and type(src) == "string" and string.find(src, "local v", 1, true) ~= nil
		ok = ok and inst.validate() and #inst.topoOrder() == 4
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7480">
<Properties>
<string name="Name">B_0316_palette_registry</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0316 :: Command Palette Registry
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: registry (catalogued editor records, tags and queries)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0316"
	S.key = "arkher.studio.palette.registry"
	S.name = "Command Palette Registry"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Command Palette"
	S.aspect = "Registry"
	S.kit = "registry"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.palette.node_editor" }
	S.tags = { "b", "palette", "registry", "studio" }
	S.description = "Command Palette Registry: catalogued editor records, tags and queries for the Command Palette subsystem."
	S.params = {
		backlogLimit = 29,
		baseRadius = 200,
		baseWeight = 0.91,
		bias = 0.21,
		biasWeight = 0.06,
		ceiling = 269,
		detailWeight = 0.21,
		failureTolerance = 1,
		horizon = 6,
		integrator = "verlet",
		minConfidence = 0.61,
		minThrottle = 0.105,
		regressionSlope = 0.055,
		saturation = 0.86,
		scale = 1.1
	}
	S.features = { "define", "get", "has", "remove", "withTag", "query", "ids", "snapshot", "restore", "stats", "upsert", "bulkDefine", "tally", "export", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("registry", { id = "arkher.studio.palette.registry" })
		inst.system = S
		inst.ctx = ctx

	function inst.upsert(id, data, tags) return inst.define(id, data, tags) end
	function inst.bulkDefine(list)
		local n = 0
		for _, rec in ipairs(list) do
			if inst.define(rec.id, rec.data, rec.tags) then n = n + 1 end
		end
		return n
	end
	function inst.tally()
		local out = {}
		for _, id in ipairs(inst.ids()) do
			for _, tag in ipairs(inst.records[id].tags) do out[tag] = (out[tag] or 0) + 1 end
		end
		return out
	end
	function inst.export() return { area = S.area, count = inst.stats().count, records = inst.snapshot() } end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.palette.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.define("probe.a", { weight = 1 }, { "probe" })
		inst.define("probe.b", { weight = 2 }, { "probe", "heavy" })
		local ok = inst.stats().count == 2 and #inst.withTag("probe") == 2 and inst.get("probe.b").weight == 2
		inst.remove("probe.a") inst.remove("probe.b")
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7481">
<Properties>
<string name="Name">B_0317_palette_pipeline</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0317 :: Command Palette Tool Pipeline
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: pipeline (staged tool execution with isolation)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0317"
	S.key = "arkher.studio.palette.tool_pipeline"
	S.name = "Command Palette Tool Pipeline"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Command Palette"
	S.aspect = "Tool Pipeline"
	S.kit = "pipeline"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.palette.registry" }
	S.tags = { "b", "palette", "pipeline", "studio" }
	S.description = "Command Palette Tool Pipeline: staged tool execution with isolation for the Command Palette subsystem."
	S.params = {
		backlogLimit = 36,
		baseRadius = 160,
		baseWeight = 0.88,
		bias = 0.28,
		biasWeight = 0.13,
		ceiling = 228,
		detailWeight = 0.68,
		failureTolerance = 3,
		horizon = 5,
		integrator = "euler",
		minConfidence = 0.68,
		minThrottle = 0.19,
		regressionSlope = 0.09,
		saturation = 0.83,
		scale = 2.8
	}
	S.features = { "addStage", "disable", "enable", "run", "stageNames", "stats", "installDefaults", "process", "benchmark", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("pipeline", { id = "arkher.studio.palette.tool_pipeline", budgetMs = 5.00 })
		inst.system = S
		inst.ctx = ctx

	function inst.installDefaults()
		inst.addStage("normalize", function(v) 
			if type(v) == "number" then return math.max(0, v) end
			return v
		end)
		inst.addStage("scale", function(v)
			if type(v) == "number" then return v * S.params.scale end
			return v
		end)
		inst.addStage("clamp", function(v)
			if type(v) == "number" then return math.min(v, S.params.ceiling) end
			return v
		end)
		return inst
	end
	function inst.process(value, ctx) return inst.run(value, ctx) end
	function inst.benchmark(iterations)
		local total = 0
		for i = 1, (iterations or 32) do
			local v = inst.run(i)
			if type(v) == "number" then total = total + v end
		end
		return total / math.max(1, iterations or 32)
	end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.palette.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.installDefaults()
		local out = inst.run(-4)
		local ok = out == 0
		local out2 = inst.run(2)
		ok = ok and out2 == math.min(2 * S.params.scale, S.params.ceiling)
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7482">
<Properties>
<string name="Name">B_0318_palette_cache</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0318 :: Command Palette Preview Cache
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: cache (reuse of expensive editor previews)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0318"
	S.key = "arkher.studio.palette.preview_cache"
	S.name = "Command Palette Preview Cache"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Command Palette"
	S.aspect = "Preview Cache"
	S.kit = "cache"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.palette.tool_pipeline" }
	S.tags = { "b", "palette", "cache", "studio" }
	S.description = "Command Palette Preview Cache: reuse of expensive editor previews for the Command Palette subsystem."
	S.params = {
		backlogLimit = 22,
		baseRadius = 240,
		baseWeight = 0.64,
		bias = 0.14,
		biasWeight = 0.19,
		ceiling = 142,
		detailWeight = 0.34,
		failureTolerance = 4,
		horizon = 7,
		integrator = "euler",
		minConfidence = 0.54,
		minThrottle = 0.17,
		regressionSlope = 0.12,
		saturation = 0.84,
		scale = 2.4
	}
	S.features = { "set", "get", "remove", "evict", "tick", "hitRate", "warm", "clear", "stats", "memoize", "prefetch", "pressure", "shrinkTo", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("cache", { id = "arkher.studio.palette.preview_cache", policy = "ttl", capacity = 462, ttl = 4 })
		inst.system = S
		inst.ctx = ctx

	function inst.memoize(fn)
		return function(key, ...)
			local hit = inst.get(key)
			if hit ~= nil then return hit, true end
			local value = fn(key, ...)
			inst.set(key, value)
			return value, false
		end
	end
	function inst.prefetch(keys, producer)
		local n = 0
		for _, k in ipairs(keys) do
			if inst.get(k) == nil then inst.set(k, producer(k)) n = n + 1 end
		end
		return n
	end
	function inst.pressure() return inst.stats().size / math.max(1, inst.capacity) end
	function inst.shrinkTo(capacity)
		inst.capacity = math.max(1, capacity)
		return inst.evict()
	end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.palette.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local calls = 0
		local memo = inst.memoize(function(k) calls = calls + 1 return k * 2 end)
		local v1 = memo(21)
		local v2, cached = memo(21)
		inst.clear()
		return v1 == 42 and v2 == 42 and cached == true and calls == 1
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7483">
<Properties>
<string name="Name">B_0319_palette_session</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0319 :: Command Palette Session Sync
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: session (multi-user editing of this editor surface)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0319"
	S.key = "arkher.studio.palette.session_sync"
	S.name = "Command Palette Session Sync"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Command Palette"
	S.aspect = "Session Sync"
	S.kit = "session"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.palette.preview_cache" }
	S.tags = { "b", "palette", "session", "studio" }
	S.description = "Command Palette Session Sync: multi-user editing of this editor surface for the Command Palette subsystem."
	S.params = {
		backlogLimit = 35,
		baseRadius = 600,
		baseWeight = 0.87,
		bias = 0.27,
		biasWeight = 0.12,
		ceiling = 363,
		detailWeight = 0.67,
		failureTolerance = 2,
		horizon = 4,
		integrator = "verlet",
		minConfidence = 0.67,
		minThrottle = 0.185,
		regressionSlope = 0.085,
		saturation = 0.82,
		scale = 2.7
	}
	S.features = { "join", "leave", "acquireLock", "releaseLock", "submit", "rebase", "since", "updatePresence", "activeUsers", "stats", "openWith", "editPath", "lockedEdit", "conflictRate", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("session", { id = "arkher.studio.palette.session_sync", maxOps = 1835 })
		inst.system = S
		inst.ctx = ctx

		function inst.openWith(users)
			for _, u in ipairs(users) do inst.join(u.id or u, u.role or "editor") end
			return #inst.activeUsers()
		end
		function inst.editPath(userId, path, value)
			return inst.submit(userId, { kind = "set", path = path, value = value })
		end
		function inst.lockedEdit(userId, path, value)
			local ok, holder = inst.acquireLock(userId, path)
			if not ok then return false, holder end
			local applied = inst.editPath(userId, path, value)
			inst.releaseLock(userId, path)
			return applied
		end
		function inst.conflictRate()
			local st = inst.stats()
			return st.conflicts / math.max(1, st.ops + st.conflicts)
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.palette.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.openWith({ { id = "probe.a", role = "editor" }, { id = "probe.b", role = "editor" },
			{ id = "probe.v", role = "viewer" } })
		local ok = #inst.activeUsers() == 3
		ok = ok and inst.acquireLock("probe.a", "probe.path")
		ok = ok and inst.editPath("probe.a", "probe.path", 1)
		ok = ok and inst.editPath("probe.b", "probe.path", 2) == false
		ok = ok and inst.editPath("probe.v", "probe.other", 3) == false
		inst.releaseLock("probe.a", "probe.path")
		ok = ok and #inst.since(0) == 1
		local rebased = inst.rebase({ kind = "set", path = "probe.path", value = 9 }, 0)
		ok = ok and rebased ~= nil and rebased.conflict == true
		ok = ok and inst.lockedEdit("probe.b", "probe.other", 4)
		inst.leave("probe.a") inst.leave("probe.b") inst.leave("probe.v")
		return ok and #inst.activeUsers() == 0
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7484">
<Properties>
<string name="Name">B_0320_palette_taskgraph</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0320 :: Command Palette Task Runner
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: taskgraph (incremental background work for the editor)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0320"
	S.key = "arkher.studio.palette.task_runner"
	S.name = "Command Palette Task Runner"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Command Palette"
	S.aspect = "Task Runner"
	S.kit = "taskgraph"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.palette.session_sync" }
	S.tags = { "b", "palette", "taskgraph", "studio" }
	S.description = "Command Palette Task Runner: incremental background work for the editor for the Command Palette subsystem."
	S.params = {
		backlogLimit = 23,
		baseRadius = 280,
		baseWeight = 0.65,
		bias = 0.15,
		biasWeight = 0.2,
		ceiling = 471,
		detailWeight = 0.35,
		failureTolerance = 0,
		horizon = 8,
		integrator = "verlet",
		minConfidence = 0.55,
		minThrottle = 0.175,
		regressionSlope = 0.125,
		saturation = 0.85,
		scale = 2.5
	}
	S.features = { "addTask", "resolveOrder", "inputHash", "run", "invalidate", "artifact", "stats", "installPipeline", "build", "rebuild", "cacheEfficiency", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("taskgraph", { id = "arkher.studio.palette.task_runner", incremental = true })
		inst.system = S
		inst.ctx = ctx

		function inst.installPipeline()
			if inst.pipeline then return inst.pipeline end
			local counters = { collect = 0, transform = 0, emit = 0 }
			inst.counters = counters
			inst.addTask("collect", { inputs = { S.key }, fn = function()
				counters.collect = counters.collect + 1
				return { items = 8 + (S.params.horizon or 1) }
			end })
			inst.addTask("transform", { deps = { "collect" }, inputs = { S.params.scale }, fn = function(artifacts)
				counters.transform = counters.transform + 1
				local items = artifacts["collect"].value.items
				return { items = items, weight = items * S.params.scale }
			end })
			inst.addTask("emit", { deps = { "transform" }, inputs = { S.params.ceiling }, fn = function(artifacts)
				counters.emit = counters.emit + 1
				return { payload = math.min(artifacts["transform"].value.weight, S.params.ceiling) }
			end })
			inst.pipeline = { "collect", "transform", "emit" }
			return inst.pipeline
		end
		function inst.build()
			inst.installPipeline()
			return inst.run()
		end
		function inst.rebuild(taskId)
			inst.installPipeline()
			inst.invalidate(taskId or "collect")
			return inst.run()
		end
		function inst.cacheEfficiency()
			local st = inst.stats()
			return st.cacheHits / math.max(1, st.cacheHits + st.artifacts)
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.palette.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local first = inst.build()
		local ok = #first == 3 and inst.counters.collect == 1
		ok = ok and #inst.build() == 0
		local third = inst.rebuild("transform")
		ok = ok and #third == 2 and inst.counters.collect == 1 and inst.counters.transform == 2
		ok = ok and inst.artifact("emit") ~= nil and inst.cacheEfficiency() &gt; 0
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7485">
<Properties>
<string name="Name">B_0321_palette_ledger</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0321 :: Command Palette Telemetry
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: ledger (editor interaction journal and histograms)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0321"
	S.key = "arkher.studio.palette.telemetry"
	S.name = "Command Palette Telemetry"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Command Palette"
	S.aspect = "Telemetry"
	S.kit = "ledger"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.palette.task_runner" }
	S.tags = { "b", "palette", "ledger", "studio" }
	S.description = "Command Palette Telemetry: editor interaction journal and histograms for the Command Palette subsystem."
	S.params = {
		backlogLimit = 9,
		baseRadius = 520,
		baseWeight = 0.51,
		bias = 0.01,
		biasWeight = 0.06,
		ceiling = 321,
		detailWeight = 0.41,
		failureTolerance = 1,
		horizon = 2,
		integrator = "verlet",
		minConfidence = 0.41,
		minThrottle = 0.205,
		regressionSlope = 0.055,
		saturation = 0.71,
		scale = 3.1
	}
	S.features = { "write", "observe", "query", "seal", "verifySeal", "percentileBucket", "stats", "record", "timing", "digest", "recent", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("ledger", { id = "arkher.studio.palette.telemetry", capacity = 641 })
		inst.system = S
		inst.ctx = ctx

	function inst.record(operation, payload) return inst.write(operation, payload) end
	function inst.timing(ms) return inst.observe(ms) end
	function inst.digest()
		return { seal = inst.seal(), written = inst.written, p95 = inst.percentileBucket(95) }
	end
	function inst.recent(kind, limit) return inst.query(kind, limit or 10) end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.palette.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.record("probe", { v = 1 })
		inst.record("probe", { v = 2 })
		inst.timing(4) inst.timing(40)
		local d = inst.digest()
		return d.written == 2 and inst.verifySeal() and #inst.recent("probe") == 2
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7486">
<Properties>
<string name="Name">B_0322_palette_recovery</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0322 :: Command Palette Recovery
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: recovery (crash-safe checkpointing of editor state)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0322"
	S.key = "arkher.studio.palette.recovery"
	S.name = "Command Palette Recovery"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Command Palette"
	S.aspect = "Recovery"
	S.kit = "recovery"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.palette.telemetry" }
	S.tags = { "b", "palette", "recovery", "studio" }
	S.description = "Command Palette Recovery: crash-safe checkpointing of editor state for the Command Palette subsystem."
	S.params = {
		backlogLimit = 47,
		baseRadius = 440,
		baseWeight = 0.89,
		bias = 0.39,
		biasWeight = 0.24,
		ceiling = 199,
		detailWeight = 0.39,
		failureTolerance = 4,
		horizon = 8,
		integrator = "verlet",
		minConfidence = 0.79,
		minThrottle = 0.195,
		regressionSlope = 0.145,
		saturation = 0.84,
		scale = 2.9
	}
	S.features = { "snapshot", "verify", "rollback", "lastGood", "protect", "stats", "guardedApply", "checkpoint", "restoreLast", "healthy", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("recovery", { id = "arkher.studio.palette.recovery", maxSnapshots = 11, strategy = "rollback" })
		inst.system = S
		inst.ctx = ctx

	function inst.guardedApply(state, mutate)
		return inst.protect(mutate, state)
	end
	function inst.checkpoint(label, state) return inst.snapshot(label, state) end
	function inst.restoreLast()
		local snap = inst.lastGood()
		if not snap then return nil end
		return snap.state, snap.label
	end
	function inst.healthy() return inst.stats().failures &lt;= S.params.failureTolerance end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.palette.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local state = { hp = 10 }
		inst.checkpoint("probe", state)
		local result, ok = inst.guardedApply(state, function() error("probe failure") end)
		local restored = inst.restoreLast()
		return ok == false and result.hp == 10 and restored ~= nil
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7487">
<Properties>
<string name="Name">B_0323_shortcuts_document</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0323 :: Shortcut Map Document Model
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: document (transactional editing state with dirty tracking and revisions)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0323"
	S.key = "arkher.studio.shortcuts.document_model"
	S.name = "Shortcut Map Document Model"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Shortcut Map"
	S.aspect = "Document Model"
	S.kit = "document"
	S.version = "1.0.0"
	S.deps = {  }
	S.tags = { "b", "shortcuts", "document", "studio" }
	S.description = "Shortcut Map Document Model: transactional editing state with dirty tracking and revisions for the Shortcut Map subsystem."
	S.params = {
		backlogLimit = 22,
		baseRadius = 240,
		baseWeight = 0.94,
		bias = 0.14,
		biasWeight = 0.19,
		ceiling = 310,
		detailWeight = 0.34,
		failureTolerance = 4,
		horizon = 7,
		integrator = "euler",
		minConfidence = 0.54,
		minThrottle = 0.17,
		regressionSlope = 0.12,
		saturation = 0.89,
		scale = 2.4
	}
	S.features = { "get", "set", "begin", "commit", "rollback", "validate", "isDirty", "markSaved", "serialize", "deserialize", "checksum", "stats", "transact", "applyPatch", "fieldNames", "transactionLabels", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("document", { id = "arkher.studio.shortcuts.document_model", initial = { profile = { quality = 0.94 }, meta = { revision = 0 } } })
		inst.system = S
		inst.ctx = ctx

		function inst.transact(label, fn)
			inst.begin(label)
			local ok, err = pcall(fn)
			if not ok then inst.rollback() return false, err end
			inst.commit()
			return true
		end
		function inst.applyPatch(patch)
			local n = 0
			for path, value in pairs(patch) do
				if inst.set(path, value) then n = n + 1 end
			end
			return n
		end
		function inst.fieldNames()
			local out = {}
			for k in pairs(inst.data) do out[#out + 1] = tostring(k) end
			table.sort(out)
			return out
		end
		function inst.transactionLabels()
			local out = {}
			for i, h in ipairs(inst.history) do out[i] = h.label end
			return out
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.shortcuts.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local ok = inst.transact("probe", function()
			inst.set("probe.alpha", 42)
			inst.set("probe.beta", "on")
		end)
		ok = ok and inst.get("probe.alpha") == 42 and inst.get("probe.beta") == "on"
		inst.begin("discard")
		inst.set("probe.alpha", 7)
		inst.rollback()
		ok = ok and inst.get("probe.alpha") == 42
		ok = ok and type(inst.checksum()) == "number" and #inst.fieldNames() &gt;= 1
		inst.markSaved()
		return ok and inst.isDirty() == false
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7488">
<Properties>
<string name="Name">B_0324_shortcuts_commands</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0324 :: Shortcut Map Command Stack
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: commands (undoable operations with grouping and coalescing)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0324"
	S.key = "arkher.studio.shortcuts.command_stack"
	S.name = "Shortcut Map Command Stack"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Shortcut Map"
	S.aspect = "Command Stack"
	S.kit = "commands"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.shortcuts.document_model" }
	S.tags = { "b", "shortcuts", "commands", "studio" }
	S.description = "Shortcut Map Command Stack: undoable operations with grouping and coalescing for the Shortcut Map subsystem."
	S.params = {
		backlogLimit = 43,
		baseRadius = 440,
		baseWeight = 0.55,
		bias = 0.35,
		biasWeight = 0.2,
		ceiling = 379,
		detailWeight = 0.75,
		failureTolerance = 0,
		horizon = 4,
		integrator = "verlet",
		minConfidence = 0.75,
		minThrottle = 0.225,
		regressionSlope = 0.125,
		saturation = 0.75,
		scale = 3.5
	}
	S.features = { "execute", "beginGroup", "endGroup", "undo", "redo", "canUndo", "canRedo", "tick", "historyLabels", "clear", "stats", "push", "undoAll", "redoAll", "depth", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("commands", { id = "arkher.studio.shortcuts.command_stack", limit = 251, coalesceWindow = 0.55 })
		inst.system = S
		inst.ctx = ctx

		function inst.push(label, doFn, undoFn, coalesceKey)
			return inst.execute({ label = label, doFn = doFn, undoFn = undoFn, coalesceKey = coalesceKey })
		end
		function inst.undoAll()
			local n = 0
			while inst.canUndo() do
				if not inst.undo() then break end
				n = n + 1
			end
			return n
		end
		function inst.redoAll()
			local n = 0
			while inst.canRedo() do
				if not inst.redo() then break end
				n = n + 1
			end
			return n
		end
		function inst.depth() return #inst.undoStack, #inst.redoStack end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.shortcuts.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.clear()
		local value = 0
		for i = 1, 3 do
			inst.push("probe." .. i, function() value = value + i end, function() value = value - i end)
		end
		local ok = value == 6
		ok = ok and inst.undoAll() == 3 and value == 0
		ok = ok and inst.redoAll() == 3 and value == 6
		inst.undoAll()
		inst.clear()
		return ok and inst.canUndo() == false
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7489">
<Properties>
<string name="Name">B_0325_shortcuts_selection</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0325 :: Shortcut Map Selection Model
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: selection (multi-selection with primary item and filters)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0325"
	S.key = "arkher.studio.shortcuts.selection_model"
	S.name = "Shortcut Map Selection Model"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Shortcut Map"
	S.aspect = "Selection Model"
	S.kit = "selection"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.shortcuts.command_stack" }
	S.tags = { "b", "shortcuts", "selection", "studio" }
	S.description = "Shortcut Map Selection Model: multi-selection with primary item and filters for the Shortcut Map subsystem."
	S.params = {
		backlogLimit = 39,
		baseRadius = 600,
		baseWeight = 0.91,
		bias = 0.31,
		biasWeight = 0.16,
		ceiling = 119,
		detailWeight = 0.31,
		failureTolerance = 1,
		horizon = 8,
		integrator = "verlet",
		minConfidence = 0.71,
		minThrottle = 0.155,
		regressionSlope = 0.105,
		saturation = 0.86,
		scale = 2.1
	}
	S.features = { "contains", "add", "remove", "toggle", "set", "clear", "all", "count", "addFilter", "filtered", "stats", "selectWhere", "invert", "primaryOr", "summary", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("selection", { id = "arkher.studio.shortcuts.selection_model", maxItems = 567 })
		inst.system = S
		inst.ctx = ctx

		function inst.selectWhere(ids, predicate)
			inst.clear()
			local n = 0
			for _, id in ipairs(ids) do
				if predicate(id) and inst.add(id) then n = n + 1 end
			end
			return n
		end
		function inst.invert(universe)
			local current = {}
			for _, id in ipairs(inst.all()) do current[id] = true end
			inst.clear()
			for _, id in ipairs(universe) do
				if not current[id] then inst.add(id) end
			end
			return inst.count()
		end
		function inst.primaryOr(default) return inst.primary or default end
		function inst.summary()
			local filters = 0
			for _ in pairs(inst.filters) do filters = filters + 1 end
			return { count = inst.count(), primary = inst.primary, filters = filters, items = inst.all() }
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.shortcuts.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.clear()
		local universe = { "probe.a", "probe.b", "probe.c", "probe.d" }
		local n = inst.selectWhere(universe, function(id) return id ~= "probe.c" end)
		local ok = n == 3 and inst.contains("probe.a") and inst.contains("probe.c") == false
		ok = ok and inst.invert(universe) == 1 and inst.contains("probe.c")
		ok = ok and inst.summary().count == 1 and inst.primaryOr("none") ~= "none"
		inst.clear()
		return ok and inst.count() == 0
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7490">
<Properties>
<string name="Name">B_0326_shortcuts_layout</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0326 :: Shortcut Map Panel Layout
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: layout (dockable panel tree with persistence)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0326"
	S.key = "arkher.studio.shortcuts.panel_layout"
	S.name = "Shortcut Map Panel Layout"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Shortcut Map"
	S.aspect = "Panel Layout"
	S.kit = "layout"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.shortcuts.selection_model" }
	S.tags = { "b", "shortcuts", "layout", "studio" }
	S.description = "Shortcut Map Panel Layout: dockable panel tree with persistence for the Shortcut Map subsystem."
	S.params = {
		backlogLimit = 11,
		baseRadius = 280,
		baseWeight = 0.73,
		bias = 0.03,
		biasWeight = 0.08,
		ceiling = 219,
		detailWeight = 0.23,
		failureTolerance = 3,
		horizon = 4,
		integrator = "verlet",
		minConfidence = 0.43,
		minThrottle = 0.115,
		regressionSlope = 0.065,
		saturation = 0.93,
		scale = 1.3
	}
	S.features = { "addPanel", "split", "dock", "focus", "setVisible", "visiblePanels", "save", "restore", "stats", "installDefault", "toggle", "panelIds", "workspacePreset", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("layout", { id = "arkher.studio.shortcuts.panel_layout", minRatio = 0.08 })
		inst.system = S
		inst.ctx = ctx

		function inst.installDefault()
			local ids = { "main", "side", "bottom" }
			for _, id in ipairs(ids) do
				if not inst.panels[id] then inst.addPanel(id, { title = S.name .. " " .. id }) end
			end
			inst.focus("main")
			return #ids
		end
		function inst.toggle(panelId)
			local p = inst.panels[panelId]
			if not p then return false end
			return inst.setVisible(panelId, not p.visible)
		end
		function inst.panelIds()
			local out = {}
			for id in pairs(inst.panels) do out[#out + 1] = id end
			table.sort(out)
			return out
		end
		function inst.workspacePreset(name)
			inst.installDefault()
			local focus = (name == "focus")
			inst.setVisible("side", not focus)
			inst.setVisible("bottom", not focus)
			return #inst.visiblePanels()
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.shortcuts.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.installDefault()
		local ok = #inst.panelIds() &gt;= 3 and #inst.visiblePanels() &gt;= 3
		local blob = inst.save()
		ok = ok and type(blob) == "string" and #blob &gt; 2
		ok = ok and inst.workspacePreset("focus") == 1
		ok = ok and inst.toggle("side") and #inst.visiblePanels() == 2
		ok = ok and inst.workspacePreset("full") == 3
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7491">
<Properties>
<string name="Name">B_0327_shortcuts_widget</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0327 :: Shortcut Map Widget Surface
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: widget (retained-mode UI tree with data bindings)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0327"
	S.key = "arkher.studio.shortcuts.widget_surface"
	S.name = "Shortcut Map Widget Surface"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Shortcut Map"
	S.aspect = "Widget Surface"
	S.kit = "widget"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.shortcuts.panel_layout" }
	S.tags = { "b", "shortcuts", "widget", "studio" }
	S.description = "Shortcut Map Widget Surface: retained-mode UI tree with data bindings for the Shortcut Map subsystem."
	S.params = {
		backlogLimit = 10,
		baseRadius = 560,
		baseWeight = 0.92,
		bias = 0.02,
		biasWeight = 0.07,
		ceiling = 274,
		detailWeight = 0.42,
		failureTolerance = 2,
		horizon = 3,
		integrator = "euler",
		minConfidence = 0.42,
		minThrottle = 0.21,
		regressionSlope = 0.06,
		saturation = 0.87,
		scale = 3.2
	}
	S.features = { "create", "setProp", "bind", "update", "render", "destroy", "count", "stats", "buildSurface", "setModel", "repaint", "tree", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("widget", { id = "arkher.studio.shortcuts.widget_surface", theme = "light", scale = 1.17 })
		inst.system = S
		inst.ctx = ctx

		inst.model = { title = S.name, value = 0, status = "idle" }
		function inst.buildSurface()
			if inst.rootId then return inst.rootId end
			inst.rootId = inst.create("Frame", { name = S.key, scale = inst.scale })
			inst.titleId = inst.create("Label", { text = "" }, inst.rootId)
			inst.valueId = inst.create("Label", { text = "" }, inst.rootId)
			inst.bind(inst.titleId, "text", function() return inst.model.title end)
			inst.bind(inst.valueId, "text", function()
				return string.format("%s %.2f", tostring(inst.model.status), inst.model.value)
			end)
			return inst.rootId
		end
		function inst.setModel(key, value)
			inst.model[key] = value
			return inst.update()
		end
		function inst.repaint()
			inst.update()
			return inst.render()
		end
		function inst.tree()
			local out = {}
			for id, node in pairs(inst.nodes) do out[#out + 1] = { id = id, class = node.class } end
			table.sort(out, function(a, b) return a.id &lt; b.id end)
			return out
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.shortcuts.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.buildSurface()
		local painted = inst.repaint()
		local ok = painted &gt;= 3 and #inst.tree() &gt;= 3
		ok = ok and inst.setModel("value", 12.5) &gt;= 1
		ok = ok and inst.repaint() &gt;= 1
		ok = ok and inst.repaint() == 0
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7492">
<Properties>
<string name="Name">B_0328_shortcuts_inspector</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0328 :: Shortcut Map Property Inspector
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: inspector (reflection-driven property editing)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0328"
	S.key = "arkher.studio.shortcuts.property_inspector"
	S.name = "Shortcut Map Property Inspector"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Shortcut Map"
	S.aspect = "Property Inspector"
	S.kit = "inspector"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.shortcuts.widget_surface" }
	S.tags = { "b", "shortcuts", "inspector", "studio" }
	S.description = "Shortcut Map Property Inspector: reflection-driven property editing for the Shortcut Map subsystem."
	S.params = {
		backlogLimit = 15,
		baseRadius = 440,
		baseWeight = 0.67,
		bias = 0.07,
		biasWeight = 0.12,
		ceiling = 511,
		detailWeight = 0.27,
		failureTolerance = 2,
		horizon = 8,
		integrator = "verlet",
		minConfidence = 0.47,
		minThrottle = 0.135,
		regressionSlope = 0.085,
		saturation = 0.87,
		scale = 1.7
	}
	S.features = { "attach", "fields", "layout", "edit", "apply", "revert", "multiSelect", "applyToAll", "stats", "ensureType", "attachDefault", "editMany", "pending", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("inspector", { id = "arkher.studio.shortcuts.property_inspector" })
		inst.system = S
		inst.ctx = ctx

		function inst.ensureType()
			local Reflection = A:import("arkher/kernel/reflection")
			if not Reflection.getType(S.key) then
				Reflection.defineType(S.key, { fields = {
					intensity = { type = "number", default = S.params.baseWeight, min = 0, max = 1,
						editor = { group = "Tuning", order = 1 } },
					mode = { type = "string", default = "auto", editor = { group = "Tuning", order = 2 } },
					enabled = { type = "boolean", default = true, editor = { group = "General", order = 3 } } } })
			end
			return S.key
		end
		function inst.attachDefault(target)
			inst.ensureType()
			target = target or { intensity = S.params.baseWeight, mode = "auto", enabled = true }
			inst.attach(target, S.key)
			return target
		end
		function inst.editMany(patch)
			local applied, rejected = 0, 0
			for field, value in pairs(patch) do
				if inst.edit(field, value) then applied = applied + 1 else rejected = rejected + 1 end
			end
			return applied, rejected
		end
		function inst.pending()
			local out = {}
			for k, v in pairs(inst.edits) do out[#out + 1] = { field = k, value = v } end
			table.sort(out, function(a, b) return a.field &lt; b.field end)
			return out
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.shortcuts.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local target = inst.attachDefault({ intensity = 0.1, mode = "auto", enabled = true })
		local applied, rejected = inst.editMany({ intensity = 9.0, mode = "manual" })
		local ok = applied == 2 and rejected == 0 and #inst.pending() == 2
		ok = ok and inst.apply() == 2 and target.intensity == 1 and target.mode == "manual"
		ok = ok and #inst.fields() == 3
		local common = inst.multiSelect({ { intensity = 0.2 }, { intensity = 0.9 } })
		return ok and common.intensity == "&lt;mixed&gt;"
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7493">
<Properties>
<string name="Name">B_0329_shortcuts_nodegraph</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0329 :: Shortcut Map Node Editor
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: nodegraph (typed node graph authoring and compilation)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0329"
	S.key = "arkher.studio.shortcuts.node_editor"
	S.name = "Shortcut Map Node Editor"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Shortcut Map"
	S.aspect = "Node Editor"
	S.kit = "nodegraph"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.shortcuts.property_inspector" }
	S.tags = { "b", "shortcuts", "nodegraph", "studio" }
	S.description = "Shortcut Map Node Editor: typed node graph authoring and compilation for the Shortcut Map subsystem."
	S.params = {
		backlogLimit = 24,
		baseRadius = 480,
		baseWeight = 0.56,
		bias = 0.16,
		biasWeight = 0.21,
		ceiling = 272,
		detailWeight = 0.76,
		failureTolerance = 1,
		horizon = 1,
		integrator = "euler",
		minConfidence = 0.56,
		minThrottle = 0.23,
		regressionSlope = 0.13,
		saturation = 0.76,
		scale = 3.6
	}
	S.features = { "defineType", "addNode", "connect", "topoOrder", "evaluate", "compile", "validate", "stats", "installStdNodes", "buildDefault", "evaluateDefault", "compileDefault", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("nodegraph", { id = "arkher.studio.shortcuts.node_editor" })
		inst.system = S
		inst.ctx = ctx

		function inst.installStdNodes()
			if inst.types["Const"] then return inst end
			inst.defineType("Const", { inputs = {}, outputs = { { name = "out", type = "number" } },
				fn = function(_, props) return { out = props.value or 0 } end,
				emit = function(id, args, props) return string.format("local v%d_out = %.6f", id, props.value or 0) end })
			inst.defineType("Scale", { inputs = { { name = "a", type = "number", required = true } },
				outputs = { { name = "out", type = "number" } },
				fn = function(inputs, props) return { out = (inputs.a or 0) * (props.factor or 1) } end,
				emit = function(id, args, props)
					local src = "0"
					for _, arg in ipairs(args) do src = string.match(arg, "=%s*(.+)$") or src end
					return string.format("local v%d_out = (%s) * %.6f", id, src, props.factor or 1)
				end })
			inst.defineType("Sum", { inputs = { { name = "a", type = "number", required = true },
					{ name = "b", type = "number", required = true } },
				outputs = { { name = "out", type = "number" } },
				fn = function(inputs) return { out = (inputs.a or 0) + (inputs.b or 0) } end,
				emit = function(id, args)
					local parts = {}
					for _, arg in ipairs(args) do parts[#parts + 1] = string.match(arg, "=%s*(.+)$") or "0" end
					if #parts == 0 then parts[1] = "0" end
					return string.format("local v%d_out = %s", id, table.concat(parts, " + "))
				end })
			return inst
		end
		function inst.buildDefault()
			if inst.defaultGraph then return inst.defaultGraph end
			inst.installStdNodes()
			local a = inst.addNode("Const", { value = S.params.baseWeight })
			local b = inst.addNode("Const", { value = S.params.detailWeight })
			local scaled = inst.addNode("Scale", { factor = S.params.scale })
			local sum = inst.addNode("Sum", {})
			inst.connect(a, "out", scaled, "a")
			inst.connect(scaled, "out", sum, "a")
			inst.connect(b, "out", sum, "b")
			inst.defaultGraph = { a = a, b = b, scaled = scaled, sum = sum }
			return inst.defaultGraph
		end
		function inst.evaluateDefault()
			local ids = inst.buildDefault()
			local values, err = inst.evaluate({})
			if not values then return nil, err end
			return values[ids.sum .. ":out"]
		end
		function inst.compileDefault(name)
			inst.buildDefault()
			return inst.compile(name or "arkherGraph")
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.shortcuts.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local expected = S.params.baseWeight * S.params.scale + S.params.detailWeight
		local value = inst.evaluateDefault()
		local ok = type(value) == "number" and math.abs(value - expected) &lt; 1e-6
		local src = inst.compileDefault("probeGraph")
		ok = ok and type(src) == "string" and string.find(src, "local v", 1, true) ~= nil
		ok = ok and inst.validate() and #inst.topoOrder() == 4
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7494">
<Properties>
<string name="Name">B_0330_shortcuts_registry</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0330 :: Shortcut Map Registry
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: registry (catalogued editor records, tags and queries)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0330"
	S.key = "arkher.studio.shortcuts.registry"
	S.name = "Shortcut Map Registry"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Shortcut Map"
	S.aspect = "Registry"
	S.kit = "registry"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.shortcuts.node_editor" }
	S.tags = { "b", "shortcuts", "registry", "studio" }
	S.description = "Shortcut Map Registry: catalogued editor records, tags and queries for the Shortcut Map subsystem."
	S.params = {
		backlogLimit = 44,
		baseRadius = 480,
		baseWeight = 0.96,
		bias = 0.36,
		biasWeight = 0.21,
		ceiling = 316,
		detailWeight = 0.76,
		failureTolerance = 1,
		horizon = 5,
		integrator = "euler",
		minConfidence = 0.76,
		minThrottle = 0.23,
		regressionSlope = 0.13,
		saturation = 0.91,
		scale = 3.6
	}
	S.features = { "define", "get", "has", "remove", "withTag", "query", "ids", "snapshot", "restore", "stats", "upsert", "bulkDefine", "tally", "export", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("registry", { id = "arkher.studio.shortcuts.registry" })
		inst.system = S
		inst.ctx = ctx

	function inst.upsert(id, data, tags) return inst.define(id, data, tags) end
	function inst.bulkDefine(list)
		local n = 0
		for _, rec in ipairs(list) do
			if inst.define(rec.id, rec.data, rec.tags) then n = n + 1 end
		end
		return n
	end
	function inst.tally()
		local out = {}
		for _, id in ipairs(inst.ids()) do
			for _, tag in ipairs(inst.records[id].tags) do out[tag] = (out[tag] or 0) + 1 end
		end
		return out
	end
	function inst.export() return { area = S.area, count = inst.stats().count, records = inst.snapshot() } end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.shortcuts.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.define("probe.a", { weight = 1 }, { "probe" })
		inst.define("probe.b", { weight = 2 }, { "probe", "heavy" })
		local ok = inst.stats().count == 2 and #inst.withTag("probe") == 2 and inst.get("probe.b").weight == 2
		inst.remove("probe.a") inst.remove("probe.b")
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7495">
<Properties>
<string name="Name">B_0331_shortcuts_pipeline</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0331 :: Shortcut Map Tool Pipeline
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: pipeline (staged tool execution with isolation)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0331"
	S.key = "arkher.studio.shortcuts.tool_pipeline"
	S.name = "Shortcut Map Tool Pipeline"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Shortcut Map"
	S.aspect = "Tool Pipeline"
	S.kit = "pipeline"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.shortcuts.registry" }
	S.tags = { "b", "shortcuts", "pipeline", "studio" }
	S.description = "Shortcut Map Tool Pipeline: staged tool execution with isolation for the Shortcut Map subsystem."
	S.params = {
		backlogLimit = 38,
		baseRadius = 400,
		baseWeight = 0.5,
		bias = 0.3,
		biasWeight = 0.15,
		ceiling = 342,
		detailWeight = 0.5,
		failureTolerance = 0,
		horizon = 7,
		integrator = "euler",
		minConfidence = 0.7,
		minThrottle = 0.1,
		regressionSlope = 0.1,
		saturation = 0.7,
		scale = 1.0
	}
	S.features = { "addStage", "disable", "enable", "run", "stageNames", "stats", "installDefaults", "process", "benchmark", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("pipeline", { id = "arkher.studio.shortcuts.tool_pipeline", budgetMs = 5.00 })
		inst.system = S
		inst.ctx = ctx

	function inst.installDefaults()
		inst.addStage("normalize", function(v) 
			if type(v) == "number" then return math.max(0, v) end
			return v
		end)
		inst.addStage("scale", function(v)
			if type(v) == "number" then return v * S.params.scale end
			return v
		end)
		inst.addStage("clamp", function(v)
			if type(v) == "number" then return math.min(v, S.params.ceiling) end
			return v
		end)
		return inst
	end
	function inst.process(value, ctx) return inst.run(value, ctx) end
	function inst.benchmark(iterations)
		local total = 0
		for i = 1, (iterations or 32) do
			local v = inst.run(i)
			if type(v) == "number" then total = total + v end
		end
		return total / math.max(1, iterations or 32)
	end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.shortcuts.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.installDefaults()
		local out = inst.run(-4)
		local ok = out == 0
		local out2 = inst.run(2)
		ok = ok and out2 == math.min(2 * S.params.scale, S.params.ceiling)
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7496">
<Properties>
<string name="Name">B_0332_shortcuts_cache</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0332 :: Shortcut Map Preview Cache
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: cache (reuse of expensive editor previews)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0332"
	S.key = "arkher.studio.shortcuts.preview_cache"
	S.name = "Shortcut Map Preview Cache"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Shortcut Map"
	S.aspect = "Preview Cache"
	S.kit = "cache"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.shortcuts.tool_pipeline" }
	S.tags = { "b", "shortcuts", "cache", "studio" }
	S.description = "Shortcut Map Preview Cache: reuse of expensive editor previews for the Shortcut Map subsystem."
	S.params = {
		backlogLimit = 27,
		baseRadius = 280,
		baseWeight = 0.99,
		bias = 0.19,
		biasWeight = 0.24,
		ceiling = 563,
		detailWeight = 0.59,
		failureTolerance = 4,
		horizon = 4,
		integrator = "verlet",
		minConfidence = 0.59,
		minThrottle = 0.145,
		regressionSlope = 0.145,
		saturation = 0.94,
		scale = 1.9
	}
	S.features = { "set", "get", "remove", "evict", "tick", "hitRate", "warm", "clear", "stats", "memoize", "prefetch", "pressure", "shrinkTo", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("cache", { id = "arkher.studio.shortcuts.preview_cache", policy = "lru", capacity = 115, ttl = 4 })
		inst.system = S
		inst.ctx = ctx

	function inst.memoize(fn)
		return function(key, ...)
			local hit = inst.get(key)
			if hit ~= nil then return hit, true end
			local value = fn(key, ...)
			inst.set(key, value)
			return value, false
		end
	end
	function inst.prefetch(keys, producer)
		local n = 0
		for _, k in ipairs(keys) do
			if inst.get(k) == nil then inst.set(k, producer(k)) n = n + 1 end
		end
		return n
	end
	function inst.pressure() return inst.stats().size / math.max(1, inst.capacity) end
	function inst.shrinkTo(capacity)
		inst.capacity = math.max(1, capacity)
		return inst.evict()
	end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.shortcuts.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local calls = 0
		local memo = inst.memoize(function(k) calls = calls + 1 return k * 2 end)
		local v1 = memo(21)
		local v2, cached = memo(21)
		inst.clear()
		return v1 == 42 and v2 == 42 and cached == true and calls == 1
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7497">
<Properties>
<string name="Name">B_0333_shortcuts_session</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0333 :: Shortcut Map Session Sync
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: session (multi-user editing of this editor surface)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0333"
	S.key = "arkher.studio.shortcuts.session_sync"
	S.name = "Shortcut Map Session Sync"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Shortcut Map"
	S.aspect = "Session Sync"
	S.kit = "session"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.shortcuts.preview_cache" }
	S.tags = { "b", "shortcuts", "session", "studio" }
	S.description = "Shortcut Map Session Sync: multi-user editing of this editor surface for the Shortcut Map subsystem."
	S.params = {
		backlogLimit = 28,
		baseRadius = 160,
		baseWeight = 0.8,
		bias = 0.2,
		biasWeight = 0.05,
		ceiling = 564,
		detailWeight = 0.2,
		failureTolerance = 0,
		horizon = 5,
		integrator = "euler",
		minConfidence = 0.6,
		minThrottle = 0.1,
		regressionSlope = 0.05,
		saturation = 0.75,
		scale = 1.0
	}
	S.features = { "join", "leave", "acquireLock", "releaseLock", "submit", "rebase", "since", "updatePresence", "activeUsers", "stats", "openWith", "editPath", "lockedEdit", "conflictRate", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("session", { id = "arkher.studio.shortcuts.session_sync", maxOps = 6132 })
		inst.system = S
		inst.ctx = ctx

		function inst.openWith(users)
			for _, u in ipairs(users) do inst.join(u.id or u, u.role or "editor") end
			return #inst.activeUsers()
		end
		function inst.editPath(userId, path, value)
			return inst.submit(userId, { kind = "set", path = path, value = value })
		end
		function inst.lockedEdit(userId, path, value)
			local ok, holder = inst.acquireLock(userId, path)
			if not ok then return false, holder end
			local applied = inst.editPath(userId, path, value)
			inst.releaseLock(userId, path)
			return applied
		end
		function inst.conflictRate()
			local st = inst.stats()
			return st.conflicts / math.max(1, st.ops + st.conflicts)
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.shortcuts.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.openWith({ { id = "probe.a", role = "editor" }, { id = "probe.b", role = "editor" },
			{ id = "probe.v", role = "viewer" } })
		local ok = #inst.activeUsers() == 3
		ok = ok and inst.acquireLock("probe.a", "probe.path")
		ok = ok and inst.editPath("probe.a", "probe.path", 1)
		ok = ok and inst.editPath("probe.b", "probe.path", 2) == false
		ok = ok and inst.editPath("probe.v", "probe.other", 3) == false
		inst.releaseLock("probe.a", "probe.path")
		ok = ok and #inst.since(0) == 1
		local rebased = inst.rebase({ kind = "set", path = "probe.path", value = 9 }, 0)
		ok = ok and rebased ~= nil and rebased.conflict == true
		ok = ok and inst.lockedEdit("probe.b", "probe.other", 4)
		inst.leave("probe.a") inst.leave("probe.b") inst.leave("probe.v")
		return ok and #inst.activeUsers() == 0
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7498">
<Properties>
<string name="Name">B_0334_shortcuts_taskgraph</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0334 :: Shortcut Map Task Runner
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: taskgraph (incremental background work for the editor)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0334"
	S.key = "arkher.studio.shortcuts.task_runner"
	S.name = "Shortcut Map Task Runner"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Shortcut Map"
	S.aspect = "Task Runner"
	S.kit = "taskgraph"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.shortcuts.session_sync" }
	S.tags = { "b", "shortcuts", "taskgraph", "studio" }
	S.description = "Shortcut Map Task Runner: incremental background work for the editor for the Shortcut Map subsystem."
	S.params = {
		backlogLimit = 17,
		baseRadius = 520,
		baseWeight = 0.79,
		bias = 0.09,
		biasWeight = 0.14,
		ceiling = 553,
		detailWeight = 0.29,
		failureTolerance = 4,
		horizon = 2,
		integrator = "verlet",
		minConfidence = 0.49,
		minThrottle = 0.145,
		regressionSlope = 0.095,
		saturation = 0.74,
		scale = 1.9
	}
	S.features = { "addTask", "resolveOrder", "inputHash", "run", "invalidate", "artifact", "stats", "installPipeline", "build", "rebuild", "cacheEfficiency", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("taskgraph", { id = "arkher.studio.shortcuts.task_runner", incremental = true })
		inst.system = S
		inst.ctx = ctx

		function inst.installPipeline()
			if inst.pipeline then return inst.pipeline end
			local counters = { collect = 0, transform = 0, emit = 0 }
			inst.counters = counters
			inst.addTask("collect", { inputs = { S.key }, fn = function()
				counters.collect = counters.collect + 1
				return { items = 8 + (S.params.horizon or 1) }
			end })
			inst.addTask("transform", { deps = { "collect" }, inputs = { S.params.scale }, fn = function(artifacts)
				counters.transform = counters.transform + 1
				local items = artifacts["collect"].value.items
				return { items = items, weight = items * S.params.scale }
			end })
			inst.addTask("emit", { deps = { "transform" }, inputs = { S.params.ceiling }, fn = function(artifacts)
				counters.emit = counters.emit + 1
				return { payload = math.min(artifacts["transform"].value.weight, S.params.ceiling) }
			end })
			inst.pipeline = { "collect", "transform", "emit" }
			return inst.pipeline
		end
		function inst.build()
			inst.installPipeline()
			return inst.run()
		end
		function inst.rebuild(taskId)
			inst.installPipeline()
			inst.invalidate(taskId or "collect")
			return inst.run()
		end
		function inst.cacheEfficiency()
			local st = inst.stats()
			return st.cacheHits / math.max(1, st.cacheHits + st.artifacts)
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.shortcuts.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local first = inst.build()
		local ok = #first == 3 and inst.counters.collect == 1
		ok = ok and #inst.build() == 0
		local third = inst.rebuild("transform")
		ok = ok and #third == 2 and inst.counters.collect == 1 and inst.counters.transform == 2
		ok = ok and inst.artifact("emit") ~= nil and inst.cacheEfficiency() &gt; 0
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7499">
<Properties>
<string name="Name">B_0335_shortcuts_ledger</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0335 :: Shortcut Map Telemetry
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: ledger (editor interaction journal and histograms)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0335"
	S.key = "arkher.studio.shortcuts.telemetry"
	S.name = "Shortcut Map Telemetry"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Shortcut Map"
	S.aspect = "Telemetry"
	S.kit = "ledger"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.shortcuts.task_runner" }
	S.tags = { "b", "shortcuts", "ledger", "studio" }
	S.description = "Shortcut Map Telemetry: editor interaction journal and histograms for the Shortcut Map subsystem."
	S.params = {
		backlogLimit = 12,
		baseRadius = 160,
		baseWeight = 0.84,
		bias = 0.04,
		biasWeight = 0.09,
		ceiling = 140,
		detailWeight = 0.44,
		failureTolerance = 4,
		horizon = 5,
		integrator = "euler",
		minConfidence = 0.44,
		minThrottle = 0.22,
		regressionSlope = 0.07,
		saturation = 0.79,
		scale = 3.4
	}
	S.features = { "write", "observe", "query", "seal", "verifySeal", "percentileBucket", "stats", "record", "timing", "digest", "recent", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("ledger", { id = "arkher.studio.shortcuts.telemetry", capacity = 460 })
		inst.system = S
		inst.ctx = ctx

	function inst.record(operation, payload) return inst.write(operation, payload) end
	function inst.timing(ms) return inst.observe(ms) end
	function inst.digest()
		return { seal = inst.seal(), written = inst.written, p95 = inst.percentileBucket(95) }
	end
	function inst.recent(kind, limit) return inst.query(kind, limit or 10) end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.shortcuts.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.record("probe", { v = 1 })
		inst.record("probe", { v = 2 })
		inst.timing(4) inst.timing(40)
		local d = inst.digest()
		return d.written == 2 and inst.verifySeal() and #inst.recent("probe") == 2
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7500">
<Properties>
<string name="Name">B_0336_shortcuts_recovery</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0336 :: Shortcut Map Recovery
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: recovery (crash-safe checkpointing of editor state)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0336"
	S.key = "arkher.studio.shortcuts.recovery"
	S.name = "Shortcut Map Recovery"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Shortcut Map"
	S.aspect = "Recovery"
	S.kit = "recovery"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.shortcuts.telemetry" }
	S.tags = { "b", "shortcuts", "recovery", "studio" }
	S.description = "Shortcut Map Recovery: crash-safe checkpointing of editor state for the Shortcut Map subsystem."
	S.params = {
		backlogLimit = 19,
		baseRadius = 440,
		baseWeight = 0.81,
		bias = 0.11,
		biasWeight = 0.16,
		ceiling = 451,
		detailWeight = 0.51,
		failureTolerance = 1,
		horizon = 4,
		integrator = "verlet",
		minConfidence = 0.51,
		minThrottle = 0.105,
		regressionSlope = 0.105,
		saturation = 0.76,
		scale = 1.1
	}
	S.features = { "snapshot", "verify", "rollback", "lastGood", "protect", "stats", "guardedApply", "checkpoint", "restoreLast", "healthy", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("recovery", { id = "arkher.studio.shortcuts.recovery", maxSnapshots = 7, strategy = "rollback" })
		inst.system = S
		inst.ctx = ctx

	function inst.guardedApply(state, mutate)
		return inst.protect(mutate, state)
	end
	function inst.checkpoint(label, state) return inst.snapshot(label, state) end
	function inst.restoreLast()
		local snap = inst.lastGood()
		if not snap then return nil end
		return snap.state, snap.label
	end
	function inst.healthy() return inst.stats().failures &lt;= S.params.failureTolerance end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.shortcuts.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local state = { hp = 10 }
		inst.checkpoint("probe", state)
		local result, ok = inst.guardedApply(state, function() error("probe failure") end)
		local restored = inst.restoreLast()
		return ok == false and result.hp == 10 and restored ~= nil
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7501">
<Properties>
<string name="Name">B_0337_theme_document</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0337 :: Theme Document Model
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: document (transactional editing state with dirty tracking and revisions)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0337"
	S.key = "arkher.studio.theme.document_model"
	S.name = "Theme Document Model"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Theme"
	S.aspect = "Document Model"
	S.kit = "document"
	S.version = "1.0.0"
	S.deps = {  }
	S.tags = { "b", "theme", "document", "studio" }
	S.description = "Theme Document Model: transactional editing state with dirty tracking and revisions for the Theme subsystem."
	S.params = {
		backlogLimit = 10,
		baseRadius = 400,
		baseWeight = 0.52,
		bias = 0.02,
		biasWeight = 0.07,
		ceiling = 210,
		detailWeight = 0.62,
		failureTolerance = 2,
		horizon = 3,
		integrator = "euler",
		minConfidence = 0.42,
		minThrottle = 0.16,
		regressionSlope = 0.06,
		saturation = 0.72,
		scale = 2.2
	}
	S.features = { "get", "set", "begin", "commit", "rollback", "validate", "isDirty", "markSaved", "serialize", "deserialize", "checksum", "stats", "transact", "applyPatch", "fieldNames", "transactionLabels", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("document", { id = "arkher.studio.theme.document_model", initial = { profile = { quality = 0.52 }, meta = { revision = 0 } } })
		inst.system = S
		inst.ctx = ctx

		function inst.transact(label, fn)
			inst.begin(label)
			local ok, err = pcall(fn)
			if not ok then inst.rollback() return false, err end
			inst.commit()
			return true
		end
		function inst.applyPatch(patch)
			local n = 0
			for path, value in pairs(patch) do
				if inst.set(path, value) then n = n + 1 end
			end
			return n
		end
		function inst.fieldNames()
			local out = {}
			for k in pairs(inst.data) do out[#out + 1] = tostring(k) end
			table.sort(out)
			return out
		end
		function inst.transactionLabels()
			local out = {}
			for i, h in ipairs(inst.history) do out[i] = h.label end
			return out
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.theme.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local ok = inst.transact("probe", function()
			inst.set("probe.alpha", 42)
			inst.set("probe.beta", "on")
		end)
		ok = ok and inst.get("probe.alpha") == 42 and inst.get("probe.beta") == "on"
		inst.begin("discard")
		inst.set("probe.alpha", 7)
		inst.rollback()
		ok = ok and inst.get("probe.alpha") == 42
		ok = ok and type(inst.checksum()) == "number" and #inst.fieldNames() &gt;= 1
		inst.markSaved()
		return ok and inst.isDirty() == false
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7502">
<Properties>
<string name="Name">B_0338_theme_commands</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0338 :: Theme Command Stack
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: commands (undoable operations with grouping and coalescing)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0338"
	S.key = "arkher.studio.theme.command_stack"
	S.name = "Theme Command Stack"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Theme"
	S.aspect = "Command Stack"
	S.kit = "commands"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.theme.document_model" }
	S.tags = { "b", "theme", "commands", "studio" }
	S.description = "Theme Command Stack: undoable operations with grouping and coalescing for the Theme subsystem."
	S.params = {
		backlogLimit = 29,
		baseRadius = 360,
		baseWeight = 0.61,
		bias = 0.21,
		biasWeight = 0.06,
		ceiling = 325,
		detailWeight = 0.61,
		failureTolerance = 1,
		horizon = 6,
		integrator = "verlet",
		minConfidence = 0.61,
		minThrottle = 0.155,
		regressionSlope = 0.055,
		saturation = 0.81,
		scale = 2.1
	}
	S.features = { "execute", "beginGroup", "endGroup", "undo", "redo", "canUndo", "canRedo", "tick", "historyLabels", "clear", "stats", "push", "undoAll", "redoAll", "depth", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("commands", { id = "arkher.studio.theme.command_stack", limit = 69, coalesceWindow = 0.41 })
		inst.system = S
		inst.ctx = ctx

		function inst.push(label, doFn, undoFn, coalesceKey)
			return inst.execute({ label = label, doFn = doFn, undoFn = undoFn, coalesceKey = coalesceKey })
		end
		function inst.undoAll()
			local n = 0
			while inst.canUndo() do
				if not inst.undo() then break end
				n = n + 1
			end
			return n
		end
		function inst.redoAll()
			local n = 0
			while inst.canRedo() do
				if not inst.redo() then break end
				n = n + 1
			end
			return n
		end
		function inst.depth() return #inst.undoStack, #inst.redoStack end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.theme.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.clear()
		local value = 0
		for i = 1, 3 do
			inst.push("probe." .. i, function() value = value + i end, function() value = value - i end)
		end
		local ok = value == 6
		ok = ok and inst.undoAll() == 3 and value == 0
		ok = ok and inst.redoAll() == 3 and value == 6
		inst.undoAll()
		inst.clear()
		return ok and inst.canUndo() == false
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7503">
<Properties>
<string name="Name">B_0339_theme_selection</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0339 :: Theme Selection Model
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: selection (multi-selection with primary item and filters)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0339"
	S.key = "arkher.studio.theme.selection_model"
	S.name = "Theme Selection Model"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Theme"
	S.aspect = "Selection Model"
	S.kit = "selection"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.theme.command_stack" }
	S.tags = { "b", "theme", "selection", "studio" }
	S.description = "Theme Selection Model: multi-selection with primary item and filters for the Theme subsystem."
	S.params = {
		backlogLimit = 16,
		baseRadius = 320,
		baseWeight = 0.58,
		bias = 0.08,
		biasWeight = 0.13,
		ceiling = 72,
		detailWeight = 0.48,
		failureTolerance = 3,
		horizon = 1,
		integrator = "euler",
		minConfidence = 0.48,
		minThrottle = 0.24,
		regressionSlope = 0.09,
		saturation = 0.78,
		scale = 3.8
	}
	S.features = { "contains", "add", "remove", "toggle", "set", "clear", "all", "count", "addFilter", "filtered", "stats", "selectWhere", "invert", "primaryOr", "summary", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("selection", { id = "arkher.studio.theme.selection_model", maxItems = 1544 })
		inst.system = S
		inst.ctx = ctx

		function inst.selectWhere(ids, predicate)
			inst.clear()
			local n = 0
			for _, id in ipairs(ids) do
				if predicate(id) and inst.add(id) then n = n + 1 end
			end
			return n
		end
		function inst.invert(universe)
			local current = {}
			for _, id in ipairs(inst.all()) do current[id] = true end
			inst.clear()
			for _, id in ipairs(universe) do
				if not current[id] then inst.add(id) end
			end
			return inst.count()
		end
		function inst.primaryOr(default) return inst.primary or default end
		function inst.summary()
			local filters = 0
			for _ in pairs(inst.filters) do filters = filters + 1 end
			return { count = inst.count(), primary = inst.primary, filters = filters, items = inst.all() }
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.theme.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.clear()
		local universe = { "probe.a", "probe.b", "probe.c", "probe.d" }
		local n = inst.selectWhere(universe, function(id) return id ~= "probe.c" end)
		local ok = n == 3 and inst.contains("probe.a") and inst.contains("probe.c") == false
		ok = ok and inst.invert(universe) == 1 and inst.contains("probe.c")
		ok = ok and inst.summary().count == 1 and inst.primaryOr("none") ~= "none"
		inst.clear()
		return ok and inst.count() == 0
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7504">
<Properties>
<string name="Name">B_0340_theme_layout</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0340 :: Theme Panel Layout
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: layout (dockable panel tree with persistence)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0340"
	S.key = "arkher.studio.theme.panel_layout"
	S.name = "Theme Panel Layout"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Theme"
	S.aspect = "Panel Layout"
	S.kit = "layout"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.theme.selection_model" }
	S.tags = { "b", "theme", "layout", "studio" }
	S.description = "Theme Panel Layout: dockable panel tree with persistence for the Theme subsystem."
	S.params = {
		backlogLimit = 14,
		baseRadius = 240,
		baseWeight = 0.86,
		bias = 0.06,
		biasWeight = 0.11,
		ceiling = 510,
		detailWeight = 0.46,
		failureTolerance = 1,
		horizon = 7,
		integrator = "euler",
		minConfidence = 0.46,
		minThrottle = 0.23,
		regressionSlope = 0.08,
		saturation = 0.81,
		scale = 3.6
	}
	S.features = { "addPanel", "split", "dock", "focus", "setVisible", "visiblePanels", "save", "restore", "stats", "installDefault", "toggle", "panelIds", "workspacePreset", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("layout", { id = "arkher.studio.theme.panel_layout", minRatio = 0.16 })
		inst.system = S
		inst.ctx = ctx

		function inst.installDefault()
			local ids = { "main", "side", "bottom" }
			for _, id in ipairs(ids) do
				if not inst.panels[id] then inst.addPanel(id, { title = S.name .. " " .. id }) end
			end
			inst.focus("main")
			return #ids
		end
		function inst.toggle(panelId)
			local p = inst.panels[panelId]
			if not p then return false end
			return inst.setVisible(panelId, not p.visible)
		end
		function inst.panelIds()
			local out = {}
			for id in pairs(inst.panels) do out[#out + 1] = id end
			table.sort(out)
			return out
		end
		function inst.workspacePreset(name)
			inst.installDefault()
			local focus = (name == "focus")
			inst.setVisible("side", not focus)
			inst.setVisible("bottom", not focus)
			return #inst.visiblePanels()
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.theme.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.installDefault()
		local ok = #inst.panelIds() &gt;= 3 and #inst.visiblePanels() &gt;= 3
		local blob = inst.save()
		ok = ok and type(blob) == "string" and #blob &gt; 2
		ok = ok and inst.workspacePreset("focus") == 1
		ok = ok and inst.toggle("side") and #inst.visiblePanels() == 2
		ok = ok and inst.workspacePreset("full") == 3
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7505">
<Properties>
<string name="Name">B_0341_theme_widget</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0341 :: Theme Widget Surface
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: widget (retained-mode UI tree with data bindings)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0341"
	S.key = "arkher.studio.theme.widget_surface"
	S.name = "Theme Widget Surface"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Theme"
	S.aspect = "Widget Surface"
	S.kit = "widget"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.theme.panel_layout" }
	S.tags = { "b", "theme", "widget", "studio" }
	S.description = "Theme Widget Surface: retained-mode UI tree with data bindings for the Theme subsystem."
	S.params = {
		backlogLimit = 38,
		baseRadius = 400,
		baseWeight = 0.8,
		bias = 0.3,
		biasWeight = 0.15,
		ceiling = 174,
		detailWeight = 0.5,
		failureTolerance = 0,
		horizon = 7,
		integrator = "euler",
		minConfidence = 0.7,
		minThrottle = 0.1,
		regressionSlope = 0.1,
		saturation = 0.75,
		scale = 1.0
	}
	S.features = { "create", "setProp", "bind", "update", "render", "destroy", "count", "stats", "buildSurface", "setModel", "repaint", "tree", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("widget", { id = "arkher.studio.theme.widget_surface", theme = "dark", scale = 1.05 })
		inst.system = S
		inst.ctx = ctx

		inst.model = { title = S.name, value = 0, status = "idle" }
		function inst.buildSurface()
			if inst.rootId then return inst.rootId end
			inst.rootId = inst.create("Frame", { name = S.key, scale = inst.scale })
			inst.titleId = inst.create("Label", { text = "" }, inst.rootId)
			inst.valueId = inst.create("Label", { text = "" }, inst.rootId)
			inst.bind(inst.titleId, "text", function() return inst.model.title end)
			inst.bind(inst.valueId, "text", function()
				return string.format("%s %.2f", tostring(inst.model.status), inst.model.value)
			end)
			return inst.rootId
		end
		function inst.setModel(key, value)
			inst.model[key] = value
			return inst.update()
		end
		function inst.repaint()
			inst.update()
			return inst.render()
		end
		function inst.tree()
			local out = {}
			for id, node in pairs(inst.nodes) do out[#out + 1] = { id = id, class = node.class } end
			table.sort(out, function(a, b) return a.id &lt; b.id end)
			return out
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.theme.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.buildSurface()
		local painted = inst.repaint()
		local ok = painted &gt;= 3 and #inst.tree() &gt;= 3
		ok = ok and inst.setModel("value", 12.5) &gt;= 1
		ok = ok and inst.repaint() &gt;= 1
		ok = ok and inst.repaint() == 0
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7506">
<Properties>
<string name="Name">B_0342_theme_inspector</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0342 :: Theme Property Inspector
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: inspector (reflection-driven property editing)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0342"
	S.key = "arkher.studio.theme.property_inspector"
	S.name = "Theme Property Inspector"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Theme"
	S.aspect = "Property Inspector"
	S.kit = "inspector"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.theme.widget_surface" }
	S.tags = { "b", "theme", "inspector", "studio" }
	S.description = "Theme Property Inspector: reflection-driven property editing for the Theme subsystem."
	S.params = {
		backlogLimit = 45,
		baseRadius = 520,
		baseWeight = 0.87,
		bias = 0.37,
		biasWeight = 0.22,
		ceiling = 437,
		detailWeight = 0.77,
		failureTolerance = 2,
		horizon = 6,
		integrator = "verlet",
		minConfidence = 0.77,
		minThrottle = 0.235,
		regressionSlope = 0.135,
		saturation = 0.82,
		scale = 3.7
	}
	S.features = { "attach", "fields", "layout", "edit", "apply", "revert", "multiSelect", "applyToAll", "stats", "ensureType", "attachDefault", "editMany", "pending", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("inspector", { id = "arkher.studio.theme.property_inspector" })
		inst.system = S
		inst.ctx = ctx

		function inst.ensureType()
			local Reflection = A:import("arkher/kernel/reflection")
			if not Reflection.getType(S.key) then
				Reflection.defineType(S.key, { fields = {
					intensity = { type = "number", default = S.params.baseWeight, min = 0, max = 1,
						editor = { group = "Tuning", order = 1 } },
					mode = { type = "string", default = "auto", editor = { group = "Tuning", order = 2 } },
					enabled = { type = "boolean", default = true, editor = { group = "General", order = 3 } } } })
			end
			return S.key
		end
		function inst.attachDefault(target)
			inst.ensureType()
			target = target or { intensity = S.params.baseWeight, mode = "auto", enabled = true }
			inst.attach(target, S.key)
			return target
		end
		function inst.editMany(patch)
			local applied, rejected = 0, 0
			for field, value in pairs(patch) do
				if inst.edit(field, value) then applied = applied + 1 else rejected = rejected + 1 end
			end
			return applied, rejected
		end
		function inst.pending()
			local out = {}
			for k, v in pairs(inst.edits) do out[#out + 1] = { field = k, value = v } end
			table.sort(out, function(a, b) return a.field &lt; b.field end)
			return out
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.theme.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local target = inst.attachDefault({ intensity = 0.1, mode = "auto", enabled = true })
		local applied, rejected = inst.editMany({ intensity = 9.0, mode = "manual" })
		local ok = applied == 2 and rejected == 0 and #inst.pending() == 2
		ok = ok and inst.apply() == 2 and target.intensity == 1 and target.mode == "manual"
		ok = ok and #inst.fields() == 3
		local common = inst.multiSelect({ { intensity = 0.2 }, { intensity = 0.9 } })
		return ok and common.intensity == "&lt;mixed&gt;"
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7507">
<Properties>
<string name="Name">B_0343_theme_nodegraph</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0343 :: Theme Node Editor
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: nodegraph (typed node graph authoring and compilation)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0343"
	S.key = "arkher.studio.theme.node_editor"
	S.name = "Theme Node Editor"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Theme"
	S.aspect = "Node Editor"
	S.kit = "nodegraph"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.theme.property_inspector" }
	S.tags = { "b", "theme", "nodegraph", "studio" }
	S.description = "Theme Node Editor: typed node graph authoring and compilation for the Theme subsystem."
	S.params = {
		backlogLimit = 40,
		baseRadius = 480,
		baseWeight = 0.62,
		bias = 0.32,
		biasWeight = 0.17,
		ceiling = 488,
		detailWeight = 0.52,
		failureTolerance = 2,
		horizon = 1,
		integrator = "euler",
		minConfidence = 0.72,
		minThrottle = 0.11,
		regressionSlope = 0.11,
		saturation = 0.82,
		scale = 1.2
	}
	S.features = { "defineType", "addNode", "connect", "topoOrder", "evaluate", "compile", "validate", "stats", "installStdNodes", "buildDefault", "evaluateDefault", "compileDefault", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("nodegraph", { id = "arkher.studio.theme.node_editor" })
		inst.system = S
		inst.ctx = ctx

		function inst.installStdNodes()
			if inst.types["Const"] then return inst end
			inst.defineType("Const", { inputs = {}, outputs = { { name = "out", type = "number" } },
				fn = function(_, props) return { out = props.value or 0 } end,
				emit = function(id, args, props) return string.format("local v%d_out = %.6f", id, props.value or 0) end })
			inst.defineType("Scale", { inputs = { { name = "a", type = "number", required = true } },
				outputs = { { name = "out", type = "number" } },
				fn = function(inputs, props) return { out = (inputs.a or 0) * (props.factor or 1) } end,
				emit = function(id, args, props)
					local src = "0"
					for _, arg in ipairs(args) do src = string.match(arg, "=%s*(.+)$") or src end
					return string.format("local v%d_out = (%s) * %.6f", id, src, props.factor or 1)
				end })
			inst.defineType("Sum", { inputs = { { name = "a", type = "number", required = true },
					{ name = "b", type = "number", required = true } },
				outputs = { { name = "out", type = "number" } },
				fn = function(inputs) return { out = (inputs.a or 0) + (inputs.b or 0) } end,
				emit = function(id, args)
					local parts = {}
					for _, arg in ipairs(args) do parts[#parts + 1] = string.match(arg, "=%s*(.+)$") or "0" end
					if #parts == 0 then parts[1] = "0" end
					return string.format("local v%d_out = %s", id, table.concat(parts, " + "))
				end })
			return inst
		end
		function inst.buildDefault()
			if inst.defaultGraph then return inst.defaultGraph end
			inst.installStdNodes()
			local a = inst.addNode("Const", { value = S.params.baseWeight })
			local b = inst.addNode("Const", { value = S.params.detailWeight })
			local scaled = inst.addNode("Scale", { factor = S.params.scale })
			local sum = inst.addNode("Sum", {})
			inst.connect(a, "out", scaled, "a")
			inst.connect(scaled, "out", sum, "a")
			inst.connect(b, "out", sum, "b")
			inst.defaultGraph = { a = a, b = b, scaled = scaled, sum = sum }
			return inst.defaultGraph
		end
		function inst.evaluateDefault()
			local ids = inst.buildDefault()
			local values, err = inst.evaluate({})
			if not values then return nil, err end
			return values[ids.sum .. ":out"]
		end
		function inst.compileDefault(name)
			inst.buildDefault()
			return inst.compile(name or "arkherGraph")
		end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.theme.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		local expected = S.params.baseWeight * S.params.scale + S.params.detailWeight
		local value = inst.evaluateDefault()
		local ok = type(value) == "number" and math.abs(value - expected) &lt; 1e-6
		local src = inst.compileDefault("probeGraph")
		ok = ok and type(src) == "string" and string.find(src, "local v", 1, true) ~= nil
		ok = ok and inst.validate() and #inst.topoOrder() == 4
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="ARK7508">
<Properties>
<string name="Name">B_0344_theme_registry</string>
<ProtectedString name="Source">-- ARKHER SYSTEM B.0344 :: Theme Registry
-- Category B - ARKHER STUDIO / IDE
-- ARKHER Studio capability: the authoring environment, its documents, panels, tools and history.
-- Kit: registry (catalogued editor records, tags and queries)
--@arkher-module
return function(A)
	local Kits = A:import("arkher/runtime/kits")
	local Vec = A:import("arkher/kernel/vec")

	local S = {}
	S.id = "B.0344"
	S.key = "arkher.studio.theme.registry"
	S.name = "Theme Registry"
	S.category = "B"
	S.family = "ARKHER STUDIO / IDE"
	S.area = "Theme"
	S.aspect = "Registry"
	S.kit = "registry"
	S.version = "1.0.0"
	S.deps = { "arkher.studio.theme.node_editor" }
	S.tags = { "b", "theme", "registry", "studio" }
	S.description = "Theme Registry: catalogued editor records, tags and queries for the Theme subsystem."
	S.params = {
		backlogLimit = 43,
		baseRadius = 280,
		baseWeight = 0.75,
		bias = 0.35,
		biasWeight = 0.2,
		ceiling = 467,
		detailWeight = 0.35,
		failureTolerance = 0,
		horizon = 4,
		integrator = "verlet",
		minConfidence = 0.75,
		minThrottle = 0.175,
		regressionSlope = 0.125,
		saturation = 0.7,
		scale = 2.5
	}
	S.features = { "define", "get", "has", "remove", "withTag", "query", "ids", "snapshot", "restore", "stats", "upsert", "bulkDefine", "tally", "export", "describe", "health", "integrate", "selfTest" }

	function S.create(ctx)
		ctx = ctx or {}
		local inst = Kits.create("registry", { id = "arkher.studio.theme.registry" })
		inst.system = S
		inst.ctx = ctx

	function inst.upsert(id, data, tags) return inst.define(id, data, tags) end
	function inst.bulkDefine(list)
		local n = 0
		for _, rec in ipairs(list) do
			if inst.define(rec.id, rec.data, rec.tags) then n = n + 1 end
		end
		return n
	end
	function inst.tally()
		local out = {}
		for _, id in ipairs(inst.ids()) do
			for _, tag in ipairs(inst.records[id].tags) do out[tag] = (out[tag] or 0) + 1 end
		end
		return out
	end
	function inst.export() return { area = S.area, count = inst.stats().count, records = inst.snapshot() } end

		function inst.describe()
			return { id = S.id, key = S.key, name = S.name, category = S.category, family = S.family,
				area = S.area, aspect = S.aspect, kit = S.kit, features = S.features,
				params = S.params, stats = inst.stats() }
		end

		function inst.health()
			local st = inst.stats()
			local status = "ok"
			for k, v in pairs(st) do
				if k == "failures" and type(v) == "number" and v &gt; 0 then status = "degraded" end
				if k == "blocked" and type(v) == "number" and v &gt; 0 and status == "ok" then status = "throttled" end
			end
			return { system = S.key, status = status, stats = st }
		end

		function inst.integrate(engine)
			if not engine then return false end
			inst.engine = engine
			if engine.bus then
				engine.bus:subscribe("arkher.studio.theme.*", function(payload) inst.lastSignal = payload end)
			end
			if engine.registry then engine.registry[S.key] = inst end
			return true
		end

		function inst.selfTest()
			local ok, err = pcall(function()
		inst.define("probe.a", { weight = 1 }, { "probe" })
		inst.define("probe.b", { weight = 2 }, { "probe", "heavy" })
		local ok = inst.stats().count == 2 and #inst.withTag("probe") == 2 and inst.get("probe.b").weight == 2
		inst.remove("probe.a") inst.remove("probe.b")
		return ok
			end)
			if not ok then return false, tostring(err) end
			return err == true or err == nil, err
		end

		return inst
	end

	return S
end
