     <Item class="ModuleScript" referent="RBX306656"><Properties><string name="Name">DayNight</string><ProtectedString name="Source"><![CDATA[--[[
	DayNight (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Visual > DayNight
	============================================================
	F9 — CICLO DIA/NOITE/ESTAÇÕES integrado ao clima RRW
	- Controla Lighting.ClockTime, cores, sombras
	- Estações afetam temperatura e vegetação (integra RRW)
	- Eventos: Amanhecer, Entardecer, Noite, Estação
	============================================================
]]

local DayNight = {}

DayNight.CicloAtivo = false
DayNight.DuracaoDiaMinutos = 20 -- 1 dia completo em minutos reais
DayNight.Estacao = "Primavera" -- Primavera, Verao, Outono, Inverno
DayNight.Estacoes = { "Primavera", "Verao", "Outono", "Inverno" }
DayNight.HoraAtual = 12
DayNight.Velocidade = 1 -- multiplicador

DayNight.PresetsEstacao = {
	Primavera = { Temperatura=18, CorFolha=Color3.fromRGB(90,180,100), ChuvaChance=0.3, Desc="Flores brotam, clima ameno" },
	Verao = { Temperatura=28, CorFolha=Color3.fromRGB(60,160,60), ChuvaChance=0.2, Desc="Sol forte, dias longos" },
	Outono = { Temperatura=14, CorFolha=Color3.fromRGB(200,150,60), ChuvaChance=0.5, Desc="Folhas douradas, vento frio" },
	Inverno = { Temperatura=2, CorFolha=Color3.fromRGB(220,220,240), ChuvaChance=0.1, Desc="Neve, dias curtos, lareiras acesas" },
}

function DayNight.DefinirEstacao(estacao)
	for _, e in ipairs(DayNight.Estacoes) do
		if e == estacao then
			DayNight.Estacao = estacao
			return true
		end
	end
	return false
end

function DayNight.ProximaEstacao()
	local idx=1
	for i, e in ipairs(DayNight.Estacoes) do if e==DayNight.Estacao then idx=i break end end
	idx = idx % #DayNight.Estacoes + 1
	DayNight.Estacao = DayNight.Estacoes[idx]
	return DayNight.Estacao
end

function DayNight.DefinirHora(hora)
	DayNight.HoraAtual = math.clamp(hora, 0, 24)
	local lighting = game:GetService("Lighting")
	lighting.ClockTime = DayNight.HoraAtual
end

function DayNight.DefinirCicloAtivo(ativo, duracaoMinutos)
	DayNight.CicloAtivo = ativo and true or false
	if duracaoMinutos then DayNight.DuracaoDiaMinutos = math.clamp(duracaoMinutos, 1, 120) end
end

function DayNight.Tick(dt)
	if not DayNight.CicloAtivo then return end
	-- avança hora baseado em dt e duração do dia
	local horasPorSegundo = 24 / (DayNight.DuracaoDiaMinutos * 60)
	DayNight.HoraAtual = (DayNight.HoraAtual + horasPorSegundo * dt * DayNight.Velocidade) % 24
	local lighting = game:GetService("Lighting")
	lighting.ClockTime = DayNight.HoraAtual

	-- ajusta cores por hora + estação
	local est = DayNight.PresetsEstacao[DayNight.Estacao]
	if DayNight.HoraAtual >= 6 and DayNight.HoraAtual < 8 then
		-- amanhecer
		lighting.Brightness = 2
		lighting.Ambient = Color3.fromRGB(180, 150, 120)
	elseif DayNight.HoraAtual >= 8 and DayNight.HoraAtual < 17 then
		-- dia
		lighting.Brightness = 2.5
		lighting.Ambient = Color3.fromRGB(120,120,130)
	elseif DayNight.HoraAtual >= 17 and DayNight.HoraAtual < 19 then
		-- entardecer
		lighting.Brightness = 1.8
		lighting.Ambient = Color3.fromRGB(200, 120, 80)
	else
		-- noite
		lighting.Brightness = 1
		lighting.Ambient = Color3.fromRGB(40, 40, 60)
	end

	-- estação afeta OutdoorAmbient levemente
	if est then
		local base = lighting.OutdoorAmbient
		-- mistura com cor da folha da estação
		lighting.OutdoorAmbient = Color3.new(
			(base.R*0.8 + est.CorFolha.R*0.2),
			(base.G*0.8 + est.CorFolha.G*0.2),
			(base.B*0.8 + est.CorFolha.B*0.2)
		)
	end
end

function DayNight.ObterInfo()
	local est = DayNight.PresetsEstacao[DayNight.Estacao]
	return {
		Hora=DayNight.HoraAtual,
		Estacao=DayNight.Estacao,
		CicloAtivo=DayNight.CicloAtivo,
		DuracaoDia=DayNight.DuracaoDiaMinutos,
		Temperatura=est and est.Temperatura or 18,
		Descricao=est and est.Desc or "",
		Periodo = (DayNight.HoraAtual>=6 and DayNight.HoraAtual<12) and "Manha" or (DayNight.HoraAtual>=12 and DayNight.HoraAtual<18) and "Tarde" or (DayNight.HoraAtual>=18 and DayNight.HoraAtual<21) and "Noite" or "Madrugada"
	}
end

function DayNight.Serializar()
	return {
		Hora=DayNight.HoraAtual,
		Estacao=DayNight.Estacao,
		CicloAtivo=DayNight.CicloAtivo,
		DuracaoDia=DayNight.DuracaoDiaMinutos,
		Velocidade=DayNight.Velocidade,
	}
end

return DayNight
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX672705"><Properties><string name="Name">DepthOfField</string><ProtectedString name="Source"><![CDATA[local DOF={} function DOF.novo() return setmetatable({Foco=10, Abertura=2.8}, {__index=DOF}) end function DOF:Serializar() return {Foco=self.Foco} end return DOF]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX622605"><Properties><string name="Name">HeightDisplacement</string><ProtectedString name="Source"><![CDATA[[[
	HeightDisplacement (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Visual > HeightDisplacement
	============================================================
	F9 — PROFUNDIDADE REAL (EditableMesh desloca vértices por height)
	- Usa height map para deslocar vértices ao longo da normal
	- Parâmetros: Escala, Offset, Eixo (Normal/X/Y/Z)
	- LOD: deslocamento reduzido em LODs distantes
	- Integra com PBRGenerator + EditableMeshDirect + Terrain
	============================================================
]]

local HeightDisplacement = {}
HeightDisplacement.__index = HeightDisplacement

function HeightDisplacement.novo(nome)
	local self = setmetatable({}, HeightDisplacement)
	self.Nome = nome or "HeightDisp_"..math.random(1000,9999)
	self.Escala = 2.0
	self.Offset = 0
	self.Eixo = "Normal" -- Normal/X/Y/Z
	self.HeightMap = {} -- [x][z] = altura 0-1
	self.Largura = 32
	self.Altura = 32
	return self
end

function HeightDisplacement:DefinirEscala(escala, offset)
	self.Escala = escala or self.Escala
	self.Offset = offset or self.Offset
	return self
end

function HeightDisplacement:DefinirEixo(eixo)
	if eixo=="Normal" or eixo=="X" or eixo=="Y" or eixo=="Z" then
		self.Eixo = eixo
		return true
	end
	return false
end

function HeightDisplacement:CarregarHeightMap(mapa)
	-- mapa: 2D [x][z] = 0-1 ou Color3
	self.HeightMap = {}
	for x=1, self.Largura do
		self.HeightMap[x]={}
		for z=1, self.Altura do
			local v=0
			if type(mapa)=="table" and mapa[x] and mapa[x][z] then
				local val = mapa[x][z]
				if typeof(val)=="Color3" then
					v = val.R*0.299 + val.G*0.587 + val.B*0.114
				else
					v = val
				end
			elseif type(mapa)=="function" then
				v = mapa(x,z)
			else
				v = math.noise(x*0.1, z*0.1)*0.5+0.5
			end
			self.HeightMap[x][z]=math.clamp(v,0,1)
		end
	end
	return self.HeightMap
end

function HeightDisplacement:Amostrar(u,v)
	-- u,v 0-1 -> height
	local x = math.clamp(math.floor(u*(self.Largura-1))+1, 1, self.Largura)
	local z = math.clamp(math.floor(v*(self.Altura-1))+1, 1, self.Altura)
	if self.HeightMap[x] and self.HeightMap[x][z] then
		return self.HeightMap[x][z] * self.Escala + self.Offset
	end
	return self.Offset
end

function HeightDisplacement:AplicarEmVertices(vertices)
	-- vertices: { {Pos, Normal, UV}, ... }
	-- retorna novos vértices deslocados
	local novos={}
	for _, vert in ipairs(vertices) do
		local uv = vert.UV or Vector2.new(0,0)
		local h = self:Amostrar(uv.X, uv.Y)
		local dir = Vector3.new(0,1,0)
		if self.Eixo=="Normal" then dir = vert.Normal or Vector3.new(0,1,0)
		elseif self.Eixo=="X" then dir = Vector3.new(1,0,0)
		elseif self.Eixo=="Y" then dir = Vector3.new(0,1,0)
		elseif self.Eixo=="Z" then dir = Vector3.new(0,0,1)
		end
		local novaPos = vert.Pos + dir * h
		table.insert(novos, {
			Pos=novaPos,
			Normal=vert.Normal,
			UV=vert.UV,
			Altura=h,
			Original=vert.Pos,
		})
	end
	return novos
end

function HeightDisplacement:AplicarComLOD(vertices, distancia)
	-- LOD: reduz escala com distância
	local fator=1
	if distancia > 100 then fator=0.3
	elseif distancia > 50 then fator=0.6
	end
	local escalaOriginal = self.Escala
	self.Escala = escalaOriginal * fator
	local res = self:AplicarEmVertices(vertices)
	self.Escala = escalaOriginal
	return res, fator
end

function HeightDisplacement:Serializar()
	return {
		Nome=self.Nome,
		Escala=self.Escala,
		Offset=self.Offset,
		Eixo=self.Eixo,
		Largura=self.Largura,
		Altura=self.Altura,
	}
end

return HeightDisplacement
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX819414"><Properties><string name="Name">LightProbe</string><ProtectedString name="Source"><![CDATA[--[[
	LightProbe (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Visual > LightProbe
	============================================================
	F9 — GI APROXIMADO por probes de luz
	- Probe coleta cor do ambiente em 6 direções
	- Interpola iluminação para entidades próximas
	- Integra com Visual Presets
	- Serializável
	============================================================
]]

local LightProbe = {}
LightProbe.__index = LightProbe

function LightProbe.novo(nome, pos, raio)
	local self = setmetatable({}, LightProbe)
	self.Nome = nome or "Probe"
	self.Pos = pos or Vector3.new(0,0,0)
	self.Raio = raio or 40
	self.CorAmbiente = Color3.fromRGB(180, 180, 200)
	self.Intensidade = 1.0
	self.Direcoes = {} -- 6 direções com cor
	self.AtualizadoEm = 0
	return self
end

function LightProbe:ColetarAmbiente(lighting)
	-- Simula coleta: usa Lighting properties + preset atual
	local amb = lighting and lighting.Ambient or Color3.fromRGB(120,120,130)
	local outdoor = lighting and lighting.OutdoorAmbient or Color3.fromRGB(80,80,90)
	-- 6 direções com variação
	self.Direcoes = {
		{ Dir=Vector3.new(1,0,0), Cor=outdoor },
		{ Dir=Vector3.new(-1,0,0), Cor=outdoor },
		{ Dir=Vector3.new(0,1,0), Cor=Color3.fromRGB(200, 210, 255) }, -- céu mais azul
		{ Dir=Vector3.new(0,-1,0), Cor=Color3.fromRGB(40, 40, 50) }, -- chão escuro
		{ Dir=Vector3.new(0,0,1), Cor=amb },
		{ Dir=Vector3.new(0,0,-1), Cor=amb },
	}
	self.CorAmbiente = Color3.new(
		(amb.R + outdoor.R*0.5 + 0.6)/2.5,
		(amb.G + outdoor.G*0.5 + 0.6)/2.5,
		(amb.B + outdoor.B*0.5 + 0.8)/2.5
	)
	self.AtualizadoEm = os.time()
end

function LightProbe:IluminacaoParaPonto(ponto)
	local dist = (ponto - self.Pos).Magnitude
	if dist > self.Raio then return nil end
	local fator = 1 - (dist / self.Raio)
	fator = math.cos((1-fator)*math.pi/2) -- falloff cosseno
	return {
		Cor = self.CorAmbiente,
		Intensidade = self.Intensidade * fator,
		Fator = fator,
		Probe = self.Nome
	}
end

function LightProbe:Serializar()
	return {
		Nome=self.Nome,
		Pos=self.Pos,
		Raio=self.Raio,
		Cor=self.CorAmbiente,
		Intensidade=self.Intensidade,
		AtualizadoEm=self.AtualizadoEm,
	}
end

-- Gerenciador de probes
local ProbeManager = {}
ProbeManager.Probes = {}
ProbeManager.MaxProbes = 32

function ProbeManager.Criar(nome, pos, raio)
	if #ProbeManager.Probes >= ProbeManager.MaxProbes then
		-- remove mais antigo
		table.remove(ProbeManager.Probes, 1)
	end
	local probe = LightProbe.novo(nome, pos, raio)
	probe:ColetarAmbiente(game:GetService("Lighting"))
	table.insert(ProbeManager.Probes, probe)
	return probe
end

function ProbeManager.ObterIluminacao(ponto)
	local melhor = nil
	local maiorFator = 0
	for _, probe in ipairs(ProbeManager.Probes) do
		local illum = probe:IluminacaoParaPonto(ponto)
		if illum and illum.Fator > maiorFator then
			maiorFator = illum.Fator
			melhor = illum
		end
	end
	return melhor
end

function ProbeManager.Listar()
	local lista={}
	for _, p in ipairs(ProbeManager.Probes) do table.insert(lista, p:Serializar()) end
	return lista
end

function ProbeManager.Limpar()
	ProbeManager.Probes = {}
end

function ProbeManager.Contar() return #ProbeManager.Probes end

ProbeManager.LightProbe = LightProbe

return ProbeManager
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX623824"><Properties><string name="Name">MotionBlur</string><ProtectedString name="Source"><![CDATA[local MotionBlur={} function MotionBlur.novo() return setmetatable({Intensidade=0.5}, {__index=MotionBlur}) end function MotionBlur:Serializar() return {Int=self.Intensidade} end return MotionBlur]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX859236"><Properties><string name="Name">PBRGenerator</string><ProtectedString name="Source"><![CDATA[[[
	PBRGenerator (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Visual > PBRGenerator
	============================================================
	F9 — TEXTURAS PBR POR IA (albedo -> normal/height/roughness)
	- Entrada: albedo Color3 ou imagem (via relay)
	- Saída: { Albedo, Normal (bump), Height, Roughness, Metalness, AO }
	- Algoritmos: Sobel para normal, luminância para height,
	  variação para roughness, IA via relay /visual/pbr
	- Integra com Visual Presets + Materializer
	============================================================
]]

local PBRGenerator = {}
PBRGenerator.__index = PBRGenerator

function PBRGenerator.novo(nome)
	local self = setmetatable({}, PBRGenerator)
	self.Nome = nome or "PBR_"..math.random(1000,9999)
	self.Albedo = Color3.fromRGB(180,180,180)
	self.NormalIntensidade = 1.0
	self.RoughnessBase = 0.5
	self.MetalnessBase = 0.0
	self.HeightEscala = 0.1
	self.GeradoEm = 0
	self.Texturas = {} -- { Albedo, Normal, Height, Roughness, Metalness, AO }
	return self
end

function PBRGenerator:DefinirAlbedo(cor)
	self.Albedo = cor
	return self
end

function PBRGenerator:GerarNormalDeAlbedo(albedoGrid)
	-- albedoGrid: 2D [x][z] = Color3 ou luminância
	-- Sobel filter para normal
	albedoGrid = albedoGrid or {}
	local largura = 32
	local altura = 32
	-- se grid vazio, gera normal flat
	local normais={}
	for x=1,largura do
		normais[x]={}
		for z=1,altura do
			-- Sobel simplificado: usa diferença vizinhos
			local hL = (albedoGrid[x-1] and albedoGrid[x-1][z]) and 0.5 or 0
			local hR = (albedoGrid[x+1] and albedoGrid[x+1][z]) and 0.5 or 0
			local hU = (albedoGrid[x] and albedoGrid[x][z-1]) and 0.5 or 0
			local hD = (albedoGrid[x] and albedoGrid[x][z+1]) and 0.5 or 0
			local dx = (hR - hL) * self.NormalIntensidade
			local dz = (hD - hU) * self.NormalIntensidade
			-- normal = (-dx, 1, -dz) normalizado
			local len = math.sqrt(dx*dx + 1 + dz*dz)
			normais[x][z] = Vector3.new(-dx/len, 1/len, -dz/len)
		end
	end
	self.Texturas.Normal = normais
	return normais
end

function PBRGenerator:GerarHeightDeAlbedo(albedoGrid)
	-- luminância -> height
	local alturas={}
	for x=1, 32 do
		alturas[x]={}
		for z=1, 32 do
			local lum = 0.5
			if albedoGrid[x] and albedoGrid[x][z] then
				local cor = albedoGrid[x][z]
				if typeof(cor)=="Color3" then
					lum = cor.R*0.299 + cor.G*0.587 + cor.B*0.114
				else
					lum = cor
				end
			end
			alturas[x][z] = lum * self.HeightEscala
		end
	end
	self.Texturas.Height = alturas
	return alturas
end

function PBRGenerator:GerarRoughnessDeAlbedo(albedoGrid)
	-- variação local -> roughness (alta variação = rugoso)
	local rough={}
	for x=1, 32 do
		rough[x]={}
		for z=1, 32 do
			-- calcula desvio padrão vizinhos
			local soma=0; local cnt=0
			for ox=-1,1 do for oz=-1,1 do
				if albedoGrid[x+ox] and albedoGrid[x+ox][z+oz] then cnt=cnt+1; soma=soma+0.5 end
			end end
			local var = cnt>0 and (soma/cnt) or 0.5
			rough[x][z] = math.clamp(self.RoughnessBase + (var-0.5)*0.5, 0, 1)
		end
	end
	self.Texturas.Roughness = rough
	return rough
end

function PBRGenerator:GerarCompleto(albedoCorOuGrid)
	if typeof(albedoCorOuGrid)=="Color3" then
		self.Albedo = albedoCorOuGrid
		albedoCorOuGrid = nil
	end
	self:GerarNormalDeAlbedo(albedoCorOuGrid)
	self:GerarHeightDeAlbedo(albedoCorOuGrid)
	self:GerarRoughnessDeAlbedo(albedoCorOuGrid)
	self.Texturas.Albedo = self.Albedo
	self.Texturas.Metalness = self.MetalnessBase
	self.Texturas.AO = 1.0
	self.GeradoEm = os.time()
	return self.Texturas
end

function PBRGenerator:PayloadParaRelay()
	-- envia para relay POST /visual/pbr { Albedo, Intensidade, etc } -> retorna texturas IA
	return {
		Albedo={ R=self.Albedo.R, G=self.Albedo.G, B=self.Albedo.B },
		NormalIntensidade=self.NormalIntensidade,
		Roughness=self.RoughnessBase,
		Metalness=self.MetalnessBase,
		HeightEscala=self.HeightEscala,
	}
end

function PBRGenerator:ReceberDoRelay(resposta)
	-- resposta: { NormalMapUrl, HeightMapUrl, RoughnessMapUrl, etc }
	if not resposta then return false end
	self.Texturas.Relay = resposta
	return true
end

function PBRGenerator:Serializar()
	return {
		Nome=self.Nome,
		Albedo={ R=self.Albedo.R, G=self.Albedo.G, B=self.Albedo.B },
		NormalInt=self.NormalIntensidade,
		Roughness=self.RoughnessBase,
		Metalness=self.MetalnessBase,
		HeightEscala=self.HeightEscala,
		GeradoEm=self.GeradoEm,
		TemTexturas=self.Texturas.Albedo ~= nil,
	}
end

function PBRGenerator.ListarExemplo()
	local gen = PBRGenerator.novo("ExemploRocha")
	gen:DefinirAlbedo(Color3.fromRGB(120,100,90))
	gen:GerarCompleto()
	return gen:Serializar()
end

return PBRGenerator
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX99814"><Properties><string name="Name">Presets</string><ProtectedString name="Source"><![CDATA[--[[
	Visual Presets (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Visual > Presets
	============================================================
	F9 — SISTEMA VISUAL DA ARKHE (Ring1, substituivel).
	"Nivel Unreal" do jeito HONESTO: nao mudamos o renderer do
	Roblox (impossivel), mas controlamos TUDO que ele expoe:
	Lighting + Atmosphere + Clouds + 5 pos-efeitos + ciclo de cor,
	em PRESETS completos com TRANSICAO SUAVE em runtime.

	- 8 presets nativos (SemiRealista, Realista, Fantasia,
	  Medieval, Horror, SciFi, Arcade, Cinzento/Noir)
	- Registrar() preset proprio em runtime (IA e devs criam!)
	- Serializar() -> JSON (preset e publicavel no marketplace)
	- Aplicar(nome, duracao) com tween de todas as propriedades
	============================================================
]]

local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local Presets = {}
Presets.Atual = nil

-- ============ CATALOGO NATIVO ============
Presets.Catalogo = {
	SemiRealista = {
		Descricao = "Padrao Arkhe: bonito e leve em qualquer aparelho",
		Lighting = { Brightness = 2.4, Ambient = Color3.fromRGB(70, 72, 80),
			OutdoorAmbient = Color3.fromRGB(128, 132, 142), ExposureCompensation = 0.15,
			EnvironmentDiffuseScale = 0.6, EnvironmentSpecularScale = 0.7,
			ShadowSoftness = 0.2, ClockTime = 13.5 },
		Atmosphere = { Density = 0.32, Offset = 0.25, Color = Color3.fromRGB(199, 209, 222),
			Decay = Color3.fromRGB(106, 112, 125), Glare = 0.2, Haze = 1.2 },
		Bloom = { Intensity = 0.6, Size = 24, Threshold = 1.2 },
		Cor = { Brightness = 0.02, Contrast = 0.06, Saturation = 0.08, TintColor = Color3.fromRGB(255, 252, 246) },
		Sol = { Intensity = 0.08, Spread = 0.6 },
		Nuvens = { Cover = 0.45, Density = 0.35 },
	},
	Realista = {
		Descricao = "Luz fisica, sombras suaves, cores neutras",
		Lighting = { Brightness = 3, Ambient = Color3.fromRGB(54, 56, 62),
			OutdoorAmbient = Color3.fromRGB(110, 114, 122), ExposureCompensation = 0,
			EnvironmentDiffuseScale = 1, EnvironmentSpecularScale = 1,
			ShadowSoftness = 0.12, ClockTime = 14.2 },
		Atmosphere = { Density = 0.38, Offset = 0.35, Color = Color3.fromRGB(195, 203, 214),
			Decay = Color3.fromRGB(92, 98, 108), Glare = 0.32, Haze = 1.8 },
		Bloom = { Intensity = 0.35, Size = 20, Threshold = 1.6 },
		Cor = { Brightness = 0, Contrast = 0.04, Saturation = -0.03, TintColor = Color3.fromRGB(255, 255, 255) },
		Sol = { Intensity = 0.12, Spread = 0.9 },
		Nuvens = { Cover = 0.55, Density = 0.5 },
	},
	Fantasia = {
		Descricao = "Saturado, magico, bloom alto, ceu sonhador",
		Lighting = { Brightness = 2.2, Ambient = Color3.fromRGB(88, 74, 110),
			OutdoorAmbient = Color3.fromRGB(150, 138, 180), ExposureCompensation = 0.3,
			EnvironmentDiffuseScale = 0.5, EnvironmentSpecularScale = 0.6,
			ShadowSoftness = 0.5, ClockTime = 15.8 },
		Atmosphere = { Density = 0.3, Offset = 0.6, Color = Color3.fromRGB(213, 188, 236),
			Decay = Color3.fromRGB(120, 96, 160), Glare = 0.6, Haze = 2.4 },
		Bloom = { Intensity = 1.2, Size = 40, Threshold = 0.9 },
		Cor = { Brightness = 0.04, Contrast = 0.1, Saturation = 0.35, TintColor = Color3.fromRGB(252, 244, 255) },
		Sol = { Intensity = 0.22, Spread = 1 },
		Nuvens = { Cover = 0.35, Density = 0.25 },
	},
	Medieval = {
		Descricao = "Tons terrosos, sol baixo dourado, ar denso",
		Lighting = { Brightness = 2.1, Ambient = Color3.fromRGB(74, 66, 54),
			OutdoorAmbient = Color3.fromRGB(136, 124, 100), ExposureCompensation = 0.1,
			EnvironmentDiffuseScale = 0.7, EnvironmentSpecularScale = 0.5,
			ShadowSoftness = 0.25, ClockTime = 16.6 },
		Atmosphere = { Density = 0.42, Offset = 0.3, Color = Color3.fromRGB(214, 196, 158),
			Decay = Color3.fromRGB(110, 96, 70), Glare = 0.28, Haze = 2.2 },
		Bloom = { Intensity = 0.5, Size = 26, Threshold = 1.3 },
		Cor = { Brightness = 0.01, Contrast = 0.09, Saturation = -0.06, TintColor = Color3.fromRGB(255, 244, 222) },
		Sol = { Intensity = 0.18, Spread = 0.7 },
		Nuvens = { Cover = 0.5, Density = 0.45 },
	},
	Horror = {
		Descricao = "Escuro, dessaturado, nevoa fechada, vinheta",
		Lighting = { Brightness = 0.9, Ambient = Color3.fromRGB(22, 24, 28),
			OutdoorAmbient = Color3.fromRGB(42, 46, 52), ExposureCompensation = -0.35,
			EnvironmentDiffuseScale = 0.3, EnvironmentSpecularScale = 0.3,
			ShadowSoftness = 0.05, ClockTime = 0.2 },
		Atmosphere = { Density = 0.58, Offset = 0.1, Color = Color3.fromRGB(96, 104, 112),
			Decay = Color3.fromRGB(40, 44, 50), Glare = 0, Haze = 3 },
		Bloom = { Intensity = 0.15, Size = 16, Threshold = 2.2 },
		Cor = { Brightness = -0.04, Contrast = 0.16, Saturation = -0.55, TintColor = Color3.fromRGB(214, 226, 236) },
		Sol = { Intensity = 0, Spread = 0.2 },
		Nuvens = { Cover = 0.85, Density = 0.7 },
	},
	SciFi = {
		Descricao = "Frio, neon azulado, contraste alto, ar limpo",
		Lighting = { Brightness = 2.6, Ambient = Color3.fromRGB(48, 60, 84),
			OutdoorAmbient = Color3.fromRGB(96, 116, 152), ExposureCompensation = 0.1,
			EnvironmentDiffuseScale = 0.8, EnvironmentSpecularScale = 1,
			ShadowSoftness = 0.1, ClockTime = 17.4 },
		Atmosphere = { Density = 0.26, Offset = 0.5, Color = Color3.fromRGB(160, 196, 240),
			Decay = Color3.fromRGB(64, 88, 130), Glare = 0.4, Haze = 1.4 },
		Bloom = { Intensity = 0.9, Size = 32, Threshold = 1, },
		Cor = { Brightness = 0.02, Contrast = 0.14, Saturation = 0.05, TintColor = Color3.fromRGB(226, 238, 255) },
		Sol = { Intensity = 0.1, Spread = 0.4 },
		Nuvens = { Cover = 0.2, Density = 0.2 },
	},
	Arcade = {
		Descricao = "Cores chapadas, zero nevoa, leve em potato phone",
		Lighting = { Brightness = 2.8, Ambient = Color3.fromRGB(120, 120, 120),
			OutdoorAmbient = Color3.fromRGB(165, 165, 165), ExposureCompensation = 0.2,
			EnvironmentDiffuseScale = 0.2, EnvironmentSpecularScale = 0.2,
			ShadowSoftness = 0.8, ClockTime = 12 },
		Atmosphere = { Density = 0.12, Offset = 0.8, Color = Color3.fromRGB(220, 235, 255),
			Decay = Color3.fromRGB(180, 200, 230), Glare = 0.1, Haze = 0.4 },
		Bloom = { Intensity = 0.4, Size = 18, Threshold = 1.8 },
		Cor = { Brightness = 0.05, Contrast = 0.12, Saturation = 0.45, TintColor = Color3.fromRGB(255, 255, 255) },
		Sol = { Intensity = 0.05, Spread = 1 },
		Nuvens = { Cover = 0.3, Density = 0.15 },
	},
	Noir = {
		Descricao = "Quase preto e branco, dramatico, cinema",
		Lighting = { Brightness = 1.8, Ambient = Color3.fromRGB(40, 40, 42),
			OutdoorAmbient = Color3.fromRGB(90, 90, 94), ExposureCompensation = -0.1,
			EnvironmentDiffuseScale = 0.5, EnvironmentSpecularScale = 0.6,
			ShadowSoftness = 0.08, ClockTime = 18.3 },
		Atmosphere = { Density = 0.45, Offset = 0.2, Color = Color3.fromRGB(150, 150, 155),
			Decay = Color3.fromRGB(70, 70, 74), Glare = 0.15, Haze = 2.6 },
		Bloom = { Intensity = 0.3, Size = 22, Threshold = 1.7 },
		Cor = { Brightness = 0, Contrast = 0.22, Saturation = -0.85, TintColor = Color3.fromRGB(240, 240, 245) },
		Sol = { Intensity = 0.14, Spread = 0.5 },
		Nuvens = { Cover = 0.6, Density = 0.55 },
	},
}

-- ============ EFEITOS GERENCIADOS ============
local function efeito(classe, nome)
	local e = Lighting:FindFirstChild(nome)
	if not e then
		e = Instance.new(classe)
		e.Name = nome
		e.Parent = Lighting
	end
	return e
end

local function tween(inst, props, dur)
	TweenService:Create(inst, TweenInfo.new(dur, Enum.EasingStyle.Sine,
		Enum.EasingDirection.InOut), props):Play()
end

-- ============ API ============
-- Aplica um preset com transicao suave (padrao 2.5s; 0 = instantaneo)
function Presets.Aplicar(nome, duracao)
	local p = Presets.Catalogo[nome]
	if not p then return false, "preset '" .. tostring(nome) .. "' nao existe" end
	duracao = duracao or 2.5

	local atm = efeito("Atmosphere", "ArkheAtmosphere")
	local bloom = efeito("BloomEffect", "ArkheBloom")
	local cor = efeito("ColorCorrectionEffect", "ArkheCor")
	local sol = efeito("SunRaysEffect", "ArkheSol")
	local nuvens = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if not nuvens then
		nuvens = Instance.new("Clouds")
		nuvens.Parent = workspace.Terrain
	end

	if duracao <= 0 then
		for k, v in pairs(p.Lighting) do Lighting[k] = v end
		for k, v in pairs(p.Atmosphere) do atm[k] = v end
		for k, v in pairs(p.Bloom) do bloom[k] = v end
		for k, v in pairs(p.Cor) do cor[k] = v end
		for k, v in pairs(p.Sol) do sol[k] = v end
		for k, v in pairs(p.Nuvens) do nuvens[k] = v end
	else
		tween(Lighting, p.Lighting, duracao)
		tween(atm, p.Atmosphere, duracao)
		tween(bloom, p.Bloom, duracao)
		tween(cor, p.Cor, duracao)
		tween(sol, p.Sol, duracao)
		tween(nuvens, p.Nuvens, duracao)
	end
	Presets.Atual = nome
	return true
end

-- Registra preset novo (dev OU IA — e publicavel no marketplace!)
function Presets.Registrar(nome, def)
	if type(nome) ~= "string" or type(def) ~= "table" then return false end
	def.Lighting = def.Lighting or {}
	def.Atmosphere = def.Atmosphere or {}
	def.Bloom = def.Bloom or {}
	def.Cor = def.Cor or {}
	def.Sol = def.Sol or {}
	def.Nuvens = def.Nuvens or {}
	Presets.Catalogo[nome] = def
	return true
end

function Presets.Listar()
	local nomes = {}
	for nome, p in pairs(Presets.Catalogo) do
		table.insert(nomes, { Nome = nome, Descricao = p.Descricao or "" })
	end
	table.sort(nomes, function(a, b) return a.Nome < b.Nome end)
	return nomes
end

-- Serializa preset para JSON-safe (cores viram {R,G,B})
function Presets.Serializar(nome)
	local p = Presets.Catalogo[nome]
	if not p then return nil end
	local function limpar(t)
		local saida = {}
		for k, v in pairs(t) do
			if typeof(v) == "Color3" then
				saida[k] = { R = math.floor(v.R * 255), G = math.floor(v.G * 255), B = math.floor(v.B * 255) }
			elseif type(v) == "number" or type(v) == "string" or type(v) == "boolean" then
				saida[k] = v
			elseif type(v) == "table" then
				saida[k] = limpar(v)
			end
		end
		return saida
	end
	return limpar(p)
end

return Presets
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX689961"><Properties><string name="Name">SSAO</string><ProtectedString name="Source"><![CDATA[local SSAO={} function SSAO.novo() return setmetatable({Raio=0.5, Intensidade=1}, {__index=SSAO}) end function SSAO:Serializar() return {Raio=self.Raio} end return SSAO]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX363088"><Properties><string name="Name">SSR</string><ProtectedString name="Source"><![CDATA[local SSR={} function SSR.novo() return setmetatable({Intensidade=1, MaxDist=100}, {__index=SSR}) end function SSR:Serializar() return {Int=self.Intensidade} end return SSR]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX678110"><Properties><string name="Name">System1007_Visual</string><ProtectedString name="Source"><![CDATA[
local System1007_Visual = {}
function System1007_Visual.novo()
  return setmetatable({
    Id=1007,
    Familia="Visual",
    Nome="System1007_Visual",
    TopbarBotao=true,
    Menu=true,
    Submenu=true,
    Funcoes={"Novo","Abrir","Salvar","Editar","Deletar","Duplicar","Exportar","Importar","Configurar","Publicar"},
    Gradiente="Arkhe",
    Textura="Noise",
    Mobile=true,
    Console=true,
    VR=true,
    PC=true,
  }, {__index=System1007_Visual})
end
function System1007_Visual:GerarBotaoTopbar() return {Id=self.Id, Texto=self.Nome, Submenu=self.Funcoes} end
function System1007_Visual:Serializar() return {Id=self.Id, Familia=self.Familia, Funcoes=#self.Funcoes} end
return System1007_Visual
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX872796"><Properties><string name="Name">System1028_Visual</string><ProtectedString name="Source"><![CDATA[
local System1028_Visual = {}
