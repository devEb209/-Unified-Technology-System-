     <Item class="ModuleScript" referent="RBX578505"><Properties><string name="Name">Icons</string><ProtectedString name="Source"><![CDATA[--[[
  Icons (ModuleScript)
  Local: ReplicatedStorage > Arkhe > UI > Icons
  ============================================================================
  SEM EMOJIS - Ícones personalizados/imagens
  - Substitui todos emojis por rbxassetid:// custom
  - Textura e gradiente suportados
  - Usado por Topbar, MenuBar, Explorer, Properties
  ============================================================================
]]

local Icons = {}
Icons.__index = Icons

Icons.Mapa = {
  -- Topbar
  ARQUIVO = "rbxassetid://14928074405", -- custom file icon
  EDITAR = "rbxassetid://14928074406",
  EXIBIR = "rbxassetid://14928074407",
  INSERIR = "rbxassetid://14928074408",
  TERRENO = "rbxassetid://14928074409",
  MODELAGEM = "rbxassetid://14928074410",
  ANIMACAO = "rbxassetid://14928074411",
  NPC = "rbxassetid://14928074412",
  FISICA = "rbxassetid://14928074413",
  VISUAL = "rbxassetid://14928074414",
  UI = "rbxassetid://14928074415",
  AUDIO = "rbxassetid://14928074416",
  IMPORT = "rbxassetid://14928074417",
  PUBLICAR = "rbxassetid://14928074418",
  OTIMIZAR = "rbxassetid://14928074419",
  MULTIPLAYER = "rbxassetid://14928074420",
  ECONOMIA = "rbxassetid://14928074421",
  CINEMATICA = "rbxassetid://14928074422",
  ACESSIBILIDADE = "rbxassetid://14928074423",
  ANALYTICS = "rbxassetid://14928074424",
  EDUCACAO = "rbxassetid://14928074425",
  VR = "rbxassetid://14928074426",
  -- Ações
  RECORTAR = "rbxassetid://14928074427",
  COPIAR = "rbxassetid://14928074428",
  COLAR = "rbxassetid://14928074429",
  DUPLICAR = "rbxassetid://14928074430",
  DELETAR = "rbxassetid://14928074431",
  RENOMEAR = "rbxassetid://14928074432",
  AGRUPAR = "rbxassetid://14928074433",
  DESAGRUPAR = "rbxassetid://14928074434",
  MOVER = "rbxassetid://14928074435",
  -- Serviços custom
  ARKHE_REALIDADE = "rbxassetid://14928074436",
  ARKHE_TERRAIN = "rbxassetid://14928074437",
  ARKHE_MODELER = "rbxassetid://14928074438",
  ARKHE_ANIMATOR = "rbxassetid://14928074439",
  ARKHE_NPC = "rbxassetid://14928074440",
  -- Properties
  CAIXA_TEXTO = "rbxassetid://14928074441",
  CAIXA_NUMERO = "rbxassetid://14928074442",
  CAIXA_SELECAO = "rbxassetid://14928074443",
  SELETOR_COR = "rbxassetid://14928074444",
  VETOR3 = "rbxassetid://14928074445",
  DROPDOWN = "rbxassetid://14928074446",
  -- Gizmos
  GIZMO_MOVER = "rbxassetid://14928074447",
  GIZMO_ROTACIONAR = "rbxassetid://14928074448",
  GIZMO_ESCALAR = "rbxassetid://14928074449",
  GIZMO_TRANSFORM = "rbxassetid://14928074450",
}

function Icons.novo()
  return setmetatable({Cache={}}, {__index=Icons})
end

function Icons:Obter(nome)
  return self.Mapa[nome] or "rbxassetid://0"
end

function Icons:Listar() return self.Mapa end

function Icons:RegistrarCustom(nome, assetId)
  self.Mapa[nome] = assetId
end

function Icons:Serializar()
  local n=0 for _ in pairs(self.Mapa) do n=n+1 end
  return {TotalIcones=n, SemEmojis=true, Textura=true, Gradiente=true}
end

return Icons
]]></ProtectedString></Properties></Item>
