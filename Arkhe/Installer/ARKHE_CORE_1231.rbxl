     <Item class="ModuleScript" referent="RBX879985"><Properties><string name="Name">CanvasVisual</string><ProtectedString name="Source"><![CDATA[--[[
	CanvasVisual (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Analytics > CanvasVisual
	============================================================
	F20 — MAPA DE CALOR VISUAL COM CORES + EXPORT CSV
	- Canvas: grade 2D desenhada em Frame com UIGradient ou
	  lista de Frames coloridos
	- Cores: usa FunnelVisual.CorParaIntensidade
	- Export: CSV com celula,count,intensidade
	- Integra com Heatmap + FunnelVisual + HeatmapLive
	============================================================
]]

local CanvasVisual = {}
CanvasVisual.__index = CanvasVisual

function CanvasVisual.novo(nome, largura, altura)
	local self = setmetatable({}, CanvasVisual)
	self.Nome = nome or "Canvas_"..math.random(1000,9999)
	self.Largura = largura or 20
	self.Altura = altura or 20
	self.Celulas = {} -- [x][z] = { Count, Intensidade, Cor }
	self.MaxCount = 0
	return self
end

function CanvasVisual:CarregarDeHeatmap(heatmapMod)
	-- heatmapMod: Heatmap.lua com Grade
	if not heatmapMod or not heatmapMod.Grade then return 0 end
	self.Celulas={}
	self.MaxCount=0
	for chave, dados in pairs(heatmapMod.Grade) do
		if dados.Count > self.MaxCount then self.MaxCount = dados.Count end
	end
	if self.MaxCount==0 then self.MaxCount=1 end
	for chave, dados in pairs(heatmapMod.Grade) do
		-- chave "x_z"
		local x,z = string.match(chave, "([^_]+)_([^_]+)")
		x = tonumber(x) or 0; z = tonumber(z) or 0
		local intensidade = dados.Count / self.MaxCount
		-- cor: verde->amarelo->vermelho
		local r = math.clamp(intensidade*2, 0, 1)
		local g = math.clamp(2 - intensidade*2, 0, 1)
		local cor = Color3.new(r,g,0)
		self.Celulas[chave] = {
			Chave=chave,
			X=x, Z=z,
			Count=dados.Count,
			Intensidade=intensidade,
			Cor={ R=cor.R, G=cor.G, B=cor.B },
		}
	end
	return self.MaxCount
end

function CanvasVisual:GerarFramesParaUI()
	-- retorna lista de frames para criar na UI
	local frames={}
	for chave, cel in pairs(self.Celulas) do
		table.insert(frames, {
			Chave=chave,
			Pos={ X=cel.X, Z=cel.Z },
			Cor=cel.Cor,
			Intensidade=cel.Intensidade,
			Count=cel.Count,
			Tamanho=1, -- tamanho relativo
		})
	end
	table.sort(frames, function(a,b) return a.Count > b.Count end)
	return frames
end

function CanvasVisual:ExportarCSV()
	local linhas={"celula_x,celula_z,count,intensidade,cor_r,cor_g,cor_b"}
	for chave, cel in pairs(self.Celulas) do
		table.insert(linhas, string.format("%d,%d,%d,%.3f,%.3f,%.3f,%.3f",
			cel.X, cel.Z, cel.Count, cel.Intensidade, cel.Cor.R, cel.Cor.G, cel.Cor.B))
	end
	return table.concat(linhas, "\n")
end

function CanvasVisual:ExportarJSON()
	local dados={
		Nome=self.Nome,
		Largura=self.Largura,
		Altura=self.Altura,
		MaxCount=self.MaxCount,
		Celulas=self.Celulas,
	}
	local ok, HttpService = pcall(function() return game:GetService("HttpService") end)
	if ok then
		local ok2, json = pcall(function() return HttpService:JSONEncode(dados) end)
		if ok2 then return json end
	end
	return nil
end

function CanvasVisual:TopQuentes(n)
	n = n or 5
	local lista={}
	for _, cel in pairs(self.Celulas) do table.insert(lista, cel) end
	table.sort(lista, function(a,b) return a.Count > b.Count end)
	local top={}
	for i=1, math.min(n, #lista) do table.insert(top, lista[i]) end
	return top
end

function CanvasVisual:Serializar()
	return {
		Nome=self.Nome,
		TotalCelulas=(function() local c=0 for _ in pairs(self.Celulas) do c=c+1 end return c end)(),
		MaxCount=self.MaxCount,
		Top=self:TopQuentes(3),
	}
end

return CanvasVisual
]]></ProtectedString></Properties></Item>
