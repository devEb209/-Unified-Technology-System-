     <Item class="ModuleScript" referent="RBX103674"><Properties><string name="Name">Occlusion</string><ProtectedString name="Source"><![CDATA[--[[
	Occlusion (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Audio > Occlusion
	============================================================
	F15 — OCLUSÃO REAL VIA RAYCAST RRW
	- Calcula oclusão entre fonte e ouvinte por raycast
	- Se tem parede/montanha entre, reduz volume + aplica filtro low-pass
	- Materiais absorvem: Madeira 0.3, Rocha 0.8, Metal 0.9 etc
	- Integra com RRW World Raycast + Audio3D + ReverbZone
	============================================================
]]

local Occlusion = {}
Occlusion.__index = Occlusion

Occlusion.AbsorcaoMateriais = {
	Madeira=0.3,
	Rocha=0.8,
	Metal=0.9,
	Vidro=0.2,
	Terra=0.5,
	Areia=0.4,
	Agua=0.6,
	Neve=0.3,
	Grama=0.2,
	Cristal=0.4,
}

function Occlusion.novo()
	local self = setmetatable({}, Occlusion)
	self.Historico = {} -- { Fonte, Ouvinte, Oclusao, Quando }
	return self
end

function Occlusion:CalcularOclusaoSimples(posFonte, posOuvinte, world)
	-- world: RRW World com Raycast ou HeightField
	local dir = posOuvinte - posFonte
	local dist = dir.Magnitude
	if dist < 1 then return 0, {} end
	dir = dir.Unit

	-- se tem world Raycast, usa
	local obstaculos={}
	local oclusao=0
	if world and world.Raycast then
		local ok, resultado = pcall(function()
			return world:Raycast(posFonte, dir, dist)
		end)
		if ok and resultado and resultado.Acertou then
			-- tem obstáculo
			local material = resultado.Material or "Rocha"
			local absorcao = Occlusion.AbsorcaoMateriais[material] or 0.5
			oclusao = absorcao
			table.insert(obstaculos, { Material=material, Dist=resultado.Distancia or dist*0.5, Absorcao=absorcao })
		end
	else
		-- fallback: checa altura terreno entre pontos (se montanha no meio)
		-- simula 3 amostras
		for i=1,3 do
			local t = i/4
			local ponto = posFonte:Lerp(posOuvinte, t)
			-- se ponto Y < altura terreno, ocluso
			-- simplificado: se Y < 10, considera rocha
			if ponto.Y < 5 then
				oclusao = math.max(oclusao, 0.7)
				table.insert(obstaculos, { Material="Rocha", Dist=dist*t, Absorcao=0.7 })
			end
		end
	end

	table.insert(self.Historico, {
		Fonte=posFonte,
		Ouvinte=posOuvinte,
		Oclusao=oclusao,
		Obstaculos=obstaculos,
		Quando=os.time(),
		Dist=dist,
	})
	if #self.Historico > 30 then table.remove(self.Historico,1) end

	return oclusao, obstaculos
end

function Occlusion:CalcularVolumeComOclusao(volumeBase, oclusao, distancia, raioMax)
	-- aplica oclusão + atenuação distância
	local volDist = volumeBase * (1 - math.clamp(distancia/(raioMax or 80), 0, 1)*0.8)
	local volOcluso = volDist * (1 - oclusao*0.8)
	return math.clamp(volOcluso, 0, volumeBase)
end

function Occlusion:CalcularFiltroLowPass(oclusao)
	-- quanto mais ocluso, mais grave (low-pass)
	-- retorna cutoff 0-1 (1 = sem filtro, 0 = muito filtrado)
	return 1 - oclusao*0.7
end

function Occlusion:ListarMateriais()
	local lista={}
	for mat, abs in pairs(Occlusion.AbsorcaoMateriais) do
		table.insert(lista, { Material=mat, Absorcao=abs })
	end
	return lista
end

function Occlusion:Serializar()
	return {
		TotalCalculos=#self.Historico,
		Materiais=self:ListarMateriais(),
		Ultimo=self.Historico[#self.Historico],
	}
end

return Occlusion
]]></ProtectedString></Properties></Item>
