     <Item class="ModuleScript" referent="RBX68726"><Properties><string name="Name">Crowd</string><ProtectedString name="Source"><![CDATA[--[[
	Crowd (ModuleScript)
	Local: ReplicatedStorage > Arkhe > NPC > Crowd
	============================================================
	F7 — MULTIDÕES 100+ com LOD e flocking simples
	- Gerencia muitos NPCs com steering: separação, alinhamento, coesão
	- LOD: perto full AI, médio só steering, longe hiberna
	- Formações: Circulo, Linha, V, Multidão
	============================================================
]]

local Crowd = {}
Crowd.__index = Crowd

function Crowd.novo(nome, maxNPCs)
	local self = setmetatable({}, Crowd)
	self.Nome = nome or "Multidao"
	self.MaxNPCs = maxNPCs or 100
	self.Membros = {} -- { Modelo, PosAlvo, Vel, Estado }
	self.Formacao = "Multidao"
	self.Centro = Vector3.new(0,0,0)
	self.Raio = 60
	return self
end

function Crowd:AdicionarMembro(modelo, posAlvo)
	if #self.Membros >= self.MaxNPCs then return false end
	table.insert(self.Membros, { Modelo=modelo, PosAlvo=posAlvo or self.Centro, Vel=Vector3.new(0,0,0), Estado="Vagar" })
	return true
end

function Crowd:DefinirCentro(pos, raio)
	self.Centro = pos
	self.Raio = raio or self.Raio
end

function Crowd:DefinirFormacao(formacao)
	local validas = { Circulo=true, Linha=true, V=true, Multidao=true, Quadrado=true }
	if validas[formacao] then
		self.Formacao = formacao
		return true
	end
	return false
end

-- Calcula posições de formação
function Crowd:CalcularFormacao()
	local posicoes={}
	local n=#self.Membros
	if n==0 then return posicoes end
	if self.Formacao == "Circulo" then
		for i=1,n do
			local ang = (i/n)*math.pi*2
			table.insert(posicoes, self.Centro + Vector3.new(math.cos(ang)*self.Raio, 0, math.sin(ang)*self.Raio))
		end
	elseif self.Formacao == "Linha" then
		for i=1,n do
			local offset = (i - n/2) * 4
			table.insert(posicoes, self.Centro + Vector3.new(offset, 0, 0))
		end
	elseif self.Formacao == "V" then
		for i=1,n do
			local lado = (i%2==0) and 1 or -1
			local fila = math.floor(i/2)
			table.insert(posicoes, self.Centro + Vector3.new(fila*4, 0, lado*fila*3))
		end
	elseif self.Formacao == "Quadrado" then
		local lado = math.ceil(math.sqrt(n))
		for i=1,n do
			local x = (i-1)%lado
			local z = math.floor((i-1)/lado)
			table.insert(posicoes, self.Centro + Vector3.new((x-lado/2)*4, 0, (z-lado/2)*4))
		end
	else -- Multidao random
		for i=1,n do
			local ang = math.random()*6.28
			local d = math.random()*self.Raio
			table.insert(posicoes, self.Centro + Vector3.new(math.cos(ang)*d, 0, math.sin(ang)*d))
		end
	end
	return posicoes
end

-- Tick flocking simples
function Crowd:Tick(dt, jogadores)
	local posForm = self:CalcularFormacao()
	for i, membro in ipairs(self.Membros) do
		if not membro.Modelo or not membro.Modelo.Parent then
			-- remove morto
		else
			local hrp = membro.Modelo:FindFirstChild("HumanoidRootPart") or membro.Modelo.PrimaryPart
			if hrp then
				local posAtual = hrp.Position
				-- LOD por distância do jogador mais próximo
				local distJogador = math.huge
				for _, j in ipairs(jogadores or {}) do
					local d = (j.Pos - posAtual).Magnitude
					if d < distJogador then distJogador = d end
				end
				if distJogador > 300 then
					-- longe: hiberna
				elseif distJogador > 120 then
					-- médio: só vai para formação, sem AI
					local alvo = posForm[i] or self.Centro
					local dir = (alvo - posAtual)
					if dir.Magnitude > 2 then
						membro.Vel = membro.Vel:Lerp(dir.Unit * 6, 0.1)
						hrp.CFrame = CFrame.new(posAtual + membro.Vel*dt, posAtual + membro.Vel)
					end
				else
					-- perto: flocking + separação
					local alvo = posForm[i] or self.Centro
					local dirAlvo = (alvo - posAtual)
					local forca = Vector3.new(0,0,0)
					if dirAlvo.Magnitude > 3 then forca = forca + dirAlvo.Unit * 4 end
					-- separação
					for j, outro in ipairs(self.Membros) do
						if i~=j and outro.Modelo and outro.Modelo:FindFirstChild("HumanoidRootPart") then
							local posOutro = outro.Modelo.HumanoidRootPart.Position
							local d = (posAtual - posOutro).Magnitude
							if d < 6 and d > 0.1 then
								forca = forca + (posAtual - posOutro).Unit * (6-d) * 0.8
							end
						end
					end
					membro.Vel = membro.Vel:Lerp(forca, 0.15)
					if membro.Vel.Magnitude > 0.5 then
						hrp.CFrame = CFrame.new(posAtual + membro.Vel*dt, posAtual + membro.Vel + posAtual)
					end
				end
			end
		end
	end
end

function Crowd:Contar() return #self.Membros end
function Crowd:Limpar()
	for _, m in ipairs(self.Membros) do if m.Modelo then m.Modelo:Destroy() end end
	self.Membros={}
end

function Crowd:Serializar()
	return { Nome=self.Nome, Total=#self.Membros, Formacao=self.Formacao, Centro=self.Centro, Raio=self.Raio }
end

return Crowd
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX332985"><Properties><string name="Name">Dialogue</string><ProtectedString name="Source"><![CDATA[--[[
	Dialogue (ModuleScript)
	Local: ReplicatedStorage > Arkhe > NPC > Dialogue
	============================================================
	F7 — DIÁLOGOS COM MEMÓRIA
	- Árvore de diálogo: nós com texto, opções, condições, ações
	- Memória por NPC: lembra escolhas do jogador, relacionamentos
	- Integra com Quest e Inventory
	- Serializável
	============================================================
]]

local Dialogue = {}
Dialogue.__index = Dialogue

function Dialogue.novo(id, nome)
	local self = setmetatable({}, Dialogue)
	self.Id = id or "dialog_"..math.random(1000,9999)
	self.Nome = nome or "Dialogo"
	self.Nos = {} -- [noId] = { Texto, Opcoes={ {Texto, ProximoNo, Condicao, Acao} }, OnEnter }
	self.Inicio = "inicio"
	self.MemoriaGlobal = {} -- [userId][npcId] = { Escolhas, Relacionamento, Flags }
	return self
end

function Dialogue:AdicionarNo(noId, texto, onEnter)
	self.Nos[noId] = { Id=noId, Texto=texto or "...", Opcoes={}, OnEnter=onEnter }
	if not self.Nos[self.Inicio] then self.Inicio = noId end
	return self.Nos[noId]
end

function Dialogue:AdicionarOpcao(deNoId, textoOpcao, paraNoId, condicao, acao)
	local no = self.Nos[deNoId]
	if not no then return nil end
	table.insert(no.Opcoes, {
		Texto=textoOpcao,
		Proximo=paraNoId,
		Condicao=condicao, -- { Tipo="TemItem", Nome="Madeira" } ou função
		Acao=acao, -- { Tipo="DarItem", Nome="Madeira", Qtd=1 }
		Id=#no.Opcoes+1
	})
	return #no.Opcoes
end

function Dialogue:ObterNo(noId)
	return self.Nos[noId]
end

-- Memória por jogador+npc
function Dialogue:ObterMemoria(userId, npcId)
	self.MemoriaGlobal[userId] = self.MemoriaGlobal[userId] or {}
	self.MemoriaGlobal[userId][npcId] = self.MemoriaGlobal[userId][npcId] or { Escolhas={}, Relacionamento=0, Flags={}, UltimoNo=self.Inicio }
	return self.MemoriaGlobal[userId][npcId]
end

function Dialogue:RegistrarEscolha(userId, npcId, deNo, opcaoIdx, paraNo)
	local mem = self:ObterMemoria(userId, npcId)
	table.insert(mem.Escolhas, { De=deNo, Opcao=opcaoIdx, Para=paraNo, Quando=os.time() })
	mem.UltimoNo = paraNo
	-- relacionamento: opções positivas aumentam
	if opcaoIdx == 1 then mem.Relacionamento = math.min(100, mem.Relacionamento + 5)
	elseif opcaoIdx == 2 then mem.Relacionamento = math.max(-100, mem.Relacionamento - 2) end
end

function Dialogue:DefinirFlag(userId, npcId, flag, valor)
	local mem = self:ObterMemoria(userId, npcId)
	mem.Flags[flag] = valor
end

function Dialogue:TemFlag(userId, npcId, flag)
	local mem = self:ObterMemoria(userId, npcId)
	return mem.Flags[flag] == true
end

-- Verifica condição simples
function Dialogue:ChecarCondicao(cond, userId, npcId, inventario)
	if not cond then return true end
	if type(cond) == "function" then
		local ok, res = pcall(cond, userId, npcId)
		return ok and res or false
	end
	if cond.Tipo == "TemItem" and inventario then
		return inventario.Tem and inventario:Tem(cond.Nome, cond.Qtd or 1) or false
	elseif cond.Tipo == "RelacionamentoMaior" then
		local mem = self:ObterMemoria(userId, npcId)
		return mem.Relacionamento >= (cond.Valor or 0)
	elseif cond.Tipo == "Flag" then
		return self:TemFlag(userId, npcId, cond.Nome) == (cond.Valor ~= false)
	end
	return true
end

function Dialogue:OpcoesDisponiveis(noId, userId, npcId, inventario)
	local no = self.Nos[noId]
	if not no then return {} end
	local disponiveis={}
	for i, op in ipairs(no.Opcoes) do
		if self:ChecarCondicao(op.Condicao, userId, npcId, inventario) then
			table.insert(disponiveis, { Indice=i, Texto=op.Texto, Proximo=op.Proximo, Acao=op.Acao })
		end
	end
	return disponiveis
end

function Dialogue:Serializar()
	return {
		Id=self.Id,
		Nome=self.Nome,
		Inicio=self.Inicio,
		TotalNos=0 + (function() local n=0 for _ in pairs(self.Nos) do n=n+1 end return n end)(),
		Nos=self.Nos,
	}
end

function Dialogue.ListarExemplo()
	local d = Dialogue.novo("exemplo", "Aldeao")
	d:AdicionarNo("inicio", "Olá, viajante! O que te traz à vila?")
	d:AdicionarNo("missao", "Precisamos de 10 madeiras para reconstruir a ponte.")
	d:AdicionarNo("loja", "Tenho alguns itens à venda...")
	d:AdicionarNo("adeus", "Volte sempre!")
	d:AdicionarOpcao("inicio", "O que vocês precisam?", "missao")
	d:AdicionarOpcao("inicio", "O que vende?", "loja")
	d:AdicionarOpcao("inicio", "Adeus", "adeus")
	d:AdicionarOpcao("missao", "Aceito a missão", "adeus", nil, { Tipo="IniciarQuest", Id="lenhador" })
	d:AdicionarOpcao("missao", "Depois eu volto", "inicio")
	d:AdicionarOpcao("loja", "Mostrar loja", "adeus", nil, { Tipo="AbrirLoja" })
	d:AdicionarOpcao("adeus", "Até logo", "inicio")
	return d
end

return Dialogue
]]></ProtectedString></Properties></Item>
