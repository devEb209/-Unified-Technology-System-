     <Item class="ModuleScript" referent="RBX388640"><Properties><string name="Name">UVUnwrap</string><ProtectedString name="Source"><![CDATA[[[
	UVUnwrap (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Modeler > UVUnwrap
	============================================================
	F5 — UV UNWRAP PROCEDURAL
	- Projeções: Planar, Cilíndrica, Esférica, Box, Smart
	- Cada vértice EditableModel: Pos + Normal -> UV
	- Packing simples: atlas 0-1 com ilhas
	- Integra com EditableModel: AplicarUV(modelo, modo)
	============================================================
]]

local UVUnwrap = {}

UVUnwrap.Modos = {
	Planar = { Desc="Projeção planar no eixo Y (chão), ideal para terreno" },
	Cilindrica = { Desc="Cilíndrica em Y, ideal para troncos/colunas" },
	Esferica = { Desc="Esférica, ideal para rochas/orgânicos" },
	Box = { Desc="Box mapping 6 lados, ideal para construções" },
	Smart = { Desc="Smart: escolhe melhor eixo por normal" },
}

function UVUnwrap.CalcularUV(pos, normal, modo, escala)
	escala = escala or 1
	modo = modo or "Planar"
	local u,v=0,0
	if modo=="Planar" then
		u = (pos.X * escala) % 1
		v = (pos.Z * escala) % 1
	elseif modo=="Cilindrica" then
		local ang = math.atan2(pos.Z, pos.X)
		u = (ang / (2*math.pi) + 0.5) % 1
		v = (pos.Y * escala) % 1
	elseif modo=="Esferica" then
		local r = math.sqrt(pos.X*pos.X + pos.Y*pos.Y + pos.Z*pos.Z)
		if r < 0.001 then r=0.001 end
		local theta = math.acos(pos.Y / r)
		local phi = math.atan2(pos.Z, pos.X)
		u = (phi / (2*math.pi) + 0.5) % 1
		v = (theta / math.pi) % 1
	elseif modo=="Box" then
		-- escolhe eixo dominante da normal
		local ax = math.abs(normal.X)
		local ay = math.abs(normal.Y)
		local az = math.abs(normal.Z)
		if ax >= ay and ax >= az then
			u = (pos.Z * escala) % 1
			v = (pos.Y * escala) % 1
		elseif ay >= ax and ay >= az then
			u = (pos.X * escala) % 1
			v = (pos.Z * escala) % 1
		else
			u = (pos.X * escala) % 1
			v = (pos.Y * escala) % 1
		end
	elseif modo=="Smart" then
		-- similar Box mas com blend
		local ax = math.abs(normal.X)
		local ay = math.abs(normal.Y)
		local az = math.abs(normal.Z)
		if ay > 0.7 then
			u = (pos.X * escala) % 1
			v = (pos.Z * escala) % 1
		elseif ax > 0.7 then
			u = (pos.Z * escala) % 1
			v = (pos.Y * escala) % 1
		else
			u = (pos.X * escala) % 1
			v = (pos.Y * escala) % 1
		end
	end
	return u, v
end

function UVUnwrap.AplicarEmModelo(modelo, modo, escala)
	-- modelo: EditableModel com Vertices {Pos, Normal}
	-- retorna lista de UVs
	escala = escala or 0.2
	modo = modo or "Smart"
	local uvs={}
	if not modelo or not modelo.Vertices then return uvs end
	for i, vert in ipairs(modelo.Vertices) do
		local pos = vert.Pos or Vector3.new(0,0,0)
		local normal = vert.Normal or Vector3.new(0,1,0)
		local u,v = UVUnwrap.CalcularUV(pos, normal, modo, escala)
		table.insert(uvs, { Indice=i, U=u, V=v, Modo=modo })
		-- se modelo suporta, escreve
		if vert.UV ~= nil then
			vert.UV = Vector2.new(u,v)
		end
	end
	return uvs
end

function UVUnwrap.PackAtlas(uvs, tamanhoAtlas)
	tamanhoAtlas = tamanhoAtlas or 1024
	-- packing simples: grid
	local lado = math.ceil(math.sqrt(#uvs))
	local celula = 1/lado
	for i, uv in ipairs(uvs) do
		local gx = (i-1) % lado
		local gy = math.floor((i-1)/lado)
		-- remap uv para dentro da célula
		uv.U = (gx + uv.U*0.8 + 0.1) * celula
		uv.V = (gy + uv.V*0.8 + 0.1) * celula
		uv.Celula = { X=gx, Y=gy }
	end
	return uvs
end

function UVUnwrap.ListarModos()
	local lista={}
	for nome, info in pairs(UVUnwrap.Modos) do
		table.insert(lista, { Nome=nome, Desc=info.Desc })
	end
	return lista
end

function UVUnwrap.SerializarExemplo()
	return {
		Modos=UVUnwrap.ListarModos(),
		ExemploUV=UVUnwrap.CalcularUV(Vector3.new(1,2,3), Vector3.new(0,1,0), "Smart", 0.2),
	}
end

return UVUnwrap
]]></ProtectedString></Properties></Item>
    </Item>
