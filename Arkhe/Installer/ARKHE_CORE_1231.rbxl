     <Item class="ModuleScript" referent="RBX825007"><Properties><string name="Name">Timeline</string><ProtectedString name="Source"><![CDATA[--[[
	Timeline (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Animator > Timeline
	============================================================
	F6 — TIMELINE / PLAYER DE ANIMACAO (Ring1).

	Controla playback de AnimationClip:
	- Play, Pause, Stop, Scrub
	- Loop, velocidade, peso (blend)
	- Camadas de animacao (base + override)
	- Eventos: OnKeyframe, OnLoop, OnFim

	Integra com RigIK para IK em runtime e com RigFactory para
	aplicar pose procedural em Motor6D.
	============================================================
]]

local Timeline = {}
Timeline.__index = Timeline

function Timeline.novo(clip)
	local self = setmetatable({}, Timeline)
	self.Clip = clip
	self.Tempo = 0
	self.Velocidade = 1
	self.Peso = 1
	self.Tocando = false
	self.Loop = clip and clip.Loop or true
	self.Eventos = {} -- [evento] = {cb, ...}
	self.Camadas = {} -- { Timeline, Peso } para blend
	return self
end

function Timeline:Ouvir(evento, cb)
	self.Eventos[evento] = self.Eventos[evento] or {}
	table.insert(self.Eventos[evento], cb)
end

function Timeline:Emitir(evento, dados)
	local lista = self.Eventos[evento]
	if lista then
		for _, cb in ipairs(lista) do task.spawn(cb, dados) end
	end
end

function Timeline:Play()
	self.Tocando = true
	self:Emitir("Play", { Tempo = self.Tempo })
end

function Timeline:Pause()
	self.Tocando = false
	self:Emitir("Pause", { Tempo = self.Tempo })
end

function Timeline:Stop()
	self.Tocando = false
	self.Tempo = 0
	self:Emitir("Stop", {})
end

function Timeline:Scrub(tempo)
	tempo = math.clamp(tempo or 0, 0, self.Clip and self.Clip.Duracao or 10)
	self.Tempo = tempo
	self:Emitir("Scrub", { Tempo = tempo })
end

function Timeline:Tick(dt)
	if not self.Tocando or not self.Clip then return nil end
	local prev = self.Tempo
	self.Tempo = self.Tempo + dt * self.Velocidade

	if self.Clip.Duracao > 0 then
		if self.Tempo >= self.Clip.Duracao then
			if self.Loop then
				self.Tempo = self.Tempo % self.Clip.Duracao
				self:Emitir("Loop", { Tempo = self.Tempo })
			else
				self.Tempo = self.Clip.Duracao
				self.Tocando = false
				self:Emitir("Fim", {})
			end
		end
	end

	-- detecta keyframe cruzado (para eventos)
	if self.Clip.Tracks then
		for osso, kfs in pairs(self.Clip.Tracks) do
			for _, kf in ipairs(kfs) do
				if (prev < kf.Tempo and self.Tempo >= kf.Tempo) or (prev > kf.Tempo and self.Tempo < kf.Tempo) then
					self:Emitir("Keyframe", { Osso = osso, Tempo = kf.Tempo })
				end
			end
		end
	end

	return self.Clip:Avaliar(self.Tempo)
end

function Timeline:ObterPose()
	if not self.Clip then return {} end
	return self.Clip:Avaliar(self.Tempo)
end

-- Blend de duas poses: poseA * (1-t) + poseB * t
function Timeline.BlendPoses(poseA, poseB, t)
	t = math.clamp(t or 0.5, 0, 1)
	local resultado = {}
	for osso, cfA in pairs(poseA) do
		local cfB = poseB[osso]
		if cfB then
			resultado[osso] = cfA:Lerp(cfB, t)
		else
			resultado[osso] = cfA
		end
	end
	for osso, cfB in pairs(poseB) do
		if not resultado[osso] then resultado[osso] = cfB end
	end
	return resultado
end

function Timeline:AdicionarCamada(clip, peso)
	peso = peso or 0.5
	local tl = Timeline.novo(clip)
	tl.Peso = peso
	table.insert(self.Camadas, tl)
	return tl
end

function Timeline:PoseComCamadas()
	local base = self:ObterPose()
	for _, camada in ipairs(self.Camadas) do
		if camada.Tocando then
			local poseC = camada:ObterPose()
			base = Timeline.BlendPoses(base, poseC, camada.Peso)
		end
	end
	return base
end

-- Puppeteering: grava pose atual de um modelo (Motor6D C0) como keyframe
function Timeline:GravarPoseDoModelo(modelo, tempo)
	if not modelo or not self.Clip then return 0 end
	tempo = tempo or self.Tempo
	local count = 0
	for _, motor in ipairs(modelo:GetDescendants()) do
		if motor:IsA("Motor6D") then
			-- grava C0 como keyframe para o osso = Part1.Name
			local osso = motor.Part1 and motor.Part1.Name or motor.Name
			self.Clip:AdicionarKeyframe(osso, tempo, motor.C0)
			count = count + 1
		end
	end
	return count
end

return Timeline
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX307469"><Properties><string name="Name">TimelineVisual</string><ProtectedString name="Source"><![CDATA[--[[
	TimelineVisual (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Animator > TimelineVisual
	============================================================
	F6 — TIMELINE VISUAL DESENHADA COM CURVAS
	- Desenha curvas de animação em Canvas (Frame com linhas)
	- Faixas: PosX/PosY/PosZ/Rot/FOV/Volume etc
	- Keyframes visuais: posição na timeline + easing icon
	- Preview: playhead que se move, scrub
	- Export: para Clip + para TimelineEditor
	============================================================
]]

local TimelineVisual = {}
TimelineVisual.__index = TimelineVisual

function TimelineVisual.novo(nome, duracao)
	local self = setmetatable({}, TimelineVisual)
	self.Nome = nome or "TimelineVis_"..math.random(1000,9999)
	self.Duracao = duracao or 10
	self.Faixas = {} -- [nomeFaixa] = { Nome, Cor, Keyframes={ {Tempo, Valor, Easing} }, Visivel }
	self.Playhead = 0
	self.Zoom = 1.0
	self.Scroll = 0
	return self
end

function TimelineVisual:AdicionarFaixa(nome, cor)
	self.Faixas[nome] = {
		Nome=nome,
		Cor=cor or Color3.fromRGB(100,150,255),
		Keyframes={},
		Visivel=true,
		Altura=40,
	}
	return self.Faixas[nome]
end

function TimelineVisual:AdicionarKeyframe(faixaNome, tempo, valor, easing)
	local faixa = self.Faixas[faixaNome]
	if not faixa then
		faixa = self:AdicionarFaixa(faixaNome)
	end
	tempo = math.clamp(tempo, 0, self.Duracao)
	table.insert(faixa.Keyframes, {
		Tempo=tempo,
		Valor=valor,
		Easing=easing or "SineInOut",
		Id=#faixa.Keyframes+1,
	})
	table.sort(faixa.Keyframes, function(a,b) return a.Tempo < b.Tempo end)
	return #faixa.Keyframes
end

function TimelineVisual:RemoverKeyframe(faixaNome, indice)
	local faixa = self.Faixas[faixaNome]
	if not faixa then return false end
	if faixa.Keyframes[indice] then
		table.remove(faixa.Keyframes, indice)
		return true
	end
	return false
end

function TimelineVisual:MoverPlayhead(tempo)
	self.Playhead = math.clamp(tempo, 0, self.Duracao)
	return self.Playhead
end

function TimelineVisual:Avaliar(faixaNome, tempo)
	local faixa = self.Faixas[faixaNome]
	if not faixa or #faixa.Keyframes == 0 then return nil end
	if #faixa.Keyframes == 1 then return faixa.Keyframes[1].Valor end
	-- encontra segmento
	for i=1, #faixa.Keyframes-1 do
		local k1 = faixa.Keyframes[i]
		local k2 = faixa.Keyframes[i+1]
		if tempo >= k1.Tempo and tempo <= k2.Tempo then
			local t = (tempo - k1.Tempo) / (k2.Tempo - k1.Tempo)
			-- easing simples (poderia usar CurveEditor)
			if k1.Easing == "Linear" then
				-- lerp
				if type(k1.Valor)=="number" then
					return k1.Valor + (k2.Valor - k1.Valor)*t
				else
					return k1.Valor
				end
			else
				-- sine in out
				local eased = -(math.cos(math.pi*t)-1)/2
				if type(k1.Valor)=="number" then
					return k1.Valor + (k2.Valor - k1.Valor)*eased
				else
					return k1.Valor
				end
			end
		end
	end
	-- antes ou depois
	if tempo < faixa.Keyframes[1].Tempo then return faixa.Keyframes[1].Valor end
	return faixa.Keyframes[#faixa.Keyframes].Valor
end

function TimelineVisual:GerarDesenho(larguraPixels, alturaPixels)
	-- retorna dados para desenhar linhas em UI
	larguraPixels = larguraPixels or 800
	alturaPixels = alturaPixels or 400
	local desenhos={}
	for nomeFaixa, faixa in pairs(self.Faixas) do
		if faixa.Visivel then
			local pontos={}
			local numAmostras = 100
			for i=0, numAmostras do
				local t = (i/numAmostras)*self.Duracao
				local val = self:Avaliar(nomeFaixa, t)
				if type(val)=="number" then
					local x = (t/self.Duracao)*larguraPixels
					local y = alturaPixels - (val*alturaPixels*0.8 + alturaPixels*0.1) -- normaliza
					table.insert(pontos, { X=x, Y=y, Tempo=t, Valor=val })
				end
			end
			table.insert(desenhos, { Faixa=nomeFaixa, Cor=faixa.Cor, Pontos=pontos, Keyframes=faixa.Keyframes })
		end
	end
	return desenhos
end

function TimelineVisual:ExportarParaClip()
	local clip = {
		Nome=self.Nome.."_Clip",
		Duracao=self.Duracao,
		Tracks={},
	}
	for nomeFaixa, faixa in pairs(self.Faixas) do
		clip.Tracks[nomeFaixa] = {}
		for _, kf in ipairs(faixa.Keyframes) do
			table.insert(clip.Tracks[nomeFaixa], { Tempo=kf.Tempo, Valor=kf.Valor, Easing=kf.Easing })
		end
	end
	return clip
end

function TimelineVisual:Serializar()
	return {
		Nome=self.Nome,
		Duracao=self.Duracao,
		NumFaixas=(function() local c=0 for _ in pairs(self.Faixas) do c=c+1 end return c end)(),
		Playhead=self.Playhead,
		Zoom=self.Zoom,
		Faixas=(function()
			local l={}
			for nome, f in pairs(self.Faixas) do table.insert(l, { Nome=nome, NumKF=#f.Keyframes, Cor={R=f.Cor.R,G=f.Cor.G,B=f.Cor.B} }) end
			return l
		end)(),
	}
end

return TimelineVisual
]]></ProtectedString></Properties></Item>
    </Item>
    <Item class="Folder" referent="RBX782063">
     <Properties>
      <string name="Name">Audio</string>
     </Properties>
     <Item class="ModuleScript" referent="RBX345798"><Properties><string name="Name">Audio3D</string><ProtectedString name="Source"><![CDATA[[[
	Audio3D (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Audio > Audio3D
	============================================================
	F15 — ÁUDIO 3D SEGUINDO ENTIDADE + ATTENUATION
	- Fonte 3D: { Id, EntidadeId ou Pos, Volume, Pitch, Loop, RaioMax, Rolloff }
	- Seguir entidade: atualiza Pos todo tick a partir de World
	- Attenuation: linear, logarítmica, realista por matéria RRW
	- Occlusão: se parede entre ouvinte e fonte, reduz volume
	- Integra com AudioMixer + MaterialSounds
	============================================================
]]

local Audio3D = {}
Audio3D.__index = Audio3D

Audio3D.ModosRolloff = {
	Linear = { Desc="Volume cai linear até RaioMax" },
	Logaritmico = { Desc="Queda logarítmica, mais natural" },
	Realista = { Desc="Inverso do quadrado, com absorção por matéria" },
}

function Audio3D.novo(id, posOuEntidadeId)
	local self = setmetatable({}, Audio3D)
	self.Id = id or "audio3d_"..math.random(1000,9999)
	self.EntidadeId = type(posOuEntidadeId)=="number" and posOuEntidadeId or nil
	self.Pos = type(posOuEntidadeId)=="userdata" and posOuEntidadeId or Vector3.new(0,0,0)
	self.Volume = 0.7
	self.Pitch = 1
	self.Loop = false
	self.RaioMax = 80
	self.Rolloff = "Logaritmico"
	self.Ativo = true
	self.SoundId = nil
	self.Oclusao = 0 -- 0..1 quanto está ocluso
	return self
end

function Audio3D:DefinirSom(soundId, volume, pitch, loop)
	self.SoundId = soundId
	if volume then self.Volume = volume end
	if pitch then self.Pitch = pitch end
	if loop ~= nil then self.Loop = loop end
	return self
end

function Audio3D:DefinirRolloff(modo, raioMax)
	if Audio3D.ModosRolloff[modo] then self.Rolloff = modo end
	if raioMax then self.RaioMax = raioMax end
	return self
end

function Audio3D:SeguirEntidade(entidadeId)
	self.EntidadeId = entidadeId
	return self
end

function Audio3D:AtualizarPos(world)
	if not world then return self.Pos end
	if self.EntidadeId and world.ObterEntidade then
		local ok, ent = pcall(function() return world:ObterEntidade(self.EntidadeId) end)
		if ok and ent and ent.Pos then
			self.Pos = ent.Pos
		end
	end
	return self.Pos
end

function Audio3D:CalcularVolumeParaOuvinte(posOuvinte, world)
	local dist = (self.Pos - posOuvinte).Magnitude
	if dist >= self.RaioMax then return 0 end
	local vol=0
	if self.Rolloff=="Linear" then
		vol = self.Volume * (1 - dist/self.RaioMax)
	elseif self.Rolloff=="Logaritmico" then
		-- log: 1 / (1 + dist*0.1)
		vol = self.Volume / (1 + dist*0.05)
		-- clamp pelo raio
		vol = vol * (1 - (dist/self.RaioMax)*0.3)
	elseif self.Rolloff=="Realista" then
		-- inverso quadrado + absorção
		local att = 1 / (1 + (dist*dist)/(self.RaioMax*10))
		vol = self.Volume * att
		-- se RRW tem matéria absorvente entre, reduz mais
		if world and world.Raycast then
			-- simula oclusão simples
			vol = vol * (1 - self.Oclusao*0.7)
		end
	end
	return math.clamp(vol, 0, self.Volume)
end

function Audio3D:CalcularOclusao(posOuvinte, world)
	-- raycast simples: se tem parede entre, aumenta oclusão
	if not world or not world.Raycast then
		self.Oclusao = 0
		return 0
	end
	local dir = posOuvinte - self.Pos
	local dist = dir.Magnitude
	if dist < 1 then self.Oclusao=0; return 0 end
	-- aqui usaria world:Raycast, simplifica
	self.Oclusao = 0 -- por padrão sem oclusão, relay pode calcular
	return self.Oclusao
end

function Audio3D:Serializar()
	return {
		Id=self.Id,
		EntidadeId=self.EntidadeId,
		Pos={ X=self.Pos.X, Y=self.Pos.Y, Z=self.Pos.Z },
		Volume=self.Volume,
		Pitch=self.Pitch,
		Loop=self.Loop,
		RaioMax=self.RaioMax,
		Rolloff=self.Rolloff,
		Ativo=self.Ativo,
		SoundId=self.SoundId,
	}
end

function Audio3D.ListarRolloffs()
	local lista={}
	for nome, info in pairs(Audio3D.ModosRolloff) do
		table.insert(lista, { Nome=nome, Desc=info.Desc })
	end
	return lista
end

return Audio3D
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX72346"><Properties><string name="Name">AudioMixer</string><ProtectedString name="Source"><![CDATA[--[[
	AudioMixer (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Audio > AudioMixer
	============================================================
	F15 — AUDIO MIXER POR ZONAS (Ring1).

	- Zonas de audio (caixa/esfera) com musica/ambiente diferente
	- Crossfade suave entre zonas
	- Musica adaptativa por estado do mundo (combate/exploracao/noite)
	- Sons 3D por entidade RRW (som segue entidade materializada)
	- Volume master/musica/efeitos separado
	- Integra com Materia: madeira soa madeira (via MaterialSounds)

	Verdade: Roblox limita numero de Sound simultaneos; mixer
	controla orcamento e evita estouro (max 8 sons 3D perto).
	============================================================
]]

local AudioMixer = {}
AudioMixer.VolumeMaster = 1
AudioMixer.VolumeMusica = 0.8
AudioMixer.VolumeEfeitos = 1
AudioMixer.Zonas = {} -- { Nome, Centro=Vector3, Raio, MusicaId, AmbienteId, Volume }
AudioMixer.Atual = nil
AudioMixer.Fila = {}
AudioMixer.MaxSons3D = 8

function AudioMixer.CriarZona(nome, centro, raio, musicaId, ambienteId, volume)
	local zona = {
		Nome = nome,
		Centro = centro or Vector3.new(0,0,0),
		Raio = raio or 60,
		MusicaId = musicaId,
		AmbienteId = ambienteId,
		Volume = volume or 0.7,
	}
	table.insert(AudioMixer.Zonas, zona)
	return zona
end

function AudioMixer.ZonaNoPonto(pos)
	local melhor, menor = nil, math.huge
	for _, zona in ipairs(AudioMixer.Zonas) do
		local d = (zona.Centro - pos).Magnitude
		if d <= zona.Raio and d < menor then
			menor = d
			melhor = zona
		end
	end
	return melhor
end

function AudioMixer.TocarMusica(id, volume, fadeDur)
	volume = volume or AudioMixer.VolumeMusica
	fadeDur = fadeDur or 1.5
	-- cria Sound em SoundService ou Workspace
	local SoundService = game:GetService("SoundService")
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. tostring(id)
	sound.Volume = 0
	sound.Looped = true
	sound.Parent = SoundService
	sound:Play()
	-- fade in
	local TweenService = game:GetService("TweenService")
	TweenService:Create(sound, TweenInfo.new(fadeDur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Volume = volume * AudioMixer.VolumeMaster }):Play()
	if AudioMixer.Atual and AudioMixer.Atual.Sound then
		-- fade out anterior
		local antigo = AudioMixer.Atual.Sound
		TweenService:Create(antigo, TweenInfo.new(fadeDur, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Volume = 0 }):Play()
		task.delay(fadeDur, function() if antigo then antigo:Destroy() end end)
	end
	AudioMixer.Atual = { Id = id, Sound = sound, Volume = volume }
	return sound
end

function AudioMixer.TocarEfeito3D(pos, id, volume, parent)
	volume = volume or AudioMixer.VolumeEfeitos
	if #AudioMixer.Fila >= AudioMixer.MaxSons3D then
		-- remove mais antigo
		local antigo = table.remove(AudioMixer.Fila, 1)
		if antigo and antigo.Sound then antigo.Sound:Destroy() end
	end
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2,0.2,0.2)
	part.Position = pos
	part.Parent = parent or workspace
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. tostring(id)
	sound.Volume = volume * AudioMixer.VolumeMaster
	sound.RollOffMode = Enum.RollOffMode.Linear
	sound.Parent = part
	sound:Play()
	table.insert(AudioMixer.Fila, { Sound = sound, Part = part, Quando = os.time() })
	task.delay(5, function()
		if part then part:Destroy() end
	end)
	return sound
end

function AudioMixer.AtualizarPorPosicao(pos)
	local zona = AudioMixer.ZonaNoPonto(pos)
	if zona and (not AudioMixer.Atual or AudioMixer.Atual.Id ~= zona.MusicaId) then
		if zona.MusicaId then
			AudioMixer.TocarMusica(zona.MusicaId, zona.Volume, 2)
		end
	end
end

function AudioMixer.MusicaAdaptativa(estado)
	-- estado: Exploracao | Combate | Noite | Perigo | Vitoria
	estado = estado or "Exploracao"
	local mapa = {
		Exploracao = 1843527676, -- placeholder ids (dev troca)
		Combate = 1843527677,
		Noite = 1843527678,
		Perigo = 1843527679,
		Vitoria = 1843527680,
	}
	local id = mapa[estado]
	if id then
		AudioMixer.TocarMusica(id, AudioMixer.VolumeMusica, 1.2)
	end
	return id
end

function AudioMixer.DefinirVolumes(master, musica, efeitos)
	if master then AudioMixer.VolumeMaster = math.clamp(master,0,1) end
	if musica then AudioMixer.VolumeMusica = math.clamp(musica,0,1) end
	if efeitos then AudioMixer.VolumeEfeitos = math.clamp(efeitos,0,1) end
end

function AudioMixer.ListarZonas()
	local lista = {}
	for _, z in ipairs(AudioMixer.Zonas) do
		table.insert(lista, { Nome=z.Nome, Centro={z.Centro.X,z.Centro.Y,z.Centro.Z}, Raio=z.Raio, MusicaId=z.MusicaId })
	end
	return lista
end

function AudioMixer.Limpar()
	for _, z in ipairs(AudioMixer.Zonas) do end
	AudioMixer.Zonas = {}
	if AudioMixer.Atual and AudioMixer.Atual.Sound then
		AudioMixer.Atual.Sound:Destroy()
		AudioMixer.Atual = nil
	end
	for _, f in ipairs(AudioMixer.Fila) do
		if f.Part then f.Part:Destroy() end
	end
	AudioMixer.Fila = {}
end

return AudioMixer
]]></ProtectedString></Properties></Item>
