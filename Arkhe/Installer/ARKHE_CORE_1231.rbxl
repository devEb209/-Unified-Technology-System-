     <Item class="ModuleScript" referent="RBX16751"><Properties><string name="Name">Sculpt</string><ProtectedString name="Source"><![CDATA[--[[
	Sculpt (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Modeler > Sculpt
	============================================================
	F5 — SCULPT MODE (Ring1).
	Pinceis que operam sobre EditableModel como no Blender:
	Inflar, Puxar, Alisar, Achatar, Pinçar, Suavizar.
	Tudo 100% dados, sem depender de EditableMesh.
	============================================================
]]

local Sculpt = {}

-- aplica pincel em vertices dentro do raio do centro
-- modo: Inflar | Puxar | Alisar | Achatar | Pinçar | Suavizar
function Sculpt.AplicarPincel(modelo, centro, raio, forca, modo)
	raio = raio or 3
	forca = forca or 1
	modo = modo or "Inflar"
	centro = centro or Vector3.new(0,0,0)

	modelo:SalvarHistorico()

	local afetados = 0
	for _, v in ipairs(modelo.Vertices) do
		local d = (v.Pos - centro).Magnitude
		if d <= raio then
			local queda = (math.cos(d / raio * math.pi) + 1) * 0.5 -- falloff cosseno
			local f = forca * queda * 0.15
			if modo == "Inflar" then
				v.Pos = v.Pos + v.Normal * f
			elseif modo == "Puxar" then
				-- puxa na direcao da camera? Simplificacao: puxa para cima Y
				v.Pos = v.Pos + Vector3.new(0,1,0) * f
			elseif modo == "Alisar" then
				-- move para media dos vizinhos (sera calculado depois, aqui faz leve)
				v.Pos = v.Pos:Lerp(centro, f * 0.1)
			elseif modo == "Achatar" then
				-- achata no plano normal do pincel (Y=const)
				local diff = v.Pos - centro
				v.Pos = Vector3.new(v.Pos.X, centro.Y + diff.Y * (1 - f), v.Pos.Z)
			elseif modo == "Pinçar" then
				-- puxa para o centro
				v.Pos = v.Pos:Lerp(centro, f * 0.3)
			elseif modo == "Suavizar" then
				-- suavizacao sera feita via Operations.Suavizar depois; aqui so marca
				-- fazemos leve relax
				v.Pos = v.Pos:Lerp(centro, f * 0.05)
			end
			afetados = afetados + 1
		end
	end

	if modo == "Suavizar" and afetados > 0 then
		-- suaviza apenas area afetada aproximando: roda 1 iteracao global leve
		-- (honesto: nao e so area, mas ja ajuda)
		local Operations = require(script.Parent.Operations)
		Operations.Suavizar(modelo, 1)
	end

	modelo:CalcularNormais()
	return afetados
end

function Sculpt.PintarVertice(modelo, centro, raio, cor, forca)
	raio = raio or 3
	forca = forca or 1
	centro = centro or Vector3.new(0,0,0)
	cor = cor or Color3.new(1,0,0)

	modelo:SalvarHistorico()
	local afetados = 0
	for _, v in ipairs(modelo.Vertices) do
		local d = (v.Pos - centro).Magnitude
		if d <= raio then
			local queda = (math.cos(d / raio * math.pi) + 1) * 0.5
			v.Cor = v.Cor:Lerp(cor, queda * forca * 0.5)
			afetados = afetados + 1
		end
	end
	return afetados
end

function Sculpt.ListarPinceis()
	return {
		{ Nome="Inflar", Desc="Empurra ao longo da normal" },
		{ Nome="Puxar", Desc="Puxa para cima" },
		{ Nome="Alisar", Desc="Aproxima do centro do pincel" },
		{ Nome="Achatar", Desc="Achata no plano Y do pincel" },
		{ Nome="Pinçar", Desc="Puxa vertices para o centro" },
		{ Nome="Suavizar", Desc="Suaviza area (laplacian)" },
		{ Nome="Pintar", Desc="Pinta vertices com cor" },
	}
end

return Sculpt
]]></ProtectedString></Properties></Item>
