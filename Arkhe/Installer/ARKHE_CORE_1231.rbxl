    <Item class="Folder" referent="RBX109675">
     <Properties>
      <string name="Name">Economy</string>
     </Properties>
     <Item class="ModuleScript" referent="RBX941632"><Properties><string name="Name">Achievement</string><ProtectedString name="Source"><![CDATA[
local Achievement = {}
function Achievement.novo() return setmetatable({Nome="Achievement", Ativo=true, Dados={}}, {__index=Achievement}) end
function Achievement:Ativar() self.Ativo=true end
function Achievement:Desativar() self.Ativo=false end
function Achievement:Tick(dt) end
function Achievement:Serializar() return {Nome=self.Nome, Ativo=self.Ativo} end
return Achievement
]]></ProtectedString></Properties></Item>
