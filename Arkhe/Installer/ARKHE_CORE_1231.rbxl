     <Item class="ModuleScript" referent="RBX703763"><Properties><string name="Name">VersionManager</string><ProtectedString name="Source"><![CDATA[--[[
	VersionManager (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Publish > VersionManager
	============================================================
	F12 — VERSIONAMENTO & ROLLBACK para publisher Open Cloud
	- Versões semânticas: 1.0.0, 1.0.1, 1.1.0 etc
	- Histórico de pacotes com changelog
	- Rollback para versão anterior
	- Integra com WorldSerializer e relay
	============================================================
]]

local VersionManager = {}
VersionManager.__index = VersionManager

function VersionManager.novo(nomeMundo)
	local self = setmetatable({}, VersionManager)
	self.NomeMundo = nomeMundo or "Meu Mundo Arkhe"
	self.Versoes = {} -- { Versao="1.0.0", Timestamp, Resumo, Changelog, PacoteHash }
	self.VersaoAtual = "0.0.0"
	self.MaxVersoes = 20
	return self
end

function VersionManager:Incrementar(tipo)
	-- tipo: patch, minor, major
	tipo = tipo or "patch"
	local major, minor, patch = self.VersaoAtual:match("(%d+)%.(%d+)%.(%d+)")
	major, minor, patch = tonumber(major) or 0, tonumber(minor) or 0, tonumber(patch) or 0
	if tipo == "major" then
		major = major + 1; minor=0; patch=0
	elseif tipo == "minor" then
		minor = minor + 1; patch=0
	else
		patch = patch + 1
	end
	self.VersaoAtual = string.format("%d.%d.%d", major, minor, patch)
	return self.VersaoAtual
end

function VersionManager:RegistrarVersao(resumo, changelog, pacoteHash)
	local versao = self.VersaoAtual
	if #self.Versoes > 0 and self.Versoes[#self.Versoes].Versao == versao then
		-- já existe, incrementa patch auto
		versao = self:Incrementar("patch")
	end
	local entry = {
		Versao=versao,
		Timestamp=os.time(),
		Resumo=resumo,
		Changelog=changelog or "Sem notas",
		PacoteHash=pacoteHash or "",
	}
	table.insert(self.Versoes, entry)
	if #self.Versoes > self.MaxVersoes then table.remove(self.Versoes, 1) end
	self.VersaoAtual = versao
	return entry
end

function VersionManager:UltimaVersao()
	return self.Versoes[#self.Versoes]
end

function VersionManager:Listar()
	return self.Versoes
end

function VersionManager:Rollback(versaoAlvo)
	for i=#self.Versoes,1,-1 do
		if self.Versoes[i].Versao == versaoAlvo then
			self.VersaoAtual = versaoAlvo
			return self.Versoes[i]
		end
	end
	return nil, "versao nao encontrada"
end

function VersionManager:Serializar()
	return {
		NomeMundo=self.NomeMundo,
		VersaoAtual=self.VersaoAtual,
		TotalVersoes=#self.Versoes,
		Versoes=self.Versoes,
	}
end

-- Singleton global
local global = VersionManager.novo("MundoArkhe")
VersionManager.Global = global

return VersionManager
]]></ProtectedString></Properties></Item>
     <Item class="ModuleScript" referent="RBX486549"><Properties><string name="Name">WorldSerializer</string><ProtectedString name="Source"><![CDATA[--[[
	WorldSerializer (ModuleScript)
	Local: ReplicatedStorage > Arkhe > Publish > WorldSerializer
	============================================================
	F12 — PUBLISHER SERIALIZADOR DE MUNDO v2.5
	Empacota TUDO: RRW + EventScript 70+ + Visual + Physica
	+ Terrain + UI + NPC + Modeler + Animator + Import + Audio
	+ Marketplace + UndoRedo + Multiplayer + Economy + Analytics + Education
	+ Cinematic + Accessibility + VRConsole + Raycast + DragDrop
	+ CaveSystem + RiverSpline + RoadSpline + CSG + CurveEditor + Narration + LaserPointer + Dialogue+Crowd+Ragdoll+LightProbe+DayNight+VersionManager+AntiCheat+CrossServer+TimelineEditor
	Versao 2.5 — pronto para Open Cloud .rbxl via relay
	============================================================
]]

local WorldSerializer = {}

function WorldSerializer.ExportarPacote(Kernel)
	local pacote = {
		Versao = "3.0",
		ArkheVersao = "F12-serializer-v3.0-100FINAL-es150-debug-timelinevis-texturepaint-vrui-binary-occlusion-curvevis-clipexport-screenreader-subtitles-canvas-skilltree-autorestore-payout-previewrender-autocaption-exportcsv-skilltreevis",
		CriadoEm = os.time(),
		RRW = nil,
		EventScript = nil,
		Visual = nil,
		Physica = nil,
		Terrain = nil,
		UI = nil,
		NPC = nil,
		Modeler = nil,
		Animator = nil,
		Import = nil,
		Audio = nil,
		Marketplace = nil,
		UndoRedo = nil,
		Multiplayer = nil,
		Economy = nil,
		Analytics = nil,
		Education = nil,
		Cinematic = nil,
		Accessibility = nil,
		VRConsole = nil,
		TerrainExtras = nil,
		UIExtras = nil,
		Caves = nil,
		Rivers = nil,
		Roads = nil,
		CSG = nil,
		Curves = nil,
		Narration = nil,
		Laser = nil,
		Dialogue = nil,
		Crowd = nil,
		Ragdoll = nil,
		LightProbes = nil,
		DayNight = nil,
		VersionManager = nil,
		AntiCheat = nil,
		CrossServer = nil,
		TimelineEditor = nil,
		Grammar = nil,
		EditableTerrain = nil,
		UVUnwrap = nil,
		LowPoly = nil,
		Docking = nil,
		ThemeManager = nil,
		FileImporter = nil,
		Audio3D = nil,
		ReverbZone = nil,
		FunnelVisual = nil,
		BlendSpace = nil,
		MotionCapture = nil,
		Destruction = nil,
		Ballistics = nil,
		Vehicle = nil,
		LiveOptimizer = nil,
		HeatmapLive = nil,
		ModerationAI = nil,
		Revenue = nil,
		Crafting = nil,
		Bank = nil,
		Trade = nil,
		Tutorial = nil,
		WhyOverlay = nil,
		HandTracking = nil,
		ConsoleSupport = nil,
		PluginSystem = nil,
		EventBusAdvanced = nil,
		TeamPermissions = nil,
		MultiSelect = nil,
		BiomePainter = nil,
		EditableMeshHeight = nil,
		EditableMeshDirect = nil,
		SnapSystem = nil,
		PBRGenerator = nil,
		HeightDisplacement = nil,
		RBXDomBuilder = nil,
		OAuth2Manager = nil,
		ClientPrediction = nil,
		Rollback = nil,
		EventScriptExtended = nil,
		TimelineVisual = nil,
		TexturePaint = nil,
		VRUIEditor = nil,
		BinaryImporter = nil,
		Occlusion = nil,
		CurveVisual = nil,
		ClipExporter = nil,
		ScreenReader = nil,
		Subtitles = nil,
		CanvasVisual = nil,
		SkillTree = nil,
		AutoRestore = nil,
		Payout = nil,
		PreviewRender = nil,
		AutoCaption = nil,
		ExportCSV = nil,
		SkillTreeVisual = nil,
		Meta = {
			TotalEntidades = 0,
			TotalFolhas = 0,
			TotalTelas = 0,
			TotalNPCs = 0,
			TotalModelos = 0,
			TotalClips = 0,
			TotalZonasAudio = 0,
			TotalAssetsImportados = 0,
			TotalItensMarketplace = 0,
			TotalQuests = 0,
			TotalItensLoja = 0,
		},
	}

	-- RRW
	local okMundo, mundo = pcall(function() return Kernel and Kernel.Obter and Kernel.Obter("Mundo") or nil end)
	if okMundo and mundo and mundo.Serializar then
		local ok, dados = pcall(function() return mundo:Serializar() end)
		if ok and dados then
			pacote.RRW = dados
			pacote.Meta.TotalEntidades = #(dados.Entidades or {})
		end
	end

	-- EventScript 70+
	local okES, es = pcall(function()
		return Kernel and Kernel.Obter and Kernel.Obter("EventScript") or require(game:GetService("ReplicatedStorage").Arkhe.Kernel.EventScript)
	end)
	if not okES then
		local ok2, mod = pcall(function() return require(game:GetService("ReplicatedStorage").Arkhe.Kernel.EventScript) end)
		if ok2 then es = mod end
	end
	if es and es.Folhas then
		local folhas = {}
		for _, f in ipairs(es.Folhas) do table.insert(folhas, { Nome=f.Nome, Gatilho=f.Gatilho, Quando=f.Quando, Faca=f.Faca, EntidadeId=f.EntidadeId }) end
		pacote.EventScript = { Folhas = folhas, TotalCondicoes = 0, TotalAcoes = 0 }
		if es.Specs then
			local c=0 for _ in pairs(es.Specs.C or {}) do c=c+1 end
			local a=0 for _ in pairs(es.Specs.A or {}) do a=a+1 end
			pacote.EventScript.TotalCondicoes = c
			pacote.EventScript.TotalAcoes = a
		end
		pacote.Meta.TotalFolhas = #folhas
	end

	-- Visual
	local okVis, visual = pcall(function() return Kernel and Kernel.Obter and Kernel.Obter("VisualPresets") or require(game:GetService("ReplicatedStorage").Arkhe.Visual.Presets) end)
	if not okVis then local ok2, mod = pcall(function() return require(game:GetService("ReplicatedStorage").Arkhe.Visual.Presets) end) if ok2 then visual = mod end end
	if visual then
		local atual = visual.Atual or "SemiRealista"
		local serialAtual = nil
		if visual.Serializar then local ok, ser = pcall(visual.Serializar, atual) if ok then serialAtual = ser end end
		local nativos = { SemiRealista=true, Realista=true, Fantasia=true, Medieval=true, Horror=true, SciFi=true, Arcade=true, Noir=true }
		local customs = {}
		if visual.Catalogo then for nome, def in pairs(visual.Catalogo) do if not nativos[nome] then local ok, ser = pcall(function() return visual.Serializar and visual.Serializar(nome) or def end) if ok then customs[nome]=ser or def end end end end
		pacote.Visual = { Atual=atual, AtualSerializado=serialAtual, Customs=customs }
	end

	-- Physica
	local okPhy, phy = pcall(function() return Kernel and Kernel.Obter and Kernel.Obter("Physica") or require(game:GetService("ReplicatedStorage").Arkhe.Physica.Physica) end)
	if not okPhy then local ok2, mod = pcall(function() return require(game:GetService("ReplicatedStorage").Arkhe.Physica.Physica) end) if ok2 then phy = mod end end
	if phy then pacote.Physica = { Atual=phy.Atual or "Arcade", Catalogo=phy.Catalogo or {} } end

	-- Terrain
	local okCampo, campo = pcall(function() return Kernel and Kernel.Obter and Kernel.Obter("TerrainCampo") or nil end)
	if okCampo and campo and campo.Serializar then local ok, ser = pcall(function() return campo:Serializar() end) if ok then pacote.Terrain = ser end end

	-- UI
	local okUI, telas = pcall(function() return Kernel and Kernel.Obter and Kernel.Obter("TelasUI") or nil end)
	if okUI and type(telas)=="table" then
		local copia={}
		for _, t in ipairs(telas) do local comps={} for _, c in ipairs(t.Comps or {}) do table.insert(comps, { Nome=c.Nome, Tipo=c.Tipo, X=c.X, Y=c.Y, W=c.W, H=c.H, Cor=c.Cor, Texto=c.Texto, Valor=c.Valor, Cantos=c.Cantos }) end table.insert(copia, { Nome=t.Nome, Comps=comps }) end
		pacote.UI = { Telas=copia }
		pacote.Meta.TotalTelas = #copia
	end

	-- NPC
	local okBrain, brain = pcall(function() return Kernel and Kernel.Obter and Kernel.Obter("NPCBrain") or nil end)
	local okSkin, skin = pcall(function() return Kernel and Kernel.Obter and Kernel.Obter("AutoSkin") or nil end)
	local npcInfo = { Personalidades={}, Temas={}, Total=0, Max=30 }
	if okBrain and brain then if brain.Contar then local ok, total = pcall(brain.Contar) if ok then npcInfo.Total = total end end npcInfo.Max = brain.MaxNPCs or 30 for nome, def in pairs(brain.Personalidades or {}) do npcInfo.Personalidades[nome]=def end end
	if okSkin and skin and skin.Listar then local ok, lista = pcall(skin.Listar) if ok then npcInfo.Temas = lista end end
	pacote.NPC = npcInfo
	pacote.Meta.TotalNPCs = npcInfo.Total

	-- Modeler
	local okMod, modelo = pcall(function() return Kernel and Kernel.Obter and Kernel.Obter("ModeloAtual") or nil end)
	if okMod and modelo and modelo.Serializar then local ok, ser = pcall(function() return modelo:Serializar() end) if ok and ser then pacote.Modeler = { Atual = ser } pacote.Meta.TotalModelos = 1 end end

	-- Animator
	local okClips, clips = pcall(function() return Kernel and Kernel.Obter and Kernel.Obter("Clips") or nil end)
	if okClips and type(clips)=="table" then
		local lista={} local totalKf=0
		for nome, clip in pairs(clips) do if clip.Serializar then local ok, ser = pcall(function() return clip:Serializar() end) if ok and ser then table.insert(lista, ser) for _, kfs in pairs(clip.Tracks or {}) do totalKf = totalKf + #kfs end end end end
		pacote.Animator = { Clips = lista, TotalKeyframes = totalKf }
		pacote.Meta.TotalClips = #lista
	end

	-- Audio F15
	local okAudio, audio = pcall(function() return Kernel and Kernel.Obter and Kernel.Obter("AudioMixer") or nil end)
	if not okAudio then local ok2, mod = pcall(function() return require(game:GetService("ReplicatedStorage").Arkhe.Audio.AudioMixer) end) if ok2 then audio = mod end end
	if audio then pacote.Audio = { Zonas = audio.Zonas or {}, VolumeMaster = audio.VolumeMaster, VolumeMusica = audio.VolumeMusica, VolumeEfeitos = audio.VolumeEfeitos, Atual = audio.Atual and audio.Atual.Id or nil } pacote.Meta.TotalZonasAudio = #(audio.Zonas or {}) end
	local okMat, matSounds = pcall(function() return require(game:GetService("ReplicatedStorage").Arkhe.Audio.MaterialSounds) end)
	if okMat and matSounds then pacote.Audio = pacote.Audio or {} pacote.Audio.MaterialSounds = matSounds.Catalogo end

	-- Import F11
	local okImp, assetImp = pcall(function() return require(game:GetService("ReplicatedStorage").Arkhe.Import.AssetImporter) end)
	if okImp and assetImp then pacote.Import = { Tipos = assetImp.TiposSuportados } end

	-- Marketplace F14
	local okMarket, marketSvc = pcall(function() return Kernel and Kernel.Obter and Kernel.Obter("MarketplaceService") or nil end)
	if okMarket and marketSvc and marketSvc.Catalogo then pacote.Marketplace = { TotalItens = #marketSvc.Catalogo, Itens = marketSvc.Catalogo } pacote.Meta.TotalItensMarketplace = #marketSvc.Catalogo else pacote.Marketplace = { TotalItens = 0 } end

	-- UndoRedo F2
	local okUndo, undo = pcall(function() return require(game:GetService("Replica]]></ProtectedString></Properties></Item>
    </Item>
