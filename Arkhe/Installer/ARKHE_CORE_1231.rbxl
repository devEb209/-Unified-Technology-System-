     <Item class="ModuleScript" referent="RBX18523"><Properties><string name="Name">LaserPointer</string><ProtectedString name="Source"><![CDATA[--[[
	LaserPointer (ModuleScript)
	Local: ReplicatedStorage > Arkhe > VRConsole > LaserPointer
	============================================================
	F22 — LASER POINTER para VR/Console + edição com mãos (futuro).
	- Raycast do controlador VR ou gamepad
	- Aponta para entidades RRW ou UI
	- Modos: Apontar, Selecionar, Editar, Teleportar
	- Serializavel
	============================================================
]]

local LaserPointer = {}
LaserPointer.__index = LaserPointer

function LaserPointer.novo(nome)
	local self = setmetatable({}, LaserPointer)
	self.Nome = nome or "Laser"
	self.Modo = "Apontar" -- Apontar, Selecionar, Editar, Teleportar
	self.Cor = Color3.fromRGB(88, 96, 200)
	self.Alcance = 200
	self.Ativo = false
	self.UltimoAlvo = nil -- { Tipo="Entidade"/"UI"/"Terreno", Id, Pos }
	self.Historico = {}
	return self
end

function LaserPointer:DefinirModo(modo)
	local modos = { Apontar=true, Selecionar=true, Editar=true, Teleportar=true }
	if modos[modo] then
		self.Modo = modo
		return true
	end
	return false
end

function LaserPointer:DefinirCor(cor)
	self.Cor = cor
end

function LaserPointer:Ativar()
	self.Ativo = true
end

function LaserPointer:Desativar()
	self.Ativo = false
end

-- Simula raycast VR: recebe origem e direção, retorna alvo mais próximo
-- entidades: lista { Id, Pos } para testar
function LaserPointer:Raycast(origem, direcao, entidades, terrenoCampo)
	if not self.Ativo then return nil end
	direcao = direcao.Unit
	local melhor = nil
	local menorDist = self.Alcance

	-- checa entidades RRW
	if entidades then
		for _, e in ipairs(entidades) do
			local pos = e.Pos or e.Position
			if pos then
				local toEnt = pos - origem
				local proj = toEnt:Dot(direcao)
				if proj > 0 and proj < menorDist then
					local pontoProximo = origem + direcao * proj
					local distLateral = (pos - pontoProximo).Magnitude
					if distLateral < 4 then -- raio de seleção
						menorDist = proj
						melhor = { Tipo="Entidade", Id=e.Id, Pos=pos, Dist=proj }
					end
				end
			end
		end
	end

	-- checa terreno (ray vs heightfield aproximado)
	if terrenoCampo and terrenoCampo.Alturas then
		-- marcha ao longo do raio
		for d=0,self.Alcance,5 do
			local p = origem + direcao * d
			local h = terrenoCampo:AlturaMundo(p.X, p.Z) -- se existir
			if h and p.Y <= h + 2 and p.Y >= h - 5 then
				if d < menorDist then
					menorDist = d
					melhor = { Tipo="Terreno", Pos=Vector3.new(p.X, h, p.Z), Dist=d }
				end
				break
			end
		end
	end

	self.UltimoAlvo = melhor
	if melhor then
		table.insert(self.Historico, { Alvo=melhor, Quando=os.time(), Modo=self.Modo })
		if #self.Historico > 30 then table.remove(self.Historico, 1) end
	end
	return melhor
end

function LaserPointer:Selecionar()
	if self.UltimoAlvo then
		return self.UltimoAlvo
	end
	return nil
end

function LaserPointer:ListarHistorico(n)
	n = n or 10
	local lista={}
	for i=math.max(1,#self.Historico-n+1),#self.Historico do
		table.insert(lista, self.Historico[i])
	end
	return lista
end

function LaserPointer:Serializar()
	return {
		Nome=self.Nome,
		Modo=self.Modo,
		Alcance=self.Alcance,
		Ativo=self.Ativo,
		UltimoAlvo=self.UltimoAlvo,
		HistoricoCount=#self.Historico,
	}
end

function LaserPointer.ListarModos()
	return {
		{ Nome="Apontar", Desc="Apenas aponta, sem ação" },
		{ Nome="Selecionar", Desc="Seleciona entidade/UI sob o laser" },
		{ Nome="Editar", Desc="Edita entidade (mover/escalar)" },
		{ Nome="Teleportar", Desc="Teleporta jogador para ponto apontado" },
	}
end

return LaserPointer
]]></ProtectedString></Properties></Item>
